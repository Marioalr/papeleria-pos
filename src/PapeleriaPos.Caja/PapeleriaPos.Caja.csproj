<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <ProjectReference Include="..\PapeleriaPos.Interfaz\PapeleriaPos.Interfaz.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Impresion\PapeleriaPos.Impresion.csproj" />
    <ProjectReference Include="..\Impresiones\PapeleriaPos.Impresiones.Windows\PapeleriaPos.Impresiones.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="caja.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\instalacion\instalar-caja.ps1" Link="instalar-caja.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PapeleriaPos.Caja</RootNamespace>
  </PropertyGroup>

  <!-- Al publicar la caja para Windows (el instalador, en GitHub Actions: -r win-x64), ya compilada (ReadyToRun): al abrirla no
       se compila, y abre más rápido en un procesador modesto (entrega 5, parte 3; docs/propuesta-interfaz.md, «Rendimiento»).
       Solo al publicar para win-x64: compilar y probar en Linux (dotnet build -p:EnableWindowsTargeting=true) no cambia. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>
