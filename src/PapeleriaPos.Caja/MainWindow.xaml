<Window x:Class="PapeleriaPos.Caja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:interfaz="clr-namespace:PapeleriaPos.Interfaz.Componentes;assembly=PapeleriaPos.Interfaz"
        Title="Caja" Width="1366" Height="768" WindowState="Maximized">
    <blazor:BlazorWebView x:Name="Vista" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type interfaz:PantallaCaja}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
