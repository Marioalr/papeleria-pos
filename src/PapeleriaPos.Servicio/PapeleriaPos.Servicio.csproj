<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PapeleriaPos.Nucleo\PapeleriaPos.Nucleo.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Datos\PapeleriaPos.Datos.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Eleventa\PapeleriaPos.Eleventa.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Interfaz\PapeleriaPos.Interfaz.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Impresion\PapeleriaPos.Impresion.csproj" />
    <!-- El módulo de impresión: su API, la vigilancia de la impresora y AgregarImpresiones. -->
    <ProjectReference Include="..\Impresiones\PapeleriaPos.Impresiones.Servicio\PapeleriaPos.Impresiones.Servicio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los Excel de los reportes (entrega 9, parte 2): la misma que usa el diagnóstico de PapeleriaPos.Herramientas. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- La llave propia del servicio, cifrada para la PC de la caja principal (DPAPI): LlaveDelServicio. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Va junto al .exe publicado: se corre ahí, como administrador, en la caja principal. -->
    <None Include="..\..\instalacion\instalar-servicio.ps1" Link="instalar-servicio.ps1" CopyToPublishDirectory="PreserveNewest" />
    <!-- La configuración de esta PC (C:\ProgramData\PapeleriaPos\servicio.json) empieza así: la ponen instalar-servicio.ps1 y
         actualizar.ps1 si falta, y nunca encima de una que ya esté. -->
    <None Include="..\..\instalacion\plantilla-servicio.json" Link="plantilla-servicio.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las pruebas abren y cierran el paso a lo que corre a la vez (lo elegido en la búsqueda) para revisar cada orden. -->
    <InternalsVisibleTo Include="PapeleriaPos.Pruebas" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
