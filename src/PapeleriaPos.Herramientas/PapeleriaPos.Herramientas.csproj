<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PapeleriaPos.Nucleo\PapeleriaPos.Nucleo.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Datos\PapeleriaPos.Datos.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Eleventa\PapeleriaPos.Eleventa.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Impresion\PapeleriaPos.Impresion.csproj" />
    <!-- El simulador de cajas (simular-cajas) vende con el código de la caja, sin la pantalla: ClienteCaja, Contingencia,
         AlmacenLocal, la foto del catálogo y la red con sus plazos. -->
    <ProjectReference Include="..\PapeleriaPos.Interfaz\PapeleriaPos.Interfaz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Publicado como un solo .exe para una PC sin el SDK, como la caja 2 (docs/impresion.md, «En la caja 2»): sin los .pdb que
       traen los paquetes (el de SkiaSharp pesa 96 MB y no sirve en la tienda). -->
  <Target Name="SinPdbEnUnSoloArchivo" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
