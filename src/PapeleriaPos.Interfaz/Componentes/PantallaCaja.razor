@* Raíz de la caja: conecta con el servicio (o da de alta la PC), pide entrar con la ficha y el PIN, abre el turno y muestra
   la venta. La entrada, abrir el turno y el turno de otro cajero van con el lado de la entrada (entrega 6). *@
@implements IDisposable
@inject ClienteCaja Cliente
@inject ConexionCaja Conexion
@inject IServiceProvider Servicios

<div class="caja">
    @* La franja de la prueba cambia mucho esta semana: si falla, se quita ella sola y la venta sigue con su ticket. *@
    <AlgoFallo Parte="la franja de la prueba">
        <FranjaPrueba />
    </AlgoFallo>
    @* «Dar de alta otra vez» solo sin nadie en la venta: con alguien, se perdería el ticket que lleva. *@
    <FranjaContingencia AlDarDeAlta="@(Conexion.PideAlta && _sesion is null ? EventCallback.Factory.Create<string>(this, AltaDesdeLaFranja) : default)" />
    @if (_alta || !Conexion.Lista)
    {
        <ConfigurarCaja Aviso="@_avisoAlta" AlTerminar="AltaTerminada"
                        AlVolver="@(_altaSePuedeDejar ? EventCallback.Factory.Create(this, DejarElAlta) : default)" />
    }
    else if (_error is not null)
    {
        <div class="centrado">
            <div class="tarjeta">
                <h2>Sin conexión</h2>
                <p class="error">@_error</p>
                <button class="boton principal" @onclick="IniciarAsync">Reintentar</button>
                @if (Conexion.PideAlta)
                {
                    <button class="boton" @onclick="() => _alta = true">Cambiar la caja principal o dar de alta de nuevo</button>
                }
            </div>
        </div>
    }
    else if (_caja is null)
    {
        <div class="centrado"><p>Conectando con el servicio…</p></div>
    }
    else if (_sesion is null && _recordarCorte)
    {
        @* El piloto con eleventa: al salir, recuerda que el corte se hace en eleventa (se quita al dejarlo). *@
        <div class="entrada">
            <LadoEntrada Caja="_caja" Turno="_turno" />
            <section class="entrada-main">
                <h1>@_caja.Nombre</h1>
                <p>@PilotoConEleventa.CorteEnEleventa</p>
                <div class="vn-botonera">
                    <button class="vn-boton primario" @ref="_entendido" @onclick="() => _recordarCorte = false">Entendido</button>
                </div>
            </section>
        </div>
    }
    else if (_sesion is null)
    {
        @* ¿Quién atiende?: las fichas y el PIN (entrega 6). Aquí llegan «Cambiar de usuario» (Ctrl+U) y «Salir». *@
        <Entrada Caja="_caja" Turno="_turno" AlEntrar="Entrar" />
    }
    else if (_administrar)
    {
        <Administracion Caja="_caja" Sesion="_sesion" AlSalir="Salir" />
    }
    else if (_turno is null)
    {
        <AbrirTurno Caja="_caja" Sesion="_sesion" AlAbrir="TurnoAbierto" AlSalir="Salir"
                    AlAdministrar="@(PuedeAdministrar ? EventCallback.Factory.Create(this, () => _administrar = true) : default)" />
    }
    else if (_turno.CajeroId != _sesion.UsuarioId)
    {
        @* Un turno por cajero: si entra otro, primero el corte del que sale, ahí mismo y sin volver a pedir el PIN. *@
        <TurnoDeOtro Caja="_caja" Turno="_turno" Sesion="_sesion" Piloto="PilotoEleventa" AlVolver="Salir" AlTerminarCorte="CorteTerminado"
                     AlAdministrar="@(PuedeAdministrar ? EventCallback.Factory.Create(this, () => _administrar = true) : default)" />
    }
    else
    {
        <PantallaVenta Caja="_caja" Sesion="_sesion" Turno="_turno" AlSalir="Salir" AlCerrarTurno="CorteTerminado" />
    }
</div>

@code {
    private CajaDto? _caja;
    private SesionDto? _sesion;
    private TurnoDto? _turno;
    private string? _error;
    private bool _administrar;

    /// <summary>
    /// Productos e inventario sin vender (sin cortar ni abrir turno), como en el prototipo: para quien tiene «Productos,
    /// precios y etiquetas» o «Compras: la nota y los costos» (con los usuarios de antes, el encargado y el dueño).
    /// </summary>
    private bool PuedeAdministrar => _sesion is { } sesion && (sesion.Puede(AccionControlada.EditarCatalogo) || sesion.Puede(AccionControlada.CostearCompra));
    private bool _alta;
    private string? _avisoAlta;

    /// <summary>El alta se abrió con «Dar de alta otra vez» de la franja: «Volver» la deja y la caja sigue con su copia.</summary>
    private bool _altaSePuedeDejar;

    protected override Task OnInitializedAsync()
    {
        // La caja principal dice que ya no conoce a esta caja (al probar quién es, sin recibir la llave): se da de alta otra vez.
        if (Servicios.GetService<Contingencia>() is { } contingencia)
            contingencia.SinAlta += AlQuedarSinAlta;
        return Conexion.Lista ? IniciarAsync() : Task.CompletedTask;
    }

    private void AlQuedarSinAlta(string porque)
    {
        if (Conexion.PideAlta)
            _ = InvokeAsync(() => DarDeAlta(porque));
    }

    /// <summary>A dar de alta esta PC otra vez (con el usuario y el PIN de quien puede), con el porqué.</summary>
    private void DarDeAlta(string porque)
    {
        (_alta, _avisoAlta, _altaSePuedeDejar) = (true, porque, false);
        StateHasChanged();
    }

    /// <summary>«Dar de alta otra vez» de la franja: lo oprime el dueño, o alguien por error (por eso se puede volver).</summary>
    private void AltaDesdeLaFranja(string porque)
    {
        DarDeAlta(porque);
        _altaSePuedeDejar = true;
    }

    private void DejarElAlta() => (_alta, _avisoAlta, _altaSePuedeDejar) = (false, null, false);

    public void Dispose()
    {
        if (Servicios.GetService<Contingencia>() is { } contingencia)
            contingencia.SinAlta -= AlQuedarSinAlta;
    }

    private async Task IniciarAsync()
    {
        _error = null;
        try
        {
            await Conexion.Listo;
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or System.ComponentModel.Win32Exception)
        {
            _error = ex.Message;
            return;
        }
        // Con la copia de esta caja, la entrada sale sin esperar a la red (entrega 5, parte 3): la caja y su turno como los
        // conoce la copia. La caja principal los pone al día en cuanto contesta (y si ya no reconoce a esta caja, se da de alta).
        if (await Cliente.DeLaCopiaAsync(Conexion.CajaId) is { } deLaCopia)
        {
            (_caja, _turno) = deLaCopia;
            _ = PonerAlDiaAsync();
            return;
        }
        await PreguntarAsync();
    }

    /// <summary>
    /// Cuenta lo que cambia quién atiende o el turno (entrar, salir, abrir el turno, el corte): lo que contesta la caja
    /// principal después de salir con la copia solo se pone si mientras tanto no pasó nada de eso.
    /// </summary>
    private int _cambios;

    /// <summary>Lo de la caja principal, después de salir con la copia: si alguien ya entró, ya lo pidió él al entrar.</summary>
    private async Task PonerAlDiaAsync()
    {
        var (caja, turno, sesion) = (_caja, _turno, _sesion);
        await PreguntarAsync(soloSiNoCambio: _cambios);
        if (_caja != caja || _turno != turno || _sesion != sesion || _alta || _error is not null)
            StateHasChanged();
    }

    /// <summary>Esta caja y su turno, de la caja principal (sin conexión, de la copia, como siempre).</summary>
    /// <param name="soloSiNoCambio">
    /// Ya se salió con la copia: lo que conteste se pone solo si nadie entró ni cambió el turno desde entonces (lo cuenta
    /// <see cref="_cambios"/>); quien entra ya pide su turno al entrar.
    /// </param>
    private async Task PreguntarAsync(int? soloSiNoCambio = null)
    {
        bool SigueIgual() => soloSiNoCambio is not { } cambios || (cambios == _cambios && _sesion is null);
        try
        {
            var cajas = await Cliente.CajasAsync();
            var caja = Conexion.CajaId is { } id ? cajas.SingleOrDefault(c => c.Id == id) : cajas.FirstOrDefault();
            if (!SigueIgual())
                return;
            _caja = caja;
            if (_caja is null)
            {
                _error = "Esta PC no tiene una caja dada de alta en el servicio.";
                return;
            }
            var turno = await Cliente.TurnoAsync(_caja.Id);
            if (SigueIgual())
                _turno = turno;
        }
        catch (ErrorCaja ex) when (ex.Codigo == "caja-sin-alta" && Conexion.PideAlta)
        {
            // El dueño quitó esta PC (o la base es otra): se vuelve a dar de alta.
            (_alta, _avisoAlta) = (true, ex.Message);
        }
        catch (ErrorCaja) when (soloSiNoCambio is not null)
        {
            // Ya se salió con la copia: se queda lo que dice ella.
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AltaTerminada()
    {
        (_alta, _avisoAlta, _altaSePuedeDejar, _caja) = (false, null, false, null);
        await IniciarAsync();
    }

    private async Task Entrar(SesionDto sesion)
    {
        _cambios++;
        _sesion = sesion;
        Conexion.UsuarioEnCaja = sesion.UsuarioId;
        // El piloto, a la par del turno: entrar no espera una consulta más.
        var piloto = CargarPilotoEleventaAsync();
        _turno = await Cliente.TurnoAsync(_caja!.Id);
        await piloto;
    }

    private void TurnoAbierto(TurnoDto turno)
    {
        _cambios++;
        _turno = turno;
    }

    /// <summary>
    /// A «¿Quién atiende?»: «Cambiar de usuario» (Ctrl+U) y «Salir» de la venta, y «Volver» de abrir el turno, del turno de
    /// otro y de productos e inventario.
    /// </summary>
    private async Task Salir()
    {
        _cambios++;
        _sesion = null;
        Conexion.UsuarioEnCaja = null;
        _administrar = false;
        // El piloto con eleventa: el turno sigue abierto aquí, y su corte se hace en eleventa.
        _recordarCorte = _enfocarEntendido = _turno is not null && PilotoEleventa;
        // El lado de la entrada dice el turno abierto: al día, por si se cerró con el corte antes de «Volver».
        try
        {
            _turno = await Cliente.TurnoAsync(_caja!.Id);
        }
        catch (ErrorCaja)
        {
            // Se queda el que se sabía: al entrar se vuelve a pedir.
        }
    }

    // ── El piloto con eleventa: el corte se hace allá (se quita al dejar eleventa) ──

    /// <summary>
    /// El servicio manda las ventas a eleventa: el corte de esta caja se hace en eleventa (decisión del dueño,
    /// 2026-10-12). En la ventana de Windows lo dice la contingencia, que lo vuelve a saber en cada latido y lo recuerda
    /// sin conexión; en el navegador, que no la tiene, se pregunta al entrar.
    /// </summary>
    private bool _pilotoEleventa;

    private bool PilotoEleventa => Servicios.GetService<Contingencia>()?.PilotoEleventa ?? _pilotoEleventa;

    /// <summary>Al salir con el turno abierto: el aviso, que la cajera cierra con Enter o con «Entendido».</summary>
    private bool _recordarCorte;

    private ElementReference _entendido;
    private bool _enfocarEntendido;

    private async Task CargarPilotoEleventaAsync()
    {
        if (Servicios.GetService<Contingencia>() is not null)
            return;
        try
        {
            _pilotoEleventa = await Cliente.PilotoEleventaAsync();
        }
        catch (ErrorCaja)
        {
            // Sin conexión y sin contingencia (el navegador): el servicio rechaza el corte de todos modos.
        }
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (_enfocarEntendido && _recordarCorte)
        {
            _enfocarEntendido = false;
            await _entendido.FocusAsync();
        }
    }

    /// <summary>
    /// Se cerró el turno con el corte, desde la venta o desde el turno de otro: lo hizo quien entró, con su PIN y con el
    /// permiso (entrega 6: el corte ya no pide el PIN de otro), así que sigue adentro y pasa a abrir el suyo, como «Listo:
    /// abrir el siguiente turno» del prototipo; si no va a vender, «Volver» lo regresa a las fichas. También «Abrir turno»
    /// del corte, si el turno ya estaba cerrado: quien entró abre el suyo.
    /// </summary>
    private async Task CorteTerminado()
    {
        _cambios++;
        _turno = await Cliente.TurnoAsync(_caja!.Id);
    }
}
