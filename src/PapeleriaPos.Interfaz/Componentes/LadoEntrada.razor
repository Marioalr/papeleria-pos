@* El lado de la entrada (docs/propuesta-interfaz/prototipo.html, htmlLado): la tienda y la caja, la hora en grande y cómo
   está todo antes de entrar: la conexión (lo mismo que dice el estado de arriba en la venta), la impresora de tickets y el
   turno abierto. Va en «¿Quién atiende?», en abrir el turno y en la caja con el turno de otro. La tienda se llama como dice
   Configuración › Tienda (entrega 7); sin nombre, como la sucursal. *@
@implements IDisposable
@inject ClienteCaja Cliente
@inject ConexionCaja Conexion
@inject IImpresora Impresora
@inject IServiceProvider Servicios

<section class="entrada-lado">
    <div class="vn-marca">
        <span class="vn-logo">P</span>
        <div><strong>@Tienda</strong><small>@Caja.Nombre · @(Conexion.Servicio.IsLoopback ? "principal" : "secundaria")</small></div>
    </div>
    <div class="reloj">@_ahora.ToString("HH:mm", Formato.Mexico)</div>
    <div class="fecha">@_ahora.ToString("dddd, d 'de' MMMM", Formato.Mexico)</div>
    <ul class="estado-lista">
        @switch (EstadoCaja.QueDice(_contingencia, Conexion))
        {
            case EstadoCaja.ChipConexion.SinLaPrincipal:
                <li><span class="punto ambar"></span>Sin la caja principal: vende con su copia@(_contingencia!.Pendientes > 0 ? $" · {_contingencia.Pendientes} por subir" : "")</li>
                break;
            case EstadoCaja.ChipConexion.Subiendo:
                <li><span class="punto ambar"></span>Subiendo @_contingencia!.Pendientes a la caja principal…</li>
                break;
            case EstadoCaja.ChipConexion.ServicioAqui:
                <li><span class="punto"></span>Servicio en esta PC</li>
                break;
            default:
                <li><span class="punto"></span>Conectada a la caja principal</li>
                break;
        }
        @* La impresora no se revisa (no hay a quién preguntarle cómo está): el punto no dice «lista», como el verde. Si algo de
           la cola no salió (entrega 5, parte 3), lo dice, con «Reintentar»: quien entra después también lo ve. *@
        @if (Impresora.MuestraVistaPrevia)
        {
            <li><span class="punto gris"></span>Ticket en pantalla (sin impresora de tickets)</li>
        }
        else if (Cola.Problema is { Estado: EstadoImpresion.NoSalio } noSalio)
        {
            <li>
                <span class="punto ambar"></span>Impresora de tickets: no salió «@noSalio.Titulo» (@noSalio.Motivo)
                <button class="vn-boton chico" @onclick="Cola.Reintentar">Reintentar</button>
            </li>
        }
        else if (Cola.Problema is { } ocupada)
        {
            <li><span class="punto ambar"></span>Impresora de tickets: «@ocupada.Titulo» espera a que conteste</li>
        }
        else
        {
            <li><span class="punto gris"></span>Impresora de tickets</li>
        }
        <li><span class="punto"></span>@(Turno is { } turno ? $"Turno abierto: {turno.Cajero} desde las {turno.AbiertoLocal.ToString("HH:mm", Formato.Mexico)}" : "Sin turno abierto")</li>
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;

    /// <summary>El turno abierto de esta caja, si hay.</summary>
    [Parameter] public TurnoDto? Turno { get; set; }

    private Contingencia? _contingencia;
    private DateTime _ahora = Ahora();

    /// <summary>El nombre de la tienda: el que ya se conocía mientras llega (sin parpadear) y, si no tiene, el de la sucursal.</summary>
    private string Tienda => Cliente.ConfiguracionConocida?.NombreTienda ?? Caja.Sucursal;
    private readonly CancellationTokenSource _alto = new();

    /// <summary>La hora de la tienda, como la del turno y los tickets.</summary>
    private static DateTime Ahora() => HoraMexico.ALocal(DateTime.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Cliente.ConfiguracionSucursalAsync(Caja.SucursalId);
        }
        catch (ErrorCaja)
        {
            // Sin conexión y sin copia: el de la sucursal.
        }
    }

    private ColaDeImpresion Cola => ColaDeImpresion.De(Impresora);

    protected override void OnInitialized()
    {
        // Solo la ventana de Windows trabaja sin conexión: si la pierde o sube lo pendiente, el lado lo dice al momento.
        _contingencia = Servicios.GetService<Contingencia>();
        if (_contingencia is not null)
            _contingencia.Cambio += AlCambiar;
        Cola.Cambio += AlCambiar;
        _ = RelojAsync();
    }

    private void AlCambiar() => _ = InvokeAsync(StateHasChanged);

    /// <summary>El reloj cambia al cambiar el minuto (y la fecha a medianoche).</summary>
    private async Task RelojAsync()
    {
        var alto = _alto.Token;
        try
        {
            while (true)
            {
                await Task.Delay(TimeSpan.FromSeconds(60 - _ahora.Second) - TimeSpan.FromMilliseconds(_ahora.Millisecond), alto);
                _ahora = Ahora();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Se entró: el lado se fue.
        }
    }

    public void Dispose()
    {
        if (_contingencia is not null)
            _contingencia.Cambio -= AlCambiar;
        Cola.Cambio -= AlCambiar;
        _alto.Cancel();
        _alto.Dispose();
    }
}
