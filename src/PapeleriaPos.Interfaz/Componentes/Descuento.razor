@* Ctrl+D: descuento al renglón seleccionado o a todo el ticket, con el precio final que debe quedar, en monto o en porcentaje
   (el dueño, 2026-11-16: «además del porcentaje, permitir escribir el precio objetivo»; 2026-11-21: «Precio final» primero y
   elegido, y se cambia con el teclado: ↑ ↓ en los campos, o ← → en los modos). Quien tiene el descuento en «Puede» no escribe
   el motivo (2026-11-21) mientras no pase de su límite; lo que pide autorización lleva motivo, como siempre. El cajero
   da hasta 10 % solo; más, con autorización. Si el descuento deja algo debajo del costo, también se pide. Las impresiones
   no llevan descuento. El del cliente registrado se pone al elegirlo (Ctrl+L) y no pide autorización.
   Un código que el lector teclee en «Cuánto» (data-numero, caja.js) se quita y su Enter no sigue.
   Precio y descuento en una sola ventana (dueño, 2026-11-22: «Cambiar precio» y «Descuento» se repetían): Ctrl+D y Ctrl+E la abren.
   «Precio final» más alto que lo que se cobra sube el precio del artículo: eso es «Cambiar precio» (su permiso, su autorización y
   su renglón en la bitácora, como antes con Ctrl+E), no un descuento; más bajo, es descuento. El artículo común no sube de precio
   (ya lleva el que se escribió), y a todo el ticket solo se le baja. Si el renglón de la ventana se va del ticket (se quitó, se
   cobró o cambió el ticket), la ventana se cierra (AlPerderSuRenglon). *@
@inject ClienteCaja Cliente
@inject ModuloCaja Js

@if (_autorizar is { } pendiente)
{
    <AutorizarAccion Accion="pendiente.Accion" Detalle="@pendiente.Detalle" MontoCentavos="pendiente.Monto" Caja="Caja" Sesion="Sesion"
                     AlAutorizar="a => AutorizadoAsync(pendiente.Accion, a.Id)" AlCancelar="Deshacer" />
}
else
{
    <div class="opciones-caja">
        @if (Linea is { EsImpresiones: false } linea)
        {
            <label class="en-linea opcion">
                <input type="radio" id="descuento-al-articulo" name="alcance" checked="@(!_todoElTicket)" @onchange="() => _todoElTicket = false" />
                Al artículo: <strong>@linea.Descripcion</strong> · precio actual @Formato.Dinero(linea.PrecioCentavos) (@Formato.Dinero(linea.ImporteSinDescuentoCentavos))
            </label>
        }
        <label class="en-linea opcion">
            <input type="radio" id="descuento-todo-el-ticket" name="alcance" checked="@_todoElTicket" @onchange="() => _todoElTicket = true" />
            A todo el ticket (@Formato.Dinero(Venta.Lineas.Where(l => !l.EsImpresiones).Sum(l => l.ImporteSinDescuentoCentavos))@(Venta.Lineas.Any(l => l.EsImpresiones) ? ", sin las impresiones" : ""))
        </label>
    </div>

    @if (ClienteDelTicket is { DescuentoCentesimas: > 0 } cliente)
    {
        <p class="nota">El ticket es de @cliente.Nombre, con @Permisos.TextoMonto(AccionControlada.Descuento, cliente.DescuentoCentesimas) de descuento ya puesto (Ctrl+L para cambiarlo).</p>
    }
    @* Los modos, en este orden y con «Precio final» elegido al abrir (2026-11-21). Sin el ratón: ↑ ↓ en «Cuánto» o en «Motivo», o
       ← → con el cursor en uno de ellos (los botones de opción del navegador). *@
    <div class="opciones-caja descuento-modos" role="radiogroup" aria-label="Cómo se escribe el descuento">
        @foreach (var modo in Modos)
        {
            <label class="en-linea opcion">
                <input type="radio" id="descuento-modo-@Clave(modo)" name="descuento-modo" checked="@(_modo == modo)" @onchange="() => _modo = modo" />
                @NombreDelModo(modo)
            </label>
        }
        <span class="nota" id="descuento-modo-teclas"><kbd>↑</kbd> <kbd>↓</kbd> cambian el modo</span>
    </div>
    <label>@(_modo switch { Modo.Porcentaje => "Cuánto (%)", Modo.Monto => "Cuánto ($)", _ => "Que quede en ($)" }) <input id="descuento-valor" data-numero inputmode="decimal" @bind="_valor" @bind:event="oninput" @onkeydown="AlTeclear" autocomplete="off" /></label>
    @if (_modo == Modo.Precio)
    {
        <p class="nota" id="descuento-precio-nota">Lo que se cobra @(_todoElTicket ? "por todo el ticket" : Linea is { } l && l.CantidadBase.EnUnidades != 1 ? $"por el renglón completo ({Textos.Cantidad(l.CantidadBase.EnUnidades, l.Unidad)})" : "por el artículo"), sin descuento: @Formato.Dinero(Base).
            @(PuedeSubir ? "Menos es descuento; más, sube el precio (como «Cambiar precio»)." : "El descuento es la diferencia.")</p>
        @if (PuedeSubir && Linea is { TienePromocion: true } conPromocion)
        {
            @* Lo que se cobra ahora es con la promoción (fase 3): subirle el precio la quita de este renglón. *@
            <p id="precio-con-promocion" class="nota">
                Con la promoción «@conPromocion.Promocion» va en @Formato.Dinero(conPromocion.ImporteSinDescuentoCentavos)@(conPromocion.Cantidad.EnUnidades != 1 && conPromocion.Cantidad.EsPositiva
                    ? $" ({Formato.Dinero((long)Math.Round(conPromocion.ImporteSinDescuentoCentavos / conPromocion.Cantidad.EnUnidades, MidpointRounding.AwayFromZero))} c/u)" : "").
                Si le subes el precio, ya no lleva la promoción.
            </p>
        }
    }
    <label>Motivo@(EsSubida ? " (subir el precio no lo pide)" : MotivoOpcional ? $" (opcional{HastaDondeSinMotivo})" : "") <input id="descuento-motivo" @bind="_motivo" @bind:event="oninput" @onkeydown="AlTeclear" autocomplete="off" placeholder="Cliente frecuente, producto con detalle…" /></label>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    <div class="acciones">
        @if (Venta.Lineas.Any(l => l.TieneDescuento && l.MotivoDescuento != MotivoDelCliente))
        {
            <button class="boton" disabled="@_ocupado" @onclick="QuitarAsync">Quitar los descuentos a mano</button>
        }
        <button class="boton principal" disabled="@_ocupado" @onclick="AplicarAsync">Aplicar (Enter)</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public Venta Venta { get; set; } = null!;

    /// <summary>El renglón seleccionado al abrir la ventana (si había): el descuento es suyo aunque luego se seleccione otro.</summary>
    [Parameter] public VentaLinea? Linea { get; set; }

    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>El cliente registrado del ticket: su descuento ya está aprobado.</summary>
    [Parameter] public ClienteRegistradoDto? ClienteDelTicket { get; set; }

    /// <summary>El descuento o el precio nuevo quedó en el ticket (con sus autorizaciones), o se quitaron: con lo que se avisa.</summary>
    [Parameter] public EventCallback<string> AlTerminar { get; set; }

    /// <summary>
    /// El renglón de la ventana ya no está en el ticket (se quitó), o el ticket ya no es el mismo (se cobró, se puso en espera, se
    /// retomó otro) o se vació: la ventana no se queda abierta con algo que ya no está (dueño, 2026-11-22). Se avisa una vez.
    /// </summary>
    [Parameter] public EventCallback AlPerderSuRenglon { get; set; }

    private sealed record Pendiente(AccionControlada Accion, string Detalle, long Monto);

    /// <summary>Cómo estaba el ticket antes de aplicar: si se cancela la autorización, vuelve a quedar así.</summary>
    private sealed record Estado(List<(VentaLinea Linea, int? Centesimas, long Centavos, string? Motivo)> Lineas, Guid? AutDescuento, Guid? AutCosto);

    private bool _todoElTicket;

    /// <summary>Cómo se escribe el descuento: el precio en que debe quedar, los pesos que se quitan o el porcentaje.</summary>
    private enum Modo { Precio, Monto, Porcentaje }

    /// <summary>En el orden de la pantalla (2026-11-21): «Precio final», «Monto», «Porcentaje».</summary>
    private static readonly Modo[] Modos = [Modo.Precio, Modo.Monto, Modo.Porcentaje];

    private Modo _modo = Modo.Precio;

    private static string NombreDelModo(Modo modo) => modo switch
    {
        Modo.Precio => "Precio final ($)",
        Modo.Monto => "Monto ($)",
        _ => "Porcentaje (%)",
    };

    private static string Clave(Modo modo) => modo switch { Modo.Precio => "precio", Modo.Monto => "monto", _ => "porcentaje" };

    /// <summary>El permiso del descuento de quien entró: de la venta (en cascada) o, sin ella, de su sesión.</summary>
    [CascadingParameter(Name = "PermisosDeSesion")] public IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? PermisosDeSesion { get; set; }

    private PermisoDeSesion? PermisoDelDescuento =>
        PermisosDeSesion?.GetValueOrDefault(AccionControlada.Descuento) ?? Sesion.Permiso(AccionControlada.Descuento);

    /// <summary>
    /// Lo puede dar sin motivo (2026-11-21): tiene el descuento en «Puede» y su permiso no pide motivo. Arriba de su límite pide
    /// autorización, y entonces sí lleva motivo (lo revisa <see cref="RevisarAsync"/> con lo que contesta el servicio).
    /// </summary>
    private bool MotivoOpcional => PermisoDelDescuento is { Nivel: NivelPermiso.Permitido, PideMotivo: false };

    private string HastaDondeSinMotivo => PermisoDelDescuento?.UmbralCentavos is { } umbral
        ? $" hasta {Permisos.TextoMonto(AccionControlada.Descuento, umbral)}"
        : "";

    /// <summary>Lo que se cobra sin descuento en lo que se descuenta (el renglón o el ticket sin las impresiones): de ahí sale el precio final.</summary>
    private long Base => _todoElTicket
        ? Venta.Lineas.Where(l => !l.EsImpresiones).Sum(l => l.ImporteSinDescuentoCentavos)
        : Linea?.ImporteSinDescuentoCentavos ?? 0;
    private string _valor = "";
    private string _motivo = "";
    private string? _error;
    private bool _ocupado;
    private Pendiente? _autorizar;
    private Estado? _antes;

    /// <summary>El motivo del descuento del cliente: ese no se quita aquí ni se revisa con la regla.</summary>
    private string? MotivoDelCliente => ClienteDelTicket is { DescuentoCentesimas: > 0 } c ? c.MotivoDescuento() : null;

    private int? Preaprobado => ClienteDelTicket is { DescuentoCentesimas: > 0 and var d } ? d : null;

    protected override void OnInitialized()
    {
        _todoElTicket = Linea is null or { EsImpresiones: true };
        (_ventaAlAbrir, _conLineasAlAbrir) = (Venta, Venta.Lineas.Count > 0);
    }

    /// <summary>El ticket con el que se abrió la ventana: si la pantalla manda otro, ya no es el suyo.</summary>
    private Venta? _ventaAlAbrir;

    private bool _conLineasAlAbrir;

    private bool _perdida;

    /// <summary>Lo que la ventana atiende ya no está: su renglón, su ticket o lo que el ticket llevaba.</summary>
    private bool SeFueLoSuyo =>
        !ReferenceEquals(Venta, _ventaAlAbrir) || !Venta.EsEditable
        || (Linea is not null && !Venta.Lineas.Contains(Linea))
        || (_conLineasAlAbrir && Venta.Lineas.Count == 0);

    protected override async Task OnParametersSetAsync()
    {
        if (_perdida || _ventaAlAbrir is null || !SeFueLoSuyo)
            return;
        _perdida = true;
        await AlPerderSuRenglon.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await Js.EnfocarAsync("#descuento-valor");
    }

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        // ↑ ↓: el modo de antes o el siguiente, sin dejar el campo (2026-11-21: sin el ratón no se llegaba a «Precio final»).
        if (e.Key is "ArrowUp" or "ArrowDown" && !e.AltKey && !e.CtrlKey)
        {
            var i = Array.IndexOf(Modos, _modo) + (e.Key == "ArrowUp" ? -1 : 1);
            _modo = Modos[(i + Modos.Length) % Modos.Length];
            return;
        }
        if (e.Key != "Enter")
            return;
        // Con el valor y sin el motivo, ahí pasa el cursor: no es un error. Quien puede darlo sin motivo, aplica; subir el precio no lo pide.
        if (!string.IsNullOrWhiteSpace(_valor) && string.IsNullOrWhiteSpace(_motivo) && !MotivoOpcional && !EsSubida)
            await Js.EnfocarAsync("#descuento-motivo");
        else
            await AplicarAsync();
    }

    private async Task AplicarAsync()
    {
        _error = null;
        int? centesimas = null;
        long? monto = null;
        if (_modo == Modo.Porcentaje)
        {
            // El mismo campo que el monto: con la misma regla de los números («1,5» no son 15 %; revisión del PR #138).
            var escrito = _valor.Trim().TrimEnd('%');
            // Sin «$»: en porcentaje, «$5» no son 5 % (revisión de la coma); los pesos van en «Monto ($)».
            if (Formato.LeerCantidad(escrito) is not { } porcentaje || porcentaje <= 0 || porcentaje > 100)
            {
                _error = Formato.ProblemaDePorcentaje(escrito) is { } problema
                    ? problema + (escrito.Contains('$') ? " Para descontar pesos, elige «Monto ($)»." : "")
                    : "Escribe el porcentaje (de más de 0 a 100).";
                return;
            }
            centesimas = (int)Math.Round(porcentaje * 100, MidpointRounding.AwayFromZero);
        }
        else if (_modo == Modo.Precio)
        {
            // El precio en que queda: el descuento es lo que falta para llegar a él desde lo que se cobra sin descuento.
            if (Formato.LeerPesos(_valor) is not { } objetivo || objetivo < 0)
            {
                _error = Formato.ProblemaDePesos(_valor) ?? "Escribe en cuánto debe quedar.";
                return;
            }
            if (objetivo == Base)
            {
                _error = $"Ya se cobra {Formato.Dinero(Base)}: menos es descuento; más, sube el precio.";
                return;
            }
            // Más de lo que se cobra: es subir el precio (Ctrl+E de antes), con su permiso; no es un descuento.
            if (objetivo > Base)
            {
                await SubirAsync(objetivo);
                return;
            }
            monto = Base - objetivo;
        }
        else if (Formato.LeerPesos(_valor) is { } pesos and > 0)
            monto = pesos;
        else
        {
            _error = Formato.ProblemaDePesos(_valor) ?? "Escribe cuánto se descuenta.";
            return;
        }
        var motivo = _motivo.Trim();
        // Sin motivo, solo quien lo puede dar solo (lo revisa RevisarAsync con lo que contesta el servicio).
        if (motivo.Length == 0 && !MotivoOpcional)
        {
            _error = "Escribe el motivo del descuento.";
            await Js.EnfocarAsync("#descuento-motivo");
            return;
        }
        // Su renglón se quitó con la ventana abierta: el descuento no pasa a otro.
        if (!_todoElTicket && !Venta.Lineas.Contains(Linea!))
        {
            _error = "Ese artículo ya no está en el ticket: el descuento puede ir a todo el ticket.";
            return;
        }

        _antes = Guardar();
        try
        {
            if (_todoElTicket)
                Venta.DescontarTicket(centesimas, monto, motivo);
            else
                Venta.DescontarLinea(Linea!, centesimas, monto, motivo);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _error = ex.Message;
            Deshacer();
            return;
        }
        await RevisarAsync();
    }

    // ── Subir el precio (lo que era Ctrl+E) ──────────────────────────────────

    /// <summary>Al artículo, y de uno que es del catálogo: a ese «Precio final» le puede subir el precio.</summary>
    private bool PuedeSubir => !_todoElTicket && Linea is { EsImpresiones: false, VarianteId: not null };

    /// <summary>Lo escrito en «Precio final» pasa de lo que se cobra: se sube el precio, sin motivo.</summary>
    private bool EsSubida => _modo == Modo.Precio && Formato.LeerPesos(_valor) is { } objetivo && objetivo > Base && Base > 0;

    /// <summary>
    /// El precio nuevo (por presentación, con IVA), lo que queda el renglón con él (lo que revisan el permiso y el servicio) y lo escrito,
    /// mientras se pide el permiso o la autorización.
    /// </summary>
    private (long Precio, long Importe, long Objetivo)? _subida;

    /// <summary>
    /// «Precio final» más alto que lo que se cobra: el precio del artículo sube hasta que el renglón quede en eso (con 3 piezas, el
    /// precio de cada una, redondeado al centavo). Lo pide el permiso de «Cambiar precio», sobre lo que queda el renglón, como Ctrl+E;
    /// queda en la venta como precio cambiado (el servicio lo vuelve a revisar al cobrar y lo anota en la bitácora). Sin descuento:
    /// el renglón queda justo en lo escrito.
    /// </summary>
    private async Task SubirAsync(long objetivo)
    {
        if (_todoElTicket || Linea is null)
        {
            _error = Linea is { EsImpresiones: false }
                ? "A todo el ticket solo se le baja: para subir un precio, elige «Al artículo»."
                : "A todo el ticket solo se le baja: para subir un precio, selecciona su renglón (↑ ↓) y abre otra vez con Ctrl+D.";
            return;
        }
        if (Linea.VarianteId is null)
        {
            _error = Venta.ComunNoSube;
            return;
        }
        if (!Venta.Lineas.Contains(Linea))
        {
            _error = "Ese artículo ya no está en el ticket: no se cambió ningún precio.";
            return;
        }
        var precio = Venta.PrecioParaQueQuede(Linea, objetivo);
        _subida = (precio, Linea.Cantidad.Importe(precio), objetivo);
        _antes = null;
        _ocupado = true;
        try
        {
            var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.CambiarPrecio, _subida.Value.Importe));
            switch (decision.Nivel)
            {
                case NivelPermiso.Permitido:
                    await SubidaAsync(null);
                    break;
                case NivelPermiso.RequiereAutorizacion:
                    _autorizar = new Pendiente(AccionControlada.CambiarPrecio,
                        $"Precio de «{Linea.Descripcion}»: {Formato.Dinero(Linea.PrecioCentavos)} → {Formato.Dinero(precio)}", _subida.Value.Importe);
                    break;
                default:
                    _error = "No tienes permiso para cambiar precios.";
                    break;
            }
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>El precio nuevo queda en el renglón, con la autorización si la hubo; el descuento que tenía se va.</summary>
    private async Task SubidaAsync(Guid? autorizacionId)
    {
        if (_subida is not { } subida || Linea is not { } linea || !Venta.EsEditable || !Venta.Lineas.Contains(linea))
        {
            _error = "Ese artículo ya no está en el ticket: no se cambió ningún precio.";
            return;
        }
        var antes = linea.PrecioCentavos;
        try
        {
            Venta.SubirPrecio(linea, subida.Objetivo, autorizacionId);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _error = ex.Message;
            return;
        }
        _subida = null;
        await AlTerminar.InvokeAsync($"Precio de «{linea.Descripcion}»: {Formato.Dinero(antes)} → {Formato.Dinero(subida.Precio)}.");
    }

    /// <summary>Primero la regla del porcentaje; luego el costo. Cada una puede pedir su autorización.</summary>
    private async Task RevisarAsync()
    {
        _ocupado = true;
        try
        {
            var revisar = Venta.DescuentoARevisar(Preaprobado);
            // Sin motivo, solo si lo puede dar solo: lo que pide autorización lleva motivo (2026-11-21), como lo revisa el servicio.
            if (Venta.HayDescuentoSinMotivo)
            {
                var propia = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.Descuento, revisar));
                if (!Permisos.DescuentoSinMotivo(new DecisionPermiso(propia.Nivel, propia.PideMotivo)))
                {
                    Fallar(propia.Nivel == NivelPermiso.NoPermitido ? "No tienes permiso para hacer descuentos." : Permisos.MotivoDelDescuento);
                    await Js.EnfocarAsync("#descuento-motivo");
                    return;
                }
            }
            if (revisar == 0)
                Venta.AutorizacionDescuentoId = null;
            else if (Venta.AutorizacionDescuentoId is null || !_autorizadoDescuento.TryGetValue(Venta.AutorizacionDescuentoId.Value, out var hasta) || revisar > hasta)
            {
                var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.Descuento, revisar));
                switch (decision.Nivel)
                {
                    case NivelPermiso.Permitido:
                        Venta.AutorizacionDescuentoId = null;
                        break;
                    case NivelPermiso.RequiereAutorizacion:
                        _autorizar = new Pendiente(AccionControlada.Descuento, Detalle(), revisar);
                        return;
                    default:
                        Fallar("No tienes permiso para hacer descuentos.");
                        return;
                }
            }
            await RevisarCostoAsync();
        }
        catch (ErrorCaja ex)
        {
            Fallar(ex.Message);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task RevisarCostoAsync()
    {
        var bajoCosto = await Cliente.BajoCostoAsync(new SolicitudBajoCosto(Caja.Id, ArmadoSolicitud.Lineas(Venta), Venta.ClienteId, Venta.MayoreoDeCliente));
        if (bajoCosto.FaltanteCentavos <= 0)
        {
            Venta.AutorizacionBajoCostoId = null;
            await TerminarAsync();
            return;
        }
        var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.VenderBajoCosto,
            bajoCosto.FaltanteCentavos));
        switch (decision.Nivel)
        {
            case NivelPermiso.Permitido:
                Venta.AutorizacionBajoCostoId = null;
                await TerminarAsync();
                break;
            case NivelPermiso.RequiereAutorizacion:
                _autorizar = new Pendiente(AccionControlada.VenderBajoCosto,
                    $"Con descuento quedan debajo del costo: {string.Join(", ", bajoCosto.Lineas)}", bajoCosto.FaltanteCentavos);
                break;
            default:
                Fallar("Ese descuento deja artículos debajo del costo y no tienes permiso para eso.");
                break;
        }
    }

    /// <summary>Las autorizaciones de descuento que ya se dieron en este ticket y hasta qué porcentaje valen.</summary>
    private readonly Dictionary<Guid, long> _autorizadoDescuento = [];

    private async Task AutorizadoAsync(AccionControlada accion, Guid autorizacionId)
    {
        var monto = _autorizar!.Monto;
        _autorizar = null;
        if (accion == AccionControlada.CambiarPrecio)
        {
            await SubidaAsync(autorizacionId);
            return;
        }
        if (accion == AccionControlada.Descuento)
        {
            Venta.AutorizacionDescuentoId = autorizacionId;
            _autorizadoDescuento[autorizacionId] = monto;
            _ocupado = true;
            try
            {
                await RevisarCostoAsync();
            }
            catch (ErrorCaja ex)
            {
                Fallar(ex.Message);
            }
            finally
            {
                _ocupado = false;
            }
        }
        else
        {
            Venta.AutorizacionBajoCostoId = autorizacionId;
            await TerminarAsync();
        }
    }

    /// <summary>Los descuentos a mano se van; el del cliente se queda (para quitarlo, se quita al cliente con Ctrl+L).</summary>
    private async Task QuitarAsync()
    {
        Venta.QuitarDescuentos(salvoMotivo: MotivoDelCliente);
        // Donde el descuento a mano había reemplazado al del cliente, vuelve el del cliente.
        ClienteEnTicket.DevolverDescuento(Venta, ClienteDelTicket);
        if (!Venta.Lineas.Any(l => l.TieneDescuento))
            Venta.AutorizacionBajoCostoId = null;
        await AlTerminar.InvokeAsync(Venta.DescuentoCentavos > 0 ? $"Descuento de {Formato.Dinero(Venta.DescuentoCentavos)}." : "Se quitaron los descuentos.");
    }

    private Task TerminarAsync() => AlTerminar.InvokeAsync(Venta.DescuentoCentavos > 0
        ? $"Descuento de {Formato.Dinero(Venta.DescuentoCentavos)} ({PorcentajeDelDescuento.DelTicket(Venta)})."
        : "Se quitaron los descuentos.");

    private string Detalle() =>
        $"Descuento de {Formato.Dinero(Venta.DescuentoCentavos)}: {string.Join("; ", Venta.Lineas.Where(l => l.TieneDescuento).Select(l => l.MotivoDescuento ?? "sin motivo").Distinct())}";

    private void Fallar(string mensaje)
    {
        _error = mensaje;
        Deshacer();
    }

    private Estado Guardar() => new(
        Venta.Lineas.Select(l => (l, l.DescuentoCentesimas, l.DescuentoCentavos, l.MotivoDescuento)).ToList(),
        Venta.AutorizacionDescuentoId, Venta.AutorizacionBajoCostoId);

    /// <summary>Se deja el panel a medio camino (Esc, la ×), como con su botón «Cancelar»: lo que esperaba autorización no se queda.</summary>
    public void Cancelar()
    {
        if (_autorizar is not null)
            Deshacer();
    }

    /// <summary>Se canceló la autorización (o falló): el ticket queda como estaba.</summary>
    private void Deshacer()
    {
        _autorizar = null;
        _subida = null;
        if (_antes is not { } antes)
            return;
        // El ticket de la ventana, aunque la pantalla ya mande otro (se perdió su renglón); cobrado ya no se toca.
        var venta = _ventaAlAbrir ?? Venta;
        if (!venta.EsEditable)
        {
            _antes = null;
            return;
        }
        foreach (var (linea, centesimas, centavos, motivo) in antes.Lineas)
        {
            if (!venta.Lineas.Contains(linea))
                continue;
            venta.QuitarDescuento(linea);
            if (centesimas is not null || centavos > 0)
                venta.AplicarDescuentoSolicitado(linea, centesimas, centesimas is null ? centavos : null, motivo);
        }
        (venta.AutorizacionDescuentoId, venta.AutorizacionBajoCostoId) = (antes.AutDescuento, antes.AutCosto);
        _antes = null;
    }
}
