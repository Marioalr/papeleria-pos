@* Una compra. Quien recibe cuenta lo que llegó sin ver la nota; quien captura los costos pasa la nota del proveedor, ve
   la comparación (faltó, sobró, no venía) y el margen con el costo nuevo, y la cierra: entra al inventario. Si un producto
   queda debajo del margen mínimo se sugiere precio, pero el precio no cambia solo. *@
@inject ClienteCaja Cliente
@inject ModuloCaja Js

@if (_compra is null)
{
    <p class="@(_error is null ? "" : "error")">@(_error ?? "Cargando…")</p>
    <div class="acciones izquierda"><button class="boton" @onclick="AlVolver">Volver</button></div>
}
else
{
    var c = _compra;
    <p>
        <strong>@c.Folio</strong> · @c.Proveedor@(c.Documento is { } d ? $" · nota {d}" : "") · <span class="etiqueta">@Textos.Estado(c.Estado)</span>
        <span class="nota">
            Recibió @c.Recibio el @c.AbiertaLocal.ToString("dd/MM/yyyy HH:mm")@(c.Costeo is { } quien && c.CerradaLocal is { } f ? $" · la cerró {quien} el {f:dd/MM/yyyy HH:mm}" : "")
        </span>
    </p>

    @switch (c.Estado)
    {
        case EstadoCompra.Recibiendo:
            <ElegirProducto SucursalId="Caja.SucursalId" Accion="Contar" AlContar="ContarAsync" AlNoExiste="NoExiste" />
            @if (_desconocido is { } desconocido)
            {
                <fieldset class="variante">
                    <legend>El código «@desconocido.Codigo» no está en el catálogo</legend>
                    <p class="nota">Cuéntalo aquí: cuando el encargado capture la nota, lo da de alta con ese código.</p>
                    <div class="ficha-producto">
                        <label class="ancho">¿Qué es? <input @bind="desconocido.Descripcion" @bind:event="oninput" @onkeydown="AlTeclearDesconocido" placeholder="Opcional: cuaderno rojo, pluma…" autocomplete="off" /></label>
                        <label>¿Cuántos llegaron? <input id="cantidad-desconocido" class="umbral" inputmode="numeric" @bind="desconocido.Cantidad" @bind:event="oninput" @onkeydown="AlTeclearDesconocido" autocomplete="off" /></label>
                    </div>
                    <div class="acciones izquierda">
                        <button class="boton" @onclick="CancelarDesconocidoAsync">Cancelar</button>
                        <button class="boton principal" disabled="@_ocupado" @onclick="ContarDesconocidoAsync">Contar</button>
                    </div>
                </fieldset>
            }
            <p class="nota">Cada código escaneado suma uno de esa presentación (el de la caja cuenta una caja); «12*código» suma doce. La cantidad se corrige en la tabla.</p>
            <TablaConteo Conteo="c.Conteo" Editable="true" AlCambiar="CambiarConteoAsync" />
            @if (_confirmar == Confirmar.TerminarConteo)
            {
                <p class="aviso-autorizacion">¿Ya contaste todo lo que llegó? Después ya no se puede cambiar el conteo.</p>
                <div class="acciones izquierda">
                    <button class="boton" @onclick="() => _confirmar = Confirmar.Nada">Seguir contando</button>
                    <button class="boton principal" disabled="@_ocupado" @onclick="TerminarConteoAsync">Sí, terminar el conteo</button>
                </div>
            }
            else
            {
                <div class="acciones izquierda">
                    <button class="boton principal" disabled="@(c.Conteo.Count == 0)" @onclick="() => _confirmar = Confirmar.TerminarConteo">Terminar el conteo</button>
                </div>
            }
            break;

        case EstadoCompra.PorCostear when c.Renglones is null:
            <p class="aviso-autorizacion">El conteo terminó. Falta que el encargado capture la nota del proveedor y cierre la compra.</p>
            <TablaConteo Conteo="c.Conteo" />
            break;

        case EstadoCompra.PorCostear:
            @if (_ordenes is { Count: > 0 } || c.OrdenId is not null)
            {
                <div class="filtros-catalogo">
                    <label class="en-linea">¿Viene de una orden de compra?
                        <select value="@(c.OrdenId?.ToString() ?? "")" @onchange="CambiarOrdenAsync">
                            <option value="">No</option>
                            @if (c.OrdenId is { } actual && _ordenes?.All(x => x.Id != actual) != false)
                            {
                                <option value="@actual">@c.Orden</option>
                            }
                            @foreach (var orden in _ordenes ?? [])
                            {
                                <option value="@orden.Id">@orden.Folio del @orden.CreadaLocal.ToString("dd/MM/yyyy") (@orden.Productos productos)</option>
                            }
                        </select>
                    </label>
                </div>
            }
            <h5>Nota del proveedor</h5>
            <div class="acciones izquierda">
                <label class="boton archivo">
                    Cargar el XML o PDF del proveedor…
                    <InputFile accept=".xml,.pdf,application/pdf,text/xml,application/xml" OnChange="CargarDocumentoAsync" />
                </label>
                <span class="nota">El XML de la factura trae todo exacto; del PDF de una nota hay que revisar cada renglón.</span>
            </div>
            @foreach (var documento in c.Documentos ?? [])
            {
                <p class="nota">
                    <strong>@documento.Nombre</strong>@(documento.Folio is { } folio ? $" · folio {folio}" : "")@(documento.TotalCentavos is { } total ? $" · total {Formato.Dinero(total)}" : "")
                    @foreach (var aviso in documento.Avisos)
                    {
                        <br />@aviso
                    }
                </p>
            }
            <RevisionNota Compra="c" Sesion="Sesion" AlCambiar="Actualizar" AlLigar="LigarAsync" AlQuitar="QuitarRenglonAsync" />
            @if (_ligando is { } ligando)
            {
                <fieldset class="variante">
                    <legend>¿Qué producto es «@ligando.Descripcion»?</legend>
                    <p class="nota">
                        En el documento: @Formato.Numero(ligando.CantidadMilesimas / 1000m) @ligando.Unidad por @Formato.Dinero(ligando.ImporteCentavos)@(ligando.CodigoProveedor is { } clave ? $" · clave {clave}" : "").
                        Escanea o busca el producto.
                    </p>
                    <ElegirProducto SucursalId="Caja.SucursalId" Accion="Es este" AlElegir="ElegirParaLigar" />
                    <div class="acciones izquierda"><button class="boton" @onclick="() => _ligando = null">Cancelar</button></div>
                </fieldset>
            }
            else if (_renglon is { } r)
            {
                <fieldset class="variante">
                    <legend>@r.Producto.Descripcion@(r.DelDocumento is { } doc ? $" · en el documento: «{doc}»" : "")</legend>
                    <div class="ficha-producto">
                        <label>Viene por
                            <select @bind="r.PresentacionId">
                                @foreach (var p in r.Producto.Presentaciones)
                                {
                                    <option value="@p.Id">@p.Nombre@(p.EsBase ? "" : $" ({Formato.Numero(p.FactorMilesimas / 1000m)})")</option>
                                }
                            </select>
                        </label>
                        <label>Cantidad <input id="cantidad-renglon" class="umbral" inputmode="decimal" @bind="r.Cantidad" @bind:event="oninput" @onkeydown="AlTeclearRenglon" autocomplete="off" /></label>
                        <label>Importe del renglón (con IVA) <input class="umbral" inputmode="decimal" @bind="r.Importe" @bind:event="oninput" @onkeydown="AlTeclearRenglon" autocomplete="off" /></label>
                        <label>Clave del proveedor <input @bind="r.Clave" @bind:event="oninput" @onkeydown="AlTeclearRenglon" placeholder="Si la trae" autocomplete="off"
                                                          readonly="@(r.DelDocumento is not null)" /></label>
                    </div>
                    <div class="acciones izquierda">
                        <button class="boton" @onclick="() => _renglon = null">Cancelar</button>
                        <button class="boton principal" disabled="@_ocupado" @onclick="AgregarRenglonAsync">@(r.RenglonId is null ? "Agregar a la nota" : "Guardar el renglón")</button>
                    </div>
                </fieldset>
            }
            else
            {
                <ElegirProducto SucursalId="Caja.SucursalId" Accion="Agregar a la nota" AlElegir="ElegirParaRenglon" />
            }

            <h5>Contra lo que llegó</h5>
            <TablaComparacion Comparacion="c.Comparacion!" />
            @if (_confirmar == Confirmar.Cerrar)
            {
                <p class="aviso-autorizacion">
                    Lo contado entra al inventario con el costo de la nota@(c.Comparacion!.Any(x => x.Diferencia != DiferenciaCompra.Ninguna)
                        ? "; las diferencias quedan para reclamarlas al proveedor y se le avisan al dueño" : "").
                </p>
                <div class="acciones izquierda">
                    <button class="boton" @onclick="() => _confirmar = Confirmar.Nada">Todavía no</button>
                    <button class="boton principal" disabled="@_ocupado" @onclick="CerrarAsync">Sí, cerrar la compra</button>
                </div>
            }
            else
            {
                <div class="acciones izquierda">
                    <span class="nota">Total de la nota: <strong>@Formato.Dinero(c.TotalCentavos ?? 0)</strong></span>
                    <button class="boton principal" disabled="@(c.Renglones!.Count == 0 || c.Renglones.Any(x => x.VarianteId is null))"
                            @onclick="() => _confirmar = Confirmar.Cerrar">Cerrar la compra</button>
                </div>
            }
            break;

        case EstadoCompra.Cerrada when c.Comparacion is not null:
            @if (c.Comparacion.Where(x => x.Diferencia != DiferenciaCompra.Ninguna).ToList() is { Count: > 0 } diferencias)
            {
                <p class="aviso-autorizacion">Diferencias contra la nota, para reclamar al proveedor: @string.Join("; ", diferencias.Select(Diferencia))</p>
            }
            @if (c.Comparacion.Any(x => x.PrecioSugeridoCentavos is not null))
            {
                <p class="nota">Con el costo nuevo, algunos productos quedaron debajo del margen mínimo. El precio no cambió: ponlo tú si estás de acuerdo.</p>
            }
            <TablaComparacion Comparacion="c.Comparacion" AlPonerPrecio="PonerPrecioAsync" Ocupado="_ocupado" />
            <h5>Nota del proveedor</h5>
            <TablaNota Renglones="c.Renglones!" Comparacion="c.Comparacion" />
            <p class="nota">Total de la nota: <strong>@Formato.Dinero(c.TotalCentavos ?? 0)</strong></p>
            break;

        case EstadoCompra.Cancelada:
            <p class="aviso-autorizacion">Se canceló: @c.Motivo</p>
            <TablaConteo Conteo="c.Conteo" />
            break;

        default:
            <TablaConteo Conteo="c.Conteo" />
            break;
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_aviso is not null)
    {
        <p class="aviso">@_aviso</p>
    }

    @if (_confirmar == Confirmar.Cancelar)
    {
        <div class="filtros-catalogo">
            <input placeholder="¿Por qué se cancela?" @bind="_motivo" autocomplete="off" />
            <button class="boton" @onclick="() => _confirmar = Confirmar.Nada">No cancelar</button>
            <button class="boton principal" disabled="@_ocupado" @onclick="CancelarAsync">Cancelar la compra</button>
        </div>
    }
    <div class="acciones izquierda">
        <button class="boton" @onclick="AlVolver">Volver a las compras</button>
        @if ((c.Estado == EstadoCompra.Recibiendo || c.Renglones is not null && c.Estado == EstadoCompra.PorCostear) && _confirmar != Confirmar.Cancelar)
        {
            <button class="boton" @onclick="() => _confirmar = Confirmar.Cancelar">Cancelar la compra…</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public Guid CompraId { get; set; }
    [Parameter] public EventCallback AlVolver { get; set; }

    private enum Confirmar { Nada, TerminarConteo, Cerrar, Cancelar }

    private sealed class RenglonEditable(ProductoVentaDto producto, Guid presentacionId)
    {
        public ProductoVentaDto Producto { get; } = producto;
        public Guid PresentacionId { get; set; } = presentacionId;

        /// <summary>Al corregir o ligar un renglón que ya está en la nota.</summary>
        public Guid? RenglonId { get; init; }

        /// <summary>Cómo lo escribe el documento del proveedor, si de ahí vino.</summary>
        public string? DelDocumento { get; init; }

        public string Cantidad { get; set; } = "1";
        public string Importe { get; set; } = "";
        public string Clave { get; set; } = "";
    }

    private CompraDto? _compra;
    private RenglonEditable? _renglon;

    private sealed class Desconocido(string codigo)
    {
        public string Codigo { get; } = codigo;
        public string Descripcion { get; set; } = "";
        public string Cantidad { get; set; } = "1";
    }

    private Desconocido? _desconocido;
    private RenglonCompraDto? _ligando;

    /// <summary>Las órdenes abiertas de este proveedor, para decir de cuál viene (solo quien captura la nota).</summary>
    private List<OrdenResumenDto>? _ordenes;
    private Confirmar _confirmar;
    private string _motivo = "";
    private bool _ocupado;
    private string? _enfocar;
    private string? _error;
    private string? _aviso;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (_enfocar is not { } selector)
            return;
        _enfocar = null;
        await Js.EnfocarAsync(selector);
    }

    protected override async Task OnInitializedAsync()
    {
        await HacerAsync(() => Cliente.CompraAsync(CompraId, Sesion.UsuarioId));
        if (_compra is { Estado: EstadoCompra.PorCostear, Renglones: not null } compra && Sesion.Rol is Rol.Dueno or Rol.Encargado)
        {
            try
            {
                _ordenes = (await Cliente.OrdenesAsync(Caja.SucursalId))
                    .Where(o => o.Estado == EstadoOrden.Abierta && o.ProveedorId == compra.ProveedorId).ToList();
            }
            catch (ErrorCaja)
            {
                // Sin la lista de órdenes se sigue: la orden es opcional.
            }
        }
    }

    private Task CambiarOrdenAsync(ChangeEventArgs e) =>
        HacerAsync(() => Cliente.OrdenDeCompraAsync(CompraId,
            new SolicitudOrdenDeCompra(Sesion.UsuarioId, Guid.TryParse(e.Value?.ToString(), out var orden) ? orden : null)));

    /// <summary>Cada operación regresa la compra como la ve este usuario.</summary>
    private async Task HacerAsync(Func<Task<CompraDto>> operacion, string? aviso = null)
    {
        _ocupado = true;
        (_error, _aviso) = (null, null);
        try
        {
            _compra = await operacion();
            _aviso = aviso;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private Task ContarAsync((ProductoVentaDto Producto, PresentacionDto Presentacion, long Piezas) elegido)
    {
        var actual = _compra!.Conteo.FirstOrDefault(x => x.PresentacionId == elegido.Presentacion.Id)?.CantidadMilesimas ?? 0;
        return HacerAsync(() => Cliente.ContarAsync(CompraId,
            new SolicitudConteo(Sesion.UsuarioId, elegido.Producto.VarianteId, elegido.Presentacion.Id, actual + elegido.Piezas * 1000)));
    }

    private Task CambiarConteoAsync((ConteoCompraDto Linea, long CantidadMilesimas) cambio) =>
        cambio.Linea is { VarianteId: { } variante, PresentacionId: { } presentacion }
            ? HacerAsync(() => Cliente.ContarAsync(CompraId, new SolicitudConteo(Sesion.UsuarioId, variante, presentacion, cambio.CantidadMilesimas)))
            : HacerAsync(() => Cliente.ContarDesconocidoAsync(CompraId,
                new SolicitudConteoDesconocido(Sesion.UsuarioId, cambio.Linea.Codigo!, null, cambio.CantidadMilesimas)));

    private void NoExiste((string Codigo, long Piezas) escaneado)
    {
        (_error, _aviso) = (null, null);
        var actual = _compra?.Conteo.FirstOrDefault(c => c.VarianteId is null && string.Equals(c.Codigo, escaneado.Codigo, StringComparison.OrdinalIgnoreCase));
        _desconocido = new Desconocido(escaneado.Codigo)
        {
            Descripcion = actual?.Producto.StartsWith("Código ", StringComparison.Ordinal) == false ? actual.Producto : "",
            Cantidad = ((actual?.CantidadMilesimas ?? 0) / 1000 + escaneado.Piezas).ToString(CultureInfo.InvariantCulture),
        };
        _enfocar = "#cantidad-desconocido";
    }

    private async Task AlTeclearDesconocido(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ContarDesconocidoAsync();
    }

    private async Task CancelarDesconocidoAsync()
    {
        _desconocido = null;
        await Js.EnfocarAsync("#codigo-compra");
    }

    private async Task ContarDesconocidoAsync()
    {
        if (_desconocido is not { } d)
            return;
        if (!long.TryParse(d.Cantidad, NumberStyles.Integer, CultureInfo.InvariantCulture, out var piezas) || piezas < 0)
        {
            _error = "Escribe cuántos llegaron (piezas enteras).";
            return;
        }
        await HacerAsync(() => Cliente.ContarDesconocidoAsync(CompraId,
            new SolicitudConteoDesconocido(Sesion.UsuarioId, d.Codigo, d.Descripcion, piezas * 1000)));
        if (_error is null)
        {
            _desconocido = null;
            await Js.EnfocarAsync("#codigo-compra");
        }
    }

    private void Actualizar(CompraDto compra) => (_compra, _error, _aviso) = (compra, null, null);

    private async Task TerminarConteoAsync()
    {
        await HacerAsync(() => Cliente.TerminarConteoAsync(CompraId, Sesion.UsuarioId), "Conteo terminado.");
        _confirmar = Confirmar.Nada;
    }

    private void ElegirParaRenglon((ProductoVentaDto Producto, PresentacionDto Presentacion) elegido)
    {
        _renglon = new RenglonEditable(elegido.Producto, elegido.Presentacion.Id);
        _enfocar = "#cantidad-renglon";
    }

    /// <summary>Del documento: el renglón sin ligar pide el producto; uno ya ligado se corrige con el suyo.</summary>
    private async Task LigarAsync(RenglonCompraDto renglon)
    {
        (_error, _aviso, _renglon, _ligando) = (null, null, null, null);
        if (renglon.VarianteId is not { } varianteId)
        {
            _ligando = renglon;
            return;
        }
        try
        {
            if (await Cliente.PorVarianteAsync(varianteId, Caja.SucursalId) is { } producto)
                Corregir(renglon, producto, renglon.PresentacionId ?? producto.Presentacion.Id);
            else
                _ligando = renglon;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private void ElegirParaLigar((ProductoVentaDto Producto, PresentacionDto Presentacion) elegido)
    {
        if (_ligando is not { } renglon)
            return;
        _ligando = null;
        Corregir(renglon, elegido.Producto, elegido.Presentacion.Id);
    }

    private void Corregir(RenglonCompraDto renglon, ProductoVentaDto producto, Guid presentacionId)
    {
        _renglon = new RenglonEditable(producto, presentacionId)
        {
            RenglonId = renglon.Id,
            DelDocumento = renglon.DelDocumento ? renglon.Descripcion : null,
            Cantidad = (renglon.CantidadMilesimas / 1000m).ToString("0.###", CultureInfo.InvariantCulture),
            Importe = (renglon.ImporteCentavos / 100m).ToString("0.00", CultureInfo.InvariantCulture),
            Clave = renglon.CodigoProveedor ?? "",
        };
        _enfocar = "#cantidad-renglon";
    }

    private async Task CargarDocumentoAsync(InputFileChangeEventArgs e)
    {
        (_error, _aviso, _renglon, _ligando) = (null, null, null, null);
        string contenido;
        try
        {
            await using var archivo = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await archivo.CopyToAsync(memoria);
            contenido = Convert.ToBase64String(memoria.ToArray());
        }
        catch (IOException)
        {
            _error = "El archivo pesa más de 10 MB.";
            return;
        }
        var antes = _compra?.Renglones?.Count ?? 0;
        await HacerAsync(() => Cliente.CargarDocumentoCompraAsync(CompraId, new SolicitudDocumentoCompra(Sesion.UsuarioId, e.File.Name, contenido)));
        if (_error is null && _compra?.Renglones is { } renglones)
            _aviso = $"Se leyeron {renglones.Count - antes} renglones de «{e.File.Name}».";
    }

    private async Task AlTeclearRenglon(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AgregarRenglonAsync();
    }

    private async Task AgregarRenglonAsync()
    {
        if (_renglon is not { } r)
            return;
        if (!decimal.TryParse(r.Cantidad.Replace(",", ""), NumberStyles.Number, CultureInfo.InvariantCulture, out var cantidad) || cantidad <= 0)
        {
            _error = "Escribe cuántos dice la nota.";
            return;
        }
        if (Formato.LeerPesos(r.Importe) is not { } importe)
        {
            _error = "Escribe el importe del renglón.";
            return;
        }
        await HacerAsync(() => Cliente.RenglonCompraAsync(CompraId, new SolicitudRenglonCompra(Sesion.UsuarioId, r.RenglonId, r.Producto.VarianteId, r.PresentacionId,
            (long)Math.Round(cantidad * 1000), importe, string.IsNullOrWhiteSpace(r.Clave) ? null : r.Clave)));
        if (_error is null)
            _renglon = null;
    }

    private Task QuitarRenglonAsync(Guid renglonId) => HacerAsync(() => Cliente.QuitarRenglonCompraAsync(CompraId, renglonId, Sesion.UsuarioId));

    private async Task CerrarAsync()
    {
        await HacerAsync(() => Cliente.CerrarCompraAsync(CompraId, Sesion.UsuarioId), "La compra entró al inventario.");
        _confirmar = Confirmar.Nada;
    }

    private async Task CancelarAsync()
    {
        await HacerAsync(() => Cliente.CancelarCompraAsync(CompraId, new SolicitudCancelarCompra(Sesion.UsuarioId, _motivo)));
        if (_error is null)
            _confirmar = Confirmar.Nada;
    }

    private async Task PonerPrecioAsync(ComparacionCompraDto c)
    {
        _ocupado = true;
        (_error, _aviso) = (null, null);
        try
        {
            await Cliente.CambiarMenudeoAsync(new SolicitudPrecioMenudeo(Sesion.UsuarioId, Caja.SucursalId, c.VarianteId, c.PrecioSugeridoCentavos!.Value));
            _compra = await Cliente.CompraAsync(CompraId, Sesion.UsuarioId);
            _aviso = $"«{c.Producto}» quedó a {Formato.Dinero(c.PrecioSugeridoCentavos.Value)}.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static string Diferencia(ComparacionCompraDto c) => c.Diferencia switch
    {
        DiferenciaCompra.Falto => $"faltó {Formato.Numero(c.Nota - c.Contado)} de «{c.Producto}»",
        DiferenciaCompra.Sobro => $"sobró {Formato.Numero(c.Contado - c.Nota)} de «{c.Producto}»",
        DiferenciaCompra.NoLlego => $"no llegó «{c.Producto}»",
        _ => $"llegó «{c.Producto}» sin estar en la nota",
    };
}
