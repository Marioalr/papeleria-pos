@* Productos (F3), una página con lista y detalle (entrega 8, htmlProductos del prototipo). Antes era una ventana encima de
   la venta que abría vacía hasta buscar; ahora abre llena: lo más vendido primero, como la búsqueda de la venta. A la
   izquierda, la búsqueda, los filtros y la lista; a la derecha, el producto elegido con sus datos, sus últimos movimientos
   del kardex, «Etiqueta» (a las etiquetas por imprimir) y «Editar». La ficha de siempre (variantes, presentaciones,
   códigos, precios, kardex y depurar) se abre ahí mismo, con su «Guardar»; Esc la cierra. También «Nuevo producto», el
   mayoreo por revisar, los departamentos (darlos de alta, cambiarles el nombre, desactivarlos) y las decisiones de la
   depuración, en el mismo lado. El filtro y la ficha solo ofrecen los departamentos activos. «Poca existencia» es lo que
   está en su mínimo o debajo: el de su ficha o, sin él, 3 o menos (2026-10-17). En el piloto con eleventa, el
   detalle y la ficha de un producto de eleventa dicen que lo que pone su lectura se cambia allá (la ficha no lo deja
   cambiar). *@
@implements IPagina
@implements IDisposable
@inject ClienteCaja Cliente
@inject ModuloCaja Js

<div class="vn-modulo-pag">
    <section class="vn-col-lista">
        <div class="vn-busca">
            <input id="busca-prod" data-busca placeholder="Nombre, marca o código" autocomplete="off" spellcheck="false" aria-label="Buscar un producto"
                   value="@Estado.Texto" @oninput="EscribiendoAsync" @onkeydown="AlTeclearAsync" />
            <div class="vn-filtros" role="group" aria-label="Filtros">
                <button class="vn-filtro @(Estado.Filtro == FiltroProductos.Todos ? "on" : "")" @onclick="() => FiltrarAsync(FiltroProductos.Todos)">Todos</button>
                <button class="vn-filtro @(Estado.Filtro == FiltroProductos.PorCompletar ? "on" : "")" title="Lo que un cajero dio de alta desde la caja"
                        @onclick="() => FiltrarAsync(FiltroProductos.PorCompletar)">Por completar @(_lista?.PorCompletar)</button>
                <button class="vn-filtro @(Estado.Filtro == FiltroProductos.PocaExistencia ? "on" : "")"
                        title="@($"En su mínimo de inventario o debajo (el de su ficha; sin él, {PocaExistencia.Hasta} o menos), como «Bajos en inventario» en Inventario")"
                        @onclick="() => FiltrarAsync(FiltroProductos.PocaExistencia)">Poca existencia</button>
                @if (Acceso.Puede(AccionControlada.VerUtilidad))
                {
                    <button class="vn-filtro @(Estado.Filtro == FiltroProductos.MargenBajo ? "on" : "")" title="Deja menos que el margen mínimo de Configuración › Inventario"
                            @onclick="() => FiltrarAsync(FiltroProductos.MargenBajo)">Margen bajo</button>
                }
            </div>
            <div class="vn-busca-mas">
                <select aria-label="Departamento" value="@(Estado.Departamento?.ToString() ?? "")" @onchange="DepartamentoAsync">
                    <option value="">Todos los departamentos</option>
                    @foreach (var d in _opciones?.Departamentos ?? [])
                    {
                        <option value="@d.Id">@d.Nombre</option>
                    }
                </select>
                <label><input type="checkbox" checked="@Estado.Inactivos" @onchange="InactivosAsync" /> Con inactivos</label>
            </div>
        </div>
        <div class="vn-items" data-lista>
            @if (_lista is null)
            {
                <p class="vn-lista-nota">@(_errorLista ?? "Cargando…")</p>
            }
            else if (_lista.Productos.Count == 0)
            {
                <p class="vn-lista-nota">@SinResultados</p>
            }
            else
            {
                @for (var i = 0; i < _lista.Productos.Count; i++)
                {
                    var p = _lista.Productos[i];
                    <button id="prod-@i" class="vn-item @(p.ProductoId == Estado.Elegido ? "on" : "") @(p.Activo ? "" : "apagado")" @onclick="AlTocar(p.ProductoId)">
                        <div>
                            <strong>@p.Nombre</strong>
                            <small>
                                @if (p.Codigo is { } codigo)
                                {
                                    <code>@codigo</code>
                                    <span> · </span>
                                }
                                @p.Departamento@(p.Variantes > 1 ? $" · {p.Variantes} variantes" : "")
                                @if (p.PorCompletar)
                                {
                                    <span class="vn-etiq ambar">por completar</span>
                                }
                                @if (!p.Activo)
                                {
                                    <span class="vn-etiq gris">inactivo</span>
                                }
                                @if (Estado.Filtro == FiltroProductos.PocaExistencia && p.Existencia is { } quedan)
                                {
                                    <span class="vn-etiq @(quedan <= 0 ? "rojo" : "ambar")">@(quedan <= 0 ? "Sin existencia" : $"Quedan {Formato.Numero(quedan)}")@(p.Minimo is { } minimo ? $" · mínimo {Formato.Numero(minimo)}" : "")</span>
                                }
                                @if (Estado.Filtro == FiltroProductos.MargenBajo && p.MargenCentesimas is { } margen)
                                {
                                    <span class="vn-etiq rojo">margen @Margen.Texto(margen)</span>
                                }
                            </small>
                        </div>
                        <span class="num">@(p.PrecioCentavos is { } precio ? Formato.Dinero(precio) : "—")</span>
                    </button>
                }
            }
        </div>
        <div class="vn-lista-pie">
            @if (_lista is { } lista)
            {
                <p>
                    @OrdenTexto(lista)
                    @if (lista.Total > lista.Productos.Count)
                    {
                        <button class="vn-enlace" @onclick="VerMasAsync">Ver @Math.Min(Pagina, lista.Total - lista.Productos.Count) más</button>
                    }
                </p>
            }
            <div class="vn-botonera">
                @if (Acceso.Puede(AccionControlada.EditarCatalogo))
                {
                    <button class="vn-boton chico" @onclick="Nuevo"><Ico Nombre="mas" />Nuevo producto</button>
                    <button class="vn-boton chico @(_vista == Vista.Mayoreo ? "on" : "")" @onclick="() => Ver(Vista.Mayoreo)">Mayoreo por revisar</button>
                }
                <button class="vn-boton chico @(_vista == Vista.Departamentos ? "on" : "")" @onclick="() => Ver(Vista.Departamentos)">Departamentos</button>
                <button class="vn-boton chico @(_vista == Vista.Decisiones ? "on" : "")" @onclick="DecisionesAsync">Decisiones de depuración</button>
            </div>
        </div>
    </section>

    <section class="vn-col-detalle">
        @switch (_vista)
        {
            case Vista.Ficha when _opciones is not null:
                <div class="vn-det-cab">
                    <div>
                        <h2>@TituloDeLaFicha</h2>
                        <p>@(Acceso.Puede(AccionControlada.EditarCatalogo) ? "Guarda los cambios con «Guardar»; Esc regresa sin guardar." : "Esc regresa al producto.")</p>
                    </div>
                </div>
                <div class="vn-adentro">
                    <FichaProducto @key="@((object?)_fichaDe ?? "nuevo")" Caja="Caja" Sesion="Sesion" Opciones="_opciones" ProductoId="_fichaDe"
                                   TextoVolver="@(_fichaDe is null && _nuevoGuardado is null ? "Cancelar" : "Volver al producto")" AlVolver="VolverDeLaFichaAsync" AlGuardar="Guardado" />
                </div>
                break;
            case Vista.Mayoreo:
                <div class="vn-det-cab"><div><h2>Mayoreo por revisar</h2><p>El mayoreo de eleventa del que no se supo el paquete. Esc regresa al producto.</p></div></div>
                <div class="vn-adentro">
                    <RevisarMayoreo Caja="Caja" Sesion="Sesion" Captura="_capturaMayoreo" AlAbrir="AbrirFicha" />
                </div>
                break;
            case Vista.Departamentos:
                <Departamentos @ref="_departamentos" Caja="Caja" Sesion="Sesion" Acceso="Acceso" AlCambiar="DepartamentosCambiaronAsync"
                               AlVerProductos="VerDelDepartamentoAsync" />
                break;
            case Vista.Decisiones:
                <div class="vn-det-cab"><div><h2>Decisiones de depuración</h2><p>Lo que se decidió al depurar el catálogo. Esc regresa al producto.</p></div></div>
                <div class="vn-adentro">
                    @if (_decisiones is null)
                    {
                        <p class="nota">@(_errorDetalle ?? "Cargando…")</p>
                    }
                    else if (_decisiones.Count == 0)
                    {
                        <p class="vacia">Todavía no hay decisiones.</p>
                    }
                    else
                    {
                        <p class="nota">Lo que vino de eleventa se repite en la importación final con <code>aplicar-depuracion</code>.</p>
                        <div class="resultados">
                            <table>
                                <thead><tr><th>Fecha</th><th>Decisión</th><th>De eleventa</th></tr></thead>
                                @foreach (var d in _decisiones)
                                {
                                    <tr><td>@d.FechaLocal.ToString("dd/MM/yyyy HH:mm")</td><td>@d.Descripcion</td><td>@(d.DeEleventa ? "Sí" : "No (se repite a mano)")</td></tr>
                                }
                            </table>
                        </div>
                    }
                </div>
                break;
            default:
                @Detalle
                break;
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Lo que puede quien entró (con los de la venta, o los de la sesión).</summary>
    [Parameter, EditorRequired] public PermisosDePagina Acceso { get; set; } = null!;

    /// <summary>La búsqueda, el filtro y el elegido: siguen ahí al ir a la venta y volver.</summary>
    [Parameter, EditorRequired] public ProductosVistos Estado { get; set; } = null!;

    /// <summary>Las etiquetas por imprimir, las de Inventario › Etiquetas.</summary>
    [Parameter, EditorRequired] public EtiquetasPorImprimir Etiquetas { get; set; } = null!;

    /// <summary>«Ir a Etiquetas»: a Inventario › Etiquetas, para imprimirlas.</summary>
    [Parameter] public EventCallback AlIrAEtiquetas { get; set; }

    private enum Vista { Detalle, Ficha, Mayoreo, Decisiones, Departamentos }

    /// <summary>Cuántos trae la lista de una vez; «Ver … más» trae otros tantos.</summary>
    public const int Pagina = 50;

    /// <summary>Lo que se espera al dejar de escribir antes de buscar (el lector no espera: su Enter busca ya).</summary>
    private static readonly TimeSpan PausaAlEscribir = TimeSpan.FromMilliseconds(250);

    private Vista _vista;

    /// <summary>A dónde regresa la ficha: al producto, o al mayoreo por revisar si se abrió desde ahí.</summary>
    private Vista _antesDeLaFicha;

    private OpcionesCatalogoDto? _opciones;
    private MargenesDto? _margenes;
    private ListaProductosDto? _lista;
    private string? _errorLista;
    private int _maximo = Pagina;

    /// <summary>Se movió con ↑ ↓ en la búsqueda: Enter abre la ficha del elegido en lugar de volver a buscar.</summary>
    private bool _navegado;

    private int _secuenciaLista;
    private int _secuenciaDetalle;
    private CancellationTokenSource? _escribiendo;

    // El producto elegido: su ficha (variantes, precios, existencia y, para quien los ve, costos) y la variante que se mira.
    private FichaProductoDto? _ficha;
    private VarianteFichaDto? _variante;
    private List<MovimientoProductoDto>? _movimientos;
    private string? _errorDetalle;
    private string? _aviso;

    /// <summary>El producto de la ficha abierta; vacío: uno nuevo.</summary>
    private Guid? _fichaDe;

    /// <summary>El producto nuevo que se guardó en la ficha: al volver, queda elegido.</summary>
    private Guid? _nuevoGuardado;

    /// <summary>«Editar «Cuaderno…»» si es el elegido; desde el mayoreo por revisar puede ser otro.</summary>
    private string TituloDeLaFicha =>
        _fichaDe is null ? "Nuevo producto"
        : _ficha is { } ficha && ficha.Id == _fichaDe ? Acceso.Puede(AccionControlada.EditarCatalogo) ? $"Editar «{ficha.Nombre}»" : ficha.Nombre
        : Acceso.Puede(AccionControlada.EditarCatalogo) ? "Editar el producto" : "El producto";

    private List<DecisionDepuracionDto>? _decisiones;
    private readonly RevisarMayoreo.Capturado _capturaMayoreo = new();
    private Departamentos? _departamentos;

    protected override async Task OnInitializedAsync()
    {
        if (Estado.Filtro == FiltroProductos.MargenBajo && !Acceso.Puede(AccionControlada.VerUtilidad))
            Estado.Filtro = FiltroProductos.Todos;
        try
        {
            _opciones = await Cliente.OpcionesCatalogoAsync();
            QuitarFiltroDesactivado();
        }
        catch (ErrorCaja ex)
        {
            _errorLista = ex.Message;
        }
        if (Acceso.Puede(AccionControlada.VerUtilidad))
        {
            try
            {
                _margenes = await Cliente.MargenesAsync(Caja.SucursalId);
            }
            catch (ErrorCaja)
            {
                // Sin el mínimo, el margen se ve igual; solo no dice si está debajo.
            }
        }
        await CargarListaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await EnfocarAsync();
    }

    public async Task EnfocarAsync() => await Js.EnfocarAsync("#busca-prod");

    public async Task<bool> CerrarAsync()
    {
        switch (_vista)
        {
            case Vista.Ficha:
                await VolverDeLaFichaAsync();
                return true;
            case Vista.Departamentos:
                // Primero deja lo que se escribía ahí (el alta, un nombre, a dónde pasan sus productos); sin nada, al producto.
                if (_departamentos is not null && await _departamentos.CerrarAsync())
                    return true;
                _vista = Vista.Detalle;
                StateHasChanged();
                return true;
            case Vista.Mayoreo or Vista.Decisiones:
                _vista = Vista.Detalle;
                StateHasChanged();
                return true;
            default:
                return false;
        }
    }

    // ── La lista ────────────────────────────────────────────────────────────

    private async Task CargarListaAsync()
    {
        var secuencia = ++_secuenciaLista;
        try
        {
            var lista = await Cliente.ListaProductosAsync(Caja.SucursalId, Sesion.UsuarioId, Estado.Texto, Estado.Filtro, Estado.Departamento,
                Estado.Inactivos, _maximo);
            if (secuencia != _secuenciaLista)
                return;
            (_lista, _errorLista, _navegado) = (lista, null, false);
        }
        catch (ErrorCaja ex)
        {
            if (secuencia == _secuenciaLista)
                _errorLista = ex.Message;
            return;
        }
        // Como en el prototipo: el elegido si sigue en la lista; si no, el primero.
        var elegido = _lista.Productos.FirstOrDefault(p => p.ProductoId == Estado.Elegido) ?? _lista.Productos.FirstOrDefault();
        if (elegido is null)
        {
            (Estado.Elegido, _ficha, _variante, _movimientos) = (null, null, null, null);
            return;
        }
        if (elegido.ProductoId != _ficha?.Id || _vista == Vista.Detalle)
            await MostrarAsync(elegido.ProductoId);
    }

    private async Task EscribiendoAsync(ChangeEventArgs e)
    {
        Estado.Texto = e.Value?.ToString() ?? "";
        _navegado = false;
        _escribiendo?.Cancel();
        var espera = _escribiendo = new CancellationTokenSource();
        try
        {
            await Task.Delay(PausaAlEscribir, espera.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        _maximo = Pagina;
        await CargarListaAsync();
    }

    /// <summary>
    /// En la búsqueda: ↑ ↓ eligen de la lista (el detalle cambia con cada uno); Enter busca ya (lo que el lector escanea:
    /// el código exacto sale primero y queda elegido), o abre la ficha del elegido si se llegó a él con ↑ ↓.
    /// </summary>
    private async Task AlTeclearAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" or "ArrowUp":
                if (_lista is not { Productos.Count: > 0 } lista)
                    return;
                var actual = lista.Productos.ToList().FindIndex(p => p.ProductoId == Estado.Elegido);
                var nuevo = Math.Clamp(actual + (e.Key == "ArrowDown" ? 1 : -1), 0, lista.Productos.Count - 1);
                _navegado = true;
                await Js.MostrarAsync($"#prod-{nuevo}");
                if (nuevo != actual)
                    await ElegirAsync(lista.Productos[nuevo]);
                break;
            case "Enter":
                if (_navegado && _ficha?.Id is { } abierto)
                {
                    AbrirFicha(abierto);
                    return;
                }
                _escribiendo?.Cancel();
                _maximo = Pagina;
                Estado.Elegido = null;
                await CargarListaAsync();
                // Lo escrito queda seleccionado: el siguiente escaneo lo reemplaza.
                await Js.EnfocarAsync("#busca-prod");
                break;
        }
    }

    private async Task FiltrarAsync(FiltroProductos filtro)
    {
        (Estado.Filtro, _maximo) = (filtro, Pagina);
        await CargarListaAsync();
        await EnfocarAsync();
    }

    private async Task DepartamentoAsync(ChangeEventArgs e)
    {
        (Estado.Departamento, _maximo) = (Guid.TryParse(e.Value?.ToString(), out var d) ? d : null, Pagina);
        await CargarListaAsync();
    }

    /// <summary>El filtro solo ofrece los departamentos activos: si el que se recordaba ya se desactivó, se quita.</summary>
    private void QuitarFiltroDesactivado()
    {
        if (Estado.Departamento is { } d && _opciones is { } opciones && opciones.Departamentos.All(x => x.Id != d))
            Estado.Departamento = null;
    }

    /// <summary>
    /// En Departamentos se dio de alta, se renombró, se desactivó o se reactivó uno: el filtro y la ficha con los de ahora, y
    /// la lista y el elegido al día (pudieron cambiar de departamento).
    /// </summary>
    private async Task DepartamentosCambiaronAsync()
    {
        try
        {
            _opciones = await Cliente.OpcionesCatalogoAsync();
            QuitarFiltroDesactivado();
        }
        catch (ErrorCaja)
        {
            // Se queda con los de antes; la lista se pide igual.
        }
        var antes = _ficha?.Id;
        await CargarListaAsync();
        // La lista vuelve a pedir el detalle solo si cambió el elegido; si es el mismo, pudo pasar a otro departamento.
        if (_ficha?.Id is { } elegido && elegido == antes)
            await MostrarAsync(elegido);
    }

    /// <summary>El número de productos de un departamento, en Departamentos: la lista, solo con los suyos.</summary>
    private async Task VerDelDepartamentoAsync(Guid departamentoId)
    {
        (Estado.Departamento, Estado.Texto, Estado.Filtro, _maximo) = (departamentoId, "", FiltroProductos.Todos, Pagina);
        await CargarListaAsync();
    }

    /// <summary>El nombre del departamento de un producto; si se desactivó, lo dice (ya no se ofrece, pero es el suyo).</summary>
    private string? NombreDepartamento(Guid departamentoId) =>
        _opciones?.Departamentos.FirstOrDefault(d => d.Id == departamentoId)?.Nombre
        ?? (_opciones?.Desactivados?.FirstOrDefault(d => d.Id == departamentoId)?.Nombre is { } desactivado ? $"{desactivado} (desactivado)" : null);

    private async Task InactivosAsync(ChangeEventArgs e)
    {
        (Estado.Inactivos, _maximo) = (e.Value is true, Pagina);
        await CargarListaAsync();
    }

    private async Task VerMasAsync()
    {
        _maximo += Pagina;
        await CargarListaAsync();
    }

    private string SinResultados => Estado.Filtro switch
    {
        FiltroProductos.PorCompletar => "No hay nada por completar.",
        FiltroProductos.PocaExistencia => $"Nada está en su mínimo o debajo (sin mínimo propio, {PocaExistencia.Hasta} o menos).",
        FiltroProductos.MargenBajo => "Nada deja menos que el margen mínimo.",
        _ when Estado.Texto.Trim().Length > 0 => $"Nada coincide con «{Estado.Texto.Trim()}».",
        _ => "No hay productos.",
    };

    /// <summary>«Lo más vendido primero · 50 de 2,345», para que se sepa que hay más y en qué orden van.</summary>
    private string OrdenTexto(ListaProductosDto lista)
    {
        var orden = Estado.Texto.Trim().Length > 0 ? "El código exacto y lo que empieza así primero; luego lo más vendido"
            : lista.PorLoMasVendido ? "Lo más vendido en 90 días primero" : "Por nombre";
        var cuantos = lista.Total > lista.Productos.Count
            ? $"{Formato.Numero(lista.Productos.Count)} de {Formato.Numero(lista.Total)}"
            : lista.Total == 1 ? "1 producto" : $"{Formato.Numero(lista.Total)} productos";
        return $"{orden} · {cuantos}.";
    }

    // ── El detalle ──────────────────────────────────────────────────────────

    private async Task ElegirAsync(ProductoEnListaDto producto) => await ElegirAsync(producto.ProductoId);

    private async Task ElegirAsync(Guid productoId)
    {
        Estado.Elegido = productoId;
        _vista = Vista.Detalle;
        await MostrarAsync(productoId);
    }

    /// <summary>
    /// El clic de cada renglón, uno por producto y el mismo en cada vuelta del dibujo: así no se crea un manejador nuevo por
    /// renglón cada vez que la página se vuelve a pintar (docs/propuesta-interfaz.md, «Pintar menos en Blazor»).
    /// </summary>
    private Func<Task> AlTocar(Guid productoId) =>
        _alTocar.TryGetValue(productoId, out var alTocar) ? alTocar : _alTocar[productoId] = () => ElegirAsync(productoId);

    private readonly Dictionary<Guid, Func<Task>> _alTocar = [];

    /// <summary>La ficha del producto (lo que se ve depende de los permisos: el costo solo para quien lo ve) y sus movimientos.</summary>
    private async Task MostrarAsync(Guid productoId)
    {
        Estado.Elegido = productoId;
        _aviso = null;
        var secuencia = ++_secuenciaDetalle;
        try
        {
            var ficha = await Cliente.FichaProductoAsync(productoId, Caja.SucursalId, Sesion.UsuarioId);
            if (secuencia != _secuenciaDetalle)
                return;
            (_ficha, _errorDetalle) = (ficha, ficha is null ? "Ese producto ya no existe." : null);
            _variante = ficha?.Variantes.OrderByDescending(v => v.Activa).FirstOrDefault();
            _movimientos = null;
            await MovimientosAsync(secuencia);
        }
        catch (ErrorCaja ex)
        {
            if (secuencia == _secuenciaDetalle)
                (_ficha, _variante, _errorDetalle) = (null, null, ex.Message);
        }
    }

    private async Task MovimientosAsync(int secuencia)
    {
        if (_ficha is not { Tipo: TipoProducto.Mercancia } || _variante?.Id is not { } varianteId)
            return;
        try
        {
            var movimientos = await Cliente.UltimosMovimientosAsync(varianteId, Caja.SucursalId);
            if (secuencia == _secuenciaDetalle)
                _movimientos = movimientos;
        }
        catch (ErrorCaja ex)
        {
            if (secuencia == _secuenciaDetalle)
                _errorDetalle = ex.Message;
        }
    }

    private async Task ElegirVarianteAsync(VarianteFichaDto variante)
    {
        (_variante, _movimientos, _aviso) = (variante, null, null);
        await MovimientosAsync(_secuenciaDetalle);
    }

    private void AbrirFicha(Guid productoId)
    {
        if (_vista != Vista.Ficha)
            _antesDeLaFicha = _vista == Vista.Mayoreo ? Vista.Mayoreo : Vista.Detalle;
        (_fichaDe, _vista) = (productoId, Vista.Ficha);
    }

    private void Nuevo()
    {
        _antesDeLaFicha = Vista.Detalle;
        (_fichaDe, _nuevoGuardado, _vista) = (null, null, Vista.Ficha);
    }

    private void Ver(Vista vista) => _vista = vista;

    private async Task DecisionesAsync()
    {
        (_vista, _decisiones, _errorDetalle) = (Vista.Decisiones, null, null);
        try
        {
            _decisiones = await Cliente.DecisionesDepuracionAsync();
        }
        catch (ErrorCaja ex)
        {
            _errorDetalle = ex.Message;
        }
    }

    /// <summary>
    /// De la ficha se regresa a donde se estaba, con la lista y el producto al día (pudo cambiar el nombre o el precio). El
    /// que se editó (o el nuevo que se guardó) queda en el detalle aunque no salga en la lista (la lista trae los primeros).
    /// </summary>
    private async Task VolverDeLaFichaAsync()
    {
        _vista = _antesDeLaFicha;
        var editado = _vista == Vista.Detalle ? _fichaDe ?? _nuevoGuardado : null;
        if (editado is { } id)
            Estado.Elegido = id;
        await CargarListaAsync();
        if (editado is { } elegido && _ficha?.Id != elegido)
            await MostrarAsync(elegido);
        await EnfocarAsync();
    }

    /// <summary>
    /// Se guardó en la ficha: un producto nuevo ya tiene su Id, y al volver queda elegido. La ficha se queda como está (con su
    /// «Guardado»), sin volver a abrirse.
    /// </summary>
    private void Guardado(FichaProductoDto guardado)
    {
        if (_fichaDe is null && guardado.Id is { } id)
            _nuevoGuardado = id;
    }

    private void AgregarEtiqueta()
    {
        if (_ficha is not { } ficha || _variante?.Id is not { } varianteId)
            return;
        Etiquetas.Agregar(varianteId, NombreDe(ficha, _variante), CodigoDe(_variante), 1);
        _aviso = $"«{NombreDe(ficha, _variante)}» va en las etiquetas por imprimir ({Etiquetas.Total}).";
    }

    private static string NombreDe(FichaProductoDto ficha, VarianteFichaDto variante) =>
        variante.Descripcion.Trim().Length > 0 ? $"{ficha.Nombre} {variante.Descripcion}" : ficha.Nombre;

    private static string? CodigoDe(VarianteFichaDto variante) =>
        variante.Presentaciones.Where(p => p.EsBase).SelectMany(p => p.Codigos).Select(c => c.Codigo).FirstOrDefault()
        ?? variante.Presentaciones.SelectMany(p => p.Codigos).Select(c => c.Codigo).FirstOrDefault();

    private RenderFragment Detalle => __builder =>
    {
        if (_ficha is not { } ficha || _variante is not { } variante)
        {
            <p class="nota">@(_errorDetalle ?? (_lista is { Productos.Count: 0 } ? "Nada coincide con la búsqueda." : "Cargando…"))</p>
            return;
        }
        var servicio = ficha.Tipo != TipoProducto.Mercancia;
        var departamento = NombreDepartamento(ficha.DepartamentoId);
        var codigo = CodigoDe(variante);
        var menudeo = variante.Precios.Where(p => p.Presentacion is null).MinBy(p => p.CantidadMinimaMilesimas);
        <div class="vn-det-cab">
            <div>
                <h2>@ficha.Nombre</h2>
                <p>
                    @if (ficha.Variantes.Count == 1 && variante.Descripcion.Trim().Length > 0)
                    {
                        @($"{variante.Descripcion} · ")
                    }
                    @(ficha.Marca ?? "Sin marca") · @(departamento ?? "Sin departamento")
                    @if (codigo is not null)
                    {
                        <span> · </span><code>@codigo</code>
                    }
                    @if (ficha.PorCompletar)
                    {
                        <span class="vn-etiq ambar">por completar</span>
                    }
                    @if (!ficha.Activo || !variante.Activa)
                    {
                        <span class="vn-etiq gris">inactivo</span>
                    }
                </p>
            </div>
            @if (!servicio && Acceso.Ve(AccionControlada.EditarCatalogo))
            {
                <button class="vn-boton" title="La agrega a las etiquetas por imprimir (Inventario › Etiquetas)" @onclick="AgregarEtiqueta">
                    <Ico Nombre="etiqueta" />Etiqueta
                </button>
            }
            <button class="vn-boton primario" @onclick="() => AbrirFicha(ficha.Id!.Value)">
                @(Acceso.Puede(AccionControlada.EditarCatalogo) ? "Editar" : "Ver la ficha")
            </button>
        </div>
        if (_aviso is { } aviso)
        {
            <div class="vn-alerta info">
                <Ico Nombre="etiqueta" />
                <div>
                    <span>@aviso</span>
                    <span><button class="vn-boton chico" @onclick="AlIrAEtiquetas">Ir a Etiquetas</button></span>
                </div>
            </div>
        }
        if (ficha.PorCompletar)
        {
            <div class="vn-alerta"><Ico Nombre="info" /><div><span>Lo dio de alta un cajero desde la caja: complétalo (departamento, marca, presentaciones) con «Editar».</span></div></div>
        }
        if (ficha.EnEleventa is { } enEleventa)
        {
            @* El piloto con eleventa: lo que pone su lectura (el precio, el nombre…) se cambia allá; la ficha dice qué. *@
            <div class="vn-alerta info"><Ico Nombre="info" /><div><span>@enEleventa</span></div></div>
        }
        if (ficha.Variantes.Count > 1)
        {
            <div class="vn-filtros" role="group" aria-label="Variantes">
                <span class="vn-tit">Variante</span>
                @foreach (var v in ficha.Variantes)
                {
                    var esta = v;
                    <button class="vn-filtro @(v.Id == variante.Id ? "on" : "") @(v.Activa ? "" : "apagado")" @onclick="() => ElegirVarianteAsync(esta)">
                        @(v.Descripcion.Trim().Length > 0 ? v.Descripcion : "Sin nombre")
                    </button>
                }
            </div>
        }
        <div class="vn-rejilla">
            <div class="vn-dato">
                <span>Precio al público</span>
                <strong>@(menudeo is null ? "—" : Formato.Dinero(menudeo.PrecioCentavos))</strong>
                <small>@MayoreoTexto(variante)</small>
            </div>
            <div class="vn-dato">
                <span>Existencia</span>
                <strong class="@(!servicio && Baja(variante) ? "bajo" : "")">@(servicio ? "—" : $"{Formato.Numero(variante.Existencia ?? 0)}{Unidad(variante.Unidad)}")</strong>
                <small>@(servicio ? "servicio" : $"según el kardex{MinimoYMaximoTexto(variante)}")</small>
            </div>
            @if (Acceso.Puede(AccionControlada.CostearCompra) || Acceso.Puede(AccionControlada.VerUtilidad))
            {
                <div class="vn-dato">
                    <span>Costo promedio</span>
                    <strong>@(variante.CostoPromedioCentavos is { } costo ? Formato.Dinero((long)Math.Round(costo)) : "—")</strong>
                    <small>@(variante.CostoPromedioCentavos is not null ? "de las compras" : servicio ? "servicio" : "sin existencia, no hay promedio")</small>
                </div>
            }
            @if (Acceso.Puede(AccionControlada.VerUtilidad))
            {
                var minimo = MinimoDe(ficha.DepartamentoId);
                <div class="vn-dato restringido">
                    <span>Margen</span>
                    @if (menudeo is { PrecioCentavos: > 0 } precio && variante.CostoPromedioCentavos is { } costoMargen)
                    {
                        var margen = Margen.Calcular(precio.PrecioCentavos, costoMargen);
                        <strong class="@(margen < minimo ? "bajo" : "")">@Margen.Texto(margen)</strong>
                        <small>@MargenTexto(precio.PrecioCentavos, costoMargen, margen, minimo, variante.Unidad)</small>
                    }
                    else
                    {
                        <strong>—</strong>
                        <small>sin costo todavía</small>
                    }
                </div>
            }
        </div>
        if (servicio)
        {
            <p class="nota">Es un servicio: no lleva inventario ni movimientos.</p>
        }
        else
        {
            <h3 class="vn-sub-titulo">Últimos movimientos</h3>
            if (_movimientos is null)
            {
                <p class="nota">@(_errorDetalle ?? "Cargando…")</p>
            }
            else if (_movimientos.Count == 0)
            {
                <p class="nota">Todavía no tiene movimientos en esta sucursal.</p>
            }
            else
            {
                <table class="vn-tabla">
                    <thead><tr><th>Movimiento</th><th>Cuándo</th><th class="num">Cantidad</th><th class="num">Quedó</th></tr></thead>
                    <tbody>
                        @foreach (var m in _movimientos)
                        {
                            <tr>
                                <td>@Movimiento(m)@(m.Motivo is { Length: > 0 } motivo ? $" · {motivo}" : "")</td>
                                <td>@Cuando(m.FechaLocal)</td>
                                <td class="num">@(m.Cantidad > 0 ? "+" : "−")@Formato.Numero(Math.Abs(m.Cantidad))</td>
                                <td class="num">@Formato.Numero(m.Existencia)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="nota">Los últimos @_movimientos.Count, del más reciente al más viejo. El kardex completo está en la ficha («Ver kardex»).</p>
            }
        }
        if (!Acceso.Puede(AccionControlada.VerUtilidad))
        {
            <p class="nota">El margen y la utilidad los ve quien tiene el permiso «Ver costos, utilidad y margen».</p>
        }
    };

    /// <summary>Si está en su mínimo o debajo (el de su ficha o, sin él, 3 o menos): como «Poca existencia».</summary>
    private static bool Baja(VarianteFichaDto variante) =>
        PocaExistencia.Es(Cantidad.Unidades(variante.Existencia ?? 0),
            variante.MinimoYMaximo?.MinimoMilesimas is { } minimo ? new Cantidad(minimo) : null);

    /// <summary>« · mínimo 5 · máximo 20», con lo que tenga en su ficha; nada si no tiene.</summary>
    private static string MinimoYMaximoTexto(VarianteFichaDto variante) =>
        (variante.MinimoYMaximo?.MinimoMilesimas is { } minimo ? $" · mínimo {Formato.Numero(new Cantidad(minimo).EnUnidades)}" : "")
        + (variante.MinimoYMaximo?.MaximoMilesimas is { } maximo ? $" · máximo {Formato.Numero(new Cantidad(maximo).EnUnidades)}" : "");

    /// <summary>El margen mínimo del departamento, o el general (Configuración › Inventario); vacío si no se pudo leer.</summary>
    private int? MinimoDe(Guid departamentoId) =>
        _margenes is { } m ? m.Departamentos.FirstOrDefault(d => d.DepartamentoId == departamentoId)?.MargenMinimoCentesimas ?? m.MargenMinimoCentesimas : null;

    /// <summary>«utilidad $3.20 por pieza · mínimo 30 %», o «… · debajo del mínimo 30 %».</summary>
    private static string MargenTexto(long precio, decimal costo, int margen, int? minimo, UnidadBase unidad) =>
        $"utilidad {Formato.Dinero(precio - (long)Math.Round(costo))} por {UnidadNombre(unidad)}"
        + (minimo is { } min ? $" · {(margen < min ? "debajo del mínimo" : "mínimo")} {Margen.Texto(min)}" : "");

    /// <summary>«desde 12: $5.50», con las presentaciones con precio propio («Caja 12: $50.00»); o «sin mayoreo».</summary>
    private static string MayoreoTexto(VarianteFichaDto variante)
    {
        var partes = variante.Precios.Where(p => p.Presentacion is null && p.CantidadMinimaMilesimas > Cantidad.Escala)
            .OrderBy(p => p.CantidadMinimaMilesimas)
            .Select(p => $"desde {Formato.Numero(p.CantidadMinimaMilesimas / (decimal)Cantidad.Escala)}: {Formato.Dinero(p.PrecioCentavos)}")
            .Concat(variante.Precios.Where(p => p.Presentacion is not null).Select(p =>
                $"{p.Presentacion}{(p.CantidadMinimaMilesimas > Cantidad.Escala ? $" desde {Formato.Numero(p.CantidadMinimaMilesimas / (decimal)Cantidad.Escala)}" : "")}: {Formato.Dinero(p.PrecioCentavos)}"))
            .ToList();
        return partes.Count == 0 ? "sin mayoreo" : string.Join(" · ", partes);
    }

    private static string Unidad(UnidadBase unidad) => unidad switch
    {
        UnidadBase.Metro => " m",
        UnidadBase.Kilogramo => " kg",
        UnidadBase.Litro => " l",
        _ => "",
    };

    private static string UnidadNombre(UnidadBase unidad) => unidad switch
    {
        UnidadBase.Metro => "metro",
        UnidadBase.Kilogramo => "kilo",
        UnidadBase.Litro => "litro",
        _ => "pieza",
    };

    /// <summary>«Venta A-000123», «Compra C-000041 · Proveedor», «Conteo del día»…</summary>
    private static string Movimiento(MovimientoProductoDto m)
    {
        var tipo = m.Tipo switch
        {
            TipoMovimiento.InventarioInicial => "Inventario inicial",
            TipoMovimiento.Venta => "Venta",
            TipoMovimiento.Devolucion => "Devolución",
            TipoMovimiento.Compra => "Compra",
            TipoMovimiento.Ajuste => "Ajuste",
            TipoMovimiento.Merma => "Merma",
            TipoMovimiento.TraspasoSalida => "Traspaso (salida)",
            TipoMovimiento.TraspasoEntrada => "Traspaso (entrada)",
            TipoMovimiento.ConsumoServicio => "Consumo de un servicio",
            TipoMovimiento.AperturaPaquete => "Abrir un paquete",
            _ => "Conteo",
        };
        return m.Documento is { Length: > 0 } documento ? $"{tipo} {documento}" : tipo;
    }

    /// <summary>«hoy 12:44», «ayer 18:02», «martes 10:15» en la semana; si no, la fecha.</summary>
    private static string Cuando(DateTime fecha)
    {
        var hoy = HoraMexico.ALocal(DateTime.UtcNow).Date;
        var dias = (hoy - fecha.Date).Days;
        var hora = fecha.ToString("HH:mm", CultureInfo.InvariantCulture);
        return dias switch
        {
            0 => $"hoy {hora}",
            1 => $"ayer {hora}",
            > 1 and < 7 => $"{fecha.ToString("dddd", Formato.Mexico)} {hora}",
            _ => fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
        };
    }

    public void Dispose() => _escribiendo?.Cancel();
}
