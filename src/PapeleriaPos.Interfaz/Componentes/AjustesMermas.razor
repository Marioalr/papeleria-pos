@* Ajustes y mermas (F4): corregir la existencia a la que se encontró, o sacar lo dañado, caducado o perdido. Pasan por
   las reglas: si piden al encargado, autoriza en la misma caja. De corrido con el teclado, como «Agregar inventario»: el código,
   la cantidad y Enter; lo que falte es el siguiente campo. Una merma de más de lo que hay se dice en rojo, y su Enter lleva el
   cursor al botón en lugar de registrarla: un cero de más no se deshace. *@
@implements IAsyncDisposable
@inject ClienteCaja Cliente
@inject ModuloCaja Js

@if (_autorizar is { } pendiente)
{
    <AutorizarAccion Accion="pendiente.Accion" Detalle="@pendiente.Detalle" Caja="Caja" Sesion="Sesion"
                     AlAutorizar="a => GuardarAsync(a.Id)" AlCancelar="() => _autorizar = null" />
}
else if (_producto is null)
{
    <p>Escanea o busca el producto.</p>
    <ElegirProducto SucursalId="Caja.SucursalId" Accion="Este" AlElegir="Elegir" CursorEnElCodigo="false" />
}
else
{
    var p = _producto;
    <p>
        <strong>@p.Descripcion</strong>
        <span class="nota"> · existencia en el sistema: @(p.Existencia is { } e ? Formato.Numero(e) : "0") @Unidad(p.Unidad)</span>
    </p>
    <nav class="pestanas">
        <button class="pestana @(_merma ? "" : "activa")" @onclick="() => Pestana(false)">Corregir la existencia</button>
        <button class="pestana @(_merma ? "activa" : "")" @onclick="() => Pestana(true)">Merma</button>
    </nav>
    @if (_merma)
    {
        <div class="ficha-producto">
            <label>¿Cuántos (@Unidad(p.Unidad))? <input id="cantidad-ajuste" data-rafaga class="umbral" inputmode="decimal" autocomplete="off" @bind="_cantidad" @bind:event="oninput" @onkeydown="AlTeclearAsync" /></label>
            <label>Causa
                <select @bind="_causa">
                    @foreach (var c in Enum.GetValues<CausaMerma>())
                    {
                        <option value="@c">@Causa(c)</option>
                    }
                </select>
            </label>
            <label class="ancho">Qué pasó <input id="motivo-ajuste" data-rafaga @bind="_motivo" @bind:event="oninput" @onkeydown="AlTeclearAsync" placeholder="@(_causa == CausaMerma.Otro ? "Obligatorio" : "Opcional")" autocomplete="off" /></label>
        </div>
        @if (Leer(_cantidad) is { } saca and > 0)
        {
            var quedan = (p.Existencia ?? 0) - saca;
            <p class="@(quedan < 0 ? "error" : "nota")">@(quedan < 0 ? "Es más de lo que hay: quedarían" : "Quedarían") @Formato.Numero(quedan) @Unidad(p.Unidad).</p>
        }
        <p class="nota">Sale del inventario a su costo: es pérdida y sale en el resumen del día.</p>
    }
    else
    {
        <div class="ficha-producto">
            <label>Existencia real (@Unidad(p.Unidad)) <input id="cantidad-ajuste" data-rafaga class="umbral" inputmode="decimal" autocomplete="off" @bind="_cantidad" @bind:event="oninput" @onkeydown="AlTeclearAsync" /></label>
            <label class="ancho">Motivo <input id="motivo-ajuste" data-rafaga @bind="_motivo" @bind:event="oninput" @onkeydown="AlTeclearAsync" placeholder="Obligatorio: lo conté, estaba en otro lugar…" autocomplete="off" /></label>
        </div>
        @if (Leer(_cantidad) is { } real)
        {
            var diferencia = real - (p.Existencia ?? 0);
            <p class="nota">@(diferencia == 0 ? "No cambia nada." : $"{(diferencia > 0 ? "Entran" : "Salen")} {Formato.Numero(Math.Abs(diferencia))} {Unidad(p.Unidad)}.")</p>
        }
    }
    <div class="acciones izquierda">
        <button class="boton" @onclick="Otro">Otro producto</button>
        <button id="guardar-ajuste" class="boton principal" disabled="@_ocupado" @onclick="() => GuardarAsync(null)">@(_merma ? "Registrar la merma" : "Ajustar") <kbd>Enter</kbd></button>
    </div>
}
@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_aviso is not null)
{
    <p class="aviso">@_aviso</p>
}

@if (_recientes is { Count: > 0 } recientes)
{
    <h5>Últimos ajustes y mermas</h5>
    <div class="resultados">
        <table>
            <thead><tr><th>Fecha</th><th></th><th>Producto</th><th class="num">Cantidad</th><th class="num">Costo</th><th>Motivo</th><th>Quién</th><th>Autorizó</th></tr></thead>
            @foreach (var a in recientes)
            {
                <tr>
                    <td>@a.FechaLocal.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(a.Tipo == TipoMovimiento.Merma ? "Merma" : "Ajuste")</td>
                    <td>@a.Producto</td>
                    <td class="num">@((a.Cantidad > 0 ? "+" : "") + Formato.Numero(a.Cantidad))</td>
                    <td class="num">@(a.CostoCentavos is { } c ? Formato.Dinero(c) : "")</td>
                    <td>@a.Motivo</td>
                    <td>@a.Usuario</td>
                    <td>@a.Autorizo</td>
                </tr>
            }
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>La tarjeta «Mermas» del inventario: empieza en la merma; «Ajustes», en corregir la existencia.</summary>
    [Parameter] public bool EnMerma { get; set; }

    private sealed record Pendiente(AccionControlada Accion, string Detalle);

    private ProductoVentaDto? _producto;
    private bool _merma;
    private string _cantidad = "";
    private CausaMerma _causa = CausaMerma.Danado;
    private string _motivo = "";
    private Pendiente? _autorizar;
    private List<AjusteInventarioDto>? _recientes;
    private bool _ocupado;
    private string? _error;
    private string? _aviso;
    private string? _enfocar;
    private DotNetObjectReference<AjustesMermas>? _referencia;

    protected override Task OnInitializedAsync()
    {
        _merma = EnMerma;
        return CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
        {
            // Lo que el lector escanea en la cantidad o en el motivo llega aquí (RafagaEnCampo): su Enter no guarda.
            _referencia = DotNetObjectReference.Create(this);
            await Js.RafagasAsync(_referencia);
        }
        if (_enfocar is { } selector)
        {
            _enfocar = null;
            await Js.EnfocarAsync(selector);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.RafagasAsync<AjustesMermas>(null);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // El navegador ya se cerró, o la página ya no tiene caja.js.
        }
        _referencia?.Dispose();
    }

    private async Task CargarAsync()
    {
        try
        {
            _recientes = await Cliente.AjustesAsync(Caja.SucursalId, Sesion.UsuarioId);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private void Elegir((ProductoVentaDto Producto, PresentacionDto Presentacion) elegido) =>
        (_producto, _cantidad, _motivo, _error, _aviso, _enfocar) = (elegido.Producto, "", "", null, null, "#cantidad-ajuste");

    private void Pestana(bool merma) => (_merma, _enfocar) = (merma, "#cantidad-ajuste");

    /// <summary>
    /// Enter en la cantidad o en el motivo guarda. Si falta un motivo obligatorio, el cursor pasa ahí, sin error; y una merma de más
    /// de lo que hay no se registra con Enter: el cursor pasa al botón, para que se vea el aviso y se decida.
    /// </summary>
    private async Task AlTeclearAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _ocupado || _producto is not { } p)
            return;
        if (Leer(_cantidad) is not { } cantidad)
            _enfocar = "#cantidad-ajuste";
        else if (string.IsNullOrWhiteSpace(_motivo) && (!_merma || _causa == CausaMerma.Otro))
        {
            _enfocar = "#motivo-ajuste";
            return;
        }
        else if (_merma && cantidad > (p.Existencia ?? 0))
        {
            _enfocar = "#guardar-ajuste";
            return;
        }
        await GuardarAsync(null);
    }

    /// <summary>
    /// Un código escaneado en la cantidad o en el motivo (caja.js lo reconoce por el ritmo del lector y deja el campo como estaba,
    /// <paramref name="antes"/>): no es un número ni un motivo, es el siguiente producto. Lo escrito para el de antes no se guarda.
    /// Si no es el código de un producto, se dice y el de antes se queda con lo escrito.
    /// </summary>
    [JSInvokable]
    public async Task RafagaEnCampo(string codigo, string campo, string antes)
    {
        if (campo == "cantidad-ajuste")
            _cantidad = antes;
        else if (campo == "motivo-ajuste")
            _motivo = antes;
        try
        {
            if (await Cliente.PorCodigoAsync(codigo, Caja.SucursalId) is { } producto)
                Elegir((producto, producto.Presentacion));
            else
                (_error, _enfocar) = ($"No existe el código «{codigo}».", $"#{campo}");
        }
        catch (ErrorCaja ex)
        {
            (_error, _enfocar) = (ex.Message, $"#{campo}");
        }
        StateHasChanged();
    }

    private void Otro() => (_producto, _error) = (null, null);

    /// <summary>Con la regla de los números del POS: «1,000» son mil y «2,5» no se adivina (antes eran 25; revisión del PR #138).</summary>
    private static decimal? Leer(string texto) => Formato.LeerCantidad(texto) is { } n && n >= 0 ? n : null;

    /// <summary>Si la regla pide autorización, el encargado autoriza y se vuelve a mandar con ella.</summary>
    private async Task GuardarAsync(Guid? autorizacion)
    {
        if (_producto is not { } p || Leer(_cantidad) is not { } cantidad)
        {
            (_error, _enfocar) = (Formato.ComaDeDecimales(_cantidad) ?? "Escribe la cantidad.", "#cantidad-ajuste");
            return;
        }
        _ocupado = true;
        (_error, _aviso) = (null, null);
        var milesimas = (long)Math.Round(cantidad * 1000);
        try
        {
            var hecho = _merma
                ? await Cliente.MermaAsync(new SolicitudMerma(Sesion.UsuarioId, Caja.SucursalId, p.VarianteId, milesimas, _causa, _motivo, autorizacion))
                : await Cliente.AjustarAsync(new SolicitudAjuste(Sesion.UsuarioId, Caja.SucursalId, p.VarianteId, milesimas, _motivo, autorizacion));
            _autorizar = null;
            _aviso = $"{(hecho.Tipo == TipoMovimiento.Merma ? "Merma registrada" : "Existencia ajustada")}: {hecho.Producto} ({(hecho.Cantidad > 0 ? "+" : "")}{Formato.Numero(hecho.Cantidad)}).";
            _producto = null;
            await CargarAsync();
        }
        catch (ErrorCaja ex) when (ex.Codigo == "requiere-autorizacion")
        {
            _autorizar = new Pendiente(_merma ? AccionControlada.Merma : AccionControlada.AjustarInventario,
                _merma ? $"Merma de {Formato.Numero(cantidad)} «{p.Descripcion}»" : $"Ajustar «{p.Descripcion}» a {Formato.Numero(cantidad)}");
        }
        catch (ErrorCaja ex)
        {
            _autorizar = null;
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static string Causa(CausaMerma c) => c switch
    {
        CausaMerma.Danado => "Dañado",
        CausaMerma.Caducado => "Caducado",
        CausaMerma.Perdido => "Perdido",
        _ => "Otro",
    };

    private static string Unidad(UnidadBase u) => u switch
    {
        UnidadBase.Metro => "metros",
        UnidadBase.Kilogramo => "kilos",
        UnidadBase.Litro => "litros",
        _ => "piezas",
    };
}
