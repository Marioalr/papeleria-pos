@* Buscar por nombre en compras, mermas, etiquetas… (ElegirProducto): busca mientras se escribe; flechas para moverse y
   Enter para elegir. En la venta, la búsqueda va debajo del cuadro de captura. Enter elige de la lista de lo que está escrito,
   nunca de la de antes (2026-10-28: el lector escribe y da Enter antes de que acabe la búsqueda, y se elegía un producto de la
   lista de lo que se había escrito antes). *@
@implements IDisposable
@inject ClienteCaja Cliente
@inject ModuloCaja Js

<input id="buscar" data-escaneo class="buscar-texto" placeholder="Nombre, código o marca…" autocomplete="off"
       @bind="_texto" @bind:event="oninput" @bind:after="Programar" @onkeydown="AlTeclear" />

<div class="resultados">
    @if (_resultados.Count == 0 && _texto.Trim().Length >= 2)
    {
        <p class="vacia">@(_buscando ? "Buscando…" : $"Nada coincide con «{_texto}».")</p>
    }
    <table>
        @for (var i = 0; i < _resultados.Count; i++)
        {
            var r = _resultados[i];
            var indice = i;
            <tr id="resultado-@i" class="@(i == _seleccion ? "seleccionada" : "")" @onclick="() => ElegirAsync(indice)">
                <td class="col-codigo">@r.Codigo</td>
                <td>@r.Descripcion</td>
                <td class="num">@Formato.Dinero(r.PrecioCentavos)</td>
                <td class="num">@(r.Existencia is { } e ? Formato.Numero(e) : "—")</td>
            </tr>
        }
    </table>
</div>

@code {
    [Parameter, EditorRequired] public Guid SucursalId { get; set; }
    [Parameter] public EventCallback<Guid> AlElegir { get; set; }

    private string _texto = "";
    private List<ResultadoBusquedaDto> _resultados = [];

    /// <summary>De qué texto son los resultados que se ven: si se escribió algo más, todavía no son de lo escrito.</summary>
    private string _buscado = "";

    private int _seleccion;
    private bool _buscando;
    private CancellationTokenSource? _espera;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await Js.EnfocarAsync("#buscar");
    }

    /// <summary>
    /// Espera a que se deje de teclear un momento antes de buscar. Desde la primera tecla cuenta como buscando, para no
    /// decir «Nada coincide» mientras espera o mientras busca (la primera búsqueda tarda más); una búsqueda que ya
    /// reemplazó otra más nueva no lo apaga.
    /// </summary>
    private async Task Programar()
    {
        _espera?.Cancel();
        _espera = new CancellationTokenSource();
        var token = _espera.Token;
        var texto = _texto.Trim();
        _buscando = texto.Length >= 2;
        try
        {
            await Task.Delay(150, token);
            var resultados = texto.Length >= 2 ? await Cliente.BuscarAsync(texto, SucursalId) : [];
            if (!token.IsCancellationRequested)
                (_resultados, _buscado, _seleccion) = (resultados, texto, 0);
        }
        catch (TaskCanceledException)
        {
            // Se siguió tecleando.
        }
        catch (ErrorCaja)
        {
            if (!token.IsCancellationRequested)
                _resultados = [];
        }
        finally
        {
            if (!token.IsCancellationRequested)
                _buscando = false;
        }
    }

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _resultados.Count > 0:
                _seleccion = Math.Min(_seleccion + 1, _resultados.Count - 1);
                await Js.MostrarAsync($"#resultado-{_seleccion}");
                break;
            case "ArrowUp" when _resultados.Count > 0:
                _seleccion = Math.Max(_seleccion - 1, 0);
                await Js.MostrarAsync($"#resultado-{_seleccion}");
                break;
            case "Enter" when _texto.Trim() != _buscado:
            {
                // Lo que se ve es de lo que estaba escrito antes (el lector escribe y da su Enter antes de que acabe la búsqueda): se
                // busca ya lo escrito y se elige el primero (un código idéntico va primero).
                _espera?.Cancel();
                var texto = _texto.Trim();
                try
                {
                    (_resultados, _buscado, _seleccion, _buscando) = (texto.Length >= 2 ? await Cliente.BuscarAsync(texto, SucursalId) : [], texto, 0, false);
                }
                catch (ErrorCaja)
                {
                    (_resultados, _buscado, _buscando) = ([], texto, false);
                }
                if (_resultados.Count > 0 && _texto.Trim() == texto)
                    await ElegirAsync(0);
                break;
            }
            case "Enter" when _resultados.Count > 0:
                await ElegirAsync(_seleccion);
                break;
        }
    }

    private async Task ElegirAsync(int indice) => await AlElegir.InvokeAsync(_resultados[indice].VarianteId);

    public void Dispose() => _espera?.Cancel();
}
