@* Emblema oficial de Clip («Clip y Hoja») compartido entre la barra de la caja, la entrada y el instalador. *@
<span class="vn-logo" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
        <defs>
            <linearGradient id="@_gradId" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#1D5C7A" />
                <stop offset="100%" stop-color="#123F55" />
            </linearGradient>
        </defs>
        <rect width="100" height="100" rx="22" fill="url(#@_gradId)" />
        <path d="M35,31 V24 A8,8 0 0 1 51,24 V31" fill="none" stroke="#8ECFF0" stroke-width="5.2" stroke-linecap="round" />
        <path d="M33,28 H61 L73,40 V74 A6,6 0 0 1 67,80 H33 A6,6 0 0 1 27,74 V34 A6,6 0 0 1 33,28 Z" fill="#FFFFFF" />
        <path d="M61,28 V36 A4,4 0 0 0 65,40 H73 Z" fill="#8ECFF0" />
        <rect x="35" y="52" width="30" height="4.4" rx="2.2" fill="#23439B" />
        <rect x="35" y="60.5" width="22" height="4.4" rx="2.2" fill="#1D5C7A" />
        <rect x="35" y="69" width="15" height="4.4" rx="2.2" fill="#94A3B8" />
        <path d="M35,28 V39 A8,8 0 0 0 51,39 V25" fill="none" stroke="#FFFFFF" stroke-width="9" stroke-linecap="round" />
        <path d="M35,24 V39 A8,8 0 0 0 51,39 V24" fill="none" stroke="#18B872" stroke-width="5.2" stroke-linecap="round" />
    </svg>
</span>

@code {
    private readonly string _gradId = $"clip-{Guid.NewGuid():N}";
}
