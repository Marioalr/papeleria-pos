    private RenderFragment ControlLogotipo(string renglon) =>
        @<span class="vn-cfg-logo">
            @if (_ticket?.LogoPngBase64 is { } png)
            {
                <img src="data:image/png;base64,@png" alt="El logotipo como sale en el ticket" />
            }
            else
            {
                <span class="vn-cfg-nota">Sin logotipo</span>
            }
            @if (Sesion.Puede(AccionControlada.ConfigurarTicket))
            {
                <label class="vn-boton chico vn-archivo">
                    @(_ticket?.Logo is null ? "Agregar logotipo…" : "Cambiar logotipo…")
                    <InputFile accept="image/png,image/jpeg,image/bmp" OnChange="e => CargarLogotipoAsync(renglon, e)" />
                </label>
                @if (_ticket?.Logo is not null)
                {
                    <button class="vn-boton chico" @onclick="() => QuitarLogotipoAsync(renglon)">Quitar</button>
                }
            }
        </span>;

    private Task CargarLogotipoAsync(string renglon, InputFileChangeEventArgs e) => HacerAsync(renglon, async () =>
    {
        byte[] imagen;
        try
        {
            await using var archivo = e.File.OpenReadStream(maxAllowedSize: LogoTicket.BytesMaximos);
            using var memoria = new MemoryStream();
            await archivo.CopyToAsync(memoria);
            imagen = memoria.ToArray();
        }
        catch (IOException)
        {
            throw new ArgumentException($"El archivo pasa de {LogoTicket.BytesMaximos / 1024 / 1024} MB: usa una imagen más chica.");
        }
        _ticket = await Cliente.GuardarLogoTicketAsync(Caja.Id, new SolicitudLogo(Sesion.UsuarioId, Convert.ToBase64String(imagen)));
    });

    private Task QuitarLogotipoAsync(string renglon) =>
        HacerAsync(renglon, async () => _ticket = await Cliente.GuardarLogoTicketAsync(Caja.Id, new SolicitudLogo(Sesion.UsuarioId, null)));

