                    }
                    <pre>@TicketTexto.Generar(Ejemplo() with { Logo = null })</pre>
                </div>
            }
        </div>;

    /// <summary>Un ticket de ejemplo con lo que se está escribiendo (aunque todavía no se guarde), para «Así sale» y la prueba.</summary>
    private TicketDto Ejemplo() => new(
        "PRUEBA", HoraMexico.ALocal(DateTime.UtcNow), Caja.Nombre, Sesion.Nombre,
        [
            new LineaTicketDto("2", "Pluma punto fino azul", 1200, 2400),
            new LineaTicketDto("1.5 m", "Listón 2.5 cm rojo", 500, 750),
            new LineaTicketDto("1", "Cuaderno profesional raya 100 hojas", 4500, 4500),
        ],
        4, 7650, 1055, [new CobroTicketDto(FormaPago.Efectivo, 7650, 10000, 2350, null)],
        Vista("encabezado", _ticket?.Encabezado), Vista("pie", _ticket?.Pie), _ticket?.Logo);

    /// <summary>Lo escrito, renglón por renglón, aunque todavía no se guarde (si algo no cabe, lo dice su renglón).</summary>
    private List<string> Vista(string campo, IReadOnlyList<string>? guardado) =>
        Escrito(campo, string.Join('\n', guardado ?? [])).Split('\n').Select(r => r.Trim()).Where(r => r.Length > 0).ToList();

    // ── El margen por departamento ──────────────────────────────────────────

    private RenderFragment MargenPorDepartamento =>
        @<table class="vn-cfg-tabla vn-cfg-margenes">
            <thead><tr><th>Departamento</th><th class="num">Margen mínimo</th></tr></thead>
            <tbody>
                @foreach (var d in _margenes?.Departamentos ?? [])
                {
                    var departamento = d;
                    var campo = $"margen-{d.DepartamentoId}";
                    <tr>
                        <td>@d.Departamento</td>
                        <td class="num">
                            <span class="vn-ctl-num">
                                <input id="aj-@campo" inputmode="decimal" placeholder="General" autocomplete="off" aria-label="@($"Margen mínimo de {d.Departamento}")"
                                       disabled="@(!Sesion.Puede(AccionControlada.ConfigurarMargen))"
                                       value="@Escrito(campo, d.MargenMinimoCentesimas is { } c ? Porcentaje(c) : "")"
                                       @oninput="e => Escribir(campo, e.Value, texto => GuardarMargenAsync(departamento.DepartamentoId, texto), MargenDepartamento, conPausa: false)"
                                       @onblur="() => SalirAsync(campo)" @onkeydown="e => AlTeclearAsync(e, campo)" />%
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>;

    private const string MargenDepartamento = "margen-departamento";

    private Task GuardarMargenAsync(Guid departamentoId, string texto)
    {
        var margen = Centesimas(texto);
        return GuardarMargenesAsync(m => m with
        {
            Departamentos = m.Departamentos.Select(d => d.DepartamentoId == departamentoId ? d with { MargenMinimoCentesimas = margen } : d).ToList(),
        });
    }

