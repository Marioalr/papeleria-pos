    /// <summary>El renglón de «Al cobrar»: ahí se dice si no se pudo guardar.</summary>
    private const string AlCobrar = "al-cobrar";

    /// <summary>
    /// Las tres opciones en un segmento, como el «opcion» del prototipo (con tres o menos): la elegida, marcada. Se guarda al
    /// tocarla, como el logotipo; con Tab se pasa de una a otra y Enter o Espacio la eligen.
    /// </summary>
    private RenderFragment ControlAlCobrar =>
        @<span class="vn-segmento" role="radiogroup" aria-label="Al cobrar">
            @foreach (var opcion in Enum.GetValues<TicketAlCobrar>())
            {
                var esta = opcion;
                var elegida = _ticket?.AlCobrar == esta;
                <button id="@($"aj-al-cobrar-{esta.ToString().ToLowerInvariant()}")" role="radio" aria-checked="@(elegida ? "true" : "false")"
                        class="@(elegida ? "on x" : null)" disabled="@(!Sesion.Puede(AccionControlada.ConfigurarTicket))"
                        @onclick="() => GuardarAlCobrarAsync(esta)">@ConfiguracionTicket.Nombre(esta)</button>
            }
        </span>;

    private Task GuardarAlCobrarAsync(TicketAlCobrar alCobrar) =>
        _ticket?.AlCobrar == alCobrar
            ? Task.CompletedTask
            : HacerAsync(AlCobrar, async () => _ticket = await Cliente.GuardarAlCobrarAsync(Caja.Id, new SolicitudAlCobrar(Sesion.UsuarioId, alCobrar)));

    /// <summary>El ticket de prueba en la cola de la impresora: junto a su botón se ve si salió y, si no, «Reintentar».</summary>
    private TrabajoDeImpresion? _prueba;

    private void ImprimirPrueba()
    {
        _avisos.Remove("prueba");
        Error("prueba", null);
        var cola = ColaDeImpresion.De(Impresora);
        if (cola.MuestraVistaPrevia)
        {
            _avisos["prueba"] = "Sin impresora de tickets: así sale, abajo.";
            return;
        }
        // Por la cola de la impresora, como todo lo que se imprime (entrega 5, parte 3): sale después de lo que ya esperaba.
        _prueba = cola.Encolar("Ticket de prueba", DisenoTicket.Armar(Ejemplo()), abrirCajon: false);
    }

