    /// <summary>
    /// La configuración de la tienda con un cambio: va con como estaba en la pantalla («Antes»), y el servicio toma solo lo que
    /// cambió; lo demás se queda como esté allá (lo pudo cambiar otra caja, o el horario en Telegram). Regresa toda, al día.
    /// </summary>
    private async Task GuardarTiendaAsync(Func<ConfiguracionSucursalDto, ConfiguracionSucursalDto> cambio)
    {
        var antes = _tienda!;
        _tienda = await Cliente.GuardarConfiguracionSucursalAsync(Caja.Id, new SolicitudConfiguracionSucursal(Sesion.UsuarioId, cambio(antes), antes));
        await AlCambiar.InvokeAsync();
    }

    // El ticket, el margen y el sugerido se guardan completos: el cambio va sobre como están ahora en el servicio, no sobre
    // lo que se leyó al abrir, para no deshacer lo que otra caja cambió mientras tanto.

    private async Task GuardarTextosAsync(Func<ConfiguracionTicketDto, (IReadOnlyList<string> Encabezado, IReadOnlyList<string> Pie)> cambio)
    {
        var (encabezado, pie) = cambio(await Cliente.ConfiguracionTicketAsync(Caja.SucursalId) ?? _ticket!);
        _ticket = await Cliente.GuardarTextosTicketAsync(Caja.Id, new SolicitudTextosTicket(Sesion.UsuarioId, encabezado, pie));
    }

    private async Task GuardarMargenesAsync(Func<MargenesDto, MargenesDto> cambio) =>
        _margenes = await Cliente.GuardarMargenesAsync(Caja.SucursalId,
            new SolicitudMargenes(Sesion.UsuarioId, cambio(await Cliente.MargenesAsync(Caja.SucursalId))));

    private async Task GuardarSugeridoAsync(Func<ParametrosSugeridoDto, ParametrosSugeridoDto> cambio) =>
        _sugerido = await Cliente.GuardarParametrosSugeridoAsync(Caja.SucursalId,
            new SolicitudParametrosSugerido(Sesion.UsuarioId, cambio(await Cliente.ParametrosSugeridoAsync(Caja.SucursalId))));

    private async Task RapidosGuardadosAsync()
    {
        MarcarGuardado();
        await AlCambiar.InvokeAsync();
    }

    // ── Lo que se escribe, como se guarda ───────────────────────────────────

    private static string Pesos(long centavos) => (centavos / 100m).ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>«$1,500», «1500.50» o vacío (null).</summary>
    private static long? Centavos(string texto) =>
        string.IsNullOrWhiteSpace(texto) ? null : Formato.LeerPesos(texto) ?? throw new ArgumentException($"«{texto.Trim()}» no es una cantidad: escribe los pesos, 500 por ejemplo.");

    private static int Entero(string texto, string que) =>
        int.TryParse(texto.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : throw new ArgumentException($"Escribe {que} con número.");

    private static TimeOnly Hora(string texto) =>
        TimeOnly.TryParseExact(texto.Trim(), ["HH:mm", "HH:mm:ss", "H:mm"], CultureInfo.InvariantCulture, DateTimeStyles.None, out var hora)
            ? hora
            : throw new ArgumentException("Escribe la hora: 08:00, por ejemplo.");

    private static string Porcentaje(int centesimas) => (centesimas / 100m).ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>«30», «30 %» o «12.5» en centésimas; vacío, null.</summary>
    private static int? Centesimas(string texto)
    {
        var limpio = texto.Replace("%", "").Trim();
        if (limpio.Length == 0)
            return null;
        return decimal.TryParse(limpio, NumberStyles.Number, CultureInfo.InvariantCulture, out var p) && p is >= 0 and < 100
            ? (int)Math.Round(p * 100)
            : throw new ArgumentException("El margen va de 0 a 99.99 %.");
    }

    /// <summary>Los renglones del encabezado o del pie, como el servicio: sin los vacíos, y lo que no cabe se dice aquí mismo.</summary>
    private static List<string> RenglonesDe(string texto, string que)
    {
        var renglones = texto.Split('\n').Select(r => r.Trim()).Where(r => r.Length > 0).ToList();
        if (renglones.Count > ConfiguracionTicket.RenglonesMaximos)
            throw new ArgumentException($"El {que.ToLowerInvariant()} va hasta {ConfiguracionTicket.RenglonesMaximos} renglones.");
        if (renglones.FirstOrDefault(r => r.Length > ConfiguracionTicket.Columnas) is { } largo)
            throw new ArgumentException($"«{largo}» tiene más de {ConfiguracionTicket.Columnas} caracteres: no cabe en el renglón.");
        return renglones;
    }

