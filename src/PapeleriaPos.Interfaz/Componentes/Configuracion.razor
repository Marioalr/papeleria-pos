@* La Configuración nueva (entrega 7; docs/propuesta-interfaz.md «Configuración», htmlConfig del prototipo). A la izquierda
   «Buscar un ajuste» y los grupos, cada uno solo para quien tiene su permiso en «Puede»: aquí no se pide autorización, así
   que cada grupo se ve o no se ve, sin candados (en Administración solo hay «Puede» o «No», dueño 2026-10-15). A la
   derecha el grupo con su título, para qué es y «Se guarda solo» o «Guardado a las HH:MM», y cada ajuste en su renglón:
   su nombre, para qué sirve, su alcance («Toda la tienda» o «Solo esta caja») y su control. No hay «Guardar» ni se pide
   usuario y PIN: cada cambio se guarda al momento con los permisos de quien entró (GuardadoAlMomento), y el servicio los
   vuelve a revisar. El buscador encuentra los ajustes de todos los grupos por su nombre, su ayuda o su grupo, y dice el
   grupo de cada uno. Solo lo que existe de verdad: lo del prototipo que todavía no hace nada no está. Sigue siendo la
   ventana que abre la venta; Esc la cierra. *@
@using System.Reflection
@using PapeleriaPos.Nucleo.Configuracion
@inherits GuardadoAlMomento
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IImpresora Impresora
@inject IServiceProvider Servicios

<div class="vn-cfg">
    <nav class="vn-cfg-nav" aria-label="Grupos de la configuración">
        <h1>Configuración</h1>
        <input id="cfg-busca" type="search" placeholder="Buscar un ajuste" aria-label="Buscar un ajuste" autocomplete="off" spellcheck="false"
               value="@_busca" @oninput="e => _busca = e.Value?.ToString() ?? string.Empty" />
        <div class="vn-cfg-grupos" role="tablist" aria-orientation="vertical">
            @foreach (var g in Visibles)
            {
                var grupo = g;
                var activo = !Buscando && grupo == Elegido;
                <button id="cfg-@grupo.Id" role="tab" class="@(activo ? "on" : null)" aria-selected="@(activo ? "true" : "false")"
                        tabindex="@(grupo == Elegido ? 0 : -1)" @onclick="() => Elegir(grupo)" @onkeydown="e => MoverAsync(e, grupo)">
                    <Ico Nombre="@grupo.Icono" />@grupo.Nombre
                </button>
            }
        </div>
    </nav>
    <section class="vn-cfg-main" role="tabpanel" aria-label="@(Buscando ? "Ajustes encontrados" : Elegido?.Nombre)">
        @if (Buscando)
        {
            var hallados = Hallados();
            <div class="vn-cfg-titulo">
                <h2>Ajustes con «@_busca.Trim()»</h2>
                <p>@(hallados.Count == 1 ? "1 encontrado" : $"{hallados.Count} encontrados")</p>
                <span class="vn-guardado" role="status">@Guardado</span>
            </div>
            @if (hallados.Count == 0)
            {
                <p class="vn-cfg-nota">Ningún ajuste se llama así.</p>
            }
            else
            {
                <div class="vn-ajustes">
                    @foreach (var (g, a) in hallados)
                    {
                        @Renglon(g, a, enBusqueda: true)
                    }
                </div>
            }
        }
        else if (Elegido is { } grupo)
        {
            @if (grupo.Titulo)
            {
                <div class="vn-cfg-titulo">
                    <h2>@grupo.Nombre</h2>
                    <p>@grupo.Descripcion</p>
                    @if (grupo.SeGuarda)
                    {
                        <span class="vn-guardado" role="status">@Guardado</span>
                    }
                </div>
            }
            @if (grupo.Ajustes.Any(a => a.Lleva is null && Ve(a)))
            {
                <div class="vn-ajustes">
                    @foreach (var a in grupo.Ajustes.Where(a => a.Lleva is null && Ve(a)))
                    {
                        @Renglon(grupo, a, enBusqueda: false)
                    }
                </div>
            }
            @grupo.Contenido
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;

    /// <summary>Quien entró: lo que ve y lo que cambia sale de sus permisos, y el servicio los vuelve a revisar.</summary>
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Antes de que el instalador cierre la caja (Acerca de › Actualización): lo que la venta tiene que guardar.</summary>
    [Parameter] public EventCallback AntesDeInstalar { get; set; }

    /// <summary>Cambió algo que usa la venta (las fichas de la espera, los rápidos): que lo vuelva a pedir.</summary>
    [Parameter] public EventCallback AlCambiar { get; set; }

    /// <summary>Al cerrar no se pudo guardar lo que quedó escrito: la venta lo dice, porque la ventana ya no está.</summary>
    [Parameter] public EventCallback<string> AlNoGuardar { get; set; }

    /// <summary>Un grupo de la izquierda.</summary>
    /// <param name="Icono">De Iconos.razor.</param>
    private sealed record Grupo(string Id, string Nombre, string Icono)
    {
        public string? Descripcion { get; init; }

        /// <summary>Sus ajustes, en renglones; los que llevan a otro lado (<see cref="Ajuste.Lleva"/>) solo salen al buscar.</summary>
        public IReadOnlyList<Ajuste> Ajustes { get; init; } = [];

        /// <summary>Lo que va debajo de los renglones (o en lugar de ellos): «Usuarios y permisos», las cajas, la bitácora…</summary>
        public RenderFragment? Contenido { get; init; }

        /// <summary>Sin su permiso no aparece; vacío: si se ve alguno de sus ajustes.</summary>
        public Func<bool>? Visible { get; init; }

        /// <summary>Con el título de aquí (no lo trae lo que va adentro).</summary>
        public bool Titulo { get; init; } = true;

        /// <summary>Lo de adentro se guarda solo: el título dice «Se guarda solo» o a qué hora fue el último cambio.</summary>
        public bool SeGuarda { get; init; } = true;
    }

    /// <summary>Un renglón: el ajuste con su nombre, para qué sirve, su alcance y su control.</summary>
    private sealed record Ajuste(string Id, string Titulo)
    {
        public string? Ayuda { get; init; }

        /// <summary>Quien lo cambia; vacío, nadie (solo dice algo).</summary>
        public AccionControlada? Permiso { get; init; }

        /// <summary>Si se ve; vacío: con su permiso («No»: no aparece).</summary>
        public Func<bool>? Ve { get; init; }

        /// <summary>Lo que se escribe, en orden (el horario lleva dos).</summary>
        public IReadOnlyList<Campo> Campos { get; init; } = [];

        /// <summary>Entre un campo y el siguiente («a», en el horario).</summary>
        public string? Entre { get; init; }

        /// <summary>Lo que dice, sin campos (la versión, los días para devolver).</summary>
        public Func<string>? Dice { get; init; }

        /// <summary>A la derecha, en lugar de campos (el logotipo, el ticket de prueba).</summary>
        public RenderFragment? Control { get; init; }

        /// <summary>Debajo del nombre, a todo lo ancho (los rápidos, los sinónimos, el margen por departamento).</summary>
        public RenderFragment? Bloque { get; init; }

        /// <summary>Solo para el buscador: lleva a ese grupo, donde está lo que se busca (en «Usuarios y permisos», por ejemplo).</summary>
        public string? Lleva { get; init; }

        /// <summary>Mientras no se tiene lo guardado: por qué («Cargando…» o el error). Vacío: listo.</summary>
        public Func<string?>? NoListo { get; init; }

        /// <summary>Más palabras con las que lo encuentra el buscador.</summary>
        public string? Palabras { get; init; }

        public bool SoloEstaCaja { get; init; }
    }

    /// <summary>Un campo de un ajuste: lo guardado, cómo se guarda lo escrito y cómo se ve.</summary>
    /// <param name="Guardar">Recibe el texto tal cual; si no sirve, lanza <see cref="ArgumentException"/> con el porqué.</param>
    private sealed record Campo(string Id, Func<string> Guardado, Func<string, Task> Guardar)
    {
        public string Clase { get; init; } = "vn-ctl-num";
        public string Tipo { get; init; } = "text";
        public string? Modo { get; init; }
        public string? Antes { get; init; }
        public string? Despues { get; init; }
        public string? Marcador { get; init; }
        public int? Largo { get; init; }

        /// <summary>Más de cero: un área de varios renglones (el encabezado y el pie del ticket).</summary>
        public int Renglones { get; init; }

        /// <summary>Para el lector de pantalla, si no basta el nombre del ajuste («De», «A»).</summary>
        public string? Etiqueta { get; init; }

        /// <summary>Texto libre (un nombre, el encabezado): también se guarda tras una pausa al escribir. Un número, al salir.</summary>
        public bool ConPausa { get; init; }
    }

    private List<Grupo> _grupos = [];
    private string _elegido = "";
    private string _busca = "";

    private ConfiguracionSucursalDto? _tienda;
    private ConfiguracionTicketDto? _ticket;
    private MargenesDto? _margenes;
    private ParametrosSugeridoDto? _sugerido;
    private string? _errorTienda;
    private string? _errorTicket;
    private string? _errorMargenes;
    private string? _errorSugerido;
    private string? _versionPrincipal;

    /// <summary>Lo que salió bien y no es un cambio (el ticket de prueba), junto a su renglón.</summary>
    private readonly Dictionary<string, string> _avisos = [];

    private bool Buscando => _busca.Trim().Length > 0;

    private List<Grupo> Visibles => _grupos.Where(EsVisible).ToList();

    /// <summary>El grupo que se ve; si el elegido no es de quien entró (o todavía no se elige), el primero.</summary>
    private Grupo? Elegido
    {
        get
        {
            var visibles = Visibles;
            return visibles.FirstOrDefault(g => g.Id == _elegido) ?? visibles.FirstOrDefault();
        }
    }

    /// <summary>La caja de prueba se actualiza desde aquí (Acerca de › Actualización).</summary>
    private bool HayActualizacion => Servicios.GetService<GitHubPrueba>() is not null;

    /// <summary>
    /// Si la venta ofrece la Configuración (su pestaña y «/»): con algún grupo con su permiso, o en la caja de prueba (para
    /// actualizarla). Las mismas reglas que los grupos de aquí.
    /// </summary>
    /// <param name="puede">Lo puede hacer quien entró, sin pedir autorización.</param>
    public static bool HayQueVer(Func<AccionControlada, bool> puede, bool hayActualizacion) =>
        hayActualizacion
        || new[]
        {
            AccionControlada.ConfigurarTienda, AccionControlada.ConfigurarTicket, AccionControlada.EditarCatalogo, AccionControlada.ConfigurarImpresora,
            AccionControlada.ConfigurarMargen, AccionControlada.VerUtilidad, AccionControlada.PedirCompra, AccionControlada.EditarReglas,
            AccionControlada.ConfigurarTelegram, AccionControlada.AdministrarCajas, AccionControlada.ConsultarBitacora,
        }.Any(puede);

    protected override async Task OnInitializedAsync()
    {
        _grupos = Armar();
        await Task.WhenAll(
            CargarAsync(async () => _tienda = await Cliente.ConfiguracionSucursalAsync(Caja.SucursalId), e => _errorTienda = e),
            CargarAsync(async () => _ticket = await Cliente.ConfiguracionTicketAsync(Caja.SucursalId), e => _errorTicket = e),
            VeMargen ? CargarAsync(async () => _margenes = await Cliente.MargenesAsync(Caja.SucursalId), e => _errorMargenes = e) : Task.CompletedTask,
            Sesion.Puede(AccionControlada.PedirCompra)
                ? CargarAsync(async () => _sugerido = await Cliente.ParametrosSugeridoAsync(Caja.SucursalId), e => _errorSugerido = e)
                : Task.CompletedTask,
            CargarAsync(async () => _versionPrincipal = await Cliente.VersionDeLaPrincipalAsync(), _ => { }));
    }

    /// <summary>Al abrir, el cursor en «Buscar un ajuste»: se escribe para buscar, y con Tab se pasa a los grupos y a sus ajustes.</summary>
    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await Js.EnfocarAsync("#cfg-busca");
    }

    private static async Task CargarAsync(Func<Task> cargar, Action<string> error)
    {
        try
        {
            await cargar();
        }
        catch (ErrorCaja ex)
        {
            error(ex.Message);
        }
    }

    // ── Lo que ve quien entró ───────────────────────────────────────────────

    private bool EsVisible(Grupo g) => g.Visible?.Invoke() ?? g.Ajustes.Any(a => a.Lleva is null && a.Permiso is not null && Ve(a));

    /// <summary>
    /// Con su permiso en «Puede»: sin él no aparece, también con «Con autorización», porque aquí no se pide (en Administración
    /// ni existe). Solo el margen se ve sin poder cambiarlo: con «Ver costos, utilidad y margen».
    /// </summary>
    private bool Ve(Ajuste a) => a.Ve?.Invoke() ?? (a.Permiso is not { } permiso || Sesion.Puede(permiso));

    /// <summary>Lo cambia quien entró: con su permiso en «Puede».</summary>
    private bool Cambia(Ajuste a) => a.Permiso is { } permiso && Sesion.Puede(permiso);

    /// <summary>Para lo que se ve sin poder cambiarlo (el margen): quién sí, sin ofrecer pedirle autorización.</summary>
    private string QuienLoCambia(Ajuste a)
    {
        if (a.Permiso is not { } permiso || Sesion.Puede(permiso) || a.Campos.Count == 0 && a.Control is null)
            return "";
        var autorizan = Sesion.Permiso(permiso)?.Autorizan ?? [];
        return autorizan.Count > 0 ? $" · lo cambia {Textos.Quien(autorizan)}" : $" · lo cambia quien tiene «{Permisos.Nombre(permiso)}»";
    }

    /// <summary>El margen lo ve quien ve la utilidad o quien lo pone.</summary>
    private bool VeMargen => Sesion.Puede(AccionControlada.VerUtilidad) || Sesion.Puede(AccionControlada.ConfigurarMargen);

    private void Elegir(Grupo grupo)
    {
        (_elegido, _busca) = (grupo.Id, "");
        _ = RefrescarAsync();
    }

    /// <summary>
    /// Al cambiar de grupo, lo de la tienda y el ticket como están ahora en el servicio (lo pudo cambiar otra caja, o el
    /// horario en Telegram): lo que se enseña no se queda con lo que se leyó al abrir.
    /// </summary>
    private Task RefrescarAsync() => EnSuTurnoAsync(async () =>
    {
        // Después de lo que se está guardando (al salir de un campo para elegir otro grupo): así no regresa lo de antes.
        try
        {
            var tienda = await Cliente.ConfiguracionSucursalAsync(Caja.SucursalId);
            var ticket = await Cliente.ConfiguracionTicketAsync(Caja.SucursalId);
            (_tienda, _ticket) = (tienda, ticket ?? _ticket);
        }
        catch (ErrorCaja)
        {
            // Sin conexión: se queda lo que había; al guardar se dice.
        }
        if (!Cerrado)
            StateHasChanged();
    });

    protected override Task NoSeGuardoAlCerrarAsync(IReadOnlyList<string> errores) => NoGuardadoAsync(string.Join(" ", errores));

    /// <summary>Lo que no se pudo guardar al cerrar, aquí o en lo de adentro (los rápidos, la impresora): lo dice la venta.</summary>
    private Task NoGuardadoAsync(string porQue) => AlNoGuardar.InvokeAsync($"No se guardó lo último que escribiste en la Configuración: {porQue}");

    /// <summary>↑ ↓ (Inicio y Fin) recorren los grupos: Tab pasa del grupo a sus ajustes, sin recorrer todos los demás.</summary>
    private async Task MoverAsync(KeyboardEventArgs e, Grupo grupo)
    {
        var visibles = Visibles;
        var i = visibles.IndexOf(grupo);
        var destino = e.Key switch
        {
            "ArrowDown" => Math.Min(i + 1, visibles.Count - 1),
            "ArrowUp" => Math.Max(i - 1, 0),
            "Home" => 0,
            "End" => visibles.Count - 1,
            _ => i,
        };
        if (destino == i)
            return;
        Elegir(visibles[destino]);
        await Js.EnfocarAsync($"#cfg-{visibles[destino].Id}");
    }

    /// <summary>
    /// Los ajustes de los grupos que se ven cuyo nombre, ayuda o grupo dicen todas las palabras buscadas (sin importar
    /// acentos ni mayúsculas), en el orden de los grupos.
    /// </summary>
    private List<(Grupo Grupo, Ajuste Ajuste)> Hallados()
    {
        var palabras = Texto.Normalizar(_busca).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return Visibles
            .SelectMany(g => g.Ajustes.Where(Ve).Select(a => (Grupo: g, Ajuste: a)))
            .Where(x => Texto.Normalizar($"{x.Ajuste.Titulo} {x.Ajuste.Ayuda} {x.Grupo.Nombre} {x.Ajuste.Palabras}") is var donde
                && palabras.All(p => donde.Contains(p, StringComparison.Ordinal)))
            .ToList();
    }

    // ── Un renglón ───────────────────────────────────────────────────────────

    private RenderFragment Renglon(Grupo g, Ajuste a, bool enBusqueda) =>
        @<div @key="a.Id" class="vn-ajuste @(a.Bloque is null ? null : "bloque")">
            <div class="vn-ajuste-txt">
                <strong>@a.Titulo</strong>
                @if (enBusqueda || a.Ayuda is not null)
                {
                    <small>@(enBusqueda ? $"{g.Nombre}{(a.Ayuda is { } ayuda ? $" · {ayuda}" : "")}" : a.Ayuda)</small>
                }
                <span class="vn-ajuste-meta">@(a.SoloEstaCaja ? "Solo esta caja" : "Toda la tienda")@QuienLoCambia(a)</span>
                @if (ErrorDe(a.Id) is { } error)
                {
                    <span class="vn-ajuste-error" role="alert">@error</span>
                }
                else if (_avisos.GetValueOrDefault(a.Id) is { } aviso)
                {
                    <span class="vn-ajuste-aviso" role="status">@aviso</span>
                }
            </div>
            @if (a.Lleva is { } lleva)
            {
                <div><button class="vn-boton chico" @onclick="() => Ir(lleva)">Abrir «@NombreDe(lleva)»</button></div>
            }
            else if (a.NoListo?.Invoke() is { } noListo)
            {
                <span class="vn-cfg-nota">@noListo</span>
            }
            else if (a.Control is { } control)
            {
                <div class="vn-ajuste-ctl">@control</div>
            }
            else if (a.Dice is { } dice)
            {
                <span class="vn-ajuste-dice">@dice()</span>
            }
            else if (a.Campos.Count > 0)
            {
                <div class="vn-ajuste-ctl">
                    @for (var i = 0; i < a.Campos.Count; i++)
                    {
                        var campo = a.Campos[i];
                        @if (i > 0 && a.Entre is { } entre)
                        {
                            <span class="vn-ctl-entre">@entre</span>
                        }
                        @Control(a, campo)
                    }
                </div>
            }
            @if (a.Bloque is { } bloque && a.Lleva is null && a.NoListo?.Invoke() is null)
            {
                <div class="vn-ajuste-bloque">@bloque</div>
            }
        </div>;

    private RenderFragment Control(Ajuste a, Campo c) =>
        @<span class="@c.Clase">
            @c.Antes
            @if (c.Renglones > 0)
            {
                <textarea id="aj-@c.Id" rows="@c.Renglones" spellcheck="false" aria-label="@(c.Etiqueta ?? a.Titulo)" disabled="@(!Cambia(a))"
                          value="@Escrito(c.Id, c.Guardado())" @oninput="e => Escribir(c.Id, e.Value, c.Guardar, a.Id, c.ConPausa)"
                          @onblur="() => SalirAsync(c.Id)"></textarea>
            }
            else
            {
                <input id="aj-@c.Id" type="@c.Tipo" inputmode="@c.Modo" maxlength="@c.Largo" placeholder="@c.Marcador" autocomplete="off"
                       spellcheck="false" aria-label="@(c.Etiqueta ?? a.Titulo)" disabled="@(!Cambia(a))" value="@Escrito(c.Id, c.Guardado())"
                       @oninput="e => Escribir(c.Id, e.Value, c.Guardar, a.Id, c.ConPausa)" @onblur="() => SalirAsync(c.Id)"
                       @onkeydown="e => AlTeclearAsync(e, c.Id)" />
            }
            @c.Despues
        </span>;

    private string NombreDe(string grupo) => _grupos.FirstOrDefault(g => g.Id == grupo)?.Nombre ?? grupo;

    private void Ir(string grupo)
    {
        (_elegido, _busca) = (grupo, "");
        _ = RefrescarAsync();
    }

    // ── Los grupos ───────────────────────────────────────────────────────────

    private List<Grupo> Armar() =>
    [
        new("tienda", "Tienda", "tienda")
        {
            Descripcion = "Sus datos: el nombre sale en la entrada de cada caja; el logotipo, en el ticket.",
            Ajustes =
            [
                TextoTienda("nombre", "Nombre de la tienda", $"Sale en la entrada de cada caja. Vacío: el de la sucursal, «{Caja.Sucursal}».",
                    ConfiguracionSucursal.LargoNombreTienda, c => c.NombreTienda, (c, v) => c with { NombreTienda = v }),
                TextoTienda("direccion", "Dirección", null, ConfiguracionSucursal.LargoDireccion, c => c.Direccion, (c, v) => c with { Direccion = v }),
                TextoTienda("telefono", "Teléfono", null, ConfiguracionSucursal.LargoTelefono, c => c.Telefono, (c, v) => c with { Telefono = v }, "tel"),
                new("horario", "Horario")
                {
                    Ayuda = "Abrir un turno fuera de él avisa al dueño, y de noche no se avisa que la impresora no responde.",
                    Permiso = AccionControlada.ConfigurarTienda,
                    NoListo = NoListoTienda,
                    Entre = "a",
                    Campos =
                    [
                        new("horario-de", () => _tienda!.HoraApertura.ToString("HH:mm", CultureInfo.InvariantCulture),
                            texto => GuardarTiendaAsync(c => c with { HoraApertura = Hora(texto) })) { Tipo = "time", Etiqueta = "La tienda abre a las" },
                        new("horario-a", () => _tienda!.HoraCierre.ToString("HH:mm", CultureInfo.InvariantCulture),
                            texto => GuardarTiendaAsync(c => c with { HoraCierre = Hora(texto) })) { Tipo = "time", Etiqueta = "La tienda cierra a las" },
                    ],
                },
                Logotipo("logo-tienda"),
            ],
        },
        new("venta", "Venta y cobro", "efectivo")
        {
            Descripcion = "Cómo se vende en todas las cajas.",
            Ajustes =
            [
                new("fichas", "Tickets en espera a la vista")
                {
                    Ayuda = "Cuántas fichas junto a «Poner en espera»; los demás van en «Más». No hay límite, y se guardan en la caja: sobreviven a un apagón.",
                    Permiso = AccionControlada.ConfigurarTienda,
                    NoListo = NoListoTienda,
                    Palabras = "espera fichas F6 F5",
                    Campos =
                    [
                        new("fichas", () => _tienda!.FichasEnEspera.ToString(CultureInfo.InvariantCulture),
                            texto => GuardarTiendaAsync(c => c with { FichasEnEspera = Entero(texto, $"cuántas fichas (de 0 a {ConfiguracionSucursal.FichasEnEsperaMaximo})") }))
                        {
                            Modo = "numeric",
                        },
                    ],
                },
                new("rapidos", "Rápidos")
                {
                    Ayuda = $"Lo que no tiene código de barras y se vende todo el día, con Alt+1 a Alt+{Rapido.Maximo}. Con un número en el cuadro, agregan esa cantidad.",
                    Permiso = AccionControlada.ConfigurarTienda,
                    Palabras = "Alt copia CURP botones servicios",
                    Bloque = @<RapidosConfiguracion Caja="Caja" Sesion="Sesion" AlGuardar="RapidosGuardadosAsync" AlNoGuardar="NoGuardadoAsync" />,
                },
                new("sinonimos", "Sinónimos de la búsqueda")
                {
                    Ayuda = "Lo que la gente pide con otro nombre: al escribir una palabra en la caja también sale lo que se llama con otra.",
                    Permiso = AccionControlada.EditarCatalogo,
