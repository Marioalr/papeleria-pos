    /// <summary>
    /// Lo que tardan los escaneos, del Enter a la línea en pantalla, y la copia del catálogo contra la que se escanea
    /// (entrega 5): para el dueño o quien instala la caja.
    /// </summary>
    private string TextoDelEscaneo
    {
        get
        {
            var medida = (Servicios.GetService<RendimientoCaja>()?.Escaneos ?? new MedidaEscaneos(0, 0, 0, 0)).Texto;
            return Cliente.Foto is { } foto
                ? $"{medida} Se escanea contra la copia del catálogo de esta caja: versión {foto.Version}, "
                  + $"{foto.Productos.ToString("#,##0", Formato.Mexico)} productos."
                : $"{medida} Esta caja todavía no tiene su copia del catálogo: el escaneo le pregunta a la caja principal.";
        }
    }

    /// <summary>«Papelería POS 1.0.0 · cambio abc1234», y la de la caja principal si es otra.</summary>
    private string Version
    {
        get
        {
            var informativa = typeof(Configuracion).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";
            var (numero, cambio) = informativa.Split('+') is [var n, var c, ..] ? (n, c[..Math.Min(7, c.Length)]) : (informativa, null);
            var texto = $"Papelería POS {numero}{(cambio is null ? "" : $" · cambio {cambio}")}";
            return _versionPrincipal is { } principal && principal != numero ? $"{texto} · la caja principal tiene la {principal}" : texto;
        }
    }
