@* La temporada, a la vista mientras corre (entrega 13, docs/propuesta-interfaz.md, «Lo que se señala: exhibidos y temporada»;
   el chip «temporada» del prototipo): arriba de la venta, un chip con su nombre («Todos Santos») que abre Ctrl+M en ella. Al
   terminar sus fechas se oculta solo, aunque nadie toque la caja (se revisa cada minuto). Sale de la copia de esta caja, sin la
   red. Se pinta solo cuando cambia lo suyo: la venta se vuelve a pintar con cada escaneo (entrega 5, parte 3, «Pintar menos»). *@
@implements IDisposable
@inject ClienteCaja Cliente
@inject IServiceProvider Servicios

@if (Visible)
{
    @foreach (var temporada in _corren)
    {
        var esta = temporada;
        <button class="vn-chip-estado vn-chip-temporada" title="@($"{temporada.Nombre}: sus productos con foto y precio (Ctrl+M)")"
                @onclick="() => AlAbrir.InvokeAsync(esta.Id)">
            <Ico Nombre="reloj" /><span class="vn-chip-nombre">@temporada.Nombre</span> <kbd>Ctrl+M</kbd>
        </button>
    }
}

@code {
    /// <summary>Solo en la venta: en las páginas (Productos, Inventario, Clientes) no sale, como en el prototipo.</summary>
    [Parameter] public bool Visible { get; set; } = true;

    /// <summary>Se tocó el chip de esa temporada: Ctrl+M en ella.</summary>
    [Parameter] public EventCallback<Guid> AlAbrir { get; set; }

    /// <summary>Cada cuánto se revisa si una temporada empezó o terminó, aunque nadie toque la caja.</summary>
    private static readonly TimeSpan CadaCuanto = TimeSpan.FromMinutes(1);

    private List<ExhibidorDto> _corren = [];
    private IReadOnlyList<ExhibidorDto>? _de;
    private DateOnly _hoy;
    private bool _visible;
    private bool _preguntado;
    private bool _cambio = true;
    private Contingencia? _contingencia;
    private readonly CancellationTokenSource _alto = new();

    private TimeProvider Reloj => Servicios.GetService<TimeProvider>() ?? TimeProvider.System;

    protected override void OnInitialized()
    {
        // La copia cambia (un exhibidor o unas fechas nuevas): se revisa ya, sin esperar a que la venta se vuelva a pintar.
        _contingencia = Servicios.GetService<Contingencia>();
        if (_contingencia is not null)
            _contingencia.Cambio += AlCambiar;
        _ = VigilarAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Visible != _visible)
            (_visible, _cambio) = (Visible, true);
        // Sin copia (el navegador): se le pregunta a la caja principal, una sola vez (no con cada escaneo).
        if (!_preguntado && Cliente.ExhibidoresDeLaCopia() is null)
        {
            _preguntado = true;
            try
            {
                await Cliente.MostradorAsync();
            }
            catch (ErrorCaja)
            {
                // Sin conexión ni copia: sin chip.
            }
        }
        Revisar();
    }

    protected override bool ShouldRender()
    {
        var pintar = _cambio;
        _cambio = false;
        return pintar;
    }

    /// <summary>
    /// Las que corren hoy, de lo que hay ahora (la copia, o lo que acaba de contestar la caja principal). Sin recalcular si no
    /// cambió ni la lista ni el día; solo se vuelve a pintar si cambiaron las que corren.
    /// </summary>
    private void Revisar()
    {
        var de = Cliente.ExhibidoresDeLaCopia();
        var hoy = Temporadas.Hoy(Reloj);
        if (ReferenceEquals(de, _de) && hoy == _hoy)
            return;
        (_de, _hoy) = (de, hoy);
        var corren = MostradorEnPantalla.TemporadasQueCorren(de, hoy);
        if (!corren.Select(t => (t.Id, t.Nombre)).SequenceEqual(_corren.Select(t => (t.Id, t.Nombre))))
            (_corren, _cambio) = (corren, true);
    }

    private void AlCambiar() => _ = InvokeAsync(() =>
    {
        Revisar();
        if (_cambio)
            StateHasChanged();
    });

    private async Task VigilarAsync()
    {
        using var reloj = new PeriodicTimer(CadaCuanto);
        try
        {
            while (await reloj.WaitForNextTickAsync(_alto.Token))
                AlCambiar();
        }
        catch (OperationCanceledException)
        {
            // La venta se fue.
        }
    }

    public void Dispose()
    {
        _alto.Cancel();
        if (_contingencia is not null)
            _contingencia.Cambio -= AlCambiar;
    }
}
