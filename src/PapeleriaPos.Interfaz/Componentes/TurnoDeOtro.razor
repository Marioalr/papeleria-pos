@* La caja con el turno de otro cajero (entrega 6, htmlOtroTurno del prototipo). Un turno por cajero: cada quien responde
   por su efectivo, así que antes de que venda quien entró se hace el corte del turno abierto. Quien puede hacer el corte
   («puede» en el corte, hoy el encargado y el dueño) lo hace ahí mismo, sin volver a escribir su PIN: acaba de entrar con
   él. Quien no, ve quién lo hace. En el piloto con eleventa no hay corte aquí: se hace en eleventa, y queda el aviso. *@
@implements IAsyncDisposable
@inject ClienteCaja Cliente
@inject IJSRuntime JS

<div class="entrada">
    <Iconos />
    <LadoEntrada Caja="Caja" Turno="Turno" />
    <section class="entrada-main">
        <h1>@Caja.Nombre tiene abierto el turno de @Turno.Cajero</h1>
        @if (Piloto)
        {
            @* El piloto con eleventa: aquí no se cierra el turno (se quita al dejarlo). *@
            <p>@PilotoConEleventa.CorteEnEleventa</p>
        }
        else
        {
            <p>Cada cajero responde por su efectivo: antes de que venda @Sesion.Nombre, se hace el corte del turno de @Turno.Cajero.</p>
        }
        @* En el piloto, ni a medio corte (si el servicio cambió mientras): quedan el aviso y las acciones. *@
        @if (_corte && !Piloto)
        {
            <div class="entrada-corte">
                @* «Que entre a esta caja» (si el servicio dice que quien entró no tiene el corte) es «Volver», a las fichas. *@
                <CorteCaja Turno="Turno" Sesion="Sesion" Caja="@Caja.Nombre" AlTerminar="TerminarCorteAsync" AlCambiarUsuario="AlVolver" />
            </div>
            <div class="vn-botonera">
                <button class="vn-boton" @onclick="AlVolver">Volver</button>
            </div>
        }
        else
        {
            @* El corte o quién lo hace, cuando ya llegaron las fichas; «Volver» y lo demás, desde el principio, aunque tarden. *@
            @if (_cargado && !Piloto && !_haceCorte)
            {
                <div class="vn-alerta info">
                    <Ico Nombre="info" />
                    <div><span>@QuienCorta</span></div>
                </div>
            }
            <div class="vn-botonera">
                @if (_cargado && !Piloto && _haceCorte)
                {
                    <button class="vn-boton primario" @onclick="() => _corte = true">Hacer el corte de @Turno.Cajero</button>
                }
                @if (AlAdministrar.HasDelegate)
                {
                    <button class="vn-boton" @onclick="AlAdministrar">Productos e inventario, sin cortar</button>
                }
                <button class="vn-boton" @onclick="AlVolver">Volver</button>
            </div>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;

    /// <summary>Quien acaba de entrar con su PIN.</summary>
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>El piloto con eleventa: el corte de esta caja se hace en eleventa.</summary>
    [Parameter] public bool Piloto { get; set; }

    /// <summary>Para quien administra (hoy, el encargado y el dueño): productos e inventario sin cortar.</summary>
    [Parameter] public EventCallback AlAdministrar { get; set; }

    /// <summary>«Volver» (o Ctrl+U): a «¿Quién atiende?».</summary>
    [Parameter] public EventCallback AlVolver { get; set; }

    /// <summary>Se cerró el turno: quien lo cortó sigue, para abrir el suyo.</summary>
    [Parameter] public EventCallback AlTerminarCorte { get; set; }

    private bool _corte;
    private bool _cargado;
    private bool _haceCorte;
    private List<QuienAutoriza> _quienes = [];
    private TeclasEntrada? _teclas;
    private DotNetObjectReference<TurnoDeOtro>? _referencia;

    /// <summary>
    /// Quién puede hacer el corte, de las fichas de esta caja (el servicio, o la copia local sin conexión): el corte lo
    /// vuelve a revisar el servicio al cerrarlo.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var fichas = await Cliente.FichasAsync(Caja.Id);
            _haceCorte = fichas.Any(f => f.UsuarioId == Sesion.UsuarioId && f.HaceCorte);
            // Por su nombre, como quien autoriza en la venta (sin su usuario: las fichas no lo traen ni hace falta).
            _quienes = fichas.Where(f => f.HaceCorte && f.UsuarioId != Sesion.UsuarioId).Select(f => new QuienAutoriza("", f.Nombre)).ToList();
        }
        catch (ErrorCaja)
        {
            // Sin las fichas (ni la copia) no se sabe quién: como antes, el encargado y el dueño tienen el corte. El servicio lo
            // vuelve a revisar al cerrarlo.
            _haceCorte = Sesion.Rol is Rol.Encargado or Rol.Dueno;
        }
        _cargado = true;
    }

    private string QuienCorta => _quienes.Count == 0
        ? "El corte lo hace quien tiene ese permiso. Pídele que entre en esta caja."
        : $"El corte lo hace quien tiene ese permiso: {Textos.Quien(_quienes)}. Pídele que entre en esta caja.";

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!primera)
            return;
        _referencia = DotNetObjectReference.Create(this);
        _teclas = new TeclasEntrada(JS);
        await _teclas.PonerAsync(_referencia, TeclasEntrada.SoloCambiar);
    }

    /// <summary>Terminó el corte: si el turno siguiera abierto, aquí se vuelve a ver el aviso, no el corte.</summary>
    private async Task TerminarCorteAsync()
    {
        _corte = false;
        await AlTerminarCorte.InvokeAsync();
    }

    /// <summary>Ctrl+U (entrada.js): cambiar de usuario, como «Volver».</summary>
    [JSInvokable]
    public Task Tecla(string tecla) => tecla == "Ctrl+U" ? AlVolver.InvokeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_teclas is not null)
            await _teclas.DisposeAsync();
        _referencia?.Dispose();
    }
}
