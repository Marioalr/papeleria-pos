@* El margen mínimo (solo el dueño): uno general de la sucursal y, si hace falta, uno propio por departamento. Una
   compra que deja un producto debajo de él avisa y sugiere precio; el precio no cambia solo. *@
@inject ClienteCaja Cliente

@if (_margenes is null)
{
    <p class="@(_error is null ? "" : "error")">@(_error ?? "Cargando…")</p>
}
else
{
    <p class="nota">El margen es sobre el precio de venta, con IVA en los dos lados: (precio − costo) ÷ precio. Con 30 %, lo que cuesta $7.00 se vende desde $10.00.</p>
    <div class="margenes">
        <label class="en-linea">General de la sucursal (%) <input class="umbral" inputmode="decimal" @bind="_general" /></label>
        <div class="resultados">
            <table>
                <thead><tr><th>Departamento</th><th class="num">Margen propio (%)</th></tr></thead>
                @foreach (var d in _departamentos)
                {
                    var departamento = d;
                    <tr>
                        <td>@d.Nombre</td>
                        <td class="num"><input class="umbral" inputmode="decimal" placeholder="General" @bind="departamento.Margen" /></td>
                    </tr>
                }
            </table>
        </div>
    </div>
    <p class="nota">Vacío: el departamento usa el general.</p>
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_aviso is not null)
    {
        <p class="aviso">@_aviso</p>
    }
    <div class="acciones izquierda">
        <button class="boton principal" disabled="@_ocupado" @onclick="GuardarAsync">Guardar</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    private sealed class Departamento
    {
        public required Guid Id { get; init; }
        public required string Nombre { get; init; }
        public string Margen { get; set; } = "";
    }

    private MargenesDto? _margenes;
    private string _general = "";
    private List<Departamento> _departamentos = [];
    private bool _ocupado;
    private string? _error;
    private string? _aviso;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Mostrar(await Cliente.MargenesAsync(Caja.SucursalId));
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private void Mostrar(MargenesDto m)
    {
        _margenes = m;
        _general = Porcentaje(m.MargenMinimoCentesimas);
        _departamentos = m.Departamentos
            .Select(d => new Departamento { Id = d.DepartamentoId, Nombre = d.Departamento, Margen = d.MargenMinimoCentesimas is { } c ? Porcentaje(c) : "" })
            .ToList();
    }

    private static string Porcentaje(int centesimas) => (centesimas / 100m).ToString("0.##", CultureInfo.InvariantCulture);

    private static int? Leer(string texto) =>
        decimal.TryParse(texto.Replace("%", "").Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var p) && p is >= 0 and < 100
            ? (int)Math.Round(p * 100)
            : null;

    private async Task GuardarAsync()
    {
        (_error, _aviso) = (null, null);
        if (Leer(_general) is not { } general)
        {
            _error = "El margen general va de 0 a 99.99 %.";
            return;
        }
        var departamentos = new List<MargenDepartamentoDto>();
        foreach (var d in _departamentos)
        {
            int? propio = null;
            if (d.Margen.Trim().Length > 0 && (propio = Leer(d.Margen)) is null)
            {
                _error = $"Revisa el margen de {d.Nombre}.";
                return;
            }
            departamentos.Add(new MargenDepartamentoDto(d.Id, d.Nombre, propio));
        }
        _ocupado = true;
        try
        {
            Mostrar(await Cliente.GuardarMargenesAsync(Caja.SucursalId, new SolicitudMargenes(Sesion.UsuarioId, new MargenesDto(general, departamentos))));
            _aviso = "Margen guardado.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
