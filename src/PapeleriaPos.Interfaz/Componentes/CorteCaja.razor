@* El corte (entrega 6, docs/propuesta-interfaz.md «Corte», 2026-10-14), como en el prototipo (htmlCorteTurno). El del
   turno: quien ya entró con su PIN y tiene el permiso cuenta el efectivo y escribe el total, sin billete por billete, sin
   ver cuánto debería haber y sin volver a escribir su PIN; al cerrar ve lo esperado, lo contado y la diferencia, a nombre
   del cajero del turno. Quien no tiene el permiso ve el corte X (sin el efectivo) y quién puede hacerlo. Con «ver y
   cerrar el corte del día», arriba elige entre el turno y el día (CorteDelDia); quien hace el corte de un turno o ve el del
   día, también el historial de cortes de cualquier día (HistorialCortes, paridad con eleventa, 2026-10-17), que «/» abre
   directo. En el piloto con eleventa el corte del turno se hace en eleventa. Va encima de la venta (la pestaña «Corte») y
   en la tarjeta del turno de otro cajero. *@
@implements IAsyncDisposable
@inject ClienteCaja Cliente
@inject IImpresora Impresora
@inject IJSRuntime JS

<div class="vn-corte">
    <div class="vn-corte-cab">
        <h2>@(_historial ? "Historial de cortes" : _delDia ? "Corte del día" : "Corte del turno")</h2>
        @if (_informativo?.VeElDia == true || VeHistorial)
        {
            @* El historial (paridad con eleventa, 2026-10-17), para quien hace el corte de un turno o ve el del día. *@
            <span class="vn-corte-segmento" role="tablist">
                <button role="tab" class="@(_delDia || _historial ? "" : "activo")" aria-selected="@(!_delDia && !_historial)" @onclick="() => Mostrar(delDia: false)">Turno</button>
                @if (_informativo?.VeElDia == true)
                {
                    <button role="tab" class="@(_delDia ? "activo" : "")" aria-selected="@_delDia" @onclick="() => Mostrar(delDia: true)">Del día · todas las cajas</button>
                }
                @if (VeHistorial)
                {
                    <button role="tab" class="@(_historial ? "activo" : "")" aria-selected="@_historial" @onclick="MostrarHistorial">Historial</button>
                }
            </span>
        }
        @if ((_delDia || _historial) && _resultado is not null)
        {
            @* Ya se cerró el turno: también desde el día se sigue al siguiente turno (Esc dejaría la venta en un turno cerrado). *@
            <button class="vn-boton primario vn-corte-listo" @onclick="AlTerminar">Listo: abrir el siguiente turno</button>
        }
    </div>

    @if (_historial)
    {
        <HistorialCortes CajaId="Turno.CajaId" Sesion="Sesion" />
    }
    else if (_delDia)
    {
        <CorteDelDia CajaId="Turno.CajaId" Sesion="Sesion" AlHacerElCorte="() => Mostrar(delDia: false)" />
    }
    else if (PilotoEleventa && _resultado is null)
    {
        <div class="vn-alerta"><Ico Nombre="info" /><div><span>@PilotoConEleventa.CorteEnEleventa</span></div></div>
    }
    else if (_resultado is { } r)
    {
        var contado = r.ContadoCentavos ?? 0;
        var diferencia = r.DiferenciaCentavos ?? 0;
        <div class="vn-corte-turno">
            <div class="vn-corte-contar">
                <h3>Turno de @r.Cajero cerrado</h3>
                <div class="vn-corte-rejilla">
                    <div class="vn-corte-dato"><span>Contado</span><strong>@Formato.Dinero(contado)</strong></div>
                    <div class="vn-corte-dato"><span>Esperado</span><strong>@Formato.Dinero(r.EsperadoCentavos)</strong><small>fondo + efectivo − salidas</small></div>
                    <div class="vn-corte-dato">
                        <span>@(diferencia == 0 ? "Cuadra" : diferencia > 0 ? "Sobrante" : "Faltante")</span>
                        <strong class="@(diferencia < 0 ? "vn-dif-mal" : "vn-dif-bien")">@Formato.ConSigno(diferencia)</strong>
                        <small>a nombre de @r.Cajero</small>
                    </div>
                </div>
                @if (r.UmbralAvisoCentavos is { } umbral)
                {
                    <div class="vn-alerta"><Ico Nombre="telegram" /><div><span>Pasa de @Formato.Dinero(umbral): se avisa por Telegram.</span></div></div>
                }
                @if (r.EnContingencia)
                {
                    <div class="vn-alerta info"><Ico Nombre="info" /><div><span>Sin conexión con la caja principal: es la cuenta de esta caja. Se cuadra cuando suba lo que hizo sin conexión.</span></div></div>
                }
                @if (_error is not null)
                {
                    <p class="vn-corte-error">@_error</p>
                }
                @if (_impreso is { } impreso)
                {
                    @* El corte va a la cola de la impresora (entrega 5, parte 3): aquí se ve si salió y, si no, «Reintentar» y «No imprimirlo». *@
                    <AvisoImpresion Trabajo="impreso" Nota="El corte ya quedó." />
                }
                <div class="vn-botonera">
                    <button class="vn-boton primario" @ref="_listo" @onclick="AlTerminar">Listo: abrir el siguiente turno</button>
                    @if (_informativo?.VeElDia == true)
                    {
                        <button class="vn-boton" @onclick="() => Mostrar(delDia: true)">Ver el corte del día</button>
                    }
                </div>
            </div>
            <div class="vn-corte-tarjeta">
                <h3>Detalle del corte</h3>
                <div class="vn-corte-linea"><span>Ventas del turno@(r.Cancelaciones > 0 ? $" ({r.Cancelaciones} {(r.Cancelaciones == 1 ? "cancelada" : "canceladas")})" : "")</span><strong>@r.Ventas</strong></div>
                <div class="vn-corte-linea"><span>Fondo</span><strong>@Formato.Dinero(r.FondoCentavos)</strong></div>
                <div class="vn-corte-linea"><span>Efectivo de ventas</span><strong>@Formato.Dinero(r.EfectivoVentasCentavos)</strong></div>
                @if (r.AbonosEfectivoCentavos != 0)
                {
                    <div class="vn-corte-linea"><span>Abonos de clientes en efectivo</span><strong>@Formato.Dinero(r.AbonosEfectivoCentavos)</strong></div>
                }
                <div class="vn-corte-linea"><span>Entradas</span><strong>@Formato.Dinero(r.EntradasCentavos)</strong></div>
                <div class="vn-corte-linea"><span>Salidas</span><strong>@Formato.ConSigno(-r.SalidasCentavos)</strong></div>
                @if (r.DevolucionesCentavos > 0)
                {
                    <div class="vn-corte-linea"><span>Devoluciones y cancelaciones</span><strong>@Formato.ConSigno(-r.DevolucionesCentavos)</strong></div>
                }
                @if (r.SaldoDevueltoCentavos != 0)
                {
                    <div class="vn-corte-linea"><span>Saldo a favor devuelto</span><strong>@Formato.ConSigno(-r.SaldoDevueltoCentavos)</strong></div>
                }
                <div class="vn-corte-linea suma"><span>Esperado</span><strong>@Formato.Dinero(r.EsperadoCentavos)</strong></div>
                @if (r.RedondeoCentavos != 0)
                {
                    <p class="vn-corte-nota">Incluye el redondeo al peso: @(r.RedondeoCentavos > 0 ? "+" : "−")@Formato.Dinero(Math.Abs(r.RedondeoCentavos)).</p>
                }
                <div class="vn-corte-linea"><span>Tarjeta</span><strong>@Formato.Dinero(r.TarjetaCentavos)</strong></div>
                <div class="vn-corte-linea"><span>Transferencias</span><strong>@Formato.Dinero(r.TransferenciaCentavos)</strong></div>
                @* Los abonos no son venta y lo fiado no es dinero: van aparte (fase 3). *@
                @if (r.AbonosTarjetaCentavos != 0)
                {
                    <div class="vn-corte-linea"><span>Abonos con tarjeta</span><strong>@Formato.Dinero(r.AbonosTarjetaCentavos)</strong></div>
                }
                @if (r.AbonosTransferenciaCentavos != 0)
                {
                    <div class="vn-corte-linea"><span>Abonos por transferencia</span><strong>@Formato.Dinero(r.AbonosTransferenciaCentavos)</strong></div>
                }
                @if (r.CreditoCentavos != 0)
                {
                    <div class="vn-corte-linea"><span>Fiado (no es efectivo)</span><strong>@Formato.Dinero(r.CreditoCentavos)</strong></div>
                }
                <p class="vn-corte-nota">Lo hizo @r.RealizadoPor a las @r.FechaLocal.ToString("HH:mm").</p>
                @if (_vistaPrevia is not null)
                {
                    <pre class="vn-corte-ticket">@_vistaPrevia</pre>
                }
            </div>
        </div>
    }
    else if (_informativo is not { } i)
    {
        @if (_sinTurno)
        {
            @* El turno ya se cerró (con otro corte, o se volvió aquí después de cerrarlo): como en el prototipo. *@
            <div class="vn-alerta info"><Ico Nombre="info" /><div><span>No hay turno abierto en @(string.IsNullOrEmpty(Caja) ? "esta caja" : Caja).</span><span><button class="vn-boton chico" @onclick="AlTerminar">Abrir turno</button></span></div></div>
        }
        else if (_error is not null)
        {
            <div class="vn-alerta"><Ico Nombre="alerta" /><div><span>@_error</span><span><button class="vn-boton chico" @onclick="CargarAsync">Volver a intentar</button></span></div></div>
        }
        else
        {
            <p class="vn-corte-nota">Cargando el turno…</p>
        }
    }
    else if (!i.PuedeCortar)
    {
        <div class="vn-corte-turno">
            <div class="vn-alerta info">
                <Ico Nombre="candado" />
                <div>
                    <span>El corte lo hace quien tiene ese permiso: <strong>@Textos.Quien(i.QuienesCortan)</strong>. Solo pide el total del efectivo, sin ver cuánto debería haber.</span>
                    @* Nunca sin salida: sin cambiar de usuario, termina el corte sin cerrar el turno (en la tarjeta del turno de otro
                       cajero eso regresa a la entrada, con el turno abierto, para que entre quien lo hace). *@
                    <span><button class="vn-boton chico" @onclick="QueEntreAsync">Que entre a esta caja</button></span>
                </div>
            </div>
            @Informativo(i)
        </div>
    }
    else
    {
        <div class="vn-corte-turno">
            <div class="vn-corte-contar">
                <h3>Turno de @Turno.Cajero · desde @Desde(Turno.AbiertoLocal)</h3>
                <p class="vn-corte-nota">
                    Cuenta el efectivo de la caja y escribe el total. No se muestra cuánto debería haber hasta cerrar.@(Sesion.UsuarioId != Turno.CajeroId
                        ? $" Entraste como {Sesion.Nombre}: no vuelve a pedir tu PIN." : "")
                </p>
                @* corte.js: si el lector escribe aquí, no se toma como dinero ni su Enter cierra el turno. *@
                <label class="vn-corte-campo">Efectivo contado
                    <input id="corte-contado" @ref="_campo" inputmode="decimal" autocomplete="off" placeholder="$0.00"
                           @bind="_contado" @bind:event="oninput" @onkeydown="AlTeclear" />
                </label>
                @if (_error is not null)
                {
                    <p class="vn-corte-error">@_error</p>
                }
                <button class="vn-cobrar" disabled="@(_ocupado || Contado is null)" @onclick="CerrarAsync"><span>Cerrar el turno</span><kbd>Enter</kbd></button>
            </div>
            @Informativo(i)
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;

    /// <summary>Quien entró en la caja: a su nombre queda el corte, y el servicio revisa que tenga el permiso.</summary>
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Nombre de la caja, para el corte impreso.</summary>
    [Parameter] public string Caja { get; set; } = "";

    /// <summary>
    /// «Listo: abrir el siguiente turno» después del corte, y «Abrir turno» si el turno ya estaba cerrado. Quien hizo el
    /// corte sigue adentro y pasa a abrir el suyo, como en el prototipo (lo hace quien pone el corte).
    /// </summary>
    [Parameter] public EventCallback AlTerminar { get; set; }

    /// <summary>
    /// En cuanto el corte cerró el turno, aunque todavía no se oprima «Listo»: quien pone el corte sabe que el turno ya no
    /// está, por si se cierra la ventana con Esc o con la ×.
    /// </summary>
    [Parameter] public EventCallback AlCerrarElTurno { get; set; }

    /// <summary>
    /// Opcional: cambiar de usuario (Ctrl+U), para que quien no tiene el permiso deje entrar a quien sí («Que entre a esta
    /// caja», como en el prototipo). Sin él, el botón termina el corte sin cerrar el turno (<see cref="AlTerminar"/>).
    /// </summary>
    [Parameter] public EventCallback AlCambiarUsuario { get; set; }

    /// <summary>
    /// El piloto con eleventa (2026-10-12): el corte de esta caja se hace en eleventa. En su lugar, el aviso; el corte del
    /// día se puede ver, pero no cerrar. Se quita al dejar eleventa.
    /// </summary>
    [CascadingParameter(Name = PilotoConEleventa.Cascada)] public bool PilotoEleventa { get; set; }

    /// <summary>Abre en el historial de cortes («Historial de cortes» en «/»), no en el del turno.</summary>
    [Parameter] public bool Historial { get; set; }

    /// <summary>Se ve el historial de cortes (paridad con eleventa, 2026-10-17).</summary>
    private bool _historial;

    /// <summary>
    /// Los permisos con que pinta la pantalla de venta (los de la sesión o, de un servicio de antes, los que pidió aparte). En
    /// la tarjeta del turno de otro cajero no hay: ahí, los de la sesión.
    /// </summary>
    [CascadingParameter(Name = "PermisosDeSesion")] public IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? PermisosDeSesion { get; set; }

    /// <summary>
    /// El historial lo ve quien hoy hace o ve los cortes: «Hacer el corte de un turno» o «Ver y cerrar el corte del día», en
    /// «Puede» (el servicio lo vuelve a revisar). Con el corte X ya leído, lo que dijo el servicio; si no, los permisos de la
    /// pantalla o de la sesión.
    /// </summary>
    private bool VeHistorial => _informativo is { } i
        ? i.PuedeCortar || i.VeElDia
        : Puede(AccionControlada.CorteZ) || Puede(AccionControlada.CorteDelDia);

    /// <summary>Lo puede sin pedir autorización. Sin saberlo, se ve y el servicio decide, como en la pantalla de venta.</summary>
    private bool Puede(AccionControlada accion) => PermisosDeSesion is { } permisos
        ? (permisos.GetValueOrDefault(accion)?.Nivel ?? NivelPermiso.Permitido) == NivelPermiso.Permitido
        : Sesion.Puede(accion);

    private CorteInformativoDto? _informativo;
    private CorteDto? _resultado;
    private string _contado = "";
    private string? _error;
    private string? _vistaPrevia;

    /// <summary>El corte en la cola de la impresora de tickets; vacío sin impresora (se ve aquí mismo).</summary>
    private TrabajoDeImpresion? _impreso;
    private bool _ocupado;
    private bool _delDia;
    private bool _enfocar = true;
    private bool _sinTurno;
    private ElementReference _campo;
    private ElementReference _listo;
    private IJSObjectReference? _modulo;

    private long? Contado => Formato.LeerPesos(_contado);

    protected override Task OnInitializedAsync()
    {
        // Quien no lo ve, abre en el turno, como siempre.
        _historial = Historial && VeHistorial;
        return CargarAsync();
    }

    /// <summary>
    /// El corte X y los permisos de quien entró (también en el piloto: dicen si ve el corte del día). Si falla porque el
    /// turno ya se cerró, se dice así, con «Abrir turno», y no «Volver a intentar».
    /// </summary>
    private async Task CargarAsync()
    {
        _error = null;
        _sinTurno = false;
        try
        {
            _informativo = await Cliente.CorteInformativoAsync(Turno.Id, Sesion.UsuarioId);
            _enfocar = true;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
            try
            {
                _sinTurno = (await Cliente.TurnoAsync(Turno.CajaId))?.Id != Turno.Id;
            }
            catch (ErrorCaja)
            {
                // Tampoco se sabe el turno: queda el error, con «Volver a intentar».
            }
        }
    }

    /// <summary>
    /// El cursor en «Efectivo contado» (cuidado del lector, corte.js); ya cerrado, en «Listo» (Enter sigue al siguiente
    /// turno).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!_enfocar || _delDia || _historial)
            return;
        if (_resultado is not null)
        {
            _enfocar = false;
            await _listo.FocusAsync();
        }
        else if (_informativo is { PuedeCortar: true } && !PilotoEleventa)
        {
            _enfocar = false;
            await _campo.FocusAsync();
            await ProtegerDelLectorAsync();
        }
    }

    /// <summary>
    /// Un escaneo en «Efectivo contado» no se toma como dinero (corte.js): el corte no se deshace. Si la página ya no
    /// contesta, el campo sigue sirviendo; solo sin ese cuidado.
    /// </summary>
    private async Task ProtegerDelLectorAsync()
    {
        try
        {
            _modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PapeleriaPos.Interfaz/corte.js");
            await _modulo.InvokeVoidAsync("proteger", _campo);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException or OperationCanceledException)
        {
            // La página se está yendo (o volviendo a cargar): el campo se queda como cualquier otro.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_modulo is null)
            return;
        try
        {
            await _modulo.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException or OperationCanceledException)
        {
            // La página ya no está: el módulo se fue con ella.
        }
    }

    /// <summary>«Que entre a esta caja»: cambiar de usuario si quien pone el corte lo deja; si no, terminar sin cerrar el turno.</summary>
    private Task QueEntreAsync() => AlCambiarUsuario.HasDelegate ? AlCambiarUsuario.InvokeAsync() : AlTerminar.InvokeAsync();

    private void Mostrar(bool delDia)
    {
        _delDia = delDia;
        _historial = false;
        _enfocar = !delDia;
    }

    private void MostrarHistorial()
    {
        (_historial, _delDia, _enfocar) = (true, false, false);
    }

    /// <summary>«desde las 09:00», o con la fecha si el turno se abrió otro día.</summary>
    private static string Desde(DateTime abiertoLocal) =>
        abiertoLocal.Date == HoraMexico.ALocal(DateTime.UtcNow).Date ? $"las {abiertoLocal:HH:mm}" : $"el {abiertoLocal:dd/MM} a las {abiertoLocal:HH:mm}";

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CerrarAsync();
    }

    /// <summary>Cierra el turno con lo que se contó; F12 no cuenta aquí: Enter o el botón.</summary>
    private async Task CerrarAsync()
    {
        if (_ocupado || Contado is not { } contado)
            return;
        _ocupado = true;
        _error = null;
        try
        {
            _resultado = await Cliente.CorteZAsync(Turno.Id, new SolicitudCorteZ(Sesion.UsuarioId, contado));
            _enfocar = true;
            Imprimir(_resultado);
            await AlCerrarElTurno.InvokeAsync();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>
    /// El corte se imprime para guardarlo con el efectivo: va a la cola de la impresora, como el ticket, sin esperarla
    /// (entrega 5, parte 3). Si no sale, el corte ya quedó: aquí mismo se ve y se reintenta.
    /// </summary>
    private void Imprimir(CorteDto corte)
    {
        var documento = DisenoComprobante.Corte(corte, Caja);
        var cola = ColaDeImpresion.De(Impresora);
        if (cola.MuestraVistaPrevia)
            _vistaPrevia = TicketTexto.Generar(documento);
        else
            _impreso = cola.Encolar($"Corte del turno de {corte.Cajero}", documento, abrirCajon: false);
    }

    /// <summary>El corte X: lo que se ve del turno antes de cerrarlo. El efectivo no: se cuenta a ciegas.</summary>
    private static RenderFragment Informativo(CorteInformativoDto i) => @<div class="vn-corte-tarjeta">
        <h3>Corte X · informativo</h3>
        <div class="vn-corte-linea"><span>Ventas del turno@(i.Cancelaciones > 0 ? $" ({i.Cancelaciones} {(i.Cancelaciones == 1 ? "cancelada" : "canceladas")})" : "")</span><strong>@i.Ventas</strong></div>
        <div class="vn-corte-linea"><span>Tarjeta</span><strong>@Formato.Dinero(i.TarjetaCentavos)</strong></div>
        <div class="vn-corte-linea">
            <span>Transferencias@(i.TransferenciasPorVerificar is > 0 and var n ? $" ({n} por verificar)" : "")</span><strong>@Formato.Dinero(i.TransferenciaCentavos)</strong>
        </div>
        @if (i.AbonosTarjetaCentavos != 0)
        {
            <div class="vn-corte-linea"><span>Abonos con tarjeta</span><strong>@Formato.Dinero(i.AbonosTarjetaCentavos)</strong></div>
        }
        @if (i.AbonosTransferenciaCentavos != 0)
        {
            <div class="vn-corte-linea"><span>Abonos por transferencia</span><strong>@Formato.Dinero(i.AbonosTransferenciaCentavos)</strong></div>
        }
        @if (i.CreditoCentavos != 0)
        {
            <div class="vn-corte-linea"><span>Fiado (no es efectivo)</span><strong>@Formato.Dinero(i.CreditoCentavos)</strong></div>
        }
        <p class="vn-corte-nota">El efectivo no se muestra: se cuenta a ciegas al cerrar el turno.@(i.EnContingencia ? " Sin conexión: es la cuenta de esta caja." : "")</p>
    </div>;
}
