@* Para las compras: escanear un código (el de la caja de 12 elige la caja) o buscar por nombre. En las tareas del
   inventario (entrega 8) es la búsqueda de la página (data-busca): lo que se escanea con el cursor en otro lado cae aquí. *@
@inject ClienteCaja Cliente
@inject ModuloCaja Js

<div class="captura">
    <label for="codigo-compra">Código:</label>
    <input id="codigo-compra" data-busca autocomplete="off" @bind="_codigo" @bind:event="oninput" @onkeydown="AlTeclear" />
    <button class="boton" @onclick="AgregarCodigoAsync">ENTER - @Accion</button>
    <button class="boton" @onclick="AlternarBusquedaAsync">@(_buscando ? "Cerrar búsqueda" : "Buscar por nombre")</button>
</div>
@if (_buscando)
{
    <BuscarProducto SucursalId="SucursalId" AlElegir="ElegidoAsync" />
}
@if (_error is not null)
{
    <p class="error">@_error</p>
}

@code {
    [Parameter, EditorRequired] public Guid SucursalId { get; set; }
    [Parameter] public string Accion { get; set; } = "Agregar";

    /// <summary>El producto y la presentación del código (la base si se buscó por nombre).</summary>
    [Parameter] public EventCallback<(ProductoVentaDto Producto, PresentacionDto Presentacion)> AlElegir { get; set; }

    /// <summary>
    /// Al recibir mercancía, en lugar de <see cref="AlElegir"/>: con las piezas, porque «12*7501…» cuenta doce de una vez,
    /// como en la venta.
    /// </summary>
    [Parameter] public EventCallback<(ProductoVentaDto Producto, PresentacionDto Presentacion, long Piezas)> AlContar { get; set; }

    /// <summary>Al recibir mercancía: un código que no está en el catálogo se cuenta aparte (sin esto, es un error).</summary>
    [Parameter] public EventCallback<(string Codigo, long Piezas)> AlNoExiste { get; set; }

    /// <summary>
    /// Después de elegir un producto, el cursor vuelve al código (para escanear el siguiente). En falso, lo pone quien elige
    /// (Agregar inventario: en «Cuántos llegaron»); si no se eligió nada, sigue en el código.
    /// </summary>
    [Parameter] public bool CursorEnElCodigo { get; set; } = true;

    private string _codigo = "";
    private bool _buscando;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await Js.EnfocarAsync("#codigo-compra");
    }

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AgregarCodigoAsync();
    }

    private async Task AgregarCodigoAsync()
    {
        var codigo = _codigo.Trim();
        if (codigo.Length == 0)
            return;
        _error = null;
        long piezas = 1;
        var asterisco = codigo.IndexOf('*');
        if (asterisco > 0 && AlContar.HasDelegate)
        {
            if (!long.TryParse(codigo[..asterisco], NumberStyles.Integer, CultureInfo.InvariantCulture, out piezas) || piezas <= 0)
            {
                _error = $"Cantidad inválida: «{codigo[..asterisco]}». Escribe piezas enteras, por ejemplo 12*7501….";
                return;
            }
            codigo = codigo[(asterisco + 1)..].Trim();
            if (codigo.Length == 0)
                return;
        }
        var elegido = false;
        try
        {
            if (await Cliente.PorCodigoAsync(codigo, SucursalId) is { } producto)
                elegido = await ElegirAsync(producto, piezas);
            else if (AlNoExiste.HasDelegate)
            {
                // Quien lo recibe pregunta cuántos llegaron y pone ahí el cursor.
                await AlNoExiste.InvokeAsync((codigo, piezas));
                _codigo = "";
                return;
            }
            else
                _error = NoExiste(codigo);
            _codigo = "";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        if (CursorEnElCodigo || !elegido)
            await Js.EnfocarAsync("#codigo-compra");
    }

    /// <summary>
    /// Un código que cayó en otro campo de la página (en Agregar inventario, escaneado en «Cuántos llegaron» o en el costo: caja.js
    /// lo reconoce por el ritmo del lector; revisión del PR #138): se busca como si se hubiera escaneado aquí. Devuelve si se
    /// eligió; el cursor lo pone quien llama.
    /// </summary>
    public async Task<bool> ElegirCodigoAsync(string codigo)
    {
        codigo = codigo.Trim();
        _error = null;
        var elegido = false;
        try
        {
            if (await Cliente.PorCodigoAsync(codigo, SucursalId) is { } producto)
                elegido = await ElegirAsync(producto, 1);
            else
                _error = NoExiste(codigo);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        StateHasChanged();
        return elegido;
    }

    private static string NoExiste(string codigo) => $"El código «{codigo}» no existe: dalo de alta en F3 Productos.";

    private async Task ElegidoAsync(Guid varianteId)
    {
        _error = null;
        var elegido = false;
        try
        {
            if (await Cliente.PorVarianteAsync(varianteId, SucursalId) is { } producto)
                elegido = await ElegirAsync(producto, 1);
            _buscando = false;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        if (CursorEnElCodigo || !elegido)
            await Js.EnfocarAsync("#codigo-compra");
    }

    /// <summary>Se lo da a quien elige; falso si no lleva inventario (un servicio).</summary>
    private async Task<bool> ElegirAsync(ProductoVentaDto producto, long piezas)
    {
        if (!producto.LlevaInventario)
        {
            _error = $"«{producto.Descripcion}» es un servicio: no lleva inventario.";
            return false;
        }
        if (AlContar.HasDelegate)
            await AlContar.InvokeAsync((producto, producto.Presentacion, piezas));
        else
            await AlElegir.InvokeAsync((producto, producto.Presentacion));
        return true;
    }

    private async Task AlternarBusquedaAsync()
    {
        _buscando = !_buscando;
        if (!_buscando)
            await Js.EnfocarAsync("#codigo-compra");
    }
}
