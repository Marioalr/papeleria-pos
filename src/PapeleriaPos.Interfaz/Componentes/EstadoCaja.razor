@* El estado de arriba en la pantalla de venta (docs/propuesta-interfaz.md, «Caja principal y secundarias»): dónde está el
   servicio o si se perdió la caja principal, la impresora de tickets y las impresiones que faltan por cobrar.
   Cada chip lleva su punto o su ícono y su texto en .vn-chip-texto: si arriba no cabe todo, el texto se acorta o se quita
   (caja.css, .vn-chips) y completo queda en su aria-label y en su title (en los avisos, el title es su explicación). El texto
   de los avisos empieza por lo que importa («Tickets · no salió…»): lo que se corta primero es el final. *@
@implements IAsyncDisposable
@inject ClienteCaja Cliente
@inject ConexionCaja Conexion
@inject IImpresora Impresora
@inject IServiceProvider Servicios

<div class="vn-estado">
    @switch (QueDice(_contingencia, Conexion))
    {
        case ChipConexion.SinLaPrincipal:
            <span class="vn-chip-estado aviso" aria-label="Sin la principal@(PorSubir)"
                  title="@(Conexion.SimularSinConexion ? "Simulado en la prueba («Volver a conectar» en la franja). " : "")Se vende con la copia de esta caja; lo que se cobra sube al volver la conexión.">
                <span class="punto"></span><span class="vn-chip-texto">Sin la principal@(PorSubir)</span>
            </span>
            break;
        case ChipConexion.RedLenta:
            <span class="vn-chip-estado aviso" aria-label="Red lenta@(PorSubir)"
                  title="La caja principal tarda en contestar@(Ms(_contingencia!.Latencia) is { } ms ? $" ({ms})" : ""): se vende con la copia de esta caja y lo cobrado sube solo. Vuelve sola cuando la red esté bien.">
                <span class="punto"></span><span class="vn-chip-texto">Red lenta@(PorSubir)</span>
            </span>
            break;
        case ChipConexion.Subiendo:
            <span class="vn-chip-estado aviso" aria-label="Subiendo @_contingencia!.Pendientes…" title="Subiendo @_contingencia.Pendientes… a la caja principal.">
                <span class="punto"></span><span class="vn-chip-texto">Subiendo @_contingencia.Pendientes…</span>
            </span>
            break;
        case ChipConexion.ServicioAqui when SinInternet(_contingencia, Conexion) is { } sinInternet:
            @* Como en el prototipo: en la caja principal, «Sin internet» en lugar de «Servicio aquí». *@
            <span class="vn-chip-estado aviso" aria-label="Sin internet" title="@Titulo(sinInternet)"><span class="punto"></span><span class="vn-chip-texto">Sin internet</span></span>
            break;
        case ChipConexion.ServicioAqui:
            <span class="vn-chip-estado" aria-label="Servicio aquí" title="Servicio aquí: el servicio y la base están en esta PC."><span class="punto"></span><span class="vn-chip-texto">Servicio aquí</span></span>
            break;
        default:
            <span class="vn-chip-estado" aria-label="@Conectada" title="@($"{Conectada}: el catálogo está en esta caja; lo que se cobra va a {Conexion.Servicio.Authority}.")"><span class="punto"></span><span class="vn-chip-texto">@Conectada</span></span>
            break;
    }
    @if (!Conexion.Servicio.IsLoopback && SinInternet(_contingencia, Conexion) is { } sinInternetAqui)
    {
        <span class="vn-chip-estado aviso" aria-label="Sin internet" title="@Titulo(sinInternetAqui)"><span class="punto"></span><span class="vn-chip-texto">Sin internet</span></span>
    }
    @if (Impresora.MuestraVistaPrevia)
    {
        <span class="vn-chip-estado" aria-label="Ticket en pantalla" title="Ticket en pantalla: sin impresora de tickets en esta PC, el ticket se ve en pantalla."><Ico Nombre="monitor" /><span class="vn-chip-texto">Ticket en pantalla</span></span>
    }
    else if (Cola.Problema is { Estado: EstadoImpresion.NoSalio } noSalio)
    {
        @* La cola se detuvo: lo que sigue espera. Desde aquí también se reintenta, también en las páginas (entrega 5, parte 3). *@
        <button class="vn-chip-estado aviso" aria-label="@NoSalio" title="No salió «@noSalio.Titulo»: @noSalio.Motivo Toca para reintentar." @onclick="Cola.Reintentar">
            <Ico Nombre="impresora" /><span class="vn-chip-texto">@NoSalio</span>
        </button>
        @* «No imprimirlo» es corto y es lo que se hace: no se encoge. *@
        <button class="vn-chip-estado aviso" title="«@noSalio.Titulo» se deja sin imprimir y sigue lo demás: se puede volver a imprimir."
                @onclick="() => AvisoImpresion.NoImprimirlo(Cola, noSalio, Servicios)">
            <span class="vn-chip-clave">No imprimirlo</span>
        </button>
    }
    else if (Cola.Problema is { } ocupada)
    {
        <span class="vn-chip-estado aviso" aria-label="Tickets · esperando a la impresora" title="«@ocupada.Titulo»: @ocupada.Motivo Se vuelve a intentar sola."><Ico Nombre="impresora" /><span class="vn-chip-texto">Tickets · esperando a la impresora</span></span>
    }
    else if (Red?.AvisoImpresora is { } porNombre)
    {
        @* Por nombre, compartida o con WSD: con el router trabado no se encuentra (la red de la tienda en el POS). *@
        <span class="vn-chip-estado aviso" aria-label="Tickets · @AvisosDeRed.ConfiguralaPorIp" title="@porNombre"><Ico Nombre="impresora" /><span class="vn-chip-texto">Tickets · @AvisosDeRed.ConfiguralaPorIp</span></span>
    }
    else
    {
        <span class="vn-chip-estado" aria-label="Tickets" title="Tickets: la impresora de tickets de esta caja."><Ico Nombre="impresora" /><span class="vn-chip-texto">Tickets</span></span>
    }
    @if (_porCobrar > 0)
    {
        @* Compacto queda «Impresiones» con su cuenta, como la tecla de abajo (F2 Impresiones), y si aun así falta, la cuenta. *@
        <button class="vn-chip-estado" aria-label="Impresiones por cobrar: @_porCobrar" title="Impresiones por cobrar: @_porCobrar. Lo impreso que falta cobrar, de todas las PC (F2)." @onclick="AlImpresiones">
            <span class="vn-chip-texto">Impresiones</span> <span class="vn-chip-resto">por cobrar</span> <span class="cuenta">@_porCobrar</span>
        </button>
    }
    @if (_controlPrintNoContesta is { } porQue)
    {
        @* Un aviso (2026-10-25): como los demás, cede al final y pierde primero el final de su texto («Control Print no…»). Las de esta
           caja y cobrar a mano con IMP siguen; tocarlo abre F2, que dice lo mismo. *@
        <button class="vn-chip-estado aviso" id="chip-control-print" aria-label="Control Print no contesta"
                title="Control Print no contesta: sus impresiones no se ven en F2. Las de esta caja y cobrar a mano con IMP siguen funcionando. @porQue"
                @onclick="AlImpresiones">
            <Ico Nombre="impresora" /><span class="vn-chip-texto">Control Print no contesta</span>
        </button>
    }
    @* Solo del piloto con eleventa: lo que quedó por revisar con eleventa (se quita al dejarlo). *@
    <PuenteEleventa Caja="Caja" Sesion="Sesion" />
</div>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter] public EventCallback AlImpresiones { get; set; }

    /// <summary>Cada cuánto se vuelven a contar las impresiones por cobrar (también al cobrar y al cerrar F2).</summary>
    private static readonly TimeSpan CadaCuanto = TimeSpan.FromSeconds(45);

    /// <summary>Lo que dice el chip de la conexión.</summary>
    public enum ChipConexion
    {
        ServicioAqui, ConectadaALaPrincipal, SinLaPrincipal, Subiendo,

        /// <summary>La caja principal contesta, pero tarde: se vende con la copia (entrega 5, parte 2).</summary>
        RedLenta,
    }

    /// <summary>
    /// «Sin internet» arriba (la propuesta, «Caja principal y secundarias»): lo dice la caja principal y esta caja llega a ella
    /// (si no llega, no se sabe; la franja dice «Sin red local»). Con la red lenta también: es un hecho. Dice lo mismo que la
    /// franja: en la caja principal sin router, «Sin internet ni red local» (ahí no se dice «no desconectes nada»). Vacío si hay
    /// internet o no se sabe.
    /// </summary>
    public static string? SinInternet(Contingencia? contingencia, ConexionCaja conexion)
    {
        if (contingencia is not { ServidorResponde: true, RedDeLaPrincipal.Internet: false })
            return null;
        var franja = AvisosDeRed.QueDice(conexion.Servicio.IsLoopback, conexion.SimularSinConexion, contingencia.EstadoDeLaRed, contingencia.RedDeLaPrincipal);
        return franja == AvisosDeRed.Franja.SinInternetNiRedLocal ? AvisosDeRed.SinInternetNiRedLocal : AvisosDeRed.SinInternet;
    }

    private static string Titulo(string sinInternet) => $"{sinInternet} Telegram y el respaldo fuera de la tienda esperan a que vuelva.";

    /// <summary>La red de la tienda en el POS: los avisos de lo configurado por nombre o con WSD.</summary>
    private RedDeLaCaja? Red => Servicios.GetService<RedDeLaCaja>();

    /// <summary>Lo que tardó el último latido, como en la propuesta («Conectada a Caja 1 · 9 ms»); vacío si no se sabe.</summary>
    private static string? Ms(TimeSpan? latencia) => latencia is { } l ? $"{Math.Max(1, Math.Round(l.TotalMilliseconds)):0} ms" : null;

    /// <summary>« · 3 por subir» después de «Sin la principal» o «Red lenta»; vacío si no falta nada.</summary>
    private string PorSubir => _contingencia is { Pendientes: > 0 } c ? $" · {c.Pendientes} por subir" : "";

    /// <summary>El chip de una caja secundaria con la principal a la vista: «Conectada a la principal · 9 ms».</summary>
    private string Conectada => $"Conectada a la principal{(Ms(_contingencia?.Latencia) is { } latencia ? $" · {latencia}" : "")}";

    /// <summary>El chip de lo que no salió de la impresora de tickets (toca para reintentar).</summary>
    private string NoSalio => $"Tickets · no salió{(Cola.Pendientes.Count > 1 ? $" ({Cola.Pendientes.Count} por imprimir)" : "")} · Reintentar";

    /// <summary>
    /// Primero lo que sabe la contingencia (la ventana de Windows): si la caja principal no contesta, o si falta subir lo
    /// que se hizo sin ella. Luego, dónde está el servicio. La caja de la prueba tiene el suyo en esta PC y «Simular sin
    /// conexión» en la franja: antes el chip miraba primero dónde está el servicio y seguía diciendo «Servicio aquí»
    /// mientras se simulaba; solo la franja de arriba lo decía. En la caja principal de verdad (su servicio también en esta
    /// PC) «Sin la principal» no aplica (docs/propuesta-interfaz.md, «Caja principal y secundarias»): si su servicio no
    /// contesta un momento (al actualizarlo), sigue diciendo «Servicio aquí», como antes; solo la prueba lo simula.
    /// </summary>
    public static ChipConexion QueDice(Contingencia? contingencia, ConexionCaja conexion) => contingencia switch
    {
        { ServidorResponde: false } when !conexion.Servicio.IsLoopback || conexion.SimularSinConexion => ChipConexion.SinLaPrincipal,
        { EstadoDeLaRed: EstadoRed.Lenta } when !conexion.Servicio.IsLoopback => ChipConexion.RedLenta,
        { Pendientes: > 0 } => ChipConexion.Subiendo,
        _ => conexion.Servicio.IsLoopback ? ChipConexion.ServicioAqui : ChipConexion.ConectadaALaPrincipal,
    };

    private Contingencia? _contingencia;
    private int _porCobrar;

    /// <summary>Por qué Control Print no contesta (2026-10-25); vacío si contesta o no está configurado.</summary>
    private string? _controlPrintNoContesta;
    private readonly CancellationTokenSource _alto = new();

    /// <summary>
    /// La pantalla de venta se vuelve a pintar con cada escaneo; el estado de arriba, solo cuando cambia lo suyo (entrega 5,
    /// parte 3, «Pintar menos»): la conexión, lo que falta por cobrar, o la caja y quien entró.
    /// </summary>
    private bool _cambio = true;

    private (CajaDto, SesionDto)? _pintadoCon;

    protected override void OnParametersSet()
    {
        if (_pintadoCon is not { } antes || !ReferenceEquals(antes.Item1, Caja) || !ReferenceEquals(antes.Item2, Sesion))
            _cambio = true;
        _pintadoCon = (Caja, Sesion);
    }

    protected override bool ShouldRender()
    {
        var pintar = _cambio;
        _cambio = false;
        return pintar;
    }

    /// <summary>Cambió algo de lo suyo: se vuelve a pintar.</summary>
    private void Pintar()
    {
        _cambio = true;
        StateHasChanged();
    }

    /// <summary>La cola de la impresora de tickets (entrega 5, parte 3): si algo no salió, el chip lo dice.</summary>
    private ColaDeImpresion Cola => ColaDeImpresion.De(Impresora);

    protected override void OnInitialized()
    {
        // Solo la ventana de Windows trabaja sin conexión; en el navegador de la caja principal no hay contingencia.
        _contingencia = Servicios.GetService<Contingencia>();
        if (_contingencia is not null)
            _contingencia.Cambio += AlCambiar;
        Cola.Cambio += AlCambiar;
        _ = VigilarAsync();
    }

    private void AlCambiar() => _ = InvokeAsync(Pintar);

    private async Task VigilarAsync()
    {
        using var reloj = new PeriodicTimer(CadaCuanto);
        try
        {
            do
                await InvokeAsync(ActualizarAsync);
            while (await reloj.WaitForNextTickAsync(_alto.Token));
        }
        catch (OperationCanceledException)
        {
            // Se cerró la pantalla.
        }
    }

    /// <summary>
    /// Cuenta otra vez lo que falta por cobrar (después de cobrar o de cerrar F2): las de la sucursal y las tarjetas de Control Print,
    /// sin las listas ni sus miniaturas (la caja 2 tiene pocos recursos), y si Control Print contesta.
    /// </summary>
    public async Task ActualizarAsync()
    {
        var (antes, antesNoContesta) = (_porCobrar, _controlPrintNoContesta);
        try
        {
            var resumen = await Cliente.ResumenPorCobrarAsync(Caja.SucursalId);
            _porCobrar = resumen.DeLaSucursal + resumen.DeControlPrint;
            _controlPrintNoContesta = resumen is { ControlPrintConfigurado: true, ControlPrintContesta: false }
                ? resumen.ControlPrintAviso ?? "Control Print no contesta."
                : null;
        }
        catch (ErrorCaja)
        {
            // Sin la caja principal no se sabe: los chips se ocultan hasta que vuelva.
            (_porCobrar, _controlPrintNoContesta) = (0, null);
        }
        if (_porCobrar != antes || _controlPrintNoContesta != antesNoContesta)
            Pintar();
    }

    public async ValueTask DisposeAsync()
    {
        if (_contingencia is not null)
            _contingencia.Cambio -= AlCambiar;
        Cola.Cambio -= AlCambiar;
        await _alto.CancelAsync();
        _alto.Dispose();
    }
}
