@* Solo del piloto con eleventa (se quita al dejarlo): en el estado de arriba de la caja 2, lo que quedó por revisar con
   eleventa y lo que conviene saber (sin Telegram, que está en pausa): también si el puente se detuvo porque eleventa se
   restauró, o si espera a respaldarla. Sale solo si hay algo. Quien tiene «Configuración de la tienda» marca ahí lo que
   ya se anotó a mano en eleventa (de una devolución de aquí, eligiendo cuál es su anotación allá) y reanuda el puente
   (docs/migracion-eleventa.md, «Lo que falta para el piloto»). *@
@implements IAsyncDisposable
@inject ClienteCaja Cliente
@inject IServiceProvider Servicios

@if (_puente is { } p && (p.PorRevisar.Count > 0 || p.Avisos.Count > 0 || p.Detenido is not null || p.Respaldo is not null))
{
    <div class="vn-puente">
        <button class="vn-chip-estado aviso" title="Lo que pasa con eleventa: toca para verlo" @onclick="() => _abierto = !_abierto">
            <Ico Nombre="alerta" />Eleventa@(p.Detenido is not null ? " · detenido" : "")@(p.PorRevisar.Count > 0 ? $" · {p.PorRevisar.Count} por revisar" : "")
        </button>
        @if (_abierto)
        {
            <div class="vn-fondo-menu" @onclick="() => _abierto = false"></div>
            <div class="vn-puente-panel" role="dialog" aria-label="El puente con eleventa">
                <p class="vn-puente-titulo">El puente con eleventa</p>
                @if (p.Detenido is { } detenido)
                {
                    <div class="vn-alerta"><Ico Nombre="alerta" /><div><span>@detenido</span></div></div>
                    @if (PuedeMarcar)
                    {
                        <button class="vn-boton chico" disabled="@_ocupado" @onclick="ReanudarAsync">Ya revisé eleventa: reanudar</button>
                    }
                }
                @if (p.Respaldo is { } respaldo)
                {
                    <div class="vn-alerta"><Ico Nombre="alerta" /><div><span>@respaldo</span></div></div>
                }
                @foreach (var aviso in p.Avisos)
                {
                    <p class="vn-puente-aviso">@aviso</p>
                }
                @if (p.PorRevisar.Count > 0)
                {
                    <p class="vn-puente-nota">Por revisar: no pasó solo a eleventa. Se anota a mano allá y después se marca aquí.</p>
                    <ul class="vn-puente-lista">
                        @foreach (var item in p.PorRevisar)
                        {
                            var revisar = item;
                            <li>
                                <div><strong>@item.Descripcion</strong> · @item.FechaLocal.ToString("dd/MM HH:mm") · @Formato.Dinero(item.TotalCentavos)</div>
                                <div class="vn-puente-motivo">@item.Motivo</div>
                                @if (PuedeMarcar && item.EligeAnotacion && _eligiendo == item.EnvioId && _anotaciones is { } anotaciones)
                                {
                                    @* Una devolución de aquí: quien la anotó en eleventa dice cuál es su anotación allá (se ligan). *@
                                    @if (anotaciones.Count == 0)
                                    {
                                        <div class="vn-puente-motivo">En eleventa todavía no hay una devolución de este ticket después de la de aquí: anótala allá y vuelve a marcarla.</div>
                                    }
                                    else
                                    {
                                        <div class="vn-puente-motivo">¿Cuál es su anotación en eleventa? Marca la que hiciste allá (o las que, juntas, son la de aquí).</div>
                                        @foreach (var a in anotaciones)
                                        {
                                            var anotacion = a;
                                            <label class="vn-puente-anotacion">
                                                <input type="checkbox" checked="@_elegidas.Contains(a.Id)" @onchange="e => Elegir(anotacion.Id, e.Value is true)" />
                                                <span>#@a.Id · @a.DevueltaLocal.ToString("dd/MM HH:mm") · @a.Caja, @a.Cajero · @a.Detalle · @Formato.Dinero(a.TotalCentavos)</span>
                                            </label>
                                        }
                                        <button class="vn-boton chico" disabled="@(_ocupado || _elegidas.Count == 0)" @onclick="() => MarcarAsync(revisar)">Es su anotación</button>
                                    }
                                }
                                else if (PuedeMarcar)
                                {
                                    <button class="vn-boton chico" disabled="@_ocupado" @onclick="() => item.EligeAnotacion ? ElegirAnotacionAsync(revisar) : MarcarAsync(revisar)">
                                        @(item.EnvioId is not null ? "Ya lo anoté en eleventa" : "Ya lo revisé")
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (_error is not null)
                {
                    <p class="error">@_error</p>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Cada cuánto se vuelve a preguntar (lo que pasa con eleventa no cambia a cada segundo).</summary>
    private static readonly TimeSpan CadaCuanto = TimeSpan.FromSeconds(30);

    private PuenteEleventaDto? _puente;
    // La devolución de aquí de la que se está eligiendo su anotación en eleventa, lo que se leyó allá y lo elegido.
    private Guid? _eligiendo;
    private List<AnotacionEnEleventaDto>? _anotaciones;
    private readonly HashSet<int> _elegidas = [];
    private bool _abierto;
    private bool _ocupado;
    private string? _error;
    private readonly CancellationTokenSource _alto = new();

    /// <summary>Lo que ya se anotó a mano en eleventa lo marca quien tiene «Configuración de la tienda».</summary>
    private bool PuedeMarcar => Sesion.Permisos?.Any(x => x.Accion == AccionControlada.ConfigurarTienda && x.Nivel == NivelPermiso.Permitido) == true;

    private ClientePuente? Puente => Servicios.GetService<ClientePuente>();

    protected override void OnInitialized() => _ = VigilarAsync();

    private async Task VigilarAsync()
    {
        // Solo en el piloto: la caja lo sabe por la contingencia o se lo pregunta al servicio.
        if (Puente is null || !(Servicios.GetService<Contingencia>()?.PilotoEleventa ?? await PilotoAsync()))
            return;
        using var reloj = new PeriodicTimer(CadaCuanto);
        try
        {
            do
                await InvokeAsync(ActualizarAsync);
            while (await reloj.WaitForNextTickAsync(_alto.Token));
        }
        catch (OperationCanceledException)
        {
            // Se cerró la pantalla.
        }
    }

    private async Task<bool> PilotoAsync()
    {
        try
        {
            return await Cliente.PilotoEleventaAsync();
        }
        catch (ErrorCaja)
        {
            return false;
        }
    }

    public async Task ActualizarAsync()
    {
        try
        {
            _puente = await Puente!.PantallaAsync();
        }
        catch (ErrorCaja)
        {
            // Sin la caja principal no se sabe: se deja lo último que se supo.
        }
        StateHasChanged();
    }

    private async Task MarcarAsync(PorRevisarEleventaDto item)
    {
        _error = null;
        _ocupado = true;
        try
        {
            if (item.EnvioId is { } envio)
                await Puente!.AnotarAManoAsync(envio, new SolicitudAnotadoAMano(Sesion.UsuarioId, null, item.EligeAnotacion ? _elegidas.ToList() : null));
            else if (item.VueltaId is { } vuelta)
                await Puente!.VueltaRevisadaAsync(vuelta, new SolicitudRevision(Sesion.UsuarioId, null));
            (_eligiendo, _anotaciones) = (null, null);
            _elegidas.Clear();
            await ActualizarAsync();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>
    /// «Ya lo anoté en eleventa» de una devolución de aquí: se leen en eleventa las devoluciones de su ticket que pueden ser su
    /// anotación, para elegir cuál es.
    /// </summary>
    private async Task ElegirAnotacionAsync(PorRevisarEleventaDto item)
    {
        _error = null;
        _ocupado = true;
        try
        {
            _anotaciones = await Puente!.AnotacionesAsync(item.EnvioId!.Value);
            _eligiendo = item.EnvioId;
            _elegidas.Clear();
        }
        catch (ErrorCaja ex)
        {
            // También cuando llegó sola a eleventa: el servicio ya la dio por enviada, y deja de enseñarse.
            _error = ex.Message;
            await ActualizarAsync();
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Elegir(int anotacion, bool elegida)
    {
        if (elegida)
            _elegidas.Add(anotacion);
        else
            _elegidas.Remove(anotacion);
    }

    /// <summary>El puente se detuvo porque eleventa se restauró: quien revisó eleventa lo reanuda (queda en la bitácora).</summary>
    private async Task ReanudarAsync()
    {
        _error = null;
        _ocupado = true;
        try
        {
            _puente = await Puente!.ReanudarAsync(new SolicitudReanudarPuente(Sesion.UsuarioId, Caja.Id, null));
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _alto.CancelAsync();
        _alto.Dispose();
    }
}
