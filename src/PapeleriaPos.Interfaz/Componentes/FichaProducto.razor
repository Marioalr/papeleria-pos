@* La ficha de un producto, en el detalle de la página de Productos (F3): sus variantes, presentaciones (con sus códigos) y
   precios, todo junto, y el mínimo y el máximo de inventario de cada variante (como en eleventa: con su mínimo o menos sale
   en «Poca existencia» y en «Bajos en inventario»; vacío, 3 o menos). La guarda quien tiene «Productos, precios y
   etiquetas»; el costo y los proveedores solo los ve quien ve los costos. En el piloto con eleventa, de un producto de
   eleventa lo que pone su lectura se ve pero no se cambia (el nombre, el departamento y si se vende, si está activa cada
   variante, los códigos de la pieza, el menudeo y las promociones de eleventa, y desde el 2026-10-24 el mínimo y el máximo:
   el inventario se lleva allá) y no se depura; lo demás, sí. Lo dice una nota arriba. *@
@inject ClienteCaja Cliente

@if (_error is not null && _producto is null)
{
    <p class="error">@_error</p>
}
else if (_producto is null)
{
    <p>Cargando…</p>
}
else
{
    var p = _producto;
    @if (_enEleventa is { } enEleventa)
    {
        <div class="vn-alerta info"><Ico Nombre="info" /><div><span>@enEleventa</span></div></div>
    }
    @if (p.PorCompletar)
    {
        <p class="aviso-autorizacion">Lo dio de alta un cajero desde la caja: complétalo (departamento, marca, presentaciones) y guárdalo.</p>
    }
    <div class="ficha-producto">
        <label class="ancho">Nombre <input @bind="p.Nombre" maxlength="150" autocomplete="off" disabled="@_productoDeEleventa" /></label>
        <label>Departamento
            <select @bind="p.DepartamentoId" disabled="@_productoDeEleventa">
                @if (_suyoDesactivado is { } suyo)
                {
                    <option value="@suyo.Id">@suyo.Nombre (desactivado)</option>
                }
                @foreach (var d in Opciones.Departamentos)
                {
                    <option value="@d.Id">@d.Nombre</option>
                }
            </select>
            @if (Opciones.Departamentos.Count == 0)
            {
                <span class="nota">No hay departamentos activos: dalos de alta en «Departamentos», abajo de la lista.</span>
            }
        </label>
        <label>Marca <input list="marcas" @bind="p.Marca" autocomplete="off" placeholder="Sin marca" /></label>
        <datalist id="marcas">
            @foreach (var m in Opciones.Marcas)
            {
                <option value="@m"></option>
            }
        </datalist>
        <label>Tipo
            <select @bind="p.Tipo">
                <option value="@TipoProducto.Mercancia">Mercancía (lleva inventario)</option>
                <option value="@TipoProducto.Servicio">Servicio</option>
            </select>
        </label>
        <label>IVA
            <select @bind="p.Impuesto">
                <option value="@Impuesto.Iva16">16 %</option>
                <option value="@Impuesto.Iva0">0 %</option>
                <option value="@Impuesto.Exento">Exento</option>
            </select>
        </label>
        <label class="en-linea opcion"><input type="checkbox" @bind="p.Activo" disabled="@_productoDeEleventa" /> Se vende (activo)</label>
    </div>

    @foreach (var v in p.Variantes)
    {
        var variante = v;
        <fieldset class="variante">
            <legend>@(p.Variantes.Count > 1 ? $"Variante {p.Variantes.IndexOf(variante) + 1}" : "Producto")</legend>
            <div class="ficha-producto">
                <label class="ancho">Variante (color, tamaño…) <input @bind="variante.Descripcion" placeholder="@(p.Variantes.Count > 1 ? "Azul, Carta…" : "Vacío si es la única")" autocomplete="off" /></label>
                <label>Se vende por
                    <select @bind="variante.Unidad">
                        <option value="@UnidadBase.Pieza">Pieza</option>
                        <option value="@UnidadBase.Metro">Metro</option>
                        <option value="@UnidadBase.Kilogramo">Kilo</option>
                        <option value="@UnidadBase.Litro">Litro</option>
                        <option value="@UnidadBase.PiezaAGranel">Pieza a granel (con fracciones)</option>
                    </select>
                </label>
                <label class="en-linea opcion"><input type="checkbox" @bind="variante.Activa" disabled="@variante.DeEleventa" /> Activa</label>
                @if (p.Tipo == TipoProducto.Mercancia)
                {
                    @* En el piloto, los de una variante de eleventa los pone su lectura: se ven, pero se cambian allá. *@
                    <label title="@TituloDelMinimo(variante)">
                        Mínimo de inventario
                        <input class="umbral minimo" inputmode="decimal" autocomplete="off" @bind="variante.Minimo" placeholder="@PocaExistencia.Hasta o menos"
                               disabled="@variante.DeEleventa" />
                    </label>
                    <label title="@TituloDelMaximo(variante)">
                        Máximo
                        <input class="umbral maximo" inputmode="decimal" autocomplete="off" @bind="variante.Maximo" placeholder="el del sugerido"
                               disabled="@variante.DeEleventa" />
                    </label>
                    @if (variante.DeEleventa)
                    {
                        <span class="nota">de eleventa</span>
                    }
                }
                @if (variante.Id is not null)
                {
                    <span class="nota">
                        Existencia: @(variante.Existencia is { } e ? Formato.Numero(e) : "—")
                        @if (variante.Costo is { } c)
                        {
                            <span> · costo promedio @Formato.Dinero((long)Math.Round(c))</span>
                        }
                    </span>
                }
            </div>

            @* Su foto (entrega 13, parte 2): la que sale en Ctrl+M, en la búsqueda y en el verificador. Se guarda aparte, al momento. *@
            @if (variante.Id is { } conFoto)
            {
                <FotoDeLaVariante Caja="Caja" Sesion="Sesion" VarianteId="conFoto" PuedeEditar="PuedeEditar"
                                  Nombre="@(variante.Descripcion.Length > 0 ? $"{p.Nombre} {variante.Descripcion}" : p.Nombre)" />
            }
            else
            {
                <p class="nota">La foto se le pone después de guardarlo.</p>
            }

            <h5>Presentaciones y códigos</h5>
            <table class="resultados">
                <thead><tr><th>Nombre</th><th class="num">Contiene</th><th>Base</th><th>Códigos (separados por espacio)</th><th></th></tr></thead>
                @foreach (var pr in variante.Presentaciones)
                {
                    var presentacion = pr;
                    <tr>
                        <td><input @bind="presentacion.Nombre" autocomplete="off" /></td>
                        <td class="num"><input class="umbral" inputmode="decimal" @bind="presentacion.Contiene" disabled="@presentacion.EsBase" /></td>
                        <td><input type="radio" name="base-@variante.Clave" checked="@presentacion.EsBase" disabled="@variante.DeEleventa" @onchange="() => HacerBase(variante, presentacion)" /></td>
                        <td>
                            @if (presentacion.Fijos.Count > 0)
                            {
                                @* Los de eleventa se quedan (la lectura los regresaría); se pueden agregar otros. *@
                                <span class="codigos-fijos" title="@SeCambiaEnEleventa">
                                    @foreach (var fijo in presentacion.Fijos)
                                    {
                                        <code>@fijo</code>
                                    }
                                </span>
                                <input class="codigos" data-escaneo="varios" @bind="presentacion.Codigos" autocomplete="off" placeholder="Otro código" aria-label="Otro código de la pieza" />
                            }
                            else
                            {
                                <input class="codigos" data-escaneo="varios" @bind="presentacion.Codigos" autocomplete="off" />
                            }
                        </td>
                        <td>
                            <button class="boton chico" disabled="@_ocupado" @onclick="() => CodigoInternoAsync(presentacion)">Código interno</button>
                            @if (!presentacion.EsBase)
                            {
                                <button class="boton chico" @onclick="() => variante.Presentaciones.Remove(presentacion)">Quitar</button>
                            }
                        </td>
                    </tr>
                }
            </table>
            <div class="acciones izquierda">
                <button class="boton chico" @onclick="() => variante.Presentaciones.Add(new PresentacionEditable { Contiene = string.Empty })">Agregar presentación</button>
            </div>

            <h5>Precios (con IVA)</h5>
            <table class="resultados">
                <thead><tr><th>De</th><th class="num">Desde (cantidad)</th><th class="num">Precio</th><th></th></tr></thead>
                @foreach (var pc in variante.Precios)
                {
                    var precio = pc;
                    <tr class="@(precio.DeEleventa ? "de-eleventa" : "")">
                        <td>
                            <select @bind="precio.Presentacion" disabled="@precio.DeEleventa">
                                <option value="">Cada @Unidad(variante.Unidad)</option>
                                @foreach (var pr in variante.Presentaciones.Where(x => !x.EsBase && x.Nombre.Trim().Length > 0))
                                {
                                    <option value="@pr.Nombre.Trim()">@pr.Nombre.Trim() (precio propio)</option>
                                }
                            </select>
                        </td>
                        <td class="num"><input class="umbral" inputmode="decimal" @bind="precio.Desde" disabled="@precio.DeEleventa" /></td>
                        <td class="num"><input class="umbral" inputmode="decimal" @bind="precio.Precio" disabled="@precio.DeEleventa" /></td>
                        <td>
                            @if (precio.DeEleventa)
                            {
                                <span class="nota">de eleventa</span>
                            }
                            else
                            {
                                <button class="boton chico" @onclick="() => variante.Precios.Remove(precio)">Quitar</button>
                            }
                        </td>
                    </tr>
                }
            </table>
            <div class="acciones izquierda">
                <button class="boton chico" @onclick="() => variante.Precios.Add(new PrecioEditable())">Agregar precio</button>
                <span class="nota">Desde 1 es el menudeo; más cantidad, mayoreo.</span>
            </div>

            @if (variante.Proveedores is { Count: > 0 } proveedores)
            {
                <p class="nota">Proveedores: @string.Join(" · ", proveedores.Select(x => x.Proveedor + (x.UltimoCostoCentavos is { } u ? $" ({Formato.Dinero(u)})" : "")))</p>
            }
            @if (variante.Id is { } varianteId)
            {
                <div class="acciones izquierda">
                    <button class="boton chico" @onclick="() => KardexAsync(varianteId)">@(_kardexDe == varianteId ? "Ocultar kardex" : "Ver kardex")</button>
                </div>
                @if (PuedeEditar && variante.Activa && !variante.DeEleventa)
                {
                    <DepurarVariante Caja="Caja" Sesion="Sesion" VarianteId="varianteId" Unidad="variante.Unidad"
                                     Nombre="@(variante.Descripcion.Length > 0 ? $"{p.Nombre} {variante.Descripcion}" : p.Nombre)" AlTerminar="DepuradoAsync" />
                }
                @if (_kardexDe == varianteId && _kardex is { } kardex)
                {
                    <div class="resultados kardex">
                        <table>
                            <thead><tr><th>Fecha</th><th>Movimiento</th><th class="num">Cantidad</th><th class="num">Existencia</th><th>Quién</th><th>Motivo</th></tr></thead>
                            @foreach (var m in kardex)
                            {
                                <tr>
                                    <td>@m.FechaLocal.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@Movimiento(m.Tipo)</td>
                                    <td class="num">@Formato.Numero(m.Cantidad)</td>
                                    <td class="num">@Formato.Numero(m.Existencia)</td>
                                    <td>@m.Quien</td>
                                    <td>@m.Motivo</td>
                                </tr>
                            }
                        </table>
                    </div>
                }
            }
        </fieldset>
    }
    <div class="acciones izquierda">
        <button class="boton" @onclick="AgregarVariante">Agregar variante</button>
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_aviso is not null)
    {
        <p class="aviso">@_aviso</p>
    }
    <div class="acciones">
        <button class="boton" @onclick="AlVolver">@TextoVolver</button>
        @if (PuedeEditar)
        {
            <button class="boton principal" disabled="@_ocupado" @onclick="GuardarAsync">Guardar</button>
        }
        else
        {
            <span class="nota">El catálogo lo editan el dueño y el encargado.</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public OpcionesCatalogoDto Opciones { get; set; } = null!;

    /// <summary>Vacío: un producto nuevo.</summary>
    [Parameter] public Guid? ProductoId { get; set; }

    [Parameter] public EventCallback AlVolver { get; set; }

    /// <summary>Lo que dice el botón de regresar: en la página de Productos, al producto (o «Cancelar» si es nuevo).</summary>
    [Parameter] public string TextoVolver { get; set; } = "Volver a la lista";

    /// <summary>Se guardó: la ficha como quedó (uno nuevo ya trae su Id).</summary>
    [Parameter] public EventCallback<FichaProductoDto> AlGuardar { get; set; }

    private sealed class PresentacionEditable
    {
        public Guid? Id { get; init; }
        public string Nombre { get; set; } = "";
        public string Contiene { get; set; } = "1";
        public bool EsBase { get; set; }

        /// <summary>Los que se escriben; con <see cref="Fijos"/>, los que se agregan.</summary>
        public string Codigos { get; set; } = "";

        /// <summary>En el piloto, los de la pieza de una variante de eleventa: se quedan (se pueden agregar otros).</summary>
        public IReadOnlyList<string> Fijos { get; init; } = [];
        public HashSet<string> Internos { get; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private sealed class PrecioEditable
    {
        public string Presentacion { get; set; } = "";
        public string Desde { get; set; } = "1";
        public string Precio { get; set; } = "";

        /// <summary>En el piloto, el menudeo o una promoción de eleventa: lo pone su lectura y no se cambia aquí.</summary>
        public bool DeEleventa { get; init; }
    }

    private sealed class VarianteEditable
    {
        public Guid Clave { get; } = Guid.NewGuid();
        public Guid? Id { get; init; }
        public string Descripcion { get; set; } = "";
        public UnidadBase Unidad { get; set; } = UnidadBase.Pieza;
        public bool Activa { get; set; } = true;
        public List<PresentacionEditable> Presentaciones { get; init; } = [];
        public List<PrecioEditable> Precios { get; init; } = [];
        public decimal? Existencia { get; init; }
        public decimal? Costo { get; init; }
        public IReadOnlyList<ProveedorFichaDto>? Proveedores { get; init; }

        /// <summary>En el piloto, viene de eleventa: si está activa y su presentación base no se cambian aquí, ni se depura.</summary>
        public bool DeEleventa { get; init; }

        /// <summary>Su mínimo y su máximo de inventario, como se escriben (en su unidad); vacíos: sin propio.</summary>
        public string Minimo { get; set; } = "";
        public string Maximo { get; set; } = "";
    }

    private sealed class ProductoEditable
    {
        public Guid? Id { get; init; }
        public string Nombre { get; set; } = "";
        public Guid DepartamentoId { get; set; }
        public string? Marca { get; set; }
        public TipoProducto Tipo { get; set; } = TipoProducto.Mercancia;
        public Impuesto Impuesto { get; set; } = Impuesto.Iva16;
        public string? ClaveSat { get; init; }
        public bool Activo { get; set; } = true;
        public bool PorCompletar { get; set; }
        public List<VarianteEditable> Variantes { get; init; } = [];
    }

    private ProductoEditable? _producto;

    /// <summary>
    /// Su departamento, si se desactivó (Productos › Departamentos): se sigue viendo y se puede dejar, pero no se le ofrece a
    /// los demás. El servicio no deja reactivar el producto ahí.
    /// </summary>
    private OpcionCatalogoDto? _suyoDesactivado;

    /// <summary>En el piloto con eleventa, si algo de este producto viene de eleventa: la nota de arriba.</summary>
    private string? _enEleventa;

    /// <summary>En el piloto, su nombre, su departamento y si se vende los pone la lectura de eleventa.</summary>
    private bool _productoDeEleventa;

    /// <summary>Lo que dice, al pasar el ratón, lo que pone la lectura de eleventa (los códigos de la pieza, el mínimo y el máximo).</summary>
    private const string SeCambiaEnEleventa = "De eleventa: mientras dure el piloto, se cambian allá";

    private static string TituloDelMinimo(VarianteEditable v) =>
        v.DeEleventa ? SeCambiaEnEleventa : $"Con esto o menos sale en «Poca existencia» y en «Bajos en inventario». Vacío: {PocaExistencia.Hasta} o menos.";

    private static string TituloDelMaximo(VarianteEditable v) =>
        v.DeEleventa ? SeCambiaEnEleventa : "«Bajos en inventario» dice cuánto pedir para llegar a él. Vacío: lo que pide el sugerido de compra.";

    private Guid? _kardexDe;
    private List<MovimientoKardexDto>? _kardex;
    private string? _error;
    private string? _aviso;
    private bool _ocupado;

    /// <summary>Con «Productos, precios y etiquetas» (con los usuarios de antes, el encargado y el dueño). El servicio decide.</summary>
    private bool PuedeEditar => Sesion.Puede(AccionControlada.EditarCatalogo);

    protected override async Task OnInitializedAsync()
    {
        if (ProductoId is not { } id)
        {
            _producto = new ProductoEditable { DepartamentoId = Opciones.Departamentos.FirstOrDefault()?.Id ?? Guid.Empty };
            AgregarVariante();
            return;
        }
        try
        {
            if (await Cliente.FichaProductoAsync(id, Caja.SucursalId, Sesion.UsuarioId) is { } ficha)
                Mostrar(ficha);
            else
                _error = "El producto ya no existe.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private void Mostrar(FichaProductoDto f)
    {
        _suyoDesactivado = Opciones.Departamentos.Any(d => d.Id == f.DepartamentoId) ? null : Opciones.Desactivados?.FirstOrDefault(d => d.Id == f.DepartamentoId);
        (_enEleventa, _productoDeEleventa) = (f.EnEleventa, f.ProductoDeEleventa);
        _producto = Editable(f);
    }

    private ProductoEditable Editable(FichaProductoDto f) => new()
    {
        Id = f.Id, Nombre = f.Nombre, DepartamentoId = f.DepartamentoId, Marca = f.Marca, Tipo = f.Tipo, Impuesto = f.Impuesto, ClaveSat = f.ClaveSat,
        Activo = f.Activo, PorCompletar = f.PorCompletar,
        Variantes = f.Variantes.Select(v => new VarianteEditable
        {
            Id = v.Id, Descripcion = v.Descripcion, Unidad = v.Unidad, Activa = v.Activa, Existencia = v.Existencia, Costo = v.CostoPromedioCentavos,
            Proveedores = v.Proveedores, DeEleventa = v.DeEleventa,
            Minimo = v.MinimoYMaximo?.MinimoMilesimas is { } minimo ? Numero(minimo) : "",
            Maximo = v.MinimoYMaximo?.MaximoMilesimas is { } maximo ? Numero(maximo) : "",
            Presentaciones = v.Presentaciones.Select(p =>
            {
                // En el piloto, los códigos de la pieza de una variante de eleventa se quedan: solo se agregan otros.
                var fijos = v.DeEleventa && p.EsBase;
                var editable = new PresentacionEditable
                {
                    Id = p.Id, Nombre = p.Nombre, Contiene = Numero(p.FactorMilesimas), EsBase = p.EsBase,
                    Codigos = fijos ? "" : string.Join(" ", p.Codigos.Select(c => c.Codigo)),
                    Fijos = fijos ? p.Codigos.Select(c => c.Codigo).ToList() : [],
                };
                editable.Internos.UnionWith(p.Codigos.Where(c => c.Origen == OrigenCodigo.Interno).Select(c => c.Codigo));
                return editable;
            }).ToList(),
            Precios = v.Precios.Select(p => new PrecioEditable
            {
                Presentacion = p.Presentacion ?? "", Desde = Numero(p.CantidadMinimaMilesimas), Precio = (p.PrecioCentavos / 100m).ToString("0.00", CultureInfo.InvariantCulture),
                DeEleventa = p.DeEleventa,
            }).ToList(),
        }).ToList(),
    };

    private void AgregarVariante() => _producto!.Variantes.Add(new VarianteEditable
    {
        Presentaciones = [new PresentacionEditable { Nombre = "Pieza", EsBase = true }],
        Precios = [new PrecioEditable()],
    });

    private static void HacerBase(VarianteEditable variante, PresentacionEditable presentacion)
    {
        foreach (var p in variante.Presentaciones)
            p.EsBase = p == presentacion;
        presentacion.Contiene = "1";
    }

    private async Task CodigoInternoAsync(PresentacionEditable presentacion)
    {
        _error = null;
        _ocupado = true;
        try
        {
            var codigo = await Cliente.CodigoInternoAsync();
            presentacion.Internos.Add(codigo);
            presentacion.Codigos = (presentacion.Codigos.Trim() + " " + codigo).Trim();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task KardexAsync(Guid varianteId)
    {
        if (_kardexDe == varianteId)
        {
            (_kardexDe, _kardex) = (null, null);
            return;
        }
        try
        {
            _kardex = await Cliente.KardexAsync(varianteId, Caja.SucursalId);
            _kardexDe = varianteId;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Después de depurar, la ficha al día (lo que se dio de baja o se juntó se ve inactivo).</summary>
    private async Task DepuradoAsync(string mensaje)
    {
        _aviso = mensaje;
        if (_producto?.Id is not { } id)
            return;
        try
        {
            if (await Cliente.FichaProductoAsync(id, Caja.SucursalId, Sesion.UsuarioId) is { } ficha)
                Mostrar(ficha);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        (_kardexDe, _kardex) = (null, null);
    }

    private async Task GuardarAsync()
    {
        (_error, _aviso) = (null, null);
        var p = _producto!;
        var variantes = new List<VarianteFichaDto>();
        foreach (var v in p.Variantes)
        {
            var presentaciones = new List<PresentacionFichaDto>();
            foreach (var pr in v.Presentaciones)
            {
                if (Milesimas(pr.EsBase ? "1" : pr.Contiene) is not { } factor)
                {
                    _error = $"Revisa cuánto contiene «{pr.Nombre}».";
                    return;
                }
                var escritos = pr.Codigos.Split([' ', ','], StringSplitOptions.RemoveEmptyEntries)
                    .Where(c => !pr.Fijos.Contains(c, StringComparer.OrdinalIgnoreCase));
                var codigos = pr.Fijos.Concat(escritos)
                    .Select(c => new CodigoFichaDto(c, pr.Internos.Contains(c) ? OrigenCodigo.Interno : OrigenCodigo.Fabrica)).ToList();
                presentaciones.Add(new PresentacionFichaDto(pr.Id, pr.Nombre, factor, pr.EsBase, codigos));
            }
            var precios = new List<PrecioFichaDto>();
            foreach (var pc in v.Precios)
            {
                if (Milesimas(pc.Desde) is not { } desde || Formato.LeerPesos(pc.Precio) is not ({ } centavos and > 0))
                {
                    _error = Formato.ProblemaDePesos(pc.Precio) is { } coma ? $"Revisa los precios: {char.ToLowerInvariant(coma[0])}{coma[1..]}"
                        : "Revisa los precios: cada uno lleva desde qué cantidad y cuánto.";
                    return;
                }
                precios.Add(new PrecioFichaDto(pc.Presentacion.Length == 0 ? null : pc.Presentacion, desde, centavos));
            }
            var quien = v.Descripcion.Trim().Length > 0 ? $"{p.Nombre.Trim()} {v.Descripcion.Trim()}" : p.Nombre.Trim();
            // Siempre van (vacíos: sin propio); un servicio no lleva inventario y el servicio los deja vacíos. En el piloto, los
            // de una variante de eleventa no: los pone la lectura, y sin ellos se quedan como están (aunque la lectura los haya
            // cambiado mientras la ficha estaba abierta).
            MinimoYMaximoDto? minimoYMaximo = null;
            if (!v.DeEleventa)
            {
                if (!LeerCantidad(v.Minimo, out var minimo) || !LeerCantidad(v.Maximo, out var maximo))
                {
                    _error = $"Revisa el mínimo y el máximo de «{quien}»: una cantidad, o vacío.";
                    return;
                }
                minimoYMaximo = new MinimoYMaximoDto(minimo, maximo);
            }
            variantes.Add(new VarianteFichaDto(v.Id, v.Descripcion, v.Unidad, v.Activa, presentaciones, precios, MinimoYMaximo: minimoYMaximo));
        }
        var ficha = new FichaProductoDto(p.Id, p.Nombre, p.DepartamentoId, p.Marca, p.Tipo, p.Impuesto, p.ClaveSat, p.Activo, p.PorCompletar, variantes);
        _ocupado = true;
        try
        {
            var guardada = await Cliente.GuardarProductoAsync(new SolicitudGuardarProducto(Sesion.UsuarioId, Caja.SucursalId, ficha));
            Mostrar(guardada);
            _aviso = "Guardado: las cajas ya lo venden así.";
            await AlGuardar.InvokeAsync(guardada);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>Con la regla de los números del POS: «1,000» son mil y «2,5» no se adivina (antes eran 25; revisión del PR #138).</summary>
    private static long? Milesimas(string texto) =>
        Formato.LeerCantidad(texto) is { } n && n > 0 ? (long)Math.Round(n * Cantidad.Escala) : null;

    /// <summary>
    /// Un mínimo o un máximo escrito: vacío es «sin propio» (null); si no, una cantidad (el cero vale como mínimo). Lo demás
    /// (que no sea negativo, ni con fracciones en piezas, ni el máximo debajo del mínimo) lo revisa el servicio.
    /// </summary>
    private static bool LeerCantidad(string texto, out long? milesimas)
    {
        milesimas = null;
        var limpio = texto.Trim();
        if (limpio.Length == 0)
            return true;
        if (Formato.LeerCantidad(limpio) is not { } n || Math.Abs(n) > Variante.TopeMinimoYMaximo)
            return false;
        milesimas = (long)Math.Round(n * Cantidad.Escala);
        return true;
    }

    private static string Numero(long milesimas) => (milesimas / (decimal)Cantidad.Escala).ToString("0.###", CultureInfo.InvariantCulture);

    private static string Unidad(UnidadBase u) => u switch
    {
        UnidadBase.Metro => "metro",
        UnidadBase.Kilogramo => "kilo",
        UnidadBase.Litro => "litro",
        _ => "pieza",
    };

    private static string Movimiento(PapeleriaPos.Nucleo.Inventario.TipoMovimiento t) => t switch
    {
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.InventarioInicial => "Inventario inicial",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Venta => "Venta",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Devolucion => "Devolución",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Compra => "Compra",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Ajuste => "Ajuste",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Merma => "Merma",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.TraspasoSalida => "Traspaso (salida)",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.TraspasoEntrada => "Traspaso (entrada)",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.ConsumoServicio => "Consumo de servicio",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.AperturaPaquete => "Apertura de paquete",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.AgregarInventario => "Agregar inventario",
        _ => "Conteo",
    };
