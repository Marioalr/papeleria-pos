        public string Nombre { get; set; } = "";
        public string Contiene { get; set; } = "1";
        public bool EsBase { get; set; }

        /// <summary>Los que se escriben; con <see cref="Fijos"/>, los que se agregan.</summary>
        public string Codigos { get; set; } = "";

        /// <summary>En el piloto, los de la pieza de una variante de eleventa: se quedan (se pueden agregar otros).</summary>
        public IReadOnlyList<string> Fijos { get; init; } = [];
        public HashSet<string> Internos { get; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private sealed class PrecioEditable
    {
        [JsonIgnore] public Guid Clave { get; } = Guid.NewGuid();

        /// <summary>Vacío: por unidad (el menudeo o un mayoreo). Con nombre: el precio propio de esa caja o paquete.</summary>
        public string Presentacion { get; set; } = "";
        public string Desde { get; set; } = "1";
        public string Precio { get; set; } = "";

        /// <summary>El de cada unidad desde una (el que va en la fila del precio): uno por variante.</summary>
        [JsonIgnore] public bool Menudeo { get; init; }

        /// <summary>La ganancia que se ve (o se escribe) junto al precio, en porcentaje; no se guarda: sale del precio y del costo.</summary>
        public string Margen { get; set; } = "";

        /// <summary>La que salió del precio y el costo: si lo de la casilla es eso, no se escribió otra.</summary>
        [JsonIgnore] public string MargenCalculado { get; set; } = "";

        /// <summary>
        /// La ganancia que se escribió y puso el precio (o espera el costo para ponerlo): mientras no se escriba el precio, el
