@* La ficha de un producto, en el detalle de la página de Productos (F3): la misma para uno nuevo y para editar. Acomodo del
   2026-11-20 (docs/propuestas/nuevo-producto.md, aprobado por el dueño): arriba lo que pide eleventa en su «Nuevo producto»
   (el código de barras, el nombre, el departamento, la marca) y la fila del precio: lo que cuesta → el precio de venta (con
   IVA, lo que paga el cliente, la casilla grande) → se vende por → la ganancia en %, con la ganancia en pesos escrita abajo.
   El precio que se escribe se guarda tal cual, al centavo; solo el que sale de la ganancia sube a los siguientes 50 centavos (y
   lo dice). Abajo, cerradas y con un renglón que dice lo que tienen, «Inventario» (el mínimo y el máximo: como en eleventa,
   con su mínimo o menos sale en «Poca existencia» y en «Bajos en inventario»; vacío, 3 o menos), «Mayoreo y cajas», «Colores,
   tamaños…» (las variantes, en una tabla) y «Otros datos» (IVA, si se vende, si es un servicio y, al editar, la foto, los
   proveedores, el kardex y depurar). Se abren solas si tienen algo. La guarda quien tiene «Productos, precios y etiquetas»; el
   costo solo lo ve quien ve los costos y la ganancia quien tiene «Ver costos, utilidad y margen». En el piloto con eleventa, de
   un producto de eleventa lo que pone su lectura se ve con su candado («Se cambia en eleventa»: el nombre y si se vende, si
   está activa cada variante, los códigos de la pieza, el menudeo, las promociones de eleventa y el costo) y no se depura; lo
   demás, sí: el departamento, el mínimo y el máximo y la unidad, entre pieza, pieza a granel, metro y litro. Lo dice una nota
   arriba. Un nuevo abre con el cursor en el código; uno que ya existe, en el precio. Enter pasa al siguiente campo de arriba (en
   el precio, a «Guardar» si ya está lo que hace falta); «Guardar» queda a la vista abajo y Ctrl+Enter guarda.
   2026-11-21 (el dueño; en eleventa, «Hay»): en una variante nueva de mercancía, «¿Cuántas hay?» (debajo del precio; con varias,
   en «Inventario»), para quien tiene «Agregar inventario» y fuera del piloto. Entra al guardar, en la misma llamada y la misma
   transacción que el alta, como un «Agregar inventario» al costo escrito. Con ella, el Enter del precio pasa ahí y el de ahí, a
   «Guardar». *@
@using System.Text.Json
@using System.Text.Json.Serialization
@inject ClienteCaja Cliente
@inject ModuloCaja Js

@if (_error is not null && _producto is null)
{
    <p class="error">@_error</p>
}
else if (_producto is null)
{
    <p>Cargando…</p>
}
else
{
    var p = _producto;
    var varias = VariasVariantes;
    var v0 = p.Variantes[0];
    <div id="ficha-campos" class="vn-adentro ficha" @onkeydown="AlTeclearAsync">
    @if (_enEleventa is { } enEleventa)
    {
        <div class="vn-alerta info"><Ico Nombre="info" /><div><span>@enEleventa</span></div></div>
    }
    @if (p.PorCompletar)
    {
        <p class="aviso-autorizacion">@PorCompletar(p)</p>
    }

    <div class="ficha-tarjeta">
        <div class="ficha-rejilla">
            @if (!varias)
            {
                var pieza = Base(v0);
                <div class="ficha-campo ancho2">
                    <label class="ficha-et" for="ficha-codigo">Código de barras</label>
                    <span class="ficha-con-boton">
                        @if (pieza.Fijos.Count > 0)
                        {
                            @* Los de eleventa se quedan (la lectura los regresaría); se pueden agregar otros. *@
                            <span class="codigos-fijos" title="@SeCambiaEnEleventa">
                                @foreach (var fijo in pieza.Fijos)
                                {
                                    <code>@fijo</code>
                                }
                            </span>
                            <input id="ficha-codigo" class="codigos" data-escaneo="varios" @bind="pieza.Codigos" @onkeydown="e => EnterAsync(e, Campo.Codigo)"
                                   autocomplete="off" placeholder="Otro código" aria-label="Otro código de la pieza" />
                        }
                        else
                        {
                            <input id="ficha-codigo" class="codigos" data-escaneo="varios" @bind="pieza.Codigos" @onkeydown="e => EnterAsync(e, Campo.Codigo)"
                                   autocomplete="off" placeholder="Escanéalo aquí" />
                        }
                        <button id="ficha-generar" type="button" class="boton chico" disabled="@_ocupado" @onclick="() => GenerarCodigoAsync(pieza)">Sin código: generar uno</button>
                    </span>
                    @if (pieza.Fijos.Count > 0)
                    {
                        @Candado
                    }
                    else
                    {
                        <span class="nota">¿Trae más de un código? Escanéalos todos aquí.</span>
                    }
                    @ErrorEn("ficha-codigo")
                </div>
            }
            <div class="ficha-campo ancho2">
                <label class="ficha-et" for="ficha-nombre">Nombre</label>
                <input id="ficha-nombre" @bind="p.Nombre" @onkeydown="e => EnterAsync(e, Campo.Nombre)" maxlength="150" autocomplete="off" disabled="@_productoDeEleventa" />
                @if (_productoDeEleventa)
                {
                    @Candado
                }
                @ErrorEn("ficha-nombre")
            </div>
            <div class="ficha-campo ancho2">
                <label class="ficha-et" for="ficha-departamento">Departamento</label>
                <select id="ficha-departamento" @bind="p.DepartamentoId">
                    @if (p.DepartamentoId == Guid.Empty)
                    {
                        <option value="@Guid.Empty">Elige el departamento…</option>
                    }
                    @if (_suyoDesactivado is { } suyo)
                    {
                        <option value="@suyo.Id">@suyo.Nombre (desactivado)</option>
                    }
                    @foreach (var d in Departamentos)
                    {
                        <option value="@d.Id">@d.Nombre</option>
                    }
                </select>
                @if (Departamentos.Count == 0 && _departamentoNuevo is null)
                {
                    <span class="nota">No hay departamentos activos: crea uno aquí mismo.</span>
                }
                @if (PuedeEditar && _departamentoNuevo is null)
                {
                    <button id="ficha-nuevo-departamento" type="button" class="vn-enlace" @onclick="AbrirDepartamentoNuevoAsync">Nuevo departamento</button>
                }
                @ErrorEn("ficha-departamento")
            </div>
            <div class="ficha-campo ancho2">
                <label class="ficha-et" for="ficha-marca">Marca</label>
                <input id="ficha-marca" @bind="p.Marca" @bind:event="oninput" @bind:after="() => _sugerirMarcas = true" @onfocus="() => _sugerirMarcas = true"
                       @onkeydown="e => EnterAsync(e, Campo.Marca)" autocomplete="off" placeholder="Sin marca" />
                @if (_sugerirMarcas && MarcasParecidas(p.Marca) is { Count: > 0 } parecidas)
                {
                    <span class="ficha-marcas" role="listbox" aria-label="Marcas ya capturadas">
                        @foreach (var m in parecidas)
                        {
                            <button type="button" class="vn-chip" role="option" @onclick="() => (p.Marca, _sugerirMarcas) = (m, false)">@m</button>
                        }
                    </span>
                }
            </div>
            @if (_departamentoNuevo is not null)
            {
                <div class="ancho4 en-linea">
                    <label>Nombre del departamento nuevo
                        <input id="ficha-departamento-nombre" @bind="_departamentoNuevo" @bind:event="oninput" @onkeydown="AlTeclearDepartamentoAsync" maxlength="80" autocomplete="off" />
                    </label>
                    <button class="boton chico principal" disabled="@_ocupado" @onclick="CrearDepartamentoAsync">Crear y usarlo</button>
                    <button class="boton chico" @onclick="() => _departamentoNuevo = null">Cancelar</button>
                    @if (_enElPiloto is { } piloto)
                    {
                        <span class="nota">@piloto</span>
                    }
                </div>
            }
        </div>
    </div>

    @if (!varias)
    {
        var menudeo = Menudeo(v0);
        <div class="ficha-tarjeta ficha-precio">
            <h3>Precio <span class="ficha-h-suave">· con IVA</span></h3>
            <div class="ficha-fila-precio @(VeCostos ? "" : "sin-costo") @(VeMargen ? "" : "sin-ganancia")">
                @if (VeCostos)
                {
                    <div class="ficha-campo">
                        <label class="ficha-et" for="ficha-costo">Lo que te cuesta</label>
                        <span class="ficha-peso"><input id="ficha-costo" class="umbral costo" data-numero inputmode="decimal" autocomplete="off" placeholder="0.00"
                                                        value="@v0.UltimoCosto" @oninput="e => CostoEscrito(v0, e.Value)" @onchange="e => CostoEscrito(v0, e.Value)"
                                                        @onkeydown="e => EnterAsync(e, Campo.Costo)" disabled="@v0.DeEleventa" /></span>
                        @if (v0.DeEleventa)
                        {
                            @Candado
                        }
                    </div>
                    <span class="ficha-flecha" aria-hidden="true">→</span>
                }
                <div class="ficha-campo ficha-p-precio">
                    <label class="ficha-et" for="ficha-precio">Precio de venta</label>
                    <span class="ficha-peso grande"><input id="ficha-precio" class="umbral" data-numero inputmode="decimal" autocomplete="off" placeholder="0.00"
                                                           value="@menudeo.Precio" @oninput="e => PrecioEscrito(v0, menudeo, e.Value)" @onchange="e => PrecioEscrito(v0, menudeo, e.Value)"
                                                           @onkeydown="e => EnterAsync(e, Campo.Precio)" disabled="@menudeo.DeEleventa" /></span>
                    @if (menudeo.DeEleventa)
                    {
                        @Candado
                    }
                </div>
                <div class="ficha-campo">
                    <label class="ficha-et" for="ficha-unidad">Se vende por</label>
                    @UnidadDe(v0, "ficha-unidad")
                </div>
                @if (VeMargen)
                {
                    <div class="ficha-campo">
                        <label class="ficha-et" for="ficha-ganancia">Ganancia</label>
                        <span class="ficha-pct"><input id="ficha-ganancia" class="umbral margen" data-numero inputmode="decimal" autocomplete="off" placeholder="—"
                                                       value="@menudeo.Margen" @oninput="e => menudeo.Margen = e.Value?.ToString() ?? string.Empty"
                                                       @onchange="e => GananciaEscrita(v0, menudeo, e.Value)" @onkeydown="e => EnterAsync(e, Campo.Ganancia)"
                                                       disabled="@menudeo.DeEleventa" /></span>
                    </div>
                }
            </div>
            @if (VeMargen && GananciaDe(v0, menudeo) is { } ganancia)
            {
                <p class="ficha-ganancia @ganancia.Clase">@ganancia.Texto</p>
            }
            @if (VeMargen && menudeo.NotaMargen is { } nota)
            {
                <p class="ficha-redondeo">@nota</p>
            }
            @ErrorEn("ficha-precio")
            @ErrorEn("ficha-costo")
            @if (PideHay(v0))
            {
                @* «¿Cuántas hay?» (2026-11-21; en eleventa, «Hay»): entra al guardar, como un «Agregar inventario». *@
                <div class="ficha-hay">
                    <label class="ficha-et" for="ficha-hay">¿Cuántas hay?</label>
                    <input id="ficha-hay" class="hay" data-numero inputmode="decimal" autocomplete="off" placeholder="0"
                           @bind="v0.Hay" @bind:event="oninput" @onkeydown="e => EnterAsync(e, Campo.Hay)" />
                    <span class="nota">@NotaDeHay(v0)</span>
                </div>
                @ErrorEn("ficha-hay")
            }
            <p class="nota">El precio de venta es lo que paga el cliente.@(VeMargen ? " Si escribes la ganancia, el precio sale solo (redondeado hacia arriba a 50 centavos)." : "")</p>
        </div>
    }

    <details class="ficha-seccion" id="sec-inventario" open="@_abrirInventario">
        <summary><span class="t">Inventario</span><span class="r">@ResumenDeInventario()</span></summary>
        <div class="dentro">
            @if (p.Tipo == TipoProducto.Servicio)
            {
                <p class="nota">Un servicio no lleva inventario: no tiene mínimo ni máximo.</p>
            }
            else if (!varias)
            {
                @if (v0.Id is null && _inventarioEnEleventa is { } inventarioAlla && PuedeAgregarInventario)
                {
                    <p class="nota">@inventarioAlla</p>
                }
                @Existencia(v0)
                <div class="ficha-rejilla">
                    <div class="ficha-campo">
                        <label class="ficha-et" for="ficha-minimo">Mínimo de inventario</label>
                        <input id="ficha-minimo" class="umbral minimo" inputmode="decimal" autocomplete="off" @bind="v0.Minimo" placeholder="@PocaExistencia.Hasta o menos" />
                    </div>
                    <div class="ficha-campo">
                        <label class="ficha-et" for="ficha-maximo">Máximo</label>
                        <input id="ficha-maximo" class="umbral maximo" inputmode="decimal" autocomplete="off" @bind="v0.Maximo" placeholder="Sin máximo" />
                    </div>
                    <p class="nota ancho2">@NotaDelMinimo</p>
                </div>
                @ErrorEn("ficha-minimo")
            }
            else
            {
                <p class="nota">@NotaDelMinimo</p>
                <div class="ficha-inventarios">
                    <div class="ficha-inv-cab"><span>Nombre</span><span>@(p.Variantes.Any(PideHay) ? "Hay" : "Existencia")</span><span>Mínimo de inventario</span><span>Máximo</span></div>
                    @for (var i = 0; i < p.Variantes.Count; i++)
                    {
                        var v = p.Variantes[i];
                        var n = i;
                        <div class="ficha-inv-fila">
                            <span>@(v.Descripcion.Trim().Length > 0 ? v.Descripcion : $"Sin nombre ({n + 1})")</span>
                            @if (PideHay(v))
                            {
                                <input id="var-hay-@n" class="hay" data-numero inputmode="decimal" autocomplete="off" placeholder="0" @bind="v.Hay" aria-label="¿Cuántas hay?" />
                            }
                            else
                            {
                                <span class="num">@(v.Id is null ? "—" : v.Existencia is { } e ? Formato.Numero(e) : "—")</span>
                            }
                            <input id="var-minimo-@n" class="umbral minimo" inputmode="decimal" autocomplete="off" @bind="v.Minimo" placeholder="@PocaExistencia.Hasta o menos" aria-label="Mínimo de inventario" />
                            <input id="var-maximo-@n" class="umbral maximo" inputmode="decimal" autocomplete="off" @bind="v.Maximo" placeholder="Sin máximo" aria-label="Máximo" />
                        </div>
                        @ErrorEn($"var-minimo-{n}")
                        @ErrorEn($"var-hay-{n}")
                    }
                </div>
                @if (p.Variantes.Any(PideHay))
                {
                    <p class="nota">@NotaDeHay(p.Variantes.First(PideHay))</p>
                }
            }
        </div>
    </details>

    @if (!varias)
    {
        <details class="ficha-seccion" id="sec-mayoreo" open="@_abrirMayoreo">
            <summary><span class="t">Mayoreo y cajas</span><span class="r">@ResumenDeMayoreo(v0)</span></summary>
            <div class="dentro">
                @MayoreoYCajas(v0)
            </div>
        </details>
    }

    <details class="ficha-seccion" id="sec-variantes" open="@_abrirVariantes">
        <summary><span class="t">Colores, tamaños…</span><span class="r">@ResumenDeVariantes()</span></summary>
        <div class="dentro">
            <label class="ficha-opcion">
                <input id="ficha-varias" type="checkbox" checked="@varias" disabled="@(p.Variantes.Count > 1)" @onchange="e => VariasCambiadas(e.Value is true)" />
                Este producto viene en varios colores, tamaños o rayados
            </label>
            @if (!varias)
            {
                <p class="nota">Cada uno lleva su código, su precio y su existencia. Al marcarlo, el precio de arriba pasa a ser el del primero.</p>
            }
            else
            {
                @if (p.Variantes.Count > 1)
                {
                    <p class="nota">Para dejar uno solo, quita los demás (los que ya se guardaron se dan de baja en su «Mayoreo y cajas…»).</p>
                }
                <div class="ficha-variantes @(VeCostos ? "" : "sin-costo") @(VeMargen ? "" : "sin-ganancia")">
                    <div class="ficha-v-cab"><span>Nombre</span><span>Código</span>@if (VeCostos)
                        {
                            <span>Te cuesta</span>
                        }<span>Precio</span>@if (VeMargen)
                        {
                            <span>Ganancia</span>
                        }<span></span></div>
                    @for (var i = 0; i < p.Variantes.Count; i++)
                    {
                        var v = p.Variantes[i];
                        var n = i;
                        var pieza = Base(v);
                        var precio = Menudeo(v);
                        var abierta = _masDe.Contains(v.Clave);
                        <div class="ficha-v-fila @(v.Activa ? "" : "inactiva")">
                            <label><span class="et-movil">Nombre</span><input id="var-nombre-@n" @bind="v.Descripcion" placeholder="Azul, Carta…" autocomplete="off" aria-label="Nombre" /></label>
                            <label>
                                <span class="et-movil">Código</span>
                                @if (pieza.Fijos.Count > 0)
                                {
                                    <span class="codigos-fijos" title="@SeCambiaEnEleventa">
                                        @foreach (var fijo in pieza.Fijos)
                                        {
                                            <code>@fijo</code>
                                        }
                                    </span>
                                    <input class="codigos" data-escaneo="varios" @bind="pieza.Codigos" autocomplete="off" placeholder="Otro código" aria-label="Otro código de la pieza" />
                                }
                                else
                                {
                                    <input class="codigos" data-escaneo="varios" @bind="pieza.Codigos" autocomplete="off" placeholder="Escanéalo" aria-label="Código" />
                                }
                            </label>
                            @if (VeCostos)
                            {
                                <label><span class="et-movil">Te cuesta</span><span class="ficha-peso"><input id="var-costo-@n" class="umbral costo" data-numero inputmode="decimal" autocomplete="off"
                                       value="@v.UltimoCosto" @oninput="e => CostoEscrito(v, e.Value)" @onchange="e => CostoEscrito(v, e.Value)" disabled="@v.DeEleventa"
                                       aria-label="Lo que te cuesta" /></span></label>
                            }
                            <label><span class="et-movil">Precio</span><span class="ficha-peso"><input id="var-precio-@n" class="umbral" data-numero inputmode="decimal" autocomplete="off"
                                   value="@precio.Precio" @oninput="e => PrecioEscrito(v, precio, e.Value)" @onchange="e => PrecioEscrito(v, precio, e.Value)" disabled="@precio.DeEleventa"
                                   aria-label="Precio de venta" /></span></label>
                            @if (VeMargen)
                            {
                                var g = GananciaDe(v, precio, corto: true);
                                <span class="g @g?.Clase">@g?.Texto</span>
                            }
                            <span class="ficha-v-acciones">
                                <button type="button" class="boton chico" aria-expanded="@(abierta ? "true" : "false")" @onclick="() => MasDe(v)">Mayoreo y cajas…</button>
                                @if (v.Id is null && p.Variantes.Count > 1)
                                {
                                    <button type="button" class="ficha-quitar" aria-label="Quitar este" title="Quitar" @onclick="() => QuitarVariante(v)">×</button>
                                }
                            </span>
                            @if (v.DeEleventa)
                            {
                                <span class="ficha-v-nota">@Candado</span>
                            }
                            @ErrorEn($"var-nombre-{n}")
                            @ErrorEn($"var-precio-{n}")
                            @ErrorEn($"var-costo-{n}")
                            @if (abierta)
                            {
                                <div class="ficha-v-mas">
                                    @MayoreoYCajas(v)
                                    <label class="ficha-opcion"><input type="checkbox" @bind="v.Activa" disabled="@v.DeEleventa" /> Se vende este</label>
                                    @DeLaGuardada(v)
                                </div>
                            }
                        </div>
                    }
                    <div>
                        <button id="ficha-agregar-variante" type="button" class="boton chico" @onclick="AgregarOtro">+ Agregar otro <span class="nota">(copia el de arriba, sin nombre ni código)</span></button>
                    </div>
                </div>
            }
        </div>
    </details>

    <details class="ficha-seccion" id="sec-otros" open="@_abrirOtros">
        <summary><span class="t">Otros datos</span><span class="r">@ResumenDeOtros()</span></summary>
        <div class="dentro">
            <div class="ficha-rejilla">
                <div class="ficha-campo">
                    <label class="ficha-et" for="ficha-iva">IVA</label>
                    <select id="ficha-iva" @bind="p.Impuesto">
                        <option value="@Impuesto.Iva16">16 %</option>
                        <option value="@Impuesto.Iva0">0 %</option>
                        <option value="@Impuesto.Exento">Exento</option>
                    </select>
                </div>
                <div class="ficha-campo ficha-abajo">
                    <label class="ficha-opcion"><input id="ficha-activo" type="checkbox" checked="@SeVende" @onchange="e => SeVendeCambiado(e.Value is true)" disabled="@SeVendeFijo" /> Se vende</label>
                    @if (SeVendeFijo)
                    {
                        @Candado
                    }
                </div>
                <div class="ficha-campo ancho2 ficha-abajo">
                    <label class="ficha-opcion"><input id="ficha-servicio" type="checkbox" checked="@(p.Tipo == TipoProducto.Servicio)"
                                                        @onchange="e => p.Tipo = e.Value is true ? TipoProducto.Servicio : TipoProducto.Mercancia" /> Es un servicio (no lleva inventario)</label>
                </div>
            </div>
            @if (!varias)
            {
                @if (v0.Id is null)
                {
                    <p class="nota">La foto, la existencia, los proveedores y el kardex salen aquí después de guardarlo.</p>
                }
                else
                {
                    @DeLaGuardada(v0)
                }
            }
            else
            {
                <p class="nota">La foto, los proveedores y el kardex de cada uno están en su «Mayoreo y cajas…» (en «Colores, tamaños…»).</p>
            }
        </div>
    </details>

    @* Con lo que dice al guardar, siempre a la vista: la ficha de un cuaderno con 8 variantes mide varias pantallas. *@
    <div class="vn-ficha-pie">
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_aviso is not null)
    {
        <p class="aviso">@_aviso</p>
    }
    <div class="acciones">
        <button class="boton" @onclick="AlVolver">@TextoVolver</button>
        @if (PuedeEditar)
        {
            <button id="ficha-guardar" class="boton principal" disabled="@_ocupado" @onclick="GuardarAsync">Guardar <kbd>Ctrl+Enter</kbd></button>
        }
        else
        {
            <span class="nota">El catálogo lo editan el dueño y el encargado.</span>
        }
    </div>
    </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public OpcionesCatalogoDto Opciones { get; set; } = null!;

