    /// <summary>A donde va el cursor al abrir un producto nuevo: el código de barras (como en eleventa: se escanea lo que se tiene en la mano).</summary>
    public const string PrimerCampoDelNuevo = "#ficha-codigo";

    /// <summary>A donde va al abrir uno que ya existe: el precio, lo que más se cambia.</summary>
    public const string PrimerCampoAlEditar = "#ficha-precio";

    /// <summary>Si el precio no se puede cambiar (el de un producto de eleventa en el piloto) o hay varios: el primer campo que se puede cambiar.</summary>
    public const string PrimerCampo = "#ficha-campos input:not([disabled])";

    private ProductoEditable? _producto;

    /// <summary>La ficha como se cargó o se guardó, para saber si hay algo sin guardar (<see cref="TieneCambios"/>).</summary>
    private string? _comoSeGuardo;

    private bool _enfocar;

    /// <summary>A donde va el cursor en el siguiente dibujo (Enter en lo de arriba, o la casilla con el problema al guardar).</summary>
    private string? _enfocarEn;

    /// <summary>Hay algo escrito sin guardar: Productos no cambia de producto sin preguntar.</summary>
    public bool TieneCambios => PuedeEditar && _producto is { } p && JsonSerializer.Serialize(p) != _comoSeGuardo;

    /// <summary>
    /// Su departamento, si se desactivó (Productos › Departamentos): se sigue viendo y se puede dejar, pero no se le ofrece a
    /// los demás. El servicio no deja reactivar el producto ahí.
    /// </summary>
    private OpcionCatalogoDto? _suyoDesactivado;

    /// <summary>En el piloto con eleventa, si algo de este producto viene de eleventa: la nota de arriba.</summary>
    private string? _enEleventa;

    /// <summary>En el piloto, su nombre y si se vende los pone la lectura de eleventa (el departamento es de aquí).</summary>
    private bool _productoDeEleventa;

    /// <summary>Lo que dice, al pasar el ratón, lo que pone la lectura de eleventa (los códigos de la pieza).</summary>
    private const string SeCambiaEnEleventa = "De eleventa: mientras dure el piloto, se cambian allá";

    private static readonly string NotaDelMinimo =
        $"Con el mínimo o menos sale en «Poca existencia», en «Bajos en inventario» y como urgente en el sugerido de compra. El máximo es hasta "
        + $"cuánto pedir. Vacíos: avisa con {PocaExistencia.Hasta} o menos y pide lo que diga el sugerido.";

    /// <summary>Ve (y escribe) el costo: quien ve los costos; el servicio lo revisa.</summary>
    private bool VeCostos => Sesion.Puede(AccionControlada.CostearCompra) || Sesion.Puede(AccionControlada.VerUtilidad);

    /// <summary>Ve la ganancia de cada precio: «Ver costos, utilidad y margen».</summary>
    private bool VeMargen => Sesion.Puede(AccionControlada.VerUtilidad);

    /// <summary>El nombre del departamento que se crea ahí mismo; vacío: no se está creando.</summary>
    private string? _departamentoNuevo;

    /// <summary>En el piloto, lo que dice la página de Departamentos (los departamentos son de aquí).</summary>
    private string? _enElPiloto;

    /// <summary>Los que se crearon desde esta ficha: se ofrecen aunque <see cref="Opciones"/> no los traiga todavía.</summary>
    private readonly List<OpcionCatalogoDto> _creados = [];

    private List<OpcionCatalogoDto> Departamentos =>
        [.. Opciones.Departamentos.Concat(_creados.Where(c => Opciones.Departamentos.All(d => d.Id != c.Id))).OrderBy(d => d.Nombre, StringComparer.CurrentCultureIgnoreCase)];

    private bool _sugerirMarcas;

    /// <summary>Se marcó «viene en varios…» (con una sola todavía): la tabla en lugar de la fila del precio.</summary>
    private bool _conVariantes;

    /// <summary>Las secciones de abajo: cerradas, salvo las que tienen algo (al cargar) o lo que se marcó.</summary>
    private bool _abrirInventario, _abrirMayoreo, _abrirVariantes, _abrirOtros;

    /// <summary>Las variantes con su «Mayoreo y cajas…» abierto (en la tabla).</summary>
    private readonly HashSet<Guid> _masDe = [];

    private Guid? _kardexDe;
    private List<MovimientoKardexDto>? _kardex;
    private string? _error;

    /// <summary>El id de la casilla con el problema de <see cref="_error"/>: el mensaje sale también junto a ella.</summary>
    private string? _errorEn;
    private string? _aviso;
    private bool _ocupado;

    /// <summary>Con «Productos, precios y etiquetas» (con los usuarios de antes, el encargado y el dueño). El servicio decide.</summary>
    private bool PuedeEditar => Sesion.Puede(AccionControlada.EditarCatalogo);

    /// <summary>Con «Agregar inventario» en «Puede» (no se autoriza): sin él, no sale «¿Cuántas hay?». El servicio decide.</summary>
    private bool PuedeAgregarInventario => Sesion.Puede(AccionControlada.AgregarInventario);

    /// <summary>En el piloto con eleventa: por qué no sale «¿Cuántas hay?» (el inventario se lleva allá). Vacío fuera del piloto.</summary>
    private string? _inventarioEnEleventa;

    /// <summary>
    /// «¿Cuántas hay?» (2026-11-21; en eleventa, «Hay» en su «Nuevo producto»): de una variante nueva de mercancía, para quien edita
    /// el catálogo y agrega inventario, fuera del piloto. Al guardar entra junto con el alta, como un «Agregar inventario».
    /// </summary>
    private bool PideHay(VarianteEditable v) =>
        v.Id is null && _producto is { Tipo: TipoProducto.Mercancia } && PuedeEditar && PuedeAgregarInventario && _pilotoSabido && _inventarioEnEleventa is null;

    private string NotaDeHay(VarianteEditable v) =>
        $"En {Plural(v.Unidad)}, las que hay en la sucursal. Al guardar entran al inventario (como «Agregar inventario»)"
        + (VeCostos ? ", a lo que te cuesta." : ", al costo de ahora.") + " Vacío: sin inventario; después, en Inventario › Agregar inventario.";

    /// <summary>Con varias variantes (o marcado «viene en varios…»): la tabla de «Colores, tamaños…» en lugar de la fila del precio.</summary>
    private bool VariasVariantes => _conVariantes || _producto!.Variantes.Count > 1;

    protected override async Task OnInitializedAsync()
    {
        // Si es el piloto con eleventa, para «¿Cuántas hay?», mientras se dibuja la ficha: la casilla sale cuando se sabe.
        var piloto = PilotoAsync();
        if (ProductoId is not { } id)
        {
            // Sin departamento de entrada: elegir el primero solo torcía los reportes por departamento de quien no lo cambiaba.
            _producto = new ProductoEditable();
            AgregarVariante();
            (_comoSeGuardo, _enfocar) = (JsonSerializer.Serialize(_producto), true);
            await piloto;
            return;
        }
        try
        {
            if (await Cliente.FichaProductoAsync(id, Caja.SucursalId, Sesion.UsuarioId) is { } ficha)
            {
                Mostrar(ficha);
                _enfocar = true;
            }
            else
                _error = "El producto ya no existe.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        await piloto;
    }

    /// <summary>
    /// Si es el piloto con eleventa (solo para quien vería «¿Cuántas hay?»): ahí el inventario se lleva allá y la casilla no sale. Sin
    /// saberlo (sin conexión), sale: el servicio decide.
    /// </summary>
    private async Task PilotoAsync()
    {
        if (!PuedeEditar || !PuedeAgregarInventario)
            return;
        try
        {
            _inventarioEnEleventa = (await Cliente.TrastiendaEnElPilotoAsync()).Inventario;
        }
        catch (ErrorCaja)
        {
            _inventarioEnEleventa = null;
        }
        _pilotoSabido = true;
    }

    /// <summary>Ya se sabe si es el piloto: hasta entonces no sale «¿Cuántas hay?» (no se ofrece lo que en el piloto no va).</summary>
    private bool _pilotoSabido;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (_enfocar && _producto is not null)
        {
            _enfocar = false;
            await Js.EnfocarAsync(CampoAlAbrir());
        }
        else if (_enfocarEn is { } campo)
        {
            _enfocarEn = null;
            await Js.EnfocarAsync(campo);
        }
    }

    /// <summary>Nuevo: el código. Ya existe: el precio, si se puede cambiar; si no (o con varias), el primero que se puede cambiar.</summary>
    private string CampoAlAbrir()
    {
        if (VariasVariantes)
            return PrimerCampo;
        if (ProductoId is null && _producto!.Id is null)
            return PrimerCampoDelNuevo;
        return Menudeo(_producto!.Variantes[0]).DeEleventa ? PrimerCampo : PrimerCampoAlEditar;
    }

    /// <summary>
    /// Ctrl+Enter guarda, como «Aplicar» del Excel. Primero el cursor sale del campo: lo escrito se toma al salir de él, y así va en
    /// lo que se guarda.
    /// </summary>
    private async Task AlTeclearAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || !(e.CtrlKey || e.MetaKey) || e.Repeat || !PuedeEditar || _ocupado)
            return;
        await Js.EnfocarAsync("#ficha-guardar");
        await GuardarAsync();
    }

    private enum Campo { Codigo, Nombre, Marca, Costo, Precio, Ganancia, Hay }

    /// <summary>
    /// Enter en lo de arriba pasa al siguiente, como Tab (también el del lector en el código): lo que falta es el siguiente campo,
    /// no un error (como la alta rápida). En el precio, a «Guardar» si ya está lo que hace falta; si no, a lo que falta. En la
    /// ganancia, pone el precio.
    /// </summary>
    private async Task EnterAsync(KeyboardEventArgs e, Campo campo)
    {
        if (e.Key != "Enter" || e.CtrlKey || e.MetaKey || e.Repeat || _producto is not { } p)
            return;
        var v0 = p.Variantes[0];
        string? siguiente = campo switch
        {
            Campo.Codigo => _productoDeEleventa ? "#ficha-departamento" : "#ficha-nombre",
            Campo.Nombre => "#ficha-departamento",
            Campo.Marca when VariasVariantes => "#var-nombre-0",
            Campo.Marca when VeCostos && !v0.DeEleventa => "#ficha-costo",
            Campo.Marca or Campo.Costo => Menudeo(v0).DeEleventa ? "#ficha-guardar" : "#ficha-precio",
            // Con «¿Cuántas hay?», el precio pasa ahí y de ahí a «Guardar» (vacío también: es opcional).
            Campo.Precio or Campo.Hay => p.Nombre.Trim().Length == 0 && !_productoDeEleventa ? "#ficha-nombre"
                : p.DepartamentoId == Guid.Empty ? "#ficha-departamento"
                : Formato.LeerPesos(Menudeo(v0).Precio) is not (> 0) ? (campo == Campo.Hay ? "#ficha-precio" : null)
                : campo == Campo.Precio && PideHay(v0) ? "#ficha-hay"
                : "#ficha-guardar",
            _ => null,
        };
        if (campo == Campo.Marca)
            _sugerirMarcas = false;
        if (campo == Campo.Ganancia)
            AplicarGanancia(v0, Menudeo(v0));
        if (siguiente is not null)
            await Js.EnfocarAsync(siguiente);
    }

    private void Mostrar(FichaProductoDto f)
    {
        _suyoDesactivado = Opciones.Departamentos.Any(d => d.Id == f.DepartamentoId) ? null : Opciones.Desactivados?.FirstOrDefault(d => d.Id == f.DepartamentoId);
        (_enEleventa, _productoDeEleventa) = (f.EnEleventa, f.ProductoDeEleventa);
        _producto = Editable(f);
        _comoSeGuardo = JsonSerializer.Serialize(_producto);
        AbrirLasQueTienenAlgo();
    }

    /// <summary>Las secciones con algo se abren solas (y con varias, el «Mayoreo y cajas…» de cada una que lo tiene).</summary>
    private void AbrirLasQueTienenAlgo()
    {
        var p = _producto!;
        _conVariantes = p.Variantes.Count > 1;
        _abrirInventario = p.Tipo == TipoProducto.Mercancia && p.Variantes.Any(v => v.Minimo.Trim().Length > 0 || v.Maximo.Trim().Length > 0);
        _abrirMayoreo = !_conVariantes && TieneMayoreoOCajas(p.Variantes[0]);
        _abrirVariantes = p.Variantes.Count > 1;
        _abrirOtros = p.Impuesto != Impuesto.Iva16 || !SeVende || p.Tipo == TipoProducto.Servicio;
        _masDe.Clear();
        if (_conVariantes)
            _masDe.UnionWith(p.Variantes.Where(TieneMayoreoOCajas).Select(v => v.Clave));
    }

    private static bool TieneMayoreoOCajas(VarianteEditable v) => v.Precios.Any(x => !x.Menudeo) || v.Presentaciones.Any(x => !x.EsBase);

    private ProductoEditable Editable(FichaProductoDto f) => new()
    {
        Id = f.Id, Nombre = f.Nombre, DepartamentoId = f.DepartamentoId, Marca = f.Marca, Tipo = f.Tipo, Impuesto = f.Impuesto, ClaveSat = f.ClaveSat,
        Activo = f.Activo, PorCompletar = f.PorCompletar,
        Variantes = f.Variantes.Select(v => new VarianteEditable
        {
            Id = v.Id, Descripcion = v.Descripcion, Unidad = v.Unidad, Activa = v.Activa, Existencia = v.Existencia, Costo = v.CostoPromedioCentavos,
            Proveedores = v.Proveedores, DeEleventa = v.DeEleventa,
            UltimoCosto = v.CostoCentavos is { } costo ? (costo / 100m).ToString("0.00", CultureInfo.InvariantCulture) : "", UltimoCostoGuardado = v.CostoCentavos,
            Minimo = v.MinimoYMaximo?.MinimoMilesimas is { } minimo ? Numero(minimo) : "",
            Maximo = v.MinimoYMaximo?.MaximoMilesimas is { } maximo ? Numero(maximo) : "",
            Presentaciones = v.Presentaciones.Select(p =>
            {
                // En el piloto, los códigos de la pieza de una variante de eleventa se quedan: solo se agregan otros.
                var fijos = v.DeEleventa && p.EsBase;
                var editable = new PresentacionEditable
                {
                    Id = p.Id, Nombre = p.Nombre, Contiene = Numero(p.FactorMilesimas), EsBase = p.EsBase,
                    Codigos = fijos ? "" : string.Join(" ", p.Codigos.Select(c => c.Codigo)),
                    Fijos = fijos ? p.Codigos.Select(c => c.Codigo).ToList() : [],
                };
                editable.Internos.UnionWith(p.Codigos.Where(c => c.Origen == OrigenCodigo.Interno).Select(c => c.Codigo));
                return editable;
            }).ToList(),
            Precios = PreciosEditables(v.Precios),
        }).Select(ConMargenes).ToList(),
    };

    /// <summary>Los precios como se escriben, con el menudeo marcado (el primero de cada unidad desde una; si no hay, uno vacío al principio).</summary>
    private static List<PrecioEditable> PreciosEditables(IReadOnlyList<PrecioFichaDto> precios)
    {
        var menudeo = precios.Select((x, i) => (x, i)).FirstOrDefault(t => t.x.Presentacion is null && t.x.CantidadMinimaMilesimas == Cantidad.Escala) is { x: not null } m ? m.i : -1;
        var lista = precios.Select((x, i) => new PrecioEditable
        {
            Presentacion = x.Presentacion ?? "", Desde = Numero(x.CantidadMinimaMilesimas), Precio = (x.PrecioCentavos / 100m).ToString("0.00", CultureInfo.InvariantCulture),
            DeEleventa = x.DeEleventa, Menudeo = i == menudeo,
        }).ToList();
        if (menudeo < 0)
            lista.Insert(0, new PrecioEditable { Menudeo = true });
        return lista;
    }

    private VarianteEditable ConMargenes(VarianteEditable variante)
    {
        foreach (var precio in variante.Precios)
            MargenDe(variante, precio);
        return variante;
    }

    /// <summary>La primera: la pieza y un precio vacío.</summary>
    private void AgregarVariante() =>
        _producto!.Variantes.Add(new VarianteEditable
        {
            Presentaciones = [new PresentacionEditable { Nombre = "Pieza", EsBase = true }],
            Precios = [new PrecioEditable { Menudeo = true }],
        });

    /// <summary>
    /// «Agregar otro» (el dueño, 2026-11-16; desde el 2026-11-20, con lo del de arriba): la unidad, las cajas (sin sus códigos: cada
    /// uno lleva los suyos), los precios y su ganancia, el mínimo, el máximo y el costo; el nombre, en blanco.
    /// </summary>
    private void AgregarOtro()
    {
        var p = _producto!;
        var arriba = p.Variantes[^1];
        p.Variantes.Add(new VarianteEditable
        {
            Unidad = arriba.Unidad, Minimo = arriba.Minimo, Maximo = arriba.Maximo, UltimoCosto = arriba.UltimoCosto,
            Presentaciones = [.. arriba.Presentaciones.Select(x => new PresentacionEditable { Nombre = x.Nombre, Contiene = x.Contiene, EsBase = x.EsBase })],
            Precios = [.. arriba.Precios.Where(x => !x.DeEleventa || x.Menudeo).Select(x => new PrecioEditable
            {
                Presentacion = x.Presentacion, Desde = x.Desde, Precio = x.Precio, Margen = x.Margen, MargenCalculado = x.MargenCalculado, Menudeo = x.Menudeo,
            })],
        });
        (_conVariantes, _abrirVariantes) = (true, true);
        _enfocarEn = $"#var-nombre-{p.Variantes.Count - 1}";
    }

    private void QuitarVariante(VarianteEditable v)
    {
        _producto!.Variantes.Remove(v);
        _masDe.Remove(v.Clave);
    }

    /// <summary>«Este producto viene en varios…»: la tabla, con la primera como estaba. Sin marcar (con una sola), la fila del precio.</summary>
    private void VariasCambiadas(bool varias)
    {
        if (!varias && _producto!.Variantes.Count > 1)
            return;
        (_conVariantes, _abrirVariantes) = (varias, true);
        // «¿Cuántas hay?» de cada uno va en «Inventario»: se abre para que se vea.
        if (varias && PideHay(_producto!.Variantes[0]))
            _abrirInventario = true;
        if (varias && TieneMayoreoOCajas(_producto!.Variantes[0]))
            _masDe.Add(_producto.Variantes[0].Clave);
    }

    private void MasDe(VarianteEditable v)
    {
        if (!_masDe.Remove(v.Clave))
            _masDe.Add(v.Clave);
    }

    // ── Lo de cada variante ──

    /// <summary>La pieza: la presentación base (con sus códigos, el «Código de barras» de arriba).</summary>
    private static PresentacionEditable Base(VarianteEditable v) => v.Presentaciones.FirstOrDefault(x => x.EsBase) ?? v.Presentaciones[0];

    /// <summary>El precio de cada unidad, desde una: el de la fila del precio.</summary>
    private static PrecioEditable Menudeo(VarianteEditable v) => v.Precios.First(x => x.Menudeo);

    /// <summary>El mayoreo: los de cada unidad que no son el menudeo.</summary>
    private static List<PrecioEditable> Mayoreos(VarianteEditable v) => [.. v.Precios.Where(x => !x.Menudeo && x.Presentacion.Length == 0)];

    /// <summary>Las cajas y paquetes: las presentaciones que no son la pieza.</summary>
    private static List<PresentacionEditable> Cajas(VarianteEditable v) => [.. v.Presentaciones.Where(x => !x.EsBase)];

    private static bool DesdeUna(PrecioEditable precio) => Milesimas(precio.Desde) == Cantidad.Escala;

    /// <summary>El precio propio de una caja (desde una caja), si tiene.</summary>
    private static PrecioEditable? PrecioDeLaCaja(VarianteEditable v, PresentacionEditable caja) =>
        caja.Nombre.Trim() is { Length: > 0 } nombre ? v.Precios.FirstOrDefault(x => x.Presentacion == nombre && DesdeUna(x)) : null;

    /// <summary>El mayoreo de una caja (precios de la caja desde 2 o más): raros, pero existen; solo se ven si ya hay.</summary>
    private static List<PrecioEditable> MayoreoDeLaCaja(VarianteEditable v, PresentacionEditable caja) =>
        caja.Nombre.Trim() is { Length: > 0 } nombre ? [.. v.Precios.Where(x => x.Presentacion == nombre && !DesdeUna(x))] : [];

    /// <summary>Antes la pieza podía no ser la primera: entonces se deja elegir cuál es (casos viejos).</summary>
    private static bool PiezaFueraDeLugar(VarianteEditable v) => v.Presentaciones.Count > 1 && !v.Presentaciones[0].EsBase;

    private void AgregarMayoreo(VarianteEditable v)
    {
        var nuevo = new PrecioEditable { Desde = "" };
        v.Precios.Add(nuevo);
        _enfocarEn = $"#may-desde-{nuevo.Clave:N}";
    }

    private void AgregarCaja(VarianteEditable v)
    {
        var nueva = new PresentacionEditable { Nombre = v.Presentaciones.Any(x => x.Nombre.Trim() == "Caja") ? "" : "Caja", Contiene = "" };
        v.Presentaciones.Add(nueva);
        _enfocarEn = $"#caja-{(nueva.Nombre.Length == 0 ? "nombre" : "contiene")}-{nueva.Clave:N}";
    }

    private static void QuitarCaja(VarianteEditable v, PresentacionEditable caja)
    {
        var nombre = caja.Nombre.Trim();
        v.Presentaciones.Remove(caja);
        if (nombre.Length > 0 && v.Presentaciones.All(x => x.Nombre.Trim() != nombre))
            v.Precios.RemoveAll(x => x.Presentacion == nombre && !x.DeEleventa);
    }

    /// <summary>Otro nombre para la caja: sus precios propios la siguen.</summary>
    private static void CajaRenombrada(VarianteEditable v, PresentacionEditable caja, object? valor)
    {
        var (antes, ahora) = (caja.Nombre.Trim(), (valor?.ToString() ?? "").Trim());
        caja.Nombre = valor?.ToString() ?? "";
        if (antes.Length == 0 || antes == ahora || v.Presentaciones.Any(x => x != caja && x.Nombre.Trim() == antes))
            return;
        foreach (var precio in v.Precios.Where(x => x.Presentacion == antes))
            precio.Presentacion = ahora;
    }

    /// <summary>El precio propio de la caja, escrito: vacío lo quita (se vende por sus piezas).</summary>
    private void PrecioDeLaCajaEscrito(VarianteEditable v, PresentacionEditable caja, object? valor)
    {
        var texto = valor?.ToString() ?? "";
        var nombre = caja.Nombre.Trim();
        if (nombre.Length == 0)
            return;
        if (PrecioDeLaCaja(v, caja) is { } precio)
            PrecioEscrito(v, precio, texto);
        else if (texto.Trim().Length > 0)
        {
            var nuevo = new PrecioEditable { Presentacion = nombre };
            v.Precios.Add(nuevo);
            PrecioEscrito(v, nuevo, texto);
        }
    }

    // ── El costo, el precio y la ganancia (2026-11-16; en pesos y en los dos sentidos, 2026-11-20) ──

    /// <summary>El costo de lo que se vende con ese precio: el de cada unidad o, con precio propio, el de lo que contiene la presentación.</summary>
    private static decimal? CostoDe(VarianteEditable variante, PrecioEditable precio)
    {
        if (Formato.LeerPesos(variante.UltimoCosto) is not ({ } costo and > 0))
            return null;
        if (precio.Presentacion.Length == 0)
            return costo;
        return variante.Presentaciones.FirstOrDefault(x => x.Nombre.Trim() == precio.Presentacion) is { } presentacion
               && Formato.LeerCantidad(presentacion.EsBase ? "1" : presentacion.Contiene) is { } contiene and > 0
            ? costo * contiene
            : null;
    }

    /// <summary>
    /// La ganancia de un precio, del precio y el costo: su % (sobre el precio, con un decimal, como <see cref="Margen.Calcular"/>).
    /// Sin costo, la ganancia que se escribió se queda (espera el costo); la que se había calculado, se quita.
    /// </summary>
    private static void MargenDe(VarianteEditable variante, PrecioEditable precio)
    {
        if (CostoDe(variante, precio) is { } costo && Formato.LeerPesos(precio.Precio) is { } centavos and > 0)
            precio.Margen = precio.MargenCalculado = (Margen.Calcular(centavos, costo) / 100m).ToString("0.#", CultureInfo.InvariantCulture);
        else
        {
            if (precio.Margen == precio.MargenCalculado)
                precio.Margen = "";
            precio.MargenCalculado = "";
        }
    }

    /// <summary>Se escribió el costo: la ganancia de cada precio, de nuevo. Los precios escritos se quedan; los que salieron de la ganancia la siguen.</summary>
    private static void CostoEscrito(VarianteEditable variante, object? valor)
    {
        var texto = valor?.ToString() ?? "";
        if (texto == variante.UltimoCosto)
            return;
        variante.UltimoCosto = texto;
        foreach (var precio in variante.Precios)
        {
            precio.NotaMargen = null;
            if (precio.GananciaEscrita.Length > 0 && !precio.DeEleventa)
                PrecioDeLaGanancia(variante, precio, precio.GananciaEscrita);
            else
                MargenDe(variante, precio);
        }
    }

    /// <summary>Se escribió el precio: se queda tal cual (al centavo, como se escribió) y se calcula su ganancia.</summary>
    private static void PrecioEscrito(VarianteEditable variante, PrecioEditable precio, object? valor)
    {
        var texto = valor?.ToString() ?? "";
        if (texto == precio.Precio)
            return;
        (precio.Precio, precio.GananciaEscrita, precio.NotaMargen) = (texto, "", null);
        MargenDe(variante, precio);
    }

    /// <summary>Se escribió la ganancia (al salir de la casilla o con Enter): pone el precio. Si es la que ya se veía, nada.</summary>
    private static void GananciaEscrita(VarianteEditable variante, PrecioEditable precio, object? valor)
    {
        precio.Margen = valor?.ToString() ?? "";
        AplicarGanancia(variante, precio);
    }

    private static void AplicarGanancia(VarianteEditable variante, PrecioEditable precio)
    {
        var escrita = precio.Margen.Trim();
        if (precio.DeEleventa || escrita == precio.MargenCalculado)
            return;
        if (escrita.Length == 0)
        {
            (precio.GananciaEscrita, precio.NotaMargen) = ("", null);
            return;
        }
        PrecioDeLaGanancia(variante, precio, escrita);
    }

    /// <summary>
    /// El precio que deja esa ganancia con el costo: costo ÷ (1 − %), subido a los siguientes 50 centavos (como el sugerido de las
    /// compras, <see cref="Margen.PrecioSugerido"/>), y lo dice si se redondeó. Fuera de 0 a 99 %, o sin costo, no pone precio y lo
    /// dice; sin costo, la ganancia espera al costo.
    /// </summary>
    private static void PrecioDeLaGanancia(VarianteEditable variante, PrecioEditable precio, string escrita)
    {
        if (Formato.LeerCantidad(escrita.TrimEnd('%').Trim()) is not { } margen || Math.Round(margen * 100) is < 0 or >= 10000)
        {
            (precio.GananciaEscrita, precio.NotaMargen) = ("", "La ganancia va de 0 a 99 % del precio.");
            return;
        }
        precio.GananciaEscrita = escrita;
        if (CostoDe(variante, precio) is not { } costo)
        {
            precio.NotaMargen = "Escribe lo que te cuesta para calcular el precio.";
            return;
        }
        var centesimas = (int)Math.Round(margen * 100);
        var nuevo = Margen.PrecioSugerido(costo, centesimas);
        var exacto = costo * 10000 / (10000 - centesimas);
        precio.Precio = (nuevo / 100m).ToString("0.00", CultureInfo.InvariantCulture);
        MargenDe(variante, precio);
        precio.NotaMargen = Math.Abs(exacto - nuevo) >= 0.5m
            ? $"Redondeado a {Formato.Dinero(nuevo)} (hacia arriba, a 50 centavos): la ganancia queda en {Margen.Texto(Margen.Calcular(nuevo, costo))}."
            : null;
    }

    private sealed record Ganancia(string Texto, string Clase);

    /// <summary>
    /// Lo que se gana con un precio, en pesos y en % del precio: «Ganas $16.50 por pieza (36.7 % del precio)», en rojo si se pierde.
    /// <paramref name="corto"/>: el de la tabla de variantes («$16.50 · 36.7 %»).
    /// </summary>
    private static Ganancia? GananciaDe(VarianteEditable v, PrecioEditable precio, bool corto = false)
    {
        var por = precio.Presentacion.Length > 0 ? "la caja" : Unidad(v.Unidad);
        if (Formato.ProblemaDePesos(precio.Precio) is { } problema)
            return new(problema, "pierde");
        if (Formato.LeerPesos(precio.Precio) is not ({ } centavos and > 0))
            return precio.Menudeo && !corto ? new("Escribe el precio de venta.", "neutra") : null;
        if (CostoDe(v, precio) is not { } costo)
            return corto ? null : new("Escribe lo que te cuesta para ver cuánto ganas.", "neutra");
        var gana = (long)Math.Round(centavos - costo, MidpointRounding.AwayFromZero);
        var margen = Margen.Texto(Margen.Calcular(centavos, costo));
        if (centavos < costo)
            return new(corto ? $"Pierdes {Formato.Dinero(-gana)}" : $"Con este precio pierdes {Formato.Dinero(-gana)} por {por}.", "pierde");
        if (gana == 0)
            return new(corto ? "No ganas nada" : "No ganas nada con este precio.", "neutra");
        return new(corto ? $"{Formato.Dinero(gana)} · {margen}" : $"Ganas {Formato.Dinero(gana)} por {por} ({margen} del precio)", "");
    }

    // ── Lo que dicen las secciones cerradas ──

    private string ResumenDeInventario()
    {
        var p = _producto!;
        if (p.Tipo == TipoProducto.Servicio)
            return "No lleva inventario (servicio)";
        var v0 = p.Variantes[0];
        if (VariasVariantes && p.Variantes.Any(v => v.Minimo.Trim() != v0.Minimo.Trim() || v.Maximo.Trim() != v0.Maximo.Trim()))
            return "Cada uno con su mínimo y su máximo";
        var texto = $"{(v0.Minimo.Trim().Length > 0 ? $"Mínimo {v0.Minimo.Trim()}" : $"Avisa con {PocaExistencia.Hasta} o menos")} · "
            + (v0.Maximo.Trim().Length > 0 ? $"máximo {v0.Maximo.Trim()}" : "sin máximo");
        return !VariasVariantes && v0.Id is not null && v0.Existencia is { } hay ? $"Hay {Formato.Numero(hay)} · {char.ToLower(texto[0])}{texto[1..]}" : texto;
    }

    private static string ResumenDeMayoreo(VarianteEditable v)
    {
        var partes = new List<string>();
        foreach (var m in Mayoreos(v))
            partes.Add($"mayoreo desde {(m.Desde.Trim().Length > 0 ? m.Desde.Trim() : "—")} a {(Formato.LeerPesos(m.Precio) is { } pesos and > 0 ? Formato.Dinero(pesos) : "—")}");
        foreach (var caja in Cajas(v))
        {
            var nombre = caja.Nombre.Trim().Length > 0 ? caja.Nombre.Trim() : "caja";
            var precio = PrecioDeLaCaja(v, caja) is { } propio && Formato.LeerPesos(propio.Precio) is { } pesos and > 0 ? $" a {Formato.Dinero(pesos)}" : "";
            partes.Add($"{nombre} de {(caja.Contiene.Trim().Length > 0 ? caja.Contiene.Trim() : "—")}{precio}");
        }
        var texto = string.Join(" · ", partes);
        return texto.Length > 0 ? char.ToUpper(texto[0]) + texto[1..] : "Sin mayoreo ni cajas";
    }

    private string ResumenDeVariantes()
    {
        var p = _producto!;
        if (!VariasVariantes)
            return "Un solo tipo";
        return $"{p.Variantes.Count}: {string.Join(", ", p.Variantes.Select(v => v.Descripcion.Trim().Length > 0 ? v.Descripcion.Trim() : "sin nombre"))}";
    }

    private string ResumenDeOtros()
    {
        var p = _producto!;
        var iva = p.Impuesto switch { Impuesto.Iva0 => "IVA 0 %", Impuesto.Exento => "Exento de IVA", _ => "IVA 16 %" };
        return $"{iva} · {(SeVende ? "se vende" : "no se vende")} · {(p.Tipo == TipoProducto.Servicio ? "servicio" : "lleva inventario")}";
    }

    /// <summary>Con una sola variante, «Se vende» es el del producto y el de la variante juntos (eran dos casillas para lo mismo).</summary>
    private bool SeVende => _producto!.Activo && (VariasVariantes || _producto.Variantes[0].Activa);

    /// <summary>En el piloto, si se vende lo pone la lectura de eleventa.</summary>
    private bool SeVendeFijo => _productoDeEleventa || (!VariasVariantes && _producto!.Variantes[0].DeEleventa);

    private void SeVendeCambiado(bool seVende)
    {
        var p = _producto!;
        p.Activo = seVende;
        if (!VariasVariantes)
            p.Variantes[0].Activa = seVende;
    }

    /// <summary>Lo dio de alta un cajero con la alta rápida (con el primer departamento): qué revisar, en concreto.</summary>
    private string PorCompletar(ProductoEditable p)
    {
        var departamento = Departamentos.FirstOrDefault(d => d.Id == p.DepartamentoId)?.Nombre ?? _suyoDesactivado?.Nombre;
        var que = departamento is null ? "el departamento" : $"el departamento (el cajero dejó «{departamento}»)";
        return $"Lo dio de alta un cajero desde la caja: revisa {que}, la marca{(VeCostos ? " y el costo" : "")}, y guárdalo.";
    }

    // ── Pedazos que se repiten ──

    private RenderFragment ErrorEn(string campo) => __builder =>
    {
        if (_errorEn == campo && _error is { } error)
        {
            <span class="ficha-error" role="alert">@error</span>
        }
    };

    private RenderFragment Candado => __builder =>
    {
        <span class="ficha-candado" title="@SeCambiaEnEleventa"><Ico Nombre="candado" />Se cambia en eleventa</span>
    };

    /// <summary>La unidad: a una variante de eleventa solo se le ofrecen pieza, pieza a granel, metro y litro (lo que deja el servicio).</summary>
    private RenderFragment UnidadDe(VarianteEditable Variante, string? Id) => __builder =>
    {
        <select id="@Id" @bind="Variante.Unidad">
            <option value="@UnidadBase.Pieza">Pieza</option>
            <option value="@UnidadBase.Metro">Metro</option>
            @if (!Variante.DeEleventa || Variante.Unidad == UnidadBase.Kilogramo)
            {
                <option value="@UnidadBase.Kilogramo">Kilo</option>
            }
            <option value="@UnidadBase.Litro">Litro</option>
            <option value="@UnidadBase.PiezaAGranel">Pieza a granel (con fracciones)</option>
        </select>
    };

    private RenderFragment Existencia(VarianteEditable v) => __builder =>
    {
        if (v.Id is not null)
        {
            <p class="nota">
                Existencia: @(v.Existencia is { } e ? Formato.Numero(e) : "—")
                @if (v.Costo is { } c)
                {
                    <span> · costo promedio @Formato.Dinero((long)Math.Round(c))</span>
                }
            </p>
        }
    };

    /// <summary>El mayoreo y las cajas de una variante: en su sección (con una) o en su «Mayoreo y cajas…» de la tabla (con varias).</summary>
    private RenderFragment MayoreoYCajas(VarianteEditable v) => __builder =>
    {
        var unidades = Plural(v.Unidad);
        <p class="ficha-sub">Mayoreo <span class="nota">· más barato desde cierta cantidad</span></p>
        <div class="ficha-renglones">
            @foreach (var m in Mayoreos(v))
            {
                var mayoreo = m;
                <div class="ficha-renglon ficha-mayoreo @(mayoreo.DeEleventa ? "de-eleventa" : "")">
                    <span class="t">Desde</span>
                    <input id="may-desde-@mayoreo.Clave.ToString("N")" class="umbral desde" inputmode="decimal" autocomplete="off" @bind="mayoreo.Desde"
                           disabled="@mayoreo.DeEleventa" aria-label="Desde cuántas" />
                    <span class="t">@unidades, a</span>
                    <span class="ficha-peso"><input id="may-precio-@mayoreo.Clave.ToString("N")" class="umbral mayoreo" data-numero inputmode="decimal" autocomplete="off"
                                                    value="@mayoreo.Precio" @oninput="e => PrecioEscrito(v, mayoreo, e.Value)" @onchange="e => PrecioEscrito(v, mayoreo, e.Value)"
                                                    disabled="@mayoreo.DeEleventa" aria-label="Precio de cada una en mayoreo" /></span>
                    <span class="g ancho-m @(VeMargen ? GananciaDe(v, mayoreo)?.Clase : "")">@(VeMargen ? GananciaDe(v, mayoreo)?.Texto : "")@MasCaroQueLaPieza(v, mayoreo)</span>
                    @if (mayoreo.DeEleventa)
                    {
                        <span class="nota">de eleventa</span>
                    }
                    else
                    {
                        <button type="button" class="ficha-quitar" aria-label="Quitar este mayoreo" title="Quitar" @onclick="() => v.Precios.Remove(mayoreo)">×</button>
                    }
                    @ErrorEn($"may-desde-{mayoreo.Clave:N}")
                    @ErrorEn($"may-precio-{mayoreo.Clave:N}")
                </div>
            }
        </div>
        <div><button type="button" class="boton chico" @onclick="() => AgregarMayoreo(v)">+ Agregar mayoreo</button></div>

        <p class="ficha-sub">Cajas y paquetes <span class="nota">· con su propio código y, si quieres, su propio precio</span></p>
        @if (PiezaFueraDeLugar(v))
        {
            <p class="nota">
                ¿Cuál es la pieza (con la que se cuenta el inventario)?
                @foreach (var pr in v.Presentaciones)
                {
                    var presentacion = pr;
                    <label class="ficha-opcion"><input type="radio" name="base-@v.Clave" checked="@presentacion.EsBase" disabled="@v.DeEleventa"
                                                       @onchange="() => HacerBase(v, presentacion)" /> @presentacion.Nombre</label>
                }
            </p>
        }
        <div class="ficha-renglones">
            @foreach (var c in Cajas(v))
            {
                var caja = c;
                var propio = PrecioDeLaCaja(v, caja);
                <div class="ficha-renglon ficha-caja">
                    <input id="caja-nombre-@caja.Clave.ToString("N")" value="@caja.Nombre" @onchange="e => CajaRenombrada(v, caja, e.Value)" autocomplete="off"
                           aria-label="Nombre (caja, paquete…)" placeholder="Caja, paquete…" />
                    <span class="t">con</span>
                    <input id="caja-contiene-@caja.Clave.ToString("N")" class="umbral contiene" inputmode="decimal" autocomplete="off" @bind="caja.Contiene"
                           aria-label="Cuántas trae" />
                    <span class="t">@unidades</span>
                    <span class="ficha-con-boton">
                        <input class="codigos" data-escaneo="varios" @bind="caja.Codigos" autocomplete="off" placeholder="Código de la caja" aria-label="Código de la caja" />
                        <button type="button" class="boton chico" disabled="@_ocupado" title="Le pone un código interno" @onclick="() => CodigoInternoAsync(caja)">Generar</button>
                    </span>
                    <span class="ficha-peso"><input class="umbral de-caja" data-numero inputmode="decimal" autocomplete="off" value="@(propio?.Precio ?? "")"
                                                    @oninput="e => PrecioDeLaCajaEscrito(v, caja, e.Value)" @onchange="e => PrecioDeLaCajaEscrito(v, caja, e.Value)"
                                                    disabled="@(caja.Nombre.Trim().Length == 0 || propio?.DeEleventa == true)" placeholder="Sin precio propio" aria-label="Precio de la caja" /></span>
                    @if (SinPrecioPropio(v, caja) is { } piezas)
                    {
                        <span class="g neutra ancho-m">@piezas</span>
                    }
                    else if (VeMargen && propio is not null && GananciaDe(v, propio) is { } g)
                    {
                        <span class="g ancho-m @g.Clase">@g.Texto</span>
                    }
                    else
                    {
                        <span class="g ancho-m"></span>
                    }
                    <button type="button" class="ficha-quitar" aria-label="Quitar esta caja" title="Quitar" @onclick="() => QuitarCaja(v, caja)">×</button>
                    @ErrorEn($"caja-nombre-{caja.Clave:N}")
                    @ErrorEn($"caja-contiene-{caja.Clave:N}")
                    @foreach (var cm in MayoreoDeLaCaja(v, caja))
                    {
                        var deLaCaja = cm;
                        <div class="ficha-mayoreo-caja ancho-m">
                            <span class="t">Mayoreo de la caja: desde</span>
                            <input class="umbral desde" inputmode="decimal" autocomplete="off" @bind="deLaCaja.Desde" disabled="@deLaCaja.DeEleventa" aria-label="Desde cuántas cajas" />
                            <span class="t">a</span>
                            <span class="ficha-peso"><input class="umbral mayoreo" data-numero inputmode="decimal" autocomplete="off" value="@deLaCaja.Precio"
                                                            @oninput="e => PrecioEscrito(v, deLaCaja, e.Value)" @onchange="e => PrecioEscrito(v, deLaCaja, e.Value)"
                                                            disabled="@deLaCaja.DeEleventa" aria-label="Precio de cada caja en mayoreo" /></span>
                            @if (!deLaCaja.DeEleventa)
                            {
                                <button type="button" class="ficha-quitar" aria-label="Quitar este mayoreo de la caja" title="Quitar" @onclick="() => v.Precios.Remove(deLaCaja)">×</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div><button type="button" class="boton chico" @onclick="() => AgregarCaja(v)">+ Agregar caja o paquete</button></div>
    };

    /// <summary>Sin precio propio, la caja se vende por sus piezas: «Sin precio propio: 20 × $45.00 = $900.00».</summary>
    private static string? SinPrecioPropio(VarianteEditable v, PresentacionEditable caja)
    {
        if (PrecioDeLaCaja(v, caja) is { } propio && propio.Precio.Trim().Length > 0)
            return null;
        return Formato.LeerPesos(Menudeo(v).Precio) is { } pieza and > 0 && Formato.LeerCantidad(caja.Contiene) is { } n and > 0
            ? $"Sin precio propio: {Formato.Numero(n)} × {Formato.Dinero(pieza)} = {Formato.Dinero((long)Math.Round(pieza * n, MidpointRounding.AwayFromZero))}"
            : "Sin precio propio: se vende por piezas";
    }

    /// <summary>Un mayoreo más caro que la pieza no se rechaza aquí (lo revisa el servicio), pero se dice.</summary>
    private static string MasCaroQueLaPieza(VarianteEditable v, PrecioEditable mayoreo) =>
        Formato.LeerPesos(mayoreo.Precio) is { } precio and > 0 && Formato.LeerPesos(Menudeo(v).Precio) is { } pieza and > 0 && precio > pieza
            ? $" El mayoreo sale más caro que la {Unidad(v.Unidad)} ({Formato.Dinero(pieza)})."
            : "";

    /// <summary>Lo de una variante ya guardada: su foto, sus proveedores, el kardex y depurar.</summary>
    private RenderFragment DeLaGuardada(VarianteEditable v) => __builder =>
    {
        var p = _producto!;
        if (v.Id is not { } varianteId)
            return;
        var nombre = v.Descripcion.Length > 0 ? $"{p.Nombre} {v.Descripcion}" : p.Nombre;
        @* Su foto (entrega 13, parte 2): la que sale en Ctrl+M, en la búsqueda y en el verificador. Se guarda aparte, al momento. *@
        <FotoDeLaVariante Caja="Caja" Sesion="Sesion" VarianteId="varianteId" PuedeEditar="PuedeEditar" Nombre="@nombre" />
        @if (VariasVariantes)
        {
            @Existencia(v)
        }
        @if (v.Proveedores is { Count: > 0 } proveedores)
        {
            <p class="nota">Proveedores: @string.Join(" · ", proveedores.Select(x => x.Proveedor + (x.UltimoCostoCentavos is { } u ? $" ({Formato.Dinero(u)})" : "")))</p>
        }
        <div class="acciones izquierda">
            <button class="boton chico" @onclick="() => KardexAsync(varianteId)">@(_kardexDe == varianteId ? "Ocultar kardex" : "Ver kardex")</button>
        </div>
        @if (PuedeEditar && v.Activa && !v.DeEleventa)
        {
            <DepurarVariante Caja="Caja" Sesion="Sesion" VarianteId="varianteId" Unidad="v.Unidad" Nombre="@nombre" AlTerminar="DepuradoAsync" />
        }
        @if (_kardexDe == varianteId && _kardex is { } kardex)
        {
            <div class="resultados kardex">
                <table>
                    <thead><tr><th>Fecha</th><th>Movimiento</th><th class="num">Cantidad</th><th class="num">Existencia</th><th>Quién</th><th>Motivo</th></tr></thead>
                    @foreach (var m in kardex)
                    {
                        <tr>
                            <td>@m.FechaLocal.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@Movimiento(m.Tipo)</td>
                            <td class="num">@Formato.Numero(m.Cantidad)</td>
                            <td class="num">@Formato.Numero(m.Existencia)</td>
                            <td>@m.Quien</td>
                            <td>@m.Motivo</td>
                        </tr>
                    }
                </table>
            </div>
        }
    };

    // ── Marca y departamento ──

    /// <summary>Las marcas ya capturadas que se parecen a lo escrito (sin acentos ni mayúsculas); la misma escrita ya no sale.</summary>
    private List<string> MarcasParecidas(string? escrito)
    {
        var texto = Texto.Normalizar(escrito ?? "");
        return [.. Opciones.Marcas.Where(m => Texto.Normalizar(m) is var marca && marca != texto && (texto.Length == 0 || marca.Contains(texto, StringComparison.Ordinal))).Take(8)];
    }

    private async Task AbrirDepartamentoNuevoAsync()
    {
        _departamentoNuevo = "";
        await Task.Yield();
        StateHasChanged();
        await Js.EnfocarAsync("#ficha-departamento-nombre");
    }

    private async Task AlTeclearDepartamentoAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !(e.CtrlKey || e.MetaKey))
            await CrearDepartamentoAsync();
        else if (e.Key == "Escape")
            _departamentoNuevo = null;
    }

    /// <summary>Lo da de alta (como en Productos › Departamentos) y deja el producto en él; si ya existía con ese nombre, usa ese.</summary>
    private async Task CrearDepartamentoAsync()
    {
        if (_ocupado || _departamentoNuevo is null)
            return;
        var nombre = _departamentoNuevo.Trim();
        if (nombre.Length == 0)
        {
            _error = "Escribe el nombre del departamento.";
            return;
        }
        (_error, _errorEn, _ocupado) = (null, null, true);
        try
        {
            if (Departamentos.FirstOrDefault(d => Texto.Normalizar(d.Nombre) == Texto.Normalizar(nombre)) is not { } yaEsta)
            {
                var todos = await Cliente.DarDeAltaDepartamentoAsync(new SolicitudDepartamento(Sesion.UsuarioId, Caja.SucursalId, nombre));
                _enElPiloto = todos.EnEleventa;
                var creado = todos.Departamentos.Where(d => d.Activo).FirstOrDefault(d => Texto.Normalizar(d.Nombre) == Texto.Normalizar(nombre))
                    ?? throw new ErrorCaja("El departamento no quedó dado de alta: revisa en Productos › Departamentos.");
                yaEsta = new OpcionCatalogoDto(creado.Id, creado.Nombre);
                _creados.Add(yaEsta);
                await AlCrearDepartamento.InvokeAsync();
            }
            _producto!.DepartamentoId = yaEsta.Id;
            _departamentoNuevo = null;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static void HacerBase(VarianteEditable variante, PresentacionEditable presentacion)
    {
        foreach (var p in variante.Presentaciones)
            p.EsBase = p == presentacion;
        presentacion.Contiene = "1";
    }

    /// <summary>«Sin código: generar uno»: el código interno en la pieza, y el cursor al nombre.</summary>
    private async Task GenerarCodigoAsync(PresentacionEditable pieza)
    {
        await CodigoInternoAsync(pieza);
        if (_error is null)
            _enfocarEn = "#ficha-nombre";
    }

    private async Task CodigoInternoAsync(PresentacionEditable presentacion)
    {
        (_error, _errorEn) = (null, null);
        _ocupado = true;
        try
        {
            var codigo = await Cliente.CodigoInternoAsync();
            presentacion.Internos.Add(codigo);
            presentacion.Codigos = (presentacion.Codigos.Trim() + " " + codigo).Trim();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task KardexAsync(Guid varianteId)
    {
        if (_kardexDe == varianteId)
        {
            (_kardexDe, _kardex) = (null, null);
            return;
        }
        try
        {
            _kardex = await Cliente.KardexAsync(varianteId, Caja.SucursalId);
            _kardexDe = varianteId;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Después de depurar, la ficha al día (lo que se dio de baja o se juntó se ve inactivo).</summary>
    private async Task DepuradoAsync(string mensaje)
    {
        _aviso = mensaje;
        if (_producto?.Id is not { } id)
            return;
        try
        {
            if (await Cliente.FichaProductoAsync(id, Caja.SucursalId, Sesion.UsuarioId) is { } ficha)
                Mostrar(ficha);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        (_kardexDe, _kardex) = (null, null);
    }

    /// <summary>
    /// Lo que no deja guardar: el mensaje sale junto a la casilla (y en el pie), su sección se abre y el cursor va a ella. Devuelve
    /// false, para el «return» de quien lo llama.
    /// </summary>
    private bool Problema(string campo, string mensaje, VarianteEditable? variante = null, bool abajo = false)
    {
        (_error, _errorEn, _enfocarEn) = (mensaje, campo, $"#{campo}");
        if (campo.StartsWith("ficha-minimo", StringComparison.Ordinal) || campo.StartsWith("var-minimo", StringComparison.Ordinal)
            || campo.StartsWith("var-hay", StringComparison.Ordinal))
            _abrirInventario = true;
        if (abajo && variante is not null)
        {
            if (VariasVariantes)
            {
                _abrirVariantes = true;
                _masDe.Add(variante.Clave);
            }
            else
                _abrirMayoreo = true;
        }
        if (campo.StartsWith("var-", StringComparison.Ordinal) && !campo.StartsWith("var-minimo", StringComparison.Ordinal)
            && !campo.StartsWith("var-hay", StringComparison.Ordinal))
            _abrirVariantes = true;
        return false;
    }

    public async Task GuardarAsync()
    {
        // También lo llama el aviso de Productos, y un doble clic ahí daba de alta el producto dos veces.
        if (_ocupado)
            return;
        (_error, _errorEn, _aviso) = (null, null, null);
        var p = _producto!;
        if (p.Nombre.Trim().Length == 0)
        {
            Problema("ficha-nombre", "Escribe el nombre del producto.");
            return;
        }
        if (p.DepartamentoId == Guid.Empty)
        {
            Problema("ficha-departamento", "Elige el departamento.");
            return;
        }
        var varias = VariasVariantes;
        if (varias && p.Variantes.Count > 1)
        {
            var nombres = new HashSet<string>(StringComparer.CurrentCultureIgnoreCase);
            for (var i = 0; i < p.Variantes.Count; i++)
            {
                var v = p.Variantes[i];
                if (!v.Activa)
                    continue;
                var nombre = v.Descripcion.Trim();
                if (nombre.Length == 0)
                {
                    Problema($"var-nombre-{i}", "Ponle nombre a cada uno: Raya, Cuadro chico…");
                    return;
                }
                if (!nombres.Add(nombre))
                {
                    Problema($"var-nombre-{i}", $"Hay dos «{nombre}».");
                    return;
                }
            }
        }
        var variantes = new List<VarianteFichaDto>();
        for (var i = 0; i < p.Variantes.Count; i++)
        {
            var v = p.Variantes[i];
            var quien = v.Descripcion.Trim().Length > 0 ? $"{p.Nombre.Trim()} {v.Descripcion.Trim()}" : p.Nombre.Trim();
            var presentaciones = new List<PresentacionFichaDto>();
            foreach (var pr in v.Presentaciones)
            {
                if (!pr.EsBase && pr.Nombre.Trim().Length == 0)
                {
                    Problema($"caja-nombre-{pr.Clave:N}", "Ponle nombre a la caja o paquete (Caja, Paquete…).", v, abajo: true);
                    return;
                }
                // La caja nueva trae 2 o más; las de antes, lo que ya traían (no se deja de poder guardar un producto que ya existe).
                if (Milesimas(pr.EsBase ? "1" : pr.Contiene) is not { } factor || (!pr.EsBase && pr.Id is null && factor <= Cantidad.Escala))
                {
                    Problema($"caja-contiene-{pr.Clave:N}", "Escribe cuántas piezas trae la caja (2 o más).", v, abajo: true);
                    return;
                }
                var escritos = pr.Codigos.Split([' ', ','], StringSplitOptions.RemoveEmptyEntries)
                    .Where(c => !pr.Fijos.Contains(c, StringComparer.OrdinalIgnoreCase));
                var codigos = pr.Fijos.Concat(escritos)
                    .Select(c => new CodigoFichaDto(c, pr.Internos.Contains(c) ? OrigenCodigo.Interno : OrigenCodigo.Fabrica)).ToList();
                presentaciones.Add(new PresentacionFichaDto(pr.Id, pr.Nombre, factor, pr.EsBase, codigos));
            }
            var precios = new List<PrecioFichaDto>();
            var mayoreos = new HashSet<long>();
            foreach (var pc in v.Precios)
            {
                var campoPrecio = pc.Menudeo ? (varias ? $"var-precio-{i}" : "ficha-precio") : $"may-precio-{pc.Clave:N}";
                if (pc.Menudeo)
                {
                    if (Formato.LeerPesos(pc.Precio) is not ({ } menudeo and > 0))
                    {
                        Problema(campoPrecio, Formato.ProblemaDePesos(pc.Precio) is { } coma ? $"Revisa los precios: {char.ToLowerInvariant(coma[0])}{coma[1..]}"
                            : varias ? $"Escribe el precio de venta de «{quien}» (lo que paga el cliente)." : "Escribe el precio de venta (lo que paga el cliente).");
                        return;
                    }
                    precios.Add(new PrecioFichaDto(null, Cantidad.Escala, menudeo));
                    continue;
                }
                if (pc.Presentacion.Length > 0)
                {
                    // El precio propio de una caja, vacío: se vende por sus piezas (no se guarda).
                    if (DesdeUna(pc) && pc.Precio.Trim().Length == 0 && !pc.DeEleventa)
                        continue;
                    if (Milesimas(pc.Desde) is not { } desdeCajas || Formato.LeerPesos(pc.Precio) is not ({ } deLaCaja and > 0))
                    {
                        var deQuien = v.Presentaciones.FirstOrDefault(x => x.Nombre.Trim() == pc.Presentacion)?.Clave ?? Guid.Empty;
                        Problema($"caja-nombre-{deQuien:N}",
                            Formato.ProblemaDePesos(pc.Precio) is { } coma ? $"Revisa los precios: {char.ToLowerInvariant(coma[0])}{coma[1..]}"
                                : $"Revisa el precio de «{pc.Presentacion}».", v, abajo: true);
                        return;
                    }
                    precios.Add(new PrecioFichaDto(pc.Presentacion, desdeCajas, deLaCaja));
                    continue;
                }
                // Un mayoreo que se agregó y se dejó vacío no cuenta.
                if (pc.Desde.Trim().Length == 0 && pc.Precio.Trim().Length == 0 && !pc.DeEleventa)
                    continue;
                if (Milesimas(pc.Desde) is not { } desde || desde <= Cantidad.Escala)
                {
                    Problema($"may-desde-{pc.Clave:N}", "El mayoreo es desde 2 piezas o más.", v, abajo: true);
                    return;
                }
                if (!mayoreos.Add(desde))
                {
                    Problema($"may-desde-{pc.Clave:N}", $"Ya hay un mayoreo desde {Numero(desde)}.", v, abajo: true);
                    return;
                }
                if (Formato.LeerPesos(pc.Precio) is not ({ } centavos and > 0))
                {
                    Problema(campoPrecio, Formato.ProblemaDePesos(pc.Precio) is { } coma ? $"Revisa los precios: {char.ToLowerInvariant(coma[0])}{coma[1..]}"
                        : $"Escribe el precio del mayoreo desde {Numero(desde)}.", v, abajo: true);
                    return;
                }
                precios.Add(new PrecioFichaDto(null, desde, centavos));
            }
            // Siempre van (vacíos: sin propio); un servicio no lleva inventario y el servicio los deja vacíos. También los de una
            // variante de eleventa en el piloto (2026-11-07: son de aquí; la lectura ya no los pone).
            if (!LeerCantidad(v.Minimo, out var minimo) || !LeerCantidad(v.Maximo, out var maximo))
            {
                Problema(varias ? $"var-minimo-{i}" : "ficha-minimo", $"Revisa el mínimo y el máximo de «{quien}»: una cantidad, o vacío.");
                return;
            }
            var minimoYMaximo = new MinimoYMaximoDto(minimo, maximo);
            // El costo: solo si se ve y se cambió (vacío, «no se toca»).
            long? costo = null;
            if (VeCostos && !v.DeEleventa && v.UltimoCosto.Trim().Length > 0)
            {
                if (Formato.LeerPesos(v.UltimoCosto) is not ({ } escrito and >= 0))
                {
                    Problema(varias ? $"var-costo-{i}" : "ficha-costo", $"Revisa el costo de «{quien}»: " + (Formato.ProblemaDePesos(v.UltimoCosto) ?? "una cantidad en pesos, o vacío."));
                    return;
                }
                costo = escrito == v.UltimoCostoGuardado ? null : escrito;
            }
            // «¿Cuántas hay?»: una cantidad (en piezas, entera), o vacío. Quien ve los costos escribe a cuánto entra, como en
            // «Agregar inventario» de un producto sin costo.
            long? hay = null;
            if (PideHay(v) && v.Hay.Trim().Length > 0)
            {
                // Con la misma regla que «Cuántos llegaron» de «Agregar inventario»; el cero es «sin inventario», como vacío.
                if (Formato.LeerCantidad(v.Hay) != 0)
                {
                    if (AgregarInventarioEnPantalla.Cantidad(v.Hay, v.Unidad, quien, out var problemaHay) is not { } milesimas)
                    {
                        Problema(varias ? $"var-hay-{i}" : "ficha-hay", (problemaHay ?? "Revisa cuántas hay.").Replace("cuántos llegaron", "cuántas hay"));
                        return;
                    }
                    hay = milesimas;
                }
                if (hay is not null && VeCostos && v.UltimoCosto.Trim().Length == 0)
                {
                    Problema(varias ? $"var-costo-{i}" : "ficha-costo", $"Escribe lo que te cuesta «{quien}»: lo que hay entra al inventario a ese costo.");
                    return;
                }
            }
            variantes.Add(new VarianteFichaDto(v.Id, v.Descripcion, v.Unidad, v.Activa, presentaciones, precios, MinimoYMaximo: minimoYMaximo, CostoCentavos: costo,
                HayMilesimas: hay));
        }
        var nuevo = p.Id is null;
        var sinCodigo = nuevo && p.Variantes.All(v => v.Presentaciones.All(x => x.Codigos.Trim().Length == 0 && x.Fijos.Count == 0));
        var ficha = new FichaProductoDto(p.Id, p.Nombre, p.DepartamentoId, p.Marca, p.Tipo, p.Impuesto, p.ClaveSat, p.Activo, p.PorCompletar, variantes);
        _ocupado = true;
        try
        {
            var guardada = await Cliente.GuardarProductoAsync(new SolicitudGuardarProducto(Sesion.UsuarioId, Caja.SucursalId, ficha));
            Mostrar(guardada);
            var entraron = variantes.Where(v => v.HayMilesimas is not null).ToList();
            _aviso = "Guardado: las cajas ya lo venden así."
                + (entraron.Count == 0 ? ""
                    : entraron.Count == 1 ? $" Entraron al inventario {Numero(entraron[0].HayMilesimas!.Value)} {Plural(entraron[0].Unidad)}."
                    : $" Entró al inventario lo que hay de {entraron.Count}.")
                + (sinCodigo ? " Sin código se vende buscándolo por nombre: «Sin código: generar uno» le pone uno." : "");
            await AlGuardar.InvokeAsync(guardada);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>Con la regla de los números del POS: «1,000» son mil y «2,5» no se adivina (antes eran 25; revisión del PR #138).</summary>
    private static long? Milesimas(string texto) =>
        Formato.LeerCantidad(texto) is { } n && n > 0 ? (long)Math.Round(n * Cantidad.Escala) : null;

    /// <summary>
    /// Un mínimo o un máximo escrito: vacío es «sin propio» (null); si no, una cantidad (el cero vale como mínimo). Lo demás
    /// (que no sea negativo, ni con fracciones en piezas, ni el máximo debajo del mínimo) lo revisa el servicio.
    /// </summary>
    private static bool LeerCantidad(string texto, out long? milesimas)
    {
        milesimas = null;
        var limpio = texto.Trim();
        if (limpio.Length == 0)
            return true;
        if (Formato.LeerCantidad(limpio) is not { } n || Math.Abs(n) > Variante.TopeMinimoYMaximo)
            return false;
        milesimas = (long)Math.Round(n * Cantidad.Escala);
        return true;
    }

    private static string Numero(long milesimas) => (milesimas / (decimal)Cantidad.Escala).ToString("0.###", CultureInfo.InvariantCulture);

    private static string Unidad(UnidadBase u) => u switch
    {
        UnidadBase.Metro => "metro",
        UnidadBase.Kilogramo => "kilo",
        UnidadBase.Litro => "litro",
        _ => "pieza",
    };

    private static string Plural(UnidadBase u) => u switch
    {
        UnidadBase.Metro => "metros",
        UnidadBase.Kilogramo => "kilos",
        UnidadBase.Litro => "litros",
        _ => "piezas",
    };

    private static string Movimiento(PapeleriaPos.Nucleo.Inventario.TipoMovimiento t) => t switch
    {
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.InventarioInicial => "Inventario inicial",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Venta => "Venta",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Devolucion => "Devolución",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Compra => "Compra",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Ajuste => "Ajuste",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.Merma => "Merma",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.TraspasoSalida => "Traspaso (salida)",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.TraspasoEntrada => "Traspaso (entrada)",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.ConsumoServicio => "Consumo de servicio",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.AperturaPaquete => "Apertura de paquete",
        PapeleriaPos.Nucleo.Inventario.TipoMovimiento.AgregarInventario => "Agregar inventario",
        _ => "Conteo",
    };
