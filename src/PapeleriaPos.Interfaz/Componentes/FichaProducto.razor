        public List<PrecioEditable> Precios { get; init; } = [];
        public decimal? Existencia { get; init; }
        public decimal? Costo { get; init; }

        /// <summary>La casilla del costo (2026-11-16): su último costo, como se escribe; vacío, sin costo.</summary>
        public string UltimoCosto { get; set; } = "";

        /// <summary>El último costo como llegó: si no se cambia, no se manda otro.</summary>
