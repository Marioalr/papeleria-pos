@* CTRL+B (fase 3, entrega 2): un abono a la cuenta de un cliente, en cualquier caja con su turno; el dinero entra a este
   turno y al corte como ingreso aparte. En efectivo se abona en pesos, o se liquida al peso; con tarjeta o transferencia,
   exacto. Con la caja principal (sin conexión, los abonos esperan). También los abonos de hoy: reimprimir y cancelar
   (solo los de este turno, con motivo). Como al cobrar una venta, lo que no es dinero no se abona y un cambio grande se
   confirma con otro Enter (TopeDeCambio); si el lector escribe en el abono, caja.js manda el código al ticket. *@
@using PapeleriaPos.Nucleo.Clientes
@inject ClienteCaja Servicio
@inject ModuloCaja Js

@if (_autorizar is { } pendiente)
{
    <AutorizarAccion Accion="AccionControlada.CancelarAbono" Detalle="@($"Cancelar el abono {pendiente.Folio} de «{pendiente.Cliente}»")"
                     MontoCentavos="pendiente.MontoCentavos" Caja="Caja" Sesion="Sesion" AlAutorizar="a => CancelarAsync(pendiente, a.Id)"
                     AlCancelar="() => _autorizar = null" />
}
else
{
    <nav class="pestanas">
        <button class="pestana @(_deHoy ? "" : "activa")" @onclick="() => _deHoy = false">Abonar</button>
        <button class="pestana @(_deHoy ? "activa" : "")" @onclick="AbonosDeHoyAsync">Abonos de hoy</button>
    </nav>

    @if (_deHoy)
    {
        @if (_hoy is null)
        {
            <p>Cargando…</p>
        }
        else if (_hoy.Count == 0)
        {
            <p class="vacia">Hoy no hay abonos en esta caja.</p>
        }
        else
        {
            <label>Motivo (para cancelar o reimprimir) <input @bind="_motivo" autocomplete="off" /></label>
            <div class="resultados">
                <table>
                    <thead><tr><th>Abono</th><th>Hora</th><th>Cliente</th><th>Forma</th><th class="num">Monto</th><th></th></tr></thead>
                    @foreach (var a in _hoy)
                    {
                        var abono = a;
                        <tr class="@(a.Cancelado ? "inactivo" : "")">
                            <td>@a.Folio</td>
                            <td>@a.FechaLocal.ToString("HH:mm")</td>
                            <td>@a.Cliente</td>
                            <td>@(a.Tipo == TipoAbono.SaldoDevuelto ? "Saldo devuelto" : Forma(a.Forma))</td>
                            <td class="num">@(a.Tipo == TipoAbono.SaldoDevuelto ? "−" : "")@Formato.Dinero(a.MontoCentavos)</td>
                            <td class="acciones-renglon">
                                @if (a.Cancelado)
                                {
                                    <span>Cancelado</span>
                                }
                                else
                                {
                                    <button class="boton chico" disabled="@_ocupado" @onclick="() => ReimprimirAsync(abono)">Reimprimir</button>
                                    @if (a.DeEsteTurno && a.Tipo == TipoAbono.Abono)
                                    {
                                        <button class="boton chico" disabled="@_ocupado" @onclick="() => CancelarAsync(abono, null)">Cancelar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </table>
            </div>
        }
    }
    else if (_cliente is null)
    {
        <input id="buscar-deudor" class="buscar-texto" placeholder="¿Quién abona? Nombre o teléfono…" autocomplete="off" @bind="_texto" @bind:event="oninput"
               @onkeydown="ElegirPrimeroAsync" />
        <div class="resultados">
            @if (_deudores is null)
            {
                <p>@(_error ?? "Cargando…")</p>
            }
            else if (Encontrados.Count == 0)
            {
                <p class="vacia">@(_deudores.Count == 0 ? "Nadie debe." : $"Nadie que deba coincide con «{_texto}».")</p>
            }
            <table>
                @foreach (var (cliente, cuenta) in Encontrados)
                {
                    var elegido = cliente;
                    <tr @onclick="() => ElegirAsync(elegido)">
                        <td>@cliente.Nombre</td>
                        <td>@ElegirCliente.Telefono(cliente.Telefono)</td>
                        <td class="num @(cuenta.Vencido(Hoy) > 0 ? "error" : "")">@Formato.Dinero(cuenta.SaldoCentavos)</td>
                    </tr>
                }
            </table>
        </div>
    }
    else if (_cuenta is { } cuenta)
    {
        <p>
            <strong>@_cliente.Nombre</strong> debe <strong>@Formato.Dinero(cuenta.SaldoCentavos)</strong>
            @if (cuenta.Vencido(Hoy) is > 0 and var vencido)
            {
                <span class="error"> · vencido @Formato.Dinero(vencido)</span>
            }
            @if (cuenta.PorVerificarCentavos > 0)
            {
                <span> · @Formato.Dinero(cuenta.PorVerificarCentavos) en transferencias por verificar</span>
            }
            @if (cuenta.Estimado)
            {
                <span> (según esta caja: sin conexión)</span>
            }
            @if (ClienteInicial is null)
            {
                <button class="boton chico" @onclick="OtroCliente">Otro cliente</button>
            }
        </p>
        @if (cuenta.SaldoCentavos <= 0)
        {
            <p class="vacia">No debe nada.</p>
        }
        else
        {
            <div class="dos-columnas">
                <label>Forma de pago
                    <select @bind="_forma">
                        <option value="@FormaPago.Efectivo">Efectivo</option>
                        <option value="@FormaPago.Tarjeta">Tarjeta</option>
                        <option value="@FormaPago.Transferencia">Transferencia</option>
                    </select>
                </label>
                @* data-cobro: lo que el lector teclee aquí va al ticket (caja.js), no se abona. *@
                <label>Abona (vacío: liquida)
                    <input id="abono-monto" data-cobro inputmode="decimal" @bind="_monto" @bind:event="oninput" @onkeydown="AlTeclear" placeholder="Liquidar" autocomplete="off" />
                </label>
                @if (_forma == FormaPago.Efectivo)
                {
                    <label>Pagó con (efectivo)
                        <input data-cobro inputmode="decimal" @bind="_recibido" @bind:event="oninput" @onkeydown="AlTeclear" autocomplete="off"
                               placeholder="@(Calculo is { } exacto ? $"Exacto: {Formato.Dinero(exacto.ACobrarCentavos)}" : "Exacto")" />
                    </label>
                }
                else
                {
                    <label>Referencia <input data-cobro @bind="_referencia" @bind:event="oninput" @onkeydown="AlTeclear" maxlength="60" autocomplete="off" /></label>
                }
            </div>
            <div class="acciones izquierda">
                <button class="boton chico" data-cobro @onclick="Liquidar">Liquidar (@Formato.Dinero(Liquidacion.ACobrarCentavos)@(Liquidacion.RedondeoCentavos != 0 ? $", redondeo {(Liquidacion.RedondeoCentavos > 0 ? "+" : "−")}{Formato.Dinero(Math.Abs(Liquidacion.RedondeoCentavos))}" : ""))</button>
            </div>
            @if (Calculo is { } calculo)
            {
                <p class="cobrar-resumen">
                    Abona @Formato.Dinero(calculo.MontoCentavos)@(calculo.Liquida ? " (liquida)" : $" · queda a deber {Formato.Dinero(cuenta.SaldoCentavos - calculo.MontoCentavos)}")
                    @if (_forma == FormaPago.Efectivo)
                    {
                        <span> · se cobran @Formato.Dinero(calculo.ACobrarCentavos) · cambio <strong>@Formato.Dinero(calculo.CambioCentavos)</strong></span>
                        @if (CambioPorConfirmar(calculo))
                        {
                            <span class="error"> · ¿te dio @Formato.Dinero(calculo.ACobrarCentavos + calculo.CambioCentavos)?</span>
                        }
                    }
                    else if (_forma == FormaPago.Transferencia)
                    {
                        <span> · queda por verificar</span>
                    }
                </p>
            }
            else if (_problema is not null)
            {
                <p class="aviso">@_problema</p>
            }
            <div class="acciones">
                <button class="boton principal" data-cobro disabled="@(_ocupado || Calculo is null)" @onclick="AbonarAsync">Abonar (Enter)</button>
            </div>
        }
    }
    else
    {
        <p>@(_error ?? "Cargando…")</p>
    }

    @if (_error is not null && (_cuenta is not null || _deHoy))
    {
        <p class="error">@_error</p>
    }
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;

    /// <summary>El cliente del ticket (o el de la ficha): si viene, se abona a él.</summary>
    [Parameter] public ClienteRegistradoDto? ClienteInicial { get; set; }

    /// <summary>Se abonó o se canceló: el comprobante para imprimirlo (y abrir el cajón si fue en efectivo).</summary>
    [Parameter] public EventCallback<ComprobanteAbonoDto> AlTerminar { get; set; }

    /// <summary>Se reimprimió: solo se imprime, sin abrir el cajón (no entra ni sale dinero).</summary>
    [Parameter] public EventCallback<ComprobanteAbonoDto> AlReimprimir { get; set; }

    private ClienteRegistradoDto? _cliente;
    private CreditoClienteDto? _cuenta;
    private List<(ClienteRegistradoDto Cliente, CreditoClienteDto Cuenta)>? _deudores;
    private List<AbonoDelDiaDto>? _hoy;
    private bool _deHoy;
    private string _texto = "";
    private FormaPago _forma = FormaPago.Efectivo;
    private string _monto = "";
    private string _recibido = "";
    private string _referencia = "";
    private string _motivo = "";
    private string? _error;
    private string? _problema;
    private bool _ocupado;
    private AbonoDelDiaDto? _autorizar;

    /// <summary>El Id del abono que se está mandando: si se manda dos veces (o se pierde la respuesta), se guarda uno.</summary>
    private Guid? _id;

    /// <summary>Se perdió la respuesta de ese abono: puede que ya esté guardado.</summary>
    private bool _sinConfirmar;

    private static DateOnly Hoy => DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow));

    private List<(ClienteRegistradoDto Cliente, CreditoClienteDto Cuenta)> Encontrados
    {
        get
        {
            var texto = Texto.Normalizar(_texto.Trim());
            var digitos = new string(_texto.Where(char.IsAsciiDigit).ToArray());
            return (_deudores ?? []).Where(d => texto.Length == 0 || Texto.Normalizar(d.Cliente.Nombre).Contains(texto)
                || (digitos.Length >= 3 && d.Cliente.Telefono is { } t && t.Contains(digitos))).ToList();
        }
    }

    private AbonoCalculado Liquidacion => _cuenta is { SaldoCentavos: > 0 } c
        ? CalculoAbono.Exacto(c.SaldoCentavos, _forma, null)
        : new AbonoCalculado(0, 0, 0, 0, false);

    /// <summary>Lo que va a pasar con lo capturado, con la misma regla que el servicio; si no se puede, por qué.</summary>
    private AbonoCalculado? Calculo
    {
        get
        {
            _problema = null;
            if (_cuenta is not { SaldoCentavos: > 0 } cuenta)
                return null;
            long? monto = string.IsNullOrWhiteSpace(_monto) ? null : Formato.LeerPesos(_monto);
            if (!string.IsNullOrWhiteSpace(_monto) && monto is null)
            {
                _problema = "Escribe cuánto abona.";
                return null;
            }
            try
            {
                // «Pagó con» vacío (o tarjeta o transferencia): lo exacto. Lo que no es dinero no se calcula: dice por qué.
                return _forma == FormaPago.Efectivo && Formato.LeerPesos(_recibido) is { } recibido
                    ? CalculoAbono.Calcular(cuenta.SaldoCentavos, _forma, monto, recibido)
                    : CalculoAbono.Exacto(cuenta.SaldoCentavos, _forma, monto);
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
            {
                _problema = ex.Message;
                return null;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (ClienteInicial is { } cliente)
        {
            await ElegirAsync(cliente);
            return;
        }
        try
        {
            var clientes = (await Servicio.ClientesRegistradosAsync(Caja.SucursalId)).ToDictionary(c => c.Id);
            _deudores = (await Servicio.CreditosAsync(Caja.SucursalId))
                .Where(c => c.SaldoCentavos > 0 && clientes.ContainsKey(c.ClienteId))
                .Select(c => (clientes[c.ClienteId], c))
                .OrderBy(d => d.Item1.Nombre, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Codigo == "sin-conexion" ? "Sin conexión con la caja principal: los abonos esperan a que vuelva." : ex.Message;
        }
    }

    /// <summary>Al abrir, o al elegir a quien abona: el cursor va donde sigue escribir.</summary>
    private bool _enfocar = true;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!_enfocar || (_cliente is not null && _cuenta is null))
            return;
        _enfocar = false;
        await Js.EnfocarAsync(_cliente is null ? "#buscar-deudor" : "#abono-monto");
    }

    /// <summary>Enter en la búsqueda: el primero que coincide.</summary>
    private async Task ElegirPrimeroAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && Encontrados.Count > 0)
            await ElegirAsync(Encontrados[0].Cliente);
    }

    private async Task ElegirAsync(ClienteRegistradoDto cliente)
    {
        (_cliente, _cuenta, _error, _id, _enfocar, _sinConfirmar) = (cliente, null, null, null, true, false);
        try
        {
            _cuenta = await Servicio.CreditoAsync(cliente.Id);
            _recibido = "";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Codigo == "sin-conexion" ? "Sin conexión con la caja principal: los abonos esperan a que vuelva." : ex.Message;
        }
    }

    private void OtroCliente() => (_cliente, _cuenta, _monto, _referencia, _enfocar, _sinConfirmar) = (null, null, "", "", true, false);

    private void Liquidar() => _monto = "";

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AbonarAsync();
    }

    /// <summary>El cambio grande que ya se enseñó (lo que se cobra y lo que dio): el siguiente Enter con lo mismo abona.</summary>
    private (long ACobrar, long Recibido)? _cambioEnsenado;

    /// <summary>Un cambio grande en efectivo (desde $500): se confirma, como en una venta (<see cref="TopeDeCambio"/>).</summary>
    private bool CambioPorConfirmar(AbonoCalculado calculo) => _forma == FormaPago.Efectivo
        && TopeDeCambio.Revisar(calculo.ACobrarCentavos, calculo.ACobrarCentavos + calculo.CambioCentavos) == RevisionDelCambio.PorConfirmar;

    private async Task AbonarAsync()
    {
        if (_ocupado || _cliente is null || _cuenta is null || Calculo is not { } calculo)
            return;
        var recibido = calculo.ACobrarCentavos + calculo.CambioCentavos;
        if (CambioPorConfirmar(calculo) && _cambioEnsenado != (calculo.ACobrarCentavos, recibido))
        {
            _cambioEnsenado = (calculo.ACobrarCentavos, recibido);
            _error = $"El cambio es de {Formato.Dinero(calculo.CambioCentavos)}: revisa que te haya dado {Formato.Dinero(recibido)}. Enter otra vez para abonar.";
            return;
        }
        _ocupado = true;
        _error = null;
        _id ??= Ids.Nuevo();
        try
        {
            // Con el saldo que se vio: si cambió mientras tanto (otra caja le fió o le abonó), el servicio no lo guarda.
            long? monto = string.IsNullOrWhiteSpace(_monto) ? null : Formato.LeerPesos(_monto);
            var comprobante = await Servicio.AbonarAsync(new SolicitudAbono(_id.Value, Caja.Id, Turno.Id, Sesion.UsuarioId, _cliente.Id, _forma, monto,
                _forma == FormaPago.Efectivo ? recibido : 0,
                string.IsNullOrWhiteSpace(_referencia) ? null : _referencia.Trim(), _cuenta.SaldoCentavos), soloEnLinea: _sinConfirmar);
            (_id, _sinConfirmar) = (null, false);
            await AlTerminar.InvokeAsync(comprobante);
        }
        catch (ErrorCaja ex) when (ex.Codigo == "sin-conexion")
        {
            _error = "Sin conexión con la caja principal: los abonos esperan a que vuelva.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
            // Se perdió la respuesta: hasta saber si quedó, este abono (el mismo Id) solo se manda en línea y la pantalla
            // se queda con lo que se vio. Cualquier otra respuesta del servicio dice que no quedó: se ve el saldo de ahora.
            _sinConfirmar = ex.Codigo == "abono-sin-confirmar";
            try
            {
                if (!_sinConfirmar)
                    _cuenta = await Servicio.CreditoAsync(_cliente.Id);
            }
            catch (ErrorCaja)
            {
            }
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task AbonosDeHoyAsync()
    {
        (_deHoy, _error) = (true, null);
        try
        {
            _hoy = await Servicio.AbonosDelDiaAsync(Caja.Id);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReimprimirAsync(AbonoDelDiaDto abono)
    {
        _ocupado = true;
        _error = null;
        try
        {
            var comprobante = await Servicio.ReimprimirAbonoAsync(abono.AbonoId,
                new SolicitudReimpresion(Sesion.UsuarioId, Caja.Id, string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim()));
            await AlReimprimir.InvokeAsync(comprobante);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>Con motivo; si la regla pide autorización, se pide y se vuelve a intentar con ella.</summary>
    private async Task CancelarAsync(AbonoDelDiaDto abono, Guid? autorizacion)
    {
        _autorizar = null;
        _error = null;
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _error = "Escribe el motivo para cancelar el abono.";
            return;
        }
        _ocupado = true;
        try
        {
            var comprobante = await Servicio.CancelarAbonoAsync(abono.AbonoId, Turno.Id,
                new SolicitudCancelacion(Sesion.UsuarioId, Caja.Id, _motivo.Trim(), autorizacion));
            await AlTerminar.InvokeAsync(comprobante);
        }
        catch (ErrorCaja ex) when (ex.Codigo == "requiere-autorizacion" && autorizacion is null)
        {
            _autorizar = abono;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static string Forma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Tarjeta",
        FormaPago.Transferencia => "Transferencia",
        _ => "Efectivo",
    };
}
