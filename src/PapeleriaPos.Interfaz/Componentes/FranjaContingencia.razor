@* Avisa en toda la caja cómo está la red (la red de la tienda en el POS, docs/arquitectura.md, «La red de la matriz»): «Sin red
   local» cuando no llega a la caja principal (con «Volver a buscarla», como en el prototipo), la red lenta, o «Sin internet: la
   venta sigue. No desconectes nada.» cuando lo dice la caja principal y la red local está bien (AvisosDeRed.QueDice); y lo que
   falta por subir y si la base (la del servicio o la de esta caja) no está lista contra apagones. Sin modal: nada estorba al
   cobro, y el botón no se lleva el foco de la venta (no está en el orden del tabulador y el clic no lo enfoca). *@
@implements IDisposable
@inject ConexionCaja Conexion
@inject IServiceProvider Servicios

@if (_contingencia is { } c)
{
    var franja = AvisosDeRed.QueDice(Conexion.Servicio.IsLoopback, Conexion.SimularSinConexion, c.EstadoDeLaRed, c.RedDeLaPrincipal);
    @if (franja is AvisosDeRed.Franja.SinRedLocal or AvisosDeRed.Franja.SinServicio or AvisosDeRed.Franja.Lenta)
    {
        <div class="vn-franja" role="status">
            <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.6 16a5 5 0 0 1 6.8 0" /><circle cx="12" cy="19.3" r=".9" /></svg>
            <span>
                <strong>@AvisosDeRed.Texto(franja)</strong>@(c.Pendientes > 0 ? $" · {c.Pendientes} por subir" : "")
                @if (franja == AvisosDeRed.Franja.SinRedLocal && Reencuentro is { Resultado: { } resultado })
                {
                    <span class="vn-franja-nota"> · @resultado</span>
                }
            </span>
            <span class="espacio"></span>
            @if (franja == AvisosDeRed.Franja.SinRedLocal && Reencuentro is { Aplica: true } reencuentro)
            {
                @* Ni con el clic se lleva el foco: el lector sigue escribiendo en la venta, y su Enter no vuelve a oprimir el botón. *@
                <button class="vn-boton chico" tabindex="-1" disabled="@reencuentro.Buscando" @onmousedown:preventDefault="true"
                        title="La busca en la red y solo se cambia a ella si prueba, con la llave de esta caja, que es su caja principal."
                        @onclick="VolverABuscarlaAsync">
                    @(reencuentro.Buscando ? "Buscando…" : "Volver a buscarla")
                </button>
            }
        </div>
    }
    else if (franja is AvisosDeRed.Franja.SinInternet or AvisosDeRed.Franja.SinInternetNiRedLocal)
    {
        <div class="vn-franja internet" role="status">
            <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.6 16a5 5 0 0 1 6.8 0" /><circle cx="12" cy="19.3" r=".9" /></svg>
            <span><strong>@AvisosDeRed.Texto(franja)</strong></span>
        </div>
    }
    @if (c.ServidorResponde && franja != AvisosDeRed.Franja.Lenta && c.Pendientes > 0)
    {
        <div class="franja-contingencia subiendo">Volvió la conexión: subiendo @c.Pendientes pendientes…</div>
    }
    @if (c.AvisoBase is { } aviso)
    {
        <div class="franja-contingencia con-error">@aviso</div>
    }
    @if (c.AvisoBaseLocal is { } avisoLocal)
    {
        <div class="franja-contingencia con-error">@avisoLocal</div>
    }
    @if (c.ConError > 0)
    {
        <div class="franja-contingencia con-error">
            @c.ConError @(c.ConError == 1 ? "operación no pudo subir" : "operaciones no pudieron subir"): «@c.UltimoError». Avisa al encargado; se reintenta sola.
        </div>
    }
}

@code {
    private Contingencia? _contingencia;

    private ReencuentroDeLaPrincipal? Reencuentro => _contingencia?.RedDeLaCaja?.Reencuentro;

    protected override void OnInitialized()
    {
        // Solo la ventana de Windows trabaja sin conexión; en el navegador de la caja principal no hay contingencia.
        _contingencia = Servicios.GetService<Contingencia>();
        if (_contingencia is not null)
            _contingencia.Cambio += AlCambiar;
    }

    private void AlCambiar() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// «Volver a buscarla»: la busca en la red al momento; si una prueba que es su caja principal, se cambia a ella y el latido la
    /// usa enseguida. Si no, la franja dice lo que pasó y la caja sigue con su copia.
    /// </summary>
    private async Task VolverABuscarlaAsync()
    {
        if (Reencuentro is not { } reencuentro)
            return;
        var busqueda = reencuentro.BuscarAhoraAsync();
        StateHasChanged();
        try
        {
            if (!await busqueda && _contingencia is { } contingencia)
                // La caja principal pudo volver en la misma dirección: que el latido lo diga sin esperar su turno.
                await contingencia.LatidoAsync();
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // Buscarla es una ayuda: si algo falla, la caja sigue con su copia y la busca sola.
        }
    }

    public void Dispose()
    {
        if (_contingencia is not null)
            _contingencia.Cambio -= AlCambiar;
    }
}
