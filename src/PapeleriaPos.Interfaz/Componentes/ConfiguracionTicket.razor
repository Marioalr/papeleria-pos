@* Personalización del ticket, como en eleventa: encabezado, pie y logotipo, con vista previa e impresión de prueba. *@
@inject ClienteCaja Cliente
@inject IImpresora Impresora

@if (_cargando)
{
    <p>Cargando…</p>
}
else
{
    <div class="configuracion-ticket">
        <div class="config-campos">
            <p class="nota">Lo autoriza el encargado o el dueño.</p>
            <div class="dos-columnas">
                <label>Usuario <input @bind="_usuario" autocomplete="off" /></label>
                <label>PIN <input type="password" inputmode="numeric" maxlength="6" @bind="_pin" /></label>
            </div>

            <label>Encabezado (un renglón por línea; el primero sale grande)
                <textarea rows="5" @bind="_encabezado" @bind:event="oninput"></textarea>
            </label>
            <label>Pie
                <textarea rows="3" @bind="_pie" @bind:event="oninput"></textarea>
            </label>
            @if (RenglonLargo() is { } largo)
            {
                <p class="error">«@largo» tiene más de @DisenoTicket.Columnas caracteres: no cabe en el renglón.</p>
            }

            <div class="logo-config">
                <span>Logotipo</span>
                <label class="boton archivo">
                    Agregar logotipo…
                    <InputFile accept="image/png,image/jpeg,image/bmp" OnChange="CargarLogoAsync" />
                </label>
                <button class="boton" disabled="@(_logo is null || _ocupado)" @onclick="QuitarLogoAsync">Quitar logotipo…</button>
            </div>

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }
            @if (_aviso is not null)
            {
                <p class="aviso">@_aviso</p>
            }
            <div class="acciones">
                <button class="boton" disabled="@_ocupado" @onclick="ImprimirPruebaAsync">Imprimir ticket de prueba</button>
                <button class="boton principal" disabled="@(_ocupado || RenglonLargo() is not null)" @onclick="GuardarTextosAsync">Guardar</button>
            </div>
        </div>

        <div class="config-vista">
            @if (_logoPng is not null)
            {
                <img class="logo-vista" src="data:image/png;base64,@_logoPng" alt="Logotipo como saldrá impreso" />
            }
            <pre class="ticket">@TicketTexto.Generar(Ejemplo() with { Logo = null })</pre>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    private bool _cargando = true;
    private bool _ocupado;
    private string _usuario = "";
    private string _pin = "";
    private string _encabezado = "";
    private string _pie = "";
    private LogoTicketDto? _logo;
    private string? _logoPng;
    private string? _error;
    private string? _aviso;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Cliente.ConfiguracionTicketAsync(Caja.SucursalId) is { } c)
                Mostrar(c);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        _cargando = false;
    }

    private void Mostrar(ConfiguracionTicketDto c)
    {
        _encabezado = string.Join('\n', c.Encabezado);
        _pie = string.Join('\n', c.Pie);
        _logo = c.Logo;
        _logoPng = c.LogoPngBase64;
    }

    private static List<string> Renglones(string texto) =>
        texto.Split('\n').Select(r => r.Trim()).Where(r => r.Length > 0).ToList();

    private string? RenglonLargo() =>
        Renglones(_encabezado).Concat(Renglones(_pie)).FirstOrDefault(r => r.Length > DisenoTicket.Columnas);

    private async Task GuardarTextosAsync() =>
        await EjecutarAsync(async () =>
        {
            Mostrar(await Cliente.GuardarTextosTicketAsync(Caja.SucursalId, new SolicitudTextosTicket(_usuario, _pin, Renglones(_encabezado), Renglones(_pie))));
            _aviso = "Ticket guardado.";
        });

    private async Task CargarLogoAsync(InputFileChangeEventArgs e) =>
        await EjecutarAsync(async () =>
        {
            await using var archivo = e.File.OpenReadStream(maxAllowedSize: LogoTicket.BytesMaximos);
            using var memoria = new MemoryStream();
            await archivo.CopyToAsync(memoria);
            Mostrar(await Cliente.GuardarLogoTicketAsync(Caja.SucursalId, new SolicitudLogo(_usuario, _pin, Convert.ToBase64String(memoria.ToArray()))));
            _aviso = "Logotipo guardado. Así saldrá impreso.";
        });

    private async Task QuitarLogoAsync() =>
        await EjecutarAsync(async () =>
        {
            Mostrar(await Cliente.GuardarLogoTicketAsync(Caja.SucursalId, new SolicitudLogo(_usuario, _pin, null)));
            _aviso = "Logotipo quitado.";
        });

    private async Task ImprimirPruebaAsync() =>
        await EjecutarAsync(async () =>
        {
            await Impresora.ImprimirAsync(Ejemplo(), abrirCajon: false);
            _aviso = Impresora.MuestraVistaPrevia ? "Sin impresora conectada: la vista previa es la de la derecha." : "Ticket de prueba enviado a la impresora.";
        }, pideCredenciales: false);

    private async Task EjecutarAsync(Func<Task> accion, bool pideCredenciales = true)
    {
        _error = null;
        _aviso = null;
        if (pideCredenciales && (_usuario.Trim().Length == 0 || _pin.Length == 0))
        {
            _error = "Escribe el usuario y PIN del encargado.";
            return;
        }
        _ocupado = true;
        try
        {
            await accion();
        }
        catch (Exception ex) when (ex is ErrorCaja or IOException or InvalidOperationException or ArgumentException)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>Un ticket de ejemplo con lo que se está editando, para la vista previa y la prueba.</summary>
    private TicketDto Ejemplo() => new(
        "PRUEBA", DateTime.Now, Caja.Nombre, Sesion.Nombre,
        [
            new LineaTicketDto("2", "Pluma punto fino azul", 1200, 2400),
            new LineaTicketDto("1.5 m", "Listón 2.5 cm rojo", 500, 750),
            new LineaTicketDto("1", "Cuaderno profesional raya 100 hojas", 4500, 4500),
        ],
        4, 7650, 1055, [new CobroTicketDto(FormaPago.Efectivo, 7650, 10000, 2350, null)],
        Renglones(_encabezado), Renglones(_pie), _logo);
}
