@* Productos, inventario y clientes sin vender: el encargado o el dueño entran aquí cuando la caja tiene el turno de otro (o
   ninguno) y no hace falta cortar ni abrir turno para capturar una nota, corregir el catálogo o dar de alta un cliente.
   Arriba va la misma barra que en la venta, como el prototipo («Productos e inventario, sin cortar» abre el inventario con
   la barra de siempre): la caja, las pestañas y el menú del usuario con «Cambiar de usuario» (Ctrl+U) y «Salir». Abajo,
   las mismas páginas que desde la venta (entrega 8: lista y detalle, e Inventario por tareas), con su barra de teclas, sin
   «Volver a la venta»: aquí no hay venta. *@
@implements IAsyncDisposable
@inject ModuloCaja Js
@inject ConexionCaja Conexion
@inject IImpresora Impresora
@inject IServiceProvider Servicios

<div class="venta-nueva sin-vender">
    <Iconos />
    <header class="vn-arriba">
        <div class="vn-marca">
            <span class="vn-logo">P</span>
            <div><strong>@Caja.Nombre</strong><small>@(Conexion.Servicio.IsLoopback ? "principal" : "secundaria") · @Caja.Sucursal</small></div>
        </div>
        <nav class="vn-pestanas">
            <button class="@Activa(Pagina.Productos)" @onclick="() => IrAsync(Pagina.Productos)">Productos <kbd>F3</kbd></button>
            <button class="@Activa(Pagina.Inventario)" @onclick="() => IrAsync(Pagina.Inventario)">Inventario <kbd>F4</kbd></button>
            <button class="@Activa(Pagina.Clientes)" @onclick="() => IrAsync(Pagina.Clientes)">Clientes</button>
            @if (VeConfiguracion)
            {
                <button class="@(_configuracion ? "activa" : "")" @onclick="AbrirConfiguracionAsync">Configuración</button>
            }
        </nav>
        <span class="espacio"></span>
        <div class="vn-usuario-caja">
            <button class="vn-usuario" title="Cambiar de usuario o salir" @onclick="() => _menuUsuario = !_menuUsuario">
                <span class="vn-avatar">@PantallaVenta.Inicial(Sesion.Nombre)</span>
                <span><strong>@Sesion.Nombre</strong><small>sin vender</small></span>
            </button>
            @if (_menuUsuario)
            {
                <div class="vn-fondo-menu" @onclick="() => _menuUsuario = false"></div>
                <div class="vn-menu-usuario">
                    <p>@Sesion.Nombre@(Sesion.Resumen is { } resumen ? $" · {resumen.ToLowerInvariant()}" : "")</p>
                    @* Como en la venta: las dos van a la entrada, y qué pasa al salir lo decide la raíz de la caja. *@
                    <button @onclick="AlSalir">Cambiar de usuario <kbd>Ctrl+U</kbd></button>
                    <button @onclick="AlSalir">Salir</button>
                </div>
            }
        </div>
    </header>
    <div class="vn-pagina">
        @switch (_pagina)
        {
            case Pagina.Productos:
                <Productos @ref="_productos" Caja="Caja" Sesion="Sesion" Acceso="Acceso" Estado="_paginas.Productos" Etiquetas="_paginas.Etiquetas"
                           AlIrAEtiquetas="() => IrAsync(Pagina.Inventario, TareaInventario.Etiquetas)" />
                break;
            case Pagina.Clientes:
                @* Sin turno no hay abonos ni devoluciones: lo único que se imprime aquí es el estado de cuenta. *@
                <Clientes @ref="_clientes" Caja="Caja" Sesion="Sesion" Acceso="Acceso" Estado="_paginas.Clientes" AlImprimirEstado="ImprimirEstadoAsync" />
                break;
            default:
                <Inventario @ref="_inventario" Caja="Caja" Sesion="Sesion" Acceso="Acceso" EtiquetasPorImprimir="_paginas.Etiquetas" TareaInicial="_tareaInicial"
                            AgregarVisto="_paginas.Agregar" />
                break;
        }
    </div>
    <footer class="vn-teclas">
        <button @onclick="AlSalir"><kbd>Ctrl+U</kbd>Cambiar de usuario</button>
        @if (_pagina != Pagina.Inventario)
        {
            <span class="vn-ayuda-tecla"><kbd>↑</kbd> <kbd>↓</kbd> elegir</span>
            <span class="vn-ayuda-tecla"><kbd>Enter</kbd> abrir</span>
        }
        <span class="vn-ayuda-tecla"><kbd>Esc</kbd> cierra lo abierto</span>
        @if (_errorImpresion is not null)
        {
            <span class="vn-ayuda-tecla error">@_errorImpresion</span>
        }
        @* Lo que no salió de la impresora de tickets (entrega 5, parte 3), con «Reintentar» y «No imprimirlo». *@
        <AvisoImpresion EnLinea />
    </footer>
</div>
@* Con los campos, sin una variable local: si el contenido de la ventana tomara una, cada vuelta del dibujo le daría un
   manejador nuevo a los botones de arriba (el menú del usuario). *@
@if (_vistaPrevia is not null)
{
    <Ventana Titulo="@_tituloVistaPrevia" AlCerrar="CerrarVistaPreviaAsync">
        <pre class="ticket">@_vistaPrevia</pre>
        <p class="nota">Sin impresora conectada: así saldrá impreso en la de 80 mm.</p>
    </Ventana>
}
@* La Configuración, igual que desde la venta (entrega 7): el margen y la cobertura del sugerido viven ahí, y sin cortar
   también se cambian. *@
@if (_configuracion)
{
    <Ventana Titulo="Configuración" Clase="cfg" AlCerrar="CerrarConfiguracionAsync">
        <Configuracion Caja="Caja" Sesion="Sesion" AlNoGuardar="m => _errorImpresion = m" />
    </Ventana>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter] public EventCallback AlSalir { get; set; }

    /// <summary>Como el prototipo («Productos e inventario, sin cortar»): empieza en el inventario.</summary>
    private Pagina _pagina = Pagina.Inventario;

    private readonly EstadoDePaginas _paginas = new();
    private TareaInventario? _tareaInicial;
    private Productos? _productos;
    private Inventario? _inventario;
    private Clientes? _clientes;

    private IPagina? PaginaAbierta => _pagina switch
    {
        Pagina.Productos => _productos,
        Pagina.Clientes => _clientes,
        _ => _inventario,
    };

    /// <summary>Lo que puede quien entró, con los permisos de su sesión.</summary>
    private PermisosDePagina Acceso => new(Sesion, null);

    /// <summary>La Configuración abierta encima, como desde la venta.</summary>
    private bool _configuracion;

    /// <summary>Si quien entró ve algún grupo de la Configuración (con su permiso en «Puede»), como en la venta.</summary>
    private bool VeConfiguracion =>
        Configuracion.HayQueVer(accion => Sesion.Puede(accion), Servicios.GetService<GitHubPrueba>() is not null);

    private async Task AbrirConfiguracionAsync()
    {
        (_configuracion, _menuUsuario, _vistaPrevia, _errorImpresion) = (true, false, null, null);
        await AvisarTeclasAsync();
    }

    private async Task CerrarConfiguracionAsync()
    {
        _configuracion = false;
        await AvisarTeclasAsync();
        if (PaginaAbierta is { } pagina)
            await pagina.EnfocarAsync();
    }

    private bool _menuUsuario;
    /// <summary>El estado de cuenta en pantalla, sin impresora (el texto); null si no se ve.</summary>
    private string? _vistaPrevia;
    private string _tituloVistaPrevia = "";
    private string? _errorImpresion;
    private DotNetObjectReference<Administracion>? _referencia;

    private string Activa(Pagina pagina) => _pagina == pagina && !_configuracion ? "activa" : "";

    private async Task IrAsync(Pagina pagina, TareaInventario? tarea = null)
    {
        if (pagina == _pagina && pagina == Pagina.Inventario && tarea is { } abrir && _inventario is { } inventario)
            await inventario.AbrirAsync(abrir);
        else if (pagina == _pagina && PaginaAbierta is { } abierta)
            await abierta.EnfocarAsync();
        (_pagina, _tareaInicial) = (pagina, tarea);
        _menuUsuario = false;
        (_vistaPrevia, _errorImpresion) = (null, null);
        await AvisarTeclasAsync();
    }

    /// <summary>
    /// «Imprimir» en el estado de cuenta de un cliente, como en la venta: en la impresora de tickets o, sin ella, en
    /// pantalla. Antes aquí no hacía nada, y el dueño revisa los créditos sin cortar (la guía de la prueba lo pide así).
    /// Solo el papel: no entra ni sale dinero, el cajón no se abre.
    /// </summary>
    private async Task ImprimirEstadoAsync(EstadoCuentaDto estado)
    {
        var titulo = $"Estado de cuenta de {estado.Cliente}";
        var documento = DisenoComprobante.EstadoCuenta(estado);
        _errorImpresion = null;
        var cola = ColaDeImpresion.De(Impresora);
        if (cola.MuestraVistaPrevia)
        {
            (_tituloVistaPrevia, _vistaPrevia) = (titulo, TicketTexto.Generar(documento));
            await AvisarTeclasAsync();
            return;
        }
        // A la cola de la impresora, como en la venta (entrega 5, parte 3): si no sale, lo dice la barra de abajo.
        cola.Encolar(titulo, documento, abrirCajon: false);
    }

    private async Task CerrarVistaPreviaAsync()
    {
        _vistaPrevia = null;
        await AvisarTeclasAsync();
    }

    /// <summary>
    /// Para caja.js es una página (entrega 8): las flechas, Enter y lo que se escribe son de ella (lo que se escribe fuera de
    /// un campo va a su búsqueda), y Esc, las F y las Ctrl de la caja llegan aquí (F5 no recarga ni Ctrl+P imprime). Con la
    /// vista previa o la Configuración encima, es una ventana, como en la venta.
    /// </summary>
    private async Task AvisarTeclasAsync()
    {
        await Js.VentanaAbiertaAsync(_vistaPrevia is not null || _configuracion);
        await Js.PaginaAbiertaAsync(true);
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!primera)
            return;
        _referencia = DotNetObjectReference.Create(this);
        await Js.RegistrarTeclasAsync(_referencia);
        await AvisarTeclasAsync();
    }

    /// <summary>
    /// Una tecla que atrapó caja.js: F3 y F4 cambian de página y Ctrl+U cambia de usuario, como en la venta. Esc cierra la
    /// vista previa del estado de cuenta o la Configuración (que guarda lo escrito al cerrarse) y, sin ellas, lo que esté
    /// abierto en la página (la ficha, una tarea, el estado de cuenta); sin nada abierto no hace nada: aquí no hay venta a
    /// donde regresar. Con la guía de la prueba encima, Esc no toca lo de abajo. Las demás no hacen nada aquí.
    /// </summary>
    [JSInvokable]
    public async Task Tecla(string tecla, string? texto)
    {
        switch (tecla)
        {
            case "Escape" when Js.FranjaEncima: return;
            case "Escape" when _vistaPrevia is not null: await CerrarVistaPreviaAsync(); break;
            case "Escape" when _configuracion: await CerrarConfiguracionAsync(); break;
            case "Escape":
                if (PaginaAbierta is { } pagina)
                    await pagina.CerrarAsync();
                break;
            case "F3" when !_configuracion: await IrAsync(Pagina.Productos); break;
            case "F4" when !_configuracion: await IrAsync(Pagina.Inventario); break;
            case "Ctrl+U":
                _menuUsuario = false;
                await AlSalir.InvokeAsync();
                return;
            default: return;
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // caja.js no olvida sola la «ventana»: si se quedara, en la venta del que entra después el cuadro de captura no
            // tomaría los escaneos (lo mismo cuida la pantalla de venta al irse con una ventana abierta). La página la olvida
            // al quitar las teclas.
            await Js.VentanaAbiertaAsync(false);
            await Js.QuitarTeclasAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // El navegador ya se cerró, o la página ya no tiene caja.js (se está volviendo a cargar).
        }
        _referencia?.Dispose();
    }
}
