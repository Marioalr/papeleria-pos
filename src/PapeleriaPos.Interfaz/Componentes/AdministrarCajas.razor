@* Configuración › Cajas: las cajas de la sucursal y qué PC usa cada una. Quien entró con «Dar de alta y quitar cajas» quita
   una PC (robada, reemplazada o que ya no se usa) sin volver a escribir su PIN; como ya no lo pide, el botón primero
   pregunta, ahí mismo. *@
@inject ClienteCaja Cliente

@if (_cajas is null)
{
    <p class="@(_error is null ? "vn-cfg-nota" : "vn-cfg-error")">@(_error ?? "Cargando…")</p>
}
else
{
    <p class="vn-cfg-nota">
        Para agregar una caja, abre el POS en la PC nueva: pide el usuario y el PIN de quien tiene «Dar de alta y quitar cajas» y se
        da de alta sola.
    </p>
    <table class="vn-cfg-tabla">
        <thead><tr><th>Caja</th><th>Serie de folios</th><th>PC</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in _cajas)
            {
                var caja = c;
                <tr>
                    <td><strong>@c.Nombre</strong>@(c.Id == Caja.Id ? " · esta" : "")</td>
                    <td>@c.Serie</td>
                    <td>@(c.Equipo ?? "—")</td>
                    <td class="num">
                        @if (c.Equipo is not null && Puede)
                        {
                            @if (_porQuitar == c.Id)
                            {
                                <span class="vn-cfg-pregunta">
                                    @(c.Id == Caja.Id ? "Esta PC deja de vender" : $"«{c.Equipo}» deja de vender") hasta darla de alta otra vez.
                                    <button class="vn-boton chico peligro" disabled="@_ocupado" @onclick="() => QuitarAsync(caja)">Quitar la PC</button>
                                    <button class="vn-boton chico" disabled="@_ocupado" @onclick="() => _porQuitar = null">No</button>
                                </span>
                            }
                            else
                            {
                                <button class="vn-boton chico" disabled="@_ocupado" @onclick="() => Preguntar(caja)">Quitar PC</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_error is not null)
    {
        <p class="vn-cfg-error" role="alert">@_error</p>
    }
    @if (_aviso is not null)
    {
        <p class="vn-cfg-aviso" role="status">@_aviso</p>
    }
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;

    /// <summary>Quien entró: el servicio revisa con su «Dar de alta y quitar cajas».</summary>
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Se quitó una PC: la Configuración dice a qué hora.</summary>
    [Parameter] public EventCallback AlGuardar { get; set; }

    private List<CajaDto>? _cajas;

    /// <summary>La caja cuya PC se va a quitar, mientras se pregunta.</summary>
    private Guid? _porQuitar;

    private string? _error;
    private string? _aviso;
    private bool _ocupado;

    private bool Puede => Sesion.Puede(AccionControlada.AdministrarCajas);

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _cajas = (await Cliente.CajasAsync()).Where(c => c.SucursalId == Caja.SucursalId).ToList();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private void Preguntar(CajaDto caja) => (_porQuitar, _error, _aviso) = (caja.Id, null, null);

    private async Task QuitarAsync(CajaDto caja)
    {
        (_error, _aviso, _ocupado) = (null, null, true);
        try
        {
            await Cliente.QuitarEquipoAsync(caja.Id, new SolicitudQuitarEquipo(Sesion.UsuarioId));
            _aviso = $"«{caja.Equipo}» ya no puede usar {caja.Nombre}. Para volver a usarla, se da de alta otra vez.";
            _porQuitar = null;
            await CargarAsync();
            await AlGuardar.InvokeAsync();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
