@* Ventana sobre la pantalla de venta. Escape la cierra (lo atrapa la pantalla de venta). Lo de la venta va como panel a
   la derecha, sin tapar el ticket (docs/propuesta-interfaz.md, «Los demás paneles»); los módulos de arriba, encima. *@
@if (EnPanel)
{
    <section class="vn-panel @Clase" role="dialog" aria-label="@Titulo">
        <div class="vn-panel-cab">
            <h2>@Titulo</h2>
            <button class="vn-panel-x" title="Cerrar (Esc)" @onclick="AlCerrar"><Ico Nombre="cerrar" /><kbd>Esc</kbd></button>
        </div>
        <div class="vn-panel-cuerpo">
            @ChildContent
        </div>
    </section>
}
else
{
    <div class="fondo-ventana">
        <div class="ventana @Clase">
            <div class="ventana-titulo">
                <span>@Titulo</span>
                <button class="cerrar" title="Cerrar (Esc)" @onclick="AlCerrar">×</button>
            </div>
            <div class="ventana-cuerpo">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Clase { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback AlCerrar { get; set; }

    /// <summary>La pone la pantalla de venta: el contenido va en el panel de la derecha, no encima del ticket.</summary>
    [CascadingParameter(Name = "VentanaEnPanel")] public bool EnPanel { get; set; }
}
