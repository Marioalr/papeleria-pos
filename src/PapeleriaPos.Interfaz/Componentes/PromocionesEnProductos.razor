                    <span class="vn-precios-cuanto">
                        <input id="promo-porcentaje" aria-label="Porcentaje" inputmode="decimal" autocomplete="off" value="@_porcentaje"
                               @oninput="e => _porcentaje = e.Value?.ToString() ?? string.Empty" @onkeydown="AlTeclearAsync" />
