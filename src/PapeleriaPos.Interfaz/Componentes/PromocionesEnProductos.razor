    private async Task TipoElegidoAsync(ChangeEventArgs e)
    {
        var marcaba = MarcaProductos;
        if (Enum.TryParse<TipoPromocion>(e.Value?.ToString(), out var tipo))
            _tipo = tipo;
        _vista = null;
        if (marcaba != MarcaProductos)
            await AlCambiarModo.InvokeAsync();
        if (MarcaProductos)
            await RenglonesAlDiaAsync();
    }

    private async Task AQueElegidoAsync(AQue aQue)
    {
        var marcaba = MarcaProductos;
        (_aQue, _vista) = (aQue, null);
        if (marcaba != MarcaProductos)
            await AlCambiarModo.InvokeAsync();
        if (MarcaProductos)
            await RenglonesAlDiaAsync();
    }

    private void DesdeElegido(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var desde))
            _desde = desde;
        _vista = null;
    }

    private void HastaElegido(ChangeEventArgs e)
    {
        _hasta = DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var hasta) ? hasta : null;
        _vista = null;
    }

    private void DiaElegido(DiasDeLaSemana dia, bool marcado)
    {
        _dias = marcado ? _dias | dia : _dias & ~dia;
        _vista = null;
    }

    /// <summary>Enter: cómo queda; Ctrl+Enter: guardarla.</summary>
    private async Task AlTeclearAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _ocupado)
            return;
        if (e.CtrlKey)
            await GuardarAsync(null);
        else
            await VerAsync();
    }

    /// <summary>Lo que se manda: lo escrito, revisado; vacío (con el error) si falta algo que se ve aquí.</summary>
    private SolicitudPromocion? Solicitud(Guid? autorizacion)
    {
        _error = null;
        int lleva = 0, paga = 0, centesimas = 0;
        if (_tipo == TipoPromocion.LlevaNPagaM)
        {
            if (Formato.LeerEntero(_lleva) is not { } llevaN || Formato.LeerEntero(_paga) is not { } pagaN
                || llevaN is < int.MinValue or > int.MaxValue || pagaN is < int.MinValue or > int.MaxValue)
            {
                _error = Formato.ComaDeDecimales(_lleva) ?? Formato.ComaDeDecimales(_paga) ?? "Escribe cuántas lleva y cuántas paga (como 3 y 2).";
                return null;
            }
            (lleva, paga) = ((int)llevaN, (int)pagaN);
        }
        if (_tipo == TipoPromocion.Porcentaje)
        {
            // Con la regla de los números del POS: «7,5» no se adivina (antes de la revisión del PR #133 eran 75 %).
            var texto = _porcentaje.Replace("%", "").Trim();
            if (Formato.LeerCantidad(texto) is not { } porcentaje)
            {
                _error = Formato.ComaDeDecimales(texto) ?? "Escribe el porcentaje (como 10).";
                return null;
            }
            centesimas = (int)Math.Round(porcentaje * 100, MidpointRounding.AwayFromZero);
        }
        List<AlcanceSolicitadoDto> alcance = [];
        if (_tipo == TipoPromocion.PrecioEspecial || _aQue == AQue.Productos)
        {
            foreach (var r in _renglones)
            {
                long? precio = null;
                if (_tipo == TipoPromocion.PrecioEspecial && (precio = Formato.LeerPesos(_precios.GetValueOrDefault(r.VarianteId))) is not > 0)
                {
                    _error = Formato.ComaDeCentavos(_precios.GetValueOrDefault(r.VarianteId)) is { } coma ? $"«{r.Producto}»: {coma}"
                        : $"Escribe el precio especial de «{r.Producto}».";
                    return null;
                }
                alcance.Add(new AlcanceSolicitadoDto(VarianteId: r.VarianteId, PrecioCentavos: precio));
            }
        }
        else if (_aQue == AQue.Departamento && _departamento is { } departamento)
            alcance.Add(new AlcanceSolicitadoDto(DepartamentoId: departamento));
        else if (_aQue == AQue.Marca && _marca.Trim().Length > 0)
            alcance.Add(new AlcanceSolicitadoDto(Marca: _marca));
        return new SolicitudPromocion(Sesion.UsuarioId, Caja.SucursalId, Caja.Id, _nombre, _tipo, lleva, paga, centesimas, _desde, _hasta, _dias,
            _soloEstaSucursal, alcance, autorizacion, _id);
    }

    private async Task VerAsync()
    {
        if (Solicitud(null) is not { } solicitud)
            return;
        _ocupado = true;
        try
        {
            _vista = await Cliente.VistaPromocionAsync(solicitud);
            _vistaQueHace = Promocion.TipoTexto(solicitud.Tipo, solicitud.Lleva, solicitud.Paga, solicitud.Centesimas);
        }
        catch (ErrorCaja ex)
        {
            (_vista, _error) = (null, ex.Message);
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>
    /// Guardarla. Antes se ve cómo queda: si algo queda debajo del costo, como en Ctrl+D, quien tiene «Vender debajo del costo»
    /// la ve con los que quedan debajo y la guarda otra vez para dejarla así; si lo puede pedir, se pide la autorización (que
    /// dice cuáles); si no, no se puede. El servicio lo vuelve a revisar al guardar.
    /// </summary>
    private async Task GuardarAsync(Guid? autorizacion)
    {
        if (Solicitud(autorizacion) is not { } solicitud)
            return;
        _ocupado = true;
        try
        {
            if (autorizacion is null)
            {
                var vista = _vista = await Cliente.VistaPromocionAsync(solicitud);
                _vistaQueHace = Promocion.TipoTexto(solicitud.Tipo, solicitud.Lleva, solicitud.Paga, solicitud.Centesimas);
                if (vista.BajoCosto.Lineas.Count > 0)
                {
                    long? falta = vista.VeCostos ? vista.BajoCosto.FaltanteCentavos : null;
                    var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.VenderBajoCosto, falta));
                    switch (decision.Nivel)
                    {
                        case NivelPermiso.Permitido when Firma(solicitud) is var firma && firma != _confirmadaBajoCosto:
                            // Primero ve cuáles quedan debajo («Cómo queda»); guardarla otra vez así, la guarda.
                            _confirmadaBajoCosto = firma;
                            _aviso = "Con esta promoción quedan productos debajo del costo (abajo, en «Cómo queda»). Si así va, guárdala otra vez "
                                     + "(Ctrl+Enter): la llevan aunque queden debajo.";
                            return;
                        case NivelPermiso.Permitido:
                            break;
                        case NivelPermiso.RequiereAutorizacion:
                            _autorizar = new Pendiente($"La promoción «{_nombre.Trim()}» deja debajo del costo: {string.Join(", ", vista.BajoCosto.Lineas.Take(10))}"
                                + (vista.BajoCosto.Lineas.Count > 10 ? $" y {vista.BajoCosto.Lineas.Count - 10} más" : ""), falta);
                            return;
                        default:
                            _error = "Con esta promoción quedan productos debajo del costo y no tienes permiso para eso.";
                            return;
                    }
                }
            }
            var ficha = await Cliente.GuardarPromocionAsync(solicitud);
            (_ficha, _aviso) = (ficha, $"Listo: se guardó la promoción «{ficha.Nombre}». Las cajas la aplican con su copia, también sin conexión.");
            _renglones.Clear();
            _deLosRenglones.Clear();
            await CambiarModoAsync(Modo.Detalle);
            await QuitarMarcasAsync();
            await CargarListaAsync();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task AutorizadoAsync(Guid autorizacionId)
    {
        _autorizar = null;
        await GuardarAsync(autorizacionId);
    }

    /// <summary>La que se arma, como texto que se compara: si cambió algo desde que se enseñó lo que queda debajo del costo.</summary>
    private static string Firma(SolicitudPromocion solicitud) => System.Text.Json.JsonSerializer.Serialize(solicitud with { AutorizacionBajoCostoId = null });
}
