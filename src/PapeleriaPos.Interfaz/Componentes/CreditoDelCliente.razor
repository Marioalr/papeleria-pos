@* La cuenta de un cliente, en su detalle de la página de Clientes (fase 3, entrega 2; con lista y detalle, entrega 8): lo
   que debe y su vencimiento, su límite y quién lo cambia, junto con los datos que pone la página, y sus últimos
   movimientos. «Límite y plazo» y «Ajustar el saldo» los hace quien tiene su permiso (al empezar, el dueño). Con un turno
   abierto, desde aquí se le recibe un abono o se le devuelve en efectivo lo que tiene a favor (en el piloto con eleventa,
   ninguno de los dos). Su estado de cuenta se imprime o se copia para mandarlo por WhatsApp (parte 3). Esc cierra lo que
   esté abierto (Cerrar). *@
@using PapeleriaPos.Nucleo.Clientes
@inject ClienteCaja Servicio
@inject ModuloCaja Js

@if (_autorizar && _cuenta is not null && Turno is not null)
{
    <AutorizarAccion Accion="AccionControlada.DevolverSaldoAFavor" Detalle="@($"Devolverle a «{Cliente.Nombre}» {Formato.Dinero(AEntregar ?? 0)} en efectivo de su saldo a favor")"
                     MontoCentavos="AEntregar" Caja="Caja" Sesion="Sesion" AlAutorizar="a => DevolverAsync(a.Id)"
                     AlCancelar="() => _autorizar = false" />
}
else if (_estado is { } estado)
{
    <h3>Estado de cuenta</h3>
    <div class="filtros-catalogo">
        <label class="en-linea">Desde <input type="date" @bind="_desdeEstado" @bind:after="EstadoAsync" /></label>
        <button class="boton" disabled="@_ocupado" @onclick="ImprimirEstadoAsync">Imprimir</button>
        <button class="boton" disabled="@_ocupado" @onclick="CopiarEstadoAsync">Copiar para WhatsApp</button>
        <button class="boton" @onclick="VolverACuenta">Volver a su cuenta</button>
    </div>
    @if (Cliente.Telefono is { Length: > 0 } telefono)
    {
        <p class="nota">Su teléfono: @ElegirCliente.Telefono(telefono)</p>
    }
    <p class="nota">
        Saldo antes del @estado.Desde.ToString("dd/MM/yyyy"): <strong>@Saldo(estado.SaldoAnteriorCentavos)</strong>
        · ahora: <strong>@Saldo(estado.SaldoCentavos)</strong>
        @if (estado.VencidoCentavos > 0)
        {
            <span class="error"> · vencido @Formato.Dinero(estado.VencidoCentavos)</span>
        }
    </p>
    @if (estado.Movimientos.Count == 0)
    {
        <p class="vacia">Sin movimientos desde esa fecha.</p>
    }
    else
    {
        <div class="resultados movimientos-credito">
            <table>
                <thead><tr><th>Fecha</th><th>Concepto</th><th>Folio</th><th class="num">Monto</th><th class="num">Saldo</th></tr></thead>
                @foreach (var m in estado.Movimientos)
                {
                    <tr>
                        <td>@m.FechaLocal.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@m.Concepto</td>
                        <td>@m.Folio</td>
                        <td class="num">@(m.MontoCentavos > 0 ? "+" : "−")@Formato.Dinero(Math.Abs(m.MontoCentavos))</td>
                        <td class="num">@Formato.Dinero(m.SaldoCentavos)</td>
                    </tr>
                }
            </table>
        </div>
    }
    @if (estado.Pendientes.Count > 0)
    {
        <h4>Lo que falta pagar</h4>
        <div class="resultados">
            <table>
                <thead><tr><th>Fecha</th><th>Concepto</th><th>Folio</th><th class="num">Falta</th><th>Vence</th></tr></thead>
                @foreach (var p in estado.Pendientes)
                {
                    <tr>
                        <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@p.Concepto</td>
                        <td>@p.Folio</td>
                        <td class="num">@Formato.Dinero(p.PendienteCentavos)@(p.PendienteCentavos < p.MontoCentavos ? $" de {Formato.Dinero(p.MontoCentavos)}" : "")</td>
                        <td class="@(p.Vence < Hoy ? "error" : "")">@p.Vence.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </table>
        </div>
    }
    @if (_aviso is not null)
    {
        <p class="aviso">@_aviso</p>
    }
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
}
else if (_abonando && Turno is not null)
{
    <Abonar Caja="Caja" Sesion="Sesion" Turno="Turno" ClienteInicial="Cliente" AlTerminar="AbonadoAsync" AlReimprimir="AlReimprimir" />
    <div class="acciones izquierda">
        <button class="boton" @onclick="() => _abonando = false">Volver a su cuenta</button>
    </div>
}
else
{
    var credito = _cuenta?.Credito;
    <div class="vn-rejilla">
        @Datos
        <div class="vn-dato">
            <span>Debe</span>
            @if (credito is null)
            {
                <strong>—</strong>
                <small>@(_error ?? "Cargando…")</small>
            }
            else if (credito.SaldoCentavos > 0)
            {
                var vencido = credito.Vencido(Hoy);
                <strong class="@(vencido > 0 ? "bajo" : "")">@Formato.Dinero(credito.SaldoCentavos)</strong>
                <small class="@(vencido > 0 ? "rojo" : "")">
                    @if (credito.VenceMasAntiguo is { } vence)
                    {
                        @($"lo más antiguo {(vence < Hoy ? "venció" : "vence")} el {vence:dd/MM/yyyy}")
                    }
                    @if (vencido > 0)
                    {
                        @($" · vencido {Formato.Dinero(vencido)}")
                    }
                </small>
            }
            else if (credito.SaldoCentavos < 0)
            {
                <strong>@Formato.Dinero(0)</strong>
                <small class="verde">tiene @Formato.Dinero(credito.AFavorCentavos) a favor</small>
            }
            else
            {
                <strong>@Formato.Dinero(0)</strong>
                <small>al corriente</small>
            }
        </div>
        <div class="vn-dato">
            <span>Límite de crédito</span>
            @if (credito is { LimiteCentavos: > 0 })
            {
                <strong>@Formato.Dinero(credito.LimiteCentavos)</strong>
                <small>a @credito.PlazoDias días · le quedan @Formato.Dinero(credito.DisponibleCentavos) · @QuienCambiaElCredito</small>
            }
            else
            {
                <strong>Sin crédito</strong>
                <small>@(_puedeDar ? "puedes darle crédito" : QuienPuede("lo da"))</small>
            }
        </div>
        @MasDatos
    </div>
    @if (credito is not null)
    {
        <div class="vn-botonera">
            <button class="vn-boton" disabled="@_ocupado" @onclick="EstadoAsync">Estado de cuenta</button>
            @if (_puedeDar)
            {
                <button class="vn-boton @(_condiciones ? "on" : "")" @onclick="() => _condiciones = !_condiciones">Límite y plazo</button>
            }
            @if (Turno is not null && credito.SaldoCentavos > 0 && !PilotoEleventa)
            {
                <button class="vn-boton primario" @onclick="() => _abonando = true">Recibir abono</button>
            }
            @if (Turno is not null && credito.DevolvibleCentavos > 0 && !_devolviendo && _sinConfirmar is null && !PilotoEleventa && PuedeDevolver)
            {
                <button class="vn-boton" title="@(QuienAutorizaDevolver is { } quien ? $"Lo autoriza {quien}" : null)" @onclick="EmpezarDevolucion">
                    Devolver saldo a favor
                    @if (QuienAutorizaDevolver is { } autoriza)
                    {
                        <small class="vn-candado"><Ico Nombre="candado" />@autoriza</small>
                    }
                </button>
            }
            @if (_puedeAjustar)
            {
                <button class="vn-boton @(_ajustando ? "on" : "")" @onclick="() => _ajustando = !_ajustando">Ajustar el saldo</button>
            }
        </div>
        @if (PilotoEleventa && credito.SaldoCentavos > 0)
        {
            <p class="nota">@PilotoConEleventa.NoSeAbona</p>
        }
        else if (PilotoEleventa && credito.DevolvibleCentavos > 0)
        {
            <p class="nota">@PilotoConEleventa.NoSeDevuelveSaldo</p>
        }
        @if (credito.PorVerificarCentavos > 0)
        {
            <p class="nota">@Formato.Dinero(credito.PorVerificarCentavos) en transferencias por verificar.</p>
        }
        @if (credito.AFavorCentavos > 0 && credito.DevolvibleCentavos == 0)
        {
            <p class="nota">Su saldo a favor viene de transferencias por verificar: se le puede devolver cuando se verifiquen.</p>
        }

        @if (Turno is not null && _sinConfirmar is { } pendiente)
        {
            <fieldset class="cobrar-credito">
                <legend>Devolver saldo a favor (en efectivo)</legend>
                <p class="aviso">
                    Se perdió la conexión al devolverle @Formato.Dinero(pendiente.Solicitud.MontoCentavos ?? 0) y no se sabe si quedó. No entregues el
                    efectivo todavía: cuando vuelva la conexión, oprime «Devolver» (si ya quedó, sale el mismo comprobante).
                </p>
                <div class="acciones izquierda">
                    <button class="boton principal" disabled="@_ocupado" @onclick="() => DevolverAsync(null)">Devolver</button>
                </div>
            </fieldset>
        }
        else if (_devolviendo && Turno is not null && credito.DevolvibleCentavos > 0)
        {
            <fieldset class="cobrar-credito">
                <legend>Devolver saldo a favor (en efectivo)</legend>
                @if (credito.PorVerificarCentavos > 0)
                {
                    <p class="nota">No incluye @Formato.Dinero(Math.Min(credito.AFavorCentavos, credito.PorVerificarCentavos)) de transferencias por verificar.</p>
                }
                <label>Cuánto (vacío: todo)
                    <input id="devolver-monto" inputmode="decimal" @bind="_devolver" @bind:event="oninput" autocomplete="off"
                           placeholder="@($"Todo: {Formato.Dinero(Redondeo.AlPeso(credito.DevolvibleCentavos))}")" />
                </label>
                @if (Devolucion is { } devolucion)
                {
                    <p class="cobrar-resumen">
                        Se le entregan <strong>@Formato.Dinero(devolucion.EntregaCentavos)</strong> en efectivo
                        · @(credito.AFavorCentavos - devolucion.MontoCentavos is > 0 and var queda ? $"le quedan {Formato.Dinero(queda)} a favor" : "queda al corriente")
                    </p>
                }
                else if (_problema is not null)
                {
                    <p class="aviso">@_problema</p>
                }
                <div class="acciones izquierda">
                    <button class="boton principal" disabled="@(_ocupado || Devolucion is null)" @onclick="() => DevolverAsync(null)">Devolver</button>
                    <button class="boton" @onclick="CancelarDevolucion">Cancelar</button>
                </div>
            </fieldset>
        }

        @if (_puedeDar && _condiciones)
        {
            <fieldset class="cobrar-credito">
                <legend>Límite y plazo</legend>
                <div class="dos-columnas">
                    <label>Límite de crédito (0: sin crédito) <input id="credito-limite" inputmode="decimal" @bind="_limite" autocomplete="off" /></label>
                    <label>Plazo (días) <input inputmode="numeric" @bind="_plazo" autocomplete="off" /></label>
                </div>
                <p class="nota">El plazo nuevo cuenta para lo que se fíe desde hoy; lo ya fiado vence cuando decía.</p>
                <div class="acciones izquierda">
                    <button class="boton principal" disabled="@_ocupado" @onclick="GuardarCondicionesAsync">Guardar límite y plazo</button>
                    <button class="boton" @onclick="() => _condiciones = false">Cancelar</button>
                </div>
            </fieldset>
        }

        @if (_puedeAjustar && _ajustando)
        {
            <fieldset class="cobrar-credito">
                <legend>Ajustar el saldo</legend>
                <div class="dos-columnas">
                    <label>
                        <select @bind="_sentido">
                            <option value="@DebeMas">Debe más</option>
                            <option value="@DebeMenos">Debe menos</option>
                        </select>
                    </label>
                    <label>Cuánto <input inputmode="decimal" @bind="_ajuste" autocomplete="off" placeholder="$0.00" /></label>
                    <label class="ancho">Motivo <input @bind="_motivo" maxlength="200" autocomplete="off" placeholder="Saldo inicial de la libreta, corrección…" /></label>
                    <label>Desde (lo que ya debía) <input type="date" @bind="_desde" /></label>
                </div>
                <p class="nota">Para pasar la libreta: «Debe más» con la fecha de lo que ya debía (desde ahí cuenta su plazo). No mueve dinero de la caja.</p>
                <div class="acciones izquierda">
                    <button class="boton principal" disabled="@_ocupado" @onclick="AjustarAsync">Ajustar</button>
                    <button class="boton" @onclick="() => _ajustando = false">Cancelar</button>
                </div>
            </fieldset>
        }

        @if (_aviso is not null)
        {
            <p class="aviso">@_aviso</p>
        }
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        <h3 class="vn-sub-titulo">Movimientos de la cuenta</h3>
        @if (_cuenta!.Movimientos.Count == 0)
        {
            <p class="nota">Todavía no tiene movimientos: no se le ha fiado ni ha abonado.</p>
        }
        else
        {
            <table class="vn-tabla">
                <thead><tr><th>Fecha</th><th>Concepto</th><th>Folio</th><th class="num">Monto</th><th class="num">Saldo</th><th>Vence</th></tr></thead>
                <tbody>
                    @foreach (var m in _cuenta.Movimientos)
                    {
                        <tr>
                            <td>@m.FechaLocal.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@m.Concepto@(m.EnContingencia ? " (sin conexión)" : "")</td>
                            <td>@m.Folio</td>
                            <td class="num">@(m.MontoCentavos > 0 ? "+" : "−")@Formato.Dinero(Math.Abs(m.MontoCentavos))</td>
                            <td class="num">@Formato.Dinero(m.SaldoCentavos)</td>
                            <td>@m.Vence?.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="nota">Los últimos movimientos, del más reciente al más viejo.</p>
        }
    }
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public ClienteRegistradoDto Cliente { get; set; } = null!;

    /// <summary>El turno abierto de la caja: sin él no se reciben abonos.</summary>
    [Parameter] public TurnoDto? Turno { get; set; }

    /// <summary>El piloto con eleventa: ni abonos ni devolver el saldo a favor (se quita al dejar eleventa).</summary>
    [CascadingParameter(Name = PilotoConEleventa.Cascada)] public bool PilotoEleventa { get; set; }

    /// <summary>
    /// Lo que puede quien entró; lo pasa la pantalla de venta. Con ellos, «Devolver saldo a favor» va como lo demás de la
    /// venta (docs/propuesta-interfaz.md, «Usuarios y permisos»): con candado y quién lo autoriza si lo autoriza otro (al
    /// cajero, de entrada, el encargado), y no aparece si no puede. Sin ellos (sin conexión ni copia de los permisos, o en
    /// Administración, donde no hay turno ni se devuelve), como siempre: el servicio decide al intentarlo.
    /// </summary>
    [CascadingParameter(Name = "PermisosDeSesion")] public IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? PermisosDeSesion { get; set; }

    private bool PuedeDevolver => PuedeDevolverConPermisos(PermisosDeSesion);

    private string? QuienAutorizaDevolver => QuienAutorizaDevolverConPermisos(PermisosDeSesion);

    /// <summary>Si sale «Devolver saldo a favor»: sin permisos sale siempre (el servicio decide). Pública para las pruebas.</summary>
    public static bool PuedeDevolverConPermisos(IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? permisos) =>
        permisos?.GetValueOrDefault(AccionControlada.DevolverSaldoAFavor)?.Nivel != NivelPermiso.NoPermitido;

    /// <summary>Quién lo autoriza («Encargado de prueba o Dueño de prueba»), si lo autoriza otro; si no, null.</summary>
    public static string? QuienAutorizaDevolverConPermisos(IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? permisos) =>
        permisos?.GetValueOrDefault(AccionControlada.DevolverSaldoAFavor) is { Nivel: NivelPermiso.RequiereAutorizacion } p ? Textos.Quien(p.Autorizan) : null;

    /// <summary>Los datos del cliente que van antes de los de su cuenta, en la misma rejilla (el mayoreo y el descuento).</summary>
    [Parameter] public RenderFragment? Datos { get; set; }

    /// <summary>Los que van después (cuánto compra, si paga a tiempo).</summary>
    [Parameter] public RenderFragment? MasDatos { get; set; }

    /// <summary>Cambiaron sus condiciones: el cliente como quedó (quien lo muestra lo pone al día).</summary>
    [Parameter] public EventCallback<ClienteRegistradoDto> AlCambiar { get; set; }

    /// <summary>Se recibió (o se canceló) un abono: el comprobante para imprimirlo.</summary>
    [Parameter] public EventCallback<ComprobanteAbonoDto> AlAbonar { get; set; }

    /// <summary>Se reimprimió un abono: solo se imprime.</summary>
    [Parameter] public EventCallback<ComprobanteAbonoDto> AlReimprimir { get; set; }

    /// <summary>Imprimir su estado de cuenta (en la impresora de tickets).</summary>
    [Parameter] public EventCallback<EstadoCuentaDto> AlImprimirEstado { get; set; }

    private CuentaClienteDto? _cuenta;
    private bool _puedeDar;
    private bool _puedeAjustar;

    /// <summary>Quién da crédito, por su nombre, para decírselo a quien no puede (como el corte dice quién lo hace).</summary>
    private List<QuienAutoriza>? _quienesDan;

    /// <summary>«Límite y plazo» y «Ajustar el saldo» abiertos (se abren con su botón, como en el prototipo).</summary>
    private bool _condiciones;
    private bool _ajustando;
    private bool _abonando;
    private bool _ocupado;
    private string? _error;
    private string? _aviso;
    private string _limite = "";
    private string _plazo = "";
    // Con texto y no con bool: un <option value="@false"> no lleva valor y «Debe menos» nunca llegaba.
    private const string DebeMas = "mas", DebeMenos = "menos";
    private string _sentido = DebeMas;
    private bool Sube => _sentido == DebeMas;
    private string _ajuste = "";
    private string _motivo = "";
    private DateOnly? _desde;

    /// <summary>El Id del ajuste que se está mandando: si se manda dos veces, se guarda uno.</summary>
    private Guid? _idAjuste;

    private EstadoCuentaDto? _estado;
    private DateOnly? _desdeEstado;

    // Devolver el saldo a favor: lo capturado, el Id que se manda (el mismo si se reintenta) y si hay que pedir autorización.
    private bool _devolviendo;
    private string _devolver = "";
    private string? _problema;
    private Guid? _idDevolucion;
    private bool _autorizar;

    /// <summary>
    /// La que se mandó y se perdió la respuesta: puede que ya esté guardada. Hasta saberlo se manda otra vez igual (el mismo
    /// Id, lo mismo y con el saldo que se vio); la recuerda <see cref="ClienteCaja"/> aunque se cierre la ventana.
    /// </summary>
    private (SolicitudDevolverSaldo Solicitud, long MontoCentavos)? _sinConfirmar;

    /// <summary>Lo que se le va a devolver con lo capturado, con la misma regla que el servicio; si no se puede, por qué.</summary>
    private SaldoDevueltoCalculado? Devolucion
    {
        get
        {
            _problema = null;
            if (_cuenta?.Credito is not { DevolvibleCentavos: > 0 } credito)
                return null;
            long? monto = string.IsNullOrWhiteSpace(_devolver) ? null : Formato.LeerPesos(_devolver);
            if (!string.IsNullOrWhiteSpace(_devolver) && monto is null)
            {
                _problema = Formato.ProblemaDePesos(_devolver) ?? "Escribe cuánto se le devuelve.";
                return null;
            }
            try
            {
                return CalculoAbono.DevolverSaldo(credito.DevolvibleCentavos, monto);
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
            {
                _problema = ex.Message;
                return null;
            }
        }
    }

    /// <summary>Lo que se le entrega en efectivo: lo que se mandó sin confirmar, o lo capturado.</summary>
    private long? AEntregar => _sinConfirmar?.Solicitud.MontoCentavos ?? Devolucion?.EntregaCentavos;

    private static DateOnly Hoy => DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow));

    protected override async Task OnInitializedAsync()
    {
        _sinConfirmar = Servicio.DevolucionSinConfirmar(Cliente.Id);
        (_limite, _plazo) = (Pesos(Cliente.LimiteCreditoCentavos), Cliente.PlazoCreditoDias.ToString(CultureInfo.InvariantCulture));
        try
        {
            _cuenta = await Servicio.CuentaClienteAsync(Cliente.Id);
            _puedeDar = (await Servicio.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.DarCredito))).Nivel
                == NivelPermiso.Permitido;
            _puedeAjustar = (await Servicio.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.AjustarCredito, 1))).Nivel
                == NivelPermiso.Permitido;
            if (!_puedeDar)
                _quienesDan = await Servicio.QuienesPuedenAsync(Caja.SucursalId, AccionControlada.DarCredito);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Codigo == "sin-conexion" ? "Sin conexión con la caja principal: la cuenta se ve cuando vuelva." : ex.Message;
        }
    }

    /// <summary>«puedes cambiarlo», o «lo cambia Dueño de prueba» (sin saber quién, quien tiene el permiso).</summary>
    private string QuienCambiaElCredito => _puedeDar ? "puedes cambiarlo" : QuienPuede("lo cambia");

    private string QuienPuede(string hace) =>
        _quienesDan is { Count: > 0 } quienes ? $"{hace} {Textos.Quien(quienes)}" : $"{hace} quien tiene «{Textos.Accion(AccionControlada.DarCredito)}»";

    /// <summary>
    /// Esc en la página: cierra lo que esté abierto aquí (la autorización, el estado de cuenta, el abono, devolver, el límite y
    /// plazo o el ajuste), lo de más adentro primero. Devuelve si cerró algo.
    /// </summary>
    public bool Cerrar()
    {
        if (_autorizar)
            _autorizar = false;
        else if (_estado is not null)
            VolverACuenta();
        else if (_abonando)
            _abonando = false;
        else if (_devolviendo)
            CancelarDevolucion();
        else if (_condiciones)
            _condiciones = false;
        else if (_ajustando)
            _ajustando = false;
        else
            return false;
        StateHasChanged();
        return true;
    }

    private async Task GuardarCondicionesAsync()
    {
        (_error, _aviso) = (null, null);
        var limite = string.IsNullOrWhiteSpace(_limite) ? 0 : Formato.LeerPesos(_limite);
        if (limite is null or < 0)
        {
            _error = Formato.ProblemaDePesos(_limite) ?? "Escribe el límite en pesos (0: sin crédito).";
            return;
        }
        if (Formato.LeerEntero(_plazo) is not ({ } dias and >= 0 and <= int.MaxValue))
        {
            _error = Formato.ProblemaDeEntero(_plazo) ?? "Escribe el plazo en días.";
            return;
        }
        var plazo = (int)dias;
        _ocupado = true;
        try
        {
            var guardado = await Servicio.GuardarCondicionesAsync(Cliente.Id, new SolicitudCreditoCliente(Sesion.UsuarioId, Caja.SucursalId, limite.Value, plazo));
            _cuenta = await Servicio.CuentaClienteAsync(Cliente.Id);
            _aviso = guardado.TieneCredito ? $"Crédito hasta {Formato.Dinero(guardado.LimiteCreditoCentavos)}, a {guardado.PlazoCreditoDias} días." : "Quedó sin crédito.";
            _condiciones = false;
            await AlCambiar.InvokeAsync(guardado);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task AjustarAsync()
    {
        (_error, _aviso) = (null, null);
        if (Formato.LeerPesos(_ajuste) is not { } monto || monto <= 0)
        {
            _error = Formato.ProblemaDePesos(_ajuste) ?? "Escribe cuánto sube o baja la cuenta.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _error = "El ajuste lleva motivo.";
            return;
        }
        _ocupado = true;
        _idAjuste ??= Ids.Nuevo();
        try
        {
            _cuenta = await Servicio.AjustarCreditoAsync(Cliente.Id,
                new SolicitudAjusteCredito(_idAjuste.Value, Sesion.UsuarioId, Caja.SucursalId, Sube ? monto : -monto, _motivo.Trim(), _desde));
            _aviso = $"Ajuste de {(Sube ? "+" : "−")}{Formato.Dinero(monto)} guardado.";
            _ajustando = false;
            (_idAjuste, _ajuste, _motivo, _desde) = (null, "", "", null);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    // ── Estado de cuenta (parte 3) ───────────────────────────────────────────

    /// <summary>Lo trae del servicio: la primera vez, desde lo más viejo que debe; luego, desde la fecha elegida.</summary>
    private async Task EstadoAsync()
    {
        (_error, _aviso) = (null, null);
        _ocupado = true;
        try
        {
            _estado = await Servicio.EstadoDeCuentaAsync(Cliente.Id, Caja.SucursalId, _estado is null ? null : _desdeEstado);
            _desdeEstado = _estado.Desde;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Codigo == "sin-conexion" ? "Sin conexión con la caja principal: el estado de cuenta se saca cuando vuelva." : ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void VolverACuenta() => (_estado, _error, _aviso) = (null, null, null);

    private async Task ImprimirEstadoAsync()
    {
        if (_estado is { } estado)
            await AlImprimirEstado.InvokeAsync(estado);
    }

    private async Task CopiarEstadoAsync()
    {
        if (_estado is not { } estado)
            return;
        (_error, _aviso) = (null, null);
        try
        {
            await Js.CopiarAsync(DisenoComprobante.EstadoCuentaTexto(estado));
            _aviso = Cliente.Telefono is { Length: > 0 } telefono
                ? $"Estado de cuenta copiado: pégalo en WhatsApp ({ElegirCliente.Telefono(telefono)})."
                : "Estado de cuenta copiado: pégalo en WhatsApp o en un correo.";
        }
        catch (JSException ex)
        {
            _error = "No se pudo copiar: " + ex.Message;
        }
    }

    // ── Devolver el saldo a favor (parte 3) ──────────────────────────────────

    private void EmpezarDevolucion() =>
        (_devolviendo, _devolver, _idDevolucion, _enfocar, _error, _aviso) = (true, "", null, true, null, null);

    private void CancelarDevolucion() => (_devolviendo, _devolver, _idDevolucion) = (false, "", null);

    /// <summary>Al empezar a devolver: el cursor va a cuánto.</summary>
    private bool _enfocar;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!_enfocar || !_devolviendo)
            return;
        _enfocar = false;
        await Js.EnfocarAsync("#devolver-monto");
    }

    /// <summary>
    /// Con lo que se vio: lo que se le entrega (no «todo», que podría ser otra cosa si mientras tanto se verificó una
    /// transferencia) y su saldo. Si la regla pide autorización, se pide y se vuelve a intentar con ella.
    /// </summary>
    private async Task DevolverAsync(Guid? autorizacion)
    {
        _autorizar = false;
        if (_ocupado || Turno is null || _cuenta is null)
            return;
        var envio = _sinConfirmar;
        if (envio is null)
        {
            if (Devolucion is not { } calculo)
                return;
            _idDevolucion ??= Ids.Nuevo();
            envio = (new SolicitudDevolverSaldo(_idDevolucion.Value, Caja.Id, Turno.Id, Sesion.UsuarioId, calculo.EntregaCentavos,
                _cuenta.Credito.SaldoCentavos), calculo.MontoCentavos);
        }
        var (solicitud, monto) = envio.Value;
        solicitud = solicitud with { AutorizacionId = autorizacion ?? solicitud.AutorizacionId };
        (_error, _aviso) = (null, null);
        _ocupado = true;
        try
        {
            var comprobante = await Servicio.DevolverSaldoAsync(Cliente.Id, solicitud, monto);
            (_devolviendo, _devolver, _idDevolucion, _sinConfirmar) = (false, "", null, null);
            await AlAbonar.InvokeAsync(comprobante);
            _cuenta = await Servicio.CuentaClienteAsync(Cliente.Id);
        }
        catch (ErrorCaja ex) when (ex.Codigo == "requiere-autorizacion" && autorizacion is null)
        {
            _autorizar = true;
        }
        catch (ErrorCaja ex) when (ex.Codigo == "sin-conexion")
        {
            _error = "Sin conexión con la caja principal: el saldo a favor se devuelve cuando vuelva.";
        }
        catch (ErrorCaja ex) when (ex.Codigo == "saldo-sin-confirmar")
        {
            // Se perdió la respuesta: hasta saber si quedó, se manda otra vez lo mismo.
            _sinConfirmar = (solicitud, monto);
        }
        catch (ErrorCaja ex)
        {
            // Una respuesta del servicio: no quedó (si hubiera quedado, habría salido su comprobante). Se ve el saldo de ahora.
            (_error, _sinConfirmar) = (ex.Message, null);
            try
            {
                _cuenta = await Servicio.CuentaClienteAsync(Cliente.Id);
            }
            catch (ErrorCaja)
            {
            }
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task AbonadoAsync(ComprobanteAbonoDto comprobante)
    {
        _abonando = false;
        await AlAbonar.InvokeAsync(comprobante);
        try
        {
            _cuenta = await Servicio.CuentaClienteAsync(Cliente.Id);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Lo que debe, o lo que tiene a favor.</summary>
    private static string Saldo(long centavos) => centavos < 0 ? $"{Formato.Dinero(-centavos)} a favor" : Formato.Dinero(centavos);

    private static string Pesos(long centavos) => (centavos / 100m).ToString("0.##", CultureInfo.InvariantCulture);
}
