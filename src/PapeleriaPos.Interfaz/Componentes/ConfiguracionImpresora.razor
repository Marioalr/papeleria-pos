    /// <summary>
    /// Lo que se elige (el margen, a qué se cobra el mínimo): al momento, en su turno, después de lo escrito en los renglones. Si un renglón
    /// no se pudo guardar, no se cambia nada más hasta corregirlo: un tramo con su porqué no se queda escondido al cambiar el margen.
    /// </summary>
    private async Task ElegirAsync(Func<CostosImpresionDto, CostosImpresionDto> cambio)
    {
        if (await GuardarFilasAsync())
            await HacerAsync(Costos, () => GuardarCostosAsync(cambio));
    }

    private static IReadOnlyList<T> Cambiar<T>(IReadOnlyList<T> lista, int indice, T nuevo) =>
        lista.Select((x, i) => i == indice ? nuevo : x).ToList();

    /// <summary>
    /// El tramo que empezaba en <paramref name="desde"/>, cambiado. Se busca por su «desde», no por su lugar: al guardar, los tramos se
    /// reordenan (segunda revisión, 2026-10-31). Si ya no está así (lo cambiaron en otra caja), se dice.
    /// </summary>
    private static CostosImpresionDto ConTramo(CostosImpresionDto c, bool porTrabajo, decimal desde, Func<TramoMargenDto, TramoMargenDto> cambio)
    {
        var tramos = porTrabajo ? c.TramosPorTrabajo : c.TramosPorHoja;
        var indice = tramos.ToList().FindIndex(t => t.Desde == desde);
        if (indice < 0)
            throw new ArgumentException($"El tramo desde {desde.ToString("$#,##0.00##", Formato.Mexico)} ya no está así (lo cambiaron en otra caja): revisa los "
                + "tramos y vuelve a escribirlo.");
        return porTrabajo
            ? c with { TramosPorTrabajo = Cambiar(tramos, indice, cambio(tramos[indice])) }
            : c with { TramosPorHoja = Cambiar(tramos, indice, cambio(tramos[indice])) };
    }

    private static string NombrePapel(PapelCostoDto p) => p.Grupo == "Normal" ? $"{p.Tamano} normal" : $"{p.Tamano} · {p.Grupo}";

    private static string Dinero(decimal valor) => valor.ToString("#,##0.00##", Formato.Mexico);

    private static string Entero(int valor) => valor.ToString("#,##0", Formato.Mexico);

    private static string Porcentaje(decimal valor) => valor.ToString("0.##", Formato.Mexico);

    // ── Un renglón a la vez (revisión del 2026-10-31; segunda revisión: sin pausa, cada tramo por su «desde» y cada renglón con su porqué) ──

    /// <summary>
    /// Un renglón de los costos: un cartucho (su precio y lo que rinde), un papel (su paquete y sus hojas), un tramo (desde y su margen)
    /// o un ajuste suelto. Lo que se escribe en sus campos se guarda junto, cuando se termina con él: al salir del renglón, con Enter en
    /// cualquiera de sus campos o al cerrar la Configuración. Ya no tras una pausa (segunda revisión, 2026-10-31): con el cursor en el
    /// segundo número, mientras se buscaba en la caja del cartucho, el renglón se guardaba a medias y se cobraba con eso. Así lo que se
    /// imprime en medio no sale con un renglón a medias, y cada vez que se guarda queda un solo renglón en el historial y uno en la
    /// bitácora. Si no se pudo, su porqué se queda con él y lo escrito, marcado, hasta que se corrige o se cierra la ventana.
    /// </summary>
    /// <param name="Id">El renglón; un tramo, por su «desde» como está guardado, no por su lugar.</param>
    /// <param name="Aplicar">
    /// Lo escrito, por campo, sobre los costos como están ahora en el servicio (lo que no se escribió se queda); si algo no sirve,
    /// <see cref="ArgumentException"/> con el porqué.
    /// </param>
    /// <param name="GuardarAparte">
    /// Lo de un renglón que no va en los costos de la sucursal (la tinta propia de una impresora, 2026-11-03): cómo se guarda lo escrito.
    /// </param>
    private sealed record Fila(string Id, Func<CostosImpresionDto, IReadOnlyDictionary<string, string>, CostosImpresionDto> Aplicar,
        Func<IReadOnlyDictionary<string, string>, Task>? GuardarAparte = null);

    /// <summary>Al salir de un campo: si en este rato el cursor no pasó a otro campo del mismo renglón, se terminó con él y se guarda.</summary>
    private static readonly TimeSpan AlDejarLaFila = TimeSpan.FromMilliseconds(250);

    /// <summary>Lo escrito en cada renglón que todavía no se guarda: el renglón y el texto de cada campo.</summary>
    private readonly Dictionary<string, (Fila Fila, Dictionary<string, string> Campos)> _escritoEnFila = [];

    private readonly Dictionary<string, CancellationTokenSource> _esperaDeFila = [];

    /// <summary>El renglón donde está el cursor; vacío: ninguno de los costos.</summary>
    private string? _filaConFoco;

    private Fila FilaCartucho(int i) => new($"cartucho-{i}", (c, escrito) =>
    {
        var cartucho = c.Cartuchos[i];
        var tinta = cartucho.Tinta.ToLowerInvariant();
        return c with
        {
            Cartuchos = Cambiar(c.Cartuchos, i, cartucho with
            {
                Precio = escrito.TryGetValue("precio", out var precio) ? Pesos(precio, $"El precio del cartucho {tinta}") : cartucho.Precio,
                Rendimiento = escrito.TryGetValue("rinde", out var rinde) ? Entero(rinde, $"lo que rinde el cartucho {tinta}") : cartucho.Rendimiento,
            }),
        };
    });

    private Fila FilaPapel(int i) => new($"papel-{i}", (c, escrito) =>
    {
        var papel = c.Papeles[i];
        var nombre = NombrePapel(papel);
        return c with
        {
            Papeles = Cambiar(c.Papeles, i, papel with
            {
                PrecioPaquete = escrito.TryGetValue("precio", out var precio) ? Pesos(precio, $"El precio del paquete de papel {nombre}") : papel.PrecioPaquete,
                HojasPaquete = escrito.TryGetValue("hojas", out var hojas) ? Entero(hojas, $"las hojas del paquete de papel {nombre}") : papel.HojasPaquete,
            }),
        };
    });

    /// <summary>La botella (o el cartucho) de una impresora con sus propios consumibles: su precio y lo que rinde, juntos.</summary>
    private Fila FilaTinta(int numero, int i) => new($"impresora-{numero}-tinta-{i}", (c, _) => c, async escrito =>
    {
        var actual = await ConsumiblesDeAsync(numero);
        var tinta = actual.Tintas[i];
        var que = $"la tinta {tinta.Tinta.ToLowerInvariant()} de la {actual.Nombre}";
        var tintas = Cambiar(actual.Tintas, i, tinta with
        {
            Precio = escrito.TryGetValue("precio", out var precio) ? Pesos(precio, $"El precio de {que}") : tinta.Precio,
            Rendimiento = escrito.TryGetValue("rinde", out var rinde) ? Entero(rinde, $"lo que rinde {que}") : tinta.Rendimiento,
        });
        _costos = await Cliente.GuardarConsumiblesAsync(Caja.SucursalId, numero, new SolicitudConsumiblesImpresora(Sesion.UsuarioId, tintas));
    });

    /// <summary>La caja de mantenimiento de una impresora con sus propios consumibles (si tiene).</summary>
    private Fila FilaCajaDe(int numero) => new($"impresora-{numero}-caja", (c, _) => c, async escrito =>
    {
        var actual = await ConsumiblesDeAsync(numero);
        var que = $"la caja de mantenimiento de la {actual.Nombre}";
        _costos = await Cliente.GuardarConsumiblesAsync(Caja.SucursalId, numero, new SolicitudConsumiblesImpresora(Sesion.UsuarioId, actual.Tintas,
            escrito.TryGetValue("precio", out var precio) && precio.Trim().Length > 0 ? Pesos(precio, $"El precio de {que}") : actual.CajaMantenimiento,
            escrito.TryGetValue("caras", out var caras) && caras.Trim().Length > 0 ? Entero(caras, $"cuántas caras dura {que}") : actual.PaginasPorCaja));
    });

    /// <summary>Los consumibles de esa impresora como están ahora en el servicio (otra caja los pudo cambiar).</summary>
    private async Task<ConsumiblesImpresoraDto> ConsumiblesDeAsync(int numero) =>
        (await Cliente.CostosImpresionAsync(Caja.SucursalId, Sesion.UsuarioId))?.Impresoras?.FirstOrDefault(p => p.Numero == numero)
        ?? throw new ErrorCaja($"La impresora {numero} ya no tiene sus propios consumibles: vuelve a abrir la Configuración.");

    /// <summary>Un tramo, por su «desde» como está guardado: lo escrito en él no cae en otro si al guardar se reordenan.</summary>
    private Fila FilaTramo(bool porTrabajo, decimal desde) =>
        new($"tramo-{(porTrabajo ? "trabajo" : "hoja")}-{desde.ToString("0.############", CultureInfo.InvariantCulture)}", (c, escrito) =>
            ConTramo(c, porTrabajo, desde, t => t with
            {
                Desde = escrito.TryGetValue("desde", out var nuevo) ? Pesos(nuevo, "El «desde» del tramo") : t.Desde,
                Margen = escrito.TryGetValue("margen", out var margen) ? Porcentaje(margen, "El margen del tramo") : t.Margen,
            }));

