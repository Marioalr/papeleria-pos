                        <div class="vn-ajuste-txt">
                            <strong>IP de la impresora</strong>
                            <small>La @PerfilesImpresora.De(impresora.Perfil).NombreCorto en la red: la lee la caja principal.</small>
                            <span class="vn-ajuste-meta">Toda la tienda</span>
                            @if (ErrorDe(Campo(Host, impresora.Numero)) is { } errorHost)
                            {
                                <span class="vn-ajuste-error" role="alert">@errorHost</span>
                            }
                        </div>
                        <span class="vn-ctl-texto">
                            <input id="@Campo(Host, impresora.Numero)" placeholder="192.168.1.50" autocomplete="off" spellcheck="false" aria-label="IP de la impresora"
                                   value="@Escrito(Campo(Host, impresora.Numero), impresora.Estado.Configuracion.Host ?? "")"
                                   @oninput="e => Escribir(Campo(Host, impresora.Numero), e.Value, texto => GuardarHostAsync(impresora.Numero, texto), conPausa: false)"
                                   @onblur="() => SalirAsync(Campo(Host, impresora.Numero))" @onkeydown="e => AlTeclearAsync(e, Campo(Host, impresora.Numero))" />
                        </span>
                    </div>
                    <div class="vn-ajuste">
                        <div class="vn-ajuste-txt">
                            <strong>Avisar con tinta en</strong>
                            <small>Con la tinta@(ConCaja(impresora) ? " o la caja de mantenimiento" : "") en este porcentaje o menos, su nivel sale en rojo aquí arriba (el aviso por Telegram está en pausa).</small>
                            <span class="vn-ajuste-meta">Toda la tienda</span>
                            @if (ErrorDe(Campo(Aviso, impresora.Numero)) is { } errorAviso)
                            {
                                <span class="vn-ajuste-error" role="alert">@errorAviso</span>
                            }
                        </div>
                        <span class="vn-ctl-num">
                            <input id="@Campo(Aviso, impresora.Numero)" inputmode="numeric" autocomplete="off" aria-label="Avisar con tinta en (por ciento)"
                                   value="@Escrito(Campo(Aviso, impresora.Numero), impresora.Estado.Configuracion.AvisoTintaPorcentaje.ToString(CultureInfo.InvariantCulture))"
                                   @oninput="e => Escribir(Campo(Aviso, impresora.Numero), e.Value, texto => GuardarAvisoAsync(impresora.Numero, texto), conPausa: false)"
                                   @onblur="() => SalirAsync(Campo(Aviso, impresora.Numero))" @onkeydown="e => AlTeclearAsync(e, Campo(Aviso, impresora.Numero))" />% o menos
                        </span>
                    </div>
                    <div class="vn-ajuste">
                        <div class="vn-ajuste-txt">
                            <strong>Leer la impresora cada</strong>
                            <span class="vn-ajuste-meta">Toda la tienda</span>
                            @if (ErrorDe(Campo(Minutos, impresora.Numero)) is { } errorMinutos)
                            {
                                <span class="vn-ajuste-error" role="alert">@errorMinutos</span>
                            }
                        </div>
                        <span class="vn-ctl-num">
                            <input id="@Campo(Minutos, impresora.Numero)" inputmode="numeric" autocomplete="off" aria-label="Leer la impresora cada (minutos)"
                                   value="@Escrito(Campo(Minutos, impresora.Numero), impresora.Estado.Configuracion.MinutosEntreLecturas.ToString(CultureInfo.InvariantCulture))"
                                   @oninput="e => Escribir(Campo(Minutos, impresora.Numero), e.Value, texto => GuardarMinutosAsync(impresora.Numero, texto), conPausa: false)"
                                   @onblur="() => SalirAsync(Campo(Minutos, impresora.Numero))" @onkeydown="e => AlTeclearAsync(e, Campo(Minutos, impresora.Numero))" />minutos
                        </span>
                    </div>
                    @if (!ConLoDeSiempre)
                    {
                        @* Cotizar (2026-11-08): lo cotizado contra lo impreso en esta impresora y la corrección de su tinta al cotizar. *@
                        <div class="vn-ajuste" id="@($"cotizar-precision-{impresora.Numero}")">
                            <div class="vn-ajuste-txt">
                                <strong>Corrección al cotizar</strong>
                                <small>@PrecisionTexto(impresora)</small>
                                <span class="vn-ajuste-meta">Toda la tienda</span>
                                @if (ErrorDe(Campo(FactorCotizar, impresora.Numero)) is { } errorFactor)
                                {
                                    <span class="vn-ajuste-error" role="alert">@errorFactor</span>
                                }
                            </div>
                            <span class="vn-ctl-num">
                                <input id="@Campo(FactorCotizar, impresora.Numero)" inputmode="decimal" autocomplete="off" aria-label="Corrección de la tinta al cotizar"
                                       value="@Escrito(Campo(FactorCotizar, impresora.Numero), impresora.FactorCotizacion.ToString("0.00", CultureInfo.InvariantCulture))"
                                       @oninput="e => Escribir(Campo(FactorCotizar, impresora.Numero), e.Value, texto => GuardarFactorAsync(impresora.Numero, texto), conPausa: false)"
                                       @onblur="() => SalirAsync(Campo(FactorCotizar, impresora.Numero))" @onkeydown="e => AlTeclearAsync(e, Campo(FactorCotizar, impresora.Numero))" />
                                @if (impresora.PrecisionCotizar?.FactorSugerido is { } sugerido && Math.Abs(sugerido - impresora.FactorCotizacion) >= 0.01)
                                {
                                    <button class="vn-boton chico" disabled="@_ocupado"
                                            @onclick="() => HacerAsync(Campo(FactorCotizar, impresora.Numero), () => GuardarFactorAsync(impresora.Numero, sugerido.ToString(CultureInfo.InvariantCulture)))">
                                        Usar @sugerido.ToString("0.00", CultureInfo.InvariantCulture)
                                    </button>
                                }
                            </span>
                        </div>
                    }
                </div>

                @if (Varias)
                {
                    <h4>Calibración de la tinta</h4>
                }
                else
                {
                    <h3>Calibración de la tinta</h3>
                }
                @if (_calibraciones.GetValueOrDefault(impresora.Numero) is { } cal)
                {
                    <div class="vn-cfg-antes">
                        <p class="nota">
                            Lo que bajaron los niveles en la impresora contra lo que estimó el cálculo@(cal.DesdeLocal is { } d ? $", desde el {d:dd/MM}" : "").
                            La impresora contó @cal.CarasImpresora.ToString("N0") caras y el POS registró @cal.CarasRegistradas.ToString("N0").
                            @(cal.AplicadaLocal is { } a ? $"Última aplicada: {a:dd/MM HH:mm}." : "Todavía no se ha aplicado.")
                        </p>
                        <table class="resultados">
                            <thead><tr><th>Tinta</th><th class="num">Bajó en la impresora</th><th class="num">Estimado</th><th class="num">Corrección</th><th class="num">Actual</th><th>Datos</th></tr></thead>
                            @foreach (var c in cal.Canales)
                            {
                                <tr>
                                    <td>@c.Canal</td>
                                    <td class="num">@c.Observado.ToString("0.#") puntos</td>
                                    <td class="num">@c.Estimado.ToString("0.#") puntos</td>
                                    <td class="num">× @c.Factor.ToString("0.000")</td>
                                    <td class="num">× @c.Actual.ToString("0.000")</td>
                                    <td>@c.Calidad</td>
                                </tr>
                            }
                        </table>
                        @if (PerfilesImpresora.De(impresora.Perfil).ConCajaDeMantenimiento || cal.PaginasPorCaja is not null)
                        {
                            <p class="nota">
                                Caja de mantenimiento: @(cal.PaginasPorCaja is { } p ? $"{p:N0} caras por caja según la impresora" : "todavía sin datos")
                                (hoy se calcula con @cal.PaginasPorCajaActual.ToString("N0")).
                            </p>
                        }
                        @foreach (var cambio in cal.Cambios)
                        {
                            <p class="nota">Cambio: @cambio</p>
                        }
                        <p class="nota">Mientras el agente vigile la cola de laboratorio, lo registrado no sale de la impresora: no apliques la calibración hasta usar la cola real.</p>
                    </div>
                    @if (ErrorDe(Campo(Calibracion, impresora.Numero)) is { } errorCalibracion)
                    {
                        <p class="vn-cfg-error" role="alert">@errorCalibracion</p>
                    }
                    @* Antes la confirmaba el PIN: ahora se pregunta aquí mismo, porque cambia el costo de lo que se imprima. *@
                    <div class="vn-botonera">
                        @if (CalibraEnControlPrint(impresora))
                        {
                            @* Sus costos vienen de Control Print y se reemplazan cuando cambian allá: la corrección se aplica allá (auditoría). *@
                            <span class="nota">Con Control Print, la corrección de esta impresora se aplica allá, como sus costos.</span>
                        }
                        else if (_porAplicar == impresora.Numero)
                        {
                            <span class="vn-cfg-pregunta">
                                Las impresiones nuevas de esta impresora salen con esta corrección.
                                <button class="vn-boton chico primario" disabled="@(_ocupado || _aplicando)" @onclick="() => AplicarCalibracionAsync(impresora.Numero)">Aplicar</button>
                                <button class="vn-boton chico" disabled="@(_ocupado || _aplicando)" @onclick="() => _porAplicar = null">No</button>
                            </span>
                        }
                        else
                        {
                            <button class="vn-boton chico" disabled="@(_ocupado || _aplicando)" @onclick="() => _porAplicar = impresora.Numero">Aplicar la corrección</button>
                        }
                    </div>
                }

                @if (Varias && !_deAntes)
                {
                    @if (ErrorDe(Campo(Baja, impresora.Numero)) is { } errorBaja)
                    {
                        <p class="vn-cfg-error" role="alert">@errorBaja</p>
                    }
                    <div class="vn-botonera">
                        @if (_porDarDeBaja == impresora.Numero)
                        {
                            <span class="vn-cfg-pregunta">
                                Ya no se lee, y lo que llegue de su cola se anota en la @PrimeraSin(impresora.Numero). Su historia se queda.
                                @if (impresora.Numero == Activas[0].Numero)
                                {
                                    @* Dar de baja la primera cambia cuál es la primera (revisión de #155, 2026-11-08). *@
                                    <strong>Es la primera:</strong> <span>desde ahí, lo que llegue sin decir de qué impresora (una PC con su cola de siempre, las
                                    copias del panel sin elegir) también se anota en la @PrimeraSin(impresora.Numero).</span>
                                }
                                <button class="vn-boton chico primario" disabled="@_ocupado" @onclick="() => DarDeBajaAsync(impresora.Numero)">Dar de baja</button>
                                <button class="vn-boton chico" disabled="@_ocupado" @onclick="() => _porDarDeBaja = null">No</button>
                            </span>
                        }
                        else
                        {
                            <button class="vn-boton chico" disabled="@_ocupado" @onclick="() => _porDarDeBaja = impresora.Numero">Dar de baja la @impresora.Nombre</button>
                        }
                    </div>
                }
            }
        </section>;

    /// <summary>Por qué no se guardaron los renglones de una tabla, cada uno con el suyo, debajo de ella.</summary>
    private RenderFragment Avisos(IReadOnlyList<Fila> filas) =>
        @<div class="vn-costos-avisos">
            @foreach (var error in filas.Select(f => ErrorDe(Renglon(f.Id))).OfType<string>())
            {
                <p class="vn-cfg-error" role="alert">@error</p>
            }
        </div>;

    /// <summary>Por qué no se guardó un ajuste suelto (el margen, el mínimo, el redondeo), en su renglón.</summary>
    private RenderFragment AvisoDe(Fila fila) =>
        @<span class="vn-costos-aviso">
            @if (ErrorDe(Renglon(fila.Id)) is { } error)
            {
                <span class="vn-ajuste-error" role="alert">@error</span>
            }
        </span>;

    /// <summary>
    /// Un campo de un renglón de los costos: se ve lo escrito mientras no se guarda; si no, lo guardado. Sin guardar, marcado. Se cambia si
    /// <paramref name="puede"/> (los consumibles propios de una impresora); si no se dice, si se pueden cambiar los costos de la sucursal.
    /// </summary>
    private RenderFragment Campo(Fila fila, string campo, string id, string etiqueta, string guardado, string modo, string? antes = null,
        string? despues = null, string? marcador = null, bool? puede = null) =>
        @<span class="vn-ctl-num">@antes<input id="@id" inputmode="@modo" autocomplete="off" aria-label="@etiqueta" placeholder="@marcador"
                                                 aria-invalid="@(SinGuardar(fila, campo) ? "true" : null)"
                                                 disabled="@(!(puede ?? _costos?.PuedeCambiar == true))" value="@EscritoEn(fila, campo, guardado)"
                                                 @oninput="e => EscribirEnFila(fila, campo, e.Value)" @onfocus="() => EntrarALaFila(fila)"
                                                 @onblur="() => SalirDeLaFila(fila)" @onkeydown="e => AlTeclearEnLaFilaAsync(e, fila)" />@despues</span>;

    /// <summary>Pesos con centavos, como el resto del dinero de la caja («1,200», «12.50»); si no, por qué.</summary>
    private static decimal Pesos(string texto, string que) =>
        Formato.LeerPesos(texto) is { } centavos
            ? centavos / 100m
            : throw new ArgumentException(Formato.ProblemaDePesos(texto) ?? $"{que}: escribe cuánto, con número (12.50, por ejemplo).");

    private static decimal Porcentaje(string texto, string que) =>
        Formato.LeerCantidad(texto.Trim().TrimEnd('%')) is { } valor && valor >= 0
            ? valor
            : throw new ArgumentException(Formato.ProblemaDePorcentaje(texto) ?? $"{que}: escribe el porcentaje con número (80, por ejemplo).");

    protected override Task AlGuardarAsync() => AlGuardar.InvokeAsync();

    protected override Task NoSeGuardoAlCerrarAsync(IReadOnlyList<string> errores) => AlNoGuardar.InvokeAsync(string.Join(" ", errores));


    /// <summary>
    /// Cómo se lee y la calibración: solo con «Configurar la impresora» en «Puede» (en Administración no hay «Con
    /// autorización»: sin el permiso no aparecen). El servicio lo vuelve a revisar.
    /// </summary>
    private bool PuedeConfigurar => Sesion.Puede(AccionControlada.ConfigurarImpresora);

    /// <summary>El desglose dice de qué impresora es cada trabajo cuando la sucursal tiene más de una (el servicio lo manda solo entonces).</summary>
    private bool ConImpresora => _dia?.Any(t => t.Impresora is not null) == true;

    /// <summary>El desglose del día: con «Consultar la bitácora» (al migrar, el dueño y el encargado). El servicio lo vuelve a revisar.</summary>
    private bool VeElDia => Sesion.Puede(AccionControlada.ConsultarBitacora);

    /// <summary>El costo de cada impresión: con «Ver costos, utilidad y margen» (al migrar, el dueño). El servicio solo lo manda a quien lo ve.</summary>
    private bool VeCosto => Sesion.Puede(AccionControlada.VerUtilidad);

    private static int Entero(string texto, string que) =>
        Formato.LeerEntero(texto.Trim().TrimEnd('%')) is { } n && n is >= int.MinValue and <= int.MaxValue
            ? (int)n
            : throw new ArgumentException(Formato.ProblemaDeEntero(texto.Trim().TrimEnd('%')) ?? $"Escribe {que} con número.");

    private Task GuardarHostAsync(int numero, string texto) => GuardarComoSeLeeAsync(numero, c => c with { Host = texto });

    private Task GuardarAvisoAsync(int numero, string texto) =>
        GuardarComoSeLeeAsync(numero, c => c with { AvisoTintaPorcentaje = Entero(texto, "el porcentaje del aviso") });

    private Task GuardarMinutosAsync(int numero, string texto) =>
        GuardarComoSeLeeAsync(numero, c => c with { MinutosEntreLecturas = Entero(texto, "los minutos") });

    /// <summary>La corrección de la tinta al cotizar (2026-11-08): un número como 1.05 (con punto o coma).</summary>
    private async Task GuardarFactorAsync(int numero, string texto)
    {
        if (!double.TryParse(texto.Trim().Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var factor))
            throw new ArgumentException("Escribe la corrección como 1.05 (1: sin corregir).");
        Poner(await Cliente.CambiarImpresoraAsync(Caja.SucursalId, numero, new SolicitudCambioImpresora(Sesion.UsuarioId, FactorCotizacion: factor)));
    }

    /// <summary>Qué tan preciso es cotizar en ella, con lo cotizado que se imprimió igual, y qué hace la corrección.</summary>
    private static string PrecisionTexto(ImpresoraDto impresora)
    {
        const string QueEs = "Cuánto se corrige la tinta de lo que se cotiza en esta impresora (1: sin corregir; 1.10: 10 % más).";
        if (impresora.PrecisionCotizar is not { Pares: > 0 } p)
            return $"{QueEs} Todavía no hay cotizaciones que se hayan impreso igual: al imprimir lo cotizado, aquí se ve la diferencia.";
        var diferencia = p.DiferenciaPorcentaje is { } d
            ? d == 0 ? "lo mismo que lo cotizado" : $"{Math.Abs(d):0.#} % {(d > 0 ? "más" : "menos")} que lo cotizado"
            : "—";
        var sugerida = p.FactorSugerido is { } f ? $" Sugerida: {f.ToString("0.00", CultureInfo.InvariantCulture)}." : $" Con {5} o más se sugiere una.";
        return $"{QueEs} De {p.Pares} cotizaciones que se imprimieron igual (últimos {p.Dias} días), lo impreso salió en promedio {diferencia}.{sugerida}";
    }

    private async Task CargarDiaAsync()
    {
        if (!VeElDia)
            return;
        var consulta = ++_consultaDia;
        await HacerAsync(async () =>
        {
            var dia = await Cliente.ImpresionesDelDiaAsync(Caja.SucursalId, _fecha, Sesion.UsuarioId);
            if (consulta == _consultaDia)
                _dia = dia;
        });
    }

    private Task LeerAsync(int numero) => HacerAsync(async () => Poner(ConLoDeSiempre
        ? DeAntes(await Cliente.LeerImpresoraAsync(Caja.SucursalId))
        : await Cliente.LeerImpresoraAsync(Caja.SucursalId, numero)));

    private async Task AplicarCalibracionAsync(int numero)
    {
        if (_aplicando)
            return;
        _aplicando = true;
        try
        {
            if (await HacerAsync(Campo(Calibracion, numero), async () => _calibraciones[numero] = ConLoDeSiempre
                    ? await Cliente.AplicarCalibracionAsync(Caja.SucursalId, new SolicitudCalibracion(Sesion.UsuarioId))
                    : await Cliente.AplicarCalibracionAsync(Caja.SucursalId, numero, new SolicitudCalibracion(Sesion.UsuarioId))))
                (_porAplicar, _avisoTexto) = (null, "Corrección aplicada: las impresiones nuevas de esa impresora ya salen con ella.");
        }
        finally
        {
            _aplicando = false;
        }
    }

    /// <summary>Lo que no se guarda (leer, cargar): el error abajo.</summary>
    private async Task HacerAsync(Func<Task> accion)
    {
        (_error, _avisoTexto, _ocupado) = (null, null, true);
        try
        {
            await accion();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>Los niveles de una impresora; la de botellas (la L5590) sin la caja de mantenimiento si no la dice.</summary>
    private static IEnumerable<(string Nombre, int? Nivel, string Color)> Niveles(LecturaImpresoraDto u, PerfilImpresora perfil)
    {
        yield return ("Negro", u.TintaK, "#222");
        yield return ("Cian", u.TintaC, "#00a0d6");
        yield return ("Magenta", u.TintaM, "#d6007a");
        yield return ("Amarillo", u.TintaY, "#e6c200");
        if (PerfilesImpresora.De(perfil).ConCajaDeMantenimiento || u.Mantenimiento is not null)
            yield return ("Caja de mantenimiento", u.Mantenimiento, "#7a8a99");
    }

    private static string Cobro(ImpresionDelDiaDto t) => t.Cobro switch
    {
        EstadoCobroImpresion.Cobrada => "Cobrada",
        EstadoCobroImpresion.NoVendida => t.Motivo switch
        {
            MotivoNoVendida.NoEraLoQueQueria => "No vendida: no era lo que quería",
            MotivoNoVendida.SalioMal => "No vendida: salió mal",
            MotivoNoVendida.Atasco => "No vendida: atasco",
            _ => "No vendida: otro",
        },
        // La copia de un trámite (su documento es «T-0042 · CURP»): se cobra con él, en el ticket (2026-10-31).
        EstadoCobroImpresion.EnTramite => "Incluida en su trámite",
        _ => "Por cobrar",
    };
}
