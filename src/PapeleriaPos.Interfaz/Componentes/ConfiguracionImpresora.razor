                                    <span class="vn-ajuste-error" role="alert">@errorNombre</span>
                                }
                            </div>
                            <span class="vn-ctl-texto">
                                <input id="@Campo(Nombre, impresora.Numero)" autocomplete="off" maxlength="40" aria-label="Nombre de la impresora @impresora.Numero"
                                       value="@Escrito(Campo(Nombre, impresora.Numero), impresora.Nombre)"
                                       @oninput="e => Escribir(Campo(Nombre, impresora.Numero), e.Value, texto => CambiarNombreAsync(impresora.Numero, texto), conPausa: false)"
                                       @onblur="() => SalirAsync(Campo(Nombre, impresora.Numero))" @onkeydown="e => AlTeclearAsync(e, Campo(Nombre, impresora.Numero))" />
                            </span>
                        </div>
                    }
