    /// <summary>
    /// Las impresoras y, para quien las configura, la calibración de cada activa. Con una caja principal de antes, la suya (la de siempre)
    /// como la impresora 1.
    /// </summary>
    private async Task CargarImpresorasAsync()
    {
        try
        {
            _hayControlPrint = (await Cliente.ResumenPorCobrarAsync(Caja.SucursalId)).ControlPrintConfigurado;
        }
        catch (ErrorCaja)
        {
            // Sin saberlo, como antes.
        }
        var lista = await Cliente.ImpresorasAsync(Caja.SucursalId);
        (_deAntes, _sinNinguna) = (lista is null, lista is { Count: 0 });
        _impresoras = lista is { Count: > 0 } ? lista : [DeAntes(await Cliente.ImpresoraAsync(Caja.SucursalId))];
        if (!PuedeConfigurar)
            return;
        _calibraciones.Clear();
        foreach (var impresora in Activas)
            _calibraciones[impresora.Numero] = ConLoDeSiempre
                ? await Cliente.CalibracionAsync(Caja.SucursalId)
                : await Cliente.CalibracionAsync(Caja.SucursalId, impresora.Numero);
    }

    /// <summary>La impresora de una caja principal de antes, como la 1.</summary>
    private static ImpresoraDto DeAntes(EstadoImpresoraDto estado) =>
        new(1, PerfilesImpresora.WF6590.NombreCorto, PerfilImpresora.WF6590, true, estado, false);

    private void Poner(ImpresoraDto impresora)
    {
        var lista = _impresoras ?? [];
        var i = lista.FindIndex(x => x.Numero == impresora.Numero);
        if (i >= 0)
            lista[i] = impresora;
        else
            lista.Add(impresora);
        _impresoras = lista.OrderBy(x => x.Numero).ToList();
    }

    /// <summary>
    /// Cómo se lee una impresora, con lo que cambió sobre como está ahora en el servicio (no sobre lo que se leyó al abrir: otra caja la
    /// pudo cambiar). Al guardarlo, la caja principal la vuelve a leer.
    /// </summary>
    private async Task GuardarComoSeLeeAsync(int numero, Func<ConfiguracionImpresoraDto, ConfiguracionImpresoraDto> cambio)
    {
        ImpresoraDto guardada;
        if (ConLoDeSiempre)
        {
            var actual = (await Cliente.ImpresoraAsync(Caja.SucursalId)).Configuracion;
            guardada = DeAntes(await Cliente.GuardarImpresoraAsync(Caja.SucursalId, new SolicitudConfiguracionImpresora(Sesion.UsuarioId, cambio(actual))));
            // Lo de siempre la acaba de dar de alta: desde aquí es una impresora como las demás.
            _sinNinguna = false;
        }
        else
        {
            var actual = (await Cliente.ImpresorasAsync(Caja.SucursalId))?.FirstOrDefault(i => i.Numero == numero)
                ?? throw new ErrorCaja($"La impresora {numero} ya no está: vuelve a abrir la Configuración.");
            guardada = await Cliente.CambiarImpresoraAsync(Caja.SucursalId, numero,
                new SolicitudCambioImpresora(Sesion.UsuarioId, cambio(actual.Estado.Configuracion)));
        }
        Poner(guardada);
        _avisoTexto = guardada.Estado.Configuracion.Host is null || guardada.Estado.Error is null ? null : "Guardado, pero la impresora no respondió.";
    }

    private async Task CambiarNombreAsync(int numero, string texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
            throw new ArgumentException("Escribe cómo se le dice a la impresora.");
        Poner(await Cliente.CambiarImpresoraAsync(Caja.SucursalId, numero, new SolicitudCambioImpresora(Sesion.UsuarioId, Nombre: texto)));
    }

    private async Task DarDeBajaAsync(int numero)
    {
        if (await HacerAsync(Campo(Baja, numero), async () =>
                Poner(await Cliente.CambiarImpresoraAsync(Caja.SucursalId, numero, new SolicitudCambioImpresora(Sesion.UsuarioId, Activa: false)))))
            (_porDarDeBaja, _avisoTexto) = (null, $"Dada de baja: ya no se lee, y lo que llegue de su cola se anota en la {Activas.FirstOrDefault()?.Nombre ?? "primera"}.");
        // Sus consumibles propios (la L5590) dejan de salir en los costos.
        await CargarCostosAsync();
    }

    private async Task DarDeAltaAsync(int numero)
    {
        await HacerAsync(Campo(Baja, numero), async () =>
        {
            Poner(await Cliente.CambiarImpresoraAsync(Caja.SucursalId, numero, new SolicitudCambioImpresora(Sesion.UsuarioId, Activa: true)));
            _calibraciones[numero] = await Cliente.CalibracionAsync(Caja.SucursalId, numero);
        });
        await CargarCostosAsync();
    }

    /// <summary>Enter en el nombre o la IP de la nueva la agrega, como en lo demás de la Configuración (teclado primero).</summary>
    private Task AlTeclearAlAgregarAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" && !string.IsNullOrWhiteSpace(_nuevaNombre) ? AgregarAsync() : Task.CompletedTask;

    private async Task AgregarAsync()
    {
        if (_agregando)
            return;
        (_agregando, _agregada) = (true, null);
        try
        {
            if (await HacerAsync(Agregar, async () =>
                {
                    var nueva = await Cliente.AgregarImpresoraAsync(Caja.SucursalId,
                        new SolicitudNuevaImpresora(Sesion.UsuarioId, _nuevaNombre, _nuevaPerfil, string.IsNullOrWhiteSpace(_nuevaHost) ? null : _nuevaHost));
                    Poner(nueva);
                    _sinNinguna = false;
                    _calibraciones[nueva.Numero] = await Cliente.CalibracionAsync(Caja.SucursalId, nueva.Numero);
                    _agregada = $"Agregada como la impresora {nueva.Numero}"
                        + (nueva.Estado.Error is not null ? ", pero no contestó (abajo dice qué revisar)" : "")
                        + $". Falta decirle a cada PC que imprime en ella cuál de sus colas es: hoy lo hace quien instaló la caja (en su caja.json, "
                        + $"con \"Impresora\": {nueva.Numero}); mientras, lo que se imprima en ella no llega a F2.";
                }))
                (_nuevaNombre, _nuevaHost) = ("", "");
            await CargarCostosAsync();
        }
        finally
        {
            _agregando = false;
        }
    }

