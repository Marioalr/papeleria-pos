@* Configuración › Impresoras e impresiones: cada impresora de la sucursal vista desde la caja principal (2026-11-03: varias; la matriz
   tiene dos WF-6590 y una L5590): sus niveles y su contador contra lo registrado, cómo se lee, su nombre y la calibración de su tinta
   (con «Configurar la impresora» de quien entró, sin volver a escribir su PIN: lo que se escribe se guarda solo, como lo demás de la
   Configuración nueva), agregar una y darla de baja; los costos de las impresiones (2026-10-31: los ve quien tiene «Ver costos,
   utilidad y margen» y los cambia quien además tiene «Configurar la impresora»; con Control Print vienen de allá y solo se ven; los
   consumibles propios de una impresora, como las botellas de la L5590, se cambian aquí aunque haya Control Print) y el desglose de las
   impresiones del día (para quien tiene «Consultar la bitácora»; el costo, con «Ver costos, utilidad y margen»). Con una sola impresora
   se ve como antes; con una caja principal de antes (sin varias impresoras), solo la suya. En una tienda sin ninguna todavía, la 1 con
   su campo de la IP: se da de alta al escribirla. *@
@inherits GuardadoAlMomento
@inject ClienteCaja Cliente
@inject IJSRuntime Js

@if (_impresoras is null)
{
    <p class="@(_error is null ? "vn-cfg-nota" : "vn-cfg-error")">@(_error ?? "Cargando…")</p>
}
else
{
    @if (Varias)
    {
        @* Con dos o más, la página es larga (revisión de #155, 2026-11-08): un índice corto arriba. *@
        <nav class="vn-cfg-indice" aria-label="En esta página">
            @foreach (var impresora in Activas)
            {
                var ancla = $"#impresora-{impresora.Numero}";
                <button class="vn-boton chico" @onclick="() => IrAAsync(ancla)">@impresora.Nombre</button>
            }
            @if (PuedeConfigurar && !_deAntes)
            {
                <button class="vn-boton chico" @onclick='() => IrAAsync("#agregar-impresora")'>Agregar una</button>
            }
            @if (VeCosto)
            {
                <button class="vn-boton chico" @onclick='() => IrAAsync("#costos-impresiones")'>Costos</button>
            }
            @if (VeElDia)
            {
                <button class="vn-boton chico" @onclick='() => IrAAsync("#impresiones-del-dia")'>Impresiones del día</button>
            }
        </nav>
    }
    @foreach (var impresora in Activas)
    {
        @Impresora(impresora)
    }

    @if (PuedeConfigurar && !_deAntes)
    {
        <h3 id="agregar-impresora">Agregar una impresora</h3>
        <div class="vn-ajustes">
            <div class="vn-ajuste">
                <div class="vn-ajuste-txt">
                    <strong>Otra impresora de inyección</strong>
                    <small>Con su nombre, su modelo y su IP. Cada PC dice en caja.json qué impresora es cada cola (su número).</small>
                    <span class="vn-ajuste-meta">Toda la tienda</span>
                    @if (_agregando)
                    {
                        @* Con su IP se lee al momento: si no contesta, son unos 12 s (revisión de #155, 2026-11-08). *@
                        <span class="vn-ajuste-meta" role="status">@(string.IsNullOrWhiteSpace(_nuevaHost) ? "Agregando la impresora…" : "Agregando y leyendo la impresora…")</span>
                    }
                    else if (ErrorDe(Agregar) is { } errorAgregar)
                    {
                        <span class="vn-ajuste-error" role="alert">@errorAgregar</span>
                    }
                    else if (_agregada is { } agregada)
                    {
                        <span class="vn-ajuste-meta" role="status">@agregada</span>
                    }
                </div>
                <div class="vn-ajuste-ctl abajo">
                    <span class="vn-ctl-texto">
                        <input id="impresora-nueva-nombre" placeholder="WF-6590 2" autocomplete="off" aria-label="Nombre de la impresora nueva"
                               maxlength="40" @bind="_nuevaNombre" @bind:event="oninput" @onkeydown="AlTeclearAlAgregarAsync" />
                    </span>
                    <span class="vn-segmento" role="radiogroup" aria-label="Modelo de la impresora nueva">
                        @foreach (var perfil in PerfilesImpresora.Todos)
                        {
                            var este = perfil.Clave;
                            var elegido = _nuevaPerfil == este;
                            <button id="impresora-nueva-@este" role="radio" aria-checked="@(elegido ? "true" : "false")" class="@(elegido ? "on x" : null)"
                                    @onclick="() => _nuevaPerfil = este">@perfil.NombreCorto</button>
                        }
                    </span>
                    <span class="vn-ctl-texto">
                        <input id="impresora-nueva-host" placeholder="192.168.1.50" autocomplete="off" spellcheck="false" aria-label="IP de la impresora nueva"
                               @bind="_nuevaHost" @bind:event="oninput" @onkeydown="AlTeclearAlAgregarAsync" />
                    </span>
                    <button class="vn-boton chico" disabled="@(_agregando || string.IsNullOrWhiteSpace(_nuevaNombre))" @onclick="AgregarAsync">Agregar</button>
                </div>
            </div>
        </div>
    }

    @if (DeBaja.Count > 0)
    {
        <h3>Dadas de baja</h3>
        <div class="vn-cfg-antes">
            @foreach (var impresora in DeBaja)
            {
                var numero = impresora.Numero;
                <p class="nota">
                    Impresora @impresora.Numero · @impresora.Nombre (@PerfilesImpresora.De(impresora.Perfil).NombreCorto): no se lee y lo que llega de su
                    cola se anota en la primera.
                    @if (PuedeConfigurar)
                    {
                        <button class="vn-boton chico" disabled="@_ocupado" @onclick="() => DarDeAltaAsync(numero)">Volver a darla de alta</button>
                    }
                </p>
                @if (ErrorDe(Campo(Baja, numero)) is { } errorAlta)
                {
                    @* Por qué no se pudo (su IP ya es de otra, por ejemplo): aquí, junto a su botón. *@
                    <p class="vn-cfg-error" role="alert">@errorAlta</p>
                }
            }
        </div>
    }

    @if (VeCosto)
    {
        <h3 id="costos-impresiones">Costos de las impresiones</h3>
        @if (_costos is not { } costos)
        {
            <p class="@(_errorCostos is null ? "vn-cfg-nota" : "vn-cfg-error")">@(_errorCostos ?? "Cargando…")</p>
        }
        else
        {
            var c = costos.Costos;
            <div class="vn-cfg-antes">
                <p class="nota">@DeDondeVienen(costos)</p>
                @if (costos.Aviso is { } avisoCostos)
                {
                    <p class="vn-cfg-error" role="alert">@avisoCostos</p>
                }
                @if (costos.Faltan.Count > 0)
                {
                    <p class="vn-cfg-error">Faltan precios (en cero, lo que se imprime sale de menos): @string.Join(", ", costos.Faltan).</p>
                }
                @if (ErrorDe(Costos) is { } errorCostos)
                {
                    <p class="vn-cfg-error" role="alert">@errorCostos</p>
                }
            </div>
            <table class="vn-cfg-tabla vn-costos">
                <thead><tr><th>Tinta</th><th class="num">Precio del cartucho</th><th class="num">Rinde</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < c.Cartuchos.Count; i++)
                    {
                        var cartucho = c.Cartuchos[i];
                        var fila = FilaCartucho(i);
                        var tinta = cartucho.Tinta.ToLowerInvariant();
                        <tr>
                            <td>@cartucho.Tinta</td>
                            <td class="num">@Campo(fila, "precio", $"costo-cartucho-{i}", $"Precio del cartucho {tinta}", Dinero(cartucho.Precio), "decimal", antes: "$")</td>
                            <td class="num">@Campo(fila, "rinde", $"costo-rinde-{i}", $"Lo que rinde el cartucho {tinta}", Entero(cartucho.Rendimiento), "numeric", despues: "páginas")</td>
                        </tr>
                    }
                    <tr>
                        <td>Caja de mantenimiento</td>
                        <td class="num">@Campo(FilaMantenimiento, "precio", "costo-mantenimiento", "Precio de la caja de mantenimiento", Dinero(c.CajaMantenimiento), "decimal", antes: "$")</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            @Avisos([.. Enumerable.Range(0, c.Cartuchos.Count).Select(FilaCartucho), FilaMantenimiento])
            @* Las impresoras con sus propios consumibles (2026-11-03: las botellas de la L5590): se cambian aquí aunque haya Control Print. *@
            @foreach (var propia in costos.Impresoras ?? [])
            {
                var deEsta = propia;
                <table class="vn-cfg-tabla vn-costos" id="costos-impresora-@propia.Numero">
                    <thead><tr><th>@(PerfilesImpresora.De(propia.Perfil).ConBotellas ? $"Botellas de la {propia.Nombre}" : $"Cartuchos de la {propia.Nombre}")</th><th class="num">Precio</th><th class="num">Rinde</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < propia.Tintas.Count; i++)
                        {
                            var tinta = propia.Tintas[i];
                            var fila = FilaTinta(propia.Numero, i);
                            var que = $"{tinta.Tinta.ToLowerInvariant()} de la {propia.Nombre}";
                            <tr>
                                <td>@tinta.Tinta</td>
                                <td class="num">@Campo(fila, "precio", $"costo-impresora-{propia.Numero}-{i}", $"Precio de la tinta {que}", Dinero(tinta.Precio), "decimal", antes: "$", puede: PuedeConfigurar)</td>
                                <td class="num">@Campo(fila, "rinde", $"costo-impresora-rinde-{propia.Numero}-{i}", $"Lo que rinde la tinta {que}", Entero(tinta.Rendimiento), "numeric", despues: "páginas", puede: PuedeConfigurar)</td>
                            </tr>
                        }
                        <tr>
                            @* Sin caja, sus campos vacíos: con su precio y lo que dura se le pone (la L5590, si en la tienda se ve que la tiene). *@
                            <td>Caja de mantenimiento@(propia.CajaMantenimiento is null ? " (no tiene)" : "")</td>
                            <td class="num">@Campo(FilaCajaDe(propia.Numero), "precio", $"costo-impresora-caja-{propia.Numero}", $"Precio de la caja de mantenimiento de la {propia.Nombre}", propia.CajaMantenimiento is { } caja ? Dinero(caja) : "", "decimal", antes: "$", puede: PuedeConfigurar)</td>
                            <td class="num">@Campo(FilaCajaDe(propia.Numero), "caras", $"costo-impresora-caja-caras-{propia.Numero}", $"Caras que dura la caja de mantenimiento de la {propia.Nombre}", propia.PaginasPorCaja is { } dura ? Entero(dura) : "", "numeric", despues: "caras", puede: PuedeConfigurar)</td>
                        </tr>
                    </tbody>
                </table>
                @Avisos([.. Enumerable.Range(0, deEsta.Tintas.Count).Select(i => FilaTinta(deEsta.Numero, i)), FilaCajaDe(deEsta.Numero)])
                @if (propia.Faltan.Count > 0)
                {
                    <p class="nota">Mientras le falte un precio, lo que sale de la @propia.Nombre se cobra como en una WF-6590 (con los cartuchos de arriba), nunca gratis.</p>
                }
            }
            <table class="vn-cfg-tabla vn-costos">
                <thead><tr><th>Papel</th><th class="num">Precio del paquete</th><th class="num">Hojas del paquete</th><th class="num">Por hoja</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < c.Papeles.Count; i++)
                    {
                        var papel = c.Papeles[i];
                        var fila = FilaPapel(i);
                        var nombre = NombrePapel(papel);
                        <tr>
                            <td>@nombre</td>
                            <td class="num">@Campo(fila, "precio", $"costo-papel-{i}", $"Precio del paquete de papel {nombre}", Dinero(papel.PrecioPaquete), "decimal", antes: "$")</td>
                            <td class="num">@Campo(fila, "hojas", $"costo-hojas-{i}", $"Hojas del paquete de papel {nombre}", Entero(papel.HojasPaquete), "numeric", despues: "hojas")</td>
                            <td class="num">@(papel.HojasPaquete > 0 ? (papel.PrecioPaquete / papel.HojasPaquete).ToString("$#,##0.00##", Formato.Mexico) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @Avisos([.. Enumerable.Range(0, c.Papeles.Count).Select(FilaPapel)])
            <div class="vn-ajustes">
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Margen</strong>
                        <small>El precio es el costo más el margen. Por tramos, como el mayoreo de Control Print: entre más cuesta, menos margen.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                    </div>
                    <span class="vn-segmento" role="radiogroup" aria-label="Margen">
                        @foreach (var (modo, texto) in Modos)
                        {
                            var este = modo;
                            var elegido = c.Margen == este;
                            <button id="costo-margen-@((int)este)" role="radio" aria-checked="@(elegido ? "true" : "false")" class="@(elegido ? "on x" : null)"
                                    disabled="@(!costos.PuedeCambiar)" @onclick="() => ElegirAsync(x => x with { Margen = este })">@texto</button>
                        }
                    </span>
                </div>
                @if (c.Margen == MargenDeImpresiones.Unico)
                {
                    <div class="vn-ajuste">
                        <div class="vn-ajuste-txt">
                            <strong>Margen para todo</strong><span class="vn-ajuste-meta">Toda la tienda</span>
                            @AvisoDe(FilaMargenUnico)
                        </div>
                        @Campo(FilaMargenUnico, "margen", "costo-margen-unico", "Margen para todo", Porcentaje(c.MargenUnico), "decimal", despues: "%")
                    </div>
                }
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Margen del papel</strong>
                        <small>El papel suele llevar menos ganancia que la tinta. Vacío: el mismo margen que lo demás.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                        @AvisoDe(FilaMargenPapel)
                    </div>
                    @Campo(FilaMargenPapel, "margen", "costo-margen-papel", "Margen del papel", c.MargenPapel is { } margenPapel ? Porcentaje(margenPapel) : "",
                        "decimal", despues: "%", marcador: "El mismo")
                </div>
            </div>
            @if (c.Margen != MargenDeImpresiones.Unico)
            {
                var porTrabajo = c.Margen == MargenDeImpresiones.PorCostoDelTrabajo;
                var tramos = porTrabajo ? c.TramosPorTrabajo : c.TramosPorHoja;
                <table class="vn-cfg-tabla vn-costos">
                    <thead><tr><th>@(porTrabajo ? "Desde un costo del trabajo de" : "Desde un costo por hoja de")</th><th class="num">Margen</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < tramos.Count; i++)
                        {
                            // Cada renglón es su tramo (por su «desde» guardado), no su lugar: al guardar se reordenan (segunda revisión).
                            var fila = FilaTramo(porTrabajo, tramos[i].Desde);
                            <tr @key="fila.Id">
                                <td>@Campo(fila, "desde", $"costo-tramo-desde-{i}", "Desde", Dinero(tramos[i].Desde), "decimal", antes: "$")</td>
                                <td class="num">@Campo(fila, "margen", $"costo-tramo-margen-{i}", "Margen del tramo", Porcentaje(tramos[i].Margen), "decimal", despues: "%")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @Avisos([.. tramos.Select(t => FilaTramo(porTrabajo, t.Desde))])
            }
            <div class="vn-ajustes">
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Cobro mínimo</strong>
                        <small>Si el precio sale menor, se cobra este.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                        @AvisoDe(FilaMinimo)
                    </div>
                    <div class="vn-ajuste-ctl">
                        @Campo(FilaMinimo, "minimo", "costo-minimo", "Cobro mínimo", Dinero(c.CobroMinimo), "decimal", antes: "$")
                        <span class="vn-segmento" role="radiogroup" aria-label="A qué se cobra el mínimo">
                            @foreach (var (todos, texto) in new[] { (false, "A lo de una cara"), (true, "A todo") })
                            {
                                var aTodo = todos;
                                var elegido = c.MinimoATodos == aTodo;
                                <button role="radio" aria-checked="@(elegido ? "true" : "false")" class="@(elegido ? "on x" : null)" disabled="@(!costos.PuedeCambiar)"
                                        @onclick="() => ElegirAsync(x => x with { MinimoATodos = aTodo })">@texto</button>
                            }
                        </span>
                    </div>
                </div>
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Redondear el precio a</strong>
                        <small>Hacia arriba: $1.00 son pesos cerrados; $0, al centavo.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                        @AvisoDe(FilaRedondeo)
                    </div>
                    @Campo(FilaRedondeo, "redondeo", "costo-redondeo", "Redondear el precio a", Dinero(c.RedondeoA), "decimal", antes: "$")
                </div>
            </div>
        }
    }

    @if (VeElDia)
    {
        <h3 id="impresiones-del-dia">Impresiones del día</h3>
        <div class="vn-cfg-antes">
            <div class="vn-cfg-filtros">
                <label>Día <input type="date" @bind="_fecha" @bind:after="CargarDiaAsync" /></label>
            </div>
            @if (_dia is { } dia)
            {
                <p>
                    Cobradas @Formato.Dinero(dia.Where(t => t.Cobro == EstadoCobroImpresion.Cobrada).Sum(t => t.PrecioCentavos))
                    · por cobrar @Formato.Dinero(dia.Where(t => t.Cobro == EstadoCobroImpresion.PorCobrar).Sum(t => t.PrecioCentavos))
                    · no vendidas @dia.Count(t => t.Cobro == EstadoCobroImpresion.NoVendida)
                    @if (VeCosto)
                    {
                        <span> · costo de todo @Formato.Dinero(dia.Sum(t => t.Costo?.TotalCentavos ?? 0))</span>
                    }
                </p>
                <div class="resultados">
                    <table>
                        <thead><tr><th>Hora</th><th>Documento</th><th>PC</th>@if (ConImpresora) {<th>Impresora</th>}<th class="num">Caras</th><th class="num">Precio</th><th>Cobro</th>@if (VeCosto) {<th class="num">Costo</th>}</tr></thead>
                        @foreach (var t in dia)
                        {
                            <tr>
                                <td>@t.FechaLocal.ToString("HH:mm")</td>
                                <td>@(t.Tipo == TipoTrabajoImpresion.Copia ? "Copias: " : "")@t.Documento</td>
                                <td>@t.Pc@(t.Atendio is { } a ? $" · {a}" : "")</td>
                                @if (ConImpresora)
                                {
                                    <td>@t.Impresora</td>
                                }
                                <td class="num">@(t.CarasContadas is { } c && c < t.Caras ? $"{c} de {t.Caras}" : t.Caras.ToString())</td>
                                <td class="num">@Formato.Dinero(t.PrecioCentavos)</td>
                                <td>@Cobro(t)</td>
                                @if (t.Costo is { } costo)
                                {
                                    <td class="num">@Formato.Dinero(costo.TotalCentavos)</td>
                                }
                            </tr>
                        }
                    </table>
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <p class="vn-cfg-error" role="alert">@_error</p>
    }
    @if (_avisoTexto is not null)
    {
        <p class="vn-cfg-aviso" role="status">@_avisoTexto</p>
    }
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Se guardó un cambio: la Configuración dice a qué hora.</summary>
    [Parameter] public EventCallback AlGuardar { get; set; }

    /// <summary>Al cerrar no se pudo guardar lo que quedó escrito: por qué.</summary>
    [Parameter] public EventCallback<string> AlNoGuardar { get; set; }

    // Los campos de la impresora 1 conservan los nombres de antes; los de las demás llevan su número («impresora-host-2»).
    private const string Host = "impresora-host";
    private const string Aviso = "impresora-aviso";
    private const string Minutos = "impresora-minutos";
    private const string Nombre = "impresora-nombre";
    private const string FactorCotizar = "impresora-factor-cotizar";
    private const string Calibracion = "impresora-calibracion";
    private const string Baja = "impresora-baja";
    private const string Agregar = "impresora-agregar";

    private static string Campo(string campo, int numero) => numero == 1 ? campo : $"{campo}-{numero}";

    /// <summary>El renglón de los costos: ahí se dice si algo no se pudo guardar.</summary>
    private const string Costos = "impresora-costos";

    /// <summary>Las impresoras de la sucursal (también las de baja), por su número; vacío mientras se leen.</summary>
    private List<ImpresoraDto>? _impresoras;

    /// <summary>La caja principal es de antes de varias impresoras: tiene una sola y se cambia con lo de siempre.</summary>
    private bool _deAntes;

    /// <summary>
    /// La sucursal no tiene ninguna todavía (una tienda nueva): se enseña la 1 sin darla de alta, como antes, y se da de alta al escribir su IP
    /// (lo de siempre la crea) o al agregar una.
    /// </summary>
    private bool _sinNinguna;

    /// <summary>Se habla con lo de siempre (<c>/impresora</c>): la caja principal es de antes, o la impresora 1 todavía no existe.</summary>
    private bool ConLoDeSiempre => _deAntes || _sinNinguna;

    /// <summary>La calibración de cada impresora (por su número), para quien la configura.</summary>
    private readonly Dictionary<int, CalibracionDto> _calibraciones = [];

    private List<ImpresionDelDiaDto>? _dia;
    private DateOnly _fecha = DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow));
    private string? _error;
    private string? _avisoTexto;
    private bool _ocupado;

    /// <summary>La impresora cuya calibración se preguntó si se aplica.</summary>
    private int? _porAplicar;

    /// <summary>Mientras se aplica: un doble clic la aplicaría dos veces.</summary>
    private bool _aplicando;

    /// <summary>La impresora que se preguntó si se da de baja.</summary>
    private int? _porDarDeBaja;

    private string _nuevaNombre = "";
    private PerfilImpresora _nuevaPerfil = PerfilImpresora.WF6590;
    private string _nuevaHost = "";
    private bool _agregando;

    /// <summary>Lo que dice al agregar una, junto a «Agregar» (la página es larga: abajo no se vería).</summary>
    private string? _agregada;

    private ModuloCaja? _modulo;

    /// <summary>Lleva a una parte de la página (el índice de arriba).</summary>
    private async Task IrAAsync(string selector) => await (_modulo ??= new ModuloCaja(Js)).IrAAsync(selector);

    private List<ImpresoraDto> Activas => _impresoras?.Where(i => i.Activa).ToList() ?? [];

