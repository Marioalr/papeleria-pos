@* Configuración › Impresoras e impresiones: la impresora vista desde la caja principal (niveles, contador contra lo
   registrado), cómo se lee y la calibración de la tinta (con «Configurar la impresora» de quien entró, sin volver a escribir
   su PIN: lo que se escribe se guarda solo, como lo demás de la Configuración nueva), los costos de las impresiones (2026-10-31:
   los ve quien tiene «Ver costos, utilidad y margen» y los cambia quien además tiene «Configurar la impresora»; con Control Print
   vienen de allá y solo se ven) y el desglose de las impresiones del día (para quien tiene «Consultar la bitácora»; el costo, con
   «Ver costos, utilidad y margen»). *@
@inherits GuardadoAlMomento
@inject ClienteCaja Cliente

@if (_estado is null)
{
    <p class="@(_error is null ? "vn-cfg-nota" : "vn-cfg-error")">@(_error ?? "Cargando…")</p>
}
else
{
    <div class="vn-cfg-antes">
        @if (_estado.Configuracion.Host is null)
        {
            <p class="nota">Escribe la IP de la impresora (la WF-6590) para leer sus niveles y su contador desde la caja principal.</p>
        }
        else if (_estado.Ultima is { } u)
        {
            <div class="niveles">
                @foreach (var (nombre, nivel, color) in Niveles(u))
                {
                    <div class="nivel @(nivel <= _estado.Configuracion.AvisoTintaPorcentaje ? "bajo" : "")">
                        <span>@nombre: <strong>@(nivel is { } n ? $"{n} %" : "—")</strong></span>
                        <div class="barra"><span style="width: @(nivel ?? 0)%; background: @color"></span></div>
                    </div>
                }
            </div>
            <p class="nota">
                Leída a las @u.TomadaLocal.ToString("HH:mm") del @u.TomadaLocal.ToString("dd/MM")
                @(u.Contador is { } c ? $" · contador {c:N0} caras" : "")@(u.ContadorColor is { } cc ? $" ({cc:N0} color, {u.ContadorBN:N0} B/N)" : "")
                @(u.Serie is { } s ? $" · serie {s}" : "")
            </p>
        }
        @if (_estado.Error is { } error)
        {
            <p class="error">No respondió: @error</p>
        }
        @if (_estado.Hoy is { } hoy)
        {
            <p>
                Hoy, desde las @hoy.DesdeLocal.ToString("HH:mm"), la impresora contó <strong>@hoy.Contadas.ToString("N0")</strong> caras; registradas
                @((hoy.CarasImpresas + hoy.CarasCopias).ToString("N0")) (@hoy.CarasImpresas.ToString("N0") desde las PC y @hoy.CarasCopias.ToString("N0") en copias cobradas).
                @if (hoy.SinRegistrar == 0)
                {
                    <span>No hay caras sin registrar.</span>
                }
                else
                {
                    <strong class="salieron">Sin registrar: @hoy.SinRegistrar.ToString("N0")@(hoy.SinRegistrarColor is { } sc ? $" ({hoy.SinRegistrar - sc:N0} B/N y {sc:N0} color)" : "")</strong>
                    <span class="nota">: copias sin cobrar, impresiones desde el celular o páginas de prueba.</span>
                }
            </p>
        }
        <div class="vn-botonera">
            <button class="vn-boton chico" disabled="@(_ocupado || _estado.Configuracion.Host is null)" @onclick="LeerAsync">Leer ahora</button>
        </div>
    </div>

    @if (PuedeConfigurar)
    {
        <h3>Cómo se lee</h3>
        <div class="vn-ajustes">
            <div class="vn-ajuste">
                <div class="vn-ajuste-txt">
                    <strong>IP de la impresora</strong>
                    <small>La WF-6590 en la red: la lee la caja principal.</small>
                    <span class="vn-ajuste-meta">Toda la tienda</span>
                    @if (ErrorDe(Host) is { } errorHost)
                    {
                        <span class="vn-ajuste-error" role="alert">@errorHost</span>
                    }
                </div>
                <span class="vn-ctl-texto">
                    <input id="impresora-host" placeholder="192.168.1.50" autocomplete="off" spellcheck="false" aria-label="IP de la impresora"
                           value="@Escrito(Host, _estado.Configuracion.Host ?? "")"
                           @oninput="e => Escribir(Host, e.Value, GuardarHostAsync, conPausa: false)"
                           @onblur="() => SalirAsync(Host)" @onkeydown="e => AlTeclearAsync(e, Host)" />
                </span>
            </div>
            <div class="vn-ajuste">
                <div class="vn-ajuste-txt">
                    <strong>Avisar con tinta en</strong>
                    <small>Con la tinta o la caja de mantenimiento en este porcentaje o menos, se avisa al dueño.</small>
                    <span class="vn-ajuste-meta">Toda la tienda</span>
                    @if (ErrorDe(Aviso) is { } errorAviso)
                    {
                        <span class="vn-ajuste-error" role="alert">@errorAviso</span>
                    }
                </div>
                <span class="vn-ctl-num">
                    <input id="impresora-aviso" inputmode="numeric" autocomplete="off" aria-label="Avisar con tinta en (por ciento)"
                           value="@Escrito(Aviso, _estado.Configuracion.AvisoTintaPorcentaje.ToString(CultureInfo.InvariantCulture))"
                           @oninput="e => Escribir(Aviso, e.Value, GuardarAvisoAsync, conPausa: false)"
                           @onblur="() => SalirAsync(Aviso)" @onkeydown="e => AlTeclearAsync(e, Aviso)" />% o menos
                </span>
            </div>
            <div class="vn-ajuste">
                <div class="vn-ajuste-txt">
                    <strong>Leer la impresora cada</strong>
                    <span class="vn-ajuste-meta">Toda la tienda</span>
                    @if (ErrorDe(Minutos) is { } errorMinutos)
                    {
                        <span class="vn-ajuste-error" role="alert">@errorMinutos</span>
                    }
                </div>
                <span class="vn-ctl-num">
                    <input id="impresora-minutos" inputmode="numeric" autocomplete="off" aria-label="Leer la impresora cada (minutos)"
                           value="@Escrito(Minutos, _estado.Configuracion.MinutosEntreLecturas.ToString(CultureInfo.InvariantCulture))"
                           @oninput="e => Escribir(Minutos, e.Value, GuardarMinutosAsync, conPausa: false)"
                           @onblur="() => SalirAsync(Minutos)" @onkeydown="e => AlTeclearAsync(e, Minutos)" />minutos
                </span>
            </div>
        </div>

        <h3>Calibración de la tinta</h3>
        @if (_calibracion is { } cal)
        {
            <div class="vn-cfg-antes">
                <p class="nota">
                    Lo que bajaron los niveles en la impresora contra lo que estimó el cálculo@(cal.DesdeLocal is { } d ? $", desde el {d:dd/MM}" : "").
                    La impresora contó @cal.CarasImpresora.ToString("N0") caras y el POS registró @cal.CarasRegistradas.ToString("N0").
                    @(cal.AplicadaLocal is { } a ? $"Última aplicada: {a:dd/MM HH:mm}." : "Todavía no se ha aplicado.")
                </p>
                <table class="resultados">
                    <thead><tr><th>Tinta</th><th class="num">Bajó en la impresora</th><th class="num">Estimado</th><th class="num">Corrección</th><th class="num">Actual</th><th>Datos</th></tr></thead>
                    @foreach (var c in cal.Canales)
                    {
                        <tr>
                            <td>@c.Canal</td>
                            <td class="num">@c.Observado.ToString("0.#") puntos</td>
                            <td class="num">@c.Estimado.ToString("0.#") puntos</td>
                            <td class="num">× @c.Factor.ToString("0.000")</td>
                            <td class="num">× @c.Actual.ToString("0.000")</td>
                            <td>@c.Calidad</td>
                        </tr>
                    }
                </table>
                <p class="nota">
                    Caja de mantenimiento: @(cal.PaginasPorCaja is { } p ? $"{p:N0} caras por caja según la impresora" : "todavía sin datos")
                    (hoy se calcula con @cal.PaginasPorCajaActual.ToString("N0")).
                </p>
                @foreach (var cambio in cal.Cambios)
                {
                    <p class="nota">Cambio: @cambio</p>
                }
                <p class="nota">Mientras el agente vigile la cola de laboratorio, lo registrado no sale de la impresora: no apliques la calibración hasta usar la cola real.</p>
            </div>
            @if (ErrorDe(Calibracion) is { } errorCalibracion)
            {
                <p class="vn-cfg-error" role="alert">@errorCalibracion</p>
            }
            @* Antes la confirmaba el PIN: ahora se pregunta aquí mismo, porque cambia el costo de lo que se imprima. *@
            <div class="vn-botonera">
                @if (_porAplicar)
                {
                    <span class="vn-cfg-pregunta">
                        Las impresiones nuevas salen con esta corrección.
                        <button class="vn-boton chico primario" disabled="@(_ocupado || _aplicando)" @onclick="AplicarCalibracionAsync">Aplicar</button>
                        <button class="vn-boton chico" disabled="@(_ocupado || _aplicando)" @onclick="() => _porAplicar = false">No</button>
                    </span>
                }
                else
                {
                    <button class="vn-boton chico" disabled="@(_ocupado || _aplicando)" @onclick="() => _porAplicar = true">Aplicar la corrección</button>
                }
            </div>
        }
    }

    @if (VeCosto)
    {
        <h3 id="costos-impresiones">Costos de las impresiones</h3>
        @if (_costos is not { } costos)
        {
            <p class="@(_errorCostos is null ? "vn-cfg-nota" : "vn-cfg-error")">@(_errorCostos ?? "Cargando…")</p>
        }
        else
        {
            var c = costos.Costos;
            <div class="vn-cfg-antes">
                <p class="nota">@DeDondeVienen(costos)</p>
                @if (costos.Aviso is { } avisoCostos)
                {
                    <p class="vn-cfg-error" role="alert">@avisoCostos</p>
                }
                @if (costos.Faltan.Count > 0)
                {
                    <p class="vn-cfg-error">Faltan precios (en cero, lo que se imprime sale de menos): @string.Join(", ", costos.Faltan).</p>
                }
                @if (ErrorDe(Costos) is { } errorCostos)
                {
                    <p class="vn-cfg-error" role="alert">@errorCostos</p>
                }
            </div>
            <table class="vn-cfg-tabla vn-costos">
                <thead><tr><th>Tinta</th><th class="num">Precio del cartucho</th><th class="num">Rinde</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < c.Cartuchos.Count; i++)
                    {
                        var cartucho = c.Cartuchos[i];
                        var fila = FilaCartucho(i);
                        var tinta = cartucho.Tinta.ToLowerInvariant();
                        <tr>
                            <td>@cartucho.Tinta</td>
                            <td class="num">@Campo(fila, "precio", $"costo-cartucho-{i}", $"Precio del cartucho {tinta}", Dinero(cartucho.Precio), "decimal", antes: "$")</td>
                            <td class="num">@Campo(fila, "rinde", $"costo-rinde-{i}", $"Lo que rinde el cartucho {tinta}", Entero(cartucho.Rendimiento), "numeric", despues: "páginas")</td>
                        </tr>
                    }
                    <tr>
                        <td>Caja de mantenimiento</td>
                        <td class="num">@Campo(FilaMantenimiento, "precio", "costo-mantenimiento", "Precio de la caja de mantenimiento", Dinero(c.CajaMantenimiento), "decimal", antes: "$")</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <table class="vn-cfg-tabla vn-costos">
                <thead><tr><th>Papel</th><th class="num">Precio del paquete</th><th class="num">Hojas del paquete</th><th class="num">Por hoja</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < c.Papeles.Count; i++)
                    {
                        var papel = c.Papeles[i];
                        var fila = FilaPapel(i);
                        var nombre = NombrePapel(papel);
                        <tr>
                            <td>@nombre</td>
                            <td class="num">@Campo(fila, "precio", $"costo-papel-{i}", $"Precio del paquete de papel {nombre}", Dinero(papel.PrecioPaquete), "decimal", antes: "$")</td>
                            <td class="num">@Campo(fila, "hojas", $"costo-hojas-{i}", $"Hojas del paquete de papel {nombre}", Entero(papel.HojasPaquete), "numeric", despues: "hojas")</td>
                            <td class="num">@(papel.HojasPaquete > 0 ? (papel.PrecioPaquete / papel.HojasPaquete).ToString("$#,##0.00##", Formato.Mexico) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="vn-ajustes">
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Margen</strong>
                        <small>El precio es el costo más el margen. Por tramos, como el mayoreo de Control Print: entre más cuesta, menos margen.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                    </div>
                    <span class="vn-segmento" role="radiogroup" aria-label="Margen">
                        @foreach (var (modo, texto) in Modos)
                        {
                            var este = modo;
                            var elegido = c.Margen == este;
                            <button id="costo-margen-@((int)este)" role="radio" aria-checked="@(elegido ? "true" : "false")" class="@(elegido ? "on x" : null)"
                                    disabled="@(!costos.PuedeCambiar)" @onclick="() => ElegirAsync(x => x with { Margen = este })">@texto</button>
                        }
                    </span>
                </div>
                @if (c.Margen == MargenDeImpresiones.Unico)
                {
                    <div class="vn-ajuste">
                        <div class="vn-ajuste-txt"><strong>Margen para todo</strong><span class="vn-ajuste-meta">Toda la tienda</span></div>
                        @Campo(FilaMargenUnico, "margen", "costo-margen-unico", "Margen para todo", Porcentaje(c.MargenUnico), "decimal", despues: "%")
                    </div>
                }
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Margen del papel</strong>
                        <small>El papel suele llevar menos ganancia que la tinta. Vacío: el mismo margen que lo demás.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                    </div>
                    @Campo(FilaMargenPapel, "margen", "costo-margen-papel", "Margen del papel", c.MargenPapel is { } margenPapel ? Porcentaje(margenPapel) : "",
                        "decimal", despues: "%", marcador: "El mismo")
                </div>
            </div>
            @if (c.Margen != MargenDeImpresiones.Unico)
            {
                var porTrabajo = c.Margen == MargenDeImpresiones.PorCostoDelTrabajo;
                var tramos = porTrabajo ? c.TramosPorTrabajo : c.TramosPorHoja;
                <table class="vn-cfg-tabla vn-costos">
                    <thead><tr><th>@(porTrabajo ? "Desde un costo del trabajo de" : "Desde un costo por hoja de")</th><th class="num">Margen</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < tramos.Count; i++)
                        {
                            var fila = FilaTramo(porTrabajo, i);
                            <tr>
                                <td>@Campo(fila, "desde", $"costo-tramo-desde-{i}", "Desde", Dinero(tramos[i].Desde), "decimal", antes: "$")</td>
                                <td class="num">@Campo(fila, "margen", $"costo-tramo-margen-{i}", "Margen del tramo", Porcentaje(tramos[i].Margen), "decimal", despues: "%")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="vn-ajustes">
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Cobro mínimo</strong>
                        <small>Si el precio sale menor, se cobra este.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                    </div>
                    <div class="vn-ajuste-ctl">
                        @Campo(FilaMinimo, "minimo", "costo-minimo", "Cobro mínimo", Dinero(c.CobroMinimo), "decimal", antes: "$")
                        <span class="vn-segmento" role="radiogroup" aria-label="A qué se cobra el mínimo">
                            @foreach (var (todos, texto) in new[] { (false, "A lo de una cara"), (true, "A todo") })
                            {
                                var aTodo = todos;
                                var elegido = c.MinimoATodos == aTodo;
                                <button role="radio" aria-checked="@(elegido ? "true" : "false")" class="@(elegido ? "on x" : null)" disabled="@(!costos.PuedeCambiar)"
                                        @onclick="() => ElegirAsync(x => x with { MinimoATodos = aTodo })">@texto</button>
                            }
                        </span>
                    </div>
                </div>
                <div class="vn-ajuste">
                    <div class="vn-ajuste-txt">
                        <strong>Redondear el precio a</strong>
                        <small>Hacia arriba: $1.00 son pesos cerrados; $0, al centavo.</small>
                        <span class="vn-ajuste-meta">Toda la tienda</span>
                    </div>
                    @Campo(FilaRedondeo, "redondeo", "costo-redondeo", "Redondear el precio a", Dinero(c.RedondeoA), "decimal", antes: "$")
                </div>
            </div>
        }
    }

    @if (VeElDia)
    {
        <h3>Impresiones del día</h3>
        <div class="vn-cfg-antes">
            <div class="vn-cfg-filtros">
                <label>Día <input type="date" @bind="_fecha" @bind:after="CargarDiaAsync" /></label>
            </div>
            @if (_dia is { } dia)
            {
                <p>
                    Cobradas @Formato.Dinero(dia.Where(t => t.Cobro == EstadoCobroImpresion.Cobrada).Sum(t => t.PrecioCentavos))
                    · por cobrar @Formato.Dinero(dia.Where(t => t.Cobro == EstadoCobroImpresion.PorCobrar).Sum(t => t.PrecioCentavos))
                    · no vendidas @dia.Count(t => t.Cobro == EstadoCobroImpresion.NoVendida)
                    @if (VeCosto)
                    {
                        <span> · costo de todo @Formato.Dinero(dia.Sum(t => t.Costo?.TotalCentavos ?? 0))</span>
                    }
                </p>
                <div class="resultados">
                    <table>
                        <thead><tr><th>Hora</th><th>Documento</th><th>PC</th><th class="num">Caras</th><th class="num">Precio</th><th>Cobro</th>@if (VeCosto) {<th class="num">Costo</th>}</tr></thead>
                        @foreach (var t in dia)
                        {
                            <tr>
                                <td>@t.FechaLocal.ToString("HH:mm")</td>
                                <td>@(t.Tipo == TipoTrabajoImpresion.Copia ? "Copias: " : "")@t.Documento</td>
                                <td>@t.Pc@(t.Atendio is { } a ? $" · {a}" : "")</td>
                                <td class="num">@(t.CarasContadas is { } c && c < t.Caras ? $"{c} de {t.Caras}" : t.Caras.ToString())</td>
                                <td class="num">@Formato.Dinero(t.PrecioCentavos)</td>
                                <td>@Cobro(t)</td>
                                @if (t.Costo is { } costo)
                                {
                                    <td class="num">@Formato.Dinero(costo.TotalCentavos)</td>
                                }
                            </tr>
                        }
                    </table>
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <p class="vn-cfg-error" role="alert">@_error</p>
    }
    @if (_avisoTexto is not null)
    {
        <p class="vn-cfg-aviso" role="status">@_avisoTexto</p>
    }
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Se guardó un cambio: la Configuración dice a qué hora.</summary>
    [Parameter] public EventCallback AlGuardar { get; set; }

    /// <summary>Al cerrar no se pudo guardar lo que quedó escrito: por qué.</summary>
    [Parameter] public EventCallback<string> AlNoGuardar { get; set; }

    private const string Host = "impresora-host";
    private const string Aviso = "impresora-aviso";
    private const string Minutos = "impresora-minutos";
    private const string Calibracion = "impresora-calibracion";

    /// <summary>El renglón de los costos: ahí se dice si algo no se pudo guardar.</summary>
    private const string Costos = "impresora-costos";

    private EstadoImpresoraDto? _estado;
    private CalibracionDto? _calibracion;
    private List<ImpresionDelDiaDto>? _dia;
    private DateOnly _fecha = DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow));
    private string? _error;
    private string? _avisoTexto;
    private bool _ocupado;

    /// <summary>Se preguntó si se aplica la calibración.</summary>
    private bool _porAplicar;

    /// <summary>Mientras se aplica: un doble clic la aplicaría dos veces.</summary>
    private bool _aplicando;

    /// <summary>La última consulta del desglose: una más vieja que llegue después no la tapa (al cambiar el día por partes).</summary>
    private int _consultaDia;

    /// <summary>Los costos de la sucursal, si quien entró los ve; vacío mientras se leen (o si no se pudo).</summary>
    private EstadoCostosImpresionDto? _costos;

    private string? _errorCostos;

    private static readonly (MargenDeImpresiones Modo, string Texto)[] Modos =
    [
        (MargenDeImpresiones.Unico, "Uno para todo"),
        (MargenDeImpresiones.PorCostoDelTrabajo, "Por el costo del trabajo"),
        (MargenDeImpresiones.PorCostoDeLaHoja, "Por el costo de cada hoja"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await HacerAsync(async () =>
        {
            Mostrar(await Cliente.ImpresoraAsync(Caja.SucursalId));
            _calibracion = await Cliente.CalibracionAsync(Caja.SucursalId);
        });
        await CargarCostosAsync();
        await CargarDiaAsync();
    }

    // ── Los costos (2026-10-31) ──────────────────────────────────────────────

    private async Task CargarCostosAsync()
    {
        if (!VeCosto)
            return;
        try
        {
            _costos = await Cliente.CostosImpresionAsync(Caja.SucursalId, Sesion.UsuarioId);
            _errorCostos = _costos is null ? "La caja principal es de una versión de antes: ahí no se ven los costos." : null;
        }
        catch (ErrorCaja ex)
        {
            _errorCostos = ex.Message;
        }
    }

    /// <summary>«Vienen de Control Print, leídos a las 10:42…» o «Los de esta tienda…».</summary>
    private static string DeDondeVienen(EstadoCostosImpresionDto c)
    {
        if (c.DeControlPrint)
            return $"Vienen de Control Print{(c.LeidosLocal is { } leidos ? $", leídos a las {leidos:HH:mm} del {leidos:dd/MM}" : ", que todavía no los da desde que arrancó la caja principal")}"
                + $" (guardados aquí{(c.GuardadosLocal is { } g ? $" el {g:dd/MM} a las {g:HH:mm}" : "")}): se leen de allá y se guardan solos, así que aquí solo se ven. "
                + "Se cambian en Control Print, en Ajustes → Costos.";
        return "Con ellos se pone precio a cada impresión, a las copias del panel y a lo que se cotiza. Lo que cambies se guarda solo y los de antes "
            + "se quedan en su historial" + (c.GuardadosLocal is { } guardados ? $"; el último cambio fue el {guardados:dd/MM} a las {guardados:HH:mm}." : ".")
            + (c.PuedeCambiar ? "" : " Los cambia quien tiene «Configurar la impresora».");
    }

    /// <summary>
    /// Un cambio a los costos sobre como están ahora en el servicio (no sobre lo que se leyó al abrir: otra caja los pudo cambiar).
    /// El servicio revisa los permisos y lo que no sirve.
    /// </summary>
    private async Task GuardarCostosAsync(Func<CostosImpresionDto, CostosImpresionDto> cambio)
    {
        var actual = await Cliente.CostosImpresionAsync(Caja.SucursalId, Sesion.UsuarioId)
            ?? throw new ErrorCaja("La caja principal es de una versión de antes: ahí no se cambian los costos.");
        _costos = await Cliente.GuardarCostosImpresionAsync(Caja.SucursalId, new SolicitudCostosImpresion(Sesion.UsuarioId, cambio(actual.Costos)));
    }

    /// <summary>Lo que se elige (el margen, a qué se cobra el mínimo): al momento, en su turno, después de lo escrito en los renglones.</summary>
    private async Task ElegirAsync(Func<CostosImpresionDto, CostosImpresionDto> cambio)
    {
        await GuardarFilasAsync();
        await HacerAsync(Costos, () => GuardarCostosAsync(cambio));
    }

    private static IReadOnlyList<T> Cambiar<T>(IReadOnlyList<T> lista, int indice, T nuevo) =>
        lista.Select((x, i) => i == indice ? nuevo : x).ToList();

    private static CostosImpresionDto ConTramo(CostosImpresionDto c, bool porTrabajo, int indice, Func<TramoMargenDto, TramoMargenDto> cambio) =>
        porTrabajo
            ? c with { TramosPorTrabajo = Cambiar(c.TramosPorTrabajo, indice, cambio(c.TramosPorTrabajo[indice])) }
            : c with { TramosPorHoja = Cambiar(c.TramosPorHoja, indice, cambio(c.TramosPorHoja[indice])) };

    private static string NombrePapel(PapelCostoDto p) => p.Grupo == "Normal" ? $"{p.Tamano} normal" : $"{p.Tamano} · {p.Grupo}";

    private static string Dinero(decimal valor) => valor.ToString("#,##0.00##", Formato.Mexico);

    private static string Entero(int valor) => valor.ToString("#,##0", Formato.Mexico);

    private static string Porcentaje(decimal valor) => valor.ToString("0.##", Formato.Mexico);

    // ── Un renglón a la vez (revisión del 2026-10-31) ──

    /// <summary>
    /// Un renglón de los costos: un cartucho (su precio y lo que rinde), un papel (su paquete y sus hojas), un tramo (desde y su margen)
    /// o un ajuste suelto. Lo que se escribe en sus campos se guarda junto: al salir del renglón, con Enter o tras una pausa después de lo
    /// último que se escribió en él. Así lo que se imprime en medio no sale con un renglón a medias, y cada vez que se guarda queda un
    /// solo renglón en el historial y uno en la bitácora.
    /// </summary>
    /// <param name="Aplicar">
    /// Lo escrito, por campo, sobre los costos como están ahora en el servicio (lo que no se escribió se queda); si algo no sirve,
    /// <see cref="ArgumentException"/> con el porqué.
    /// </param>
    private sealed record Fila(string Id, Func<CostosImpresionDto, IReadOnlyDictionary<string, string>, CostosImpresionDto> Aplicar);

    /// <summary>Sin teclear este rato, lo escrito en un renglón se guarda aunque el cursor siga en él.</summary>
    private static readonly TimeSpan PausaEnLaFila = TimeSpan.FromSeconds(2);

    /// <summary>Al salir de un campo: si en este rato el cursor no pasó a otro campo del mismo renglón, el renglón se guarda.</summary>
    private static readonly TimeSpan AlDejarLaFila = TimeSpan.FromMilliseconds(250);

    /// <summary>Lo escrito en cada renglón que todavía no se guarda: el renglón y el texto de cada campo.</summary>
    private readonly Dictionary<string, (Fila Fila, Dictionary<string, string> Campos)> _escritoEnFila = [];

    private readonly Dictionary<string, CancellationTokenSource> _esperaDeFila = [];

    /// <summary>El renglón donde está el cursor; vacío: ninguno de los costos.</summary>
    private string? _filaConFoco;

    private Fila FilaCartucho(int i) => new($"cartucho-{i}", (c, escrito) =>
    {
        var cartucho = c.Cartuchos[i];
        var tinta = cartucho.Tinta.ToLowerInvariant();
        return c with
        {
            Cartuchos = Cambiar(c.Cartuchos, i, cartucho with
            {
                Precio = escrito.TryGetValue("precio", out var precio) ? Pesos(precio, $"El precio del cartucho {tinta}") : cartucho.Precio,
                Rendimiento = escrito.TryGetValue("rinde", out var rinde) ? Entero(rinde, $"lo que rinde el cartucho {tinta}") : cartucho.Rendimiento,
            }),
        };
    });

    private Fila FilaPapel(int i) => new($"papel-{i}", (c, escrito) =>
    {
        var papel = c.Papeles[i];
        var nombre = NombrePapel(papel);
        return c with
        {
            Papeles = Cambiar(c.Papeles, i, papel with
            {
                PrecioPaquete = escrito.TryGetValue("precio", out var precio) ? Pesos(precio, $"El precio del paquete de papel {nombre}") : papel.PrecioPaquete,
                HojasPaquete = escrito.TryGetValue("hojas", out var hojas) ? Entero(hojas, $"las hojas del paquete de papel {nombre}") : papel.HojasPaquete,
            }),
        };
    });

    private Fila FilaTramo(bool porTrabajo, int i) => new($"tramo-{(porTrabajo ? "trabajo" : "hoja")}-{i}", (c, escrito) =>
        ConTramo(c, porTrabajo, i, t => t with
        {
            Desde = escrito.TryGetValue("desde", out var desde) ? Pesos(desde, "El «desde» del tramo") : t.Desde,
            Margen = escrito.TryGetValue("margen", out var margen) ? Porcentaje(margen, "El margen del tramo") : t.Margen,
        }));

    private Fila FilaMantenimiento { get; } = new("mantenimiento", (c, escrito) =>
        c with { CajaMantenimiento = Pesos(escrito["precio"], "El precio de la caja de mantenimiento") });

    private Fila FilaMargenUnico { get; } = new("margen-unico", (c, escrito) => c with { MargenUnico = Porcentaje(escrito["margen"], "El margen") });

    /// <summary>Vacío: el mismo margen que lo demás.</summary>
    private Fila FilaMargenPapel { get; } = new("margen-papel", (c, escrito) =>
        c with { MargenPapel = escrito["margen"] is { } texto && texto.Trim().Length > 0 ? Porcentaje(texto, "El margen del papel") : null });

    private Fila FilaMinimo { get; } = new("minimo", (c, escrito) => c with { CobroMinimo = Pesos(escrito["minimo"], "El cobro mínimo") });

    private Fila FilaRedondeo { get; } = new("redondeo", (c, escrito) => c with { RedondeoA = Pesos(escrito["redondeo"], "El redondeo") });

    private string EscritoEn(Fila fila, string campo, string guardado) =>
        _escritoEnFila.TryGetValue(fila.Id, out var escrito) && escrito.Campos.TryGetValue(campo, out var texto) ? texto : guardado;

    private void EscribirEnFila(Fila fila, string campo, object? valor)
    {
        if (!_escritoEnFila.TryGetValue(fila.Id, out var escrito))
            _escritoEnFila[fila.Id] = escrito = (fila, []);
        escrito.Campos[campo] = valor?.ToString() ?? "";
        Programar(fila.Id, PausaEnLaFila, soloSiSeFue: false);
    }

    private void EntrarALaFila(Fila fila) => _filaConFoco = fila.Id;

    private void SalirDeLaFila(Fila fila)
    {
        if (_filaConFoco == fila.Id)
            _filaConFoco = null;
        Programar(fila.Id, AlDejarLaFila, soloSiSeFue: true);
    }

    private async Task AlTeclearEnLaFilaAsync(KeyboardEventArgs e, Fila fila)
    {
        if (e.Key == "Enter")
            await GuardarFilaAsync(fila.Id);
    }

    /// <summary>Lo escrito en el renglón se guarda después de <paramref name="espera"/> (lo de antes de él se deja de esperar).</summary>
    /// <param name="soloSiSeFue">Al salir de un campo: si el cursor regresó al mismo renglón, todavía no.</param>
    private void Programar(string fila, TimeSpan espera, bool soloSiSeFue)
    {
        if (!_escritoEnFila.ContainsKey(fila))
            return;
        if (_esperaDeFila.Remove(fila, out var antes))
        {
            antes.Cancel();
            antes.Dispose();
        }
        var cancelar = new CancellationTokenSource();
        _esperaDeFila[fila] = cancelar;
        _ = EsperarYGuardarAsync(fila, espera, soloSiSeFue, cancelar.Token);
    }

    private async Task EsperarYGuardarAsync(string fila, TimeSpan espera, bool soloSiSeFue, CancellationToken token)
    {
        try
        {
            await Task.Delay(espera, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(async () =>
        {
            if (Cerrado || token.IsCancellationRequested)
                return;
            if (soloSiSeFue && _filaConFoco == fila)
            {
                // Pasó a otro campo del mismo renglón: se guarda al salir de él o tras la pausa, aunque ya no se escriba nada.
                Programar(fila, PausaEnLaFila, soloSiSeFue: false);
                return;
            }
            await GuardarFilaAsync(fila);
            if (!Cerrado)
                StateHasChanged();
        });
    }

    /// <summary>
    /// Lo escrito en un renglón, junto, sobre los costos como están ahora en el servicio. Si no se pudo, lo escrito se queda en sus campos
    /// para corregirlo, con el porqué arriba.
    /// </summary>
    /// <returns>Si se guardó (o no había nada que guardar).</returns>
    private async Task<bool> GuardarFilaAsync(string id)
    {
        if (_esperaDeFila.Remove(id, out var espera))
        {
            espera.Cancel();
            espera.Dispose();
        }
        if (!_escritoEnFila.TryGetValue(id, out var escrito) || escrito.Campos.Count == 0)
            return true;
        var campos = new Dictionary<string, string>(escrito.Campos);
        if (!await HacerAsync(Costos, () => GuardarCostosAsync(c => escrito.Fila.Aplicar(c, campos))))
            return false;
        // Lo que se siguió escribiendo mientras se guardaba se queda para la siguiente vez.
        foreach (var (campo, texto) in campos)
        {
            if (escrito.Campos.TryGetValue(campo, out var ahora) && ahora == texto)
                escrito.Campos.Remove(campo);
        }
        if (escrito.Campos.Count == 0)
            _escritoEnFila.Remove(id);
        return true;
    }

    private async Task GuardarFilasAsync()
    {
        foreach (var fila in _escritoEnFila.Keys.ToList())
            await GuardarFilaAsync(fila);
    }

    /// <summary>
    /// Lo escrito en un renglón que todavía no se guardaba al cerrar la ventana (Esc con el cursor en él) se guarda, como lo demás de la
    /// Configuración; si no se pudo, lo dice la venta.
    /// </summary>
    public override async ValueTask DisposeAsync()
    {
        var errores = new List<string>();
        foreach (var fila in _escritoEnFila.Keys.ToList())
        {
            if (!await GuardarFilaAsync(fila) && ErrorDe(Costos) is { } error)
                errores.Add(error);
        }
        foreach (var espera in _esperaDeFila.Values)
        {
            espera.Cancel();
            espera.Dispose();
        }
        _esperaDeFila.Clear();
        await base.DisposeAsync();
        if (errores.Count > 0)
            await AlNoGuardar.InvokeAsync(string.Join(" ", errores.Distinct()));
    }

    /// <summary>Un campo de un renglón de los costos: se ve lo escrito mientras no se guarda; si no, lo guardado.</summary>
    private RenderFragment Campo(Fila fila, string campo, string id, string etiqueta, string guardado, string modo, string? antes = null,
        string? despues = null, string? marcador = null) =>
        @<span class="vn-ctl-num">@antes<input id="@id" inputmode="@modo" autocomplete="off" aria-label="@etiqueta" placeholder="@marcador"
                                                 disabled="@(_costos?.PuedeCambiar != true)" value="@EscritoEn(fila, campo, guardado)"
                                                 @oninput="e => EscribirEnFila(fila, campo, e.Value)" @onfocus="() => EntrarALaFila(fila)"
                                                 @onblur="() => SalirDeLaFila(fila)" @onkeydown="e => AlTeclearEnLaFilaAsync(e, fila)" />@despues</span>;

    /// <summary>Pesos con centavos, como el resto del dinero de la caja («1,200», «12.50»); si no, por qué.</summary>
    private static decimal Pesos(string texto, string que) =>
        Formato.LeerPesos(texto) is { } centavos
            ? centavos / 100m
            : throw new ArgumentException(Formato.ProblemaDePesos(texto) ?? $"{que}: escribe cuánto, con número (12.50, por ejemplo).");

    private static decimal Porcentaje(string texto, string que) =>
        Formato.LeerCantidad(texto.Trim().TrimEnd('%')) is { } valor && valor >= 0
            ? valor
            : throw new ArgumentException(Formato.ProblemaDePorcentaje(texto) ?? $"{que}: escribe el porcentaje con número (80, por ejemplo).");

    protected override Task AlGuardarAsync() => AlGuardar.InvokeAsync();

    protected override Task NoSeGuardoAlCerrarAsync(IReadOnlyList<string> errores) => AlNoGuardar.InvokeAsync(string.Join(" ", errores));

    private void Mostrar(EstadoImpresoraDto estado) => _estado = estado;

    /// <summary>
    /// Cómo se lee y la calibración: solo con «Configurar la impresora» en «Puede» (en Administración no hay «Con
    /// autorización»: sin el permiso no aparecen). El servicio lo vuelve a revisar.
    /// </summary>
    private bool PuedeConfigurar => Sesion.Puede(AccionControlada.ConfigurarImpresora);

    /// <summary>El desglose del día: con «Consultar la bitácora» (al migrar, el dueño y el encargado). El servicio lo vuelve a revisar.</summary>
    private bool VeElDia => Sesion.Puede(AccionControlada.ConsultarBitacora);

    /// <summary>El costo de cada impresión: con «Ver costos, utilidad y margen» (al migrar, el dueño). El servicio solo lo manda a quien lo ve.</summary>
    private bool VeCosto => Sesion.Puede(AccionControlada.VerUtilidad);

    private static int Entero(string texto, string que) =>
        Formato.LeerEntero(texto.Trim().TrimEnd('%')) is { } n && n is >= int.MinValue and <= int.MaxValue
            ? (int)n
            : throw new ArgumentException(Formato.ProblemaDeEntero(texto.Trim().TrimEnd('%')) ?? $"Escribe {que} con número.");

    /// <summary>
    /// Cómo se lee, con lo que cambió sobre como está ahora en el servicio (no sobre lo que se leyó al abrir: otra caja la
    /// pudo cambiar). Al guardarlo, la caja principal la vuelve a leer.
    /// </summary>
    private async Task GuardarAsync(Func<ConfiguracionImpresoraDto, ConfiguracionImpresoraDto> cambio)
    {
        var actual = (await Cliente.ImpresoraAsync(Caja.SucursalId)).Configuracion;
        Mostrar(await Cliente.GuardarImpresoraAsync(Caja.SucursalId, new SolicitudConfiguracionImpresora(Sesion.UsuarioId, cambio(actual))));
        _avisoTexto = _estado!.Configuracion.Host is null || _estado.Error is null ? null : "Guardado, pero la impresora no respondió.";
    }

    private Task GuardarHostAsync(string texto) => GuardarAsync(c => c with { Host = texto });

    private Task GuardarAvisoAsync(string texto) => GuardarAsync(c => c with { AvisoTintaPorcentaje = Entero(texto, "el porcentaje del aviso") });

    private Task GuardarMinutosAsync(string texto) => GuardarAsync(c => c with { MinutosEntreLecturas = Entero(texto, "los minutos") });

    private async Task CargarDiaAsync()
    {
        if (!VeElDia)
            return;
        var consulta = ++_consultaDia;
        await HacerAsync(async () =>
        {
            var dia = await Cliente.ImpresionesDelDiaAsync(Caja.SucursalId, _fecha, Sesion.UsuarioId);
            if (consulta == _consultaDia)
                _dia = dia;
        });
    }

    private Task LeerAsync() => HacerAsync(async () => Mostrar(await Cliente.LeerImpresoraAsync(Caja.SucursalId)));

    private async Task AplicarCalibracionAsync()
    {
        if (_aplicando)
            return;
        _aplicando = true;
        try
        {
            if (await HacerAsync(Calibracion, async () => _calibracion = await Cliente.AplicarCalibracionAsync(Caja.SucursalId,
                    new SolicitudCalibracion(Sesion.UsuarioId))))
                (_porAplicar, _avisoTexto) = (false, "Corrección aplicada: las impresiones nuevas ya salen con ella.");
        }
        finally
        {
            _aplicando = false;
        }
    }

    /// <summary>Lo que no se guarda (leer, cargar): el error abajo.</summary>
    private async Task HacerAsync(Func<Task> accion)
    {
        (_error, _avisoTexto, _ocupado) = (null, null, true);
        try
        {
            await accion();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static IEnumerable<(string Nombre, int? Nivel, string Color)> Niveles(LecturaImpresoraDto u)
    {
        yield return ("Negro", u.TintaK, "#222");
        yield return ("Cian", u.TintaC, "#00a0d6");
        yield return ("Magenta", u.TintaM, "#d6007a");
        yield return ("Amarillo", u.TintaY, "#e6c200");
        yield return ("Caja de mantenimiento", u.Mantenimiento, "#7a8a99");
    }

    private static string Cobro(ImpresionDelDiaDto t) => t.Cobro switch
    {
        EstadoCobroImpresion.Cobrada => "Cobrada",
        EstadoCobroImpresion.NoVendida => t.Motivo switch
        {
            MotivoNoVendida.NoEraLoQueQueria => "No vendida: no era lo que quería",
            MotivoNoVendida.SalioMal => "No vendida: salió mal",
            MotivoNoVendida.Atasco => "No vendida: atasco",
            _ => "No vendida: otro",
        },
        _ => "Por cobrar",
    };
}
