        c with { CajaMantenimiento = Pesos(escrito["precio"], "El precio de la caja de mantenimiento") });

    private Fila FilaMargenUnico { get; } = new("margen-unico", (c, escrito) => c with { MargenUnico = Porcentaje(escrito["margen"], "El margen") });

    /// <summary>Vacío: el mismo margen que lo demás.</summary>
    private Fila FilaMargenPapel { get; } = new("margen-papel", (c, escrito) =>
        c with { MargenPapel = escrito["margen"] is { } texto && texto.Trim().Length > 0 ? Porcentaje(texto, "El margen del papel") : null });

    private Fila FilaMinimo { get; } = new("minimo", (c, escrito) => c with { CobroMinimo = Pesos(escrito["minimo"], "El cobro mínimo") });

    private Fila FilaRedondeo { get; } = new("redondeo", (c, escrito) => c with { RedondeoA = Pesos(escrito["redondeo"], "El redondeo") });

    /// <summary>Dónde va el porqué de un renglón que no se guardó: el suyo, no uno de todos los costos (segunda revisión, 2026-10-31).</summary>
    private static string Renglon(string fila) => $"costos-{fila}";

    private string EscritoEn(Fila fila, string campo, string guardado) =>
        _escritoEnFila.TryGetValue(fila.Id, out var escrito) && escrito.Campos.TryGetValue(campo, out var texto) ? texto : guardado;

    /// <summary>Lo escrito en un campo de un renglón que no se pudo guardar: se marca hasta que se corrige.</summary>
    private bool SinGuardar(Fila fila, string campo) =>
        ErrorDe(Renglon(fila.Id)) is not null && _escritoEnFila.TryGetValue(fila.Id, out var escrito) && escrito.Campos.ContainsKey(campo);

    /// <summary>Lo que se teclea solo se recuerda: el renglón se guarda al terminar con él.</summary>
    private void EscribirEnFila(Fila fila, string campo, object? valor)
    {
        if (!_escritoEnFila.TryGetValue(fila.Id, out var escrito))
            _escritoEnFila[fila.Id] = escrito = (fila, []);
        escrito.Campos[campo] = valor?.ToString() ?? "";
    }

    private void EntrarALaFila(Fila fila) => _filaConFoco = fila.Id;

    /// <summary>Al salir de un campo: si en un momento el cursor no está en otro campo del mismo renglón, se terminó con él.</summary>
    private void SalirDeLaFila(Fila fila)
    {
        if (_filaConFoco == fila.Id)
            _filaConFoco = null;
        if (!_escritoEnFila.ContainsKey(fila.Id))
            return;
        if (_esperaDeFila.Remove(fila.Id, out var antes))
        {
            antes.Cancel();
            antes.Dispose();
        }
        var cancelar = new CancellationTokenSource();
        _esperaDeFila[fila.Id] = cancelar;
        _ = AlDejarLaFilaAsync(fila.Id, cancelar.Token);
    }

    /// <summary>Enter, en cualquier campo del renglón: se guarda ya.</summary>
    private async Task AlTeclearEnLaFilaAsync(KeyboardEventArgs e, Fila fila)
    {
        if (e.Key == "Enter")
            await GuardarFilaAsync(fila.Id);
    }

    private async Task AlDejarLaFilaAsync(string fila, CancellationToken token)
    {
        try
        {
            await Task.Delay(AlDejarLaFila, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(async () =>
        {
            // Pasó a otro campo del mismo renglón: todavía no se termina con él (se guarda al salir de él, con Enter o al cerrar).
            if (Cerrado || token.IsCancellationRequested || _filaConFoco == fila)
                return;
            await GuardarFilaAsync(fila);
            if (!Cerrado)
                StateHasChanged();
        });
    }

    /// <summary>
    /// Lo escrito en un renglón, junto, sobre los costos como están ahora en el servicio. Si no se pudo, lo escrito se queda en sus campos,
    /// marcado, para corregirlo, con su porqué.
    /// </summary>
    /// <returns>Si se guardó (o no había nada que guardar).</returns>
    private async Task<bool> GuardarFilaAsync(string id)
    {
        if (_esperaDeFila.Remove(id, out var espera))
        {
            espera.Cancel();
            espera.Dispose();
        }
        if (!_escritoEnFila.TryGetValue(id, out var escrito) || escrito.Campos.Count == 0)
            return true;
        var campos = new Dictionary<string, string>(escrito.Campos);
        if (!await HacerAsync(Renglon(id), () => escrito.Fila.GuardarAparte is { } aparte
                ? aparte(campos)
                : GuardarCostosAsync(c => escrito.Fila.Aplicar(c, campos))))
            return false;
        // Lo que se siguió escribiendo mientras se guardaba se queda para la siguiente vez.
        foreach (var (campo, texto) in campos)
        {
            if (escrito.Campos.TryGetValue(campo, out var ahora) && ahora == texto)
                escrito.Campos.Remove(campo);
        }
        if (escrito.Campos.Count == 0)
            _escritoEnFila.Remove(id);
        return true;
    }

    /// <summary>Lo escrito en todos los renglones (antes de elegir el margen). Falso si alguno no se pudo guardar.</summary>
    private async Task<bool> GuardarFilasAsync()
    {
        var todos = true;
        foreach (var fila in _escritoEnFila.Keys.ToList())
            todos &= await GuardarFilaAsync(fila);
        return todos;
    }

    /// <summary>
    /// Lo escrito en un renglón que todavía no se guardaba al cerrar la ventana (Esc con el cursor en él) se guarda, como lo demás de la
    /// Configuración; si no se pudo, lo dice la venta.
    /// </summary>
    public override async ValueTask DisposeAsync()
    {
        var errores = new List<string>();
        foreach (var fila in _escritoEnFila.Keys.ToList())
        {
            if (!await GuardarFilaAsync(fila) && ErrorDe(Renglon(fila)) is { } error)
                errores.Add(error);
        }
        foreach (var espera in _esperaDeFila.Values)
        {
            espera.Cancel();
            espera.Dispose();
        }
        _esperaDeFila.Clear();
        if (_modulo is not null)
            await _modulo.DisposeAsync();
        await base.DisposeAsync();
        if (errores.Count > 0)
            await AlNoGuardar.InvokeAsync(string.Join(" ", errores.Distinct()));
    }

    /// <summary>
    /// Una impresora: sus niveles y su contador contra lo registrado; para quien la configura, cómo se lee (con varias, también su nombre),
    /// la calibración de su tinta y darla de baja. Los campos de la 1 se llaman como antes («impresora-host»); los de las demás, con su
    /// número.
    /// </summary>
    private RenderFragment Impresora(ImpresoraDto impresora) =>
        @<section class="vn-impresora" id="@($"impresora-{impresora.Numero}")">
            @if (Varias)
            {
                <h3>@impresora.Nombre <small class="nota">impresora @impresora.Numero · @PerfilesImpresora.De(impresora.Perfil).Modelo</small></h3>
            }
            <div class="vn-cfg-antes">
                @if (impresora.Estado.Configuracion.Host is null)
                {
                    <p class="nota">Escribe la IP de la impresora (la @PerfilesImpresora.De(impresora.Perfil).NombreCorto) para leer sus niveles y su contador desde la caja principal.</p>
                }
                else if (impresora.Estado.Ultima is { } u)
                {
                    <div class="niveles">
                        @foreach (var (nombre, nivel, color) in Niveles(u, impresora.Perfil))
                        {
                            <div class="nivel @(nivel <= impresora.Estado.Configuracion.AvisoTintaPorcentaje ? "bajo" : "")">
                                <span>@nombre: <strong>@(nivel is { } n ? $"{n} %" : "—")</strong></span>
                                <div class="barra"><span style="width: @(nivel ?? 0)%; background: @color"></span></div>
                            </div>
                        }
                    </div>
                    <p class="nota">
                        Leída a las @u.TomadaLocal.ToString("HH:mm") del @u.TomadaLocal.ToString("dd/MM")
                        @(u.Contador is { } c ? $" · contador {c:N0} caras" : "")@(u.ContadorColor is { } cc ? $" ({cc:N0} color, {u.ContadorBN:N0} B/N)" : "")
                        @(u.Serie is { } serie ? $" · serie {serie}" : "")
                    </p>
                }
                @if (impresora.Estado.OtraSerie is { } otraSerie)
                {
                    @* Con Telegram en pausa, este es el aviso (2026-11-08): sus lecturas no se guardan hasta corregir la IP. *@
                    <p class="error" role="alert">@otraSerie</p>
                }
                @if (impresora.Estado.Error is { } error)
                {
                    <p class="error">@error</p>
                }
                @if (impresora.Estado.Hoy is { } hoy)
                {
                    <p>
                        Hoy, desde las @hoy.DesdeLocal.ToString("HH:mm"), la impresora contó <strong>@hoy.Contadas.ToString("N0")</strong> caras; registradas
                        @((hoy.CarasImpresas + hoy.CarasCopias).ToString("N0")) (@hoy.CarasImpresas.ToString("N0") desde las PC y @hoy.CarasCopias.ToString("N0") en copias cobradas).
                        @if (ConControlPrint(impresora))
                        {
                            @* La caja principal imprime con Control Print en esta misma impresora: aquí solo se registra lo de esta caja, y la
                               diferencia no es una fuga (auditoría, 2026-11-04). *@
                            <span class="nota">Lo que imprimió la caja principal lo registra Control Print, no esta caja: lo no registrado se cuenta allá.</span>
                        }
                        else if (hoy.SinRegistrar == 0)
                        {
                            <span>No hay caras sin registrar.</span>
                        }
                        else
                        {
                            <strong class="salieron">Sin registrar: @hoy.SinRegistrar.ToString("N0")@(hoy.SinRegistrarColor is { } sc ? $" ({hoy.SinRegistrar - sc:N0} B/N y {sc:N0} color)" : "")</strong>
                            <span class="nota">: copias sin cobrar, impresiones desde el celular o páginas de prueba.</span>
                        }
                    </p>
                }
                @if (PuedeConfigurar && PerfilesImpresora.De(impresora.Perfil).PorVerificar is { } porVerificar)
                {
                    <p class="nota">@porVerificar</p>
                }
                <div class="vn-botonera">
                    <button class="vn-boton chico" disabled="@(_ocupado || impresora.Estado.Configuracion.Host is null)" @onclick="() => LeerAsync(impresora.Numero)">Leer ahora</button>
                </div>
            </div>

            @if (PuedeConfigurar)
