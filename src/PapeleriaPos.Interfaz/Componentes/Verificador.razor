@* F9: consulta precio y existencia sin agregar a la venta. Si se lo lleva, «Agregarlo al ticket» (docs/propuesta-interfaz.md,
   «La pantalla de venta»). Desde aquí, Ctrl+M abre el mostrador y la temporada en modo verificador: tocar una pieza la enseña
   aquí, con su foto (entrega 13, parte 2: de la base de esta caja; sin foto, sus iniciales), sin agregarla. Cada producto que
   enseña cuenta como una consulta (entrega 13, parte 3): Productos › Tarjetas de precio dice lo que más se pregunta. *@
@implements IDisposable
@inject ClienteCaja Cliente
@inject ModuloCaja Js

<label>Código del producto
    <input id="verificador" autocomplete="off" @bind="_codigo" @bind:event="oninput" @onkeydown="AlTeclear" />
</label>

@if (_producto is { } producto)
{
    <div class="verificado">
        @if (Cliente.Fotos.Direccion(producto.VarianteId) is { } foto)
        {
            <img class="vn-foto" src="@foto" alt="" />
        }
        else
        {
            <span class="vn-foto" aria-hidden="true">@MostradorEnPantalla.Iniciales(producto.Descripcion)</span>
        }
        <div class="descripcion">@producto.Descripcion</div>
        <div class="precio">@Formato.Dinero(Precio(producto))</div>
        <div class="nota">Existencia: @(producto.Existencia is { } e ? Formato.Numero(e) : "no lleva inventario")</div>
    </div>
    @if (AlAgregar.HasDelegate)
    {
        <button class="vn-boton" @onclick="() => AlAgregar.InvokeAsync(producto)"><Ico Nombre="mas" />Agregarlo al ticket</button>
    }
}
@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (AlMostrador.HasDelegate)
{
    <div class="vn-botonera">
        <button class="vn-boton chico" title="Lo que el cliente señala: tocarlo enseña su precio aquí" @onclick="AlMostrador">
            <Ico Nombre="tienda" />Mostrador y temporada <kbd>Ctrl+M</kbd>
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid SucursalId { get; set; }

    /// <summary>Lo que se enseña al abrir: lo que se tocó en el mostrador (entrega 13).</summary>
    [Parameter] public ProductoVentaDto? Producto { get; set; }

    /// <summary>Lo que se busca al abrir: lo que se escaneó con el mostrador abierto en modo verificador.</summary>
    [Parameter] public string? Codigo { get; set; }

    /// <summary>«Agregarlo al ticket»: si se lo lleva.</summary>
    [Parameter] public EventCallback<ProductoVentaDto> AlAgregar { get; set; }

    /// <summary>El mostrador y la temporada en modo verificador (Ctrl+M).</summary>
    [Parameter] public EventCallback AlMostrador { get; set; }

    private string _codigo = "";
    private ProductoVentaDto? _producto;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Cliente.Fotos.Cambio += AlCambiarLasFotos;
        _producto = Producto;
        if (Producto is { } tocado)
            Contar(tocado);
        else if (Codigo?.Trim() is { Length: > 0 } codigo)
            await BuscarAsync(codigo);
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await Js.EnfocarAsync("#verificador");
    }

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _codigo.Trim().Length == 0)
            return;
        await BuscarAsync(_codigo.Trim());
        _codigo = "";
    }

    private async Task BuscarAsync(string codigo)
    {
        try
        {
            _producto = await Cliente.PorCodigoAsync(codigo, SucursalId);
            _error = _producto is null ? $"No existe el código «{codigo}»." : null;
            if (_producto is { } encontrado)
                Contar(encontrado);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private void AlCambiarLasFotos() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Lo que se enseña cuenta como una consulta (lo más preguntado): sin esperarla, como lo que se busca.</summary>
    private void Contar(ProductoVentaDto producto) => _ = Cliente.ContarConsultaAsync(SucursalId, producto.VarianteId);

    public void Dispose() => Cliente.Fotos.Cambio -= AlCambiarLasFotos;

    private long Precio(ProductoVentaDto p) =>
        CalculoPrecio.Calcular(p.PreciosModelo(), SucursalId, p.PresentacionModelo(), Cantidad.Piezas(1))?.ImporteCentavos ?? 0;
}
