@inject ClienteCaja Cliente
@inject ModuloCaja Js

<div class="centrado">
    <div class="tarjeta">
        <h2>@(Titulo ?? $"{Caja.Nombre} · {Caja.Sucursal}")</h2>
        @if (Turno is not null)
        {
            <p class="nota">Turno abierto de @Turno.Cajero desde las @Turno.AbiertoLocal.ToString("HH:mm")</p>
        }
        <label>Usuario
            <input id="entrada-usuario" @bind="_usuario" @bind:event="oninput" @onkeydown="AlTeclearUsuario" autocomplete="off" />
        </label>
        <label>PIN
            <input id="entrada-pin" type="password" inputmode="numeric" maxlength="6" @bind="_pin" @bind:event="oninput" @onkeydown="AlTeclearPin" />
        </label>
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        <button class="boton principal" disabled="@_ocupado" @onclick="EntrarAsync">Entrar</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter] public TurnoDto? Turno { get; set; }

    /// <summary>En lugar de la caja y la sucursal (el conteo desde el celular).</summary>
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public EventCallback<SesionDto> AlEntrar { get; set; }

    private string _usuario = "";
    private string _pin = "";
    private string? _error;
    private bool _ocupado;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
            await Js.EnfocarAsync("#entrada-usuario");
    }

    private async Task AlTeclearUsuario(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Js.EnfocarAsync("#entrada-pin");
    }

    private async Task AlTeclearPin(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await EntrarAsync();
    }

    private async Task EntrarAsync()
    {
        if (_ocupado || _usuario.Length == 0 || _pin.Length == 0)
            return;
        _ocupado = true;
        _error = null;
        try
        {
            await AlEntrar.InvokeAsync(await Cliente.EntrarAsync(_usuario, _pin));
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
            _pin = "";
        }
        finally
        {
            _ocupado = false;
        }
    }
}
