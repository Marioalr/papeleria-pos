@* Inventario (F4), por tareas (entrega 8, htmlInventario del prototipo). Antes era una ventana con una fila de pestañas;
   ahora es una página con una tarjeta por tarea: recibir, el conteo del día, mermas, ajustes, abrir un paquete, compras y
   notas, órdenes, el sugerido, etiquetas, el conteo completo y, de lo que ya había, la hoja de códigos y los proveedores.
   Solo salen las de quien entró («Puede» o «Con autorización»), con lo pendiente de cada una cuando se lee rápido, su
   límite («tú: hasta $200») o quién la autoriza. Cada tarjeta abre la pantalla de siempre de esa tarea, aquí mismo, con
   «← Inventario» (o Esc) para volver: por dentro funcionan como antes. En el piloto con eleventa, las que mueven
   existencias no se ofrecen (el inventario se lleva allá) y una nota lo dice. Los reportes de eleventa (2026-10-17: bajos
   en inventario, movimientos y lo que vale) son tarjetas de consulta: salen con su permiso en «Puede», con el acomodo
   nuevo, y también en el piloto. *@
@implements IPagina
@inject ClienteCaja Cliente
@inject ModuloCaja Js

@if (_pedidaEsperando)
{
    @* Una tarea que mueve existencias, pedida desde fuera (el chip del conteo): se abre cuando se sabe si es el piloto. *@
}
else if (_tarea is { } abierta)
{
    var tarea = PaginasDeAtras.De(abierta);
    <div class="vn-tarea-pag">
        <div class="vn-tarea-cab">
            <button class="vn-boton chico" title="Volver a las tareas del inventario (Esc)" @onclick="VolverAsync">← Inventario</button>
            <Ico Nombre="@tarea.Icono" />
            <h2>@tarea.Nombre</h2>
            <p>@tarea.Descripcion</p>
        </div>
        @* @key: de una tarea a otra (Mermas y Ajustes son la misma pantalla) empieza como nueva. Las de antes van con sus letras
           y botones (vn-adentro); los reportes, con el acomodo de las páginas (vn-reporte). *@
        <div class="vn-tarea-cuerpo @(tarea.Consulta ? "vn-reporte" : "vn-adentro")" @key="abierta">
            @switch (abierta)
            {
                case TareaInventario.Recibir:
                    <Compras Caja="Caja" Sesion="Sesion" EmpezarARecibir="true" />
                    break;
                case TareaInventario.Compras:
                    <Compras Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.ConteoDelDia:
                    <ConteoDelDia Caja="Caja" Sesion="Sesion" AlContar="ContadoAsync" />
                    break;
                case TareaInventario.Mermas:
                    <AjustesMermas Caja="Caja" Sesion="Sesion" EnMerma="true" />
                    break;
                case TareaInventario.Ajustes:
                    <AjustesMermas Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Paquete:
                    <AbrirPaquete Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Ordenes:
                    <Ordenes Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Sugerido:
                    <Sugerido Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Etiquetas:
                    <Etiquetas Caja="Caja" Sesion="Sesion" Lista="EtiquetasPorImprimir" />
                    break;
                case TareaInventario.HojaCodigos:
                    <HojaCodigos Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.ConteoCompleto:
                    <ConteoCompleto Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Bajos:
                    <BajosInventario Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Movimientos:
                    <MovimientosInventario Caja="Caja" Sesion="Sesion" />
                    break;
                case TareaInventario.Valor:
                    <ValorInventario Caja="Caja" Sesion="Sesion" />
                    break;
                default:
                    <Proveedores Caja="Caja" Sesion="Sesion" />
                    break;
            }
        </div>
    </div>
}
else
{
    <div class="vn-hub">
        <h2>Inventario</h2>
        <p>Solo las tareas que tienes. Las demás no aparecen.</p>
        @if (_piloto is { } piloto)
        {
            <div class="vn-alerta info"><Ico Nombre="info" /><div><span>@piloto</span></div></div>
        }
        <div class="vn-tareas" data-rejilla>
            @* Las tarjetas, cuando se sabe si es el piloto (un instante): así no se ofrece lo que en el piloto no va. *@
            @foreach (var t in _pilotoSabido ? Ofrecidas : [])
            {
                <button id="tarea-@t.Id" class="vn-tarea" @onclick="AlTocar(t.Id)">
                    <Ico Nombre="@t.Icono" />
                    <div>
                        <strong>@t.Nombre</strong>
                        <small>@t.Descripcion</small>
                        <span class="vn-pie-tarea">
                            @foreach (var (texto, color) in Pendiente(t.Id))
                            {
                                <span class="vn-etiq @color">@texto</span>
                            }
                            @if (t.Regla is { } regla && Acceso.De(regla) is { Nivel: NivelPermiso.RequiereAutorizacion } autoriza)
                            {
                                <span class="vn-etiq ambar"><Ico Nombre="candado" />lo autoriza @Textos.Quien(autoriza.Autorizan)</span>
                            }
                            else if (t.Regla is { } conLimite && Acceso.De(conLimite) is { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral })
                            {
                                <span class="vn-etiq gris">tú: hasta @PapeleriaPos.Nucleo.Control.Permisos.TextoMonto(conLimite, umbral)</span>
                            }
                            @if (t.Id == TareaInventario.Proveedores && !Acceso.Puede(AccionControlada.EditarCatalogo))
                            {
                                <span class="vn-etiq gris">solo consulta</span>
                            }
                        </span>
                    </div>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>Lo que puede quien entró: las tarjetas de lo demás no aparecen.</summary>
    [Parameter, EditorRequired] public PermisosDePagina Acceso { get; set; } = null!;

    /// <summary>Las etiquetas por imprimir: las mismas que agrega «Etiqueta» en Productos.</summary>
    [Parameter, EditorRequired] public EtiquetasPorImprimir EtiquetasPorImprimir { get; set; } = null!;

    /// <summary>El conteo del día que ya pidió la venta (para su chip, abajo); sin él, se pide aquí.</summary>
    [Parameter] public ConteoCiclicoDto? Conteo { get; set; }

    /// <summary>Se contó algo del conteo del día: la venta pone al día su chip.</summary>
    [Parameter] public EventCallback<ConteoCiclicoDto> AlContar { get; set; }

    /// <summary>La tarea con que abre (el chip «Conteo del día», «Ir a Etiquetas» en Productos); vacío: las tarjetas.</summary>
    [Parameter] public TareaInventario? TareaInicial { get; set; }

    private TareaInventario? _tarea;
    private PendientesInventarioDto? _pendientes;
    private ConteoCiclicoDto? _conteo;

    /// <summary>En el piloto con eleventa: por qué no están las que mueven existencias. Vacío fuera del piloto.</summary>
    private string? _piloto;

    /// <summary>Ya se sabe si es el piloto (sin tareas que muevan existencias, desde el principio).</summary>
    private bool _pilotoSabido;

    /// <summary>La tarea pedida desde fuera mueve existencias: se abre (o no, en el piloto) cuando se sepa.</summary>
    private bool _pedidaEsperando;

    /// <summary>Las de quien entró; en el piloto, sin las que mueven existencias.</summary>
    private IEnumerable<PaginasDeAtras.Tarea> Ofrecidas =>
        PaginasDeAtras.TareasDe(Acceso).Where(t => _piloto is null || !PaginasDeAtras.MuevenExistencias.Contains(t.Id));

    protected override async Task OnInitializedAsync()
    {
        _conteo = Conteo;
        var pedida = TareaInicial is { } t && PaginasDeAtras.TareasDe(Acceso).Any(x => x.Id == t) ? t : (TareaInventario?)null;
        // Lo que no mueve existencias («Ir a Etiquetas») se abre ya; lo que sí, cuando se sepa si es el piloto.
        _pedidaEsperando = pedida is { } p && PaginasDeAtras.MuevenExistencias.Contains(p);
        _tarea = _pedidaEsperando ? null : pedida;
        await PilotoAsync();
        _pilotoSabido = true;
        if (_pedidaEsperando)
            (_tarea, _pedidaEsperando) = (Ofrecidas.Any(x => x.Id == pedida) ? pedida : null, false);
        // Las tarjetas (o la tarea pedida) ya; lo pendiente de cada una, cuando llegue.
        StateHasChanged();
        await PendientesAsync();
    }

    /// <summary>Si es el piloto con eleventa, solo para quien tiene alguna tarea que mueve existencias.</summary>
    private async Task PilotoAsync()
    {
        if (!PaginasDeAtras.TareasDe(Acceso).Any(t => PaginasDeAtras.MuevenExistencias.Contains(t.Id)))
            return;
        try
        {
            _piloto = (await Cliente.TrastiendaEnElPilotoAsync()).Inventario;
        }
        catch (ErrorCaja)
        {
            // Sin saberlo se ofrecen como siempre: el servicio decide.
        }
    }

    /// <summary>Al abrir la página, el cursor va a la primera tarjeta (una vez que se sabe qué se abre).</summary>
    private bool _enfocarAlAbrir = true;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!_enfocarAlAbrir || !_pilotoSabido)
            return;
        _enfocarAlAbrir = false;
        if (_tarea is null)
            await EnfocarAsync();
    }

    public async Task EnfocarAsync()
    {
        if (_tarea is null)
            await Js.EnfocarAsync(".vn-tarea");
    }

    public async Task<bool> CerrarAsync()
    {
        if (_tarea is null)
            return false;
        await VolverAsync();
        return true;
    }

    /// <summary>El clic de cada tarjeta, el mismo en cada vuelta del dibujo (no un manejador nuevo cada vez).</summary>
    private Func<Task> AlTocar(TareaInventario tarea) =>
        _alTocar.TryGetValue(tarea, out var alTocar) ? alTocar : _alTocar[tarea] = () => AbrirAsync(tarea);

    private readonly Dictionary<TareaInventario, Func<Task>> _alTocar = [];

    /// <summary>Abre una tarea (si quien entró la tiene y se ofrece); desde fuera, el chip del conteo o «Ir a Etiquetas».</summary>
    public Task AbrirAsync(TareaInventario tarea)
    {
        if (Ofrecidas.Any(t => t.Id == tarea))
        {
            _tarea = tarea;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task VolverAsync()
    {
        _tarea = null;
        await PendientesAsync();
        StateHasChanged();
        await EnfocarAsync();
    }

    /// <summary>
    /// Lo pendiente: las compras, las órdenes, los conteos completos y lo que está en su mínimo o debajo en una consulta de
    /// solo cuentas; el conteo del día, el que ya tiene la venta (o se pide, como al abrirlo). El sugerido no lleva cuenta:
    /// calcularlo lee un año de ventas.
    /// </summary>
    private async Task PendientesAsync()
    {
        var tareas = PaginasDeAtras.TareasDe(Acceso).Select(t => t.Id).ToHashSet();
        if (tareas.Overlaps([TareaInventario.Recibir, TareaInventario.Compras, TareaInventario.Ordenes, TareaInventario.ConteoCompleto, TareaInventario.Bajos]))
        {
            try
            {
                _pendientes = await Cliente.PendientesInventarioAsync(Caja.SucursalId);
            }
            catch (ErrorCaja)
            {
                // Sin conexión, las tarjetas van sin lo pendiente.
            }
        }
        if (tareas.Contains(TareaInventario.ConteoDelDia) && _conteo is null)
        {
            try
            {
                _conteo = await Cliente.ConteoDelDiaAsync(Caja.SucursalId, Sesion.UsuarioId);
            }
            catch (ErrorCaja)
            {
                // Sin conexión, el conteo espera a que vuelva.
            }
        }
    }

    private async Task ContadoAsync(ConteoCiclicoDto conteo)
    {
        _conteo = conteo;
        await AlContar.InvokeAsync(conteo);
    }

    /// <summary>Lo que va en la tarjeta: «1 contando», «2 por contar», «3 por imprimir»… con su color.</summary>
    private IEnumerable<(string Texto, string Color)> Pendiente(TareaInventario tarea)
    {
        var p = _pendientes;
        switch (tarea)
        {
            case TareaInventario.Recibir when p is not null:
                if (p.ComprasContando > 0)
                    yield return ($"{p.ComprasContando} contando", "azul");
                if (p.OrdenesEnCamino > 0)
                    yield return (p.OrdenesEnCamino == 1 ? "1 orden en camino" : $"{p.OrdenesEnCamino} órdenes en camino", "azul");
                break;
            case TareaInventario.ConteoDelDia when _conteo is { } conteo:
                if (conteo.Total == 0)
                    yield return ("nada que contar hoy", "gris");
                else if (conteo.Contados < conteo.Total)
                    yield return ($"{conteo.Total - conteo.Contados} por contar", "azul");
                else
                    yield return ("contado", "verde");
                break;
            case TareaInventario.Compras when p is { ComprasSinNota: > 0 }:
                yield return (p.ComprasSinNota == 1 ? "1 nota por capturar" : $"{p.ComprasSinNota} notas por capturar", "azul");
                break;
            case TareaInventario.Ordenes when p is { OrdenesAbiertas: > 0 }:
                yield return (p.OrdenesAbiertas == 1 ? "1 abierta" : $"{p.OrdenesAbiertas} abiertas", "azul");
                break;
            case TareaInventario.Etiquetas when EtiquetasPorImprimir.Total > 0:
                yield return ($"{Formato.Numero(EtiquetasPorImprimir.Total)} por imprimir", "azul");
                break;
            case TareaInventario.ConteoCompleto when p is { ConteosCompletosAbiertos: > 0 }:
                yield return (p.ConteosCompletosAbiertos == 1 ? "1 departamento abierto" : $"{p.ConteosCompletosAbiertos} departamentos abiertos", "azul");
                break;
            case TareaInventario.Bajos when p is { BajosEnInventario: > 0 }:
                yield return (p.BajosEnInventario == 1 ? "1 en su mínimo o debajo" : $"{Formato.Numero(p.BajosEnInventario)} en su mínimo o debajo", "ambar");
                break;
        }
    }
}
