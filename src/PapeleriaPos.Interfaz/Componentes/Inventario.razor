@* F4 Inventario: las compras (recibir a ciegas y capturar la nota), las órdenes de compra y el sugerido (con «Órdenes y
   sugerido de compra»), el conteo del día y el completo por departamento, ajustes y mermas, abrir paquete, los
   proveedores, el margen mínimo (con «Margen mínimo») y las etiquetas y la hoja de códigos del mostrador (con «Productos,
   precios y etiquetas»). Con los usuarios de antes, como con los roles: el margen, el dueño; lo demás, también el
   encargado. *@

<nav class="pestanas config-pestanas">
    @foreach (var p in Enum.GetValues<Pestanas>().Where(Visible))
    {
        var pestana = p;
        <button class="pestana @(p == _pestana ? "activa" : "")" @onclick="() => _pestana = pestana">@Nombre(p)</button>
    }
</nav>

@switch (_pestana)
{
    case Pestanas.Compras:
        <Compras Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Ordenes:
        <Ordenes Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Sugerido:
        <Sugerido Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Conteo:
        <ConteoDelDia Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.ConteoCompleto:
        <ConteoCompleto Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Ajustes:
        <AjustesMermas Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Etiquetas:
        <Etiquetas Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.HojaCodigos:
        <HojaCodigos Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Paquete:
        <AbrirPaquete Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Proveedores:
        <Proveedores Caja="Caja" Sesion="Sesion" />
        break;
    case Pestanas.Margen:
        <MargenMinimo Caja="Caja" Sesion="Sesion" />
        break;
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    private enum Pestanas { Compras, Ordenes, Sugerido, Conteo, ConteoCompleto, Ajustes, Etiquetas, HojaCodigos, Paquete, Proveedores, Margen }

    private bool Visible(Pestanas p) => p switch
    {
        Pestanas.Ordenes or Pestanas.Sugerido => Sesion.Puede(AccionControlada.PedirCompra),
        Pestanas.Etiquetas or Pestanas.HojaCodigos => Sesion.Puede(AccionControlada.EditarCatalogo),
        Pestanas.Margen => Sesion.Puede(AccionControlada.ConfigurarMargen),
        _ => true,
    };

    private Pestanas _pestana;

    private static string Nombre(Pestanas p) => p switch
    {
        Pestanas.Compras => "Compras",
        Pestanas.Ordenes => "Órdenes de compra",
        Pestanas.Sugerido => "Sugerido de compra",
        Pestanas.Conteo => "Conteo del día",
        Pestanas.ConteoCompleto => "Conteo completo",
        Pestanas.Ajustes => "Ajustes y mermas",
        Pestanas.Etiquetas => "Etiquetas",
        Pestanas.HojaCodigos => "Hoja de códigos",
        Pestanas.Paquete => "Abrir paquete",
        Pestanas.Proveedores => "Proveedores",
        _ => "Margen mínimo",
    };
}
