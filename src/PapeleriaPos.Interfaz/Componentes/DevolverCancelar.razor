@* Devoluciones y cancelaciones con el folio impreso en el ticket (el de la caja o, en el piloto, el de eleventa; el ticket
   no lleva QR por ahora, como el de eleventa: 2026-10-16). Si la regla lo pide, autoriza el encargado.
   En el piloto con eleventa solo se devuelve en efectivo lo que se cobró en efectivo: de un ticket fiado, o con tarjeta o
   transferencia, el servicio dice por qué no se devuelve aquí y no se ofrece (también lo rechaza). *@
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IServiceProvider Servicios

@if (_autorizar is { } pendiente)
{
    <AutorizarAccion Accion="pendiente.Accion" Detalle="@pendiente.Detalle" MontoCentavos="pendiente.Monto" Caja="Caja" Sesion="Sesion"
                     AlAutorizar="a => pendiente.Reintentar(a.Id)" AlCancelar="() => _autorizar = null" />
}
else
{
    <div class="captura-folio">
        <label>Folio del ticket
            <input id="folio" autocomplete="off" @bind="_folio" @bind:event="oninput" @onkeydown="AlTeclearFolio" placeholder="A-000123" />
        </label>
        <button class="boton" @onclick="BuscarAsync">Buscar</button>
    </div>

    @if (_opciones is { } opciones)
    {
        @* El piloto con eleventa: el mismo folio en más de un ticket (eleventa lo repite entre cajas). *@
        <p>El folio <strong>@_folioOpciones</strong> lo tienen @opciones.Count tickets: elige el del cliente por la hora y el total que dice su ticket.</p>
        @if (_aviso is not null)
        {
            <p class="aviso">@_aviso</p>
        }
        <div class="resultados">
            <table>
                <thead><tr><th>Caja</th><th>Fecha y hora</th><th class="num">Total</th><th></th></tr></thead>
                @foreach (var t in opciones)
                {
                    var ticket = t;
                    <tr>
                        <td>@t.Caja</td>
                        <td>@(t.FechaLocal?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="num">@Formato.Dinero(t.TotalCentavos)</td>
                        <td><button class="boton" @onclick="() => ElegirAsync(ticket)">Es este</button></td>
                    </tr>
                }
            </table>
        </div>
    }

    @if (_venta is { } v)
    {
        <p>
            <strong>@v.Folio</strong> · @v.FechaLocal.ToString("dd/MM/yyyy HH:mm") · @Formato.Dinero(v.TotalCentavos)
            @if (v.Estado == EstadoVenta.Cancelada)
            {
                <span class="error"> · cancelado</span>
            }
            else if (v.DiasParaDevolver == 0)
            {
                <span class="error"> · ya pasaron 7 días: no admite devoluciones</span>
            }
        </p>
        @if (v.NoSeDevuelveEnElPiloto is { } noSeDevuelve)
        {
            <p class="aviso">@noSeDevuelve</p>
        }
        else if (v.CreditoCentavos > 0)
        {
            <p class="aviso">Este ticket se fió (@Formato.Dinero(v.CreditoCentavos) a «@v.Cliente»): lo devuelto baja primero su cuenta, y solo sale en efectivo lo que pagó.</p>
        }
        <div class="resultados">
            <table>
                <thead><tr><th>Descripción</th><th class="num">Vendido</th><th class="num">Ya devuelto</th><th class="num">Importe</th><th class="num">Devolver</th><th>Dañado</th></tr></thead>
                @foreach (var l in v.Lineas)
                {
                    var linea = l;
                    var queda = (l.CantidadMilesimas - l.CantidadDevueltaMilesimas) / 1000m;
                    <tr>
                        <td>@l.Descripcion</td>
                        <td class="num">@Formato.Numero(l.CantidadMilesimas / 1000m)</td>
                        <td class="num">@Formato.Numero(l.CantidadDevueltaMilesimas / 1000m)</td>
                        <td class="num">@Formato.Dinero(l.ImporteCentavos)</td>
                        <td class="num">
                            @if (queda > 0 && v is { Estado: EstadoVenta.Pagada, NoSeDevuelveEnElPiloto: null })
                            {
                                <input class="cantidad-devolver" inputmode="decimal" placeholder="0" value="@_cantidades.GetValueOrDefault(l.LineaId)"
                                       @onchange="e => _cantidades[linea.LineaId] = e.Value?.ToString() ?? string.Empty" />
                            }
                        </td>
                        <td>
                            @if (l.LlevaInventario && queda > 0 && v.NoSeDevuelveEnElPiloto is null)
                            {
                                <input type="checkbox" checked="@_danados.Contains(l.LineaId)" @onchange="e => Marcar(linea.LineaId, e.Value is true)" />
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>
        @if (v.NoSeDevuelveEnElPiloto is null)
        {
            <label>Motivo <input @bind="_motivo" @bind:event="oninput" autocomplete="off" /></label>
        }
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_venta is { Estado: EstadoVenta.Pagada, NoSeDevuelveEnElPiloto: null } venta)
    {
        <div class="acciones">
            @if (venta.PuedeCancelar)
            {
                <button class="boton" disabled="@_ocupado" @onclick="() => CancelarAsync(null)">Cancelar todo el ticket</button>
            }
            <button class="boton principal" disabled="@(_ocupado || venta.DiasParaDevolver == 0)" @onclick="() => DevolverAsync(null)">Devolver lo marcado</button>
        </div>
        <p class="nota">Cancelar es todo el ticket y solo en el mismo turno; después es devolución (con ticket y hasta 7 días). El reembolso sale en efectivo.</p>
        @if (PilotoEleventa)
        {
            <p class="nota">@PilotoConEleventa.SoloSeDevuelveEfectivo</p>
            <p class="nota">@PilotoConEleventa.SoloSeCancelaElMismoDia</p>
        }
    }
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter] public string? FolioInicial { get; set; }
    [Parameter] public EventCallback<ComprobanteDevolucionDto> AlTerminar { get; set; }

    /// <summary>El piloto con eleventa: solo se devuelve en efectivo y solo se cancela lo del mismo día (se quita al dejar eleventa).</summary>
    [CascadingParameter(Name = PilotoConEleventa.Cascada)] public bool PilotoEleventa { get; set; }

    private sealed record Pendiente(AccionControlada Accion, string Detalle, long Monto, Func<Guid, Task> Reintentar);

    private string _folio = "";
    private string _motivo = "";
    private VentaParaDevolverDto? _venta;
    private readonly Dictionary<Guid, string> _cantidades = [];
    private readonly HashSet<Guid> _danados = [];
    private Pendiente? _autorizar;
    private string? _error;
    private bool _ocupado;

    protected override async Task OnInitializedAsync()
    {
        if (FolioInicial is { Length: > 0 } folio)
        {
            _folio = folio;
            await BuscarAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera && _venta is null)
            await Js.EnfocarAsync("#folio");
    }

    private async Task AlTeclearFolio(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await BuscarAsync();
    }

    /// <summary>
    /// El piloto con eleventa: los tickets que llevan el folio de eleventa escrito, cuando son más de uno (eleventa lo repite
    /// entre cajas). Se elige por la hora y el total. Vacío si no.
    /// </summary>
    private IReadOnlyList<TicketConFolioDto>? _opciones;
    private string _folioOpciones = "";
    private string? _aviso;

    /// <summary>
    /// El piloto con eleventa: el ticket que se devuelve es uno cobrado en eleventa (la ida), leído en vivo; su
    /// <c>VENTATICKETS.ID</c>. Vacío si es de esta caja.
    /// </summary>
    private int? _ticketEleventa;

    private async Task BuscarAsync()
    {
        _error = null;
        _aviso = null;
        _opciones = null;
        _ticketEleventa = null;
        _cantidades.Clear();
        _danados.Clear();
        var folio = _folio.Trim();
        try
        {
            // El piloto: el folio impreso puede ser el de eleventa (solo número): de esta caja, de otra caja de eleventa, o de
            // las dos si eleventa lo repitió.
            if (PilotoEleventa && folio.Length > 0 && folio.All(char.IsAsciiDigit) && int.TryParse(folio, out var deEleventa)
                && Servicios.GetService<ClientePuente>() is { } puente && await TicketsConFolioAsync(puente, deEleventa) is { } encontrado)
            {
                var tickets = encontrado.Tickets;
                _aviso = encontrado.Aviso;
                switch (tickets)
                {
                    case []:
                        // Sin eleventa no se sabe si es de otra caja: se dice, y si no, se busca como siempre.
                        if (_aviso is { } sinEleventa)
                        {
                            (_venta, _error) = (null, sinEleventa);
                            return;
                        }
                        break;
                    case [{ FolioCaja: { } deLaCaja }]:
                        folio = deLaCaja;
                        break;
                    // Uno solo de eleventa se abre, aunque no se devuelva aquí (de otro turno, de otra caja…): la ventana dice por qué.
                    case [{ FolioCaja: null, TicketEleventa: { } unico }] when _aviso is null:
                        await AbrirDeEleventaAsync(puente, unico);
                        return;
                    default:
                        _venta = null;
                        (_opciones, _folioOpciones) = (tickets, folio);
                        return;
                }
            }
            _venta = await Cliente.VentaPorFolioAsync(Caja.SucursalId, folio);
            if (_venta is null)
                _error = $"No existe el ticket «{_folio.Trim()}».";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Lo que el puente sabe de ese folio; si no contesta (un servicio de antes), se busca como siempre.</summary>
    private static async Task<FolioEleventaDto?> TicketsConFolioAsync(ClientePuente puente, int folio)
    {
        try
        {
            return await puente.FolioAsync(folio);
        }
        catch (ErrorCaja)
        {
            return null;
        }
    }

    /// <summary>
    /// El que eligió el cajero de los que tienen el mismo folio: el de esta caja se abre aquí; el de otra caja de eleventa,
    /// también (se lee en vivo), salvo que no se pueda devolver aquí: entonces se dice por qué.
    /// </summary>
    private async Task ElegirAsync(TicketConFolioDto ticket)
    {
        _error = null;
        try
        {
            if (ticket.FolioCaja is { } folio)
            {
                _venta = await Cliente.VentaPorFolioAsync(Caja.SucursalId, folio);
                _ticketEleventa = null;
                _opciones = null;
                if (_venta is null)
                    _error = $"No existe el ticket «{folio}».";
            }
            else if (ticket is { Nota: null, TicketEleventa: { } deEleventa } && Servicios.GetService<ClientePuente>() is { } puente)
                await AbrirDeEleventaAsync(puente, deEleventa);
            else
                _error = ticket.Nota;
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Un ticket cobrado en eleventa, leído en vivo: se devuelve aquí como uno de esta caja (la ida).</summary>
    private async Task AbrirDeEleventaAsync(ClientePuente puente, int ticket)
    {
        _venta = await puente.TicketAsync(ticket);
        _ticketEleventa = ticket;
        _opciones = null;
    }

    private void Marcar(Guid lineaId, bool danado)
    {
        if (danado)
            _danados.Add(lineaId);
        else
            _danados.Remove(lineaId);
    }

    private async Task CancelarAsync(Guid? autorizacionId)
    {
        var venta = _venta!;
        await EjecutarAsync(AccionControlada.CancelarTicket, $"Cancelar el ticket {venta.Folio}", venta.TotalCentavos, CancelarAsync,
            () => Cliente.CancelarAsync(venta.Id, new SolicitudCancelacion(Sesion.UsuarioId, Caja.Id, _motivo, autorizacionId)));
    }

    private async Task DevolverAsync(Guid? autorizacionId)
    {
        var venta = _venta!;
        var lineas = new List<LineaDevolucionSolicitada>();
        long monto = 0;
        foreach (var l in venta.Lineas)
        {
            if (!_cantidades.TryGetValue(l.LineaId, out var texto) || string.IsNullOrWhiteSpace(texto))
                continue;
            if (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var cantidad) || cantidad < 0)
            {
                _error = $"Cantidad inválida en «{l.Descripcion}».";
                return;
            }
            if (cantidad == 0)
                continue;
            var milesimas = (long)Math.Round(cantidad * 1000);
            lineas.Add(new LineaDevolucionSolicitada(l.LineaId, milesimas, !_danados.Contains(l.LineaId)));
            // Igual que quien la hace, para que la autorización cuadre: el servicio (CalculoDevolucion), en proporción y redondeado
            // sobre lo ya devuelto; el puente, con un ticket de eleventa, en proporción a lo vendido.
            monto += _ticketEleventa is null
                ? CalculoDevolucion.ParteDe(l.ImporteCentavos, new Cantidad(l.CantidadDevueltaMilesimas), new Cantidad(milesimas), new Cantidad(l.CantidadMilesimas))
                : milesimas == l.CantidadMilesimas ? l.ImporteCentavos : Redondeo.Dividir((Int128)l.ImporteCentavos * milesimas, l.CantidadMilesimas);
        }
        if (lineas.Count == 0)
        {
            _error = "Escribe cuánto se devuelve de cada artículo.";
            return;
        }
        var solicitud = new SolicitudDevolucion(Sesion.UsuarioId, Caja.Id, _motivo, lineas, autorizacionId);
        // La ida: un ticket de eleventa se devuelve por el puente (sale de esta caja y va a eleventa por la bandeja).
        await EjecutarAsync(AccionControlada.Devolucion, $"Devolución del ticket {venta.Folio}", monto, DevolverAsync,
            _ticketEleventa is { } deEleventa && Servicios.GetService<ClientePuente>() is { } puente
                ? () => puente.DevolverAsync(deEleventa, solicitud)
                : () => Cliente.DevolverAsync(venta.Id, solicitud));
    }

    /// <summary>Hace la operación; si la regla pide autorización, muestra la ventana del encargado y la repite con ella.</summary>
    private async Task EjecutarAsync(AccionControlada accion, string detalle, long monto, Func<Guid?, Task> repetir, Func<Task<ComprobanteDevolucionDto>> operacion)
    {
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _error = "Escribe el motivo.";
            return;
        }
        _error = null;
        _ocupado = true;
        try
        {
            var comprobante = await operacion();
            _autorizar = null;
            await AlTerminar.InvokeAsync(comprobante);
        }
        catch (ErrorCaja ex) when (ex.Codigo == "requiere-autorizacion")
        {
            _autorizar = new Pendiente(accion, detalle, monto, id => repetir(id));
        }
        catch (ErrorCaja ex)
        {
            _autorizar = null;
            _error = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
