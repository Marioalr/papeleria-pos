    private async Task ConfirmarReimpresionAsync(string motivo)
    {
        _ocupadoMotivo = true;
        try
        {
            var ventaId = _reimprimir ?? (await Cliente.UltimoTicketAsync(Caja.Id))?.VentaId
                ?? throw new ErrorCaja("Esta caja todavía no tiene ventas.");
            var ticket = await Cliente.ReimprimirAsync(ventaId, new SolicitudReimpresion(Sesion.UsuarioId, Caja.Id, motivo));
            await ImprimirAsync(ticket, abrirCajon: false);
        }
        catch (ErrorCaja ex)
        {
            _errorMotivo = ex.Message;
        }
        finally
        {
            _ocupadoMotivo = false;
        }
    }

    // ── Impresiones (F2) ────────────────────────────────────────────────────

    /// <summary>Las elegidas reemplazan a las que había: van juntas en la línea "Impresiones".</summary>
    private async Task ImpresionesElegidasAsync(IReadOnlyList<ImpresionPorCobrarDto> elegidas)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        _cobrado = null;
        await Cerrar();
        Actual.Impresiones.Clear();
        Actual.Impresiones.AddRange(elegidas);
        // El costo no viaja a la caja: el servicio pone el de cada trabajo al cobrar.
        var linea = Actual.Venta.FijarImpresiones(elegidas.Sum(i => i.PrecioCentavos), 0);
        _seleccion = linea is null ? Math.Min(_seleccion, Actual.Venta.Lineas.Count - 1) : Actual.Venta.Lineas.IndexOf(linea);
    }

    // ── Descuento (Ctrl+D) ──────────────────────────────────────────────────

    private async Task DescuentoAplicadoAsync()
    {
        await Cerrar();
        Avisar(Actual.Venta.DescuentoCentavos > 0 ? $"Descuento de {Formato.Dinero(Actual.Venta.DescuentoCentavos)}." : "Se quitaron los descuentos.", error: false);
    }

    private ElegirCliente? _elegirCliente;

    /// <summary>Lo que dejan los descuentos debajo del costo y falta autorizar antes de cobrar.</summary>
    private sealed record CostoPorAutorizar(string Detalle, long Monto);

    private CostoPorAutorizar? _costoPorAutorizar;

    /// <summary>
    /// F12: si el ticket lleva descuentos (el del cliente se pone solo al agregar), antes de cobrar se revisa que nada quede
    /// debajo del costo sin autorización; si falta, se pide aquí y no hasta que el cobro falle.
    /// </summary>
    private async Task AbrirCobroAsync()
    {
        // La ventana se abre con la última línea: el exacto que trae ya la cuenta.
        await _captura.EsperarAsync();
        if (Actual.Venta.Lineas.Count == 0 || !await RevisarCostoAsync())
            return;
        await CargarCuentaAsync(Actual);
        await Abrir(Ventanas.Cobrar);
    }

    /// <summary>Si se puede cobrar ya. Si algo queda debajo del costo y hace falta autorizarlo, abre su ventana y devuelve false.</summary>
    private async Task<bool> RevisarCostoAsync()
    {
        var venta = Actual.Venta;
        if (!venta.Lineas.Any(l => l.TieneDescuento || l.PrecioCambiado) || venta.AutorizacionBajoCostoId is not null)
            return true;
        try
        {
            var bajoCosto = await Cliente.BajoCostoAsync(new SolicitudBajoCosto(Caja.Id, ArmadoSolicitud.Lineas(venta), venta.ClienteId, venta.MayoreoDeCliente));
            if (bajoCosto.FaltanteCentavos <= 0)
                return true;
            var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.VenderBajoCosto,
                bajoCosto.FaltanteCentavos));
            switch (decision.Nivel)
            {
                case NivelPermiso.NoPermitido:
                    Avisar($"Quedan debajo del costo ({string.Join(", ", bajoCosto.Lineas)}) y no tienes permiso para venderlos así.");
                    return false;
                case NivelPermiso.RequiereAutorizacion:
                    _costoPorAutorizar = new CostoPorAutorizar($"Con descuento quedan debajo del costo: {string.Join(", ", bajoCosto.Lineas)}",
                        bajoCosto.FaltanteCentavos);
                    await Abrir(Ventanas.AutorizarCosto);
                    return false;
                default:
                    return true;
            }
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
            return false;
        }
    }

    private async Task CostoAutorizadoAsync(Guid autorizacionId)
    {
        Actual.Venta.AutorizacionBajoCostoId = autorizacionId;
        _costoPorAutorizar = null;
        // En la pantalla nueva, de regreso al panel del total, y se sigue con el cobro que se pidió (con lo que ya se escribió).
        if (_pantallaNueva)
        {
            await Cerrar();
            await CobrarEnPanelAsync();
            StateHasChanged();
            return;
        }
        await CargarCuentaAsync(Actual);
        await Abrir(Ventanas.Cobrar);
    }

    /// <summary>La cuenta del cliente del ticket (lo que debe y su límite). Sin conexión, la que conoce esta caja; sin los saldos, no se fía.</summary>
    private async Task CargarCuentaAsync(TicketAbierto ticket)
    {
        if (ticket.Cliente is not { } cliente)
        {
            ticket.Cuenta = null;
            return;
        }
        try
        {
            ticket.Cuenta = await Cliente.CreditoAsync(cliente.Id);
        }
        catch (ErrorCaja)
        {
            ticket.Cuenta = null;
        }
    }

    /// <summary>
    /// Un abono o su cancelación, o un saldo a favor devuelto: se imprime su comprobante (en efectivo se abre el cajón:
    /// entra o sale dinero, y el servicio lo registra) y se pone al día la cuenta del ticket.
    /// </summary>
    private async Task AbonoRegistradoAsync(ComprobanteAbonoDto comprobante)
    {
        await Cerrar();
        if (comprobante.EsSaldoDevuelto)
            Avisar($"Entrega {Formato.Dinero(comprobante.CobradoCentavos)} en efectivo a «{comprobante.Cliente}» (su saldo a favor) y que firme el comprobante.",
                error: false);
        else
            Avisar(comprobante.Cancelado
                ? $"Se canceló el abono {comprobante.Folio}"
                  + (comprobante.Forma == FormaPago.Efectivo ? $": entrega {Formato.Dinero(comprobante.CobradoCentavos)} en efectivo" : "")
                  + $". «{comprobante.Cliente}» vuelve a deber {Formato.Dinero(comprobante.MontoCentavos)}."
                : $"Abono de {Formato.Dinero(comprobante.MontoCentavos)} de «{comprobante.Cliente}». Saldo: {Formato.Dinero(comprobante.SaldoCentavos)}"
                  + (comprobante.Forma == FormaPago.Efectivo ? $". Cambio: {Formato.Dinero(comprobante.CambioCentavos)}." : "."), error: false);
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == comprobante.ClienteId))
            await CargarCuentaAsync(ticket);
        await ImprimirDocumentoAsync($"{(comprobante.EsSaldoDevuelto ? "Saldo devuelto" : "Abono")} {comprobante.Folio}", DisenoComprobante.Abono(comprobante),
            abrirCajon: comprobante.AbreCajon);
        await RevisarEfectivoAsync();
    }

    /// <summary>El estado de cuenta de un cliente: solo el papel (no entra ni sale dinero).</summary>
    private Task EstadoDeCuentaAsync(EstadoCuentaDto estado) =>
        ImprimirDocumentoAsync($"Estado de cuenta de {estado.Cliente}", DisenoComprobante.EstadoCuenta(estado), abrirCajon: false);

    /// <summary>Una reimpresión: solo el papel; el cajón no se abre (no entra ni sale dinero).</summary>
    private async Task AbonoReimpresoAsync(ComprobanteAbonoDto comprobante)
    {
        await Cerrar();
        Avisar($"Se reimprimió el abono {comprobante.Folio}.", error: false);
        await ImprimirDocumentoAsync($"{(comprobante.EsSaldoDevuelto ? "Saldo devuelto" : "Abono")} {comprobante.Folio}", DisenoComprobante.Abono(comprobante),
            abrirCajon: false);
    }

    /// <summary>
    /// Se editó un cliente en el módulo Clientes: los tickets abiertos que lo tienen se ponen al día (su descuento y su
    /// mayoreo); si quedó inactivo, sale del ticket.
    /// </summary>
    private async Task ClienteGuardadoAsync(ClienteRegistradoDto guardado)
    {
        ClienteGuardado(guardado);
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == guardado.Id))
            await CargarCuentaAsync(ticket);
    }

    private void ClienteGuardado(ClienteRegistradoDto guardado)
    {
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == guardado.Id))
        {
            var nuevo = guardado.Activo ? guardado : null;
            try
            {
                ClienteEnTicket.Cambiar(ticket.Venta, ticket.Cliente, nuevo, l => CatalogoDe(ticket, l));
                ticket.Cliente = nuevo;
                // El costo se vuelve a revisar al cobrar.
                ticket.Venta.AutorizacionBajoCostoId = null;
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
            {
                Avisar($"El ticket {ticket.Numero} no se pudo poner al día con el cliente: {ex.Message}");
                continue;
            }
            Avisar(nuevo is null ? $"«{guardado.Nombre}» quedó inactivo: salió del ticket {ticket.Numero}."
                : $"El ticket {ticket.Numero} ya va con lo nuevo de «{guardado.Nombre}».", error: false);
        }
    }

    private async Task ClienteElegidoAsync(ClienteRegistradoDto? cliente)
    {
        Actual.Cliente = cliente;
        // Lo que se iba a fiar era del cliente de antes.
        _otras.RemoveAll(o => o.Forma == FormaPago.Credito);
        await Cerrar();
        await CargarCuentaAsync(Actual);
        Avisar(cliente is null ? "El ticket ya no tiene cliente." : $"Cliente: {ArmadoTicket.ClienteTexto(cliente)}.", error: false);
    }

    /// <summary>La presentación y los precios de un renglón, de la copia que ya tiene el ticket (funciona sin conexión).</summary>
    private (Presentacion Presentacion, IReadOnlyList<Precio> Precios)? CatalogoDe(VentaLinea linea) => CatalogoDe(Actual, linea);

    private static (Presentacion Presentacion, IReadOnlyList<Precio> Precios)? CatalogoDe(TicketAbierto ticket, VentaLinea linea) =>
        linea.VarianteId is { } varianteId && ticket.Productos.TryGetValue(varianteId, out var producto)
            ? (producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo())
            : null;

    /// <summary>Con cliente con descuento, lo que se agrega al ticket lleva el suyo (el mayoreo ya sale solo del precio).</summary>
    private void DescuentoDelCliente(VentaLinea linea)
    {
        if (Actual.Cliente is { DescuentoCentesimas: > 0 } cliente && !linea.EsImpresiones && linea.DescuentoCentesimas != cliente.DescuentoCentesimas)
            Actual.Venta.DescontarLinea(linea, cliente.DescuentoCentesimas, null, cliente.MotivoDescuento());
    }

