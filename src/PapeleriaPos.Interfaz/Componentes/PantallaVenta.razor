    {
        { Nivel: NivelPermiso.RequiereAutorizacion } p => $"Lo autoriza {Quien(p)}",
        { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral } p => $"Tú: hasta {Permisos.TextoMonto(accion, umbral)}; más, lo autoriza {Quien(p)}",
        _ => null,
    };

    // ── «/»: todas las acciones de quien entró ──────────────────────────────

    private sealed record AccionDeVenta(string Nombre, string Icono, string? Tecla, AccionControlada? Regla, Func<Task> Hacer);

    /// <summary>Lo que sale al escribir «/»; null: la lista está cerrada.</summary>
    private List<AccionDeVenta>? _accionesVistas;

    private string _textoAcciones = "";
    private int _indiceAccion;

    private IEnumerable<AccionDeVenta> TodasLasAcciones()
    {
        yield return new("Cobrar", "efectivo", "F12", null, IrAlCobroAsync);
        yield return new("Buscar producto por nombre", "buscar", "F10", null, () =>
        {
            Buscar();
            return Task.CompletedTask;
        });
        yield return new("Verificar precio sin vender", "ojo", "F9", null, () => Abrir(Ventanas.Verificador));
        yield return new("Impresiones por cobrar", "impresora", "F2", null, () => Abrir(Ventanas.Impresiones));
        yield return new("Artículo común (sin inventario)", "etiqueta", "Ins", AccionControlada.ArticuloComun, () => Abrir(Ventanas.Comun));
        yield return new("Elegir cliente del ticket", "clientes", "Ctrl+L", null, () => Abrir(Ventanas.ElegirCliente));
        if (!_pilotoEleventa)
            yield return new("Abono a la cuenta de un cliente", "efectivo", "Ctrl+B", null, () => Abrir(Ventanas.Abono));
        yield return new("Cambiar precio del artículo", "etiqueta", "Ctrl+E", AccionControlada.CambiarPrecio, AbrirCambioPrecio);
        yield return new("Descuento", "porcentaje", "Ctrl+D", AccionControlada.Descuento, () => Abrir(Ventanas.Descuento));
        yield return new("Ver el mayoreo del artículo", "capas", "F11", null, MayoreoAsync);
        yield return new("Quitar el artículo", "basura", "Supr", AccionControlada.QuitarProducto, BorrarSeleccion);
        yield return new("Poner el ticket en espera", "pausa", "F6", null, PonerEnEsperaAsync);
        yield return new("Retomar un ticket en espera", "ticket", "F5", null, async () =>
        {
            await _captura.EsperarAsync();
            RetomarPrimero();
        });
        yield return new("Entrada de efectivo", "entrada", "F7", AccionControlada.EntradaEfectivo, () => Abrir(Ventanas.Entrada));
        yield return new("Salida de efectivo", "salida", "F8", AccionControlada.SalidaEfectivo, () => Abrir(Ventanas.Salida));
        yield return new("Devolver o cancelar un ticket", "volver", "folio", AccionControlada.Devolucion, () => AbrirDevolucion(null));
        yield return new("Reimprimir el último ticket", "impresora", null, AccionControlada.Reimprimir, ReimprimirUltimoAsync);
        yield return new("Ventas del día", "lista", null, null, () => Abrir(Ventanas.VentasDelDia));
        yield return new("Cotizar un PDF", "impresora", "Ctrl+Q", null, () => Js.ClicAsync("#pdf-cotizar"));
        yield return new("Verificar transferencias", "check", null, AccionControlada.VerificarTransferencia, () => Abrir(Ventanas.Transferencias));
        yield return new("Corte", "contar", null, null, () => Abrir(Ventanas.Corte));
        yield return new("Conteo del día", "contar", null, AccionControlada.ContarInventario, () => IrAAsync(Pagina.Inventario, TareaInventario.ConteoDelDia));
        yield return new("Productos", "cajas", "F3", AccionControlada.EditarCatalogo, () => IrAAsync(Pagina.Productos));
        if (VeInventario)
            yield return new("Inventario: recibir, contar y mermas", "recibir", "F4", null, () => IrAAsync(Pagina.Inventario));
        // Para todos, como la pestaña: quien no los administra solo los consulta.
        yield return new("Clientes", "clientes", null, null, () => IrAAsync(Pagina.Clientes));
        if (VeConfiguracion)
            yield return new("Configuración", "engrane", null, null, () => Abrir(Ventanas.Configuracion));
        yield return new("Cambiar de usuario", "usuario", "Ctrl+U", null, SalirAsync);
    }

    /// <summary>Las que puede (lo que no, no sale) y se llaman como lo escrito después de «/», sin acentos.</summary>
    private void MostrarAcciones(string filtro)
    {
        var buscado = Texto.Normalizar(filtro);
        _accionesVistas = TodasLasAcciones()
            .Where(a => a.Regla is not { } regla || Ve(regla))
            .Where(a => buscado.Length == 0 || Texto.Normalizar(a.Nombre).Contains(buscado, StringComparison.Ordinal))
            .ToList();
        (_textoAcciones, _indiceAccion) = (filtro, 0);
    }

    private void CerrarAcciones() => _accionesVistas = null;

    private void MoverAccion(int paso)
    {
        if (_accionesVistas is not { Count: > 0 } acciones)
            return;
        _indiceAccion = Math.Clamp(_indiceAccion + paso, 0, acciones.Count - 1);
        _ = Js.MostrarAsync($"#acc-{_indiceAccion}");
    }

    /// <summary>«/ Más acciones» en la barra de teclas: el «/» queda en el cuadro y la lista abierta.</summary>
    private async Task AbrirAccionesAsync()
    {
        // Con un panel abierto, se cierra: la lista y su Enter son del cuadro de captura. Si espera su Enter (o una
        // autorización), lo dice, como con las teclas.
        if (PorQueNoSeDeja is { } espera)
        {
            AvisarEnElPanel(espera);
            return;
        }
        if (_ventana != Ventanas.Ninguna)
            await Cerrar();
        CerrarResultados();
        _captura.Texto = "/";
        await Js.EscribirCapturaAsync("/");
        MostrarAcciones("");
    }

    private async Task HacerAccionAsync(int indice)
    {
        if (_accionesVistas is not { } acciones || indice < 0 || indice >= acciones.Count)
            return;
        var accion = acciones[indice];
        CerrarAcciones();
        VaciarCaptura();
        _enfocar = "#codigo";
        await accion.Hacer();
        // Si abrió una ventana o una página, el cursor se queda en ella.
        if (_ventana != Ventanas.Ninguna || _pagina != Pagina.Venta)
            _enfocar = null;
    }

    /// <summary>Enter con «/algo»: la elegida con ↑ ↓, o la primera que se llama así.</summary>
    private async Task HacerAccionDeTextoAsync(string filtro)
    {
        if (_accionesVistas is null || filtro != _textoAcciones)
            MostrarAcciones(filtro);
        if (_accionesVistas is { Count: > 0 })
            await HacerAccionAsync(_indiceAccion);
        else
        {
            CerrarAcciones();
            Avisar($"Ninguna acción se llama «{filtro}».");
        }
    }

    /// <summary>Lo que se escribió después de «/», o null si no empieza con «/».</summary>
    private static string? FiltroDeAcciones(string texto) => texto.TrimStart() is ['/', .. var resto] ? resto.Trim() : null;

    /// <summary>Un rápido con el producto al que apunta (para su precio); sin conexión al cargar, el producto se pide al usarlo.</summary>
    private sealed record RapidoListo(Rapido Rapido, ProductoVentaDto? Producto, long? PrecioCentavos)
    {
        /// <summary>Su botón: el mismo en cada pintado, así la página no cambia su manejador con cada escaneo.</summary>
        public Func<Task> Agregar { get; init; } = () => Task.CompletedTask;
    }

    private List<RapidoListo> _rapidos = [];

    private async Task CargarRapidosAsync()
    {
        try
        {
            var listos = new List<RapidoListo>();
            foreach (var rapido in (await Cliente.RapidosAsync(Caja.SucursalId)).Take(Rapido.Maximo))
            {
                // De la copia de la caja, si ya la tiene: sin una consulta por cada rápido.
                var producto = Cliente.Foto?.PorVariante(rapido.VarianteId) ?? await Cliente.PorVarianteAsync(rapido.VarianteId, Caja.SucursalId);
                var indice = listos.Count;
                listos.Add(new RapidoListo(rapido, producto, producto is null ? null : PrecioDelRapido(rapido, producto, Caja.SucursalId))
                {
                    Agregar = () => RapidoAsync(indice),
                });
            }
            _rapidos = listos;
        }
        catch (ErrorCaja)
        {
            // Sin conexión, la fila queda sin rápidos; al volver a entrar se cargan.
            _rapidos = [];
        }
    }

    /// <summary>
    /// Lo que dice la fila de rápidos: el precio por pieza de menudeo (el de la sucursal si tiene, si no el general) por la
    /// cantidad del rápido. Público para que las pruebas revisen los de la base de la prueba con la misma cuenta.
    /// </summary>
    public static long PrecioDelRapido(Rapido rapido, ProductoVentaDto producto, Guid sucursalId)
    {
        var porUnidad = producto.Precios.Where(p => p.PresentacionId is null).ToList();
        var deSucursal = porUnidad.Where(p => p.SucursalId == sucursalId).ToList();
        var menudeo = (deSucursal.Count > 0 ? deSucursal : porUnidad.Where(p => p.SucursalId is null)).MinBy(p => p.CantidadMinimaMilesimas)?.PrecioCentavos ?? 0;
        return (long)Math.Round(menudeo * rapido.Cantidad);
    }

    /// <summary>Alt+1 a Alt+6 o el botón. Un número en el cuadro es cuántos: «20» y Alt+1 son veinte copias.</summary>
    private async Task RapidoAsync(int indice)
    {
        if (indice < 0 || indice >= _rapidos.Count)
            return;
        var (rapido, cargado, _) = _rapidos[indice];
        var texto = _captura.Texto.Trim();
        var veces = 1m;
        if (texto.Length > 0 && (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out veces) || veces <= 0))
        {
            Avisar($"Antes de un rápido solo va la cantidad: «{texto}» no lo es.");
            return;
        }
        VaciarCaptura();
        _enfocar = "#codigo";
        // En la cola, como un escaneo: en orden con ellos, y no cae en un ticket que se está cobrando.
        await _captura.EnTurnoAsync(async () =>
        {
            // Como un escaneo: de la copia de la caja, con los precios de ahora; si no está, el que se cargó al entrar, o se pide.
            var producto = Cliente.Foto?.PorVariante(rapido.VarianteId) ?? cargado;
            try
            {
                producto ??= await Cliente.PorVarianteAsync(rapido.VarianteId, Caja.SucursalId);
            }
            catch (ErrorCaja ex)
            {
                Avisar(ex.Message);
                return;
            }
            if (producto is null)
            {
                Avisar($"El producto del rápido «{rapido.Nombre}» ya no está en el catálogo: hay que elegirlo otra vez en Configuración.");
                return;
            }
            Agregar(producto, null, Cantidad.Unidades(Math.Round(veces * rapido.Cantidad, 3)));
        });
    }

    /// <summary>Los tickets en espera: los que tienen algo y no son el que se atiende, en el orden en que se apartaron.</summary>
    private IEnumerable<TicketAbierto> EnEspera => _tickets.Where(t => t != Actual && t.Venta.Lineas.Count > 0);

    /// <summary>
    /// Cuántos se ven como ficha junto a «Poner en espera»; los demás van en «Más». Se cambia en Configuración › Venta y
    /// cobro (entrega 7); mientras llega, y sin conexión ni copia, los de siempre.
    /// </summary>
    private int _fichasEnEspera = ConfiguracionSucursal.FichasEnEsperaPorOmision;

    /// <summary>Lo de la configuración de la tienda que usa la venta: cuántas fichas de la espera se ven.</summary>
    private async Task CargarConfiguracionAsync()
    {
        try
        {
            _fichasEnEspera = (await Cliente.ConfiguracionSucursalAsync(Caja.SucursalId)).FichasEnEspera;
        }
        catch (ErrorCaja)
        {
            // Sin conexión y sin copia: las de siempre.
        }
    }

    /// <summary>La Configuración guardó algo que usa la venta: las fichas de la espera y los rápidos se vuelven a pedir.</summary>
    private async Task ConfiguracionCambiadaAsync()
    {
        await CargarConfiguracionAsync();
        await CargarRapidosAsync();
    }

    /// <summary>
    /// Se cerró la Configuración con algo escrito que no se pudo guardar (Esc sin salir del campo): ya no está su renglón para
    /// decirlo, así que se dice aquí abajo.
    /// </summary>
    private void ConfiguracionNoGuardada(string porQue) => Avisar(porQue);

    /// <summary>Con más de estos en «Más», el menú lleva flechas arriba y abajo.</summary>
    private const int FilasDelMenu = 5;

    private bool _menuEspera;

    private static string Desde(TicketAbierto ticket) => HoraMexico.ALocal(ticket.Venta.CreadaUtc).ToString("HH:mm");

    private static string TituloEspera(TicketAbierto ticket, bool primero) =>
        $"En espera desde las {Desde(ticket)}, {ArticulosTexto(ticket.Venta)}. Retomar{(primero ? " (F5)" : "")}: el ticket actual pasa a la espera";

    /// <summary>F6: guarda este ticket y deja la caja lista para el siguiente cliente.</summary>
    private void PonerEnEspera()
    {
        if (Actual.Venta.Lineas.Count == 0)
        {
            Avisar("El ticket está vacío: no hay nada que poner en espera.", error: false);
            return;
        }
        NuevoTicket();
        Avisar("Ticket en espera. Atiende al siguiente; lo retomas arriba o con F5.", error: false);
    }

    /// <summary>
    /// El botón «Poner en espera» (y la acción): como F6, primero espera lo que se escaneó y lo que se le pregunta a la caja
    /// principal, para que todo quede en el ticket que se aparta.
    /// </summary>
    private async Task PonerEnEsperaAsync()
    {
        await _captura.EsperarAsync();
        PonerEnEspera();
    }

    /// <summary>El botón de su ficha: el mismo en cada pintado (la página no cambia su manejador con cada escaneo).</summary>
    private Func<Task> AlRetomar(TicketAbierto ticket) => ticket.AlRetomar ??= () => RetomarAsync(ticket);

    /// <summary>Una ficha de la espera, con el mouse: como F5, primero espera lo que se escaneó en el ticket que se atiende.</summary>
    private async Task RetomarAsync(TicketAbierto ticket)
    {
        _menuEspera = false;
        await _captura.EsperarAsync();
        if (_tickets.Contains(ticket))
            Retomar(ticket);
    }

    /// <summary>
    /// Retomar un ticket en espera: el que se atendía pasa a la espera (si estaba vacío, se descarta; no si se le pregunta
    /// algo a la caja principal: su línea llega ahí).
    /// </summary>
    private void Retomar(TicketAbierto ticket)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        _cobrado = null;
        _menuEspera = false;
        if (Actual.Venta.Lineas.Count == 0 && Actual.Buscando.Count == 0 && Actual != ticket)
            _tickets.Remove(Actual);
        Cambiar(ticket);
        _enfocar = "#codigo";
        Avisar($"Retomaste el ticket de las {Desde(ticket)}.", error: false);
    }

    /// <summary>F5: el que lleva más tiempo esperando.</summary>
    private void RetomarPrimero()
    {
        if (EnEspera.FirstOrDefault() is { } ticket)
            Retomar(ticket);
        else
            Avisar("No hay tickets en espera.", error: false);
    }

    /// <summary>Los botones − y + de la fila: cambian la cantidad de ese renglón.</summary>
    private async Task PasoCantidadAsync(int indice, int paso)
    {
        _seleccion = indice;
        await CambiarCantidadSeleccion(paso);
        _enfocar = "#codigo";
    }

    // ── El cobro en el panel: «Pagó con» siempre a la vista ─────────────────

    /// <summary>Lo que dio el cliente. Vacío: se cobra exacto (el exacto se ve en gris en el cuadro).</summary>
    private string _pagoCon = "";

    private bool _enPago;
    private bool _cobrando;

    /// <summary>Tarjeta, transferencia o crédito en el panel del total: cada una en su renglón.</summary>
    private sealed class OtraForma(FormaPago forma, string monto)
    {
        public FormaPago Forma { get; } = forma;
        public string Monto { get; set; } = monto;
        public string Referencia { get; set; } = "";

        /// <summary>Vacío cuenta como cero; lo que no es una cantidad, null.</summary>
        public long? Centavos => Monto.Trim().Length == 0 ? 0 : Formato.LeerPesos(Monto);
    }

    private readonly List<OtraForma> _otras = [];

    /// <summary>Lo que va con tarjeta, transferencia y crédito: no da cambio.</summary>
    private long Otros => _otras.Sum(o => o.Centavos ?? 0);

    private long CreditoDelPanel => _otras.Where(o => o.Forma == FormaPago.Credito).Sum(o => o.Centavos ?? 0);

    /// <summary>Lo que falta en efectivo después de las otras formas, al peso.</summary>
    private EfectivoACobrar EnEfectivo => Actual.Venta.Efectivo(Otros);

    private long? PagoConCentavos => _pagoCon.Trim().Length == 0 ? EnEfectivo.ACobrarCentavos : Formato.LeerPesos(_pagoCon);

    private long Recibido => PagoConCentavos ?? 0;

    /// <summary>Lo que el cobro tiene que decir en el panel, donde está el cajero (lo de la izquierda se apaga al cobrar).</summary>
    private string? _avisoDelCobro;

    /// <summary>Con crédito, o con saldo a favor que se puede usar. Lo dice la cuenta (igual que el servicio), no el cliente.</summary>
    private bool PuedeFiar => Actual.Cliente is not null && Actual.Cuenta is { } cuenta && (cuenta.LimiteCentavos > 0 || cuenta.AFavorCentavos > 0);

    private bool ConCredito => Actual.Cliente is not null && Actual.Cuenta is { LimiteCentavos: > 0 };

    private long ExcesoDeCredito => PuedeFiar ? Actual.Cuenta!.Exceso(CreditoDelPanel) : 0;

    private void LimpiarCobro()
    {
        _pagoCon = "";
        _otras.Clear();
        _enPago = false;
        _avisoDelCobro = null;
    }

    /// <summary>
    /// Las otras formas que todavía no tienen renglón: una de cada una; el crédito, solo con quien puede fiar. En el piloto
    /// con eleventa, ninguna: solo efectivo.
    /// </summary>
    private IEnumerable<FormaPago> FormasQueFaltan =>
        new[] { FormaPago.Tarjeta, FormaPago.Transferencia, FormaPago.Credito }
            .Where(_ => !_pilotoEleventa)
            .Where(f => f != FormaPago.Credito || PuedeFiar)
            .Where(f => _otras.All(o => o.Forma != f));

    /// <summary>
    /// Tarjeta, transferencia y crédito, chicos junto a «Pagó con»: cada uno agrega su renglón con lo que falta. En el
    /// piloto con eleventa, en su lugar, que solo es efectivo.
    /// </summary>
    private RenderFragment FormasDePago => @<span class="vn-formas">
        @if (_pilotoEleventa)
        {
            <span class="nota" title="@PilotoConEleventa.NoSeCobra">@PilotoConEleventa.SoloEfectivo</span>
        }
        @foreach (var forma in FormasQueFaltan)
        {
            <button class="vn-forma" title="@TituloDeForma(forma)" @onclick="AlAgregarForma(forma)"><Ico Nombre="@IconoDeForma(forma)" />@EtiquetaDeForma(forma)</button>
        }
    </span>;

    private string EtiquetaDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Tarjeta",
        FormaPago.Transferencia => "Transf.",
        _ => ConCredito ? "Crédito" : "A favor",
    };

    private string TituloDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Todo o una parte con tarjeta (terminal)",
        FormaPago.Transferencia => "Todo o una parte por transferencia",
        _ => ConCredito ? $"Todo o una parte a crédito de {Actual.Cliente?.Nombre}" : "Todo o una parte de su saldo a favor",
    };

    private static string IconoDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "tarjeta",
        FormaPago.Transferencia => "transferir",
        _ => "reloj",
    };

    private string NombreDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Tarjeta (terminal)",
        FormaPago.Transferencia => "Transferencia",
        _ => ConCredito ? $"A crédito de {Actual.Cliente?.Nombre}" : "De su saldo a favor",
    };

    /// <summary>Junto a lo que se fía: lo que debe y lo que le queda, o lo que tiene a favor.</summary>
    private string NotaDeCredito
    {
        get
        {
            if (Actual.Cuenta is not { } cuenta)
                return "";
            var nota = ConCredito
                ? $"Debe {Formato.Dinero(Math.Max(0, cuenta.SaldoCentavos))} · le quedan {Formato.Dinero(Math.Max(0, cuenta.DisponibleCentavos))}"
                : $"Tiene {Formato.Dinero(cuenta.AFavorCentavos)} a favor"
                  + (cuenta.PorVerificarCentavos > 0 ? $"; puede usar {Formato.Dinero(Math.Max(0, cuenta.DisponibleCentavos))}" : "");
            return cuenta.Estimado ? nota + " (según esta caja)" : nota;
        }
    }

    /// <summary>«: lo autoriza Luis.», según lo que puede quien entró.</summary>
    private string AutorizaExceso => Permiso(AccionControlada.ExcederLimiteCredito) switch
    {
        { Nivel: NivelPermiso.RequiereAutorizacion } p => $": lo autoriza {Quien(p)}.",
        { Nivel: NivelPermiso.NoPermitido } => ": no tienes permiso para fiar arriba del límite.",
        { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral } p when ExcesoDeCredito > umbral => $": lo autoriza {Quien(p)}.",
        _ => ".",
    };

    private readonly Dictionary<FormaPago, Func<Task>> _agregarForma = [];

    /// <summary>El botón de cada forma: el mismo en cada pintado (la página no cambia su manejador con cada escaneo).</summary>
    private Func<Task> AlAgregarForma(FormaPago forma) =>
        _agregarForma.TryGetValue(forma, out var agregar) ? agregar : _agregarForma[forma] = () => AgregarFormaAsync(forma);

    /// <summary>La forma nueva trae lo que falta (del saldo a favor, hasta lo que puede usar); se cambia si es solo una parte.</summary>
    private async Task AgregarFormaAsync(FormaPago forma)
    {
        if (_pilotoEleventa)
        {
            Avisar(PilotoConEleventa.NoSeCobra);
            return;
        }
        if (forma == FormaPago.Credito)
        {
            // La cuenta al día antes de fiar: otra caja pudo fiarle o recibirle un abono.
            await CargarCuentaAsync(Actual);
            if (!PuedeFiar)
            {
                Avisar("Ya no tiene crédito ni saldo a favor que usar: se cobra con otra forma.");
                return;
            }
        }
        var falta = Math.Max(0, Actual.Venta.TotalCentavos - Otros);
        if (forma == FormaPago.Credito && !ConCredito)
            falta = Math.Min(falta, Math.Max(0, Actual.Cuenta!.DisponibleCentavos));
        _otras.Add(new OtraForma(forma, (falta / 100m).ToString("0.00", CultureInfo.InvariantCulture)));
        _pagoCon = "";
        _enfocar = $"#pago-monto-{_otras.Count - 1}";
    }

    private void QuitarForma(OtraForma otra)
    {
        _otras.Remove(otra);
        _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
    }

    /// <summary>Lo que impide cobrar en los renglones de las otras formas.</summary>
    private string? ErrorDeLasFormas
    {
        get
        {
            if (_pilotoEleventa && _otras.Count > 0)
                return "En el piloto con eleventa solo se cobra en efectivo: quita las otras formas";
            if (_otras.FirstOrDefault(o => o.Centavos is null) is { } mala)
                return $"«{mala.Monto}» no es una cantidad";
            if (_otras.Any(o => o.Forma == FormaPago.Credito) && !PuedeFiar)
                return "Sin un cliente con crédito o saldo a favor no se fía: quita ese renglón";
            if (Otros > Actual.Venta.TotalCentavos)
                return "Tarjeta, transferencia y crédito no pueden pasar del total: no dan cambio";
            if (ExcesoDeCredito > 0 && !ConCredito)
                return $"No tiene crédito: solo puede usar su saldo a favor ({Formato.Dinero(Math.Max(0, Actual.Cuenta!.DisponibleCentavos))})";
            return null;
        }
    }

    /// <summary>Lo que impide cobrar ya, o null.</summary>
    private string? ErrorDelCobro
    {
        get
        {
            if (ErrorDeLasFormas is { } error)
                return error + ".";
            var aCobrar = EnEfectivo.ACobrarCentavos;
            if (aCobrar == 0)
                return null;
            if (PagoConCentavos is null)
                return $"«{_pagoCon}» no es una cantidad.";
            return Recibido < aCobrar ? $"Faltan {Formato.Dinero(aCobrar - Recibido)}." : null;
        }
    }

    private string EtiquetaDeCobrar
    {
        get
        {
            var aCobrar = EnEfectivo.ACobrarCentavos;
            if (ErrorDeLasFormas is not null)
                return "Cobrar";
            if (aCobrar == 0)
                return $"Cobrar {Formato.Dinero(Otros)}";
            if (PagoConCentavos is not { } recibido)
                return "Cobrar";
            if (recibido < aCobrar)
                return "Falta dinero";
            return _pagoCon.Trim().Length == 0 ? $"Cobrar exacto {Formato.Dinero(aCobrar + Otros)}" : $"Cobrar · cambio {Formato.Dinero(recibido - aCobrar)}";
        }
    }

    /// <summary>
    /// F12: el cursor va a «Pagó con» y lo demás se apaga; si las otras formas ya lo cubren todo, a «Cobrar». Con el
    /// cursor ya en el cobro, F12 cobra como Enter (y el cobro espera el último escaneo).
    /// </summary>
    private async Task IrAlCobroAsync()
    {
        if (_enPago)
        {
            await CobrarEnPanelAsync();
            return;
        }
        // caja.js no encontró «Pagó con»: el ticket estaba vacío, o el escaneo de su primera línea sigue en camino (con el
        // Wi-Fi lento). Se espera, como las demás teclas del ticket, y entonces el cursor va al cobro: el F12 no se pierde.
        await _captura.EsperarAsync();
        if (Actual.Venta.Lineas.Count > 0)
            _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
    }

    private async Task AlTeclearPago(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CobrarEnPanelAsync();
    }

    /// <summary>
    /// Enter en el cobro (o F12, o el botón): sin escribir nada, exacto; con lo que dio, da el cambio. Con tarjeta,
    /// transferencia o crédito, cada una con su monto y el efectivo por lo que falta. Fiar arriba del límite se autoriza en
    /// el panel. Primero espera el último escaneo: si llegó algo, no cobra y el panel dice el total nuevo.
    /// </summary>
    private async Task CobrarEnPanelAsync()
    {
        if (await EnTurnoDeCobroAsync(CobrarConLaColaAsync) is not { } aviso)
            return;
        _avisoDelCobro = aviso;
        _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
    }

    private async Task CobrarConLaColaAsync(CapturaCodigo.Apartado apartado)
    {
        _avisoDelCobro = null;
        // Un escaneo de la cola pudo abrir algo (el folio de un ticket abre su devolución): no se cobra encima.
        if (_ventana != Ventanas.Ninguna || Actual.Venta.Lineas.Count == 0)
            return;
        if (ErrorDelCobro is { } error)
        {
            Avisar(error);
            return;
        }
        if (!await RevisarCostoAsync())
            return;
        // Pasar el límite: el cajero lo pide; el encargado y el dueño pueden solos. Sin crédito no hay autorización que valga.
        if (ExcesoDeCredito is > 0 and var exceso)
        {
            try
            {
                var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.ExcederLimiteCredito, exceso));
                switch (decision.Nivel)
                {
                    case NivelPermiso.RequiereAutorizacion:
                        _creditoPorAutorizar = exceso;
                        await Abrir(Ventanas.AutorizarCredito);
                        return;
                    case NivelPermiso.NoPermitido:
                        Avisar("No tienes permiso para fiar arriba del límite.");
                        return;
                }
            }
            catch (ErrorCaja ex)
            {
                Avisar(ex.Message);
                return;
            }
        }
        await MandarCobroAsync(null, apartado);
    }

    /// <summary>Lo que se fía arriba del límite y falta autorizar.</summary>
    private long? _creditoPorAutorizar;

    private async Task CreditoAutorizadoAsync(Guid autorizacionId)
    {
        _creditoPorAutorizar = null;
        await Cerrar();
        if (await EnTurnoDeCobroAsync(apartado => MandarCobroAsync(autorizacionId, apartado)) is { } aviso)
            _avisoDelCobro = aviso;
        StateHasChanged();
    }

    private async Task MandarCobroAsync(Guid? autorizacionCredito, CapturaCodigo.Apartado apartado)
    {
        var cobros = new List<CobroSolicitado>();
        foreach (var otra in _otras)
            if (otra.Centavos is > 0 and var monto)
                cobros.Add(otra.Forma == FormaPago.Credito
                    ? new CobroSolicitado(FormaPago.Credito, monto)
                    : new CobroSolicitado(otra.Forma, monto, otra.Referencia.Trim().Length == 0 ? null : otra.Referencia.Trim()));
        if (EnEfectivo.ACobrarCentavos > 0)
            cobros.Add(new CobroSolicitado(FormaPago.Efectivo, Recibido));
        // Si se cobró, el ticket nuevo ya dejó el cobro en blanco. Lo que ya dice el panel del cobro (los precios que
        // cambiaron) no se repite abajo.
        if (await CobrarAsync(cobros, autorizacionCredito, apartado) is { } error)
        {
            if (!ReferenceEquals(error, _avisoDelCobro))
                Avisar(error);
        }
        else
            _enfocar = "#codigo";
    }

    /// <summary>
    /// Todo cobro pasa por aquí (el panel y el crédito ya autorizado): aparta la cola de escaneos, que espera los que
    /// venían y detiene los que llegan mientras se cobra; esos caen en el ticket del siguiente cliente. Si mientras
    /// esperaba llegó algo al ticket, no cobra y devuelve el aviso: el cajero ve el total nuevo antes de cobrarlo. Con
    /// un cobro en curso, no hace nada.
    /// </summary>
    private async Task<string?> EnTurnoDeCobroAsync(Func<CapturaCodigo.Apartado, Task> cobrar)
    {
        if (_cobrando)
            return null;
        _cobrando = true;
        try
        {
            var (ticket, total, _, lineas, _) = FotoDelTicket();
            using var apartado = await _captura.ApartarAsync(FotoDelTicket);
            if (apartado.LlegoAlgo)
                // Un «buscando…» que no llegó (no existe, o la caja principal no contestó) no cambia el total: lo que pasó lo
                // dice el aviso de la izquierda.
                return ticket == Actual && total == Actual.Venta.TotalCentavos && lineas == Actual.Venta.Lineas.Count
                    ? "Lo último que escaneaste no entró al ticket (el aviso de la izquierda dice por qué): cobra cuando esté completo."
                    : $"Llegó lo último que escaneaste: el total ahora es {Formato.Dinero(Actual.Venta.TotalCentavos)}. Revisa lo que te dio y vuelve a cobrar.";
            await cobrar(apartado);
            return null;
        }
        finally
        {
            _cobrando = false;
        }
    }

    /// <summary>
    /// Lo que cambia si llega una línea mientras se espera para cobrar: el ticket, su total, lo que lleva y lo que se le
    /// pregunta a la caja principal.
    /// </summary>
    private (TicketAbierto Ticket, long Total, decimal Articulos, int Lineas, int Buscando) FotoDelTicket() =>
        (Actual, Actual.Venta.TotalCentavos, Actual.Venta.NumeroDeArticulos, Actual.Venta.Lineas.Count, Actual.Buscando.Count);

    private async Task RevisarConteoAsync()
    {
        try
        {
            _conteo = await Cliente.ConteoDelDiaAsync(Caja.SucursalId, Sesion.UsuarioId);
        }
        catch (ErrorCaja)
        {
            // Sin conexión no se pide: el conteo espera a que vuelva.
        }
    }

    private sealed class TicketAbierto
    {
        public required Venta Venta { get; init; }
        public required int Numero { get; init; }
        public Dictionary<Guid, ProductoVentaDto> Productos { get; } = [];

        /// <summary>
        /// La versión del catálogo de la que salió el precio que se ve en cada línea (entrega 5): la del producto con que se
        /// agregó o se volvió a calcular. Al cobrar va con cada línea: dos presentaciones del mismo producto pueden venir de
        /// copias distintas (la pieza de antes de que cambiara su precio, el paquete de después). Una línea que no está aquí
        /// tomó sus precios del producto que guarda el ticket (<see cref="VersionDe"/>).
        /// </summary>
        public Dictionary<VentaLinea, long?> Versiones { get; } = [];

        /// <summary>La versión del catálogo del precio que se ve en esa línea.</summary>
        public long? VersionDe(VentaLinea linea) =>
            Versiones.TryGetValue(linea, out var version) ? version
            : linea.VarianteId is { } varianteId ? Productos.GetValueOrDefault(varianteId)?.Version : null;

        /// <summary>
        /// El precio de <paramref name="linea"/> se acaba de calcular con <paramref name="producto"/>: queda en el ticket (lo
        /// siguiente de ese producto ya sale de él) y la línea con su versión. Las otras líneas del mismo producto (otra
        /// presentación) se quedan con la versión de sus precios.
        /// </summary>
        public void Calculada(VentaLinea linea, ProductoVentaDto producto)
        {
            foreach (var otra in Venta.Lineas.Where(l => l != linea && l.VarianteId == producto.VarianteId))
                Versiones.TryAdd(otra, VersionDe(otra));
            Productos[producto.VarianteId] = producto;
            Versiones[linea] = producto.Version;
        }

        /// <summary>Los trabajos de impresión que van en la línea "Impresiones" de este ticket.</summary>
        public List<ImpresionPorCobrarDto> Impresiones { get; } = [];

        /// <summary>Retomarlo desde su ficha de la espera (lo arma la pantalla una vez).</summary>
        public Func<Task>? AlRetomar { get; set; }

        /// <summary>El cliente registrado del ticket: lo que se agregue después también lleva su descuento y su mayoreo.</summary>
