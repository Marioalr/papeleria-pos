    private EfectivoCajaDto? _efectivo;

    /// <summary>
    /// El aviso de retiro, si el efectivo llegó al límite. En el piloto con eleventa no sale (se quita al dejarlo): el
    /// cajón es de las dos y el turno de esta caja no se cierra aquí (su corte se hace en eleventa), así que lo esperado
    /// suma días y no dice cuánto hay; y un retiro iría a eleventa como salida y movería su corte.
    /// </summary>
    private EfectivoCajaDto? Retiro => !_pilotoEleventa && _efectivo is { PideRetiro: true } efectivo ? efectivo : null;

    private async Task MovimientoRegistrado(ComprobanteMovimientoDto comprobante)
    {
        var salida = comprobante.Tipo == TipoMovimientoCaja.Salida;
        await Cerrar();
        Avisar($"{(salida ? "Salida" : "Entrada")} de {Formato.Dinero(comprobante.MontoCentavos)} registrada.", error: false);
        if (salida)
            await ImprimirDocumentoAsync($"Comprobante {comprobante.Folio}", DisenoComprobante.Movimiento(comprobante), abrirCajon: true);
        else if (!Impresora.MuestraVistaPrevia)
        {
            try
            {
                await Impresora.EnviarAsync(TicketEscPos.AbrirCajon());
            }
            catch (Exception ex)
            {
                Avisar($"No se pudo abrir el cajón: {ex.Message}");
            }
        }
        await RevisarEfectivoAsync();
    }

    /// <summary>Si el efectivo llegó al límite de la sucursal, aparece el aviso de retiro hasta que se haga.</summary>
    private async Task RevisarEfectivoAsync()
    {
        // El piloto con eleventa: sin aviso de retiro (Retiro), y no se calcula lo esperado de un turno que suma días.
        if (_pilotoEleventa)
        {
            _efectivo = null;
            StateHasChanged();
            return;
        }
        try
        {
            _efectivo = await Cliente.EfectivoAsync(Turno.Id);
        }
        catch (ErrorCaja)
        {
            // Sin conexión no hay aviso; lo demás ya muestra el error.
        }
        // Lo llaman callbacks de las ventanas que no vuelven a dibujar esta pantalla.
        StateHasChanged();
    }

    /// <summary>
    /// La ventana abierta. En la pantalla nueva, lo de la venta va como panel a la derecha (VaEnPanel), sin tapar el ticket;
    /// lo demás (y todo en la pantalla de hoy) va encima.
    /// </summary>
    private RenderFragment ContenidoDeVentana => @<CascadingValue Name="@PilotoConEleventa.Cascada" Value="_pilotoEleventa">
    @switch (_ventana)
    {
        case Ventanas.Cobrar:
            <Ventana Titulo="Cobrar" Clase="cobrar" AlCerrar="Cerrar">
                <CobrarVenta Venta="Actual.Venta" Caja="Caja" Sesion="Sesion" Cliente="Actual.Cliente" Cuenta="Actual.Cuenta" AlCobrar="CobrarDeLaVentanaAsync" />
            </Ventana>
            break;
        case Ventanas.AutorizarCredito when _creditoPorAutorizar is { } exceso && Actual.Cliente is { } fiado:
            <Ventana Titulo="Fiar arriba del límite" AlCerrar="Cerrar">
                <AutorizarAccion Accion="AccionControlada.ExcederLimiteCredito" MontoCentavos="exceso" Caja="Caja" Sesion="Sesion"
                                 Detalle="@($"Fiar {Formato.Dinero(CreditoDelPanel)} a «{fiado.Nombre}»; lo que pasa de su límite")"
                                 AlAutorizar="a => CreditoAutorizadoAsync(a.Id)" AlCancelar="Cerrar" />
            </Ventana>
            break;
        case Ventanas.AutorizarCosto when _costoPorAutorizar is { } costo:
            <Ventana Titulo="Debajo del costo" AlCerrar="Cerrar">
                <AutorizarAccion Accion="AccionControlada.VenderBajoCosto" Detalle="@costo.Detalle" MontoCentavos="costo.Monto" Caja="Caja" Sesion="Sesion"
                                 AlAutorizar="a => CostoAutorizadoAsync(a.Id)" AlCancelar="Cerrar" />
            </Ventana>
            break;
        case Ventanas.Buscar:
            <Ventana Titulo="Buscar producto" Clase="buscar" AlCerrar="Cerrar">
                <BuscarProducto SucursalId="Caja.SucursalId" TextoInicial="@_buscarTexto" AlElegir="AgregarVarianteAsync" />
            </Ventana>
            break;
        case Ventanas.Comun:
            <Ventana Titulo="Artículo varios / común" AlCerrar="Cerrar">
                <ArticuloComun AlAgregar="AgregarComun" />
            </Ventana>
            break;
        case Ventanas.Entrada:
        case Ventanas.Salida:
            var tipo = _ventana == Ventanas.Entrada ? TipoMovimientoCaja.Entrada : TipoMovimientoCaja.Salida;
            @* @key: de la entrada a la salida (o al revés) empieza en blanco, no con lo que se escribió en la otra. *@
            <Ventana @key="tipo" Titulo="@(tipo == TipoMovimientoCaja.Entrada ? "Entrada de efectivo" : "Salida de efectivo")" AlCerrar="Cerrar">
                <MovimientoEfectivo Tipo="tipo" TurnoId="Turno.Id" UsuarioId="Sesion.UsuarioId" AlTerminar="MovimientoRegistrado" />
            </Ventana>
            break;
        case Ventanas.Mayoreo when LineaSeleccionada is { VarianteId: { } varianteMayoreo } lineaMayoreo
                                   && Actual.Productos.TryGetValue(varianteMayoreo, out var productoMayoreo):
            <Ventana Titulo="Mayoreo" AlCerrar="Cerrar">
                <EscalasMayoreo Producto="productoMayoreo" SucursalId="Caja.SucursalId" PresentacionId="lineaMayoreo.PresentacionId" Cantidad="lineaMayoreo.Cantidad"
                                MayoreoDeCliente="Actual.Venta.MayoreoDeCliente"
                                PrecioCambiadoCentavos="@(lineaMayoreo.PrecioCambiado ? lineaMayoreo.PrecioCentavos : null)" />
            </Ventana>
            break;
        case Ventanas.Verificador:
            <Ventana Titulo="Verificador de precios" AlCerrar="Cerrar">
                <Verificador SucursalId="Caja.SucursalId" />
            </Ventana>
            break;
        case Ventanas.Corte:
            <Ventana Titulo="Corte" Clase="corte" AlCerrar="Cerrar">
                @* En el piloto con eleventa, CorteCaja solo dice que el corte se hace en eleventa: aquí no se cierra el turno. *@
                @if (!_pilotoEleventa && _tickets.Count(t => t.Venta.Lineas.Count > 0) is var sinCobrar and > 0)
                {
                    <p class="error">Hay @sinCobrar @(sinCobrar == 1 ? "ticket" : "tickets") sin cobrar: si se cierra el turno, se pierden.</p>
                }
                <CorteCaja Turno="Turno" Sesion="Sesion" Caja="@Caja.Nombre" AlTerminar="AlCerrarTurno" />
            </Ventana>
            break;
        case Ventanas.VentasDelDia:
            <Ventana Titulo="Ventas del día" Clase="ventas-dia tarjetas ventas-del-dia" AlCerrar="Cerrar">
                <VentasDelDia CajaId="Caja.Id" AlReimprimir="(Guid id) => PedirReimpresion(id)" AlDevolver="(string folio) => AbrirDevolucion(folio)" />
            </Ventana>
            break;
        case Ventanas.Devolucion:
            <Ventana Titulo="Devoluciones y cancelaciones" Clase="ventas-dia tarjetas devolver" AlCerrar="Cerrar">
                <DevolverCancelar Caja="Caja" Sesion="Sesion" FolioInicial="@_folioDevolucion" AlTerminar="DevolucionHechaAsync" />
            </Ventana>
            break;
        case Ventanas.CambiarPrecio when LineaSeleccionada is { } seleccionada:
            <Ventana Titulo="Cambiar precio" AlCerrar="Cerrar">
                <CambiarPrecio Descripcion="@seleccionada.Descripcion" PrecioActualCentavos="seleccionada.PrecioCentavos" Cantidad="seleccionada.Cantidad"
                               Caja="Caja" Sesion="Sesion" AlCambiar="PrecioCambiadoAsync" />
            </Ventana>
            break;
        case Ventanas.Impresiones:
            <Ventana Titulo="Impresiones por cobrar" Clase="ventas-dia tarjetas" AlCerrar="Cerrar">
                <ImpresionesPorCobrar Caja="Caja" Sesion="Sesion" EnElTicket="@Actual.Impresiones.Select(i => i.Id).ToList()" AlAgregar="ImpresionesElegidasAsync" />
            </Ventana>
            break;
        case Ventanas.Productos:
            <Ventana Titulo="Productos" Clase="configuracion" AlCerrar="Cerrar">
                <Productos Caja="Caja" Sesion="Sesion" />
            </Ventana>
            break;
        case Ventanas.Conteo:
            <Ventana Titulo="Conteo del día" Clase="configuracion" AlCerrar="Cerrar">
                <ConteoDelDia Caja="Caja" Sesion="Sesion" AlContar="c => _conteo = c" />
            </Ventana>
            break;
        case Ventanas.Inventario:
            <Ventana Titulo="Inventario" Clase="configuracion" AlCerrar="Cerrar">
                <Inventario Caja="Caja" Sesion="Sesion" />
            </Ventana>
            break;
        case Ventanas.AltaRapida when _codigoNuevo is { } codigoNuevo:
            <Ventana Titulo="Dar de alta" AlCerrar="Cerrar">
                <AltaRapida Codigo="@codigoNuevo" Caja="Caja" Sesion="Sesion" AlDarDeAlta="DadoDeAltaAsync" />
            </Ventana>
            break;
        case Ventanas.Descuento:
            <Ventana Titulo="Descuento" AlCerrar="Cerrar">
                <Descuento Venta="Actual.Venta" Linea="LineaSeleccionada" Caja="Caja" Sesion="Sesion" ClienteDelTicket="Actual.Cliente"
                           AlTerminar="DescuentoAplicadoAsync" />
            </Ventana>
            break;
        case Ventanas.ElegirCliente:
            <Ventana Titulo="Cliente del ticket" Clase="buscar tarjetas clientes" AlCerrar="Cerrar">
                <ElegirCliente @ref="_elegirCliente" Venta="Actual.Venta" Caja="Caja" Sesion="Sesion" Actual="Actual.Cliente" Catalogo="CatalogoDe"
                               AlTerminar="ClienteElegidoAsync" />
            </Ventana>
            break;
        case Ventanas.Clientes:
            <Ventana Titulo="Clientes" Clase="configuracion" AlCerrar="Cerrar">
                <Clientes Caja="Caja" Sesion="Sesion" Turno="Turno" AlGuardar="ClienteGuardadoAsync" AlAbonar="AbonoRegistradoAsync"
                          AlReimprimir="AbonoReimpresoAsync" AlImprimirEstado="EstadoDeCuentaAsync" />
            </Ventana>
            break;
        case Ventanas.Abono:
            <Ventana Titulo="Abono a cuenta" Clase="buscar tarjetas clientes" AlCerrar="Cerrar">
                <Abonar Caja="Caja" Sesion="Sesion" Turno="Turno" ClienteInicial="Actual.Cliente" AlTerminar="AbonoRegistradoAsync"
                        AlReimprimir="AbonoReimpresoAsync" />
            </Ventana>
            break;
        case Ventanas.Cotizar:
            <Ventana Titulo="Cotizar PDF" Clase="ventas-dia" AlCerrar="Cerrar">
                <Cotizar Caja="Caja" Sesion="Sesion" Archivo="_pdfACotizar" />
            </Ventana>
            break;
        case Ventanas.Transferencias:
            <Ventana Titulo="Verificar transferencias" Clase="ventas-dia" AlCerrar="Cerrar">
                <VerificarTransferencias Caja="Caja" />
            </Ventana>
            break;
        case Ventanas.Configuracion:
            <Ventana Titulo="Configuración" Clase="configuracion" AlCerrar="Cerrar">
                <Configuracion Caja="Caja" Sesion="Sesion" AntesDeInstalar="GuardarEspera" />
            </Ventana>
            break;
        case Ventanas.Motivo:
            <Ventana Titulo="Reimprimir ticket" AlCerrar="Cerrar">
                <PedirMotivo Etiqueta="Motivo de la reimpresión" Error="@_errorMotivo" Ocupado="_ocupadoMotivo" AlAceptar="ConfirmarReimpresionAsync" />
            </Ventana>
            break;
        case Ventanas.VistaPrevia when _vistaPrevia is { } vista:
            <Ventana Titulo="@vista.Titulo" Clase="vista-previa" AlCerrar="Cerrar">
                <pre class="ticket">@vista.Texto</pre>
                <p class="nota">Sin impresora conectada: así saldrá impreso en la de 80 mm.</p>
            </Ventana>
            break;
    }
    </CascadingValue>;

    // ── Ventanas y avisos ───────────────────────────────────────────────────

    private async Task Abrir(Ventanas ventana)
    {
        _menuUsuario = false;
        _menuEspera = false;
        CerrarAcciones();
        // Encima de otra (un botón del renglón o una pestaña con un panel abierto): la de antes se deja como al cerrarla.
        if (_ventana != ventana)
            DejarVentana();
        _ventana = ventana;
        _avisoDelPanel = null;
        await AvisarVentanaAbiertaAsync();
        StateHasChanged();
    }

    private async Task Cerrar()
    {
        await QuitarVentanaAsync();
        await Js.EnfocarAsync("#codigo");
    }

    /// <summary>Cierra la ventana sin mover el cursor (<see cref="Cerrar"/> lo regresa al cuadro de captura; F12, al cobro).</summary>
    private async Task QuitarVentanaAsync()
    {
        DejarVentana();
        _ventana = Ventanas.Ninguna;
        _avisoDelPanel = null;
        _buscarTexto = "";
        await Js.VentanaAbiertaAsync(false);
        StateHasChanged();
    }

    /// <summary>Lo que la ventana deja a medias al cerrarla o al cambiarla por otra.</summary>
    private void DejarVentana()
    {
        // Si CTRL+L se queda a medio camino (pidiendo la autorización del costo), el ticket regresa a como estaba.
        if (_ventana == Ventanas.ElegirCliente)
            _elegirCliente?.Cancelar();
    }

    private void Avisar(string mensaje, bool error = true)
    {
        _mensaje = mensaje;
        _mensajeEsError = error;
        _codigoNuevo = null;
    }

    private static string Descripcion(VentaLinea linea, ProductoVentaDto? producto)
    {
        var presentacion = producto?.Presentaciones.FirstOrDefault(p => p.Id == linea.PresentacionId);
        return presentacion is { EsBase: false } ? $"{linea.Descripcion} ({presentacion.Nombre})" : linea.Descripcion;
    }

    public async ValueTask DisposeAsync()
    {
        if (_contingencia is not null)
            _contingencia.Cambio -= AlCambiarContingencia;
        try
        {
            // Si se va con una ventana abierta (el corte Z, o «Cambiar de usuario» del menú con un panel), caja.js seguiría
            // creyendo que está ahí: en la pantalla nueva del que entra después, el cuadro de captura no tomaría los escaneos.
            if (_ventana != Ventanas.Ninguna)
                await Js.VentanaAbiertaAsync(false);
            await Js.QuitarTeclasAsync();
        }
        catch (JSDisconnectedException)
        {
            // El navegador ya se cerró.
        }
        _referencia?.Dispose();
    }
}
