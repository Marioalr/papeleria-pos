@* La pantalla de venta, la del rediseño (docs/propuesta-interfaz.md, entrega 0), en todas las cajas. La de antes, con la
   misma distribución que eleventa, ya no existe: el dueño la quitó el 2026-10-14 («no volveremos a esa versión»).
   Productos (F3), Inventario (F4) y Clientes son páginas, como en el prototipo (entrega 8): bajo la barra de arriba se ve
   la venta o una de ellas. La venta no se deja: se oculta con su ticket, sus tickets en espera, el cobro y el panel que
   tuviera, y «Venta» (F1) la regresa tal cual. El corte y la Configuración siguen encima, como ventanas. *@
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using PapeleriaPos.Nucleo.Configuracion
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IImpresora Impresora
@inject ConexionCaja Conexion
@inject IServiceProvider Servicios

<div class="venta-nueva">
    <Iconos />
    <header class="vn-arriba">
        <div class="vn-marca">
            <span class="vn-logo">P</span>
            <div><strong>@Caja.Nombre</strong><small>@(Conexion.Servicio.IsLoopback ? "principal" : "secundaria") · @Caja.Sucursal</small></div>
        </div>
        @* Cada quien ve lo que sus permisos le dejan: lo que no puede no aparece (docs/propuesta-interfaz.md, «Usuarios y permisos»).
           Mientras llegan, solo lo que es de todos. *@
        <nav class="vn-pestanas">
            <button class="@Activa(Pagina.Venta)" @onclick="() => IrAAsync(Pagina.Venta)">Venta <kbd>F1</kbd></button>
            @if (Ve(AccionControlada.EditarCatalogo))
            {
                <button class="@Activa(Pagina.Productos)" @onclick="() => IrAAsync(Pagina.Productos)">Productos <kbd>F3</kbd></button>
            }
            @if (VeInventario)
            {
                <button class="@Activa(Pagina.Inventario)" @onclick="() => IrAAsync(Pagina.Inventario)">Inventario <kbd>F4</kbd></button>
            }
            @* Clientes es de todos: quien no los administra los consulta (sin «Nuevo cliente» ni editar) y en su cuenta
               recibe abonos y devuelve el saldo a favor, con candado si lo autoriza otro. *@
            <button class="@Activa(Pagina.Clientes)" @onclick="() => IrAAsync(Pagina.Clientes)">Clientes</button>
            <button @onclick="() => Abrir(Ventanas.Corte)">Corte</button>
            @if (VeConfiguracion)
            {
                <button @onclick="() => Abrir(Ventanas.Configuracion)">Configuración</button>
            }
        </nav>
        <span class="espacio"></span>
        <EstadoCaja @ref="_estado" Caja="Caja" Sesion="Sesion" AlImpresiones="ImpresionesDesdeArribaAsync" />
        <div class="vn-usuario-caja">
            <button class="vn-usuario" title="Cambiar de usuario o salir" @onclick="() => _menuUsuario = !_menuUsuario">
                <span class="vn-avatar">@Inicial(Sesion.Nombre)</span>
                <span><strong>@Sesion.Nombre</strong><small>turno desde @Turno.AbiertoLocal.ToString("HH:mm")</small></span>
            </button>
            @if (_menuUsuario)
            {
                <div class="vn-fondo-menu" @onclick="() => _menuUsuario = false"></div>
                <div class="vn-menu-usuario">
                    <p>@Sesion.Nombre@(Sesion.Resumen is { } resumen ? $" · {resumen.ToLowerInvariant()}" : "")</p>
                    @* Como en el prototipo, las dos van a la entrada; qué pasa al salir lo decide la raíz de la caja (AlSalir). *@
                    <button @onclick="SalirAsync">Cambiar de usuario <kbd>Ctrl+U</kbd></button>
                    <button @onclick="SalirAsync">Salir</button>
                </div>
            }
        </div>
    </header>

    @* En una página, la venta se queda como está, oculta: nada de ella se pierde ni se vuelve a cargar. *@
    <div class="vn-cuerpo @(_pagina == Pagina.Venta ? "" : "oculto")">
        <section class="vn-izq">
            <div class="vn-captura-caja">
                <div class="vn-captura">
                    <Ico Nombre="escaner" Clase="vn-captura-ico" />
                    @* Sin @bind: caja.js lo lee al Enter y lo vacía al momento (un escaneo nunca se pega al siguiente). *@
                    <input id="codigo" data-captura autocomplete="off" spellcheck="false" aria-label="Código del producto"
                           placeholder="Escanea o escribe: código, nombre, 3*código o folio de un ticket" />
                    <span class="vn-captura-modo"><kbd>/</kbd> todas las acciones</span>
                </div>
                @if (_accionesVistas is { } acciones)
                {
                    @* «/»: todo lo que puede hacer quien entró, con su tecla; lo que pide autorización dice quién autoriza. *@
                    <div class="vn-resultados" role="listbox">
                        <div class="vn-res-grupo">Acciones que tienes</div>
                        @if (acciones.Count == 0)
                        {
                            <div class="vn-res-vacio">Ninguna acción se llama así: borra lo escrito después de «/» para verlas todas.</div>
                        }
                        @for (var k = 0; k < acciones.Count; k++)
                        {
                            var indiceAccion = k;
                            var accion = acciones[k];
                            <div id="acc-@k" class="vn-res vn-res-accion @(k == _indiceAccion ? "activa" : "")" role="option" @onclick="() => HacerAccionAsync(indiceAccion)">
                                <Ico Nombre="@accion.Icono" />
                                <div class="vn-res-texto">
                                    <div class="vn-res-nombre">@accion.Nombre</div>
                                    @if (accion.Regla is { } regla && DetallePermiso(regla) is { } detalle)
                                    {
                                        <div class="vn-res-sub">
                                            @if (Permiso(regla)?.Nivel == NivelPermiso.RequiereAutorizacion)
                                            {
                                                <Ico Nombre="candado" />
                                            }
                                            @detalle
                                        </div>
                                    }
                                </div>
                                @if (accion.Tecla is { } teclaAccion)
                                {
                                    <kbd>@teclaAccion</kbd>
                                }
                            </div>
                        }
                        <div class="vn-res-ayuda"><span><kbd>↑</kbd> <kbd>↓</kbd> elegir</span><span><kbd>Enter</kbd> hacerla</span><span><kbd>Esc</kbd> cerrar</span><span>«/desc» deja solo las que dicen «desc»</span></div>
                    </div>
                }
                else if (_resultados is { } resultados && _familias is { } familias)
                {
                    @* Lo que se escribe a mano busca aquí mismo, sin otra ventana; el lector no (no espera a dejar de teclear). Lo que
                       solo cambia en el color, la medida o la marca va en un renglón: una familia (docs/propuesta-interfaz.md). *@
                    <div class="vn-resultados" role="listbox" data-familias="@familias.Ejes.Count">
                        @if (resultados.Count == 0)
                        {
                            <div class="vn-res-vacio">Nada coincide con «@_textoBuscado». Revisa cómo se escribe, o véndelo como artículo común (<kbd>Ins</kbd>).</div>
                        }
                        else
                        {
                            var vistos = Math.Min(familias.Renglones.Count, MaximoResultados);
                            var cuantos = $"{resultados.Count}{(resultados.Count >= ParaFamilias ? " o más" : "")}{(familias.Renglones.Count < resultados.Count ? $" en {familias.Renglones.Count} renglones" : "")}";
                            <div class="vn-res-grupo">
                                @if (resultados[0].Parecido)
                                {
                                    @($"Parecidos a «{_textoBuscado}» · {cuantos}: nada coincide exacto, ¿será un error de dedo?")
                                }
                                else
                                {
                                    @($"Productos · {cuantos}: primero lo que se eligió aquí con este texto, luego lo más vendido")
                                }
                            </div>
                            @if (familias.Ejes.Count > 0)
                            {
                                <div class="vn-ejes">
                                    <span>Desplegar por</span>
                                    @foreach (var eje in familias.Ejes)
                                    {
                                        var este = eje;
                                        <button class="@(eje == familias.Eje ? "activo" : "")" @onclick="() => ElegirEje(este)" @onclick:preventDefault="true">@NombreDeEje(eje)</button>
                                    }
                                    @if (familias.Ejes.Count > 1)
                                    {
                                        <small><kbd>Tab</kbd> cambia</small>
                                    }
                                </div>
                            }
                            @if (ParaAfinar() is { Count: > 0 } afinar)
                            {
                                @* Con un texto general, las palabras que separan los resultados: un clic las agrega a lo escrito. *@
                                <div class="vn-afinar">
                                    <span>Afinar</span>
                                    @foreach (var (palabra, veces) in afinar)
                                    {
                                        var esta = palabra;
                                        <button tabindex="-1" @onclick="() => AfinarAsync(esta)" @onclick:preventDefault="true">@esta.ToLowerInvariant() <small>@veces</small></button>
                                    }
                                    <small>o escribe el principio de otra palabra</small>
                                </div>
                            }
                            var n = 0;
                            for (var k = 0; k < vistos; k++)
                            {
                                var indiceRenglon = k;
                                var renglon = familias.Renglones[k];
                                var r = renglon.Elegido;
                                var activo = n == _indiceResultado;
                                var idRenglon = n++;
                                if (!renglon.EsFamilia)
                                {
                                    <div id="res-@idRenglon" class="vn-res @(activo ? "activa" : "")" role="option" @onclick="() => AgregarDeLaListaAsync(indiceRenglon, -1)">
                                        <div class="vn-res-texto">
                                            <div class="vn-res-nombre">@Marcado(r.Descripcion)@PorSinonimo(r)</div>
                                            @if (r.Codigo is { } codigoRes)
                                            {
                                                <div class="vn-res-sub"><code>@Marcado(codigoRes)</code></div>
                                            }
                                        </div>
                                        <div class="vn-res-precio">@Formato.Dinero(r.PrecioCentavos)</div>
                                        <div class="vn-res-exist @ExistenciaClase(r.Existencia)">@ExistenciaTexto(r.Existencia)</div>
                                    </div>
                                    continue;
                                }
                                var abierta = indiceRenglon == _abierta;
                                var eje = renglon.Eje!.Value;
                                <div id="res-@idRenglon" class="vn-res vn-fam @(activo ? "activa" : "")" role="option" @onclick="() => AgregarDeLaListaAsync(indiceRenglon, -1)">
                                    <div class="vn-res-texto">
                                        <div class="vn-res-nombre">@Marcado(renglon.Titulo!)@PorSinonimo(r)</div>
                                        <div class="vn-valores">
                                            @for (var v = 0; v < Math.Min(renglon.Valores.Count, ValoresALaVista); v++)
                                            {
                                                var indiceValor = v;
                                                <button class="vn-valor @(v == renglon.MasVendido ? "mas" : "")" tabindex="-1" title="@ValorTitulo(renglon, v)"
                                                        @onclick="() => AgregarDeLaListaAsync(indiceRenglon, indiceValor)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                                    @Punto(eje, renglon.Valores[v].Clave)@Marcado(ValorTexto(renglon, v))
                                                </button>
                                            }
                                            @if (renglon.Valores.Count > ValoresALaVista)
                                            {
                                                <span class="vn-mas-valores">y @(renglon.Valores.Count - ValoresALaVista) más <kbd>→</kbd></span>
                                            }
                                        </div>
                                        <div class="vn-res-sub">@renglon.Valores.Count @PluralDeEje(eje) · Enter agrega @ValorTexto(renglon, renglon.MasVendido), el más vendido</div>
                                    </div>
                                    <div class="vn-res-precio">@PrecioDeFamilia(renglon)</div>
                                    <button class="vn-fam-flecha" tabindex="-1" title="@(abierta ? "Cerrar (←)" : "Ver cada uno con su precio y existencia (→)")"
                                            @onclick="() => AlternarFamilia(indiceRenglon)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                        <Ico Nombre="@(abierta ? "abajo" : "derecha")" />
                                    </button>
                                </div>
                                @if (abierta)
                                {
                                    for (var v = 0; v < renglon.Valores.Count; v++)
                                    {
                                        var indiceValor = v;
                                        var valor = renglon.Valores[v].Elemento;
                                        var activoValor = n == _indiceResultado;
                                        var idValor = n++;
                                        <div id="res-@idValor" class="vn-res vn-res-valor @(activoValor ? "activa" : "")" role="option" @onclick="() => AgregarDeLaListaAsync(indiceRenglon, indiceValor)">
                                            <div class="vn-res-texto">
                                                <div class="vn-res-nombre">
                                                    @Punto(eje, renglon.Valores[v].Clave)@Marcado(ValorTexto(renglon, v))
                                                    @if (v == renglon.MasVendido)
                                                    {
                                                        <span class="vn-etiq verde">más vendido</span>
                                                    }
                                                </div>
                                                @if (valor.Codigo is { } codigoValor)
                                                {
                                                    <div class="vn-res-sub"><code>@Marcado(codigoValor)</code></div>
                                                }
                                            </div>
                                            <div class="vn-res-precio">@Formato.Dinero(valor.PrecioCentavos)</div>
                                            <div class="vn-res-exist @ExistenciaClase(valor.Existencia)">@ExistenciaTexto(valor.Existencia)</div>
                                        </div>
                                    }
                                }
                            }
                            if (familias.Renglones.Count > vistos)
                            {
                                <div class="vn-res-vacio">Y @(familias.Renglones.Count - vistos) renglones más: escribe otra palabra para afinar.</div>
                            }
                        }
                        <div class="vn-res-ayuda">
                            <span><kbd>↑</kbd> <kbd>↓</kbd> elegir</span>
                            @if (familias.Ejes.Count > 0)
                            {
                                <span><kbd>→</kbd> desplegar · <kbd>←</kbd> cerrar</span>
                            }
                            <span><kbd>Enter</kbd> agregar</span><span><kbd>Esc</kbd> cerrar</span><span><kbd>3*</kbd> antes del texto = cantidad</span>
                        </div>
                    </div>
                }
            </div>
            <div class="vn-aviso @(_mensaje is null ? "info" : _mensajeEsError ? "error" : "")">
                @if (_mensaje is not null)
                {
                    <span>@_mensaje</span>
                    @* Un código que no existe: lo que sus permisos le dejan (docs/propuesta-interfaz.md, «El cuadro de captura»). *@
                    @if (_codigoNuevo is not null && Ve(AccionControlada.AltaRapida))
                    {
                        <button class="vn-boton chico" @onclick="() => Abrir(Ventanas.AltaRapida)">Darlo de alta aquí</button>
                    }
                    @if (_codigoNuevo is not null && Ve(AccionControlada.ArticuloComun))
                    {
                        <button class="vn-boton chico" @onclick="() => Abrir(Ventanas.Comun)">Venderlo como artículo común</button>
                    }
                }
                else
                {
                    <Ico Nombre="info" />
                    <span>El cursor siempre vuelve aquí: escanea, escribe un nombre o «/» para ver todo lo que puedes hacer.</span>
                }
            </div>
            <div class="vn-barra">
                @if (_rapidos.Count > 0)
                {
                    <span class="vn-rapidos">
                        <span class="vn-tit">Rápidos</span>
                        @for (var k = 0; k < _rapidos.Count; k++)
                        {
                            var listo = _rapidos[k];
                            <button class="vn-rapido" title="Con un número en el cuadro, agrega esa cantidad" @onclick="listo.Agregar">
                                <kbd>Alt+@(k + 1)</kbd>@listo.Rapido.Nombre
                                @if (listo.PrecioCentavos is { } precioRapido)
                                {
                                    <small>@Formato.Dinero(precioRapido)</small>
                                }
                            </button>
                        }
                    </span>
                }
                @* Los tickets en espera, sin límite: unas fichas a la vista y los demás en «Más», en orden de llegada (F5 retoma el primero). *@
                <span class="vn-espera">
                    @{
                        var esperan = EnEspera.ToList();
                    }
                    @for (var k = 0; k < Math.Min(_fichasEnEspera, esperan.Count); k++)
                    {
                        var enEspera = esperan[k];
                        <button class="vn-ficha" title="@TituloEspera(enEspera, k == 0)" @onclick="AlRetomar(enEspera)"><Ico Nombre="pausa" />@Desde(enEspera) · @Formato.Dinero(enEspera.Venta.TotalCentavos)</button>
                    }
                    @if (esperan.Count > _fichasEnEspera)
                    {
                        var resto = esperan.Skip(_fichasEnEspera).ToList();
                        <span class="vn-mas-espera">
                            <button class="vn-boton chico @(_menuEspera ? "on" : "")" aria-expanded="@(_menuEspera ? "true" : "false")" title="Los otros @resto.Count tickets en espera"
                                    @onclick="() => _menuEspera = !_menuEspera">Más (@resto.Count) <Ico Nombre="abajo" /></button>
                            @if (_menuEspera)
                            {
                                <div class="vn-fondo-menu" @onclick="() => _menuEspera = false"></div>
                                <div class="vn-menu-espera" role="menu">
                                    @* Con muchos, flechas arriba y abajo: deslizan la lista al pasar el mouse o con un clic (caja.js). *@
                                    @if (resto.Count > FilasDelMenu)
                                    {
                                        <button class="vn-menu-flecha apagada" data-rodar="-1" aria-label="Más arriba" title="Más arriba: pasa el mouse o haz clic"><Ico Nombre="arriba" /></button>
                                    }
                                    <div class="vn-menu-lista" id="lista-espera">
                                        @foreach (var enEspera in resto)
                                        {
                                            <button class="vn-fila-espera" role="menuitem" title="@TituloEspera(enEspera, false)" @onclick="AlRetomar(enEspera)">
                                                <Ico Nombre="pausa" />
                                                <span><strong>@Desde(enEspera)</strong><small>@ArticulosTexto(enEspera.Venta)</small></span>
                                                <em>@Formato.Dinero(enEspera.Venta.TotalCentavos)</em>
                                            </button>
                                        }
                                    </div>
                                    @if (resto.Count > FilasDelMenu)
                                    {
                                        <button class="vn-menu-flecha" data-rodar="1" aria-label="Más abajo" title="Más abajo: pasa el mouse o haz clic"><Ico Nombre="abajo" /></button>
                                    }
                                </div>
                            }
                        </span>
                    }
                    <button class="vn-boton chico" disabled="@(Actual.Venta.Lineas.Count == 0)" title="Guarda este ticket y empieza otro" @onclick="PonerEnEsperaAsync"><Ico Nombre="pausa" />Poner en espera <kbd>F6</kbd></button>
                </span>
            </div>
            <div class="vn-ticket">
                @if (Actual.Venta.Lineas.Count == 0 && Actual.Buscando.Count == 0)
                {
                    <div class="vn-vacio">
                        <h3>Escanea el primer producto</h3>
                        <p>El cuadro de arriba entiende todo esto, sin abrir otra ventana:</p>
                        <ul>
                            <li><code>7501234567890</code></li><li>el código del lector</li>
                            <li><code>cuaderno estrella</code></li><li>busca por nombre o código; Enter agrega el primero</li>
                            <li><code>12*7501234567890</code></li><li>doce de una vez</li>
                            <li><code>20</code> y <kbd>Alt+1</kbd></li><li>veinte del primer rápido</li>
                            <li><code>A-000118</code></li><li>el folio: devolver o cancelar</li>
                            <li><code>/</code></li><li>todas las acciones que tienes</li>
                        </ul>
                    </div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th class="vn-col-cant">Cantidad</th><th>Descripción</th><th class="num vn-col-precio">Precio</th><th class="num vn-col-importe">Importe</th></tr>
                        </thead>
                        <tbody>
                            @* Lo que no está en la copia de esta caja entra en su lugar como «buscando…» mientras se pregunta a la
                               caja principal (entrega 5): los escaneos que siguen no lo esperan. *@
                            @foreach (var buscando in BuscandoDespuesDe(null))
                            {
                                @RenglonBuscando(buscando)
                            }
                            @* Cada renglón es su propio componente, con @key: al escanear se pinta el nuevo y los demás no (entrega 5,
                               parte 3, «Pintar menos»). *@
                            @for (var i = 0; i < Actual.Venta.Lineas.Count; i++)
                            {
                                var linea = Actual.Venta.Lineas[i];
                                var elegida = i == _seleccion;
                                <FilaTicket @key="linea" Indice="i" Renglon="Renglon(linea)" Seleccionada="elegida" Acciones="@(elegida ? AccionesDe(linea) : null)"
                                            AlTocar="Seleccionar" AlPaso="PasoDeFilaAsync" AlAccion="AccionDeFilaAsync" />
                                @foreach (var buscando in BuscandoDespuesDe(linea))
                                {
                                    @RenglonBuscando(buscando)
                                }
                            }
                            @foreach (var buscando in BuscandoSinLugar())
                            {
                                @RenglonBuscando(buscando)
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>

        <aside class="vn-der @(VaEnPanel ? "con-panel" : "")">
            @if (VaEnPanel)
            {
                @if (_avisoDelPanel is { } avisoDelPanel)
                {
                    <div class="vn-alerta" role="status"><Ico Nombre="info" /><div><span>@avisoDelPanel</span></div></div>
                }
                <CascadingValue Name="VentanaEnPanel" Value="true">
                    <CascadingValue Name="PermisosDeSesion" Value="PermisosEnCascada">@ContenidoDeVentana</CascadingValue>
                </CascadingValue>
            }
            else if (MostrarCambio && _cobrado is { } cobrado)
            {
                @* Al cobrar: el cambio en grande hasta que se escanea al siguiente cliente (docs/propuesta-interfaz.md, «El panel del total»). *@
                <div class="vn-cambio">
                    <span>@(cobrado.CambioCentavos > 0 ? "Entrega de cambio" : "Cobrado")</span>
                    <strong>@Formato.Dinero(cobrado.CambioCentavos > 0 ? cobrado.CambioCentavos : cobrado.TotalCobradoCentavos)</strong>
                    <p>@PagoTexto(cobrado)</p>
                </div>
                @if (_noSalio is { } noSalio)
                {
                    <div class="vn-alerta">
                        <Ico Nombre="impresora" />
                        <div>
                            <span>El ticket <strong>@cobrado.FolioImpreso</strong> no salió: @noSalio La venta ya quedó guardada.</span>
                            <span class="vn-botonera">
                                <button class="vn-boton chico" @onclick="() => ImprimirCobradoAsync(cobrado)">Reintentar</button>
                                <button class="vn-boton chico" @onclick="VerCobradoEnPantallaAsync">Verlo en pantalla</button>
                            </span>
                        </div>
                    </div>
                }
                else if (Impresora.MuestraVistaPrevia)
                {
                    <div class="vn-folio-ok"><Ico Nombre="monitor" />Ticket <code>@cobrado.FolioImpreso</code> · <button class="vn-enlace" @onclick="VerCobradoEnPantallaAsync">verlo en pantalla</button></div>
                }
                else
                {
                    <div class="vn-folio-ok"><Ico Nombre="check" />Ticket <code>@cobrado.FolioImpreso</code> impreso</div>
                }
                <div class="vn-alerta info">
                    <Ico Nombre="escaner" />
                    <div><span>Listo para el siguiente cliente: lo que escanees empieza su ticket. El cambio se queda aquí hasta entonces.</span></div>
                </div>
                @if (Retiro is { } efectivoC)
                {
                    <div class="vn-alerta">
                        <Ico Nombre="efectivo" />
                        <div><span>Hay <strong>@Formato.Dinero(efectivoC.EsperadoCentavos)</strong> en efectivo y el límite es @Formato.Dinero(efectivoC.LimiteCentavos ?? 0): haz un retiro.</span></div>
                    </div>
                }
                <div class="vn-ultimo"><span></span><button class="vn-enlace" @onclick="() => _cobrado = null">Volver al total</button></div>
            }
            else
            {
                @* El cliente: una flecha chica que apunta al ticket; se jala (Ctrl+L) para elegirlo. A su izquierda, lo que debe. *@
                <div class="vn-cliente">
                    @if (Actual.Cliente is not null && Actual.Cuenta is { } cuenta && cuenta.SaldoCentavos != 0)
                    {
                        <span class="vn-cli-dato">
                            @if (cuenta.SaldoCentavos > 0)
                            {
                                <span class="debe" title="@(cuenta.VenceMasAntiguo is { } vence ? $"Lo más antiguo vence el {vence:dd/MM}" : "")">
                                    Debe @Formato.Dinero(cuenta.SaldoCentavos)@(VencidoDelTicket > 0 ? $" · vencido {Formato.Dinero(VencidoDelTicket)}" : "")
                                </span>
                                @if (!_pilotoEleventa)
                                {
                                    <button class="vn-boton chico" @onclick="() => Abrir(Ventanas.Abono)">Abonar <kbd>Ctrl+B</kbd></button>
                                }
                            }
                            else
                            {
                                <span>@Formato.Dinero(cuenta.AFavorCentavos) a favor</span>
                            }
                        </span>
                    }
                    <button class="vn-flecha-cli" title="Elegir el cliente del ticket (Ctrl+L)" @onclick="() => Abrir(Ventanas.ElegirCliente)">
                        <Ico Nombre="usuario" /><span>@(Actual.Cliente?.Nombre ?? "Público en general")</span>
                    </button>
                </div>
                @* data-cobro: lo que el lector teclee en el cobro («Pagó con», montos, referencias, botones) va a la captura y su
                   Enter no cobra (caja.js). *@
                <div class="vn-total" data-cobro>
                    <div class="vn-total-cab"><span>Total</span><span>@ArticulosTexto(Actual.Venta)</span></div>
                    <div class="vn-cifra @(Actual.Venta.Lineas.Count == 0 ? "vacio" : "")">@Formato.Dinero(Actual.Venta.TotalCentavos)</div>
                    <div class="vn-tecla"><kbd>F12</kbd><span>cobrar</span></div>
                    @if (Actual.Venta.Lineas.Sum(l => l.AhorroMayoreoCentavos) is var ahorro and > 0)
                    {
                        <div class="vn-linea verde"><span>Ahorro por mayoreo</span><span>@Formato.Dinero(ahorro)</span></div>
                    }
                    @if (Actual.Venta.DescuentoCentavos > 0)
                    {
                        <div class="vn-linea verde"><span>Descuentos</span><span>−@Formato.Dinero(Actual.Venta.DescuentoCentavos)</span></div>
                    }
                    @if (Actual.Venta.Lineas.Count > 0)
                    {
                        var aCobrar = EnEfectivo.ACobrarCentavos;
                        <div class="vn-separa"></div>
                        @if (aCobrar > 0 && EnEfectivo.RedondeoCentavos != 0)
                        {
                            <div class="vn-linea"><span>En efectivo, al peso</span><strong>@Formato.Dinero(aCobrar)</strong></div>
                        }
                        @* Tarjeta, transferencia o crédito: cada una en su renglón, con lo que faltaba; el efectivo cubre el resto. *@
                        @for (var k = 0; k < _otras.Count; k++)
                        {
                            var otra = _otras[k];
                            <div class="vn-pago-fila" @key="otra">
                                <div class="forma">
                                    <span>@NombreDeForma(otra.Forma)</span>
                                    @if (otra.Forma == FormaPago.Transferencia)
                                    {
                                        <small>queda por verificar</small>
                                    }
                                </div>
                                <label>Monto
                                    <input id="pago-monto-@k" data-pago inputmode="decimal" autocomplete="off" @bind="otra.Monto" @bind:event="oninput"
                                           @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                                </label>
                                @if (otra.Forma == FormaPago.Credito)
                                {
                                    <span class="nota">@NotaDeCredito</span>
                                }
                                else
                                {
                                    <label>Referencia
                                        <input data-pago autocomplete="off" title="@(otra.Forma == FormaPago.Tarjeta ? "La de la terminal" : "La de la transferencia")" @bind="otra.Referencia" @bind:event="oninput"
                                               @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                                    </label>
                                }
                                <button class="x" title="Quitar" aria-label="Quitar" @onclick="() => QuitarForma(otra)"><Ico Nombre="cerrar" /></button>
                            </div>
                        }
                        @if (aCobrar > 0)
                        {
                            <div class="vn-pago-cab">
                                <label for="pago-nuevo">Pagó con</label>
                                @FormasDePago
                            </div>
                            <input id="pago-nuevo" data-pago inputmode="decimal" autocomplete="off" placeholder="@Formato.Dinero(aCobrar)"
                                   @bind="_pagoCon" @bind:event="oninput" @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                        }
                        else if (FormasQueFaltan.Any())
                        {
                            <div class="vn-pago-cab"><span class="nota">Otra forma</span>@FormasDePago</div>
                        }
                        @if (ErrorDeLasFormas is { } errorFormas)
                        {
                            <div class="vn-vivo falta"><span>@errorFormas</span></div>
                        }
                        else if (aCobrar == 0)
                        {
                            <div class="vn-vivo"><span>Cubierto con @(_otras.Count == 1 ? "otra forma" : "otras formas")</span><strong>@Formato.Dinero(0)</strong></div>
                        }
                        else if (_pagoCon.Trim().Length > 0)
                        {
                            @if (PagoConCentavos is null)
                            {
                                <div class="vn-vivo falta"><span>«@_pagoCon» no es una cantidad</span></div>
                            }
                            else if (Recibido >= aCobrar)
                            {
                                <div class="vn-vivo"><span>Cambio</span><strong>@Formato.Dinero(Recibido - aCobrar)</strong></div>
                            }
                            else
                            {
                                <div class="vn-vivo falta"><span>Faltan</span><strong>@Formato.Dinero(aCobrar - Recibido)</strong></div>
                            }
                        }
                        @if (ExcesoDeCredito > 0 && ConCredito)
                        {
                            <div class="vn-alerta">
                                <Ico Nombre="candado" />
                                <div><span>Pasa su límite de crédito por <strong>@Formato.Dinero(ExcesoDeCredito)</strong>@AutorizaExceso</span></div>
                            </div>
                        }
                        @if (_avisoDelCobro is { } avisoCobro)
                        {
                            <div class="vn-alerta">
                                <Ico Nombre="escaner" />
                                <div><span>@avisoCobro</span></div>
                            </div>
                        }
                        <button id="cobrar-nuevo" class="vn-cobrar" disabled="@(_cobrando || ErrorDelCobro is not null)" @onclick="CobrarEnPanelAsync"
                                @onfocus="() => _enPago = true" @onblur="() => _enPago = false">@EtiquetaDeCobrar</button>
                    }
                </div>
                @if (Retiro is { } efectivoN)
                {
                    <div class="vn-alerta">
                        <Ico Nombre="efectivo" />
                        <div>
                            <span>Hay <strong>@Formato.Dinero(efectivoN.EsperadoCentavos)</strong> en efectivo y el límite es @Formato.Dinero(efectivoN.LimiteCentavos ?? 0): haz un retiro.</span>
                            @if (Ve(AccionControlada.SalidaEfectivo))
                            {
                                <span><button class="vn-boton chico" @onclick="() => Abrir(Ventanas.Salida)">Retiro <kbd>F8</kbd></button></span>
                            }
                        </div>
                    </div>
                }
                <div class="vn-ultimo">
                    @if (_ultimo is { } ultimo)
                    {
                        <span>Último: <strong>@ultimo.FolioImpreso</strong> · @Formato.Dinero(ultimo.TotalCobradoCentavos) · cambio <strong>@Formato.Dinero(ultimo.CambioCentavos)</strong></span>
                    }
                    else
                    {
                        <span>Todavía no hay ventas en este turno.</span>
                    }
                    @if (Ve(AccionControlada.Reimprimir))
                    {
                        <button class="vn-enlace" @onclick="ReimprimirUltimoAsync">Reimprimir</button>
                    }
                </div>
            }
        </aside>
    </div>

    @if (_pagina != Pagina.Venta)
    {
        @* Productos, Inventario o Clientes, con lo que se recuerda de cada uno (la búsqueda, el elegido, las etiquetas). *@
        <div class="vn-pagina">
            <CascadingValue Name="@PilotoConEleventa.Cascada" Value="_pilotoEleventa">
                <CascadingValue Name="PermisosDeSesion" Value="PermisosEnCascada">
                    @switch (_pagina)
                    {
                        case Pagina.Productos:
                            <Productos @ref="_productos" Caja="Caja" Sesion="Sesion" Acceso="Acceso" Estado="_paginas.Productos" Etiquetas="_paginas.Etiquetas"
                                       AlIrAEtiquetas="() => IrAAsync(Pagina.Inventario, TareaInventario.Etiquetas)" />
                            break;
                        case Pagina.Inventario:
                            <Inventario @ref="_inventario" Caja="Caja" Sesion="Sesion" Acceso="Acceso" EtiquetasPorImprimir="_paginas.Etiquetas"
                                        Conteo="_conteo" AlContar="c => _conteo = c" TareaInicial="_tareaInicial" />
                            break;
                        default:
                            <Clientes @ref="_clientes" Caja="Caja" Sesion="Sesion" Turno="Turno" Acceso="Acceso" Estado="_paginas.Clientes"
                                      AlGuardar="ClienteGuardadoAsync" AlAbonar="AbonoDesdePaginaAsync" AlReimprimir="AbonoReimpresoDesdePaginaAsync"
                                      AlImprimirEstado="EstadoDesdePaginaAsync" />
                            break;
                    }
                </CascadingValue>
            </CascadingValue>
        </div>
    }

    @* Lo de todos los días; lo demás, en «/» (docs/propuesta-interfaz.md, «La pantalla de venta»). Cada botón hace lo
       que su tecla, también con un panel abierto: el suyo lo cierra y otro lo cambia. En una página se oculta (el selector
       del PDF de Ctrl+Q sigue ahí) y va la barra de la página. *@
    <footer class="vn-teclas @(_pagina == Pagina.Venta ? "" : "oculto")">
        <button @onclick="@(() => ComoSuTecla("F12"))"><kbd>F12</kbd>Cobrar</button>
        <button @onclick="@(() => ComoSuTecla("F10"))"><kbd>F10</kbd>Buscar</button>
        <button @onclick="@(() => ComoSuTecla("F9"))"><kbd>F9</kbd>Verificar</button>
        <button @onclick="@(() => ComoSuTecla("F2"))"><kbd>F2</kbd>Impresiones</button>
        @if (Ve(AccionControlada.ArticuloComun))
        {
            <button @onclick="@(() => ComoSuTecla("Insert"))"><kbd>Ins</kbd>Art. común</button>
        }
        <button @onclick="@(() => ComoSuTecla("Ctrl+L"))"><kbd>Ctrl+L</kbd>Cliente</button>
        @if (Ve(AccionControlada.EntradaEfectivo))
        {
            <button @onclick="@(() => ComoSuTecla("F7"))"><kbd>F7</kbd>Entrada</button>
        }
        @if (Ve(AccionControlada.SalidaEfectivo))
        {
            <button @onclick="@(() => ComoSuTecla("F8"))"><kbd>F8</kbd>Salida</button>
        }
        <button @onclick="@(() => ComoSuTecla("F6"))"><kbd>F6</kbd>En espera</button>
        <button @onclick="AbrirAccionesAsync"><kbd>/</kbd>Más acciones</button>
        @* Ctrl+Q (o «Cotizar un PDF» en «/») abre el selector de archivos de aquí. *@
        <InputFile id="pdf-cotizar" class="oculto" accept=".pdf,application/pdf" onclick="this.value = ''" OnChange="PdfElegidoAsync" />
        <span class="espacio"></span>
        @ChipDelConteo
    </footer>
    @if (_pagina != Pagina.Venta)
    {
        @* La de las páginas, como en el prototipo: regresar a la venta; lo demás son las teclas de la página. *@
        <footer class="vn-teclas">
            <button @onclick="() => IrAAsync(Pagina.Venta)"><kbd>F1</kbd>Volver a la venta</button>
            @if (_pagina != Pagina.Inventario)
            {
                <span class="vn-ayuda-tecla"><kbd>↑</kbd> <kbd>↓</kbd> elegir</span>
                <span class="vn-ayuda-tecla"><kbd>Enter</kbd> abrir</span>
            }
            <span class="vn-ayuda-tecla"><kbd>Esc</kbd> cierra lo abierto; si no hay nada, a la venta</span>
            @if (_errorDePagina is not null)
            {
                <span class="vn-ayuda-tecla error">@_errorDePagina</span>
            }
            <span class="espacio"></span>
            @ChipDelConteo
        </footer>
    }
</div>

@* Lo que se imprime desde una página, sin impresora: encima de la página, sin tocar lo que la venta tenga abierto. Con el
   campo, sin una variable local: si el contenido de la ventana tomara una, cada vuelta del dibujo le daría un manejador
   nuevo a los botones de arriba (las pestañas, el menú del usuario). *@
@if (_pagina != Pagina.Venta && _vistaPreviaDePagina is not null)
{
    <Ventana Titulo="@_vistaPreviaDePagina.Value.Titulo" AlCerrar="CerrarVistaPreviaDePaginaAsync">
        <pre class="ticket">@_vistaPreviaDePagina?.Texto</pre>
        <p class="nota">Sin impresora conectada: así saldrá impreso en la de 80 mm.</p>
    </Ventana>
}

@* Solo con algo encima: sin ventana no hay nada que pintar, y la venta no lo vuelve a pintar con cada escaneo. *@
@if (!VaEnPanel && _ventana != Ventanas.Ninguna)
{
    <CascadingValue Name="PermisosDeSesion" Value="PermisosEnCascada">@ContenidoDeVentana</CascadingValue>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;

    /// <summary>«Cambiar de usuario» (Ctrl+U) y «Salir»: a «¿Quién atiende?».</summary>
    [Parameter] public EventCallback AlSalir { get; set; }

    /// <summary>El corte cerró el turno: «Listo: abrir el siguiente turno», o cerrar el corte ya hecho.</summary>
    [Parameter] public EventCallback AlCerrarTurno { get; set; }

    /// <summary>
    /// El corte Z ya cerró este turno (CorteCaja lo avisa en cuanto cierra, antes de «Listo»): aquí ya no se vende, así que
    /// cerrar la ventana del corte sigue al siguiente turno.
    /// </summary>
    private bool _turnoCerrado;

    /// <summary>
    /// El corte cerró el turno: lo que quedó sin cobrar (también el ticket que se atendía, como estaba) se guarda en espera
    /// para el siguiente turno, como dijo el corte.
    /// </summary>
    private async Task TurnoCerrado()
    {
        _turnoCerrado = true;
        await GuardarEsperaYEsperarAsync();
    }

    /// <summary>
    /// «Cambiar de usuario» (Ctrl+U, el menú, «Que entre a esta caja») y «Salir»: el ticket que se atendía se guarda como
    /// estaba, con los que esperan, y vuelve en espera al regresar (como en el prototipo, cambiar de usuario no lo pierde).
    /// Antes se espera el escaneo en camino y el cobro en curso: un ticket que se está cobrando no se guarda.
    /// </summary>
    private async Task SalirAsync()
    {
        await _captura.EsperarAsync();
        // Ya guardados cuando entre el siguiente: los lee al abrir su venta.
        await GuardarEsperaYEsperarAsync();
        await AlSalir.InvokeAsync();
    }

    /// <summary>
    /// Los paneles de la venta (a la derecha, sin tapar el ticket) y lo que va encima de todo: el corte y la Configuración.
    /// Productos, Inventario y Clientes ya no son ventanas: son páginas (<see cref="Pagina"/>).
    /// </summary>
    private enum Ventanas
    {
        Ninguna, Comun, Entrada, Salida, Verificador, Corte, VentasDelDia, VistaPrevia, Configuracion, Motivo, Devolucion,
        CambiarPrecio, Transferencias, Impresiones, Cotizar, Descuento, AltaRapida, Mayoreo, ElegirCliente,
        AutorizarCosto, Abono, AutorizarCredito,
    }

    /// <summary>
    /// Lo de la venta, que va como panel a la derecha (docs/propuesta-interfaz.md, «Los demás paneles»): el ticket queda a
    /// la vista. El corte y la Configuración siguen encima.
    /// </summary>
    private static readonly HashSet<Ventanas> VentanasEnPanel =
    [
        Ventanas.AutorizarCosto, Ventanas.Comun, Ventanas.Entrada, Ventanas.Salida, Ventanas.Mayoreo, Ventanas.Verificador,
        Ventanas.VentasDelDia, Ventanas.Devolucion, Ventanas.CambiarPrecio, Ventanas.Impresiones, Ventanas.AltaRapida, Ventanas.Descuento,
        Ventanas.ElegirCliente, Ventanas.Abono, Ventanas.Cotizar, Ventanas.Motivo, Ventanas.VistaPrevia, Ventanas.Transferencias,
        Ventanas.AutorizarCredito,
    ];

    private bool VaEnPanel => VentanasEnPanel.Contains(_ventana);

    /// <summary>
    /// Los paneles que se dejan con la tecla de otra cosa (F12, Ctrl+L, F6…) sin perder nada: solo enseñan algo, o lo que
    /// tienen a medias no va a la venta ni al cajón (el verificador, el mayoreo, las ventas del día, el ticket en pantalla,
    /// el cliente, cotizar y las transferencias). Los demás tienen campos que van a la venta o al cajón (artículo común, descuento, precio,
    /// entrada y salida, abono, devolución, alta rápida, impresiones por cobrar, el motivo de la reimpresión): se terminan
    /// con Enter o se cierran con Esc o con su misma tecla, como dice la propuesta («Cada uno con sus campos y Enter para
    /// terminar»). Con otra tecla lo escrito se perdería sin decirlo y, con F12, se cobraría sin ello: Ins, «Engargolado»
    /// $35 y F12 por costumbre en lugar de Enter dejaría el cursor en «Pagó con» con el total de antes. Un panel nuevo no
    /// se deja hasta agregarlo aquí.
    /// </summary>
    private static readonly HashSet<Ventanas> PanelesQueSeDejan =
    [
        Ventanas.Verificador, Ventanas.Mayoreo, Ventanas.VentasDelDia, Ventanas.VistaPrevia, Ventanas.ElegirCliente, Ventanas.Cotizar,
        Ventanas.Transferencias,
    ];

    private bool PanelQueSeDeja => VaEnPanel && PanelesQueSeDejan.Contains(_ventana);

    /// <summary>Por qué el panel abierto no se deja con otra tecla ni con «/ Más acciones»; null si se deja o no hay panel.</summary>
    private string? PorQueNoSeDeja =>
        !VaEnPanel || PanelQueSeDeja ? null
        // Fiar arriba del límite o vender debajo del costo: el cobro está a medias y espera el PIN de quien autoriza. Con
        // otra tecla se quedaría a medias sin decirlo.
        : _ventana is Ventanas.AutorizarCosto or Ventanas.AutorizarCredito ? "El cobro espera la autorización: que la den aquí, o Esc para regresar a la venta."
        // Con campos (artículo común, descuento, entrada…): ver PanelesQueSeDejan.
        : "Primero termina aquí con Enter (o su botón), o Esc para regresar a la venta.";

    /// <summary>
    /// Le dice a caja.js qué hay: una ventana encima (y si es un panel de la venta, con el que Ins y Ctrl+Q también son de la
    /// venta) o una página. Un panel que se quedó en la venta mientras se ve una página no cuenta: está oculto, y las teclas
    /// son de la página. Lo que se imprime desde una página sin impresora va encima, como una ventana.
    /// </summary>
    private async Task AvisarTeclasAsync()
    {
        var enLaVenta = _pagina == Pagina.Venta;
        var encima = (_ventana != Ventanas.Ninguna && (enLaVenta || !VaEnPanel)) || (!enLaVenta && _vistaPreviaDePagina is not null);
        await Js.VentanaAbiertaAsync(encima, enLaVenta && VaEnPanel);
        await Js.PaginaAbiertaAsync(!enLaVenta);
    }

    // ── Las páginas de atrás: Productos, Inventario y Clientes (entrega 8) ──

    /// <summary>Lo que se ve bajo la barra de arriba: la venta, o una página.</summary>
    private Pagina _pagina;

    /// <summary>Lo que se recuerda de las páginas mientras se vende: la búsqueda y el elegido de cada una, y las etiquetas por imprimir.</summary>
    private readonly EstadoDePaginas _paginas = new();

    private Productos? _productos;
    private Inventario? _inventario;
    private Clientes? _clientes;

    /// <summary>La tarea con que abre Inventario (el chip del conteo, «Ir a Etiquetas»); vacío: sus tarjetas.</summary>
    private TareaInventario? _tareaInicial;

    /// <summary>Lo que se imprimió desde una página sin impresora: se ve encima de ella.</summary>
    private (string Titulo, string Texto)? _vistaPreviaDePagina;

    /// <summary>Si lo que se imprimió desde una página no salió: lo dice su barra de abajo.</summary>
    private string? _errorDePagina;

    private IPagina? PaginaAbierta => _pagina switch
    {
        Pagina.Productos => _productos,
        Pagina.Inventario => _inventario,
        Pagina.Clientes => _clientes,
        _ => null,
    };

    private string Activa(Pagina pagina) => _pagina == pagina ? "activa" : "";

    /// <summary>
    /// A una página, o de regreso a la venta (F1, F3, F4, las pestañas): la venta se queda como está, con su ticket, los
    /// tickets en espera, el cobro y el panel que tuviera, y al volver el cursor regresa al cuadro de captura (o al panel).
    /// Lo que no tiene, no se abre: su pestaña ni sale.
    /// </summary>
    private async Task IrAAsync(Pagina pagina, TareaInventario? tarea = null)
    {
        if ((pagina == Pagina.Productos && SinTecla(Ve(AccionControlada.EditarCatalogo))) || (pagina == Pagina.Inventario && SinTecla(VeInventario)))
        {
            Avisar("Eso no está entre lo que puedes hacer: «/» muestra todo lo que sí.");
            return;
        }
        (_menuUsuario, _menuEspera) = (false, false);
        CerrarAcciones();
        if (_resultados is not null)
            CerrarResultados();
        var antes = _pagina;
        (_pagina, _tareaInicial, _vistaPreviaDePagina, _errorDePagina) = (pagina, tarea, null, null);
        if (pagina == antes && pagina != Pagina.Venta)
        {
            // Ya estaba ahí: la tarea que se pidió (el chip del conteo) o el cursor a su búsqueda.
            if (tarea is { } abrir && _inventario is { } inventario)
                await inventario.AbrirAsync(abrir);
            else if (PaginaAbierta is { } abierta)
                await abierta.EnfocarAsync();
        }
        else if (pagina == Pagina.Venta)
            _enfocar = VaEnPanel ? null : "#codigo";
        await AvisarTeclasAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Las teclas en una página, como en el prototipo: F1 regresa a la venta, F3 y F4 cambian de página, Ctrl+U cambia de
    /// usuario y Esc cierra lo que esté abierto adentro (la ficha, una tarea, el estado de cuenta); sin nada abierto, regresa a
    /// la venta. Las de la venta (F12, F2…) no hacen nada aquí. Las flechas, Enter y lo que se escribe son de la página.
    /// </summary>
    private async Task TeclaEnPaginaAsync(string tecla)
    {
        switch (tecla)
        {
            case "F1":
                await IrAAsync(Pagina.Venta);
                break;
            case "F3" when Ve(AccionControlada.EditarCatalogo):
                await IrAAsync(Pagina.Productos);
                break;
            case "F4" when VeInventario:
                await IrAAsync(Pagina.Inventario);
                break;
            case "Ctrl+U":
                await SalirAsync();
                break;
            case "Escape" when Js.FranjaEncima:
                // La guía de la prueba está encima: la página de abajo no se toca.
                break;
            case "Escape" when _vistaPreviaDePagina is not null:
                await CerrarVistaPreviaDePaginaAsync();
                break;
            case "Escape":
                if (PaginaAbierta is not { } pagina || !await pagina.CerrarAsync())
                    await IrAAsync(Pagina.Venta);
                StateHasChanged();
                break;
        }
    }

