@* La pantalla de venta. La de hoy tiene la misma distribución y las mismas teclas que eleventa; la nueva es la del
   rediseño (docs/propuesta-interfaz.md, entrega 0) y cada caja elige cuál usa. Las dos comparten los tickets, el cobro,
   las ventanas y las teclas: solo cambia cómo se ve. *@
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using PapeleriaPos.Nucleo.Configuracion
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IImpresora Impresora

@if (_pantallaNueva)
{
    <div class="venta-nueva">
        <header class="vn-arriba">
            <span class="vn-marca">@Caja.Nombre<small>@Caja.Sucursal</small></span>
            <nav class="vn-pestanas">
                <button class="activa">Venta <kbd>F1</kbd></button>
                <button @onclick="() => Abrir(Ventanas.Productos)">Productos <kbd>F3</kbd></button>
                <button @onclick="() => Abrir(Ventanas.Inventario)">Inventario <kbd>F4</kbd></button>
                <button @onclick="() => Abrir(Ventanas.Clientes)">Clientes</button>
                <button @onclick="() => Abrir(Ventanas.Corte)">Corte</button>
                <button @onclick="() => Abrir(Ventanas.Configuracion)">Configuración</button>
            </nav>
            <span class="espacio"></span>
            <button class="vn-chip" title="Vuelve a la pantalla de venta de hoy; se recuerda en esta PC" @onclick="CambiarPantallaAsync">Pantalla de hoy</button>
            <div class="vn-atiende"><strong>@Sesion.Nombre</strong><small>turno desde @Turno.AbiertoLocal.ToString("HH:mm")</small></div>
            <button class="vn-chip" @onclick="AlSalir">Salir</button>
        </header>
        @if (HayConteoPendiente)
        {
            @FranjaConteo
        }
        @if (Actual.Cliente is not null && Actual.Cuenta is { SaldoCentavos: not 0 })
        {
            @FranjaCredito
        }

        <div class="vn-cuerpo">
            <section class="vn-izq">
                <div class="vn-captura-caja">
                    <div class="vn-captura">
                        <span class="vn-captura-ico" aria-hidden="true">▥</span>
                        @* Sin @bind: caja.js lo lee al Enter y lo vacía al momento (un escaneo nunca se pega al siguiente). *@
                        <input id="codigo" data-codigo data-captura autocomplete="off" spellcheck="false" aria-label="Código del producto"
                               placeholder="Escanea o escribe: código, nombre, 3*código o folio de un ticket" />
                    </div>
                    @if (_resultados is { } resultados)
                    {
                        @* Lo que se escribe a mano busca aquí mismo, sin otra ventana; el lector no (no espera a dejar de teclear). *@
                        <div class="vn-resultados" role="listbox">
                            @if (resultados.Count == 0)
                            {
                                <div class="vn-res-vacio">Nada coincide con «@_textoBuscado». Revisa cómo se escribe, o véndelo como artículo común (<kbd>Ins</kbd>).</div>
                            }
                            else
                            {
                                <div class="vn-res-grupo">Productos · @resultados.Count@(resultados.Count >= MaximoResultados ? " o más" : ""): primero lo que se eligió aquí con este texto, luego lo más vendido</div>
                                @for (var k = 0; k < resultados.Count; k++)
                                {
                                    var indiceRes = k;
                                    var r = resultados[k];
                                    <div id="res-@k" class="vn-res @(k == _indiceResultado ? "activa" : "")" role="option" @onclick="() => ElegirResultadoAsync(indiceRes)">
                                        <div class="vn-res-texto">
                                            <div class="vn-res-nombre">@Marcado(r.Descripcion)</div>
                                            @if (r.Codigo is { } codigoRes)
                                            {
                                                <div class="vn-res-sub"><code>@Marcado(codigoRes)</code></div>
                                            }
                                        </div>
                                        <div class="vn-res-precio">@Formato.Dinero(r.PrecioCentavos)</div>
                                        <div class="vn-res-exist @(r.Existencia is <= 0 ? "nada" : r.Existencia is <= 3 ? "poca" : "")">
                                            @ExistenciaTexto(r.Existencia)
                                        </div>
                                    </div>
                                }
                            }
                            <div class="vn-res-ayuda"><span><kbd>↑</kbd> <kbd>↓</kbd> elegir</span><span><kbd>Enter</kbd> agregar</span><span><kbd>Esc</kbd> cerrar</span><span><kbd>3*</kbd> antes del texto = cantidad</span></div>
                        </div>
                    }
                </div>
                <div class="vn-aviso @(_mensajeEsError ? "error" : "")">
                    @if (_mensaje is not null)
                    {
                        <span>@_mensaje</span>
                        @if (_codigoNuevo is { } nuevoN)
                        {
                            <button class="boton chico" @onclick="() => Abrir(Ventanas.AltaRapida)">Dar de alta «@nuevoN»</button>
                        }
                    }
                </div>
                <div class="vn-barra">
                    @if (_rapidos.Count > 0)
                    {
                        <span class="vn-rapidos">
                            <span class="vn-tit">Rápidos</span>
                            @for (var k = 0; k < _rapidos.Count; k++)
                            {
                                var indiceRapido = k;
                                var listo = _rapidos[k];
                                <button class="vn-rapido" title="Con un número en el cuadro, agrega esa cantidad" @onclick="() => RapidoAsync(indiceRapido)">
                                    <kbd>Alt+@(k + 1)</kbd>@listo.Rapido.Nombre
                                    @if (listo.PrecioCentavos is { } precioRapido)
                                    {
                                        <small>@Formato.Dinero(precioRapido)</small>
                                    }
                                </button>
                            }
                        </span>
                    }
                    <span class="vn-espera">
                        @foreach (var enEspera in EnEspera)
                        {
                            <button class="vn-ficha" title="En espera desde las @Desde(enEspera), @Formato.Numero(enEspera.Venta.NumeroDeArticulos) productos. Al retomarlo, el ticket actual pasa a la espera"
                                    @onclick="() => Retomar(enEspera)">⏸ @Desde(enEspera) · @Formato.Dinero(enEspera.Venta.TotalCentavos)</button>
                        }
                        <button class="boton chico" disabled="@(Actual.Venta.Lineas.Count == 0)" title="Guarda este ticket y empieza otro" @onclick="PonerEnEspera">Poner en espera <kbd>F6</kbd></button>
                    </span>
                </div>
                <div class="vn-ticket">
                    @if (Actual.Venta.Lineas.Count == 0)
                    {
                        <div class="vn-vacio">
                            <h3>Escanea el primer producto</h3>
                            <p>El cuadro de arriba entiende el código del lector, <code>12*código</code> para doce de una vez, el nombre
                                (lo busca aquí abajo; Enter agrega el primero) y el folio de un ticket para devolverlo. Un número y un rápido agregan esa cantidad.</p>
                        </div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr><th class="vn-col-cant">Cantidad</th><th>Descripción</th><th class="num">Precio</th><th class="num">Importe</th></tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Actual.Venta.Lineas.Count; i++)
                                {
                                    var indice = i;
                                    var linea = Actual.Venta.Lineas[i];
                                    var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
                                    <tr id="linea-@i" class="@(i == _seleccion ? "seleccionada" : "")" @onclick="() => Seleccionar(indice)">
                                        <td class="vn-col-cant">
                                            @if (producto is not null && !linea.EsImpresiones)
                                            {
                                                <span class="vn-paso">
                                                    <button tabindex="-1" title="Uno menos" @onclick="() => PasoCantidadAsync(indice, -1)" @onclick:stopPropagation="true">−</button>
                                                    <span>@Formato.Numero(linea.Cantidad.EnUnidades)</span>
                                                    <button tabindex="-1" title="Uno más" @onclick="() => PasoCantidadAsync(indice, 1)" @onclick:stopPropagation="true">+</button>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vn-paso-fijo">@Formato.Numero(linea.Cantidad.EnUnidades)</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="vn-nombre">@(linea.EsImpresiones ? $"Impresiones ({Actual.Impresiones.Count})" : Descripcion(linea, producto))</div>
                                            <div class="vn-sub">
                                                @if (producto?.Codigo is { } codigoLinea)
                                                {
                                                    <code>@codigoLinea</code>
                                                }
                                                @if (linea.TieneMayoreo)
                                                {
                                                    <span class="vn-etiq">@MayoreoTexto(linea, producto) · ahorra @Formato.Dinero(linea.AhorroMayoreoCentavos)</span>
                                                }
                                                @if (linea.TieneDescuento)
                                                {
                                                    <span class="vn-etiq">Descuento −@Formato.Dinero(linea.DescuentoCentavos) · @linea.MotivoDescuento</span>
                                                }
                                                @if (producto?.Existencia is { } quedan && quedan <= 3)
                                                {
                                                    <span class="vn-etiq ambar">@(quedan <= 0 ? "Sin existencia en el sistema" : $"Quedan {Formato.Numero(quedan)}")</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="num">
                                            @if (linea.PrecioCambiado)
                                            {
                                                <s class="precio-original">@Formato.Dinero(linea.PrecioOriginalCentavos ?? 0)</s>
                                            }
                                            @Formato.Dinero(linea.PrecioCentavos)
                                        </td>
                                        <td class="num vn-importe">@Formato.Dinero(linea.ImporteCentavos)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            <aside class="vn-der">
                <div class="vn-cliente">
                    <span>@(Actual.Cliente?.Nombre ?? "Público en general")</span>
                    <button class="vn-chip" title="Elegir el cliente del ticket" @onclick="() => Abrir(Ventanas.ElegirCliente)">Cliente <kbd>Ctrl+L</kbd></button>
                </div>
                <div class="vn-total">
                    <div class="vn-total-cab"><span>Total</span><span>@(Actual.Venta.Lineas.Count == 0 ? "sin productos" : $"{Formato.Numero(Actual.Venta.NumeroDeArticulos)} productos")</span></div>
                    <div class="vn-cifra @(Actual.Venta.Lineas.Count == 0 ? "vacio" : "")">@Formato.Dinero(Actual.Venta.TotalCentavos)</div>
                    <div class="vn-tecla"><kbd>F12</kbd><span>cobrar</span></div>
                    @if (Actual.Venta.DescuentoCentavos > 0)
                    {
                        <div class="vn-linea verde"><span>Descuentos</span><span>−@Formato.Dinero(Actual.Venta.DescuentoCentavos)</span></div>
                    }
                    @if (Actual.Venta.Lineas.Count > 0)
                    {
                        var aCobrar = EnEfectivo.ACobrarCentavos;
                        <div class="vn-separa"></div>
                        @if (EnEfectivo.RedondeoCentavos != 0)
                        {
                            <div class="vn-linea"><span>En efectivo, al peso</span><strong>@Formato.Dinero(aCobrar)</strong></div>
                        }
                        @if (Actual.Cliente is null)
                        {
                            <div class="vn-pago-cab">
                                <label for="pago-nuevo">Pagó con</label>
                                <button class="vn-chip" title="Tarjeta, transferencia o una parte de cada una: abre el cobro de hoy" @onclick="AbrirCobroAsync">Tarjeta o transferencia</button>
                            </div>
                            <input id="pago-nuevo" data-pago inputmode="decimal" autocomplete="off" placeholder="@Formato.Dinero(aCobrar)"
                                   @bind="_pagoCon" @bind:event="oninput" @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                            @if (_pagoCon.Trim().Length > 0)
                            {
                                @if (PagoConCentavos is null)
                                {
                                    <div class="vn-vivo falta"><span>«@_pagoCon» no es una cantidad</span></div>
                                }
                                else if (Recibido >= aCobrar)
                                {
                                    <div class="vn-vivo"><span>Cambio</span><strong>@Formato.Dinero(Recibido - aCobrar)</strong></div>
                                }
                                else
                                {
                                    <div class="vn-vivo falta"><span>Faltan</span><strong>@Formato.Dinero(aCobrar - Recibido)</strong></div>
                                }
                            }
                            <button class="vn-cobrar" disabled="@(_cobrando || PagoConCentavos is null && _pagoCon.Trim().Length > 0 || Recibido < aCobrar)" @onclick="CobrarEnPanelAsync">
                                @(Recibido < aCobrar ? "Falta dinero" : _pagoCon.Trim().Length == 0 ? $"Cobrar exacto {Formato.Dinero(aCobrar)}" : $"Cobrar · cambio {Formato.Dinero(Recibido - aCobrar)}")
                            </button>
                        }
                        else
                        {
                            <p class="nota">Con cliente registrado se cobra en la ventana de hoy, con su crédito o su saldo a favor.</p>
                            <button class="vn-cobrar" @onclick="AbrirCobroAsync">Cobrar <kbd>F12</kbd></button>
                        }
                    }
                </div>
                @if (_efectivo is { PideRetiro: true } efectivoN)
                {
                    <div class="vn-alerta">Hay @Formato.Dinero(efectivoN.EsperadoCentavos) en efectivo y el límite es @Formato.Dinero(efectivoN.LimiteCentavos ?? 0): haz un retiro con F8.</div>
                }
                <div class="vn-ultimo">
                    @if (_ultimo is { } ultimo)
                    {
                        <span>Último: <strong>@ultimo.Folio</strong> · @Formato.Dinero(ultimo.TotalCobradoCentavos) · cambio <strong>@Formato.Dinero(ultimo.CambioCentavos)</strong></span>
                    }
                    else
                    {
                        <span>Todavía no hay ventas en este turno.</span>
                    }
                    <button class="vn-enlace" @onclick="ReimprimirUltimoAsync">Reimprimir</button>
                </div>
            </aside>
        </div>

        <footer class="vn-teclas">
            <button @onclick="IrAlCobroAsync"><kbd>F12</kbd>Cobrar</button>
            <button @onclick="() => Abrir(Ventanas.Buscar)"><kbd>F10</kbd>Buscar</button>
            <button @onclick="() => Abrir(Ventanas.Verificador)"><kbd>F9</kbd>Verificar</button>
            <button @onclick="() => Abrir(Ventanas.Impresiones)"><kbd>F2</kbd>Impresiones</button>
            <button @onclick="() => Abrir(Ventanas.Comun)"><kbd>Ins</kbd>Art. común</button>
            <button @onclick="() => Abrir(Ventanas.Descuento)"><kbd>Ctrl+D</kbd>Descuento</button>
            <button @onclick="AbrirCambioPrecio"><kbd>Ctrl+E</kbd>Precio</button>
            <button @onclick="MayoreoAsync"><kbd>F11</kbd>Mayoreo</button>
            <button @onclick="() => Abrir(Ventanas.Entrada)"><kbd>F7</kbd>Entrada</button>
            <button @onclick="() => Abrir(Ventanas.Salida)"><kbd>F8</kbd>Salida</button>
            <label for="pdf-cotizar" title="Elige un PDF y te dice cuánto cobrar"><kbd>Ctrl+Q</kbd>Cotizar</label>
            <InputFile id="pdf-cotizar" class="oculto" accept=".pdf,application/pdf" onclick="this.value = ''" OnChange="PdfElegidoAsync" />
            <span class="espacio"></span>
            <button @onclick="() => Abrir(Ventanas.VentasDelDia)">Ventas del día</button>
            <button @onclick="() => AbrirDevolucion(null)">Devoluciones</button>
            <button @onclick="() => Abrir(Ventanas.Transferencias)">Transferencias</button>
        </footer>
    </div>
}
else
{
<div class="venta">
    <header class="barra-modulos">
        <button class="modulo activo">F1 Ventas</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Productos)">F3 Productos</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Inventario)">F4 Inventario</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Clientes)">Clientes</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Configuracion)">Configuración</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Corte)">Corte</button>
        <span class="espacio"></span>
        <button class="modulo" title="La pantalla del rediseño (en desarrollo); se recuerda en esta PC" @onclick="CambiarPantallaAsync">Probar la pantalla nueva</button>
        <div class="atiende">
            <small>Le atiende:</small>
            <strong>@Sesion.Nombre</strong>
            <small>@Caja.Sucursal · @Caja.Nombre · turno desde @Turno.AbiertoLocal.ToString("HH:mm")</small>
        </div>
        <button class="modulo" @onclick="AlSalir">Salir</button>
    </header>

    @if (HayConteoPendiente)
    {
        @FranjaConteo
    }
    <div class="titulo-venta">
        VENTA - Ticket @Actual.Numero
        @if (Actual.Cliente is { } delTicket)
        {
            <span class="cliente-ticket">Cliente: @delTicket.Nombre@(delTicket.TextoPrivilegios() is { Length: > 0 } privilegios ? $" · {privilegios}" : "")</span>
        }
    </div>
    @if (Actual.Cliente is not null && Actual.Cuenta is { SaldoCentavos: not 0 })
    {
        @FranjaCredito
    }

    <div class="captura">
        <label for="codigo">Código del producto:</label>
        <input id="codigo" data-codigo autocomplete="off" @bind="_captura.Texto" @bind:event="oninput" @onkeydown="AlTeclearCodigo" />
        <button class="boton" @onclick="AgregarCodigoAsync">ENTER - Agregar producto</button>
    </div>
    <div class="botones-venta">
        <button class="boton" @onclick="() => Abrir(Ventanas.Comun)">INS Varios</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Comun)">CTRL+P Art. común</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Buscar)">F10 Buscar</button>
        <button class="boton" title="Las escalas de mayoreo del producto seleccionado" @onclick="MayoreoAsync">F11 Mayoreo</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Entrada)">F7 Entradas</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Salida)">F8 Salidas</button>
        <button class="boton" @onclick="BorrarSeleccion">DEL Borrar art.</button>
        <button class="boton" @onclick="AbrirCambioPrecio">CTRL+E Cambiar precio</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Descuento)">CTRL+D Descuento</button>
        <button class="boton" title="El cliente registrado del ticket, por nombre o teléfono" @onclick="() => Abrir(Ventanas.ElegirCliente)">CTRL+L Cliente</button>
        <button class="boton" title="Un abono a la cuenta de un cliente" @onclick="() => Abrir(Ventanas.Abono)">CTRL+B Abono</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Verificador)">F9 Verificador</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Impresiones)">F2 Impresiones</button>
        @* Cotizar a un botón: la etiqueta abre el selector de archivos; al elegir el PDF se abre la cotización. *@
        <label class="boton" for="pdf-cotizar" title="Elige un PDF y te dice cuánto cobrar">CTRL+Q Cotizar PDF</label>
        <InputFile id="pdf-cotizar" class="oculto" accept=".pdf,application/pdf" onclick="this.value = ''" OnChange="PdfElegidoAsync" />
    </div>

    <nav class="pestanas">
        @foreach (var t in _tickets)
        {
            <button class="pestana @(t == Actual ? "activa" : "")" @onclick="() => Cambiar(t)">
                Ticket @t.Numero @(t.Venta.Lineas.Count > 0 && t != Actual ? $"({Formato.Dinero(t.Venta.TotalCentavos)})" : "")
            </button>
        }
    </nav>

    <div class="tabla-venta">
        <table>
            <thead>
                <tr>
                    <th class="col-codigo">Código de barras</th>
                    <th>Descripción del producto</th>
                    <th class="num">Precio venta</th>
                    <th class="num col-cant">Cant.</th>
                    <th class="num">Importe</th>
                    <th class="num">Existencia</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Actual.Venta.Lineas.Count; i++)
                {
                    var indice = i;
                    var linea = Actual.Venta.Lineas[i];
                    var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
                    <tr id="linea-@i" class="@(i == _seleccion ? "seleccionada" : "")" @onclick="() => Seleccionar(indice)">
                        <td class="col-codigo">@(producto?.Codigo ?? "—")</td>
                        <td>
                            @(linea.EsImpresiones ? $"Impresiones ({Actual.Impresiones.Count})" : Descripcion(linea, producto))
                            @if (linea.TieneMayoreo)
                            {
                                <small class="descuento">@MayoreoTexto(linea, producto) · ahorra @Formato.Dinero(linea.AhorroMayoreoCentavos)</small>
                            }
                            @if (linea.TieneDescuento)
                            {
                                <small class="descuento">Descuento @(linea.DescuentoCentesimas is { } c ? Permisos.TextoMonto(AccionControlada.Descuento, c) + " " : "")−@Formato.Dinero(linea.DescuentoCentavos) · @linea.MotivoDescuento</small>
                            }
                        </td>
                        <td class="num">
                            @if (linea.PrecioCambiado)
                            {
                                <s class="precio-original">@Formato.Dinero(linea.PrecioOriginalCentavos ?? 0)</s>
                            }
                            @Formato.Dinero(linea.PrecioCentavos)
                        </td>
                        <td class="num col-cant">@Formato.Numero(linea.Cantidad.EnUnidades)</td>
                        <td class="num">@Formato.Dinero(linea.ImporteCentavos)</td>
                        <td class="num">@(producto?.Existencia is { } e ? Formato.Numero(e) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Actual.Venta.Lineas.Count == 0)
        {
            <p class="vacia">Escanea un producto o escribe su código. F10 para buscar por nombre.</p>
        }
    </div>

    @if (_efectivo is { PideRetiro: true } efectivo)
    {
        <div class="mensaje retiro">Hay @Formato.Dinero(efectivo.EsperadoCentavos) en efectivo y el límite es @Formato.Dinero(efectivo.LimiteCentavos ?? 0): haz un retiro con F8.</div>
    }
    @if (_mensaje is not null)
    {
        <div class="mensaje @(_mensajeEsError ? "error" : "")">
            @_mensaje
            @if (_codigoNuevo is { } nuevo && _mensaje is not null)
            {
                <button class="boton chico" @onclick="() => Abrir(Ventanas.AltaRapida)">Dar de alta «@nuevo»</button>
            }
        </div>
    }

    <footer class="pie-venta">
        <div class="pie-izquierda">
            <div class="conteo"><span class="numero">@Formato.Numero(Actual.Venta.NumeroDeArticulos)</span> Productos en la venta actual.</div>
            <div class="botones-pie">
                <button class="boton" @onclick="CambiarSiguiente">F5 - Cambiar</button>
                <button class="boton" @onclick="NuevoTicket">F6 - Pendiente</button>
                <button class="boton" @onclick="EliminarTicket">Eliminar</button>
            </div>
            <div class="ultima">
                <div><small>Total:</small> <strong>@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.TotalCobradoCentavos))</strong></div>
                <div><small>Pagó con:</small> <strong>@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.PagoConCentavos))</strong></div>
                <div><small>Cambio:</small> <strong class="cambio">@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.CambioCentavos))</strong></div>
            </div>
        </div>
        <div class="pie-derecha">
            <div class="cobro">
                <button class="boton cobrar" disabled="@(Actual.Venta.Lineas.Count == 0)" @onclick="AbrirCobroAsync">F12 - Cobrar</button>
                <div class="total">@Formato.Dinero(Actual.Venta.TotalCentavos)</div>
                @if (Actual.Venta.Lineas.Count > 0 && Actual.Venta.Efectivo(0) is { RedondeoCentavos: not 0 } enEfectivo)
                {
                    <div class="total-efectivo">En efectivo: @Formato.Dinero(enEfectivo.ACobrarCentavos)</div>
                }
                @if (Actual.Venta.DescuentoCentavos > 0)
                {
                    <div class="descuento-total">Descuento: −@Formato.Dinero(Actual.Venta.DescuentoCentavos)</div>
                }
            </div>
            <div class="botones-pie">
                <button class="boton" @onclick="ReimprimirUltimoAsync">Reimprimir último ticket</button>
                <button class="boton" @onclick="() => Abrir(Ventanas.VentasDelDia)">Ventas del día</button>
                <button class="boton" @onclick="() => AbrirDevolucion(null)">Devoluciones</button>
                <button class="boton" @onclick="() => Abrir(Ventanas.Transferencias)">Transferencias</button>
            </div>
        </div>
    </footer>
</div>
}

    @switch (_ventana)
