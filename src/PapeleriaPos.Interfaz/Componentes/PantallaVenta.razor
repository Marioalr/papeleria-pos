@* La pantalla de venta: misma distribución y mismas teclas que eleventa. *@
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IImpresora Impresora

<div class="venta">
    <header class="barra-modulos">
        <button class="modulo activo">F1 Ventas</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Productos)">F3 Productos</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Inventario)">F4 Inventario</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Clientes)">Clientes</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Configuracion)">Configuración</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Corte)">Corte</button>
        <span class="espacio"></span>
        <div class="atiende">
            <small>Le atiende:</small>
            <strong>@Sesion.Nombre</strong>
            <small>@Caja.Sucursal · @Caja.Nombre · turno desde @Turno.AbiertoLocal.ToString("HH:mm")</small>
        </div>
        <button class="modulo" @onclick="AlSalir">Salir</button>
    </header>

    @if (_conteo is { } conteo && conteo.Contados < conteo.Total)
    {
        @* Se pide al abrir el turno; se cuenta cuando haya calma. *@
        <div class="franja-conteo">
            Conteo del día: faltan @(conteo.Total - conteo.Contados) de @conteo.Total productos por contar.
            <button class="boton chico" @onclick="() => Abrir(Ventanas.Conteo)">Contar ahora</button>
        </div>
    }
    <div class="titulo-venta">
        VENTA - Ticket @Actual.Numero
        @if (Actual.Cliente is { } delTicket)
        {
            <span class="cliente-ticket">Cliente: @delTicket.Nombre@(delTicket.TextoPrivilegios() is { Length: > 0 } privilegios ? $" · {privilegios}" : "")</span>
        }
    </div>
    @if (Actual.Cliente is { } conCuenta && Actual.Cuenta is { SaldoCentavos: not 0 } cuenta)
    {
        @* Si debe, la caja lo dice al elegirlo, para cobrarlo en esta compra (fase 3). *@
        var vencido = cuenta.Vencido(DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow)));
        <div class="franja-credito @(vencido > 0 ? "vencido" : "")">
            @if (cuenta.SaldoCentavos > 0)
            {
                <span>@conCuenta.Nombre debe @Formato.Dinero(cuenta.SaldoCentavos)@(cuenta.VenceMasAntiguo is { } vence ? $" · vence {vence:dd/MM}" : "")@(vencido > 0 ? $" · vencido {Formato.Dinero(vencido)}" : "")</span>
                <button class="boton chico" @onclick="() => Abrir(Ventanas.Abono)">CTRL+B Abonar</button>
            }
            else
            {
                <span>@conCuenta.Nombre tiene @Formato.Dinero(cuenta.AFavorCentavos) a favor: se usa con «A crédito» al cobrar.</span>
            }
        </div>
    }

    <div class="captura">
        <label for="codigo">Código del producto:</label>
        <input id="codigo" data-codigo autocomplete="off" @bind="_codigo" @bind:event="oninput" @onkeydown="AlTeclearCodigo" />
        <button class="boton" @onclick="AgregarCodigoAsync">ENTER - Agregar producto</button>
    </div>
    <div class="botones-venta">
        <button class="boton" @onclick="() => Abrir(Ventanas.Comun)">INS Varios</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Comun)">CTRL+P Art. común</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Buscar)">F10 Buscar</button>
        <button class="boton" title="Las escalas de mayoreo del producto seleccionado" @onclick="MayoreoAsync">F11 Mayoreo</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Entrada)">F7 Entradas</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Salida)">F8 Salidas</button>
        <button class="boton" @onclick="BorrarSeleccion">DEL Borrar art.</button>
        <button class="boton" @onclick="AbrirCambioPrecio">CTRL+E Cambiar precio</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Descuento)">CTRL+D Descuento</button>
        <button class="boton" title="El cliente registrado del ticket, por nombre o teléfono" @onclick="() => Abrir(Ventanas.ElegirCliente)">CTRL+L Cliente</button>
        <button class="boton" title="Un abono a la cuenta de un cliente" @onclick="() => Abrir(Ventanas.Abono)">CTRL+B Abono</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Verificador)">F9 Verificador</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Impresiones)">F2 Impresiones</button>
        @* Cotizar a un botón: la etiqueta abre el selector de archivos; al elegir el PDF se abre la cotización. *@
        <label class="boton" for="pdf-cotizar" title="Elige un PDF y te dice cuánto cobrar">CTRL+Q Cotizar PDF</label>
        <InputFile id="pdf-cotizar" class="oculto" accept=".pdf,application/pdf" onclick="this.value = ''" OnChange="PdfElegidoAsync" />
    </div>

    <nav class="pestanas">
        @foreach (var t in _tickets)
        {
            <button class="pestana @(t == Actual ? "activa" : "")" @onclick="() => Cambiar(t)">
                Ticket @t.Numero @(t.Venta.Lineas.Count > 0 && t != Actual ? $"({Formato.Dinero(t.Venta.TotalCentavos)})" : "")
            </button>
        }
    </nav>

    <div class="tabla-venta">
        <table>
            <thead>
                <tr>
                    <th class="col-codigo">Código de barras</th>
                    <th>Descripción del producto</th>
                    <th class="num">Precio venta</th>
                    <th class="num col-cant">Cant.</th>
                    <th class="num">Importe</th>
                    <th class="num">Existencia</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Actual.Venta.Lineas.Count; i++)
                {
                    var indice = i;
                    var linea = Actual.Venta.Lineas[i];
                    var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
                    <tr id="linea-@i" class="@(i == _seleccion ? "seleccionada" : "")" @onclick="() => Seleccionar(indice)">
                        <td class="col-codigo">@(producto?.Codigo ?? "—")</td>
                        <td>
                            @(linea.EsImpresiones ? $"Impresiones ({Actual.Impresiones.Count})" : Descripcion(linea, producto))
                            @if (linea.TieneMayoreo)
                            {
                                <small class="descuento">@MayoreoTexto(linea, producto) · ahorra @Formato.Dinero(linea.AhorroMayoreoCentavos)</small>
                            }
                            @if (linea.TieneDescuento)
                            {
                                <small class="descuento">Descuento @(linea.DescuentoCentesimas is { } c ? Permisos.TextoMonto(AccionControlada.Descuento, c) + " " : "")−@Formato.Dinero(linea.DescuentoCentavos) · @linea.MotivoDescuento</small>
                            }
                        </td>
                        <td class="num">
                            @if (linea.PrecioCambiado)
                            {
                                <s class="precio-original">@Formato.Dinero(linea.PrecioOriginalCentavos ?? 0)</s>
                            }
                            @Formato.Dinero(linea.PrecioCentavos)
                        </td>
                        <td class="num col-cant">@Formato.Numero(linea.Cantidad.EnUnidades)</td>
                        <td class="num">@Formato.Dinero(linea.ImporteCentavos)</td>
                        <td class="num">@(producto?.Existencia is { } e ? Formato.Numero(e) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Actual.Venta.Lineas.Count == 0)
        {
            <p class="vacia">Escanea un producto o escribe su código. F10 para buscar por nombre.</p>
        }
    </div>

    @if (_efectivo is { PideRetiro: true } efectivo)
    {
        <div class="mensaje retiro">Hay @Formato.Dinero(efectivo.EsperadoCentavos) en efectivo y el límite es @Formato.Dinero(efectivo.LimiteCentavos ?? 0): haz un retiro con F8.</div>
    }
    @if (_mensaje is not null)
    {
        <div class="mensaje @(_mensajeEsError ? "error" : "")">
            @_mensaje
            @if (_codigoNuevo is { } nuevo && _mensaje is not null)
            {
                <button class="boton chico" @onclick="() => Abrir(Ventanas.AltaRapida)">Dar de alta «@nuevo»</button>
            }
        </div>
    }

    <footer class="pie-venta">
        <div class="pie-izquierda">
            <div class="conteo"><span class="numero">@Formato.Numero(Actual.Venta.NumeroDeArticulos)</span> Productos en la venta actual.</div>
            <div class="botones-pie">
                <button class="boton" @onclick="CambiarSiguiente">F5 - Cambiar</button>
                <button class="boton" @onclick="NuevoTicket">F6 - Pendiente</button>
                <button class="boton" @onclick="EliminarTicket">Eliminar</button>
            </div>
            <div class="ultima">
                <div><small>Total:</small> <strong>@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.TotalCobradoCentavos))</strong></div>
                <div><small>Pagó con:</small> <strong>@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.PagoConCentavos))</strong></div>
                <div><small>Cambio:</small> <strong class="cambio">@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.CambioCentavos))</strong></div>
            </div>
        </div>
        <div class="pie-derecha">
            <div class="cobro">
                <button class="boton cobrar" disabled="@(Actual.Venta.Lineas.Count == 0)" @onclick="AbrirCobroAsync">F12 - Cobrar</button>
                <div class="total">@Formato.Dinero(Actual.Venta.TotalCentavos)</div>
                @if (Actual.Venta.Lineas.Count > 0 && Actual.Venta.Efectivo(0) is { RedondeoCentavos: not 0 } enEfectivo)
                {
                    <div class="total-efectivo">En efectivo: @Formato.Dinero(enEfectivo.ACobrarCentavos)</div>
                }
                @if (Actual.Venta.DescuentoCentavos > 0)
                {
                    <div class="descuento-total">Descuento: −@Formato.Dinero(Actual.Venta.DescuentoCentavos)</div>
                }
            </div>
            <div class="botones-pie">
                <button class="boton" @onclick="ReimprimirUltimoAsync">Reimprimir último ticket</button>
                <button class="boton" @onclick="() => Abrir(Ventanas.VentasDelDia)">Ventas del día</button>
                <button class="boton" @onclick="() => AbrirDevolucion(null)">Devoluciones</button>
                <button class="boton" @onclick="() => Abrir(Ventanas.Transferencias)">Transferencias</button>
            </div>
        </div>
    </footer>

    @switch (_ventana)
    {
        case Ventanas.Cobrar:
            <Ventana Titulo="Cobrar" Clase="cobrar" AlCerrar="Cerrar">
                <CobrarVenta Venta="Actual.Venta" Caja="Caja" Sesion="Sesion" Cliente="Actual.Cliente" Cuenta="Actual.Cuenta" AlCobrar="CobrarAsync" />
            </Ventana>
            break;
        case Ventanas.AutorizarCosto when _costoPorAutorizar is { } costo:
            <Ventana Titulo="Debajo del costo" AlCerrar="Cerrar">
                <AutorizarAccion Accion="AccionControlada.VenderBajoCosto" Detalle="@costo.Detalle" MontoCentavos="costo.Monto" Caja="Caja" Sesion="Sesion"
                                 AlAutorizar="a => CostoAutorizadoAsync(a.Id)" AlCancelar="Cerrar" />
            </Ventana>
            break;
        case Ventanas.Buscar:
            <Ventana Titulo="Buscar producto" Clase="buscar" AlCerrar="Cerrar">
                <BuscarProducto SucursalId="Caja.SucursalId" AlElegir="AgregarVarianteAsync" />
            </Ventana>
            break;
        case Ventanas.Comun:
            <Ventana Titulo="Artículo varios / común" AlCerrar="Cerrar">
                <ArticuloComun AlAgregar="AgregarComun" />
            </Ventana>
            break;
        case Ventanas.Entrada:
        case Ventanas.Salida:
            var tipo = _ventana == Ventanas.Entrada ? TipoMovimientoCaja.Entrada : TipoMovimientoCaja.Salida;
            <Ventana Titulo="@(tipo == TipoMovimientoCaja.Entrada ? "Entrada de efectivo" : "Salida de efectivo")" AlCerrar="Cerrar">
                <MovimientoEfectivo Tipo="tipo" TurnoId="Turno.Id" UsuarioId="Sesion.UsuarioId" AlTerminar="MovimientoRegistrado" />
            </Ventana>
            break;
        case Ventanas.Mayoreo when LineaSeleccionada is { VarianteId: { } varianteMayoreo } lineaMayoreo
                                   && Actual.Productos.TryGetValue(varianteMayoreo, out var productoMayoreo):
            <Ventana Titulo="Mayoreo" AlCerrar="Cerrar">
                <EscalasMayoreo Producto="productoMayoreo" SucursalId="Caja.SucursalId" PresentacionId="lineaMayoreo.PresentacionId" Cantidad="lineaMayoreo.Cantidad"
                                MayoreoDeCliente="Actual.Venta.MayoreoDeCliente"
                                PrecioCambiadoCentavos="@(lineaMayoreo.PrecioCambiado ? lineaMayoreo.PrecioCentavos : null)" />
            </Ventana>
            break;
        case Ventanas.Verificador:
            <Ventana Titulo="Verificador de precios" AlCerrar="Cerrar">
                <Verificador SucursalId="Caja.SucursalId" />
            </Ventana>
            break;
        case Ventanas.Corte:
            <Ventana Titulo="Corte" Clase="corte" AlCerrar="Cerrar">
                @if (_tickets.Count(t => t.Venta.Lineas.Count > 0) is var sinCobrar and > 0)
                {
                    <p class="error">Hay @sinCobrar @(sinCobrar == 1 ? "ticket" : "tickets") sin cobrar: si se cierra el turno, se pierden.</p>
                }
                <CorteCaja Turno="Turno" Sesion="Sesion" Caja="@Caja.Nombre" AlTerminar="AlCerrarTurno" />
            </Ventana>
            break;
        case Ventanas.VentasDelDia:
            <Ventana Titulo="Ventas del día" Clase="ventas-dia" AlCerrar="Cerrar">
                <VentasDelDia CajaId="Caja.Id" AlReimprimir="(Guid id) => PedirReimpresion(id)" AlDevolver="(string folio) => AbrirDevolucion(folio)" />
            </Ventana>
            break;
        case Ventanas.Devolucion:
            <Ventana Titulo="Devoluciones y cancelaciones" Clase="ventas-dia" AlCerrar="Cerrar">
                <DevolverCancelar Caja="Caja" Sesion="Sesion" FolioInicial="@_folioDevolucion" AlTerminar="DevolucionHechaAsync" />
            </Ventana>
            break;
        case Ventanas.CambiarPrecio when LineaSeleccionada is { } seleccionada:
            <Ventana Titulo="Cambiar precio" AlCerrar="Cerrar">
                <CambiarPrecio Descripcion="@seleccionada.Descripcion" PrecioActualCentavos="seleccionada.PrecioCentavos" Cantidad="seleccionada.Cantidad"
                               Caja="Caja" Sesion="Sesion" AlCambiar="PrecioCambiadoAsync" />
            </Ventana>
            break;
        case Ventanas.Impresiones:
            <Ventana Titulo="Impresiones por cobrar" Clase="ventas-dia" AlCerrar="Cerrar">
                <ImpresionesPorCobrar Caja="Caja" Sesion="Sesion" EnElTicket="@Actual.Impresiones.Select(i => i.Id).ToList()" AlAgregar="ImpresionesElegidasAsync" />
            </Ventana>
            break;
        case Ventanas.Productos:
            <Ventana Titulo="Productos" Clase="configuracion" AlCerrar="Cerrar">
                <Productos Caja="Caja" Sesion="Sesion" />
            </Ventana>
            break;
        case Ventanas.Conteo:
            <Ventana Titulo="Conteo del día" Clase="configuracion" AlCerrar="Cerrar">
                <ConteoDelDia Caja="Caja" Sesion="Sesion" AlContar="c => _conteo = c" />
            </Ventana>
            break;
        case Ventanas.Inventario:
            <Ventana Titulo="Inventario" Clase="configuracion" AlCerrar="Cerrar">
                <Inventario Caja="Caja" Sesion="Sesion" />
            </Ventana>
            break;
        case Ventanas.AltaRapida when _codigoNuevo is { } codigoNuevo:
            <Ventana Titulo="Dar de alta" AlCerrar="Cerrar">
                <AltaRapida Codigo="@codigoNuevo" Caja="Caja" Sesion="Sesion" AlDarDeAlta="DadoDeAltaAsync" />
            </Ventana>
            break;
        case Ventanas.Descuento:
            <Ventana Titulo="Descuento" AlCerrar="Cerrar">
                <Descuento Venta="Actual.Venta" Linea="LineaSeleccionada" Caja="Caja" Sesion="Sesion" ClienteDelTicket="Actual.Cliente"
                           AlTerminar="DescuentoAplicadoAsync" />
            </Ventana>
            break;
        case Ventanas.ElegirCliente:
            <Ventana Titulo="Cliente del ticket" Clase="buscar" AlCerrar="Cerrar">
                <ElegirCliente @ref="_elegirCliente" Venta="Actual.Venta" Caja="Caja" Sesion="Sesion" Actual="Actual.Cliente" Catalogo="CatalogoDe"
                               AlTerminar="ClienteElegidoAsync" />
            </Ventana>
            break;
        case Ventanas.Clientes:
            <Ventana Titulo="Clientes" Clase="configuracion" AlCerrar="Cerrar">
                <Clientes Caja="Caja" Sesion="Sesion" Turno="Turno" AlGuardar="ClienteGuardadoAsync" AlAbonar="AbonoRegistradoAsync"
                          AlReimprimir="AbonoReimpresoAsync" />
            </Ventana>
            break;
        case Ventanas.Abono:
            <Ventana Titulo="Abono a cuenta" Clase="buscar" AlCerrar="Cerrar">
                <Abonar Caja="Caja" Sesion="Sesion" Turno="Turno" ClienteInicial="Actual.Cliente" AlTerminar="AbonoRegistradoAsync"
                        AlReimprimir="AbonoReimpresoAsync" />
            </Ventana>
            break;
        case Ventanas.Cotizar:
            <Ventana Titulo="Cotizar PDF" Clase="ventas-dia" AlCerrar="Cerrar">
                <Cotizar Caja="Caja" Sesion="Sesion" Archivo="_pdfACotizar" />
            </Ventana>
            break;
        case Ventanas.Transferencias:
            <Ventana Titulo="Verificar transferencias" Clase="ventas-dia" AlCerrar="Cerrar">
                <VerificarTransferencias Caja="Caja" />
            </Ventana>
            break;
        case Ventanas.Configuracion:
            <Ventana Titulo="Configuración" Clase="configuracion" AlCerrar="Cerrar">
                <Configuracion Caja="Caja" Sesion="Sesion" />
            </Ventana>
            break;
        case Ventanas.Motivo:
            <Ventana Titulo="Reimprimir ticket" AlCerrar="Cerrar">
                <PedirMotivo Etiqueta="Motivo de la reimpresión" Error="@_errorMotivo" Ocupado="_ocupadoMotivo" AlAceptar="ConfirmarReimpresionAsync" />
            </Ventana>
            break;
        case Ventanas.VistaPrevia when _vistaPrevia is { } vista:
            <Ventana Titulo="@vista.Titulo" Clase="vista-previa" AlCerrar="Cerrar">
                <pre class="ticket">@vista.Texto</pre>
                <p class="nota">Sin impresora conectada: así saldrá impreso en la de 80 mm.</p>
            </Ventana>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;
    [Parameter] public EventCallback AlSalir { get; set; }
    [Parameter] public EventCallback AlCerrarTurno { get; set; }

    private enum Ventanas
    {
        Ninguna, Cobrar, Buscar, Comun, Entrada, Salida, Verificador, Corte, VentasDelDia, VistaPrevia, Configuracion, Motivo, Devolucion,
        CambiarPrecio, Transferencias, Impresiones, Cotizar, Descuento, Productos, AltaRapida, Inventario, Conteo, Mayoreo, ElegirCliente, Clientes,
        AutorizarCosto, Abono,
    }

    /// <summary>El conteo cíclico de hoy: cuántos faltan, para pedirlo en la franja.</summary>
    private ConteoCiclicoDto? _conteo;

    private async Task RevisarConteoAsync()
    {
        try
        {
            _conteo = await Cliente.ConteoDelDiaAsync(Caja.SucursalId, Sesion.UsuarioId);
        }
        catch (ErrorCaja)
        {
            // Sin conexión no se pide: el conteo espera a que vuelva.
        }
    }

    private sealed class TicketAbierto
    {
        public required Venta Venta { get; init; }
        public required int Numero { get; init; }
        public Dictionary<Guid, ProductoVentaDto> Productos { get; } = [];

        /// <summary>Los trabajos de impresión que van en la línea "Impresiones" de este ticket.</summary>
        public List<ImpresionPorCobrarDto> Impresiones { get; } = [];

        /// <summary>El cliente registrado del ticket: lo que se agregue después también lleva su descuento y su mayoreo.</summary>
        public ClienteRegistradoDto? Cliente { get; set; }

        /// <summary>Su cuenta (lo que debe, su límite): se pide al elegirlo y otra vez antes de cobrar.</summary>
        public CreditoClienteDto? Cuenta { get; set; }

        /// <summary>Se mandó a fiar y se perdió la respuesta: puede que ya esté guardado. Solo se cobra en línea, con el mismo Id.</summary>
        public bool FiadoSinConfirmar { get; set; }
    }

    private readonly List<TicketAbierto> _tickets = [];
    private TicketAbierto Actual => _tickets[_actual];
    private int _actual;
    private int _seleccion = -1;
    private int _siguienteNumero = 1;
    private string _codigo = "";
    private string? _mensaje;
    private bool _mensajeEsError;
    private TicketDto? _ultimo;
    private (string Titulo, string Texto)? _vistaPrevia;
    private Ventanas _ventana;
    private DotNetObjectReference<PantallaVenta>? _referencia;

    protected override void OnInitialized() => NuevoTicket();

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!primera)
            return;
        _referencia = DotNetObjectReference.Create(this);
        await Js.RegistrarTeclasAsync(_referencia);
        await Js.EnfocarAsync("#codigo");
        await RevisarEfectivoAsync();
        await RevisarConteoAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task Tecla(string tecla)
    {
        if (_ventana != Ventanas.Ninguna)
        {
            if (tecla == "Escape")
                await Cerrar();
            return;
        }

        switch (tecla)
        {
            case "F10": await Abrir(Ventanas.Buscar); break;
            case "F12" when Actual.Venta.Lineas.Count > 0: await AbrirCobroAsync(); break;
            case "F5": CambiarSiguiente(); break;
            case "F6": NuevoTicket(); break;
            case "F7": await Abrir(Ventanas.Entrada); break;
            case "F8": await Abrir(Ventanas.Salida); break;
            case "F9": await Abrir(Ventanas.Verificador); break;
            case "F2": await Abrir(Ventanas.Impresiones); break;
            case "Insert" or "Ctrl+P": await Abrir(Ventanas.Comun); break;
            case "Ctrl+E": await AbrirCambioPrecio(); break;
            case "Ctrl+D": await Abrir(Ventanas.Descuento); break;
            case "Ctrl+L": await Abrir(Ventanas.ElegirCliente); break;
            case "Ctrl+B": await Abrir(Ventanas.Abono); break;
            case "Delete": await BorrarSeleccion(); break;
            case "ArrowUp": await MoverSeleccion(-1); break;
            case "ArrowDown": await MoverSeleccion(1); break;
            case "+": await CambiarCantidadSeleccion(1); break;
            case "-": await CambiarCantidadSeleccion(-1); break;
            case "F11": await MayoreoAsync(); break;
            case "F3": await Abrir(Ventanas.Productos); break;
            case "F4": await Abrir(Ventanas.Inventario); break;
            case "Escape": _codigo = ""; _mensaje = null; break;
        }
        StateHasChanged();
    }

    // ── Captura ─────────────────────────────────────────────────────────────

    private async Task AlTeclearCodigo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AgregarCodigoAsync();
    }

    /// <summary>
    /// "7501…" agrega una pieza; "3*7501…" agrega tres; "5*" cambia la cantidad del renglón seleccionado. El QR de un
    /// ticket ("A-000123") abre la devolución.
    /// </summary>
    private async Task AgregarCodigoAsync()
    {
        var texto = _codigo.Trim();
        if (texto.Length == 0)
            return;
        if (FolioTicket.IsMatch(texto))
        {
            _codigo = "";
            await AbrirDevolucion(texto.ToUpperInvariant());
            return;
        }

        var cantidad = Cantidad.Piezas(1);
        var asterisco = texto.IndexOf('*');
        if (asterisco > 0)
        {
            if (!decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) || n <= 0)
            {
                Avisar($"Cantidad inválida: «{texto[..asterisco]}».");
                return;
            }
            cantidad = Cantidad.Unidades(Math.Round(n, 3));
            texto = texto[(asterisco + 1)..].Trim();
            if (texto.Length == 0)
            {
                await FijarCantidadSeleccion(cantidad);
                _codigo = "";
                return;
            }
        }

        try
        {
            var producto = await Cliente.PorCodigoAsync(texto, Caja.SucursalId);
            if (producto is null)
            {
                Avisar($"No existe el código «{texto}». F10 para buscar por nombre, o dalo de alta.");
                _codigoNuevo = texto;
                return;
            }
            Agregar(producto, null, cantidad);
            _codigo = "";
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarVarianteAsync(Guid varianteId)
    {
        await Cerrar();
        try
        {
            if (await Cliente.PorVarianteAsync(varianteId, Caja.SucursalId) is { } producto)
                Agregar(producto, null, Cantidad.Piezas(1));
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    private void Agregar(ProductoVentaDto producto, Guid? presentacionId, Cantidad cantidad)
    {
        try
        {
            var linea = Actual.Venta.AgregarProducto(producto.ParaVenta(), producto.PresentacionModelo(presentacionId), cantidad, producto.PreciosModelo());
            DescuentoDelCliente(linea);
            Actual.Productos[producto.VarianteId] = producto;
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
            _mensaje = null;
            _ = Js.MostrarAsync($"#linea-{_seleccion}");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarComun((string Descripcion, long Precio, Cantidad Cantidad) articulo)
    {
        await Cerrar();
        try
        {
            var linea = Actual.Venta.AgregarArticuloComun(articulo.Descripcion, articulo.Precio, articulo.Cantidad);
            DescuentoDelCliente(linea);
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    // ── Renglones ───────────────────────────────────────────────────────────

    private void Seleccionar(int indice) => _seleccion = indice;

    private async Task MoverSeleccion(int paso)
    {
        if (Actual.Venta.Lineas.Count == 0)
            return;
        _seleccion = Math.Clamp(_seleccion + paso, 0, Actual.Venta.Lineas.Count - 1);
        await Js.MostrarAsync($"#linea-{_seleccion}");
    }

    private async Task BorrarSeleccion()
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Actual.Impresiones.Clear();
            Actual.Venta.FijarImpresiones(0, 0);
        }
        else
            Actual.Venta.QuitarLinea(linea);
        _seleccion = Math.Min(_seleccion, Actual.Venta.Lineas.Count - 1);
        await RegistrarQuitadoAsync($"Quitó «{linea.Descripcion}» × {linea.Cantidad} del ticket {Actual.Numero}", linea.ImporteCentavos);
    }

    private async Task CambiarCantidadSeleccion(int paso)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        var nueva = linea.Cantidad + Cantidad.Piezas(paso);
        if (!nueva.EsPositiva)
        {
            await BorrarSeleccion();
            return;
        }
        await FijarCantidadSeleccion(nueva);
    }

    /// <summary>Quitar lo ya escaneado no requiere permiso, pero siempre queda en la bitácora.</summary>
    private async Task RegistrarQuitadoAsync(string detalle, long montoCentavos)
    {
        try
        {
            await Cliente.BitacoraAsync(new SolicitudBitacora(Sesion.UsuarioId, Caja.SucursalId, Caja.Id, AccionControlada.QuitarProducto, detalle, montoCentavos));
        }
        catch (ErrorCaja ex)
        {
            Avisar($"No quedó en la bitácora: {ex.Message}");
        }
    }

    /// <summary>
    /// F11: el mayoreo ya se aplica solo al llegar a la cantidad. Como en eleventa, si se escribieron las piezas (el
    /// paquete) y luego F11, esa es la cantidad del renglón seleccionado; si no, muestra sus escalas.
    /// </summary>
    private async Task MayoreoAsync()
    {
        if (LineaSeleccionada is not { VarianteId: { } varianteId, EsImpresiones: false } linea || !Actual.Productos.ContainsKey(varianteId))
        {
            Avisar("Selecciona un producto (flechas) para ver su mayoreo.");
            return;
        }
        var texto = _codigo.Trim().TrimEnd('*');
        if (texto.Length > 0)
        {
            if (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var piezas) || piezas <= 0)
            {
                Avisar($"Escribe cuántas lleva antes de F11: «{texto}» no es una cantidad.");
                return;
            }
            // Si no se pudo (una fracción en algo por pieza), se queda el error y lo escrito.
            if (!await FijarCantidadSeleccion(Cantidad.Unidades(Math.Round(piezas, 3))))
                return;
            _codigo = "";
            if (linea.TieneMayoreo)
                Avisar($"{MayoreoTexto(linea, Actual.Productos[varianteId])}: ahorra {Formato.Dinero(linea.AhorroMayoreoCentavos)}.", error: false);
            else if (linea.PrecioCambiado)
                Avisar("El precio de este renglón se cambió a mano: no aplica el mayoreo.", error: false);
            else if (_mensaje is null)
                Avisar("A esa cantidad no hay mayoreo: F11 sin escribir nada muestra desde cuánto.", error: false);
            return;
        }
        await Abrir(Ventanas.Mayoreo);
    }

    /// <summary>"Mayoreo desde 12", o "desde 24 pzas" en un renglón de paquetes, o "desde 10 m" a granel.</summary>
    private static string MayoreoTexto(VentaLinea linea, ProductoVentaDto? producto) =>
        linea.MayoreoDeCliente ? "Mayoreo de cliente"
            : $"Mayoreo desde {ArmadoTicket.MayoreoTexto(linea.MayoreoDesde!.Value, linea.Unidad, producto?.PresentacionModelo(linea.PresentacionId).EsBase ?? true)}";

    /// <summary>Si se cambió la cantidad; si no, ya avisó por qué.</summary>
    private async Task<bool> FijarCantidadSeleccion(Cantidad cantidad)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
        {
            Avisar("Selecciona un renglón (flechas) para cambiar su cantidad.");
            return false;
        }
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Avisar("Las impresiones se eligen con F2.");
            return false;
        }
        if (linea.VarianteId is not { } varianteId || !Actual.Productos.TryGetValue(varianteId, out var producto))
        {
            Avisar("La cantidad del artículo común no se cambia: bórralo y agrégalo de nuevo.");
            return false;
        }
        var (antes, importeAntes) = (linea.Cantidad, linea.ImporteCentavos);
        try
        {
            Actual.Venta.CambiarCantidad(linea, cantidad, producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo());
            _mensaje = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
            return false;
        }
        if (cantidad < antes)
            await RegistrarQuitadoAsync($"Bajó «{linea.Descripcion}» de {antes} a {cantidad} en el ticket {Actual.Numero}", importeAntes - linea.ImporteCentavos);
        return true;
    }

    // ── Tickets ─────────────────────────────────────────────────────────────

    private void NuevoTicket()
    {
        _tickets.Add(new TicketAbierto
        {
            Numero = _siguienteNumero++,
            Venta = new Venta
            {
                SucursalId = Caja.SucursalId,
                CajaId = Caja.Id,
                TurnoId = Turno.Id,
                CajeroId = Sesion.UsuarioId,
                Serie = Caja.Serie,
                CreadaUtc = DateTime.UtcNow,
            },
        });
        _actual = _tickets.Count - 1;
        _seleccion = -1;
        _ = Js.EnfocarAsync("#codigo");
    }

    private void Cambiar(TicketAbierto ticket)
    {
        _actual = _tickets.IndexOf(ticket);
        _seleccion = Actual.Venta.Lineas.Count - 1;
    }

    private void CambiarSiguiente()
    {
        if (_tickets.Count > 1)
            Cambiar(_tickets[(_actual + 1) % _tickets.Count]);
    }

    private async Task EliminarTicket()
    {
        var venta = Actual.Venta;
        if (venta.Lineas.Count > 0)
            await RegistrarQuitadoAsync($"Eliminó el ticket {Actual.Numero} con {Formato.Numero(venta.NumeroDeArticulos)} productos", venta.TotalCentavos);
        _tickets.RemoveAt(_actual);
        if (_tickets.Count == 0)
            NuevoTicket();
        else
            Cambiar(_tickets[Math.Min(_actual, _tickets.Count - 1)]);
    }

    // ── Cobro e impresión ───────────────────────────────────────────────────

    /// <summary>Lo llama la ventana de cobro. Devuelve el error para mostrarlo ahí, o null si se cobró.</summary>
    private async Task<string?> CobrarAsync(IReadOnlyList<CobroSolicitado> cobros, Guid? autorizacionCredito)
    {
        var abierto = Actual;
        var venta = abierto.Venta;
        try
        {
            // Con el Id del ticket: si la respuesta se pierde, el siguiente intento (en línea o sin conexión) es la misma venta.
            var ticket = await Cliente.CobrarAsync(new SolicitudCobro(Caja.Id, Turno.Id, Sesion.UsuarioId, ArmadoSolicitud.Lineas(venta), cobros,
                VentaId: venta.Id, Impresiones: abierto.Impresiones.Count > 0 ? abierto.Impresiones.Select(i => i.Id).ToList() : null,
                ClienteId: venta.ClienteId, AutorizacionDescuentoId: venta.AutorizacionDescuentoId,
                AutorizacionBajoCostoId: venta.AutorizacionBajoCostoId, MayoreoDeCliente: venta.MayoreoDeCliente,
                AutorizacionCreditoId: autorizacionCredito), soloEnLinea: abierto.FiadoSinConfirmar);
            _tickets.RemoveAt(_actual);
            if (_tickets.Count == 0)
                NuevoTicket();
            else
                Cambiar(_tickets[^1]);
            Avisar($"Venta {ticket.Folio} cobrada. Cambio: {Formato.Dinero(ticket.CambioCentavos)}", error: false);
            _ultimo = ticket;
            await ImprimirAsync(ticket, abrirCajon: ticket.AbreCajon);
            await RevisarEfectivoAsync();
            return null;
        }
        catch (ErrorCaja ex)
        {
            if (ex.Codigo == "fiado-sin-confirmar")
                abierto.FiadoSinConfirmar = true;
            // Si no se pudo fiar (otra caja le fió, le abonaron, venció la autorización…), la ventana sigue abierta con la
            // cuenta al día; los callbacks de las ventanas no vuelven a dibujar esta pantalla.
            if (abierto.Cliente is not null && cobros.Any(c => c.Forma == FormaPago.Credito))
            {
                await CargarCuentaAsync(abierto);
                StateHasChanged();
            }
            return ex.Message;
        }
    }

    private Task ImprimirAsync(TicketDto ticket, bool abrirCajon) =>
        ImprimirDocumentoAsync($"Ticket {ticket.Folio}", DisenoTicket.Armar(ticket), abrirCajon);

    private async Task ImprimirDocumentoAsync(string titulo, IReadOnlyList<Elemento> documento, bool abrirCajon)
    {
        if (Impresora.MuestraVistaPrevia)
        {
            _vistaPrevia = (titulo, TicketTexto.Generar(documento));
            await Abrir(Ventanas.VistaPrevia);
            return;
        }

        // Primero se cierra la ventana y se ve la pantalla lista; la impresora tarda un par de segundos con el logo.
        await Cerrar();
        try
        {
            await Impresora.ImprimirAsync(documento, abrirCajon);
        }
        catch (Exception ex)
        {
            Avisar($"No se pudo imprimir ({titulo}): {ex.Message} Se puede reimprimir.");
            StateHasChanged();
        }
    }

    // ── Reimprimir (con motivo, queda en la bitácora) ───────────────────────

    private Guid? _reimprimir;
    private string? _errorMotivo;
    private bool _ocupadoMotivo;

    private Task ReimprimirUltimoAsync() => PedirReimpresion(null);

    private async Task PedirReimpresion(Guid? ventaId)
    {
        (_reimprimir, _errorMotivo) = (ventaId, null);
        await Abrir(Ventanas.Motivo);
    }

    private async Task ConfirmarReimpresionAsync(string motivo)
    {
        _ocupadoMotivo = true;
        try
        {
            var ventaId = _reimprimir ?? (await Cliente.UltimoTicketAsync(Caja.Id))?.VentaId
                ?? throw new ErrorCaja("Esta caja todavía no tiene ventas.");
            var ticket = await Cliente.ReimprimirAsync(ventaId, new SolicitudReimpresion(Sesion.UsuarioId, Caja.Id, motivo));
            await ImprimirAsync(ticket, abrirCajon: false);
        }
        catch (ErrorCaja ex)
        {
            _errorMotivo = ex.Message;
        }
        finally
        {
            _ocupadoMotivo = false;
        }
    }

    // ── Impresiones (F2) ────────────────────────────────────────────────────

    /// <summary>Las elegidas reemplazan a las que había: van juntas en la línea "Impresiones".</summary>
    private async Task ImpresionesElegidasAsync(IReadOnlyList<ImpresionPorCobrarDto> elegidas)
    {
        await Cerrar();
        Actual.Impresiones.Clear();
        Actual.Impresiones.AddRange(elegidas);
        // El costo no viaja a la caja: el servicio pone el de cada trabajo al cobrar.
        var linea = Actual.Venta.FijarImpresiones(elegidas.Sum(i => i.PrecioCentavos), 0);
        _seleccion = linea is null ? Math.Min(_seleccion, Actual.Venta.Lineas.Count - 1) : Actual.Venta.Lineas.IndexOf(linea);
    }

    // ── Descuento (Ctrl+D) ──────────────────────────────────────────────────

    private async Task DescuentoAplicadoAsync()
    {
        await Cerrar();
        Avisar(Actual.Venta.DescuentoCentavos > 0 ? $"Descuento de {Formato.Dinero(Actual.Venta.DescuentoCentavos)}." : "Se quitaron los descuentos.", error: false);
    }

    private ElegirCliente? _elegirCliente;

    /// <summary>Lo que dejan los descuentos debajo del costo y falta autorizar antes de cobrar.</summary>
    private sealed record CostoPorAutorizar(string Detalle, long Monto);

    private CostoPorAutorizar? _costoPorAutorizar;

    /// <summary>
    /// F12: si el ticket lleva descuentos (el del cliente se pone solo al agregar), antes de cobrar se revisa que nada quede
    /// debajo del costo sin autorización; si falta, se pide aquí y no hasta que el cobro falle.
    /// </summary>
    private async Task AbrirCobroAsync()
    {
        var venta = Actual.Venta;
        if (venta.Lineas.Count == 0)
            return;
        if (venta.Lineas.Any(l => l.TieneDescuento || l.PrecioCambiado) && venta.AutorizacionBajoCostoId is null)
        {
            try
            {
                var bajoCosto = await Cliente.BajoCostoAsync(new SolicitudBajoCosto(Caja.Id, ArmadoSolicitud.Lineas(venta), venta.ClienteId, venta.MayoreoDeCliente));
                if (bajoCosto.FaltanteCentavos > 0)
                {
                    var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.VenderBajoCosto,
                        bajoCosto.FaltanteCentavos));
                    if (decision.Nivel == NivelPermiso.NoPermitido)
                    {
                        Avisar($"Quedan debajo del costo ({string.Join(", ", bajoCosto.Lineas)}) y no tienes permiso para venderlos así.");
                        return;
                    }
                    if (decision.Nivel == NivelPermiso.RequiereAutorizacion)
                    {
                        _costoPorAutorizar = new CostoPorAutorizar($"Con descuento quedan debajo del costo: {string.Join(", ", bajoCosto.Lineas)}",
                            bajoCosto.FaltanteCentavos);
                        await Abrir(Ventanas.AutorizarCosto);
                        return;
                    }
                }
            }
            catch (ErrorCaja ex)
            {
                Avisar(ex.Message);
                return;
            }
        }
        await CargarCuentaAsync(Actual);
        await Abrir(Ventanas.Cobrar);
    }

    private async Task CostoAutorizadoAsync(Guid autorizacionId)
    {
        Actual.Venta.AutorizacionBajoCostoId = autorizacionId;
        _costoPorAutorizar = null;
        await CargarCuentaAsync(Actual);
        await Abrir(Ventanas.Cobrar);
    }

    /// <summary>La cuenta del cliente del ticket (lo que debe y su límite). Sin conexión no se conoce: no se fía.</summary>
    private async Task CargarCuentaAsync(TicketAbierto ticket)
    {
        if (ticket.Cliente is not { } cliente)
        {
            ticket.Cuenta = null;
            return;
        }
        try
        {
            ticket.Cuenta = (await Cliente.CuentaClienteAsync(cliente.Id)).Credito;
        }
        catch (ErrorCaja)
        {
            ticket.Cuenta = null;
        }
    }

    /// <summary>
    /// Un abono o su cancelación: se imprime su comprobante (en efectivo se abre el cajón: entra o sale dinero, y el
    /// servicio lo registra) y se pone al día la cuenta del ticket.
    /// </summary>
    private async Task AbonoRegistradoAsync(ComprobanteAbonoDto comprobante)
    {
        await Cerrar();
        Avisar(comprobante.Cancelado
            ? $"Se canceló el abono {comprobante.Folio}"
              + (comprobante.Forma == FormaPago.Efectivo ? $": entrega {Formato.Dinero(comprobante.CobradoCentavos)} en efectivo" : "")
              + $". «{comprobante.Cliente}» vuelve a deber {Formato.Dinero(comprobante.MontoCentavos)}."
            : $"Abono de {Formato.Dinero(comprobante.MontoCentavos)} de «{comprobante.Cliente}». Saldo: {Formato.Dinero(comprobante.SaldoCentavos)}"
              + (comprobante.Forma == FormaPago.Efectivo ? $". Cambio: {Formato.Dinero(comprobante.CambioCentavos)}." : "."), error: false);
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == comprobante.ClienteId))
            await CargarCuentaAsync(ticket);
        await ImprimirDocumentoAsync($"Abono {comprobante.Folio}", DisenoComprobante.Abono(comprobante), abrirCajon: comprobante.AbreCajon);
        await RevisarEfectivoAsync();
    }

    /// <summary>Una reimpresión: solo el papel; el cajón no se abre (no entra ni sale dinero).</summary>
    private async Task AbonoReimpresoAsync(ComprobanteAbonoDto comprobante)
    {
        await Cerrar();
        Avisar($"Se reimprimió el abono {comprobante.Folio}.", error: false);
        await ImprimirDocumentoAsync($"Abono {comprobante.Folio}", DisenoComprobante.Abono(comprobante), abrirCajon: false);
    }

    /// <summary>
    /// Se editó un cliente en el módulo Clientes: los tickets abiertos que lo tienen se ponen al día (su descuento y su
    /// mayoreo); si quedó inactivo, sale del ticket.
    /// </summary>
    private async Task ClienteGuardadoAsync(ClienteRegistradoDto guardado)
    {
        ClienteGuardado(guardado);
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == guardado.Id))
            await CargarCuentaAsync(ticket);
    }

    private void ClienteGuardado(ClienteRegistradoDto guardado)
    {
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == guardado.Id))
        {
            var nuevo = guardado.Activo ? guardado : null;
            try
            {
                ClienteEnTicket.Cambiar(ticket.Venta, ticket.Cliente, nuevo, l => CatalogoDe(ticket, l));
                ticket.Cliente = nuevo;
                // El costo se vuelve a revisar al cobrar.
                ticket.Venta.AutorizacionBajoCostoId = null;
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
            {
                Avisar($"El ticket {ticket.Numero} no se pudo poner al día con el cliente: {ex.Message}");
                continue;
            }
            Avisar(nuevo is null ? $"«{guardado.Nombre}» quedó inactivo: salió del ticket {ticket.Numero}."
                : $"El ticket {ticket.Numero} ya va con lo nuevo de «{guardado.Nombre}».", error: false);
        }
    }

    private async Task ClienteElegidoAsync(ClienteRegistradoDto? cliente)
    {
        Actual.Cliente = cliente;
        await Cerrar();
        await CargarCuentaAsync(Actual);
        Avisar(cliente is null ? "El ticket ya no tiene cliente." : $"Cliente: {ArmadoTicket.ClienteTexto(cliente)}.", error: false);
    }

    /// <summary>La presentación y los precios de un renglón, de la copia que ya tiene el ticket (funciona sin conexión).</summary>
    private (Presentacion Presentacion, IReadOnlyList<Precio> Precios)? CatalogoDe(VentaLinea linea) => CatalogoDe(Actual, linea);

    private static (Presentacion Presentacion, IReadOnlyList<Precio> Precios)? CatalogoDe(TicketAbierto ticket, VentaLinea linea) =>
        linea.VarianteId is { } varianteId && ticket.Productos.TryGetValue(varianteId, out var producto)
            ? (producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo())
            : null;

    /// <summary>Con cliente con descuento, lo que se agrega al ticket lleva el suyo (el mayoreo ya sale solo del precio).</summary>
    private void DescuentoDelCliente(VentaLinea linea)
    {
        if (Actual.Cliente is { DescuentoCentesimas: > 0 } cliente && !linea.EsImpresiones && linea.DescuentoCentesimas != cliente.DescuentoCentesimas)
            Actual.Venta.DescontarLinea(linea, cliente.DescuentoCentesimas, null, cliente.MotivoDescuento());
    }

    // ── Alta rápida de un código que no existe ──────────────────────────────

    private string? _codigoNuevo;

    private async Task DadoDeAltaAsync(ProductoVentaDto producto)
    {
        _codigoNuevo = null;
        await Cerrar();
        Agregar(producto, null, Cantidad.Piezas(1));
        _codigo = "";
        Avisar($"«{producto.Descripcion}» quedó dado de alta (por completar en F3).", error: false);
    }

    // ── Cotizar (Ctrl+Q) ────────────────────────────────────────────────────

    private IBrowserFile? _pdfACotizar;

    private async Task PdfElegidoAsync(InputFileChangeEventArgs e)
    {
        if (_ventana != Ventanas.Ninguna)
            await Cerrar();
        _pdfACotizar = e.File;
        await Abrir(Ventanas.Cotizar);
    }

    // ── Cambiar precio (Ctrl+E) ─────────────────────────────────────────────

    private VentaLinea? LineaSeleccionada =>
        _seleccion >= 0 && _seleccion < Actual.Venta.Lineas.Count ? Actual.Venta.Lineas[_seleccion] : null;

    private async Task AbrirCambioPrecio()
    {
        switch (LineaSeleccionada)
        {
            case null: Avisar("Selecciona un renglón (flechas) para cambiar su precio."); break;
            case { VarianteId: null }: Avisar("El artículo común ya lleva el precio que se escribió: bórralo y agrégalo de nuevo."); break;
            default: await Abrir(Ventanas.CambiarPrecio); break;
        }
    }

    /// <summary>Queda en la venta con su autorización; el servicio la revisa y la gasta al cobrar.</summary>
    private async Task PrecioCambiadoAsync((long Precio, Guid? AutorizacionId) cambio)
    {
        var linea = LineaSeleccionada!;
        await Cerrar();
        try
        {
            Actual.Venta.CambiarPrecio(linea, cambio.Precio, cambio.AutorizacionId);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    // ── Devoluciones y cancelaciones ────────────────────────────────────────

    private static readonly Regex FolioTicket = new(@"^[A-Za-z]{1,3}-\d{6,}$");

    private string? _folioDevolucion;

    private async Task AbrirDevolucion(string? folio)
    {
        _folioDevolucion = folio;
        // Si ya estaba abierta (desde ventas del día), se vuelve a crear con el folio nuevo.
        _ventana = Ventanas.Ninguna;
        StateHasChanged();
        await Abrir(Ventanas.Devolucion);
    }

    private async Task DevolucionHechaAsync(ComprobanteDevolucionDto comprobante)
    {
        await Cerrar();
        Avisar($"{(comprobante.EsCancelacion ? "Ticket cancelado" : "Devolución registrada")}: entrega {Formato.Dinero(comprobante.ReembolsoEfectivoCentavos)} en efectivo"
            + (comprobante.AlCreditoCentavos > 0 ? $" y baja {Formato.Dinero(comprobante.AlCreditoCentavos)} de la cuenta de «{comprobante.Cliente}»." : "."), error: false);
        await ImprimirDocumentoAsync($"{(comprobante.EsCancelacion ? "Cancelación" : "Devolución")} {comprobante.Folio}",
            DisenoComprobante.Devolucion(comprobante), abrirCajon: comprobante.ReembolsoEfectivoCentavos > 0);
        await RevisarEfectivoAsync();
    }

    // ── Efectivo en caja ────────────────────────────────────────────────────

    private EfectivoCajaDto? _efectivo;

    private async Task MovimientoRegistrado(ComprobanteMovimientoDto comprobante)
    {
        var salida = comprobante.Tipo == TipoMovimientoCaja.Salida;
        await Cerrar();
        Avisar($"{(salida ? "Salida" : "Entrada")} de {Formato.Dinero(comprobante.MontoCentavos)} registrada.", error: false);
        if (salida)
            await ImprimirDocumentoAsync($"Comprobante {comprobante.Folio}", DisenoComprobante.Movimiento(comprobante), abrirCajon: true);
        else if (!Impresora.MuestraVistaPrevia)
        {
            try
            {
                await Impresora.EnviarAsync(TicketEscPos.AbrirCajon());
            }
            catch (Exception ex)
            {
                Avisar($"No se pudo abrir el cajón: {ex.Message}");
            }
        }
        await RevisarEfectivoAsync();
    }

    /// <summary>Si el efectivo llegó al límite de la sucursal, aparece el aviso de retiro hasta que se haga.</summary>
    private async Task RevisarEfectivoAsync()
    {
        try
        {
            _efectivo = await Cliente.EfectivoAsync(Turno.Id);
        }
        catch (ErrorCaja)
        {
            // Sin conexión no hay aviso; lo demás ya muestra el error.
        }
        // Lo llaman callbacks de las ventanas que no vuelven a dibujar esta pantalla.
        StateHasChanged();
    }

    // ── Ventanas y avisos ───────────────────────────────────────────────────

    private async Task Abrir(Ventanas ventana)
    {
        _ventana = ventana;
        await Js.VentanaAbiertaAsync(true);
        StateHasChanged();
    }

    private async Task Cerrar()
    {
        // Si CTRL+L se queda a medio camino (pidiendo la autorización del costo), el ticket regresa a como estaba.
        if (_ventana == Ventanas.ElegirCliente)
            _elegirCliente?.Cancelar();
        _ventana = Ventanas.Ninguna;
        await Js.VentanaAbiertaAsync(false);
        StateHasChanged();
        await Js.EnfocarAsync("#codigo");
    }

    private void Avisar(string mensaje, bool error = true)
    {
        _mensaje = mensaje;
        _mensajeEsError = error;
        _codigoNuevo = null;
    }

    private static string Descripcion(VentaLinea linea, ProductoVentaDto? producto)
    {
        var presentacion = producto?.Presentaciones.FirstOrDefault(p => p.Id == linea.PresentacionId);
        return presentacion is { EsBase: false } ? $"{linea.Descripcion} ({presentacion.Nombre})" : linea.Descripcion;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.QuitarTeclasAsync();
        }
        catch (JSDisconnectedException)
        {
            // El navegador ya se cerró.
        }
        _referencia?.Dispose();
    }
}
