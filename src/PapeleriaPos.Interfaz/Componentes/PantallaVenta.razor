    /// <summary>
    /// Llegan con la sesión, al entrar (entrega 1), para pintar sin preguntar en cada clic; si no (un servicio de antes), se
    /// piden en una sola consulta. Sin ellos (sin conexión ni copia), todo se ve y el servicio decide al hacerlo, como hoy.
    /// </summary>
    private Dictionary<AccionControlada, PermisoDeSesion>? _permisos;

    /// <summary>
    /// Ya se pidieron, con respuesta o sin ella. Antes, lo que depende de ellos no se pinta (ni en «/»): sin ellos todo
    /// se ve, y el cajero vería un instante las pestañas del encargado.
    /// </summary>
    private bool _permisosPedidos;

    private PermisoDeSesion? Permiso(AccionControlada accion) => _permisos?.GetValueOrDefault(accion);

    /// <summary>
    /// A las ventanas: en la autorización se toca la ficha de quien autoriza (sin ellos, sin conexión ni copia, se escribe
    /// su usuario) y en la cuenta del cliente «Devolver saldo a favor» lleva su candado.
    /// </summary>
    private IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? PermisosEnCascada => _permisos;

    /// <summary>Lo que no puede no aparece: ni botón, ni tecla, ni en «/», ni la pestaña. Mientras se piden, tampoco.</summary>
    private bool Ve(AccionControlada accion) => _permisosPedidos && Permiso(accion)?.Nivel != NivelPermiso.NoPermitido;

    /// <summary>
    /// La tecla de algo que no ve (<paramref name="ve"/> en false) solo avisa que no puede. Mientras se piden los permisos
    /// no se sabe: hace lo de siempre y el servicio decide, como sin ellos.
    /// </summary>
    private bool SinTecla(bool ve) => _permisosPedidos && !ve;

    /// <summary>Las teclas de lo que tiene permiso: la de lo que no ve solo avisa.</summary>
    private bool SinTecla(string tecla) => tecla switch
    {
        "F3" => SinTecla(Ve(AccionControlada.EditarCatalogo)),
        "F4" => SinTecla(VeInventario),
        "Insert" or "Ctrl+P" => SinTecla(Ve(AccionControlada.ArticuloComun)),
        "F7" => SinTecla(Ve(AccionControlada.EntradaEfectivo)),
        "F8" => SinTecla(Ve(AccionControlada.SalidaEfectivo)),
