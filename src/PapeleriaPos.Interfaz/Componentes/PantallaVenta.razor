    private Guid? _reimprimir;
    private string? _errorMotivo;
    private bool _ocupadoMotivo;

    private Task ReimprimirUltimoAsync() => PedirReimpresion(null);

    private async Task PedirReimpresion(Guid? ventaId)
    {
        (_reimprimir, _errorMotivo) = (ventaId, null);
        await Abrir(Ventanas.Motivo);
    }

    private async Task ConfirmarReimpresionAsync(string motivo)
    {
        _ocupadoMotivo = true;
        try
        {
            var ventaId = _reimprimir ?? (await Cliente.UltimoTicketAsync(Caja.Id))?.VentaId
                ?? throw new ErrorCaja("Esta caja todavía no tiene ventas.");
            var ticket = await Cliente.ReimprimirAsync(ventaId, new SolicitudReimpresion(Sesion.UsuarioId, Caja.Id, motivo));
            await ImprimirAsync(ticket, abrirCajon: false);
        }
