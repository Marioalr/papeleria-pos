@* La pantalla de venta. La nueva es la del rediseño (docs/propuesta-interfaz.md, entrega 0) y es con la que se entra en
   todas las cajas; la de hoy, con la misma distribución y las mismas teclas que eleventa, queda para volver a ella desde
   el menú del usuario. Las dos comparten los tickets, el cobro, las ventanas y las teclas: solo cambia cómo se ve. *@
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using PapeleriaPos.Nucleo.Configuracion
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IImpresora Impresora
@inject ConexionCaja Conexion
@inject IServiceProvider Servicios

@if (_pantallaNueva)
{
    <div class="venta-nueva">
        <Iconos />
        <header class="vn-arriba">
            <div class="vn-marca">
                <span class="vn-logo">P</span>
                <div><strong>@Caja.Nombre</strong><small>@(Conexion.Servicio.IsLoopback ? "principal" : "secundaria") · @Caja.Sucursal</small></div>
            </div>
            @* Cada quien ve lo que sus permisos le dejan: lo que no puede no aparece (docs/propuesta-interfaz.md, «Usuarios y permisos»).
               Mientras llegan, solo lo que es de todos. *@
            <nav class="vn-pestanas">
                <button class="activa">Venta <kbd>F1</kbd></button>
                @if (Ve(AccionControlada.EditarCatalogo))
                {
                    <button @onclick="() => Abrir(Ventanas.Productos)">Productos <kbd>F3</kbd></button>
                }
                @if (VeInventario)
                {
                    <button @onclick="() => Abrir(Ventanas.Inventario)">Inventario <kbd>F4</kbd></button>
                }
                @* Clientes es de todos, como en la pantalla de hoy: quien no los administra los consulta (sin «Nuevo cliente» ni
                   editar) y en su cuenta recibe abonos y devuelve el saldo a favor, con candado si lo autoriza otro. *@
                <button @onclick="() => Abrir(Ventanas.Clientes)">Clientes</button>
                <button @onclick="() => Abrir(Ventanas.Corte)">Corte</button>
                @if (VeConfiguracion)
                {
                    <button @onclick="() => Abrir(Ventanas.Configuracion)">Configuración</button>
                }
            </nav>
            <span class="espacio"></span>
            <EstadoCaja @ref="_estado" Caja="Caja" Sesion="Sesion" AlImpresiones="() => Abrir(Ventanas.Impresiones)" />
            <div class="vn-usuario-caja">
                <button class="vn-usuario" title="Cambiar de usuario o volver a la pantalla de hoy" @onclick="() => _menuUsuario = !_menuUsuario">
                    <span class="vn-avatar">@Inicial(Sesion.Nombre)</span>
                    <span><strong>@Sesion.Nombre</strong><small>turno desde @Turno.AbiertoLocal.ToString("HH:mm")</small></span>
                </button>
                @if (_menuUsuario)
                {
                    <div class="vn-fondo-menu" @onclick="() => _menuUsuario = false"></div>
                    <div class="vn-menu-usuario">
                        <p>@Sesion.Nombre · @Textos.Rol(Sesion.Rol).ToLowerInvariant()</p>
                        <button @onclick="AlSalir">Cambiar de usuario <kbd>Ctrl+U</kbd></button>
                        @* Solo aquí, no en «/»: un Enter con «/pan…» no deja la de hoy guardada en esta PC sin querer. *@
                        <button @onclick="CambiarPantallaAsync">Volver a la pantalla de hoy</button>
                    </div>
                }
            </div>
        </header>

        <div class="vn-cuerpo">
            <section class="vn-izq">
                <div class="vn-captura-caja">
                    <div class="vn-captura">
                        <Ico Nombre="escaner" Clase="vn-captura-ico" />
                        @* Sin @bind: caja.js lo lee al Enter y lo vacía al momento (un escaneo nunca se pega al siguiente). *@
                        <input id="codigo" data-codigo data-captura autocomplete="off" spellcheck="false" aria-label="Código del producto"
                               placeholder="Escanea o escribe: código, nombre, 3*código o folio de un ticket" />
                        <span class="vn-captura-modo"><kbd>/</kbd> todas las acciones</span>
                    </div>
                    @if (_accionesVistas is { } acciones)
                    {
                        @* «/»: todo lo que puede hacer quien entró, con su tecla; lo que pide autorización dice quién autoriza. *@
                        <div class="vn-resultados" role="listbox">
                            <div class="vn-res-grupo">Acciones que tienes</div>
                            @if (acciones.Count == 0)
                            {
                                <div class="vn-res-vacio">Ninguna acción se llama así: borra lo escrito después de «/» para verlas todas.</div>
                            }
                            @for (var k = 0; k < acciones.Count; k++)
                            {
                                var indiceAccion = k;
                                var accion = acciones[k];
                                <div id="acc-@k" class="vn-res vn-res-accion @(k == _indiceAccion ? "activa" : "")" role="option" @onclick="() => HacerAccionAsync(indiceAccion)">
                                    <Ico Nombre="@accion.Icono" />
                                    <div class="vn-res-texto">
                                        <div class="vn-res-nombre">@accion.Nombre</div>
                                        @if (accion.Regla is { } regla && DetallePermiso(regla) is { } detalle)
                                        {
                                            <div class="vn-res-sub">
                                                @if (Permiso(regla)?.Nivel == NivelPermiso.RequiereAutorizacion)
                                                {
                                                    <Ico Nombre="candado" />
                                                }
                                                @detalle
                                            </div>
                                        }
                                    </div>
                                    @if (accion.Tecla is { } teclaAccion)
                                    {
                                        <kbd>@teclaAccion</kbd>
                                    }
                                </div>
                            }
                            <div class="vn-res-ayuda"><span><kbd>↑</kbd> <kbd>↓</kbd> elegir</span><span><kbd>Enter</kbd> hacerla</span><span><kbd>Esc</kbd> cerrar</span><span>«/desc» deja solo las que dicen «desc»</span></div>
                        </div>
                    }
                    else if (_resultados is { } resultados && _familias is { } familias)
                    {
                        @* Lo que se escribe a mano busca aquí mismo, sin otra ventana; el lector no (no espera a dejar de teclear). Lo que
                           solo cambia en el color, la medida o la marca va en un renglón: una familia (docs/propuesta-interfaz.md). *@
                        <div class="vn-resultados" role="listbox" data-familias="@familias.Ejes.Count">
                            @if (resultados.Count == 0)
                            {
                                <div class="vn-res-vacio">Nada coincide con «@_textoBuscado». Revisa cómo se escribe, o véndelo como artículo común (<kbd>Ins</kbd>).</div>
                            }
                            else
                            {
                                var vistos = Math.Min(familias.Renglones.Count, MaximoResultados);
                                var cuantos = $"{resultados.Count}{(resultados.Count >= ParaFamilias ? " o más" : "")}{(familias.Renglones.Count < resultados.Count ? $" en {familias.Renglones.Count} renglones" : "")}";
                                <div class="vn-res-grupo">
                                    @if (resultados[0].Parecido)
                                    {
                                        @($"Parecidos a «{_textoBuscado}» · {cuantos}: nada coincide exacto, ¿será un error de dedo?")
                                    }
                                    else
                                    {
                                        @($"Productos · {cuantos}: primero lo que se eligió aquí con este texto, luego lo más vendido")
                                    }
                                </div>
                                @if (familias.Ejes.Count > 0)
                                {
                                    <div class="vn-ejes">
                                        <span>Desplegar por</span>
                                        @foreach (var eje in familias.Ejes)
                                        {
                                            var este = eje;
                                            <button class="@(eje == familias.Eje ? "activo" : "")" @onclick="() => ElegirEje(este)" @onclick:preventDefault="true">@NombreDeEje(eje)</button>
                                        }
                                        @if (familias.Ejes.Count > 1)
                                        {
                                            <small><kbd>Tab</kbd> cambia</small>
                                        }
                                    </div>
                                }
                                @if (ParaAfinar() is { Count: > 0 } afinar)
                                {
                                    @* Con un texto general, las palabras que separan los resultados: un clic las agrega a lo escrito. *@
                                    <div class="vn-afinar">
                                        <span>Afinar</span>
                                        @foreach (var (palabra, veces) in afinar)
                                        {
                                            var esta = palabra;
                                            <button tabindex="-1" @onclick="() => AfinarAsync(esta)" @onclick:preventDefault="true">@esta.ToLowerInvariant() <small>@veces</small></button>
                                        }
                                        <small>o escribe el principio de otra palabra</small>
                                    </div>
                                }
                                var n = 0;
                                for (var k = 0; k < vistos; k++)
                                {
                                    var indiceRenglon = k;
                                    var renglon = familias.Renglones[k];
                                    var r = renglon.Elegido;
                                    var activo = n == _indiceResultado;
                                    var idRenglon = n++;
                                    if (!renglon.EsFamilia)
                                    {
                                        <div id="res-@idRenglon" class="vn-res @(activo ? "activa" : "")" role="option" @onclick="() => AgregarDeLaListaAsync(indiceRenglon, -1)">
                                            <div class="vn-res-texto">
                                                <div class="vn-res-nombre">@Marcado(r.Descripcion)@PorSinonimo(r)</div>
                                                @if (r.Codigo is { } codigoRes)
                                                {
                                                    <div class="vn-res-sub"><code>@Marcado(codigoRes)</code></div>
                                                }
                                            </div>
                                            <div class="vn-res-precio">@Formato.Dinero(r.PrecioCentavos)</div>
                                            <div class="vn-res-exist @ExistenciaClase(r.Existencia)">@ExistenciaTexto(r.Existencia)</div>
                                        </div>
                                        continue;
                                    }
                                    var abierta = indiceRenglon == _abierta;
                                    var eje = renglon.Eje!.Value;
                                    <div id="res-@idRenglon" class="vn-res vn-fam @(activo ? "activa" : "")" role="option" @onclick="() => AgregarDeLaListaAsync(indiceRenglon, -1)">
                                        <div class="vn-res-texto">
                                            <div class="vn-res-nombre">@Marcado(renglon.Titulo!)@PorSinonimo(r)</div>
                                            <div class="vn-valores">
                                                @for (var v = 0; v < Math.Min(renglon.Valores.Count, ValoresALaVista); v++)
                                                {
                                                    var indiceValor = v;
                                                    <button class="vn-valor @(v == renglon.MasVendido ? "mas" : "")" tabindex="-1" title="@ValorTitulo(renglon, v)"
                                                            @onclick="() => AgregarDeLaListaAsync(indiceRenglon, indiceValor)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                                        @Punto(eje, renglon.Valores[v].Clave)@Marcado(ValorTexto(renglon, v))
                                                    </button>
                                                }
                                                @if (renglon.Valores.Count > ValoresALaVista)
                                                {
                                                    <span class="vn-mas-valores">y @(renglon.Valores.Count - ValoresALaVista) más <kbd>→</kbd></span>
                                                }
                                            </div>
                                            <div class="vn-res-sub">@renglon.Valores.Count @PluralDeEje(eje) · Enter agrega @ValorTexto(renglon, renglon.MasVendido), el más vendido</div>
                                        </div>
                                        <div class="vn-res-precio">@PrecioDeFamilia(renglon)</div>
                                        <button class="vn-fam-flecha" tabindex="-1" title="@(abierta ? "Cerrar (←)" : "Ver cada uno con su precio y existencia (→)")"
                                                @onclick="() => AlternarFamilia(indiceRenglon)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                            <Ico Nombre="@(abierta ? "abajo" : "derecha")" />
                                        </button>
                                    </div>
                                    @if (abierta)
                                    {
                                        for (var v = 0; v < renglon.Valores.Count; v++)
                                        {
                                            var indiceValor = v;
                                            var valor = renglon.Valores[v].Elemento;
                                            var activoValor = n == _indiceResultado;
                                            var idValor = n++;
                                            <div id="res-@idValor" class="vn-res vn-res-valor @(activoValor ? "activa" : "")" role="option" @onclick="() => AgregarDeLaListaAsync(indiceRenglon, indiceValor)">
                                                <div class="vn-res-texto">
                                                    <div class="vn-res-nombre">
                                                        @Punto(eje, renglon.Valores[v].Clave)@Marcado(ValorTexto(renglon, v))
                                                        @if (v == renglon.MasVendido)
                                                        {
                                                            <span class="vn-etiq verde">más vendido</span>
                                                        }
                                                    </div>
                                                    @if (valor.Codigo is { } codigoValor)
                                                    {
                                                        <div class="vn-res-sub"><code>@Marcado(codigoValor)</code></div>
                                                    }
                                                </div>
                                                <div class="vn-res-precio">@Formato.Dinero(valor.PrecioCentavos)</div>
                                                <div class="vn-res-exist @ExistenciaClase(valor.Existencia)">@ExistenciaTexto(valor.Existencia)</div>
                                            </div>
                                        }
                                    }
                                }
                                if (familias.Renglones.Count > vistos)
                                {
                                    <div class="vn-res-vacio">Y @(familias.Renglones.Count - vistos) renglones más: escribe otra palabra para afinar.</div>
                                }
                            }
                            <div class="vn-res-ayuda">
                                <span><kbd>↑</kbd> <kbd>↓</kbd> elegir</span>
                                @if (familias.Ejes.Count > 0)
                                {
                                    <span><kbd>→</kbd> desplegar · <kbd>←</kbd> cerrar</span>
                                }
                                <span><kbd>Enter</kbd> agregar</span><span><kbd>Esc</kbd> cerrar</span><span><kbd>3*</kbd> antes del texto = cantidad</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="vn-aviso @(_mensaje is null ? "info" : _mensajeEsError ? "error" : "")">
                    @if (_mensaje is not null)
                    {
                        <span>@_mensaje</span>
                        @if (_codigoNuevo is { } nuevoN)
                        {
                            <button class="vn-boton chico" @onclick="() => Abrir(Ventanas.AltaRapida)">Dar de alta «@nuevoN»</button>
                        }
                    }
                    else
                    {
                        <Ico Nombre="info" />
                        <span>El cursor siempre vuelve aquí: escanea, escribe un nombre o «/» para ver todo lo que puedes hacer.</span>
                    }
                </div>
                <div class="vn-barra">
                    @if (_rapidos.Count > 0)
                    {
                        <span class="vn-rapidos">
                            <span class="vn-tit">Rápidos</span>
                            @for (var k = 0; k < _rapidos.Count; k++)
                            {
                                var indiceRapido = k;
                                var listo = _rapidos[k];
                                <button class="vn-rapido" title="Con un número en el cuadro, agrega esa cantidad" @onclick="() => RapidoAsync(indiceRapido)">
                                    <kbd>Alt+@(k + 1)</kbd>@listo.Rapido.Nombre
                                    @if (listo.PrecioCentavos is { } precioRapido)
                                    {
                                        <small>@Formato.Dinero(precioRapido)</small>
                                    }
                                </button>
                            }
                        </span>
                    }
                    @* Los tickets en espera, sin límite: unas fichas a la vista y los demás en «Más», en orden de llegada (F5 retoma el primero). *@
                    <span class="vn-espera">
                        @{
                            var esperan = EnEspera.ToList();
                        }
                        @for (var k = 0; k < Math.Min(FichasEnEspera, esperan.Count); k++)
                        {
                            var enEspera = esperan[k];
                            <button class="vn-ficha" title="@TituloEspera(enEspera, k == 0)" @onclick="() => Retomar(enEspera)"><Ico Nombre="pausa" />@Desde(enEspera) · @Formato.Dinero(enEspera.Venta.TotalCentavos)</button>
                        }
                        @if (esperan.Count > FichasEnEspera)
                        {
                            var resto = esperan.Skip(FichasEnEspera).ToList();
                            <span class="vn-mas-espera">
                                <button class="vn-boton chico @(_menuEspera ? "on" : "")" aria-expanded="@(_menuEspera ? "true" : "false")" title="Los otros @resto.Count tickets en espera"
                                        @onclick="() => _menuEspera = !_menuEspera">Más (@resto.Count) <Ico Nombre="abajo" /></button>
                                @if (_menuEspera)
                                {
                                    <div class="vn-fondo-menu" @onclick="() => _menuEspera = false"></div>
                                    <div class="vn-menu-espera" role="menu">
                                        @* Con muchos, flechas arriba y abajo: deslizan la lista al pasar el mouse o con un clic (caja.js). *@
                                        @if (resto.Count > FilasDelMenu)
                                        {
                                            <button class="vn-menu-flecha apagada" data-rodar="-1" aria-label="Más arriba" title="Más arriba: pasa el mouse o haz clic"><Ico Nombre="arriba" /></button>
                                        }
                                        <div class="vn-menu-lista" id="lista-espera">
                                            @foreach (var enEspera in resto)
                                            {
                                                <button class="vn-fila-espera" role="menuitem" title="@TituloEspera(enEspera, false)" @onclick="() => Retomar(enEspera)">
                                                    <Ico Nombre="pausa" />
                                                    <span><strong>@Desde(enEspera)</strong><small>@ArticulosTexto(enEspera.Venta)</small></span>
                                                    <em>@Formato.Dinero(enEspera.Venta.TotalCentavos)</em>
                                                </button>
                                            }
                                        </div>
                                        @if (resto.Count > FilasDelMenu)
                                        {
                                            <button class="vn-menu-flecha" data-rodar="1" aria-label="Más abajo" title="Más abajo: pasa el mouse o haz clic"><Ico Nombre="abajo" /></button>
                                        }
                                    </div>
                                }
                            </span>
                        }
                        <button class="vn-boton chico" disabled="@(Actual.Venta.Lineas.Count == 0)" title="Guarda este ticket y empieza otro" @onclick="PonerEnEspera"><Ico Nombre="pausa" />Poner en espera <kbd>F6</kbd></button>
                    </span>
                </div>
                <div class="vn-ticket">
                    @if (Actual.Venta.Lineas.Count == 0)
                    {
                        <div class="vn-vacio">
                            <h3>Escanea el primer producto</h3>
                            <p>El cuadro de arriba entiende todo esto, sin abrir otra ventana:</p>
                            <ul>
                                <li><code>7501234567890</code></li><li>el código del lector</li>
                                <li><code>cuaderno estrella</code></li><li>busca por nombre o código; Enter agrega el primero</li>
                                <li><code>12*7501234567890</code></li><li>doce de una vez</li>
                                <li><code>20</code> y <kbd>Alt+1</kbd></li><li>veinte del primer rápido</li>
                                <li><code>A-000118</code></li><li>el folio: devolver o cancelar</li>
                                <li><code>/</code></li><li>todas las acciones que tienes</li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr><th class="vn-col-cant">Cantidad</th><th>Descripción</th><th class="num vn-col-precio">Precio</th><th class="num vn-col-importe">Importe</th></tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Actual.Venta.Lineas.Count; i++)
                                {
                                    var indice = i;
                                    var linea = Actual.Venta.Lineas[i];
                                    var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
                                    <tr id="linea-@i" class="@(i == _seleccion ? "seleccionada" : "")" @onclick="() => Seleccionar(indice)">
                                        <td class="vn-col-cant">
                                            @if (producto is not null && !linea.EsImpresiones)
                                            {
                                                <span class="vn-paso">
                                                    <button tabindex="-1" title="Uno menos" @onclick="() => PasoCantidadAsync(indice, -1)" @onclick:stopPropagation="true">−</button>
                                                    <span>@Formato.Numero(linea.Cantidad.EnUnidades)</span>
                                                    <button tabindex="-1" title="Uno más" @onclick="() => PasoCantidadAsync(indice, 1)" @onclick:stopPropagation="true">+</button>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vn-paso-fijo">@Formato.Numero(linea.Cantidad.EnUnidades)</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="vn-nombre">@(linea.EsImpresiones ? $"Impresiones ({Actual.Impresiones.Count})" : Descripcion(linea, producto))</div>
                                            <div class="vn-sub">
                                                @if (producto?.Codigo is { } codigoLinea)
                                                {
                                                    <code>@codigoLinea</code>
                                                }
                                                @if (linea.TieneMayoreo)
                                                {
                                                    <span class="vn-etiq">@MayoreoTexto(linea, producto) · ahorra @Formato.Dinero(linea.AhorroMayoreoCentavos)</span>
                                                }
                                                @if (linea.TieneDescuento)
                                                {
                                                    <span class="vn-etiq">Descuento −@Formato.Dinero(linea.DescuentoCentavos) · @linea.MotivoDescuento</span>
                                                }
                                                @if (linea.PrecioCambiado)
                                                {
                                                    <span class="vn-etiq azul">Precio cambiado</span>
                                                }
                                                @if (producto?.Existencia is { } quedan && quedan <= 3)
                                                {
                                                    <span class="vn-etiq ambar">@(quedan <= 0 ? "Sin existencia en el sistema" : $"Quedan {Formato.Numero(quedan)}")</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="num vn-precio">
                                            @if (linea.PrecioCambiado)
                                            {
                                                <s>@Formato.Dinero(linea.PrecioOriginalCentavos ?? 0)</s>
                                            }
                                            @Formato.Dinero(linea.PrecioCentavos)
                                        </td>
                                        <td class="num vn-importe">@Formato.Dinero(linea.ImporteCentavos)</td>
                                    </tr>
                                    @if (i == _seleccion)
                                    {
                                        @* Las acciones del artículo, pegadas a su fila: así el panel de la derecha queda solo para el dinero. *@
                                        <tr class="vn-acciones-fila">
                                            <td></td>
                                            <td colspan="3">
                                                <div class="vn-tira">
                                                    @if (producto is not null && !linea.EsImpresiones && Ve(AccionControlada.CambiarPrecio))
                                                    {
                                                        <button class="vn-accion" @onclick="() => EnLaFilaAsync(AbrirCambioPrecio)" @onclick:stopPropagation="true">
                                                            <Ico Nombre="etiqueta" />Precio @Marca(AccionControlada.CambiarPrecio, "Ctrl+E")
                                                        </button>
                                                    }
                                                    @if (Ve(AccionControlada.Descuento))
                                                    {
                                                        <button class="vn-accion" @onclick="() => EnLaFilaAsync(() => Abrir(Ventanas.Descuento))" @onclick:stopPropagation="true">
                                                            <Ico Nombre="porcentaje" />Descuento @Limite(AccionControlada.Descuento) @Marca(AccionControlada.Descuento, "Ctrl+D")
                                                        </button>
                                                    }
                                                    @if (producto is not null && !linea.EsImpresiones && TieneEscalas(producto))
                                                    {
                                                        <button class="vn-accion" @onclick="() => EnLaFilaAsync(MayoreoAsync)" @onclick:stopPropagation="true">
                                                            <Ico Nombre="capas" />Mayoreo <kbd>F11</kbd>
                                                        </button>
                                                    }
                                                    @if (Ve(AccionControlada.QuitarProducto))
                                                    {
                                                        <button class="vn-accion peligro" @onclick="() => EnLaFilaAsync(BorrarSeleccion)" @onclick:stopPropagation="true">
                                                            <Ico Nombre="basura" />Quitar <kbd>Supr</kbd>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            <aside class="vn-der @(VaEnPanel ? "con-panel" : "")">
                @if (VaEnPanel)
                {
                    @if (_avisoDelPanel is { } avisoDelPanel)
                    {
                        <div class="vn-alerta" role="status"><Ico Nombre="info" /><div><span>@avisoDelPanel</span></div></div>
                    }
                    <CascadingValue Name="VentanaEnPanel" Value="true">
                        <CascadingValue Name="PermisosDeSesion" Value="PermisosEnCascada">@ContenidoDeVentana</CascadingValue>
                    </CascadingValue>
                }
                else if (MostrarCambio && _cobrado is { } cobrado)
                {
                    @* Al cobrar: el cambio en grande hasta que se escanea al siguiente cliente (docs/propuesta-interfaz.md, «El panel del total»). *@
                    <div class="vn-cambio">
                        <span>@(cobrado.CambioCentavos > 0 ? "Entrega de cambio" : "Cobrado")</span>
                        <strong>@Formato.Dinero(cobrado.CambioCentavos > 0 ? cobrado.CambioCentavos : cobrado.TotalCobradoCentavos)</strong>
                        <p>@PagoTexto(cobrado)</p>
                    </div>
                    @if (_noSalio is { } noSalio)
                    {
                        <div class="vn-alerta">
                            <Ico Nombre="impresora" />
                            <div>
                                <span>El ticket <strong>@cobrado.FolioImpreso</strong> no salió: @noSalio La venta ya quedó guardada.</span>
                                <span class="vn-botonera">
                                    <button class="vn-boton chico" @onclick="() => ImprimirCobradoAsync(cobrado)">Reintentar</button>
                                    <button class="vn-boton chico" @onclick="VerCobradoEnPantallaAsync">Verlo en pantalla</button>
                                </span>
                            </div>
                        </div>
                    }
                    else if (Impresora.MuestraVistaPrevia)
                    {
                        <div class="vn-folio-ok"><Ico Nombre="monitor" />Ticket <code>@cobrado.FolioImpreso</code> · <button class="vn-enlace" @onclick="VerCobradoEnPantallaAsync">verlo en pantalla</button></div>
                    }
                    else
                    {
                        <div class="vn-folio-ok"><Ico Nombre="check" />Ticket <code>@cobrado.FolioImpreso</code> impreso</div>
                    }
                    <div class="vn-alerta info">
                        <Ico Nombre="escaner" />
                        <div><span>Listo para el siguiente cliente: lo que escanees empieza su ticket. El cambio se queda aquí hasta entonces.</span></div>
                    </div>
                    @if (Retiro is { } efectivoC)
                    {
                        <div class="vn-alerta">
                            <Ico Nombre="efectivo" />
                            <div><span>Hay <strong>@Formato.Dinero(efectivoC.EsperadoCentavos)</strong> en efectivo y el límite es @Formato.Dinero(efectivoC.LimiteCentavos ?? 0): haz un retiro.</span></div>
                        </div>
                    }
                    <div class="vn-ultimo"><span></span><button class="vn-enlace" @onclick="() => _cobrado = null">Volver al total</button></div>
                }
                else
                {
                    @* El cliente: una flecha chica que apunta al ticket; se jala (Ctrl+L) para elegirlo. A su izquierda, lo que debe. *@
                    <div class="vn-cliente">
                        @if (Actual.Cliente is not null && Actual.Cuenta is { } cuenta && cuenta.SaldoCentavos != 0)
                        {
                            <span class="vn-cli-dato">
                                @if (cuenta.SaldoCentavos > 0)
                                {
                                    <span class="debe" title="@(cuenta.VenceMasAntiguo is { } vence ? $"Lo más antiguo vence el {vence:dd/MM}" : "")">
                                        Debe @Formato.Dinero(cuenta.SaldoCentavos)@(VencidoDelTicket > 0 ? $" · vencido {Formato.Dinero(VencidoDelTicket)}" : "")
                                    </span>
                                    @if (!_pilotoEleventa)
                                    {
                                        <button class="vn-boton chico" @onclick="() => Abrir(Ventanas.Abono)">Abonar <kbd>Ctrl+B</kbd></button>
                                    }
                                }
                                else
                                {
                                    <span>@Formato.Dinero(cuenta.AFavorCentavos) a favor</span>
                                }
                            </span>
                        }
                        <button class="vn-flecha-cli" title="Elegir el cliente del ticket (Ctrl+L)" @onclick="() => Abrir(Ventanas.ElegirCliente)">
                            <Ico Nombre="usuario" /><span>@(Actual.Cliente?.Nombre ?? "Público en general")</span>
                        </button>
                    </div>
                    @* data-cobro: lo que el lector teclee en el cobro («Pagó con», montos, referencias, botones) va a la captura y su
                       Enter no cobra (caja.js). *@
                    <div class="vn-total" data-cobro>
                        <div class="vn-total-cab"><span>Total</span><span>@ArticulosTexto(Actual.Venta)</span></div>
                        <div class="vn-cifra @(Actual.Venta.Lineas.Count == 0 ? "vacio" : "")">@Formato.Dinero(Actual.Venta.TotalCentavos)</div>
                        <div class="vn-tecla"><kbd>F12</kbd><span>cobrar</span></div>
                        @if (Actual.Venta.Lineas.Sum(l => l.AhorroMayoreoCentavos) is var ahorro and > 0)
                        {
                            <div class="vn-linea verde"><span>Ahorro por mayoreo</span><span>@Formato.Dinero(ahorro)</span></div>
                        }
                        @if (Actual.Venta.DescuentoCentavos > 0)
                        {
                            <div class="vn-linea verde"><span>Descuentos</span><span>−@Formato.Dinero(Actual.Venta.DescuentoCentavos)</span></div>
                        }
                        @if (Actual.Venta.Lineas.Count > 0)
                        {
                            var aCobrar = EnEfectivo.ACobrarCentavos;
                            <div class="vn-separa"></div>
                            @if (aCobrar > 0 && EnEfectivo.RedondeoCentavos != 0)
                            {
                                <div class="vn-linea"><span>En efectivo, al peso</span><strong>@Formato.Dinero(aCobrar)</strong></div>
                            }
                            @* Tarjeta, transferencia o crédito: cada una en su renglón, con lo que faltaba; el efectivo cubre el resto. *@
                            @for (var k = 0; k < _otras.Count; k++)
                            {
                                var otra = _otras[k];
                                <div class="vn-pago-fila" @key="otra">
                                    <div class="forma">
                                        <span>@NombreDeForma(otra.Forma)</span>
                                        @if (otra.Forma == FormaPago.Transferencia)
                                        {
                                            <small>queda por verificar</small>
                                        }
                                    </div>
                                    <label>Monto
                                        <input id="pago-monto-@k" data-pago inputmode="decimal" autocomplete="off" @bind="otra.Monto" @bind:event="oninput"
                                               @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                                    </label>
                                    @if (otra.Forma == FormaPago.Credito)
                                    {
                                        <span class="nota">@NotaDeCredito</span>
                                    }
                                    else
                                    {
                                        <label>Referencia
                                            <input data-pago autocomplete="off" title="@(otra.Forma == FormaPago.Tarjeta ? "La de la terminal" : "La de la transferencia")" @bind="otra.Referencia" @bind:event="oninput"
                                                   @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                                        </label>
                                    }
                                    <button class="x" title="Quitar" aria-label="Quitar" @onclick="() => QuitarForma(otra)"><Ico Nombre="cerrar" /></button>
                                </div>
                            }
                            @if (aCobrar > 0)
                            {
                                <div class="vn-pago-cab">
                                    <label for="pago-nuevo">Pagó con</label>
                                    @FormasDePago
                                </div>
                                <input id="pago-nuevo" data-pago inputmode="decimal" autocomplete="off" placeholder="@Formato.Dinero(aCobrar)"
                                       @bind="_pagoCon" @bind:event="oninput" @onkeydown="AlTeclearPago" @onfocus="() => _enPago = true" @onblur="() => _enPago = false" />
                            }
                            else if (FormasQueFaltan.Any())
                            {
                                <div class="vn-pago-cab"><span class="nota">Otra forma</span>@FormasDePago</div>
                            }
                            @if (ErrorDeLasFormas is { } errorFormas)
                            {
                                <div class="vn-vivo falta"><span>@errorFormas</span></div>
                            }
                            else if (aCobrar == 0)
                            {
                                <div class="vn-vivo"><span>Cubierto con @(_otras.Count == 1 ? "otra forma" : "otras formas")</span><strong>@Formato.Dinero(0)</strong></div>
                            }
                            else if (_pagoCon.Trim().Length > 0)
                            {
                                @if (PagoConCentavos is null)
                                {
                                    <div class="vn-vivo falta"><span>«@_pagoCon» no es una cantidad</span></div>
                                }
                                else if (Recibido >= aCobrar)
                                {
                                    <div class="vn-vivo"><span>Cambio</span><strong>@Formato.Dinero(Recibido - aCobrar)</strong></div>
                                }
                                else
                                {
                                    <div class="vn-vivo falta"><span>Faltan</span><strong>@Formato.Dinero(aCobrar - Recibido)</strong></div>
                                }
                            }
                            @if (ExcesoDeCredito > 0 && ConCredito)
                            {
                                <div class="vn-alerta">
                                    <Ico Nombre="candado" />
                                    <div><span>Pasa su límite de crédito por <strong>@Formato.Dinero(ExcesoDeCredito)</strong>@AutorizaExceso</span></div>
                                </div>
                            }
                            @if (_avisoDelCobro is { } avisoCobro)
                            {
                                <div class="vn-alerta">
                                    <Ico Nombre="escaner" />
                                    <div><span>@avisoCobro</span></div>
                                </div>
                            }
                            <button id="cobrar-nuevo" class="vn-cobrar" disabled="@(_cobrando || ErrorDelCobro is not null)" @onclick="CobrarEnPanelAsync"
                                    @onfocus="() => _enPago = true" @onblur="() => _enPago = false">@EtiquetaDeCobrar</button>
                        }
                    </div>
                    @if (Retiro is { } efectivoN)
                    {
                        <div class="vn-alerta">
                            <Ico Nombre="efectivo" />
                            <div>
                                <span>Hay <strong>@Formato.Dinero(efectivoN.EsperadoCentavos)</strong> en efectivo y el límite es @Formato.Dinero(efectivoN.LimiteCentavos ?? 0): haz un retiro.</span>
                                @if (Ve(AccionControlada.SalidaEfectivo))
                                {
                                    <span><button class="vn-boton chico" @onclick="() => Abrir(Ventanas.Salida)">Retiro <kbd>F8</kbd></button></span>
                                }
                            </div>
                        </div>
                    }
                    <div class="vn-ultimo">
                        @if (_ultimo is { } ultimo)
                        {
                            <span>Último: <strong>@ultimo.FolioImpreso</strong> · @Formato.Dinero(ultimo.TotalCobradoCentavos) · cambio <strong>@Formato.Dinero(ultimo.CambioCentavos)</strong></span>
                        }
                        else
                        {
                            <span>Todavía no hay ventas en este turno.</span>
                        }
                        @if (Ve(AccionControlada.Reimprimir))
                        {
                            <button class="vn-enlace" @onclick="ReimprimirUltimoAsync">Reimprimir</button>
                        }
                    </div>
                }
            </aside>
        </div>

        @* Lo de todos los días; lo demás, en «/» (docs/propuesta-interfaz.md, «La pantalla de venta»). Cada botón hace lo
           que su tecla, también con un panel abierto: el suyo lo cierra y otro lo cambia. *@
        <footer class="vn-teclas">
            <button @onclick="@(() => ComoSuTecla("F12"))"><kbd>F12</kbd>Cobrar</button>
            <button @onclick="@(() => ComoSuTecla("F10"))"><kbd>F10</kbd>Buscar</button>
            <button @onclick="@(() => ComoSuTecla("F9"))"><kbd>F9</kbd>Verificar</button>
            <button @onclick="@(() => ComoSuTecla("F2"))"><kbd>F2</kbd>Impresiones</button>
            @if (Ve(AccionControlada.ArticuloComun))
            {
                <button @onclick="@(() => ComoSuTecla("Insert"))"><kbd>Ins</kbd>Art. común</button>
            }
            <button @onclick="@(() => ComoSuTecla("Ctrl+L"))"><kbd>Ctrl+L</kbd>Cliente</button>
            @if (Ve(AccionControlada.EntradaEfectivo))
            {
                <button @onclick="@(() => ComoSuTecla("F7"))"><kbd>F7</kbd>Entrada</button>
            }
            @if (Ve(AccionControlada.SalidaEfectivo))
            {
                <button @onclick="@(() => ComoSuTecla("F8"))"><kbd>F8</kbd>Salida</button>
            }
            <button @onclick="@(() => ComoSuTecla("F6"))"><kbd>F6</kbd>En espera</button>
            <button @onclick="AbrirAccionesAsync"><kbd>/</kbd>Más acciones</button>
            @* Ctrl+Q (o «Cotizar un PDF» en «/») abre el selector de archivos de aquí. *@
            <InputFile id="pdf-cotizar" class="oculto" accept=".pdf,application/pdf" onclick="this.value = ''" OnChange="PdfElegidoAsync" />
            <span class="espacio"></span>
            @if (HayConteoPendiente)
            {
                <button class="vn-chip-estado" title="Los productos que hay que contar hoy" @onclick="() => Abrir(Ventanas.Conteo)">
                    <Ico Nombre="contar" />Conteo del día @_conteo!.Contados/@_conteo.Total
                </button>
            }
        </footer>
    </div>
}
else
{
<div class="venta">
    <header class="barra-modulos">
        <button class="modulo activo">F1 Ventas</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Productos)">F3 Productos</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Inventario)">F4 Inventario</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Clientes)">Clientes</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Configuracion)">Configuración</button>
        <button class="modulo" @onclick="() => Abrir(Ventanas.Corte)">Corte</button>
        <span class="espacio"></span>
        <button class="modulo" title="La pantalla del rediseño, con la que se entra en todas las cajas; esta PC deja de recordar la de hoy" @onclick="CambiarPantallaAsync">Probar la pantalla nueva</button>
        <div class="atiende">
            <small>Le atiende:</small>
            <strong>@Sesion.Nombre</strong>
            <small>@Caja.Sucursal · @Caja.Nombre · turno desde @Turno.AbiertoLocal.ToString("HH:mm")</small>
        </div>
        <button class="modulo" @onclick="AlSalir">Salir</button>
    </header>

    @if (HayConteoPendiente)
    {
        @FranjaConteo
    }
    <div class="titulo-venta">
        VENTA - Ticket @Actual.Numero
        @if (Actual.Cliente is { } delTicket)
        {
            <span class="cliente-ticket">Cliente: @delTicket.Nombre@(delTicket.TextoPrivilegios() is { Length: > 0 } privilegios ? $" · {privilegios}" : "")</span>
        }
    </div>
    @if (Actual.Cliente is not null && Actual.Cuenta is { SaldoCentavos: not 0 })
    {
        @FranjaCredito
    }

    <div class="captura">
        <label for="codigo">Código del producto:</label>
        <input id="codigo" data-codigo autocomplete="off" @bind="_captura.Texto" @bind:event="oninput" @onkeydown="AlTeclearCodigo" />
        <button class="boton" @onclick="AgregarCodigoAsync">ENTER - Agregar producto</button>
    </div>
    <div class="botones-venta">
        <button class="boton" @onclick="() => Abrir(Ventanas.Comun)">INS Varios</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Comun)">CTRL+P Art. común</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Buscar)">F10 Buscar</button>
        <button class="boton" title="Las escalas de mayoreo del producto seleccionado" @onclick="MayoreoAsync">F11 Mayoreo</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Entrada)">F7 Entradas</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Salida)">F8 Salidas</button>
        <button class="boton" @onclick="BorrarSeleccion">DEL Borrar art.</button>
        <button class="boton" @onclick="AbrirCambioPrecio">CTRL+E Cambiar precio</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Descuento)">CTRL+D Descuento</button>
        <button class="boton" title="El cliente registrado del ticket, por nombre o teléfono" @onclick="() => Abrir(Ventanas.ElegirCliente)">CTRL+L Cliente</button>
        @if (!_pilotoEleventa)
        {
            <button class="boton" title="Un abono a la cuenta de un cliente" @onclick="() => Abrir(Ventanas.Abono)">CTRL+B Abono</button>
        }
        <button class="boton" @onclick="() => Abrir(Ventanas.Verificador)">F9 Verificador</button>
        <button class="boton" @onclick="() => Abrir(Ventanas.Impresiones)">F2 Impresiones</button>
        @* Cotizar a un botón: la etiqueta abre el selector de archivos; al elegir el PDF se abre la cotización. *@
        <label class="boton" for="pdf-cotizar" title="Elige un PDF y te dice cuánto cobrar">CTRL+Q Cotizar PDF</label>
        <InputFile id="pdf-cotizar" class="oculto" accept=".pdf,application/pdf" onclick="this.value = ''" OnChange="PdfElegidoAsync" />
    </div>

    <nav class="pestanas">
        @foreach (var t in _tickets)
        {
            <button class="pestana @(t == Actual ? "activa" : "")" @onclick="() => Cambiar(t)">
                Ticket @t.Numero @(t.Venta.Lineas.Count > 0 && t != Actual ? $"({Formato.Dinero(t.Venta.TotalCentavos)})" : "")
            </button>
        }
    </nav>

    <div class="tabla-venta">
        <table>
            <thead>
                <tr>
                    <th class="col-codigo">Código de barras</th>
                    <th>Descripción del producto</th>
                    <th class="num">Precio venta</th>
                    <th class="num col-cant">Cant.</th>
                    <th class="num">Importe</th>
                    <th class="num">Existencia</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Actual.Venta.Lineas.Count; i++)
                {
                    var indice = i;
                    var linea = Actual.Venta.Lineas[i];
                    var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
                    <tr id="linea-@i" class="@(i == _seleccion ? "seleccionada" : "")" @onclick="() => Seleccionar(indice)">
                        <td class="col-codigo">@(producto?.Codigo ?? "—")</td>
                        <td>
                            @(linea.EsImpresiones ? $"Impresiones ({Actual.Impresiones.Count})" : Descripcion(linea, producto))
                            @if (linea.TieneMayoreo)
                            {
                                <small class="descuento">@MayoreoTexto(linea, producto) · ahorra @Formato.Dinero(linea.AhorroMayoreoCentavos)</small>
                            }
                            @if (linea.TieneDescuento)
                            {
                                <small class="descuento">Descuento @(linea.DescuentoCentesimas is { } c ? Permisos.TextoMonto(AccionControlada.Descuento, c) + " " : "")−@Formato.Dinero(linea.DescuentoCentavos) · @linea.MotivoDescuento</small>
                            }
                        </td>
                        <td class="num">
                            @if (linea.PrecioCambiado)
                            {
                                <s class="precio-original">@Formato.Dinero(linea.PrecioOriginalCentavos ?? 0)</s>
                            }
                            @Formato.Dinero(linea.PrecioCentavos)
                        </td>
                        <td class="num col-cant">@Formato.Numero(linea.Cantidad.EnUnidades)</td>
                        <td class="num">@Formato.Dinero(linea.ImporteCentavos)</td>
                        <td class="num">@(producto?.Existencia is { } e ? Formato.Numero(e) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Actual.Venta.Lineas.Count == 0)
        {
            <p class="vacia">Escanea un producto o escribe su código. F10 para buscar por nombre.</p>
        }
    </div>

    @if (Retiro is { } efectivo)
    {
        <div class="mensaje retiro">Hay @Formato.Dinero(efectivo.EsperadoCentavos) en efectivo y el límite es @Formato.Dinero(efectivo.LimiteCentavos ?? 0): haz un retiro con F8.</div>
    }
    @if (_mensaje is not null)
    {
        <div class="mensaje @(_mensajeEsError ? "error" : "")">
            @_mensaje
            @if (_codigoNuevo is { } nuevo && _mensaje is not null)
            {
                <button class="boton chico" @onclick="() => Abrir(Ventanas.AltaRapida)">Dar de alta «@nuevo»</button>
            }
        </div>
    }

    <footer class="pie-venta">
        <div class="pie-izquierda">
            <div class="conteo"><span class="numero">@Formato.Numero(Actual.Venta.NumeroDeArticulos)</span> Productos en la venta actual.</div>
            <div class="botones-pie">
                <button class="boton" @onclick="CambiarSiguiente">F5 - Cambiar</button>
                <button class="boton" @onclick="NuevoTicket">F6 - Pendiente</button>
                <button class="boton" @onclick="EliminarTicket">Eliminar</button>
            </div>
            <div class="ultima">
                <div><small>Total:</small> <strong>@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.TotalCobradoCentavos))</strong></div>
                <div><small>Pagó con:</small> <strong>@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.PagoConCentavos))</strong></div>
                <div><small>Cambio:</small> <strong class="cambio">@(_ultimo is null ? "$0.00" : Formato.Dinero(_ultimo.CambioCentavos))</strong></div>
            </div>
        </div>
        <div class="pie-derecha">
            <div class="cobro">
                <button class="boton cobrar" disabled="@(Actual.Venta.Lineas.Count == 0)" @onclick="() => AbrirCobroAsync()">F12 - Cobrar</button>
                <div class="total">@Formato.Dinero(Actual.Venta.TotalCentavos)</div>
                @if (Actual.Venta.Lineas.Count > 0 && Actual.Venta.Efectivo(0) is { RedondeoCentavos: not 0 } enEfectivo)
                {
                    <div class="total-efectivo">En efectivo: @Formato.Dinero(enEfectivo.ACobrarCentavos)</div>
                }
                @if (Actual.Venta.DescuentoCentavos > 0)
                {
                    <div class="descuento-total">Descuento: −@Formato.Dinero(Actual.Venta.DescuentoCentavos)</div>
                }
            </div>
            <div class="botones-pie">
                <button class="boton" @onclick="ReimprimirUltimoAsync">Reimprimir último ticket</button>
                <button class="boton" @onclick="() => Abrir(Ventanas.VentasDelDia)">Ventas del día</button>
                <button class="boton" @onclick="() => AbrirDevolucion(null)">Devoluciones</button>
                <button class="boton" @onclick="() => Abrir(Ventanas.Transferencias)">Transferencias</button>
            </div>
        </div>
    </footer>
</div>
}

@if (!VaEnPanel)
{
    <CascadingValue Name="PermisosDeSesion" Value="PermisosEnCascada">@ContenidoDeVentana</CascadingValue>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;
    [Parameter] public EventCallback AlSalir { get; set; }
    [Parameter] public EventCallback AlCerrarTurno { get; set; }

    private enum Ventanas
    {
        Ninguna, Cobrar, Buscar, Comun, Entrada, Salida, Verificador, Corte, VentasDelDia, VistaPrevia, Configuracion, Motivo, Devolucion,
        CambiarPrecio, Transferencias, Impresiones, Cotizar, Descuento, Productos, AltaRapida, Inventario, Conteo, Mayoreo, ElegirCliente, Clientes,
        AutorizarCosto, Abono, AutorizarCredito,
    }

    /// <summary>
    /// Lo de la venta que en la pantalla nueva va como panel a la derecha (docs/propuesta-interfaz.md, «Los demás
    /// paneles»): el ticket queda a la vista. Los módulos de arriba (productos, inventario, clientes, corte,
    /// configuración) y el conteo siguen encima.
    /// </summary>
    private static readonly HashSet<Ventanas> VentanasEnPanel =
    [
        Ventanas.Cobrar, Ventanas.AutorizarCosto, Ventanas.Comun, Ventanas.Entrada, Ventanas.Salida, Ventanas.Mayoreo, Ventanas.Verificador,
        Ventanas.VentasDelDia, Ventanas.Devolucion, Ventanas.CambiarPrecio, Ventanas.Impresiones, Ventanas.AltaRapida, Ventanas.Descuento,
        Ventanas.ElegirCliente, Ventanas.Abono, Ventanas.Cotizar, Ventanas.Motivo, Ventanas.VistaPrevia, Ventanas.Transferencias,
        Ventanas.AutorizarCredito,
    ];

    private bool VaEnPanel => _pantallaNueva && VentanasEnPanel.Contains(_ventana);

    /// <summary>
    /// Los paneles que se dejan con la tecla de otra cosa (F12, Ctrl+L, F6…) sin perder nada: solo enseñan algo, o lo que
    /// tienen a medias no va a la venta ni al cajón (el verificador, el mayoreo, las ventas del día, el ticket en pantalla,
    /// el cliente, cotizar y las transferencias). Los demás tienen campos que van a la venta o al cajón (artículo común, descuento, precio,
    /// entrada y salida, abono, devolución, alta rápida, impresiones por cobrar, el motivo de la reimpresión): se terminan
    /// con Enter o se cierran con Esc o con su misma tecla, como dice la propuesta («Cada uno con sus campos y Enter para
    /// terminar»). Con otra tecla lo escrito se perdería sin decirlo y, con F12, se cobraría sin ello: Ins, «Engargolado»
    /// $35 y F12 por costumbre en lugar de Enter dejaría el cursor en «Pagó con» con el total de antes. Un panel nuevo no
    /// se deja hasta agregarlo aquí.
    /// </summary>
    private static readonly HashSet<Ventanas> PanelesQueSeDejan =
    [
        Ventanas.Verificador, Ventanas.Mayoreo, Ventanas.VentasDelDia, Ventanas.VistaPrevia, Ventanas.ElegirCliente, Ventanas.Cotizar,
        Ventanas.Transferencias,
    ];

    private bool PanelQueSeDeja => VaEnPanel && PanelesQueSeDejan.Contains(_ventana);

    /// <summary>Por qué el panel abierto no se deja con otra tecla ni con «/ Más acciones»; null si se deja o no hay panel.</summary>
    private string? PorQueNoSeDeja =>
        !VaEnPanel || PanelQueSeDeja ? null
        // Fiar arriba del límite o vender debajo del costo: el cobro está a medias y espera el PIN de quien autoriza. Con
        // otra tecla se quedaría a medias sin decirlo.
        : _ventana is Ventanas.AutorizarCosto or Ventanas.AutorizarCredito ? "El cobro espera la autorización: que la den aquí, o Esc para regresar a la venta."
        // Con campos (artículo común, descuento, entrada…): ver PanelesQueSeDejan.
        : "Primero termina aquí con Enter (o su botón), o Esc para regresar a la venta.";

    /// <summary>Le dice a caja.js que hay una ventana abierta y si es un panel (con él a la vista, Ins y Ctrl+Q también son de la venta).</summary>
    private Task AvisarVentanaAbiertaAsync() => Js.VentanaAbiertaAsync(true, VaEnPanel);

    /// <summary>
    /// Por qué una tecla no hizo nada con el panel abierto. Va en el panel, donde se está mirando: el aviso de siempre
    /// sale bajo el cuadro de captura, a la izquierda.
    /// </summary>
    private string? _avisoDelPanel;

    /// <summary>F10 en la pantalla nueva: el cursor al cuadro, donde salen los resultados al escribir.</summary>
    private void Buscar()
    {
        _enfocar = "#codigo";
        Avisar("Escribe el nombre aquí: los resultados salen abajo, y con ↓ y Enter se agrega.", error: false);
    }

    /// <summary>El conteo cíclico de hoy: cuántos faltan, para pedirlo en la franja.</summary>
    private ConteoCiclicoDto? _conteo;

    private bool HayConteoPendiente => _conteo is { } conteo && conteo.Contados < conteo.Total;

    // ── Las franjas de arriba: las mismas en las dos pantallas ──────────────

    /// <summary>Se pide al abrir el turno; se cuenta cuando haya calma.</summary>
    private RenderFragment FranjaConteo => @<div class="franja-conteo">
        Conteo del día: faltan @(_conteo!.Total - _conteo.Contados) de @_conteo.Total productos por contar.
        <button class="boton chico" @onclick="() => Abrir(Ventanas.Conteo)">Contar ahora</button>
    </div>;

    /// <summary>Si el cliente del ticket debe, la caja lo dice al elegirlo, para cobrarlo en esta compra (fase 3).</summary>
    private RenderFragment FranjaCredito => @<div class="franja-credito @(VencidoDelTicket > 0 ? "vencido" : "")">
        @if (Actual.Cuenta!.SaldoCentavos > 0)
        {
            <span>@Actual.Cliente!.Nombre debe @Formato.Dinero(Actual.Cuenta.SaldoCentavos)@(Actual.Cuenta.VenceMasAntiguo is { } vence ? $" · vence {vence:dd/MM}" : "")@(VencidoDelTicket > 0 ? $" · vencido {Formato.Dinero(VencidoDelTicket)}" : "")@(Actual.Cuenta.Estimado ? " (según esta caja)" : "")</span>
            @if (!_pilotoEleventa)
            {
                <button class="boton chico" @onclick="() => Abrir(Ventanas.Abono)">CTRL+B Abonar</button>
            }
        }
        else if (_pilotoEleventa)
        {
            <span>@Actual.Cliente!.Nombre tiene @Formato.Dinero(Actual.Cuenta.AFavorCentavos) a favor: en el piloto con eleventa no se usa, solo se cobra en efectivo.</span>
        }
        else
        {
            <span>@Actual.Cliente!.Nombre tiene @Formato.Dinero(Actual.Cuenta.AFavorCentavos) a favor: se usa con «A crédito» al cobrar.</span>
        }
    </div>;

    private long VencidoDelTicket => Actual.Cuenta?.Vencido(DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow))) ?? 0;

    // ── La pantalla nueva (docs/propuesta-interfaz.md, entrega 0) ───────────

    /// <summary>
    /// Dónde recuerda el navegador de esta PC si se volvió a la pantalla de hoy. Solo se guarda eso
    /// (<see cref="PantallaDeHoy"/>): sin nada, o con el «nueva» que guardaba «Probar la pantalla nueva», se entra a la nueva.
    /// </summary>
    private const string ClavePantalla = "pantalla-venta";

    private const string PantallaDeHoy = "hoy";

    /// <summary>
    /// La nueva desde el primer dibujo, en todas las cajas, de prueba y de verdad (para la segunda prueba con una persona
    /// real, 17 y 18 de octubre de 2026: la de hoy no le gustó al dueño en la primera). Así, al entrar (también con
    /// Ctrl+U) no se asoma la de hoy ni sus teclas mientras se lee lo guardado.
    /// </summary>
    private bool _pantallaNueva = true;

    /// <summary>Lo que se enfoca después de dibujar (el cuadro del código, o «Pagó con» con F12).</summary>
    private string? _enfocar;

    private EstadoCaja? _estado;
    private bool _menuUsuario;

    private static string Inicial(string nombre) => nombre.Trim() is { Length: > 0 } n ? char.ToUpper(n[0], CultureInfo.CurrentCulture).ToString() : "?";

    private static string ArticulosTexto(Venta venta) =>
        venta.Lineas.Count == 0 ? "sin artículos" : venta.NumeroDeArticulos == 1 ? "1 artículo" : $"{Formato.Numero(venta.NumeroDeArticulos)} artículos";

    /// <summary>Con mayoreo (un precio por pieza desde más de una), la fila ofrece F11.</summary>
    private static bool TieneEscalas(ProductoVentaDto producto) => producto.Precios.Any(p => p.PresentacionId is null && p.CantidadMinimaMilesimas > 1000);

    /// <summary>Un botón de la fila hace lo mismo que su tecla; el cursor vuelve al cuadro si no se abrió una ventana.</summary>
    private async Task EnLaFilaAsync(Func<Task> hacer)
    {
        await hacer();
        if (_ventana == Ventanas.Ninguna)
            _enfocar = "#codigo";
    }

    // ── Lo que puede quien entró (docs/propuesta-interfaz.md, «Usuarios y permisos») ──

    /// <summary>
    /// Se piden al entrar, en una sola consulta, para pintar sin preguntar en cada clic. Sin ellos (sin conexión ni copia),
    /// todo se ve y el servicio decide al hacerlo, como hoy.
    /// </summary>
    private Dictionary<AccionControlada, PermisoDeSesion>? _permisos;

    /// <summary>
    /// Ya se pidieron, con respuesta o sin ella. Antes, lo que depende de ellos no se pinta (ni en «/»): sin ellos todo
    /// se ve, y el cajero vería un instante las pestañas del encargado.
    /// </summary>
    private bool _permisosPedidos;

    private PermisoDeSesion? Permiso(AccionControlada accion) => _permisos?.GetValueOrDefault(accion);

    /// <summary>Para la autorización: en la pantalla nueva se toca la ficha de quien autoriza (en la de hoy, se escribe su usuario).</summary>
    private IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? PermisosEnCascada => _pantallaNueva ? _permisos : null;

    /// <summary>Lo que no puede no aparece: ni botón, ni tecla, ni en «/», ni la pestaña. Mientras se piden, tampoco.</summary>
    private bool Ve(AccionControlada accion) => _permisosPedidos && Permiso(accion)?.Nivel != NivelPermiso.NoPermitido;

    /// <summary>
    /// La tecla de algo que no ve (<paramref name="ve"/> en false) solo avisa que no puede. Mientras se piden los permisos
    /// no se sabe: hace lo de siempre y el servicio decide, como sin ellos.
    /// </summary>
    private bool SinTecla(bool ve) => _pantallaNueva && _permisosPedidos && !ve;

    /// <summary>Las teclas de lo que tiene permiso: en la pantalla nueva, la de lo que no ve solo avisa.</summary>
    private bool SinTecla(string tecla) => tecla switch
    {
        "F3" => SinTecla(Ve(AccionControlada.EditarCatalogo)),
        "F4" => SinTecla(VeInventario),
        "Insert" or "Ctrl+P" => SinTecla(Ve(AccionControlada.ArticuloComun)),
        "F7" => SinTecla(Ve(AccionControlada.EntradaEfectivo)),
        "F8" => SinTecla(Ve(AccionControlada.SalidaEfectivo)),
        _ => false,
    };

    private bool VeInventario =>
        new[]
        {
            AccionControlada.RecibirMercancia, AccionControlada.ContarInventario, AccionControlada.ConteoCompleto, AccionControlada.Merma,
            AccionControlada.AjustarInventario, AccionControlada.AbrirPaquete, AccionControlada.CostearCompra, AccionControlada.PedirCompra,
        }.Any(Ve);

    /// <summary>La caja de prueba se actualiza desde Configuración: ahí la ve cualquiera.</summary>
    private bool VeConfiguracion =>
        Servicios.GetService<GitHubPrueba>() is not null
        || new[]
        {
            AccionControlada.ConfigurarTicket, AccionControlada.EditarReglas, AccionControlada.ConsultarBitacora, AccionControlada.AdministrarCajas,
            AccionControlada.ConfigurarTelegram, AccionControlada.ConfigurarImpresora, AccionControlada.ConfigurarMargen,
        }.Any(Ve);

    private async Task CargarPermisosAsync()
    {
        try
        {
            _permisos = (await Cliente.PermisosDeSesionAsync(Sesion.UsuarioId, Caja.SucursalId)).ToDictionary(p => p.Accion);
        }
        catch (ErrorCaja)
        {
            // Sin conexión y sin copia: todo se ve, como hoy.
        }
        _permisosPedidos = true;
    }

    // ── El piloto con eleventa: solo efectivo y el corte allá (se quita al dejar eleventa) ──

    /// <summary>
    /// El servicio manda las ventas a eleventa: solo se cobra y se devuelve en efectivo, y el corte se hace en eleventa
    /// (decisión del dueño, 2026-10-12). Las ventanas lo reciben en cascada (<see cref="PilotoConEleventa.Cascada"/>).
    /// Cambia con la configuración del servicio: se pregunta al entrar y, en la ventana de Windows, la contingencia lo
    /// vuelve a saber en cada latido, así que si el servicio se reinicia con otra configuración la pantalla cambia sin
    /// salir de ella. En el navegador no hay contingencia, pero al reiniciarse el servicio la pantalla se vuelve a cargar.
    /// </summary>
    private bool _pilotoEleventa;

    private Contingencia? _contingencia;

    private async Task CargarPilotoEleventaAsync()
    {
        _contingencia = Servicios.GetService<Contingencia>();
        if (_contingencia is not null)
            _contingencia.Cambio += AlCambiarContingencia;
        try
        {
            _pilotoEleventa = await Cliente.PilotoEleventaAsync();
        }
        catch (ErrorCaja)
        {
            // Sin conexión y sin contingencia (el navegador): no se puede cobrar de ninguna forma; el servicio lo revisa.
        }
    }

    /// <summary>La contingencia avisa de muchas cosas: solo se vuelve a pintar si cambió el piloto.</summary>
    private void AlCambiarContingencia()
    {
        if (_contingencia is { } contingencia && contingencia.PilotoEleventa != _pilotoEleventa)
            _ = InvokeAsync(() =>
            {
                _pilotoEleventa = contingencia.PilotoEleventa;
                StateHasChanged();
            });
    }

    private static string Quien(PermisoDeSesion permiso) => Textos.Quien(permiso.Autorizan);

    /// <summary>En «/»: «Lo autoriza Luis», o «Tú: hasta 10 %; más, lo autoriza Carmen o Luis».</summary>
    private string? DetallePermiso(AccionControlada accion) => Permiso(accion) switch
    {
        { Nivel: NivelPermiso.RequiereAutorizacion } p => $"Lo autoriza {Quien(p)}",
        { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral } p => $"Tú: hasta {Permisos.TextoMonto(accion, umbral)}; más, lo autoriza {Quien(p)}",
        _ => null,
    };

    /// <summary>La tecla, o el candado con quién autoriza.</summary>
    private RenderFragment Marca(AccionControlada accion, string tecla) => Permiso(accion) is { Nivel: NivelPermiso.RequiereAutorizacion } p
        ? @<small class="vn-candado" title="Lo autoriza @Quien(p)"><Ico Nombre="candado" />@Quien(p)</small>
        : @<kbd>@tecla</kbd>;

    private RenderFragment Limite(AccionControlada accion) => Permiso(accion) is { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral }
        ? @<small class="vn-limite">hasta @Permisos.TextoMonto(accion, umbral)</small>
        : _ => { };

    // ── «/»: todas las acciones de quien entró ──────────────────────────────

    private sealed record AccionDeVenta(string Nombre, string Icono, string? Tecla, AccionControlada? Regla, Func<Task> Hacer);

    /// <summary>Lo que sale al escribir «/»; null: la lista está cerrada.</summary>
    private List<AccionDeVenta>? _accionesVistas;

    private string _textoAcciones = "";
    private int _indiceAccion;

    private IEnumerable<AccionDeVenta> TodasLasAcciones()
    {
        yield return new("Cobrar", "efectivo", "F12", null, IrAlCobroAsync);
        yield return new("Buscar producto por nombre", "buscar", "F10", null, () =>
        {
            Buscar();
            return Task.CompletedTask;
        });
        yield return new("Verificar precio sin vender", "ojo", "F9", null, () => Abrir(Ventanas.Verificador));
        yield return new("Impresiones por cobrar", "impresora", "F2", null, () => Abrir(Ventanas.Impresiones));
        yield return new("Artículo común (sin inventario)", "etiqueta", "Ins", AccionControlada.ArticuloComun, () => Abrir(Ventanas.Comun));
        yield return new("Elegir cliente del ticket", "clientes", "Ctrl+L", null, () => Abrir(Ventanas.ElegirCliente));
        if (!_pilotoEleventa)
            yield return new("Abono a la cuenta de un cliente", "efectivo", "Ctrl+B", null, () => Abrir(Ventanas.Abono));
        yield return new("Cambiar precio del artículo", "etiqueta", "Ctrl+E", AccionControlada.CambiarPrecio, AbrirCambioPrecio);
        yield return new("Descuento", "porcentaje", "Ctrl+D", AccionControlada.Descuento, () => Abrir(Ventanas.Descuento));
        yield return new("Ver el mayoreo del artículo", "capas", "F11", null, MayoreoAsync);
        yield return new("Quitar el artículo", "basura", "Supr", AccionControlada.QuitarProducto, BorrarSeleccion);
        yield return new("Poner el ticket en espera", "pausa", "F6", null, () =>
        {
            PonerEnEspera();
            return Task.CompletedTask;
        });
        yield return new("Retomar un ticket en espera", "ticket", "F5", null, () =>
        {
            RetomarPrimero();
            return Task.CompletedTask;
        });
        yield return new("Entrada de efectivo", "entrada", "F7", AccionControlada.EntradaEfectivo, () => Abrir(Ventanas.Entrada));
        yield return new("Salida de efectivo", "salida", "F8", AccionControlada.SalidaEfectivo, () => Abrir(Ventanas.Salida));
        yield return new("Devolver o cancelar un ticket", "volver", "folio", AccionControlada.Devolucion, () => AbrirDevolucion(null));
        yield return new("Reimprimir el último ticket", "impresora", null, AccionControlada.Reimprimir, ReimprimirUltimoAsync);
        yield return new("Ventas del día", "lista", null, null, () => Abrir(Ventanas.VentasDelDia));
        yield return new("Cotizar un PDF", "impresora", "Ctrl+Q", null, () => Js.ClicAsync("#pdf-cotizar"));
        yield return new("Verificar transferencias", "check", null, AccionControlada.VerificarTransferencia, () => Abrir(Ventanas.Transferencias));
        yield return new("Corte", "contar", null, null, () => Abrir(Ventanas.Corte));
        yield return new("Conteo del día", "contar", null, AccionControlada.ContarInventario, () => Abrir(Ventanas.Conteo));
        yield return new("Productos", "cajas", "F3", AccionControlada.EditarCatalogo, () => Abrir(Ventanas.Productos));
        if (VeInventario)
            yield return new("Inventario: recibir, contar y mermas", "recibir", "F4", null, () => Abrir(Ventanas.Inventario));
        // Para todos, como la pestaña: quien no los administra solo los consulta.
        yield return new("Clientes", "clientes", null, null, () => Abrir(Ventanas.Clientes));
        if (VeConfiguracion)
            yield return new("Configuración", "engrane", null, null, () => Abrir(Ventanas.Configuracion));
        yield return new("Cambiar de usuario", "usuario", "Ctrl+U", null, () => AlSalir.InvokeAsync());
        // «Volver a la pantalla de hoy» no va aquí: solo en el menú del usuario.
    }

    /// <summary>Las que puede (lo que no, no sale) y se llaman como lo escrito después de «/», sin acentos.</summary>
    private void MostrarAcciones(string filtro)
    {
        var buscado = Texto.Normalizar(filtro);
        _accionesVistas = TodasLasAcciones()
            .Where(a => a.Regla is not { } regla || Ve(regla))
            .Where(a => buscado.Length == 0 || Texto.Normalizar(a.Nombre).Contains(buscado, StringComparison.Ordinal))
            .ToList();
        (_textoAcciones, _indiceAccion) = (filtro, 0);
    }

    private void CerrarAcciones() => _accionesVistas = null;

    private void MoverAccion(int paso)
    {
        if (_accionesVistas is not { Count: > 0 } acciones)
            return;
        _indiceAccion = Math.Clamp(_indiceAccion + paso, 0, acciones.Count - 1);
        _ = Js.MostrarAsync($"#acc-{_indiceAccion}");
    }

    /// <summary>«/ Más acciones» en la barra de teclas: el «/» queda en el cuadro y la lista abierta.</summary>
    private async Task AbrirAccionesAsync()
    {
        // Con un panel abierto, se cierra: la lista y su Enter son del cuadro de captura. Si espera su Enter (o una
        // autorización), lo dice, como con las teclas.
        if (PorQueNoSeDeja is { } espera)
        {
            AvisarEnElPanel(espera);
            return;
        }
        if (_ventana != Ventanas.Ninguna)
            await Cerrar();
        CerrarResultados();
        _captura.Texto = "/";
        await Js.EscribirCapturaAsync("/");
        MostrarAcciones("");
    }

    private async Task HacerAccionAsync(int indice)
    {
        if (_accionesVistas is not { } acciones || indice < 0 || indice >= acciones.Count)
            return;
        var accion = acciones[indice];
        CerrarAcciones();
        VaciarCaptura();
        _enfocar = "#codigo";
        await accion.Hacer();
        // Si abrió una ventana, el cursor se queda en ella.
        if (_ventana != Ventanas.Ninguna)
            _enfocar = null;
    }

    /// <summary>Enter con «/algo»: la elegida con ↑ ↓, o la primera que se llama así.</summary>
    private async Task HacerAccionDeTextoAsync(string filtro)
    {
        if (_accionesVistas is null || filtro != _textoAcciones)
            MostrarAcciones(filtro);
        if (_accionesVistas is { Count: > 0 })
            await HacerAccionAsync(_indiceAccion);
        else
        {
            CerrarAcciones();
            Avisar($"Ninguna acción se llama «{filtro}».");
        }
    }

    /// <summary>Lo que se escribió después de «/», o null si no empieza con «/».</summary>
    private static string? FiltroDeAcciones(string texto) => texto.TrimStart() is ['/', .. var resto] ? resto.Trim() : null;

    /// <summary>«Volver a la pantalla de hoy» (en el menú del usuario) y «Probar la pantalla nueva» (en la de hoy).</summary>
    private async Task CambiarPantallaAsync()
    {
        _pantallaNueva = !_pantallaNueva;
        _menuUsuario = false;
        // Lo abierto pasa de panel a ventana encima (o al revés): caja.js lo sabe.
        if (_ventana != Ventanas.Ninguna)
            await AvisarVentanaAbiertaAsync();
        // El cuadro de la otra pantalla empieza vacío.
        _captura.Texto = "";
        await Js.GuardarAsync(ClavePantalla, _pantallaNueva ? null : PantallaDeHoy);
        if (_pantallaNueva && _rapidos.Count == 0)
            await CargarRapidosAsync();
        _enfocar = "#codigo";
    }

    /// <summary>Un rápido con el producto al que apunta (para su precio); sin conexión al cargar, el producto se pide al usarlo.</summary>
    private sealed record RapidoListo(Rapido Rapido, ProductoVentaDto? Producto, long? PrecioCentavos);

    private List<RapidoListo> _rapidos = [];

    private async Task CargarRapidosAsync()
    {
        try
        {
            var listos = new List<RapidoListo>();
            foreach (var rapido in (await Cliente.RapidosAsync(Caja.SucursalId)).Take(Rapido.Maximo))
            {
                var producto = await Cliente.PorVarianteAsync(rapido.VarianteId, Caja.SucursalId);
                listos.Add(new RapidoListo(rapido, producto, producto is null ? null : PrecioDelRapido(rapido, producto, Caja.SucursalId)));
            }
            _rapidos = listos;
        }
        catch (ErrorCaja)
        {
            // Sin conexión, la fila queda sin rápidos; al volver a entrar se cargan.
            _rapidos = [];
        }
    }

    /// <summary>
    /// Lo que dice la fila de rápidos: el precio por pieza de menudeo (el de la sucursal si tiene, si no el general) por la
    /// cantidad del rápido. Público para que las pruebas revisen los de la base de la prueba con la misma cuenta.
    /// </summary>
    public static long PrecioDelRapido(Rapido rapido, ProductoVentaDto producto, Guid sucursalId)
    {
        var porUnidad = producto.Precios.Where(p => p.PresentacionId is null).ToList();
        var deSucursal = porUnidad.Where(p => p.SucursalId == sucursalId).ToList();
        var menudeo = (deSucursal.Count > 0 ? deSucursal : porUnidad.Where(p => p.SucursalId is null)).MinBy(p => p.CantidadMinimaMilesimas)?.PrecioCentavos ?? 0;
        return (long)Math.Round(menudeo * rapido.Cantidad);
    }

    /// <summary>Alt+1 a Alt+6 o el botón. Un número en el cuadro es cuántos: «20» y Alt+1 son veinte copias.</summary>
    private async Task RapidoAsync(int indice)
    {
        if (indice < 0 || indice >= _rapidos.Count)
            return;
        var (rapido, producto, _) = _rapidos[indice];
        var texto = _captura.Texto.Trim();
        var veces = 1m;
        if (texto.Length > 0 && (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out veces) || veces <= 0))
        {
            Avisar($"Antes de un rápido solo va la cantidad: «{texto}» no lo es.");
            return;
        }
        VaciarCaptura();
        _enfocar = "#codigo";
        // En la cola, como un escaneo: en orden con ellos, y no cae en un ticket que se está cobrando.
        await _captura.EnTurnoAsync(async () =>
        {
            try
            {
                producto ??= await Cliente.PorVarianteAsync(rapido.VarianteId, Caja.SucursalId);
            }
            catch (ErrorCaja ex)
            {
                Avisar(ex.Message);
                return;
            }
            if (producto is null)
            {
                Avisar($"El producto del rápido «{rapido.Nombre}» ya no está en el catálogo: hay que elegirlo otra vez en Configuración.");
                return;
            }
            Agregar(producto, null, Cantidad.Unidades(Math.Round(veces * rapido.Cantidad, 3)));
        });
    }

    /// <summary>Los tickets en espera: los que tienen algo y no son el que se atiende, en el orden en que se apartaron.</summary>
    private IEnumerable<TicketAbierto> EnEspera => _tickets.Where(t => t != Actual && t.Venta.Lineas.Count > 0);

    /// <summary>Cuántos se ven como ficha junto a «Poner en espera»; los demás van en «Más».</summary>
    private const int FichasEnEspera = 3;

    /// <summary>Con más de estos en «Más», el menú lleva flechas arriba y abajo.</summary>
    private const int FilasDelMenu = 5;

    private bool _menuEspera;

    private static string Desde(TicketAbierto ticket) => HoraMexico.ALocal(ticket.Venta.CreadaUtc).ToString("HH:mm");

    private static string TituloEspera(TicketAbierto ticket, bool primero) =>
        $"En espera desde las {Desde(ticket)}, {ArticulosTexto(ticket.Venta)}. Retomar{(primero ? " (F5)" : "")}: el ticket actual pasa a la espera";

    /// <summary>F6: guarda este ticket y deja la caja lista para el siguiente cliente.</summary>
    private void PonerEnEspera()
    {
        if (Actual.Venta.Lineas.Count == 0)
        {
            Avisar("El ticket está vacío: no hay nada que poner en espera.", error: false);
            return;
        }
        NuevoTicket();
        Avisar("Ticket en espera. Atiende al siguiente; lo retomas arriba o con F5.", error: false);
    }

    /// <summary>Retomar un ticket en espera: el que se atendía pasa a la espera (si estaba vacío, se descarta).</summary>
    private void Retomar(TicketAbierto ticket)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        _cobrado = null;
        _menuEspera = false;
        if (Actual.Venta.Lineas.Count == 0 && Actual != ticket)
            _tickets.Remove(Actual);
        Cambiar(ticket);
        _enfocar = "#codigo";
        Avisar($"Retomaste el ticket de las {Desde(ticket)}.", error: false);
    }

    /// <summary>F5: el que lleva más tiempo esperando.</summary>
    private void RetomarPrimero()
    {
        if (EnEspera.FirstOrDefault() is { } ticket)
            Retomar(ticket);
        else
            Avisar("No hay tickets en espera.", error: false);
    }

    /// <summary>Los botones − y + de la fila: cambian la cantidad de ese renglón.</summary>
    private async Task PasoCantidadAsync(int indice, int paso)
    {
        _seleccion = indice;
        await CambiarCantidadSeleccion(paso);
        _enfocar = "#codigo";
    }

    // ── El cobro en el panel: «Pagó con» siempre a la vista ─────────────────

    /// <summary>Lo que dio el cliente. Vacío: se cobra exacto (el exacto se ve en gris en el cuadro).</summary>
    private string _pagoCon = "";

    private bool _enPago;
    private bool _cobrando;

    /// <summary>Tarjeta, transferencia o crédito en el panel del total: cada una en su renglón.</summary>
    private sealed class OtraForma(FormaPago forma, string monto)
    {
        public FormaPago Forma { get; } = forma;
        public string Monto { get; set; } = monto;
        public string Referencia { get; set; } = "";

        /// <summary>Vacío cuenta como cero; lo que no es una cantidad, null.</summary>
        public long? Centavos => Monto.Trim().Length == 0 ? 0 : Formato.LeerPesos(Monto);
    }

    private readonly List<OtraForma> _otras = [];

    /// <summary>Lo que va con tarjeta, transferencia y crédito: no da cambio.</summary>
    private long Otros => _otras.Sum(o => o.Centavos ?? 0);

    private long CreditoDelPanel => _otras.Where(o => o.Forma == FormaPago.Credito).Sum(o => o.Centavos ?? 0);

    /// <summary>Lo que falta en efectivo después de las otras formas, al peso.</summary>
    private EfectivoACobrar EnEfectivo => Actual.Venta.Efectivo(Otros);

    private long? PagoConCentavos => _pagoCon.Trim().Length == 0 ? EnEfectivo.ACobrarCentavos : Formato.LeerPesos(_pagoCon);

    private long Recibido => PagoConCentavos ?? 0;

    /// <summary>Lo que el cobro tiene que decir en el panel, donde está el cajero (lo de la izquierda se apaga al cobrar).</summary>
    private string? _avisoDelCobro;

    /// <summary>Con crédito, o con saldo a favor que se puede usar. Lo dice la cuenta (igual que el servicio), no el cliente.</summary>
    private bool PuedeFiar => Actual.Cliente is not null && Actual.Cuenta is { } cuenta && (cuenta.LimiteCentavos > 0 || cuenta.AFavorCentavos > 0);

    private bool ConCredito => Actual.Cliente is not null && Actual.Cuenta is { LimiteCentavos: > 0 };

    private long ExcesoDeCredito => PuedeFiar ? Actual.Cuenta!.Exceso(CreditoDelPanel) : 0;

    private void LimpiarCobro()
    {
        _pagoCon = "";
        _otras.Clear();
        _enPago = false;
        _avisoDelCobro = null;
    }

    /// <summary>
    /// Las otras formas que todavía no tienen renglón: una de cada una; el crédito, solo con quien puede fiar. En el piloto
    /// con eleventa, ninguna: solo efectivo.
    /// </summary>
    private IEnumerable<FormaPago> FormasQueFaltan =>
        new[] { FormaPago.Tarjeta, FormaPago.Transferencia, FormaPago.Credito }
            .Where(_ => !_pilotoEleventa)
            .Where(f => f != FormaPago.Credito || PuedeFiar)
            .Where(f => _otras.All(o => o.Forma != f));

    /// <summary>
    /// Tarjeta, transferencia y crédito, chicos junto a «Pagó con»: cada uno agrega su renglón con lo que falta. En el
    /// piloto con eleventa, en su lugar, que solo es efectivo.
    /// </summary>
    private RenderFragment FormasDePago => @<span class="vn-formas">
        @if (_pilotoEleventa)
        {
            <span class="nota" title="@PilotoConEleventa.NoSeCobra">@PilotoConEleventa.SoloEfectivo</span>
        }
        @foreach (var forma in FormasQueFaltan)
        {
            var esta = forma;
            <button class="vn-forma" title="@TituloDeForma(esta)" @onclick="() => AgregarFormaAsync(esta)"><Ico Nombre="@IconoDeForma(esta)" />@EtiquetaDeForma(esta)</button>
        }
    </span>;

    private string EtiquetaDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Tarjeta",
        FormaPago.Transferencia => "Transf.",
        _ => ConCredito ? "Crédito" : "A favor",
    };

    private string TituloDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Todo o una parte con tarjeta (terminal)",
        FormaPago.Transferencia => "Todo o una parte por transferencia",
        _ => ConCredito ? $"Todo o una parte a crédito de {Actual.Cliente?.Nombre}" : "Todo o una parte de su saldo a favor",
    };

    private static string IconoDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "tarjeta",
        FormaPago.Transferencia => "transferir",
        _ => "reloj",
    };

    private string NombreDeForma(FormaPago forma) => forma switch
    {
        FormaPago.Tarjeta => "Tarjeta (terminal)",
        FormaPago.Transferencia => "Transferencia",
        _ => ConCredito ? $"A crédito de {Actual.Cliente?.Nombre}" : "De su saldo a favor",
    };

    /// <summary>Junto a lo que se fía: lo que debe y lo que le queda, o lo que tiene a favor.</summary>
    private string NotaDeCredito
    {
        get
        {
            if (Actual.Cuenta is not { } cuenta)
                return "";
            var nota = ConCredito
                ? $"Debe {Formato.Dinero(Math.Max(0, cuenta.SaldoCentavos))} · le quedan {Formato.Dinero(Math.Max(0, cuenta.DisponibleCentavos))}"
                : $"Tiene {Formato.Dinero(cuenta.AFavorCentavos)} a favor"
                  + (cuenta.PorVerificarCentavos > 0 ? $"; puede usar {Formato.Dinero(Math.Max(0, cuenta.DisponibleCentavos))}" : "");
            return cuenta.Estimado ? nota + " (según esta caja)" : nota;
        }
    }

    /// <summary>«: lo autoriza Luis.», según lo que puede quien entró.</summary>
    private string AutorizaExceso => Permiso(AccionControlada.ExcederLimiteCredito) switch
    {
        { Nivel: NivelPermiso.RequiereAutorizacion } p => $": lo autoriza {Quien(p)}.",
        { Nivel: NivelPermiso.NoPermitido } => ": no tienes permiso para fiar arriba del límite.",
        { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral } p when ExcesoDeCredito > umbral => $": lo autoriza {Quien(p)}.",
        _ => ".",
    };

    /// <summary>La forma nueva trae lo que falta (del saldo a favor, hasta lo que puede usar); se cambia si es solo una parte.</summary>
    private async Task AgregarFormaAsync(FormaPago forma)
    {
        if (_pilotoEleventa)
        {
            Avisar(PilotoConEleventa.NoSeCobra);
            return;
        }
        if (forma == FormaPago.Credito)
        {
            // La cuenta al día antes de fiar: otra caja pudo fiarle o recibirle un abono.
            await CargarCuentaAsync(Actual);
            if (!PuedeFiar)
            {
                Avisar("Ya no tiene crédito ni saldo a favor que usar: se cobra con otra forma.");
                return;
            }
        }
        var falta = Math.Max(0, Actual.Venta.TotalCentavos - Otros);
        if (forma == FormaPago.Credito && !ConCredito)
            falta = Math.Min(falta, Math.Max(0, Actual.Cuenta!.DisponibleCentavos));
        _otras.Add(new OtraForma(forma, (falta / 100m).ToString("0.00", CultureInfo.InvariantCulture)));
        _pagoCon = "";
        _enfocar = $"#pago-monto-{_otras.Count - 1}";
    }

    private void QuitarForma(OtraForma otra)
    {
        _otras.Remove(otra);
        _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
    }

    /// <summary>Lo que impide cobrar en los renglones de las otras formas.</summary>
    private string? ErrorDeLasFormas
    {
        get
        {
            if (_pilotoEleventa && _otras.Count > 0)
                return "En el piloto con eleventa solo se cobra en efectivo: quita las otras formas";
            if (_otras.FirstOrDefault(o => o.Centavos is null) is { } mala)
                return $"«{mala.Monto}» no es una cantidad";
            if (_otras.Any(o => o.Forma == FormaPago.Credito) && !PuedeFiar)
                return "Sin un cliente con crédito o saldo a favor no se fía: quita ese renglón";
            if (Otros > Actual.Venta.TotalCentavos)
                return "Tarjeta, transferencia y crédito no pueden pasar del total: no dan cambio";
            if (ExcesoDeCredito > 0 && !ConCredito)
                return $"No tiene crédito: solo puede usar su saldo a favor ({Formato.Dinero(Math.Max(0, Actual.Cuenta!.DisponibleCentavos))})";
            return null;
        }
    }

    /// <summary>Lo que impide cobrar ya, o null.</summary>
    private string? ErrorDelCobro
    {
        get
        {
            if (ErrorDeLasFormas is { } error)
                return error + ".";
            var aCobrar = EnEfectivo.ACobrarCentavos;
            if (aCobrar == 0)
                return null;
            if (PagoConCentavos is null)
                return $"«{_pagoCon}» no es una cantidad.";
            return Recibido < aCobrar ? $"Faltan {Formato.Dinero(aCobrar - Recibido)}." : null;
        }
    }

    private string EtiquetaDeCobrar
    {
        get
        {
            var aCobrar = EnEfectivo.ACobrarCentavos;
            if (ErrorDeLasFormas is not null)
                return "Cobrar";
            if (aCobrar == 0)
                return $"Cobrar {Formato.Dinero(Otros)}";
            if (PagoConCentavos is not { } recibido)
                return "Cobrar";
            if (recibido < aCobrar)
                return "Falta dinero";
            return _pagoCon.Trim().Length == 0 ? $"Cobrar exacto {Formato.Dinero(aCobrar + Otros)}" : $"Cobrar · cambio {Formato.Dinero(recibido - aCobrar)}";
        }
    }

    /// <summary>
    /// F12: el cursor va a «Pagó con» y lo demás se apaga; si las otras formas ya lo cubren todo, a «Cobrar». Con el
    /// cursor ya en el cobro, F12 cobra como Enter (y el cobro espera el último escaneo).
    /// </summary>
    private async Task IrAlCobroAsync()
    {
        if (_enPago)
        {
            await CobrarEnPanelAsync();
            return;
        }
        // caja.js no encontró «Pagó con»: el ticket estaba vacío, o el escaneo de su primera línea sigue en camino (con el
        // Wi-Fi lento). Se espera, como las demás teclas del ticket, y entonces el cursor va al cobro: el F12 no se pierde.
        await _captura.EsperarAsync();
        if (Actual.Venta.Lineas.Count > 0)
            _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
    }

    private async Task AlTeclearPago(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CobrarEnPanelAsync();
    }

    /// <summary>
    /// Enter en el cobro (o F12, o el botón): sin escribir nada, exacto; con lo que dio, da el cambio. Con tarjeta,
    /// transferencia o crédito, cada una con su monto y el efectivo por lo que falta. Fiar arriba del límite se autoriza en
    /// el panel. Primero espera el último escaneo: si llegó algo, no cobra y el panel dice el total nuevo.
    /// </summary>
    private async Task CobrarEnPanelAsync()
    {
        if (await EnTurnoDeCobroAsync(CobrarConLaColaAsync) is not { } aviso)
            return;
        _avisoDelCobro = aviso;
        _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
    }

    private async Task CobrarConLaColaAsync(CapturaCodigo.Apartado apartado)
    {
        _avisoDelCobro = null;
        // Un escaneo de la cola pudo abrir algo (el folio de un ticket abre su devolución): no se cobra encima.
        if (_ventana != Ventanas.Ninguna || Actual.Venta.Lineas.Count == 0)
            return;
        if (ErrorDelCobro is { } error)
        {
            Avisar(error);
            return;
        }
        if (!await RevisarCostoAsync())
            return;
        // Pasar el límite: el cajero lo pide; el encargado y el dueño pueden solos. Sin crédito no hay autorización que valga.
        if (ExcesoDeCredito is > 0 and var exceso)
        {
            try
            {
                var decision = await Cliente.PermisoAsync(new SolicitudPermiso(Sesion.UsuarioId, Caja.SucursalId, AccionControlada.ExcederLimiteCredito, exceso));
                switch (decision.Nivel)
                {
                    case NivelPermiso.RequiereAutorizacion:
                        _creditoPorAutorizar = exceso;
                        await Abrir(Ventanas.AutorizarCredito);
                        return;
                    case NivelPermiso.NoPermitido:
                        Avisar("No tienes permiso para fiar arriba del límite.");
                        return;
                }
            }
            catch (ErrorCaja ex)
            {
                Avisar(ex.Message);
                return;
            }
        }
        await MandarCobroAsync(null, apartado);
    }

    /// <summary>Lo que se fía arriba del límite y falta autorizar.</summary>
    private long? _creditoPorAutorizar;

    private async Task CreditoAutorizadoAsync(Guid autorizacionId)
    {
        _creditoPorAutorizar = null;
        await Cerrar();
        if (await EnTurnoDeCobroAsync(apartado => MandarCobroAsync(autorizacionId, apartado)) is { } aviso)
            _avisoDelCobro = aviso;
        StateHasChanged();
    }

    private async Task MandarCobroAsync(Guid? autorizacionCredito, CapturaCodigo.Apartado apartado)
    {
        var cobros = new List<CobroSolicitado>();
        foreach (var otra in _otras)
            if (otra.Centavos is > 0 and var monto)
                cobros.Add(otra.Forma == FormaPago.Credito
                    ? new CobroSolicitado(FormaPago.Credito, monto)
                    : new CobroSolicitado(otra.Forma, monto, otra.Referencia.Trim().Length == 0 ? null : otra.Referencia.Trim()));
        if (EnEfectivo.ACobrarCentavos > 0)
            cobros.Add(new CobroSolicitado(FormaPago.Efectivo, Recibido));
        // Si se cobró, el ticket nuevo ya dejó el cobro en blanco.
        if (await CobrarAsync(cobros, autorizacionCredito, apartado) is { } error)
            Avisar(error);
        else
            _enfocar = "#codigo";
    }

    /// <summary>
    /// Todo cobro pasa por aquí (el panel, el crédito ya autorizado y la ventana de la pantalla de hoy): aparta la cola de
    /// escaneos, que espera los que venían y detiene los que llegan mientras se cobra; esos caen en el ticket del siguiente
    /// cliente. Si mientras esperaba llegó algo al ticket, no cobra y devuelve el aviso: el cajero ve el total nuevo antes
    /// de cobrarlo. Con un cobro en curso, no hace nada.
    /// </summary>
    private async Task<string?> EnTurnoDeCobroAsync(Func<CapturaCodigo.Apartado, Task> cobrar)
    {
        if (_cobrando)
            return null;
        _cobrando = true;
        try
        {
            using var apartado = await _captura.ApartarAsync(FotoDelTicket);
            if (apartado.LlegoAlgo)
                return $"Llegó lo último que escaneaste: el total ahora es {Formato.Dinero(Actual.Venta.TotalCentavos)}. Revisa lo que te dio y vuelve a cobrar.";
            await cobrar(apartado);
            return null;
        }
        finally
        {
            _cobrando = false;
        }
    }

    /// <summary>Lo que cambia si llega una línea mientras se espera para cobrar: el ticket, su total y lo que lleva.</summary>
    private (TicketAbierto Ticket, long Total, decimal Articulos, int Lineas) FotoDelTicket() =>
        (Actual, Actual.Venta.TotalCentavos, Actual.Venta.NumeroDeArticulos, Actual.Venta.Lineas.Count);

    /// <summary>La ventana de cobro de la pantalla de hoy: el mismo turno en la cola que el panel.</summary>
    private async Task<string?> CobrarDeLaVentanaAsync(IReadOnlyList<CobroSolicitado> cobros, Guid? autorizacionCredito)
    {
        string? error = null;
        var aviso = await EnTurnoDeCobroAsync(async apartado => error = await CobrarAsync(cobros, autorizacionCredito, apartado));
        return aviso ?? error;
    }

    private async Task RevisarConteoAsync()
    {
        try
        {
            _conteo = await Cliente.ConteoDelDiaAsync(Caja.SucursalId, Sesion.UsuarioId);
        }
        catch (ErrorCaja)
        {
            // Sin conexión no se pide: el conteo espera a que vuelva.
        }
    }

    private sealed class TicketAbierto
    {
        public required Venta Venta { get; init; }
        public required int Numero { get; init; }
        public Dictionary<Guid, ProductoVentaDto> Productos { get; } = [];

        /// <summary>Los trabajos de impresión que van en la línea "Impresiones" de este ticket.</summary>
        public List<ImpresionPorCobrarDto> Impresiones { get; } = [];

        /// <summary>El cliente registrado del ticket: lo que se agregue después también lleva su descuento y su mayoreo.</summary>
        public ClienteRegistradoDto? Cliente { get; set; }

        /// <summary>Su cuenta (lo que debe, su límite): se pide al elegirlo y otra vez antes de cobrar.</summary>
        public CreditoClienteDto? Cuenta { get; set; }

        /// <summary>Se mandó a fiar y se perdió la respuesta: puede que ya esté guardado. Solo se cobra en línea, con el mismo Id.</summary>
        public bool FiadoSinConfirmar { get; set; }
    }

    private readonly List<TicketAbierto> _tickets = [];
    private TicketAbierto Actual => _tickets[_actual];
    private int _actual;
    private int _seleccion = -1;
    private int _siguienteNumero = 1;
    private readonly CapturaCodigo _captura = new();
    private string? _mensaje;
    private bool _mensajeEsError;
    private TicketDto? _ultimo;
    private (string Titulo, string Texto)? _vistaPrevia;
    private Ventanas _ventana;
    private DotNetObjectReference<PantallaVenta>? _referencia;

    protected override void OnInitialized()
    {
        RecuperarEspera();
        NuevoTicket();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (_enfocar is { } selector)
        {
            _enfocar = null;
            await Js.EnfocarAsync(selector);
        }
        if (!primera)
            return;
        _referencia = DotNetObjectReference.Create(this);
        await Js.RegistrarTeclasAsync(_referencia);
        await Js.EnfocarAsync("#codigo");
        // Quien volvió a la de hoy en esta PC la ve en cuanto se lee, sin esperar los permisos (sin conexión, en el
        // navegador, tardan lo que tarda en fallar): sus teclas ya son las de la de hoy. Los demás ya están en la nueva.
        if (await Js.LeerAsync(ClavePantalla) == PantallaDeHoy)
        {
            _pantallaNueva = false;
            _enfocar = "#codigo";
            StateHasChanged();
        }
        // Primero los permisos: lo de quien entró sale en cuanto llegan, sin esperar a los rápidos ni a lo demás.
        await CargarPermisosAsync();
        StateHasChanged();
        await CargarRapidosAsync();
        await CargarPilotoEleventaAsync();
        await RevisarEfectivoAsync();
        await RevisarConteoAsync();
        StateHasChanged();
    }

    /// <summary>El Enter del cuadro de captura de la pantalla nueva: caja.js ya tomó el texto y vació el cuadro.</summary>
    [JSInvokable]
    public async Task Escaneado(string texto)
    {
        if (_ventana != Ventanas.Ninguna)
            return;
        // «/algo» y Enter: la acción elegida, o la primera que se llama así.
        if (_pantallaNueva && FiltroDeAcciones(texto) is { } filtro)
        {
            CerrarResultados();
            await HacerAccionDeTextoAsync(filtro);
            StateHasChanged();
            return;
        }
        // Con ↑ ↓ (o → y Tab) se eligió de la lista de resultados: Enter agrega ese; en una familia, su más vendido.
        if (_resultados is { Count: > 0 } resultados && _navegado && SepararCantidad(texto).Texto == _textoBuscado && Seleccionado() is { } elegido)
        {
            var (cantidad, buscado) = (_cantidadBuscada, _textoBuscado);
            CerrarResultados();
            // caja.js ya vació el cuadro: el nombre buscado no se queda como la cantidad de lo que sigue (F11, un rápido).
            _captura.Texto = "";
            await _captura.EnTurnoAsync(() => AgregarResultadoAsync(elegido, cantidad, buscado, resultados.Count));
            StateHasChanged();
            return;
        }
        CerrarResultados();
        _captura.Texto = texto;
        var escaneo = AgregarCodigoAsync();
        StateHasChanged();
        await escaneo;
        StateHasChanged();
    }

    /// <summary>
    /// El lector escribió en el cobro («Pagó con», un monto, una referencia o un botón; data-cobro) o en un abono, y caja.js
    /// lo reconoció por su ritmo: ya quitó del campo lo que tecleó y su Enter no cobró. Un escaneo nunca se toma como
    /// dinero (docs/propuesta-interfaz.md, «El cuadro de captura»): el código va a la cola de captura como cualquier otro y
    /// el cursor vuelve al cuadro. La ventana donde estaba (el cobro de la pantalla de hoy, un abono) se cierra, para ver el
    /// ticket. Si se está cobrando, espera al cobro y cae en el ticket del siguiente cliente.
    /// </summary>
    [JSInvokable]
    public async Task EscaneoEnPago(string codigo)
    {
        var cobrando = _cobrando;
        var enAbono = _ventana is Ventanas.Abono or Ventanas.Clientes;
        if (!cobrando)
        {
            if (_ventana != Ventanas.Ninguna)
                await Cerrar();
            _enfocar = "#codigo";
        }
        var antes = FotoDelTicket();
        _captura.Texto = codigo;
        var escaneo = AgregarCodigoAsync();
        StateHasChanged();
        await escaneo;
        if (!cobrando && !antes.Equals(FotoDelTicket()))
            Avisar(enAbono
                ? $"«{codigo}» se leyó en el abono: se agregó al ticket, no se tomó como dinero. El abono, otra vez con Ctrl+B."
                : $"«{codigo}» se leyó en el cobro: se agregó al ticket, no se tomó como dinero. Cobra cuando esté completo.", error: false);
        StateHasChanged();
    }

    /// <summary>
    /// Lo que se escribe a mano en el cuadro de la pantalla nueva, al dejar de teclear: la cantidad de un rápido o de
    /// F11, o un nombre, que se busca aquí mismo.
    /// </summary>
    [JSInvokable]
    public async Task Escribiendo(string texto)
    {
        _captura.Texto = texto;
        if (_pantallaNueva && _ventana == Ventanas.Ninguna)
            await BuscarMientrasEscribeAsync(texto);
    }

    // ── La búsqueda debajo del cuadro (pantalla nueva) ──────────────────────

    /// <summary>Cuántos renglones muestra la lista.</summary>
    private const int MaximoResultados = 30;

    /// <summary>Cuántos productos se piden: con más, las familias salen completas aunque la lista muestre 30 renglones.</summary>
    private const int ParaFamilias = 200;

    /// <summary>Cuántos valores se ven en el renglón de una familia; los demás, al desplegarla.</summary>
    private const int ValoresALaVista = 8;

    /// <summary>Lo que sale al escribir; null: la lista está cerrada.</summary>
    private List<ResultadoBusquedaDto>? _resultados;

    /// <summary>Los resultados en renglones: lo que solo cambia en el color, la medida o la marca va junto.</summary>
    private AgrupacionDeFamilias<ResultadoBusquedaDto>? _familias;

    /// <summary>El renglón de la familia desplegada, o -1.</summary>
    private int _abierta = -1;

    /// <summary>Lo que se eligió desplegar con Tab para cada texto: la próxima vez con ese texto se despliega igual.</summary>
    private readonly Dictionary<string, EjeFamilia> _ejePorTexto = [];

    private void Agrupar()
    {
        if (_resultados is not { } resultados)
        {
            (_familias, _abierta) = (null, -1);
            return;
        }
        EjeFamilia? preferido = _ejePorTexto.TryGetValue(Texto.Normalizar(_textoBuscado), out var eje) ? eje : null;
        _familias = Familias.Agrupar(resultados, r => r.Partes ?? [], r => r.Vendidos, preferido);
        _abierta = -1;
    }

    /// <summary>Lo que se recorre con ↑ ↓: cada renglón y, en la familia desplegada, cada valor (-1: el renglón).</summary>
    private List<(int Renglon, int Valor)> Navegables()
    {
        var lista = new List<(int, int)>();
        if (_familias is not { } familias)
            return lista;
        for (var k = 0; k < Math.Min(familias.Renglones.Count, MaximoResultados); k++)
        {
            lista.Add((k, -1));
            if (k == _abierta)
                lista.AddRange(Enumerable.Range(0, familias.Renglones[k].Valores.Count).Select(v => (k, v)));
        }
        return lista;
    }

    /// <summary>El producto de un renglón (el más vendido, si es familia) o de uno de sus valores.</summary>
    private ResultadoBusquedaDto? DeLaLista(int renglon, int valor) =>
        _familias is { } familias && renglon >= 0 && renglon < familias.Renglones.Count
            ? valor < 0 ? familias.Renglones[renglon].Elegido : familias.Renglones[renglon].Valores[valor].Elemento
            : null;

    private ResultadoBusquedaDto? Seleccionado() =>
        Navegables() is var lista && _indiceResultado >= 0 && _indiceResultado < lista.Count
            ? DeLaLista(lista[_indiceResultado].Renglon, lista[_indiceResultado].Valor)
            : null;

    /// <summary>→ (o la flecha del renglón): despliega la familia con el cursor en el más vendido.</summary>
    private void AbrirSeleccionada()
    {
        var lista = Navegables();
        if (_familias is not { } familias || _indiceResultado >= lista.Count || lista[_indiceResultado] is not (var renglon, -1)
            || !familias.Renglones[renglon].EsFamilia)
            return;
        _abierta = renglon;
        _indiceResultado = Navegables().IndexOf((renglon, familias.Renglones[renglon].MasVendido));
        _navegado = true;
        _ = Js.MostrarAsync($"#res-{_indiceResultado}");
    }

    /// <summary>← o Esc: cierra la familia y el cursor vuelve a su renglón.</summary>
    private void CerrarFamilia()
    {
        if (_abierta < 0)
            return;
        var renglon = _abierta;
        _abierta = -1;
        _indiceResultado = Navegables().IndexOf((renglon, -1));
    }

    private void AlternarFamilia(int renglon)
    {
        if (_abierta == renglon)
        {
            CerrarFamilia();
        }
        else
        {
            _abierta = -1;
            _indiceResultado = Navegables().IndexOf((renglon, -1));
            AbrirSeleccionada();
        }
        _enfocar = "#codigo";
    }

    /// <summary>Tab y Mayús+Tab: despliega por lo siguiente que cambia (color, medida, marca…). Se recuerda para ese texto.</summary>
    private void CambiarEje(int paso)
    {
        if (_familias is not { Ejes.Count: > 1 } familias)
            return;
        var actual = familias.Eje is { } eje ? familias.Ejes.ToList().IndexOf(eje) : -1;
        ElegirEje(familias.Ejes[(actual + paso + familias.Ejes.Count) % familias.Ejes.Count]);
    }

    private void ElegirEje(EjeFamilia eje)
    {
        _ejePorTexto[Texto.Normalizar(_textoBuscado)] = eje;
        Agrupar();
        (_indiceResultado, _navegado) = (0, true);
        _enfocar = "#codigo";
    }

    private static string NombreDeEje(EjeFamilia eje) => eje switch
    {
        EjeFamilia.Color => "Color",
        EjeFamilia.Medida => "Tamaño",
        EjeFamilia.Marca => "Marca",
        EjeFamilia.Contenido => "Contenido",
        _ => "Rayado",
    };

    private static string PluralDeEje(EjeFamilia eje) => eje switch
    {
        EjeFamilia.Color => "colores",
        EjeFamilia.Medida => "tamaños",
        EjeFamilia.Marca => "marcas",
        EjeFamilia.Contenido => "contenidos",
        _ => "rayados",
    };

    /// <summary>El valor como se escribió; si dos se llaman igual (un producto repetido en el catálogo), con su precio.</summary>
    private static string ValorTexto(RenglonDeFamilia<ResultadoBusquedaDto> renglon, int v)
    {
        var valor = renglon.Valores[v];
        var repetido = renglon.Valores.Count(x => x.Clave == valor.Clave) > 1;
        return repetido ? $"{valor.Texto} · {Formato.Dinero(valor.Elemento.PrecioCentavos)}" : valor.Texto;
    }

    private static string ValorTitulo(RenglonDeFamilia<ResultadoBusquedaDto> renglon, int v) =>
        $"{renglon.Valores[v].Elemento.Descripcion} · {Formato.Dinero(renglon.Valores[v].Elemento.PrecioCentavos)} · {ExistenciaTexto(renglon.Valores[v].Elemento.Existencia)}";

    /// <summary>Si el precio cambia según el valor (el costo de compra es distinto), «desde» el más bajo.</summary>
    private static string PrecioDeFamilia(RenglonDeFamilia<ResultadoBusquedaDto> renglon)
    {
        var precios = renglon.Valores.Select(v => v.Elemento.PrecioCentavos).Distinct().ToList();
        return precios.Count == 1 ? Formato.Dinero(precios[0]) : $"desde {Formato.Dinero(precios.Min())}";
    }

    /// <summary>El punto de color de referencia (el surtido, de varios colores); en otros ejes, nada.</summary>
    private static RenderFragment Punto(EjeFamilia eje, string clave) => eje != EjeFamilia.Color
        ? _ => { }
        : MuestraDeColor.Css(clave) is { } css
            ? @<span class="vn-punto" style="background:@css"></span>
            : @<span class="vn-punto surtido"></span>;

    private static string ExistenciaClase(decimal? existencia) => existencia is <= 0 ? "nada" : existencia is <= 3 ? "poca" : "";

    /// <summary>Si salió por un sinónimo de la tienda, por cuál: así se va aprendiendo cómo se llama.</summary>
    private static RenderFragment PorSinonimo(ResultadoBusquedaDto r) => r.PorSinonimo is { } palabra
        ? @<span class="vn-via" title="Sinónimo de la tienda (Configuración › Sinónimos)">por «@palabra»</span>
        : _ => { };

    /// <summary>Cuántas fichas para afinar se ven.</summary>
    private const int FichasParaAfinar = 7;

    /// <summary>
    /// Con un texto general («folder»), las palabras que separan los resultados, de la que más separa a la que menos: la
    /// marca, la medida, otra palabra del nombre. Lo que ya sale como ficha de los renglones (el eje desplegado) no se
    /// repite (docs/propuesta-interfaz.md, «Afinar con fichas»).
    /// </summary>
    private List<(string Palabra, int Veces)> ParaAfinar()
    {
        if (_resultados is not { Count: >= 4 } resultados)
            return [];
        var desplegado = _familias?.Eje;
        var cuenta = new Dictionary<string, int>();
        foreach (var r in resultados)
        {
            var delProducto = (r.Partes ?? [])
                .Where(p => p.Clave.Length >= 2 && !p.Clave.All(char.IsDigit) && (desplegado is null || p.Eje != desplegado))
                .Where(p => !_partesBuscadas.Any(b => p.Clave.StartsWith(b, StringComparison.Ordinal)))
                .Select(p => p.Clave)
                .ToHashSet();
            foreach (var palabra in delProducto)
                cuenta[palabra] = cuenta.GetValueOrDefault(palabra) + 1;
        }
        var lista = cuenta.Where(x => x.Value < resultados.Count)
            .OrderByDescending(x => x.Value).ThenBy(x => x.Key, StringComparer.Ordinal)
            .Take(FichasParaAfinar).Select(x => (x.Key, x.Value)).ToList();
        return lista.Count >= 2 ? lista : [];
    }

    /// <summary>Una ficha para afinar: la palabra se agrega a lo escrito y se busca otra vez.</summary>
    private async Task AfinarAsync(string palabra)
    {
        var texto = $"{_captura.Texto.TrimEnd()} {palabra.ToLowerInvariant()}";
        _captura.Texto = texto;
        await Js.EscribirCapturaAsync(texto);
        await BuscarMientrasEscribeAsync(texto);
    }

    private string _textoBuscado = "";
    private string[] _partesBuscadas = [];
    private Cantidad _cantidadBuscada = Cantidad.Piezas(1);
    private int _indiceResultado;

    /// <summary>Se movió con ↑ ↓: Enter agrega el elegido y no busca el texto como código.</summary>
    private bool _navegado;

    /// <summary>Cada búsqueda lleva su número: si llega tarde (ya se escribió otra cosa), no se muestra.</summary>
    private int _secuenciaBusqueda;

    /// <summary>«3*cuad» → 3 y «cuad»: lo de antes del asterisco es la cantidad.</summary>
    private static (Cantidad Cantidad, string Texto) SepararCantidad(string texto)
    {
        texto = texto.Trim();
        var asterisco = texto.IndexOf('*');
        return asterisco > 0 && decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) && n > 0
            ? (Cantidad.Unidades(Math.Round(n, 3)), texto[(asterisco + 1)..].Trim())
            : (Cantidad.Piezas(1), texto);
    }

    /// <summary>Un nombre (o un código corto con letras), no un código del lector ni un folio.</summary>
    private static bool EsTextoDeBusqueda(string texto) => texto.Length >= 2 && texto.Any(char.IsLetter) && !FolioTicket.IsMatch(texto);

    private async Task BuscarMientrasEscribeAsync(string texto)
    {
        if (FiltroDeAcciones(texto) is { } filtro)
        {
            CerrarResultados();
            MostrarAcciones(filtro);
            StateHasChanged();
            return;
        }
        if (_accionesVistas is not null)
        {
            CerrarAcciones();
            StateHasChanged();
        }
        var (cantidad, resto) = SepararCantidad(texto);
        var secuencia = ++_secuenciaBusqueda;
        if (!EsTextoDeBusqueda(resto))
        {
            if (_resultados is not null)
            {
                _resultados = null;
                Agrupar();
                StateHasChanged();
            }
            return;
        }
        try
        {
            var resultados = await Cliente.BuscarAsync(resto, Caja.SucursalId, Caja.Id, ParaFamilias);
            if (secuencia != _secuenciaBusqueda)
                return;
            (_resultados, _textoBuscado, _cantidadBuscada, _indiceResultado, _navegado) = (resultados, resto, cantidad, 0, false);
            _partesBuscadas = Texto.Normalizar(resto).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            Agrupar();
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
        StateHasChanged();
    }

    private void CerrarResultados()
    {
        _resultados = null;
        Agrupar();
        _navegado = false;
        _secuenciaBusqueda++;
    }

    private void MoverResultado(int paso)
    {
        var lista = Navegables();
        if (lista.Count == 0)
            return;
        _indiceResultado = Math.Clamp(_indiceResultado + paso, 0, lista.Count - 1);
        _navegado = true;
        _ = Js.MostrarAsync($"#res-{_indiceResultado}");
    }

    /// <summary>Un clic en un renglón (en una familia, su más vendido), en uno de sus valores o en su ficha.</summary>
    private async Task AgregarDeLaListaAsync(int renglon, int valor)
    {
        if (_resultados is not { } resultados || DeLaLista(renglon, valor) is not { } elegido)
            return;
        var (cantidad, buscado) = (_cantidadBuscada, _textoBuscado);
        CerrarResultados();
        VaciarCaptura();
        _enfocar = "#codigo";
        await _captura.EnTurnoAsync(() => AgregarResultadoAsync(elegido, cantidad, buscado, resultados.Count));
    }

    /// <summary>
    /// Agrega lo elegido y anota qué se eligió con ese texto: la próxima vez, en esta caja, sale primero. Fuera de la cola
    /// de escaneos, quien llama lo forma en ella (<see cref="CapturaCodigo.EnTurnoAsync"/>); dentro, se llama directo.
    /// </summary>
    private async Task AgregarResultadoAsync(ResultadoBusquedaDto resultado, Cantidad cantidad, string buscado, int resultados)
    {
        _ = Cliente.RegistrarBusquedaAsync(new SolicitudBusqueda(Caja.Id, buscado, resultados, resultado.VarianteId));
        try
        {
            if (await Cliente.PorVarianteAsync(resultado.VarianteId, Caja.SucursalId) is { } producto)
                Agregar(producto, null, cantidad);
            else
                Avisar("Ese producto ya no está en el catálogo.");
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    /// <summary>
    /// Enter con un nombre que no es código, sin elegir de la lista: agrega el primer renglón (lo elegido antes o lo más
    /// vendido); si es una familia, su más vendido. Si no sale nada, lo dice y lo anota, para darlo de alta o hacerlo
    /// sinónimo después.
    /// </summary>
    private async Task AgregarPrimeroAsync(string texto, Cantidad cantidad)
    {
        var resultados = await Cliente.BuscarAsync(texto, Caja.SucursalId, Caja.Id, _pantallaNueva ? ParaFamilias : MaximoResultados);
        if (resultados.Count == 0)
        {
            _ = Cliente.RegistrarBusquedaAsync(new SolicitudBusqueda(Caja.Id, texto, 0, null));
            Avisar($"Nada coincide con «{texto}». Revisa cómo se escribe, o véndelo como artículo común (Ins).");
            return;
        }
        EjeFamilia? preferido = _ejePorTexto.TryGetValue(Texto.Normalizar(texto), out var eje) ? eje : null;
        var primero = Familias.Agrupar(resultados, r => r.Partes ?? [], r => r.Vendidos, preferido).Renglones[0].Elegido;
        await AgregarResultadoAsync(primero, cantidad, texto, resultados.Count);
    }

    private static string ExistenciaTexto(decimal? existencia) => existencia switch
    {
        null => "Servicio",
        <= 0 => "Sin existencia",
        <= 3 => $"Quedan {Formato.Numero(existencia.Value)}",
        _ => $"{Formato.Numero(existencia.Value)} en tienda",
    };

    /// <summary>El texto con el principio de cada palabra que coincide con lo escrito, resaltado.</summary>
    private RenderFragment Marcado(string texto) => @<span>@foreach (var (parte, marcada) in Segmentos(texto, _partesBuscadas))
        {
            if (marcada)
            {
                <mark>@parte</mark>
            }
            else
            {
                @parte
            }
        }</span>;

    private static IEnumerable<(string Parte, bool Marcada)> Segmentos(string texto, string[] partes)
    {
        if (texto.Length == 0)
            yield break;
        // Cada carácter normalizado por separado: la misma longitud que el texto, para marcar en su lugar.
        var plano = string.Concat(texto.Select(c => char.IsWhiteSpace(c) ? " " : Texto.Normalizar(c.ToString()) is { Length: 1 } n ? n : "·"));
        var marca = new bool[texto.Length];
        for (var i = 0; i < texto.Length; i++)
        {
            if (i > 0 && char.IsLetterOrDigit(texto[i - 1]))
                continue;
            foreach (var parte in partes)
            {
                if (!plano.AsSpan(i).StartsWith(parte, StringComparison.Ordinal))
                    continue;
                for (var k = i; k < i + parte.Length; k++)
                    marca[k] = true;
                break;
            }
        }
        var inicio = 0;
        for (var i = 1; i <= texto.Length; i++)
        {
            if (i < texto.Length && marca[i] == marca[inicio])
                continue;
            yield return (texto[inicio..i], marca[inicio]);
            inicio = i;
        }
    }

    /// <summary>Vacía el cuadro de captura, también en la pantalla nueva, donde no está enlazado.</summary>
    private void VaciarCaptura()
    {
        _captura.Texto = "";
        if (_pantallaNueva)
            _ = Js.LimpiarCapturaAsync();
    }

    /// <param name="tecla">La tecla, como la nombra caja.js.</param>
    /// <param name="texto">
    /// En la pantalla nueva, lo que había en el cuadro de captura (no está enlazado); null si se oprimió en otro lado o es
    /// un botón de la barra de teclas.
    /// </param>
    [JSInvokable]
    public async Task Tecla(string tecla, string? texto)
    {
        if (_pantallaNueva && texto is not null)
            _captura.Texto = texto;
        if (_ventana != Ventanas.Ninguna && !await TeclaConVentanaAsync(tecla, desdeLaCaptura: texto is not null))
            return;

        // Con «/» en el cuadro, ↑ ↓ recorren las acciones.
        if (_pantallaNueva && tecla is "ArrowUp" or "ArrowDown" && texto is not null && FiltroDeAcciones(texto) is { } filtro)
        {
            if (_accionesVistas is null || filtro != _textoAcciones)
                MostrarAcciones(filtro);
            MoverAccion(tecla == "ArrowUp" ? -1 : 1);
            StateHasChanged();
            return;
        }
        // Las familias de la lista (caja.js solo manda estas teclas con la lista abierta): → despliega, ← y Esc cierran, Tab
        // despliega por otra cosa. Sin familia abierta, Esc hace lo de siempre.
        // caja.js no vació el cuadro si creyó que había una familia abierta.
        var cuadroSinVaciar = tecla == "Escape-familia";
        if (cuadroSinVaciar && _abierta < 0)
            tecla = "Escape";
        if (_pantallaNueva && _familias is not null && tecla is "ArrowRight" or "ArrowLeft" or "Tab" or "Shift+Tab" or "Escape-familia")
        {
            switch (tecla)
            {
                case "ArrowRight": AbrirSeleccionada(); break;
                case "ArrowLeft" or "Escape-familia": CerrarFamilia(); break;
                case "Tab": CambiarEje(1); break;
                case "Shift+Tab": CambiarEje(-1); break;
            }
            StateHasChanged();
            return;
        }
        // Con un nombre en el cuadro, ↑ ↓ recorren los resultados (si se teclearon antes de que salieran, se busca ya).
        if (_pantallaNueva && tecla is "ArrowUp" or "ArrowDown" && texto is not null && EsTextoDeBusqueda(SepararCantidad(texto).Texto))
        {
            if (_resultados is null || SepararCantidad(texto).Texto != _textoBuscado)
                await BuscarMientrasEscribeAsync(texto);
            MoverResultado(tecla == "ArrowUp" ? -1 : 1);
            StateHasChanged();
            return;
        }
        // Cualquier otra tecla (Esc, F12, F6…) cierra la lista, el menú del usuario y «Más».
        if (_resultados is not null)
            CerrarResultados();
        CerrarAcciones();
        _menuUsuario = false;
        _menuEspera = false;

        // Las teclas que actúan sobre el ticket esperan a que termine el último escaneo (y el cobro en curso): F6 no manda
        // un escaneo al ticket nuevo, ni + cambia el que se está cobrando. F12 espera en IrAlCobroAsync: dentro del cobro,
        // que además dice si llegó algo mientras, o antes de pasar el cursor al cobro.
        if (tecla is "F6" or "F5" or "+" or "-" or "Delete" or "F11" || tecla.StartsWith("Alt+", StringComparison.Ordinal))
            await _captura.EsperarAsync();

        switch (tecla)
        {
            // En la pantalla nueva, lo que no está entre sus permisos no tiene tecla.
            case var _ when SinTecla(tecla):
                Avisar("Eso no está entre lo que puedes hacer: «/» muestra todo lo que sí.");
                break;
            case "Ctrl+U" when _pantallaNueva: await AlSalir.InvokeAsync(); break;
            case "F10" when _pantallaNueva: Buscar(); break;
            case "F10": await Abrir(Ventanas.Buscar); break;
            // caja.js ya movió el cursor a «Pagó con» (sin esperar esta vuelta): no cobra todavía, y el cobro espera el
            // último escaneo al dar Enter.
            case "F12-pago": break;
            case "F12" when _pantallaNueva: await IrAlCobroAsync(); break;
            case "F12": await AbrirCobroAsync(); break;
            case "F5" when _pantallaNueva: RetomarPrimero(); break;
            case "F5": CambiarSiguiente(); break;
            case "F6" when _pantallaNueva: PonerEnEspera(); break;
            case "F6": NuevoTicket(); break;
            case ['A', 'l', 't', '+', var numero] when _pantallaNueva && numero is >= '1' and <= '6': await RapidoAsync(numero - '1'); break;
            case "F7": await Abrir(Ventanas.Entrada); break;
            case "F8": await Abrir(Ventanas.Salida); break;
            case "F9": await Abrir(Ventanas.Verificador); break;
            case "F2": await Abrir(Ventanas.Impresiones); break;
            case "Insert" or "Ctrl+P": await Abrir(Ventanas.Comun); break;
            case "Ctrl+E": await AbrirCambioPrecio(); break;
            case "Ctrl+D": await Abrir(Ventanas.Descuento); break;
            case "Ctrl+L": await Abrir(Ventanas.ElegirCliente); break;
            case "Ctrl+B": await Abrir(Ventanas.Abono); break;
            case "Delete": await BorrarSeleccion(); break;
            case "ArrowUp": await MoverSeleccion(-1); break;
            case "ArrowDown": await MoverSeleccion(1); break;
            case "+": await CambiarCantidadSeleccion(1); break;
            case "-": await CambiarCantidadSeleccion(-1); break;
            case "F11": await MayoreoAsync(); break;
            case "F3": await Abrir(Ventanas.Productos); break;
            case "F4": await Abrir(Ventanas.Inventario); break;
            case "Escape":
                _cobrado = null;
                // Desde el cuadro de captura, caja.js ya lo vació: vaciarlo otra vez desde aquí borraría lo que se
                // empezó a escribir enseguida.
                if (_pantallaNueva && texto is not null && !cuadroSinVaciar)
                    _captura.Texto = "";
                else
                    VaciarCaptura();
                _mensaje = null;
                if (_pantallaNueva)
                {
                    // Desde «Pagó con», Esc borra lo escrito y regresa al cuadro del código sin cobrar.
                    (_pagoCon, _avisoDelCobro) = ("", null);
                    _enfocar = "#codigo";
                }
                break;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Una tecla con una ventana abierta; devuelve si sigue a hacer lo suyo. Esc la cierra. En la pantalla nueva, con un
    /// panel a la derecha (el ticket a la vista), las teclas de la barra y de «/» siguen funcionando
    /// (docs/propuesta-interfaz.md, «Los demás paneles»): la del mismo panel lo cierra («F9 o Esc regresan a vender») y,
    /// si el panel se deja (<see cref="PanelesQueSeDejan"/>), las demás lo cierran y hacen lo suyo, como sin él: abrir
    /// otro panel, F12 al cobro, F6 a la espera. Un panel con campos espera su Enter o Esc, y con otra tecla lo dice. Antes
    /// solo respondía Esc. caja.js solo manda las que no escriben en los campos del panel (Esc, las F, las Ctrl de la caja
    /// e Ins); Supr, las flechas, + y − se quedan en el panel.
    /// </summary>
    /// <param name="desdeLaCaptura">Se oprimió en el cuadro de captura de la pantalla nueva: caja.js mandó su texto.</param>
    private async Task<bool> TeclaConVentanaAsync(string tecla, bool desdeLaCaptura)
    {
        if (tecla == "Escape")
        {
            // Desde el cuadro de captura, caja.js ya lo vació.
            if (desdeLaCaptura)
                _captura.Texto = "";
            await Cerrar();
            return false;
        }
        // caja.js no manda estas con una ventana abierta: si llegan, perdió la cuenta porque otra parte de la caja le dijo
        // que ya no había ventana (la franja de la prueba lo hacía al cerrar su guía encima de un panel). Se le vuelve a
        // decir y la tecla no hace nada: Supr no quita un renglón, + no cambia una cantidad ni Alt+1 agrega un rápido
        // detrás del panel.
        if (EsTeclaSinVentana(tecla))
        {
            await AvisarVentanaAbiertaAsync();
            return false;
        }
        // Lo que va encima del ticket (los módulos de arriba y el conteo; en la pantalla de hoy, todo) solo se cierra con
        // Esc: puede tener algo a medio escribir. F1 (la venta, donde ya está) no hace nada.
        if (!VaEnPanel || tecla == "F1")
            return false;
        if (PanelDeLaTecla(tecla) == _ventana)
        {
            await Cerrar();
            return false;
        }
        // Una autorización a mitad del cobro, o un panel con campos: espera su Enter o Esc, y lo dice.
        if (PorQueNoSeDeja is { } espera)
        {
            AvisarEnElPanel(espera);
            return false;
        }
        // La tecla de algo que no puede solo lo avisa: el panel se queda.
        if (SinTecla(tecla))
        {
            AvisarEnElPanel("Eso no está entre lo que puedes hacer: «/» muestra todo lo que sí.");
            return false;
        }
        if (tecla == "Ctrl+Q")
        {
            // El PDF a cotizar: el selector se abre ya (la tecla se acaba de oprimir) y, al elegir el PDF, el panel cambia al
            // de cotizar. Si no se elige ninguno, el panel se queda.
            await Js.ClicAsync("#pdf-cotizar");
            return false;
        }
        if (tecla == "F12")
        {
            // Al cobro: el cursor va directo a «Pagó con» (IrAlCobroAsync), sin pasar por el cuadro de captura, donde lo
            // que se teclee enseguida se tomaría como un código. No estaba en el cobro (el panel lo tapaba): no cobra todavía.
            await QuitarVentanaAsync();
            _enPago = false;
            if (Actual.Venta.Lineas.Count == 0)
                _enfocar = "#codigo";
            return true;
        }
        await Cerrar();
        return true;
    }

    /// <summary>
    /// Las que caja.js deja en los campos de una ventana abierta (Supr, las flechas, + y −, Alt+1 a Alt+6) y las que solo
    /// manda sin ventana: F12 que ya movió el cursor a «Pagó con» y las de la lista de familias (→, ←, Tab y su Esc).
    /// </summary>
    private static bool EsTeclaSinVentana(string tecla) =>
        tecla is "Delete" or "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight" or "+" or "-" or "Tab" or "Shift+Tab" or "Escape-familia"
            or "F12-pago"
        || tecla.StartsWith("Alt+", StringComparison.Ordinal);

    private void AvisarEnElPanel(string aviso)
    {
        _avisoDelPanel = aviso;
        StateHasChanged();
    }

    /// <summary>El panel que abre la tecla en la pantalla nueva, para que la misma lo cierre; null si no abre uno.</summary>
    private Ventanas? PanelDeLaTecla(string tecla) => tecla switch
    {
        "F9" => Ventanas.Verificador,
        "F2" => Ventanas.Impresiones,
        "F7" => Ventanas.Entrada,
        "F8" => Ventanas.Salida,
        "Insert" or "Ctrl+P" => Ventanas.Comun,
        "Ctrl+E" => Ventanas.CambiarPrecio,
        "Ctrl+D" => Ventanas.Descuento,
        "Ctrl+L" => Ventanas.ElegirCliente,
        "Ctrl+B" => Ventanas.Abono,
        // Con las piezas escritas en el cuadro, F11 las pone en el renglón (MayoreoAsync): ahí no cierra el mayoreo.
        "F11" when _captura.Texto.Trim().TrimEnd('*').Length == 0 => Ventanas.Mayoreo,
        _ => null,
    };

    /// <summary>Un botón de la barra de teclas hace lo mismo que su tecla, también con un panel abierto (el suyo lo cierra).</summary>
    private Task ComoSuTecla(string tecla) => Tecla(tecla, null);

    // ── Captura ─────────────────────────────────────────────────────────────

    private async Task AlTeclearCodigo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AgregarCodigoAsync();
    }

    /// <summary>El cuadro se vacía al momento y el escaneo espera su turno: el lector no espera a la red.</summary>
    private Task AgregarCodigoAsync() => _captura.EnterAsync(ProcesarCodigoAsync);

    /// <summary>
    /// "7501…" agrega una pieza; "3*7501…" agrega tres; "5*" cambia la cantidad del renglón seleccionado. El QR de un
    /// ticket ("A-000123") abre la devolución.
    /// </summary>
    private async Task ProcesarCodigoAsync(string texto)
    {
        if (FolioTicket.IsMatch(texto))
        {
            await AbrirDevolucion(texto.ToUpperInvariant());
            return;
        }

        var cantidad = Cantidad.Piezas(1);
        var asterisco = texto.IndexOf('*');
        if (asterisco > 0)
        {
            if (!decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) || n <= 0)
            {
                Avisar($"Cantidad inválida: «{texto[..asterisco]}».");
                return;
            }
            cantidad = Cantidad.Unidades(Math.Round(n, 3));
            texto = texto[(asterisco + 1)..].Trim();
            if (texto.Length == 0)
            {
                await FijarCantidadSeleccion(cantidad);
                return;
            }
        }

        try
        {
            var producto = await Cliente.PorCodigoAsync(texto, Caja.SucursalId);
            if (producto is null && _pantallaNueva && PareceNombre(texto))
            {
                // En la pantalla nueva el nombre se busca aquí mismo: Enter agrega el primero de la lista («3*cuad» también).
                await AgregarPrimeroAsync(texto, cantidad);
                return;
            }
            if (producto is null && asterisco < 0 && PareceNombre(texto))
            {
                // Como en eleventa, se escribe el nombre donde va el código: se busca por nombre en vez de ofrecer el alta.
                _buscarTexto = texto;
                await Abrir(Ventanas.Buscar);
                return;
            }
            if (producto is null)
            {
                Avisar($"No existe el código «{texto}». F10 para buscar por nombre, o dalo de alta.");
                _codigoNuevo = texto;
                return;
            }
            Agregar(producto, null, cantidad);
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarVarianteAsync(Guid varianteId)
    {
        await Cerrar();
        try
        {
            if (await Cliente.PorVarianteAsync(varianteId, Caja.SucursalId) is { } producto)
                Agregar(producto, null, Cantidad.Piezas(1));
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    private void Agregar(ProductoVentaDto producto, Guid? presentacionId, Cantidad cantidad)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        (_cobrado, _avisoDelCobro) = (null, null);
        try
        {
            var linea = Actual.Venta.AgregarProducto(producto.ParaVenta(), producto.PresentacionModelo(presentacionId), cantidad, producto.PreciosModelo());
            DescuentoDelCliente(linea);
            Actual.Productos[producto.VarianteId] = producto;
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
            _mensaje = null;
            _ = Js.MostrarAsync($"#linea-{_seleccion}");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarComun((string Descripcion, long Precio, Cantidad Cantidad) articulo)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        _cobrado = null;
        await Cerrar();
        try
        {
            var linea = Actual.Venta.AgregarArticuloComun(articulo.Descripcion, articulo.Precio, articulo.Cantidad);
            DescuentoDelCliente(linea);
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    // ── Renglones ───────────────────────────────────────────────────────────

    private void Seleccionar(int indice) => _seleccion = indice;

    private async Task MoverSeleccion(int paso)
    {
        if (Actual.Venta.Lineas.Count == 0)
            return;
        _seleccion = Math.Clamp(_seleccion + paso, 0, Actual.Venta.Lineas.Count - 1);
        await Js.MostrarAsync($"#linea-{_seleccion}");
    }

    private async Task BorrarSeleccion()
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Actual.Impresiones.Clear();
            Actual.Venta.FijarImpresiones(0, 0);
        }
        else
            Actual.Venta.QuitarLinea(linea);
        _seleccion = Math.Min(_seleccion, Actual.Venta.Lineas.Count - 1);
        await RegistrarQuitadoAsync($"Quitó «{linea.Descripcion}» × {linea.Cantidad} del ticket {Actual.Numero}", linea.ImporteCentavos);
    }

    private async Task CambiarCantidadSeleccion(int paso)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        var nueva = linea.Cantidad + Cantidad.Piezas(paso);
        if (!nueva.EsPositiva)
        {
            await BorrarSeleccion();
            return;
        }
        await FijarCantidadSeleccion(nueva);
    }

    /// <summary>Quitar lo ya escaneado no requiere permiso, pero siempre queda en la bitácora.</summary>
    private async Task RegistrarQuitadoAsync(string detalle, long montoCentavos)
    {
        try
        {
            await Cliente.BitacoraAsync(new SolicitudBitacora(Sesion.UsuarioId, Caja.SucursalId, Caja.Id, AccionControlada.QuitarProducto, detalle, montoCentavos));
        }
        catch (ErrorCaja ex)
        {
            Avisar($"No quedó en la bitácora: {ex.Message}");
        }
    }

    /// <summary>
    /// F11: el mayoreo ya se aplica solo al llegar a la cantidad. Como en eleventa, si se escribieron las piezas (el
    /// paquete) y luego F11, esa es la cantidad del renglón seleccionado; si no, muestra sus escalas.
    /// </summary>
    private async Task MayoreoAsync()
    {
        if (LineaSeleccionada is not { VarianteId: { } varianteId, EsImpresiones: false } linea || !Actual.Productos.ContainsKey(varianteId))
        {
            Avisar("Selecciona un producto (flechas) para ver su mayoreo.");
            return;
        }
        var texto = _captura.Texto.Trim().TrimEnd('*');
        if (texto.Length > 0)
        {
            if (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var piezas) || piezas <= 0)
            {
                Avisar($"Escribe cuántas lleva antes de F11: «{texto}» no es una cantidad.");
                return;
            }
            // Si no se pudo (una fracción en algo por pieza), se queda el error y lo escrito.
            if (!await FijarCantidadSeleccion(Cantidad.Unidades(Math.Round(piezas, 3))))
                return;
            VaciarCaptura();
            if (linea.TieneMayoreo)
                Avisar($"{MayoreoTexto(linea, Actual.Productos[varianteId])}: ahorra {Formato.Dinero(linea.AhorroMayoreoCentavos)}.", error: false);
            else if (linea.PrecioCambiado)
                Avisar("El precio de este renglón se cambió a mano: no aplica el mayoreo.", error: false);
            else if (_mensaje is null)
                Avisar("A esa cantidad no hay mayoreo: F11 sin escribir nada muestra desde cuánto.", error: false);
            return;
        }
        await Abrir(Ventanas.Mayoreo);
    }

    /// <summary>"Mayoreo desde 12", o "desde 24 pzas" en un renglón de paquetes, o "desde 10 m" a granel.</summary>
    private static string MayoreoTexto(VentaLinea linea, ProductoVentaDto? producto) =>
        linea.MayoreoDeCliente ? "Mayoreo de cliente"
            : $"Mayoreo desde {ArmadoTicket.MayoreoTexto(linea.MayoreoDesde!.Value, linea.Unidad, producto?.PresentacionModelo(linea.PresentacionId).EsBase ?? true)}";

    /// <summary>Si se cambió la cantidad; si no, ya avisó por qué.</summary>
    private async Task<bool> FijarCantidadSeleccion(Cantidad cantidad)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
        {
            Avisar("Selecciona un renglón (flechas) para cambiar su cantidad.");
            return false;
        }
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Avisar("Las impresiones se eligen con F2.");
            return false;
        }
        if (linea.VarianteId is not { } varianteId || !Actual.Productos.TryGetValue(varianteId, out var producto))
        {
            Avisar("La cantidad del artículo común no se cambia: bórralo y agrégalo de nuevo.");
            return false;
        }
        var (antes, importeAntes) = (linea.Cantidad, linea.ImporteCentavos);
        try
        {
            Actual.Venta.CambiarCantidad(linea, cantidad, producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo());
            _mensaje = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
            return false;
        }
        if (cantidad < antes)
            await RegistrarQuitadoAsync($"Bajó «{linea.Descripcion}» de {antes} a {cantidad} en el ticket {Actual.Numero}", importeAntes - linea.ImporteCentavos);
        return true;
    }

    // ── Tickets ─────────────────────────────────────────────────────────────

    private Venta VentaVacia() => new()
    {
        SucursalId = Caja.SucursalId,
        CajaId = Caja.Id,
        TurnoId = Turno.Id,
        CajeroId = Sesion.UsuarioId,
        Serie = Caja.Serie,
        CreadaUtc = DateTime.UtcNow,
    };

    private void NuevoTicket()
    {
        _tickets.Add(new TicketAbierto { Numero = _siguienteNumero++, Venta = VentaVacia() });
        _actual = _tickets.Count - 1;
        _seleccion = -1;
        LimpiarCobro();
        _ = Js.EnfocarAsync("#codigo");
        GuardarEspera();
    }

    private void Cambiar(TicketAbierto ticket)
    {
        _actual = _tickets.IndexOf(ticket);
        _seleccion = Actual.Venta.Lineas.Count - 1;
        LimpiarCobro();
        GuardarEspera();
    }

    /// <summary>
    /// Cada vez que cambia el ticket que se atiende (F6, F5, retomar, cobrar, eliminar), los que tienen algo quedan
    /// guardados en la caja. También el que se atiende, como estaba en ese momento: si se va la luz, vuelve en espera.
    /// </summary>
    private void GuardarEspera()
    {
        var conAlgo = _tickets.Where(t => t.Venta.Lineas.Count > 0).ToList();
        // Sin tickets con algo, ni antes ni ahora (lo de casi siempre al cobrar): no hay nada que escribir.
        if (conAlgo.Count == 0 && !_hayEsperaGuardada)
            return;
        try
        {
            Cliente.GuardarEnEspera(conAlgo.Select(t => TicketsEnEspera.Guardar(t.Venta, t.Productos, t.Impresiones, t.Cliente, t.Cuenta, t.FiadoSinConfirmar)).ToList());
            _hayEsperaGuardada = conAlgo.Count > 0;
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException)
        {
            Avisar($"No se pudieron guardar los tickets en espera en esta caja: {ex.Message}");
        }
    }

    /// <summary>Al entrar a la venta, los que quedaron guardados (de antes de un reinicio o un apagón) vuelven a esperar.</summary>
    private void RecuperarEspera()
    {
        List<TicketGuardado> guardados;
        try
        {
            guardados = Cliente.TicketsEnEspera();
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException or System.Text.Json.JsonException)
        {
            Avisar($"No se pudieron leer los tickets en espera de esta caja: {ex.Message}");
            return;
        }
        var perdidas = 0;
        foreach (var guardado in guardados)
        {
            var ticket = new TicketAbierto
            {
                Numero = _siguienteNumero++, Venta = VentaVacia(), Cliente = guardado.Cliente, Cuenta = guardado.Cuenta,
                FiadoSinConfirmar = guardado.FiadoSinConfirmar,
            };
            perdidas += TicketsEnEspera.Rearmar(guardado, ticket.Venta);
            foreach (var producto in guardado.Productos)
                ticket.Productos[producto.VarianteId] = producto;
            ticket.Impresiones.AddRange(guardado.Impresiones);
            if (ticket.Venta.Lineas.Count > 0)
                _tickets.Add(ticket);
        }
        if (_tickets.Count > 0)
            Avisar((_tickets.Count == 1 ? "Volvió el ticket que estaba en espera." : $"Volvieron los {_tickets.Count} tickets que estaban en espera.")
                + (perdidas > 0 ? $" {perdidas} productos ya no se pudieron armar: revísalos." : ""), error: perdidas > 0);
    }

    /// <summary>Si lo último que se guardó tenía tickets: al entrar puede haber de antes, por eso empieza en sí.</summary>
    private bool _hayEsperaGuardada = true;

    private void CambiarSiguiente()
    {
        if (_tickets.Count > 1)
            Cambiar(_tickets[(_actual + 1) % _tickets.Count]);
    }

    private async Task EliminarTicket()
    {
        var venta = Actual.Venta;
        if (venta.Lineas.Count > 0)
            await RegistrarQuitadoAsync($"Eliminó el ticket {Actual.Numero} con {Formato.Numero(venta.NumeroDeArticulos)} productos", venta.TotalCentavos);
        _tickets.RemoveAt(_actual);
        if (_tickets.Count == 0)
            NuevoTicket();
        else
            Cambiar(_tickets[Math.Min(_actual, _tickets.Count - 1)]);
    }

    // ── Cobro e impresión ───────────────────────────────────────────────────

    /// <summary>
    /// Cobra el ticket que se atiende. Quien llama ya apartó la cola (<see cref="EnTurnoDeCobroAsync"/>): se suelta en
    /// cuanto está el ticket del siguiente cliente, antes de imprimir, y lo que se escaneó mientras se cobraba cae ahí. La
    /// ventana de cobro muestra el error que devuelve; null si se cobró.
    /// </summary>
    private async Task<string?> CobrarAsync(IReadOnlyList<CobroSolicitado> cobros, Guid? autorizacionCredito, CapturaCodigo.Apartado apartado)
    {
        var abierto = Actual;
        var venta = abierto.Venta;
        TicketDto ticket;
        try
        {
            // Con el Id del ticket: si la respuesta se pierde, el siguiente intento (en línea o sin conexión) es la misma venta.
            ticket = await Cliente.CobrarAsync(new SolicitudCobro(Caja.Id, Turno.Id, Sesion.UsuarioId, ArmadoSolicitud.Lineas(venta), cobros,
                VentaId: venta.Id, Impresiones: abierto.Impresiones.Count > 0 ? abierto.Impresiones.Select(i => i.Id).ToList() : null,
                ClienteId: venta.ClienteId, AutorizacionDescuentoId: venta.AutorizacionDescuentoId,
                AutorizacionBajoCostoId: venta.AutorizacionBajoCostoId, MayoreoDeCliente: venta.MayoreoDeCliente,
                AutorizacionCreditoId: autorizacionCredito), soloEnLinea: abierto.FiadoSinConfirmar);
        }
        catch (ErrorCaja ex)
        {
            if (ex.Codigo == "fiado-sin-confirmar")
                abierto.FiadoSinConfirmar = true;
            // Si no se pudo fiar (otra caja le fió, le abonaron, venció la autorización…), la ventana sigue abierta con la
            // cuenta al día; los callbacks de las ventanas no vuelven a dibujar esta pantalla.
            if (abierto.Cliente is not null && cobros.Any(c => c.Forma == FormaPago.Credito))
            {
                await CargarCuentaAsync(abierto);
                StateHasChanged();
            }
            return ex.Message;
        }
        // Sale el que se cobró, aunque mientras se haya tocado otro (una ficha en espera).
        _tickets.Remove(abierto);
        // En la pantalla nueva los que esperan se quedan esperando: lo siguiente es un ticket vacío para el siguiente cliente.
        if (_tickets.Count == 0 || _pantallaNueva)
            NuevoTicket();
        else
            Cambiar(_tickets[^1]);
        apartado.Dispose();
        Avisar($"Venta {ticket.FolioImpreso} cobrada. Cambio: {Formato.Dinero(ticket.CambioCentavos)}", error: false);
        _ultimo = ticket;
        if (_pantallaNueva)
            await ImprimirCobradoAsync(ticket);
        else
            await ImprimirAsync(ticket, abrirCajon: ticket.AbreCajon);
        await RevisarEfectivoAsync();
        if (abierto.Impresiones.Count > 0 && _estado is not null)
            await _estado.ActualizarAsync();
        return null;
    }

    // ── Al cobrar en la pantalla nueva: el cambio en grande hasta el siguiente cliente ──

    /// <summary>La venta que se acaba de cobrar: su cambio se queda en el panel hasta que se agrega algo o con Esc.</summary>
    private TicketDto? _cobrado;

    /// <summary>Si el ticket de esa venta no salió: lo que dijo la impresora.</summary>
    private string? _noSalio;

    private bool MostrarCambio => _pantallaNueva && _cobrado is not null && Actual.Venta.Lineas.Count == 0;

    /// <summary>
    /// La venta ya quedó guardada: se imprime aparte y el panel dice si salió. Sin impresora (en el navegador), el ticket
    /// no se abre solo: el panel ofrece verlo; si la impresora no responde, ahí mismo «Reintentar» y «Verlo en pantalla».
    /// </summary>
    private async Task ImprimirCobradoAsync(TicketDto ticket)
    {
        (_cobrado, _noSalio) = (ticket, null);
        await Cerrar();
        if (Impresora.MuestraVistaPrevia)
            return;
        try
        {
            await Impresora.ImprimirAsync(DisenoTicket.Armar(ticket), ticket.AbreCajon);
        }
        catch (Exception ex)
        {
            _noSalio = ex.Message;
        }
        StateHasChanged();
    }

    private async Task VerCobradoEnPantallaAsync()
    {
        if (_cobrado is not { } ticket)
            return;
        _vistaPrevia = ($"Ticket {ticket.FolioImpreso}", TicketTexto.Generar(DisenoTicket.Armar(ticket)));
        await Abrir(Ventanas.VistaPrevia);
    }

    /// <summary>«Pagó con $200.00 · total $137.00», y las otras formas si las hubo.</summary>
    private static string PagoTexto(TicketDto ticket)
    {
        var recibido = ticket.Cobros.Where(c => c.Forma == FormaPago.Efectivo).Sum(c => c.RecibidoCentavos);
        var partes = new List<string>();
        if (recibido > 0)
            partes.Add($"Pagó con {Formato.Dinero(recibido)}");
        partes.Add($"total {Formato.Dinero(ticket.TotalCobradoCentavos)}");
        partes.AddRange(ticket.Cobros.Where(c => c.Forma != FormaPago.Efectivo).Select(c => c.Forma switch
        {
            FormaPago.Tarjeta => $"tarjeta {Formato.Dinero(c.MontoCentavos)}",
            FormaPago.Transferencia => $"transferencia {Formato.Dinero(c.MontoCentavos)}",
            _ => $"a crédito {Formato.Dinero(c.MontoCentavos)}",
        }));
        return string.Join(" · ", partes);
    }

    private Task ImprimirAsync(TicketDto ticket, bool abrirCajon) =>
        ImprimirDocumentoAsync($"Ticket {ticket.FolioImpreso}", DisenoTicket.Armar(ticket), abrirCajon);

    private async Task ImprimirDocumentoAsync(string titulo, IReadOnlyList<Elemento> documento, bool abrirCajon)
    {
        if (Impresora.MuestraVistaPrevia)
        {
            _vistaPrevia = (titulo, TicketTexto.Generar(documento));
            await Abrir(Ventanas.VistaPrevia);
            return;
        }

        // Primero se cierra la ventana y se ve la pantalla lista; la impresora tarda un par de segundos con el logo.
        await Cerrar();
        try
        {
            await Impresora.ImprimirAsync(documento, abrirCajon);
        }
        catch (Exception ex)
        {
            Avisar($"No se pudo imprimir ({titulo}): {ex.Message} Se puede reimprimir.");
            StateHasChanged();
        }
    }

