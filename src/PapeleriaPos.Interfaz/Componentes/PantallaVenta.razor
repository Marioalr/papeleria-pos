@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;
    [Parameter, EditorRequired] public TurnoDto Turno { get; set; } = null!;
    [Parameter] public EventCallback AlSalir { get; set; }
    [Parameter] public EventCallback AlCerrarTurno { get; set; }

    private enum Ventanas
    {
        Ninguna, Cobrar, Buscar, Comun, Entrada, Salida, Verificador, Corte, VentasDelDia, VistaPrevia, Configuracion, Motivo, Devolucion,
        CambiarPrecio, Transferencias, Impresiones, Cotizar, Descuento, Productos, AltaRapida, Inventario, Conteo, Mayoreo, ElegirCliente, Clientes,
        AutorizarCosto, Abono,
    }

    /// <summary>El conteo cíclico de hoy: cuántos faltan, para pedirlo en la franja.</summary>
    private ConteoCiclicoDto? _conteo;

    private bool HayConteoPendiente => _conteo is { } conteo && conteo.Contados < conteo.Total;

    // ── Las franjas de arriba: las mismas en las dos pantallas ──────────────

    /// <summary>Se pide al abrir el turno; se cuenta cuando haya calma.</summary>
    private RenderFragment FranjaConteo => @<div class="franja-conteo">
        Conteo del día: faltan @(_conteo!.Total - _conteo.Contados) de @_conteo.Total productos por contar.
        <button class="boton chico" @onclick="() => Abrir(Ventanas.Conteo)">Contar ahora</button>
    </div>;

    /// <summary>Si el cliente del ticket debe, la caja lo dice al elegirlo, para cobrarlo en esta compra (fase 3).</summary>
    private RenderFragment FranjaCredito => @<div class="franja-credito @(VencidoDelTicket > 0 ? "vencido" : "")">
        @if (Actual.Cuenta!.SaldoCentavos > 0)
        {
            <span>@Actual.Cliente!.Nombre debe @Formato.Dinero(Actual.Cuenta.SaldoCentavos)@(Actual.Cuenta.VenceMasAntiguo is { } vence ? $" · vence {vence:dd/MM}" : "")@(VencidoDelTicket > 0 ? $" · vencido {Formato.Dinero(VencidoDelTicket)}" : "")@(Actual.Cuenta.Estimado ? " (según esta caja)" : "")</span>
            <button class="boton chico" @onclick="() => Abrir(Ventanas.Abono)">CTRL+B Abonar</button>
        }
        else
        {
            <span>@Actual.Cliente!.Nombre tiene @Formato.Dinero(Actual.Cuenta.AFavorCentavos) a favor: se usa con «A crédito» al cobrar.</span>
        }
    </div>;

    private long VencidoDelTicket => Actual.Cuenta?.Vencido(DateOnly.FromDateTime(HoraMexico.ALocal(DateTime.UtcNow))) ?? 0;

    // ── La pantalla nueva (docs/propuesta-interfaz.md, entrega 0) ───────────

    /// <summary>Cada caja elige su pantalla; se recuerda en el navegador de esta PC.</summary>
    private const string ClavePantalla = "pantalla-venta";

    private bool _pantallaNueva;

    /// <summary>Lo que se enfoca después de dibujar (el cuadro del código, o «Pagó con» con F12).</summary>
    private string? _enfocar;

    private async Task CambiarPantallaAsync()
    {
        _pantallaNueva = !_pantallaNueva;
        // El cuadro de la otra pantalla empieza vacío.
        _captura.Texto = "";
        await Js.GuardarAsync(ClavePantalla, _pantallaNueva ? "nueva" : null);
        if (_pantallaNueva && _rapidos.Count == 0)
            await CargarRapidosAsync();
        _enfocar = "#codigo";
    }

    /// <summary>Un rápido con el producto al que apunta (para su precio); sin conexión al cargar, el producto se pide al usarlo.</summary>
    private sealed record RapidoListo(Rapido Rapido, ProductoVentaDto? Producto, long? PrecioCentavos);

    private List<RapidoListo> _rapidos = [];

    private async Task CargarRapidosAsync()
    {
        try
        {
            var listos = new List<RapidoListo>();
            foreach (var rapido in (await Cliente.RapidosAsync(Caja.SucursalId)).Take(Rapido.Maximo))
            {
                var producto = await Cliente.PorVarianteAsync(rapido.VarianteId, Caja.SucursalId);
                listos.Add(new RapidoListo(rapido, producto, producto is null ? null : (long)Math.Round(PrecioMenudeo(producto) * rapido.Cantidad)));
            }
            _rapidos = listos;
        }
        catch (ErrorCaja)
        {
            // Sin conexión, la fila queda sin rápidos; al volver a entrar se cargan.
            _rapidos = [];
        }
    }

    /// <summary>El precio por pieza de menudeo: el de la sucursal si tiene, si no el general.</summary>
    private long PrecioMenudeo(ProductoVentaDto producto)
    {
        var porUnidad = producto.Precios.Where(p => p.PresentacionId is null).ToList();
        var deSucursal = porUnidad.Where(p => p.SucursalId == Caja.SucursalId).ToList();
        return (deSucursal.Count > 0 ? deSucursal : porUnidad.Where(p => p.SucursalId is null)).MinBy(p => p.CantidadMinimaMilesimas)?.PrecioCentavos ?? 0;
    }

    /// <summary>Alt+1 a Alt+6 o el botón. Un número en el cuadro es cuántos: «20» y Alt+1 son veinte copias.</summary>
    private async Task RapidoAsync(int indice)
    {
        if (indice < 0 || indice >= _rapidos.Count)
            return;
        var (rapido, producto, _) = _rapidos[indice];
        var texto = _captura.Texto.Trim();
        var veces = 1m;
        if (texto.Length > 0 && (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out veces) || veces <= 0))
        {
            Avisar($"Antes de un rápido solo va la cantidad: «{texto}» no lo es.");
            return;
        }
        VaciarCaptura();
        _enfocar = "#codigo";
        try
        {
            producto ??= await Cliente.PorVarianteAsync(rapido.VarianteId, Caja.SucursalId);
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
            return;
        }
        if (producto is null)
        {
            Avisar($"El producto del rápido «{rapido.Nombre}» ya no está en el catálogo: hay que elegirlo otra vez en Configuración.");
            return;
        }
        Agregar(producto, null, Cantidad.Unidades(Math.Round(veces * rapido.Cantidad, 3)));
    }

    /// <summary>Los tickets en espera: los que tienen algo y no son el que se atiende, en el orden en que se apartaron.</summary>
    private IEnumerable<TicketAbierto> EnEspera => _tickets.Where(t => t != Actual && t.Venta.Lineas.Count > 0);

    private static string Desde(TicketAbierto ticket) => HoraMexico.ALocal(ticket.Venta.CreadaUtc).ToString("HH:mm");

    /// <summary>F6: guarda este ticket y deja la caja lista para el siguiente cliente.</summary>
    private void PonerEnEspera()
    {
        if (Actual.Venta.Lineas.Count == 0)
        {
            Avisar("El ticket está vacío: no hay nada que poner en espera.", error: false);
            return;
        }
        NuevoTicket();
        _pagoCon = "";
        Avisar("Ticket en espera. Atiende al siguiente; lo retomas arriba o con F5.", error: false);
    }

    /// <summary>Retomar un ticket en espera: el que se atendía pasa a la espera (si estaba vacío, se descarta).</summary>
    private void Retomar(TicketAbierto ticket)
    {
        if (Actual.Venta.Lineas.Count == 0 && Actual != ticket)
            _tickets.Remove(Actual);
        Cambiar(ticket);
        _pagoCon = "";
        _enfocar = "#codigo";
        Avisar($"Retomaste el ticket de las {Desde(ticket)}.", error: false);
    }

    /// <summary>F5: el que lleva más tiempo esperando.</summary>
    private void RetomarPrimero()
    {
        if (EnEspera.FirstOrDefault() is { } ticket)
            Retomar(ticket);
        else
            Avisar("No hay tickets en espera.", error: false);
    }

    /// <summary>Los botones − y + de la fila: cambian la cantidad de ese renglón.</summary>
    private async Task PasoCantidadAsync(int indice, int paso)
    {
        _seleccion = indice;
        await CambiarCantidadSeleccion(paso);
        _enfocar = "#codigo";
    }

    // ── El cobro en el panel: «Pagó con» siempre a la vista ─────────────────

    /// <summary>Lo que dio el cliente. Vacío: se cobra exacto (el exacto se ve en gris en el cuadro).</summary>
    private string _pagoCon = "";

    private bool _enPago;
    private bool _cobrando;

    private EfectivoACobrar EnEfectivo => Actual.Venta.Efectivo(0);

    private long? PagoConCentavos => _pagoCon.Trim().Length == 0 ? EnEfectivo.ACobrarCentavos : Formato.LeerPesos(_pagoCon);

    private long Recibido => PagoConCentavos ?? 0;

    /// <summary>
    /// F12: el cursor va a «Pagó con» y lo demás se apaga. Con un cliente registrado (su crédito, su saldo a favor), el
    /// cobro de hoy. Con el cursor ya en «Pagó con», F12 cobra como Enter.
    /// </summary>
    private async Task IrAlCobroAsync()
    {
        if (Actual.Venta.Lineas.Count == 0)
            return;
        if (Actual.Cliente is not null)
            await AbrirCobroAsync();
        else if (_enPago)
            await CobrarEnPanelAsync();
        else
            _enfocar = "#pago-nuevo";
    }

    private async Task AlTeclearPago(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CobrarEnPanelAsync();
    }

    /// <summary>Enter en «Pagó con»: sin escribir nada, exacto; con lo que dio, da el cambio. Todo en efectivo.</summary>
    private async Task CobrarEnPanelAsync()
    {
        if (_cobrando || Actual.Venta.Lineas.Count == 0)
            return;
        if (Actual.Cliente is not null)
        {
            await AbrirCobroAsync();
            return;
        }
        var aCobrar = EnEfectivo.ACobrarCentavos;
        if (PagoConCentavos is null)
        {
            Avisar($"«{_pagoCon}» no es una cantidad.");
            return;
        }
        if (Recibido < aCobrar)
        {
            Avisar($"Faltan {Formato.Dinero(aCobrar - Recibido)}.");
            return;
        }
        if (!await RevisarCostoAsync())
            return;
        _cobrando = true;
        try
        {
            if (await CobrarAsync([new CobroSolicitado(FormaPago.Efectivo, Recibido)], null) is { } error)
                Avisar(error);
            else
            {
                _pagoCon = "";
                _enfocar = "#codigo";
            }
        }
        finally
        {
            _cobrando = false;
        }
    }

    private async Task RevisarConteoAsync()
    {
        try
        {
            _conteo = await Cliente.ConteoDelDiaAsync(Caja.SucursalId, Sesion.UsuarioId);
        }
        catch (ErrorCaja)
        {
            // Sin conexión no se pide: el conteo espera a que vuelva.
        }
    }

    private sealed class TicketAbierto
    {
        public required Venta Venta { get; init; }
        public required int Numero { get; init; }
        public Dictionary<Guid, ProductoVentaDto> Productos { get; } = [];

        /// <summary>Los trabajos de impresión que van en la línea "Impresiones" de este ticket.</summary>
        public List<ImpresionPorCobrarDto> Impresiones { get; } = [];

        /// <summary>El cliente registrado del ticket: lo que se agregue después también lleva su descuento y su mayoreo.</summary>
        public ClienteRegistradoDto? Cliente { get; set; }

        /// <summary>Su cuenta (lo que debe, su límite): se pide al elegirlo y otra vez antes de cobrar.</summary>
        public CreditoClienteDto? Cuenta { get; set; }

        /// <summary>Se mandó a fiar y se perdió la respuesta: puede que ya esté guardado. Solo se cobra en línea, con el mismo Id.</summary>
        public bool FiadoSinConfirmar { get; set; }
    }

    private readonly List<TicketAbierto> _tickets = [];
    private TicketAbierto Actual => _tickets[_actual];
    private int _actual;
    private int _seleccion = -1;
    private int _siguienteNumero = 1;
    private readonly CapturaCodigo _captura = new();
    private string? _mensaje;
    private bool _mensajeEsError;
    private TicketDto? _ultimo;
    private (string Titulo, string Texto)? _vistaPrevia;
    private Ventanas _ventana;
    private DotNetObjectReference<PantallaVenta>? _referencia;

    protected override void OnInitialized()
    {
        RecuperarEspera();
        NuevoTicket();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (_enfocar is { } selector)
        {
            _enfocar = null;
            await Js.EnfocarAsync(selector);
        }
        if (!primera)
            return;
        _referencia = DotNetObjectReference.Create(this);
        await Js.RegistrarTeclasAsync(_referencia);
        await Js.EnfocarAsync("#codigo");
        if (await Js.LeerAsync(ClavePantalla) == "nueva")
        {
            _pantallaNueva = true;
            _enfocar = "#codigo";
        }
        await CargarRapidosAsync();
        await RevisarEfectivoAsync();
        await RevisarConteoAsync();
        StateHasChanged();
    }

    /// <summary>El Enter del cuadro de captura de la pantalla nueva: caja.js ya tomó el texto y vació el cuadro.</summary>
    [JSInvokable]
    public async Task Escaneado(string texto)
    {
        if (_ventana != Ventanas.Ninguna)
            return;
        // Con ↑ ↓ se eligió uno de la lista de resultados: Enter agrega ese.
        if (_resultados is { Count: > 0 } resultados && _navegado && SepararCantidad(texto).Texto == _textoBuscado)
        {
            var (elegido, cantidad, buscado) = (resultados[_indiceResultado], _cantidadBuscada, _textoBuscado);
            CerrarResultados();
            await _captura.EsperarAsync();
            await AgregarResultadoAsync(elegido, cantidad, buscado, resultados.Count);
            StateHasChanged();
            return;
        }
        CerrarResultados();
        _captura.Texto = texto;
        var escaneo = AgregarCodigoAsync();
        StateHasChanged();
        await escaneo;
        StateHasChanged();
    }

    /// <summary>
    /// Lo que se escribe a mano en el cuadro de la pantalla nueva, al dejar de teclear: la cantidad de un rápido o de
    /// F11, o un nombre, que se busca aquí mismo.
    /// </summary>
    [JSInvokable]
    public async Task Escribiendo(string texto)
    {
        _captura.Texto = texto;
        if (_pantallaNueva && _ventana == Ventanas.Ninguna)
            await BuscarMientrasEscribeAsync(texto);
    }

    // ── La búsqueda debajo del cuadro (pantalla nueva) ──────────────────────

    private const int MaximoResultados = 30;

    /// <summary>Lo que sale al escribir; null: la lista está cerrada.</summary>
    private List<ResultadoBusquedaDto>? _resultados;

    private string _textoBuscado = "";
    private string[] _partesBuscadas = [];
    private Cantidad _cantidadBuscada = Cantidad.Piezas(1);
    private int _indiceResultado;

    /// <summary>Se movió con ↑ ↓: Enter agrega el elegido y no busca el texto como código.</summary>
    private bool _navegado;

    /// <summary>Cada búsqueda lleva su número: si llega tarde (ya se escribió otra cosa), no se muestra.</summary>
    private int _secuenciaBusqueda;

    /// <summary>«3*cuad» → 3 y «cuad»: lo de antes del asterisco es la cantidad.</summary>
    private static (Cantidad Cantidad, string Texto) SepararCantidad(string texto)
    {
        texto = texto.Trim();
        var asterisco = texto.IndexOf('*');
        return asterisco > 0 && decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) && n > 0
            ? (Cantidad.Unidades(Math.Round(n, 3)), texto[(asterisco + 1)..].Trim())
            : (Cantidad.Piezas(1), texto);
    }

    /// <summary>Un nombre (o un código corto con letras), no un código del lector ni un folio.</summary>
    private static bool EsTextoDeBusqueda(string texto) => texto.Length >= 2 && texto.Any(char.IsLetter) && !FolioTicket.IsMatch(texto);

    private async Task BuscarMientrasEscribeAsync(string texto)
    {
        var (cantidad, resto) = SepararCantidad(texto);
        var secuencia = ++_secuenciaBusqueda;
        if (!EsTextoDeBusqueda(resto))
        {
            if (_resultados is not null)
            {
                _resultados = null;
                StateHasChanged();
            }
            return;
        }
        try
        {
            var resultados = await Cliente.BuscarAsync(resto, Caja.SucursalId, Caja.Id);
            if (secuencia != _secuenciaBusqueda)
                return;
            (_resultados, _textoBuscado, _cantidadBuscada, _indiceResultado, _navegado) = (resultados, resto, cantidad, 0, false);
            _partesBuscadas = Texto.Normalizar(resto).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
        StateHasChanged();
    }

    private void CerrarResultados()
    {
        _resultados = null;
        _navegado = false;
        _secuenciaBusqueda++;
    }

    private void MoverResultado(int paso)
    {
        if (_resultados is not { Count: > 0 } resultados)
            return;
        _indiceResultado = Math.Clamp(_indiceResultado + paso, 0, resultados.Count - 1);
        _navegado = true;
        _ = Js.MostrarAsync($"#res-{_indiceResultado}");
    }

    /// <summary>Un clic en un resultado.</summary>
    private async Task ElegirResultadoAsync(int indice)
    {
        if (_resultados is not { } resultados || indice < 0 || indice >= resultados.Count)
            return;
        var (elegido, cantidad, buscado) = (resultados[indice], _cantidadBuscada, _textoBuscado);
        CerrarResultados();
        VaciarCaptura();
        _enfocar = "#codigo";
        await _captura.EsperarAsync();
        await AgregarResultadoAsync(elegido, cantidad, buscado, resultados.Count);
    }

    /// <summary>
    /// Agrega lo elegido y anota qué se eligió con ese texto: la próxima vez, en esta caja, sale primero. Fuera de la cola
    /// de escaneos, quien llama espera antes a que termine el último (dentro de la cola se esperaría a sí mismo).
    /// </summary>
    private async Task AgregarResultadoAsync(ResultadoBusquedaDto resultado, Cantidad cantidad, string buscado, int resultados)
    {
        _ = Cliente.RegistrarBusquedaAsync(new SolicitudBusqueda(Caja.Id, buscado, resultados, resultado.VarianteId));
        try
        {
            if (await Cliente.PorVarianteAsync(resultado.VarianteId, Caja.SucursalId) is { } producto)
                Agregar(producto, null, cantidad);
            else
                Avisar("Ese producto ya no está en el catálogo.");
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    /// <summary>
    /// Enter con un nombre que no es código, sin elegir de la lista: agrega el primero (lo elegido antes o lo más vendido).
    /// Si no sale nada, lo dice y lo anota, para darlo de alta o hacerlo sinónimo después.
    /// </summary>
    private async Task AgregarPrimeroAsync(string texto, Cantidad cantidad)
    {
        var resultados = await Cliente.BuscarAsync(texto, Caja.SucursalId, Caja.Id);
        if (resultados.Count == 0)
        {
            _ = Cliente.RegistrarBusquedaAsync(new SolicitudBusqueda(Caja.Id, texto, 0, null));
            Avisar($"Nada coincide con «{texto}». Revisa cómo se escribe, o véndelo como artículo común (Ins).");
            return;
        }
        await AgregarResultadoAsync(resultados[0], cantidad, texto, resultados.Count);
    }

    private static string ExistenciaTexto(decimal? existencia) => existencia switch
    {
        null => "Servicio",
        <= 0 => "Sin existencia",
        <= 3 => $"Quedan {Formato.Numero(existencia.Value)}",
        _ => $"{Formato.Numero(existencia.Value)} en tienda",
    };

    /// <summary>El texto con el principio de cada palabra que coincide con lo escrito, resaltado.</summary>
    private RenderFragment Marcado(string texto) => @<span>@foreach (var (parte, marcada) in Segmentos(texto, _partesBuscadas))
        {
            if (marcada)
            {
                <mark>@parte</mark>
            }
            else
            {
                @parte
            }
        }</span>;

    private static IEnumerable<(string Parte, bool Marcada)> Segmentos(string texto, string[] partes)
    {
        if (texto.Length == 0)
            yield break;
        // Cada carácter normalizado por separado: la misma longitud que el texto, para marcar en su lugar.
        var plano = string.Concat(texto.Select(c => char.IsWhiteSpace(c) ? " " : Texto.Normalizar(c.ToString()) is { Length: 1 } n ? n : "·"));
        var marca = new bool[texto.Length];
        for (var i = 0; i < texto.Length; i++)
        {
            if (i > 0 && char.IsLetterOrDigit(texto[i - 1]))
                continue;
            foreach (var parte in partes)
            {
                if (!plano.AsSpan(i).StartsWith(parte, StringComparison.Ordinal))
                    continue;
                for (var k = i; k < i + parte.Length; k++)
                    marca[k] = true;
                break;
            }
        }
        var inicio = 0;
        for (var i = 1; i <= texto.Length; i++)
        {
            if (i < texto.Length && marca[i] == marca[inicio])
                continue;
            yield return (texto[inicio..i], marca[inicio]);
            inicio = i;
        }
    }

    /// <summary>Vacía el cuadro de captura, también en la pantalla nueva, donde no está enlazado.</summary>
    private void VaciarCaptura()
    {
        _captura.Texto = "";
        if (_pantallaNueva)
            _ = Js.LimpiarCapturaAsync();
    }

    /// <param name="tecla">La tecla, como la nombra caja.js.</param>
    /// <param name="texto">En la pantalla nueva, lo que había en el cuadro de captura (no está enlazado); si no, null.</param>
    [JSInvokable]
    public async Task Tecla(string tecla, string? texto)
    {
        if (_pantallaNueva && texto is not null)
            _captura.Texto = texto;
        if (_ventana != Ventanas.Ninguna)
        {
            if (tecla == "Escape")
                await Cerrar();
            return;
        }

        // Con un nombre en el cuadro, ↑ ↓ recorren los resultados (si se teclearon antes de que salieran, se busca ya).
        if (_pantallaNueva && tecla is "ArrowUp" or "ArrowDown" && texto is not null && EsTextoDeBusqueda(SepararCantidad(texto).Texto))
        {
            if (_resultados is null || SepararCantidad(texto).Texto != _textoBuscado)
                await BuscarMientrasEscribeAsync(texto);
            MoverResultado(tecla == "ArrowUp" ? -1 : 1);
            StateHasChanged();
            return;
        }
        // Cualquier otra tecla (Esc, F12, F6…) cierra la lista.
        if (_resultados is not null)
            CerrarResultados();

        // Las teclas que actúan sobre el ticket esperan a que termine el último escaneo: F12 no abre el cobro sin la
        // última línea, ni F6 manda un escaneo al ticket nuevo.
        if (tecla is "F12" or "F6" or "F5" or "+" or "-" or "Delete" or "F11" || tecla.StartsWith("Alt+", StringComparison.Ordinal))
            await _captura.EsperarAsync();

        switch (tecla)
        {
            case "F10": await Abrir(Ventanas.Buscar); break;
            case "F12" when _pantallaNueva: await IrAlCobroAsync(); break;
            case "F12" when Actual.Venta.Lineas.Count > 0: await AbrirCobroAsync(); break;
            case "F5" when _pantallaNueva: RetomarPrimero(); break;
            case "F5": CambiarSiguiente(); break;
            case "F6" when _pantallaNueva: PonerEnEspera(); break;
            case "F6": NuevoTicket(); break;
            case ['A', 'l', 't', '+', var numero] when _pantallaNueva && numero is >= '1' and <= '6': await RapidoAsync(numero - '1'); break;
            case "F7": await Abrir(Ventanas.Entrada); break;
            case "F8": await Abrir(Ventanas.Salida); break;
            case "F9": await Abrir(Ventanas.Verificador); break;
            case "F2": await Abrir(Ventanas.Impresiones); break;
            case "Insert" or "Ctrl+P": await Abrir(Ventanas.Comun); break;
            case "Ctrl+E": await AbrirCambioPrecio(); break;
            case "Ctrl+D": await Abrir(Ventanas.Descuento); break;
            case "Ctrl+L": await Abrir(Ventanas.ElegirCliente); break;
            case "Ctrl+B": await Abrir(Ventanas.Abono); break;
            case "Delete": await BorrarSeleccion(); break;
            case "ArrowUp": await MoverSeleccion(-1); break;
            case "ArrowDown": await MoverSeleccion(1); break;
            case "+": await CambiarCantidadSeleccion(1); break;
            case "-": await CambiarCantidadSeleccion(-1); break;
            case "F11": await MayoreoAsync(); break;
            case "F3": await Abrir(Ventanas.Productos); break;
            case "F4": await Abrir(Ventanas.Inventario); break;
            case "Escape":
                VaciarCaptura();
                _mensaje = null;
                if (_pantallaNueva)
                {
                    // Desde «Pagó con», Esc borra lo escrito y regresa al cuadro del código sin cobrar.
                    _pagoCon = "";
                    _enfocar = "#codigo";
                }
                break;
        }
        StateHasChanged();
    }

    // ── Captura ─────────────────────────────────────────────────────────────

    private async Task AlTeclearCodigo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AgregarCodigoAsync();
    }

    /// <summary>El cuadro se vacía al momento y el escaneo espera su turno: el lector no espera a la red.</summary>
    private Task AgregarCodigoAsync() => _captura.EnterAsync(ProcesarCodigoAsync);

    /// <summary>
    /// "7501…" agrega una pieza; "3*7501…" agrega tres; "5*" cambia la cantidad del renglón seleccionado. El QR de un
    /// ticket ("A-000123") abre la devolución.
    /// </summary>
    private async Task ProcesarCodigoAsync(string texto)
    {
        if (FolioTicket.IsMatch(texto))
        {
            await AbrirDevolucion(texto.ToUpperInvariant());
            return;
        }

        var cantidad = Cantidad.Piezas(1);
        var asterisco = texto.IndexOf('*');
        if (asterisco > 0)
        {
            if (!decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) || n <= 0)
            {
                Avisar($"Cantidad inválida: «{texto[..asterisco]}».");
                return;
            }
            cantidad = Cantidad.Unidades(Math.Round(n, 3));
            texto = texto[(asterisco + 1)..].Trim();
            if (texto.Length == 0)
            {
                await FijarCantidadSeleccion(cantidad);
                return;
            }
        }

        try
        {
            var producto = await Cliente.PorCodigoAsync(texto, Caja.SucursalId);
            if (producto is null && _pantallaNueva && PareceNombre(texto))
            {
                // En la pantalla nueva el nombre se busca aquí mismo: Enter agrega el primero de la lista («3*cuad» también).
                await AgregarPrimeroAsync(texto, cantidad);
                return;
            }
            if (producto is null && asterisco < 0 && PareceNombre(texto))
            {
                // Como en eleventa, se escribe el nombre donde va el código: se busca por nombre en vez de ofrecer el alta.
                _buscarTexto = texto;
                await Abrir(Ventanas.Buscar);
                return;
            }
            if (producto is null)
            {
                Avisar($"No existe el código «{texto}». F10 para buscar por nombre, o dalo de alta.");
                _codigoNuevo = texto;
                return;
            }
            Agregar(producto, null, cantidad);
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarVarianteAsync(Guid varianteId)
    {
        await Cerrar();
        try
        {
            if (await Cliente.PorVarianteAsync(varianteId, Caja.SucursalId) is { } producto)
                Agregar(producto, null, Cantidad.Piezas(1));
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    private void Agregar(ProductoVentaDto producto, Guid? presentacionId, Cantidad cantidad)
    {
        try
        {
            var linea = Actual.Venta.AgregarProducto(producto.ParaVenta(), producto.PresentacionModelo(presentacionId), cantidad, producto.PreciosModelo());
            DescuentoDelCliente(linea);
            Actual.Productos[producto.VarianteId] = producto;
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
            _mensaje = null;
            _ = Js.MostrarAsync($"#linea-{_seleccion}");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarComun((string Descripcion, long Precio, Cantidad Cantidad) articulo)
    {
        await Cerrar();
        try
        {
            var linea = Actual.Venta.AgregarArticuloComun(articulo.Descripcion, articulo.Precio, articulo.Cantidad);
            DescuentoDelCliente(linea);
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    // ── Renglones ───────────────────────────────────────────────────────────

    private void Seleccionar(int indice) => _seleccion = indice;

    private async Task MoverSeleccion(int paso)
    {
        if (Actual.Venta.Lineas.Count == 0)
            return;
        _seleccion = Math.Clamp(_seleccion + paso, 0, Actual.Venta.Lineas.Count - 1);
        await Js.MostrarAsync($"#linea-{_seleccion}");
    }

    private async Task BorrarSeleccion()
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Actual.Impresiones.Clear();
            Actual.Venta.FijarImpresiones(0, 0);
        }
        else
            Actual.Venta.QuitarLinea(linea);
        _seleccion = Math.Min(_seleccion, Actual.Venta.Lineas.Count - 1);
        await RegistrarQuitadoAsync($"Quitó «{linea.Descripcion}» × {linea.Cantidad} del ticket {Actual.Numero}", linea.ImporteCentavos);
    }

    private async Task CambiarCantidadSeleccion(int paso)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        var nueva = linea.Cantidad + Cantidad.Piezas(paso);
        if (!nueva.EsPositiva)
        {
            await BorrarSeleccion();
            return;
        }
        await FijarCantidadSeleccion(nueva);
    }

    /// <summary>Quitar lo ya escaneado no requiere permiso, pero siempre queda en la bitácora.</summary>
    private async Task RegistrarQuitadoAsync(string detalle, long montoCentavos)
    {
        try
        {
            await Cliente.BitacoraAsync(new SolicitudBitacora(Sesion.UsuarioId, Caja.SucursalId, Caja.Id, AccionControlada.QuitarProducto, detalle, montoCentavos));
        }
        catch (ErrorCaja ex)
        {
            Avisar($"No quedó en la bitácora: {ex.Message}");
        }
    }

    /// <summary>
    /// F11: el mayoreo ya se aplica solo al llegar a la cantidad. Como en eleventa, si se escribieron las piezas (el
    /// paquete) y luego F11, esa es la cantidad del renglón seleccionado; si no, muestra sus escalas.
    /// </summary>
    private async Task MayoreoAsync()
    {
        if (LineaSeleccionada is not { VarianteId: { } varianteId, EsImpresiones: false } linea || !Actual.Productos.ContainsKey(varianteId))
        {
            Avisar("Selecciona un producto (flechas) para ver su mayoreo.");
            return;
        }
        var texto = _captura.Texto.Trim().TrimEnd('*');
        if (texto.Length > 0)
        {
            if (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var piezas) || piezas <= 0)
            {
                Avisar($"Escribe cuántas lleva antes de F11: «{texto}» no es una cantidad.");
                return;
            }
            // Si no se pudo (una fracción en algo por pieza), se queda el error y lo escrito.
            if (!await FijarCantidadSeleccion(Cantidad.Unidades(Math.Round(piezas, 3))))
                return;
            VaciarCaptura();
            if (linea.TieneMayoreo)
                Avisar($"{MayoreoTexto(linea, Actual.Productos[varianteId])}: ahorra {Formato.Dinero(linea.AhorroMayoreoCentavos)}.", error: false);
            else if (linea.PrecioCambiado)
                Avisar("El precio de este renglón se cambió a mano: no aplica el mayoreo.", error: false);
            else if (_mensaje is null)
                Avisar("A esa cantidad no hay mayoreo: F11 sin escribir nada muestra desde cuánto.", error: false);
            return;
        }
        await Abrir(Ventanas.Mayoreo);
    }

    /// <summary>"Mayoreo desde 12", o "desde 24 pzas" en un renglón de paquetes, o "desde 10 m" a granel.</summary>
    private static string MayoreoTexto(VentaLinea linea, ProductoVentaDto? producto) =>
        linea.MayoreoDeCliente ? "Mayoreo de cliente"
            : $"Mayoreo desde {ArmadoTicket.MayoreoTexto(linea.MayoreoDesde!.Value, linea.Unidad, producto?.PresentacionModelo(linea.PresentacionId).EsBase ?? true)}";

    /// <summary>Si se cambió la cantidad; si no, ya avisó por qué.</summary>
    private async Task<bool> FijarCantidadSeleccion(Cantidad cantidad)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
        {
            Avisar("Selecciona un renglón (flechas) para cambiar su cantidad.");
            return false;
        }
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Avisar("Las impresiones se eligen con F2.");
            return false;
        }
        if (linea.VarianteId is not { } varianteId || !Actual.Productos.TryGetValue(varianteId, out var producto))
        {
            Avisar("La cantidad del artículo común no se cambia: bórralo y agrégalo de nuevo.");
            return false;
        }
        var (antes, importeAntes) = (linea.Cantidad, linea.ImporteCentavos);
        try
        {
            Actual.Venta.CambiarCantidad(linea, cantidad, producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo());
            _mensaje = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
            return false;
        }
        if (cantidad < antes)
            await RegistrarQuitadoAsync($"Bajó «{linea.Descripcion}» de {antes} a {cantidad} en el ticket {Actual.Numero}", importeAntes - linea.ImporteCentavos);
        return true;
    }

    // ── Tickets ─────────────────────────────────────────────────────────────

    private Venta VentaVacia() => new()
    {
        SucursalId = Caja.SucursalId,
        CajaId = Caja.Id,
        TurnoId = Turno.Id,
        CajeroId = Sesion.UsuarioId,
        Serie = Caja.Serie,
        CreadaUtc = DateTime.UtcNow,
    };

    private void NuevoTicket()
    {
        _tickets.Add(new TicketAbierto { Numero = _siguienteNumero++, Venta = VentaVacia() });
        _actual = _tickets.Count - 1;
        _seleccion = -1;
        _ = Js.EnfocarAsync("#codigo");
        GuardarEspera();
    }

    private void Cambiar(TicketAbierto ticket)
    {
        _actual = _tickets.IndexOf(ticket);
        _seleccion = Actual.Venta.Lineas.Count - 1;
        GuardarEspera();
    }

    /// <summary>
    /// Cada vez que cambia el ticket que se atiende (F6, F5, retomar, cobrar, eliminar), los que tienen algo quedan
    /// guardados en la caja. También el que se atiende, como estaba en ese momento: si se va la luz, vuelve en espera.
    /// </summary>
    private void GuardarEspera()
    {
        var conAlgo = _tickets.Where(t => t.Venta.Lineas.Count > 0).ToList();
        // Sin tickets con algo, ni antes ni ahora (lo de casi siempre al cobrar): no hay nada que escribir.
        if (conAlgo.Count == 0 && !_hayEsperaGuardada)
            return;
        try
        {
            Cliente.GuardarEnEspera(conAlgo.Select(t => TicketsEnEspera.Guardar(t.Venta, t.Productos, t.Impresiones, t.Cliente, t.Cuenta, t.FiadoSinConfirmar)).ToList());
            _hayEsperaGuardada = conAlgo.Count > 0;
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException)
        {
            Avisar($"No se pudieron guardar los tickets en espera en esta caja: {ex.Message}");
        }
    }

    /// <summary>Al entrar a la venta, los que quedaron guardados (de antes de un reinicio o un apagón) vuelven a esperar.</summary>
    private void RecuperarEspera()
    {
        List<TicketGuardado> guardados;
        try
        {
            guardados = Cliente.TicketsEnEspera();
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException or System.Text.Json.JsonException)
        {
            Avisar($"No se pudieron leer los tickets en espera de esta caja: {ex.Message}");
            return;
        }
        var perdidas = 0;
        foreach (var guardado in guardados)
        {
            var ticket = new TicketAbierto
            {
                Numero = _siguienteNumero++, Venta = VentaVacia(), Cliente = guardado.Cliente, Cuenta = guardado.Cuenta,
                FiadoSinConfirmar = guardado.FiadoSinConfirmar,
            };
            perdidas += TicketsEnEspera.Rearmar(guardado, ticket.Venta);
            foreach (var producto in guardado.Productos)
                ticket.Productos[producto.VarianteId] = producto;
            ticket.Impresiones.AddRange(guardado.Impresiones);
            if (ticket.Venta.Lineas.Count > 0)
                _tickets.Add(ticket);
        }
        if (_tickets.Count > 0)
            Avisar((_tickets.Count == 1 ? "Volvió el ticket que estaba en espera." : $"Volvieron los {_tickets.Count} tickets que estaban en espera.")
                + (perdidas > 0 ? $" {perdidas} productos ya no se pudieron armar: revísalos." : ""), error: perdidas > 0);
    }

    /// <summary>Si lo último que se guardó tenía tickets: al entrar puede haber de antes, por eso empieza en sí.</summary>
    private bool _hayEsperaGuardada = true;

    private void CambiarSiguiente()
    {
        if (_tickets.Count > 1)
            Cambiar(_tickets[(_actual + 1) % _tickets.Count]);
    }

    private async Task EliminarTicket()
    {
        var venta = Actual.Venta;
        if (venta.Lineas.Count > 0)
            await RegistrarQuitadoAsync($"Eliminó el ticket {Actual.Numero} con {Formato.Numero(venta.NumeroDeArticulos)} productos", venta.TotalCentavos);
        _tickets.RemoveAt(_actual);
        if (_tickets.Count == 0)
            NuevoTicket();
        else
            Cambiar(_tickets[Math.Min(_actual, _tickets.Count - 1)]);
    }

    // ── Cobro e impresión ───────────────────────────────────────────────────

    /// <summary>Lo llama la ventana de cobro. Devuelve el error para mostrarlo ahí, o null si se cobró.</summary>
    private async Task<string?> CobrarAsync(IReadOnlyList<CobroSolicitado> cobros, Guid? autorizacionCredito)
    {
        var abierto = Actual;
        var venta = abierto.Venta;
        try
        {
            // Con el Id del ticket: si la respuesta se pierde, el siguiente intento (en línea o sin conexión) es la misma venta.
            var ticket = await Cliente.CobrarAsync(new SolicitudCobro(Caja.Id, Turno.Id, Sesion.UsuarioId, ArmadoSolicitud.Lineas(venta), cobros,
                VentaId: venta.Id, Impresiones: abierto.Impresiones.Count > 0 ? abierto.Impresiones.Select(i => i.Id).ToList() : null,
                ClienteId: venta.ClienteId, AutorizacionDescuentoId: venta.AutorizacionDescuentoId,
                AutorizacionBajoCostoId: venta.AutorizacionBajoCostoId, MayoreoDeCliente: venta.MayoreoDeCliente,
                AutorizacionCreditoId: autorizacionCredito), soloEnLinea: abierto.FiadoSinConfirmar);
            _tickets.RemoveAt(_actual);
            // En la pantalla nueva los que esperan se quedan esperando: lo siguiente es un ticket vacío para el siguiente cliente.
            if (_tickets.Count == 0 || _pantallaNueva)
                NuevoTicket();
            else
                Cambiar(_tickets[^1]);
            Avisar($"Venta {ticket.Folio} cobrada. Cambio: {Formato.Dinero(ticket.CambioCentavos)}", error: false);
            _ultimo = ticket;
            await ImprimirAsync(ticket, abrirCajon: ticket.AbreCajon);
            await RevisarEfectivoAsync();
            return null;
        }
        catch (ErrorCaja ex)
        {
            if (ex.Codigo == "fiado-sin-confirmar")
                abierto.FiadoSinConfirmar = true;
            // Si no se pudo fiar (otra caja le fió, le abonaron, venció la autorización…), la ventana sigue abierta con la
            // cuenta al día; los callbacks de las ventanas no vuelven a dibujar esta pantalla.
            if (abierto.Cliente is not null && cobros.Any(c => c.Forma == FormaPago.Credito))
            {
                await CargarCuentaAsync(abierto);
                StateHasChanged();
            }
            return ex.Message;
        }
    }

    private Task ImprimirAsync(TicketDto ticket, bool abrirCajon) =>
        ImprimirDocumentoAsync($"Ticket {ticket.Folio}", DisenoTicket.Armar(ticket), abrirCajon);

    private async Task ImprimirDocumentoAsync(string titulo, IReadOnlyList<Elemento> documento, bool abrirCajon)
    {
        if (Impresora.MuestraVistaPrevia)
        {
            _vistaPrevia = (titulo, TicketTexto.Generar(documento));
            await Abrir(Ventanas.VistaPrevia);
            return;
        }

        // Primero se cierra la ventana y se ve la pantalla lista; la impresora tarda un par de segundos con el logo.
        await Cerrar();
        try
        {
            await Impresora.ImprimirAsync(documento, abrirCajon);
        }
        catch (Exception ex)
        {
            Avisar($"No se pudo imprimir ({titulo}): {ex.Message} Se puede reimprimir.");
            StateHasChanged();
        }
    }

