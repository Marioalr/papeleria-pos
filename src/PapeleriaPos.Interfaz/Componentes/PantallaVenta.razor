    private async Task ImpresionesDesdeArribaAsync()
    {
        if (_pagina != Pagina.Venta)
            await IrAAsync(Pagina.Venta);
        await Abrir(Ventanas.Impresiones);
    }

    /// <summary>
    /// Un abono o un saldo a favor devuelto desde la página de Clientes: los tickets que tienen a ese cliente ponen al día su
    /// cuenta y se imprime el comprobante (en efectivo, con el cajón). La página dice lo que hay que entregar; se sigue en ella.
    /// </summary>
    private async Task AbonoDesdePaginaAsync(ComprobanteAbonoDto comprobante)
    {
        foreach (var ticket in _tickets.Where(t => t.Cliente?.Id == comprobante.ClienteId))
            await CargarCuentaAsync(ticket);
        await ImprimirDesdePaginaAsync($"{(comprobante.EsSaldoDevuelto ? "Saldo devuelto" : "Abono")} {comprobante.Folio}", DisenoComprobante.Abono(comprobante),
            comprobante.AbreCajon);
        await RevisarEfectivoAsync();
    }

    /// <summary>Una reimpresión desde la página de Clientes: solo el papel.</summary>
    private Task AbonoReimpresoDesdePaginaAsync(ComprobanteAbonoDto comprobante) =>
        ImprimirDesdePaginaAsync($"{(comprobante.EsSaldoDevuelto ? "Saldo devuelto" : "Abono")} {comprobante.Folio}", DisenoComprobante.Abono(comprobante),
            abrirCajon: false);

    /// <summary>El estado de cuenta desde la página de Clientes: solo el papel.</summary>
    private Task EstadoDesdePaginaAsync(EstadoCuentaDto estado) =>
        ImprimirDesdePaginaAsync($"Estado de cuenta de {estado.Cliente}", DisenoComprobante.EstadoCuenta(estado), abrirCajon: false);

    /// <summary>
    /// Lo que se imprime desde una página, sin dejarla ni tocar lo que la venta tiene abierto: sin impresora se ve encima de
    /// la página (Esc lo cierra); si no sale, lo dice su barra de abajo.
    /// </summary>
    private async Task ImprimirDesdePaginaAsync(string titulo, IReadOnlyList<Elemento> documento, bool abrirCajon)
    {
        _errorDePagina = null;
        if (Impresora.MuestraVistaPrevia)
        {
            _vistaPreviaDePagina = (titulo, TicketTexto.Generar(documento));
            await AvisarTeclasAsync();
            StateHasChanged();
            return;
        }
        try
        {
            await Impresora.ImprimirAsync(documento, abrirCajon);
        }
        catch (Exception ex)
        {
            _errorDePagina = $"No se pudo imprimir ({titulo}): {ex.Message} Se puede reimprimir.";
        }
        StateHasChanged();
    }

    private async Task CerrarVistaPreviaDePaginaAsync()
    {
        _vistaPreviaDePagina = null;
        await AvisarTeclasAsync();
        if (PaginaAbierta is { } pagina)
            await pagina.EnfocarAsync();
        StateHasChanged();
    }

