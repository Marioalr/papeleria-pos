    private readonly List<TicketAbierto> _tickets = [];
    private TicketAbierto Actual => _tickets[_actual];
    private int _actual;
    private int _seleccion = -1;
    private int _siguienteNumero = 1;
    private readonly CapturaCodigo _captura = new();
    private string? _mensaje;
    private bool _mensajeEsError;
    private TicketDto? _ultimo;
    private (string Titulo, string Texto)? _vistaPrevia;
    private Ventanas _ventana;
    private DotNetObjectReference<PantallaVenta>? _referencia;

    protected override void OnInitialized()
    {
        // Lo que puede quien entró ya llega con la sesión (entrega 1): la pantalla sale desde el principio con sus pestañas.
        if (Sesion.Permisos is { } permisos)
            (_permisos, _permisosPedidos) = (permisos.ToDictionary(p => p.Accion), true);
        RecuperarEspera();
        NuevoTicket();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        // Ya se dibujó lo de estos escaneos: caja.js mide cuánto tardaron en verse (entrega 5).
        if (_porPintar.Count > 0)
        {
            var horas = _porPintar.ToArray();
            _porPintar.Clear();
            _ = Js.PintadoAsync(horas);
        }
        if (_enfocar is { } selector)
        {
            _enfocar = null;
            await Js.EnfocarAsync(selector);
        }
        if (!primera)
            return;
        _referencia = DotNetObjectReference.Create(this);
        // El vigía del hilo de la pantalla (entrega 5): en una ráfaga de escaneos, anota en el registro si se traba.
        _vigia = new VigiaDeLaPantalla(InvokeAsync, Rendimiento, Servicios.GetService<RegistroDiario>());
        await Js.RegistrarTeclasAsync(_referencia);
        await Js.EnfocarAsync("#codigo");
        // Junto con lo demás de la página, antes de esperar al servicio: después, la página ya pudo volver a cargarse (y
        // esta pantalla ya no estar) mientras llegaba lo de abajo.
        await Js.GuardarAsync(ClavePantallaDeAntes, null);
        // Primero los permisos: lo de quien entró sale en cuanto llegan, sin esperar a los rápidos ni a lo demás.
        await CargarPermisosAsync();
        StateHasChanged();
        await CargarConfiguracionAsync();
        await CargarRapidosAsync();
        await CargarPilotoEleventaAsync();
        await RevisarEfectivoAsync();
        await RevisarConteoAsync();
        StateHasChanged();
    }

    // ── Lo que se mide (entrega 5, docs/propuesta-interfaz.md, «Cómo se mide») ──

    /// <summary>Lo que mide la caja; sin la de la caja (una prueba), una propia.</summary>
    private RendimientoCaja Rendimiento => _rendimiento ??= Servicios.GetService<RendimientoCaja>() ?? new RendimientoCaja();

    private RendimientoCaja? _rendimiento;
    private VigiaDeLaPantalla? _vigia;

    /// <summary>La hora del Enter (reloj de la página) de los escaneos que ya agregaron lo suyo y todavía no se dibuja.</summary>
    private readonly List<double> _porPintar = [];

    /// <summary>
    /// Lo de un Enter que agrega al ticket: cuando termina (ya está su línea, su «buscando…» o el aviso de por qué no), la
    /// hora del Enter espera al siguiente dibujo para medirse. Un escaneo que esperó en la cola detrás de algo con red (un
    /// nombre, un folio) se mide con todo lo que esperó.
    /// </summary>
    private async Task MedidoAsync(Func<Task> agregar, double? hora)
    {
        try
        {
            await agregar();
        }
        finally
        {
            if (hora is { } h)
                _porPintar.Add(h);
        }
    }

    /// <summary>Lo que tardaron en verse las líneas de los últimos escaneos, medido por caja.js con el reloj de la página.</summary>
    [JSInvokable]
    public void Pintados(double[] milisegundos)
    {
        foreach (var ms in milisegundos)
            Rendimiento.AnotarEscaneo(TimeSpan.FromMilliseconds(ms));
    }

    /// <summary>El Enter del cuadro de captura: caja.js ya tomó el texto y vació el cuadro.</summary>
    /// <param name="hora">La del Enter, con el reloj de la página: de ahí se mide hasta que se ve la línea.</param>
    [JSInvokable]
    public async Task Escaneado(string texto, double? hora = null)
    {
        if (_ventana != Ventanas.Ninguna || _pagina != Pagina.Venta)
            return;
        // «/algo» y Enter: la acción elegida, o la primera que se llama así.
        if (FiltroDeAcciones(texto) is { } filtro)
        {
            CerrarResultados();
            await HacerAccionDeTextoAsync(filtro);
            StateHasChanged();
            return;
        }
        // Entra a la venta: el vigía sabe que hay ráfaga. Lo que tarda en verse se mide cuando ya agregó lo suyo.
        _vigia?.Escaneo();
        // Con ↑ ↓ (o → y Tab) se eligió de la lista de resultados: Enter agrega ese; en una familia, su más vendido.
        if (_resultados is { Count: > 0 } resultados && _navegado && SepararCantidad(texto).Texto == _textoBuscado && Seleccionado() is { } elegido)
        {
            var (cantidad, buscado) = (_cantidadBuscada, _textoBuscado);
            CerrarResultados();
            // caja.js ya vació el cuadro: el nombre buscado no se queda como la cantidad de lo que sigue (F11, un rápido).
            _captura.Texto = "";
            await _captura.EnTurnoAsync(() => MedidoAsync(() => AgregarResultadoAsync(elegido, cantidad, buscado, resultados.Count), hora));
            StateHasChanged();
            return;
        }
        CerrarResultados();
        _captura.Texto = texto;
        var escaneo = AgregarCodigoAsync(hora);
        // Casi siempre ya terminó (el código está en la copia): se pinta una sola vez (entrega 5, parte 3). Si espera algo (un
        // nombre o un folio con la red, o un escaneo de antes), se pinta ya lo que hay y otra vez al terminar.
        if (!escaneo.IsCompleted)
        {
            StateHasChanged();
            await escaneo;
        }
        StateHasChanged();
    }

    /// <summary>
    /// El lector escribió en el cobro («Pagó con», un monto, una referencia o un botón; data-cobro) o en un abono, y caja.js
    /// lo reconoció por su ritmo: ya quitó del campo lo que tecleó y su Enter no cobró. Un escaneo nunca se toma como
    /// dinero (docs/propuesta-interfaz.md, «El cuadro de captura»): el código va a la cola de captura como cualquier otro y
    /// el cursor vuelve al cuadro. Donde estaba (el panel del abono, o el abono en la página de Clientes) se deja, para ver
    /// el ticket. Si se está cobrando, espera al cobro y cae en el ticket del siguiente cliente.
    /// </summary>
    [JSInvokable]
    public async Task EscaneoEnPago(string codigo, double? hora = null)
    {
        _vigia?.Escaneo();
        var cobrando = _cobrando;
        var enAbono = _ventana is Ventanas.Abono || _pagina == Pagina.Clientes;
        if (!cobrando)
        {
            if (_pagina != Pagina.Venta)
                await IrAAsync(Pagina.Venta);
            if (_ventana != Ventanas.Ninguna)
                await Cerrar();
            _enfocar = "#codigo";
        }
        var antes = FotoDelTicket();
        _captura.Texto = codigo;
        var escaneo = AgregarCodigoAsync(hora);
        StateHasChanged();
        await escaneo;
        if (!cobrando && !antes.Equals(FotoDelTicket()))
            Avisar(enAbono
                ? $"«{codigo}» se leyó en el abono: se agregó al ticket, no se tomó como dinero. El abono, otra vez con Ctrl+B."
                : $"«{codigo}» se leyó en el cobro: se agregó al ticket, no se tomó como dinero. Cobra cuando esté completo.", error: false);
        StateHasChanged();
    }

    /// <summary>
    /// Lo que se escribe a mano en el cuadro de captura, al dejar de teclear: la cantidad de un rápido o de F11, o un
    /// nombre, que se busca aquí mismo.
    /// </summary>
    [JSInvokable]
    public async Task Escribiendo(string texto)
    {
        _captura.Texto = texto;
        if (_ventana == Ventanas.Ninguna && _pagina == Pagina.Venta)
            await BuscarMientrasEscribeAsync(texto);
    }

    // ── La búsqueda debajo del cuadro ───────────────────────────────────────

    /// <summary>Cuántos renglones muestra la lista.</summary>
    private const int MaximoResultados = 30;

    /// <summary>Cuántos productos se piden: con más, las familias salen completas aunque la lista muestre 30 renglones.</summary>
    private const int ParaFamilias = 200;

    /// <summary>Cuántos valores se ven en el renglón de una familia; los demás, al desplegarla.</summary>
    private const int ValoresALaVista = 8;

    /// <summary>Lo que sale al escribir; null: la lista está cerrada.</summary>
    private List<ResultadoBusquedaDto>? _resultados;

    /// <summary>Los resultados en renglones: lo que solo cambia en el color, la medida o la marca va junto.</summary>
    private AgrupacionDeFamilias<ResultadoBusquedaDto>? _familias;

    /// <summary>El renglón de la familia desplegada, o -1.</summary>
    private int _abierta = -1;

    /// <summary>Lo que se eligió desplegar con Tab para cada texto: la próxima vez con ese texto se despliega igual.</summary>
    private readonly Dictionary<string, EjeFamilia> _ejePorTexto = [];

    private void Agrupar()
    {
        if (_resultados is not { } resultados)
        {
            (_familias, _abierta) = (null, -1);
            return;
        }
        EjeFamilia? preferido = _ejePorTexto.TryGetValue(Texto.Normalizar(_textoBuscado), out var eje) ? eje : null;
        _familias = Familias.Agrupar(resultados, r => r.Partes ?? [], r => r.Vendidos, preferido);
        _abierta = -1;
    }

    /// <summary>Lo que se recorre con ↑ ↓: cada renglón y, en la familia desplegada, cada valor (-1: el renglón).</summary>
    private List<(int Renglon, int Valor)> Navegables()
    {
        var lista = new List<(int, int)>();
        if (_familias is not { } familias)
            return lista;
        for (var k = 0; k < Math.Min(familias.Renglones.Count, MaximoResultados); k++)
        {
            lista.Add((k, -1));
            if (k == _abierta)
                lista.AddRange(Enumerable.Range(0, familias.Renglones[k].Valores.Count).Select(v => (k, v)));
        }
        return lista;
    }

    /// <summary>El producto de un renglón (el más vendido, si es familia) o de uno de sus valores.</summary>
    private ResultadoBusquedaDto? DeLaLista(int renglon, int valor) =>
        _familias is { } familias && renglon >= 0 && renglon < familias.Renglones.Count
            ? valor < 0 ? familias.Renglones[renglon].Elegido : familias.Renglones[renglon].Valores[valor].Elemento
            : null;

    private ResultadoBusquedaDto? Seleccionado() =>
        Navegables() is var lista && _indiceResultado >= 0 && _indiceResultado < lista.Count
            ? DeLaLista(lista[_indiceResultado].Renglon, lista[_indiceResultado].Valor)
            : null;

    /// <summary>→ (o la flecha del renglón): despliega la familia con el cursor en el más vendido.</summary>
    private void AbrirSeleccionada()
    {
        var lista = Navegables();
        if (_familias is not { } familias || _indiceResultado >= lista.Count || lista[_indiceResultado] is not (var renglon, -1)
            || !familias.Renglones[renglon].EsFamilia)
            return;
        _abierta = renglon;
        _indiceResultado = Navegables().IndexOf((renglon, familias.Renglones[renglon].MasVendido));
        _navegado = true;
        _ = Js.MostrarAsync($"#res-{_indiceResultado}");
    }

    /// <summary>← o Esc: cierra la familia y el cursor vuelve a su renglón.</summary>
    private void CerrarFamilia()
    {
        if (_abierta < 0)
            return;
        var renglon = _abierta;
        _abierta = -1;
        _indiceResultado = Navegables().IndexOf((renglon, -1));
    }

    private void AlternarFamilia(int renglon)
    {
        if (_abierta == renglon)
        {
            CerrarFamilia();
        }
        else
        {
            _abierta = -1;
            _indiceResultado = Navegables().IndexOf((renglon, -1));
            AbrirSeleccionada();
        }
        _enfocar = "#codigo";
    }

    /// <summary>Tab y Mayús+Tab: despliega por lo siguiente que cambia (color, medida, marca…). Se recuerda para ese texto.</summary>
    private void CambiarEje(int paso)
    {
        if (_familias is not { Ejes.Count: > 1 } familias)
            return;
        var actual = familias.Eje is { } eje ? familias.Ejes.ToList().IndexOf(eje) : -1;
        ElegirEje(familias.Ejes[(actual + paso + familias.Ejes.Count) % familias.Ejes.Count]);
    }

    private void ElegirEje(EjeFamilia eje)
    {
        _ejePorTexto[Texto.Normalizar(_textoBuscado)] = eje;
        Agrupar();
        (_indiceResultado, _navegado) = (0, true);
        _enfocar = "#codigo";
    }

    private static string NombreDeEje(EjeFamilia eje) => eje switch
    {
        EjeFamilia.Color => "Color",
        EjeFamilia.Medida => "Tamaño",
        EjeFamilia.Marca => "Marca",
        EjeFamilia.Contenido => "Contenido",
        _ => "Rayado",
    };

    private static string PluralDeEje(EjeFamilia eje) => eje switch
    {
        EjeFamilia.Color => "colores",
        EjeFamilia.Medida => "tamaños",
        EjeFamilia.Marca => "marcas",
        EjeFamilia.Contenido => "contenidos",
        _ => "rayados",
    };

    /// <summary>El valor como se escribió; si dos se llaman igual (un producto repetido en el catálogo), con su precio.</summary>
    private static string ValorTexto(RenglonDeFamilia<ResultadoBusquedaDto> renglon, int v)
    {
        var valor = renglon.Valores[v];
        var repetido = renglon.Valores.Count(x => x.Clave == valor.Clave) > 1;
        return repetido ? $"{valor.Texto} · {Formato.Dinero(valor.Elemento.PrecioCentavos)}" : valor.Texto;
    }

    private static string ValorTitulo(RenglonDeFamilia<ResultadoBusquedaDto> renglon, int v) =>
        $"{renglon.Valores[v].Elemento.Descripcion} · {Formato.Dinero(renglon.Valores[v].Elemento.PrecioCentavos)} · {ExistenciaTexto(renglon.Valores[v].Elemento.Existencia)}";

    /// <summary>Si el precio cambia según el valor (el costo de compra es distinto), «desde» el más bajo.</summary>
    private static string PrecioDeFamilia(RenglonDeFamilia<ResultadoBusquedaDto> renglon)
    {
        var precios = renglon.Valores.Select(v => v.Elemento.PrecioCentavos).Distinct().ToList();
        return precios.Count == 1 ? Formato.Dinero(precios[0]) : $"desde {Formato.Dinero(precios.Min())}";
    }

    /// <summary>El punto de color de referencia (el surtido, de varios colores); en otros ejes, nada.</summary>
    private static RenderFragment Punto(EjeFamilia eje, string clave) => eje != EjeFamilia.Color
        ? _ => { }
        : MuestraDeColor.Css(clave) is { } css
            ? @<span class="vn-punto" style="background:@css"></span>
            : @<span class="vn-punto surtido"></span>;

    private static string ExistenciaClase(decimal? existencia) => existencia is <= 0 ? "nada" : existencia is <= 3 ? "poca" : "";

    /// <summary>Si salió por un sinónimo de la tienda, por cuál: así se va aprendiendo cómo se llama.</summary>
    private static RenderFragment PorSinonimo(ResultadoBusquedaDto r) => r.PorSinonimo is { } palabra
        ? @<span class="vn-via" title="Sinónimo de la tienda (Configuración › Sinónimos)">por «@palabra»</span>
        : _ => { };

    /// <summary>Cuántas fichas para afinar se ven.</summary>
    private const int FichasParaAfinar = 7;

    /// <summary>
    /// Con un texto general («folder»), las palabras que separan los resultados, de la que más separa a la que menos: la
    /// marca, la medida, otra palabra del nombre. Lo que ya sale como ficha de los renglones (el eje desplegado) no se
    /// repite (docs/propuesta-interfaz.md, «Afinar con fichas»).
    /// </summary>
    private List<(string Palabra, int Veces)> ParaAfinar()
    {
        if (_resultados is not { Count: >= 4 } resultados)
            return [];
        var desplegado = _familias?.Eje;
        var cuenta = new Dictionary<string, int>();
        foreach (var r in resultados)
        {
            var delProducto = (r.Partes ?? [])
                .Where(p => p.Clave.Length >= 2 && !p.Clave.All(char.IsDigit) && (desplegado is null || p.Eje != desplegado))
                .Where(p => !_partesBuscadas.Any(b => p.Clave.StartsWith(b, StringComparison.Ordinal)))
                .Select(p => p.Clave)
                .ToHashSet();
            foreach (var palabra in delProducto)
                cuenta[palabra] = cuenta.GetValueOrDefault(palabra) + 1;
        }
        var lista = cuenta.Where(x => x.Value < resultados.Count)
            .OrderByDescending(x => x.Value).ThenBy(x => x.Key, StringComparer.Ordinal)
            .Take(FichasParaAfinar).Select(x => (x.Key, x.Value)).ToList();
        return lista.Count >= 2 ? lista : [];
    }

    /// <summary>Una ficha para afinar: la palabra se agrega a lo escrito y se busca otra vez.</summary>
    private async Task AfinarAsync(string palabra)
    {
        var texto = $"{_captura.Texto.TrimEnd()} {palabra.ToLowerInvariant()}";
        _captura.Texto = texto;
        await Js.EscribirCapturaAsync(texto);
        await BuscarMientrasEscribeAsync(texto);
    }

    private string _textoBuscado = "";
    private string[] _partesBuscadas = [];
    private Cantidad _cantidadBuscada = Cantidad.Piezas(1);
    private int _indiceResultado;

    /// <summary>Se movió con ↑ ↓: Enter agrega el elegido y no busca el texto como código.</summary>
    private bool _navegado;

    /// <summary>Cada búsqueda lleva su número: si llega tarde (ya se escribió otra cosa), no se muestra.</summary>
    private int _secuenciaBusqueda;

    /// <summary>«3*cuad» → 3 y «cuad»: lo de antes del asterisco es la cantidad.</summary>
    private static (Cantidad Cantidad, string Texto) SepararCantidad(string texto)
    {
        texto = texto.Trim();
        var asterisco = texto.IndexOf('*');
        return asterisco > 0 && decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) && n > 0
            ? (Cantidad.Unidades(Math.Round(n, 3)), texto[(asterisco + 1)..].Trim())
            : (Cantidad.Piezas(1), texto);
    }

    /// <summary>Un nombre (o un código corto con letras), no un código del lector ni un folio.</summary>
    private static bool EsTextoDeBusqueda(string texto) => texto.Length >= 2 && texto.Any(char.IsLetter) && !FolioTicket.IsMatch(texto);

    private async Task BuscarMientrasEscribeAsync(string texto)
    {
        if (FiltroDeAcciones(texto) is { } filtro)
        {
            CerrarResultados();
            MostrarAcciones(filtro);
            StateHasChanged();
            return;
        }
        if (_accionesVistas is not null)
        {
            CerrarAcciones();
            StateHasChanged();
        }
        var (cantidad, resto) = SepararCantidad(texto);
        var secuencia = ++_secuenciaBusqueda;
        if (!EsTextoDeBusqueda(resto))
        {
            if (_resultados is not null)
            {
                _resultados = null;
                Agrupar();
                StateHasChanged();
            }
            return;
        }
        try
        {
            // Contra la copia de esta caja, al momento y sin la red (entrega 5, parte 3); sin copia, al servicio.
            var resultados = Cliente.BuscarEnLaCopia(resto, ParaFamilias) ?? await Cliente.BuscarAsync(resto, Caja.SucursalId, Caja.Id, ParaFamilias);
            if (secuencia != _secuenciaBusqueda)
                return;
            (_resultados, _textoBuscado, _cantidadBuscada, _indiceResultado, _navegado) = (resultados, resto, cantidad, 0, false);
            _partesBuscadas = Texto.Normalizar(resto).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            Agrupar();
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
        StateHasChanged();
    }

    private void CerrarResultados()
    {
        _resultados = null;
        Agrupar();
        _navegado = false;
        _secuenciaBusqueda++;
    }

    private void MoverResultado(int paso)
    {
        var lista = Navegables();
        if (lista.Count == 0)
            return;
        _indiceResultado = Math.Clamp(_indiceResultado + paso, 0, lista.Count - 1);
        _navegado = true;
        _ = Js.MostrarAsync($"#res-{_indiceResultado}");
    }

    /// <summary>Un clic en un renglón (en una familia, su más vendido), en uno de sus valores o en su ficha.</summary>
    private async Task AgregarDeLaListaAsync(int renglon, int valor)
    {
        if (_resultados is not { } resultados || DeLaLista(renglon, valor) is not { } elegido)
            return;
        var (cantidad, buscado) = (_cantidadBuscada, _textoBuscado);
        CerrarResultados();
        VaciarCaptura();
        _enfocar = "#codigo";
        await _captura.EnTurnoAsync(() => AgregarResultadoAsync(elegido, cantidad, buscado, resultados.Count));
    }

    /// <summary>
    /// Agrega lo elegido y anota qué se eligió con ese texto: la próxima vez, en esta caja, sale primero. Fuera de la cola
    /// de escaneos, quien llama lo forma en ella (<see cref="CapturaCodigo.EnTurnoAsync"/>); dentro, se llama directo.
    /// </summary>
    private async Task AgregarResultadoAsync(ResultadoBusquedaDto resultado, Cantidad cantidad, string buscado, int resultados)
    {
        _ = Cliente.RegistrarBusquedaAsync(new SolicitudBusqueda(Caja.Id, buscado, resultados, resultado.VarianteId));
        try
        {
            // Como un escaneo: de la copia de esta caja, sin la red (entrega 5); sin copia, del servicio.
            if ((Cliente.Foto?.PorVariante(resultado.VarianteId) ?? await Cliente.PorVarianteAsync(resultado.VarianteId, Caja.SucursalId)) is { } producto)
                Agregar(producto, null, cantidad);
            else
                Avisar("Ese producto ya no está en el catálogo.");
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    /// <summary>
    /// Enter con un nombre que no es código, sin elegir de la lista: agrega el primer renglón (lo elegido antes o lo más
    /// vendido); si es una familia, su más vendido. Si no sale nada, lo dice y lo anota, para darlo de alta o hacerlo
    /// sinónimo después.
    /// </summary>
    private async Task AgregarPrimeroAsync(string texto, Cantidad cantidad)
    {
        var resultados = Cliente.BuscarEnLaCopia(texto, ParaFamilias) ?? await Cliente.BuscarAsync(texto, Caja.SucursalId, Caja.Id, ParaFamilias);
        if (resultados.Count == 0)
        {
            _ = Cliente.RegistrarBusquedaAsync(new SolicitudBusqueda(Caja.Id, texto, 0, null));
            Avisar($"Nada coincide con «{texto}». Revisa cómo se escribe, o véndelo como artículo común (Ins).");
            return;
        }
        EjeFamilia? preferido = _ejePorTexto.TryGetValue(Texto.Normalizar(texto), out var eje) ? eje : null;
        var primero = Familias.Agrupar(resultados, r => r.Partes ?? [], r => r.Vendidos, preferido).Renglones[0].Elegido;
        await AgregarResultadoAsync(primero, cantidad, texto, resultados.Count);
    }

    private static string ExistenciaTexto(decimal? existencia) => existencia switch
    {
        null => "Servicio",
        <= 0 => "Sin existencia",
        <= 3 => $"Quedan {Formato.Numero(existencia.Value)}",
        _ => $"{Formato.Numero(existencia.Value)} en tienda",
    };

    /// <summary>El texto con el principio de cada palabra que coincide con lo escrito, resaltado.</summary>
    private RenderFragment Marcado(string texto) => @<span>@foreach (var (parte, marcada) in Segmentos(texto, _partesBuscadas))
        {
            if (marcada)
            {
                <mark>@parte</mark>
            }
            else
            {
                @parte
            }
        }</span>;

    private static IEnumerable<(string Parte, bool Marcada)> Segmentos(string texto, string[] partes)
    {
        if (texto.Length == 0)
            yield break;
        // Cada carácter normalizado por separado: la misma longitud que el texto, para marcar en su lugar.
        var plano = string.Concat(texto.Select(c => char.IsWhiteSpace(c) ? " " : Texto.Normalizar(c.ToString()) is { Length: 1 } n ? n : "·"));
        var marca = new bool[texto.Length];
        for (var i = 0; i < texto.Length; i++)
        {
            if (i > 0 && char.IsLetterOrDigit(texto[i - 1]))
                continue;
            foreach (var parte in partes)
            {
                if (!plano.AsSpan(i).StartsWith(parte, StringComparison.Ordinal))
                    continue;
                for (var k = i; k < i + parte.Length; k++)
                    marca[k] = true;
                break;
            }
        }
        var inicio = 0;
        for (var i = 1; i <= texto.Length; i++)
        {
            if (i < texto.Length && marca[i] == marca[inicio])
                continue;
            yield return (texto[inicio..i], marca[inicio]);
            inicio = i;
        }
    }

    /// <summary>Vacía el cuadro de captura, aquí y en la página: no está enlazado (lo maneja caja.js).</summary>
    private void VaciarCaptura()
    {
        _captura.Texto = "";
        _ = Js.LimpiarCapturaAsync();
    }

    /// <param name="tecla">La tecla, como la nombra caja.js.</param>
    /// <param name="texto">
    /// Lo que había en el cuadro de captura (no está enlazado); null si se oprimió en otro lado o es un botón de la barra
    /// de teclas.
    /// </param>
    [JSInvokable]
    public async Task Tecla(string tecla, string? texto)
    {
        if (texto is not null)
            _captura.Texto = texto;
        // El corte o la Configuración encima (de la venta o de una página): lo suyo, como siempre.
        if (_ventana != Ventanas.Ninguna && !VaEnPanel && !await TeclaConVentanaAsync(tecla, desdeLaCaptura: texto is not null))
            return;
        // En una página, sus teclas; la venta (y el panel que tuviera) se queda como está.
        if (_pagina != Pagina.Venta)
        {
            await TeclaEnPaginaAsync(tecla);
            return;
        }
        if (_ventana != Ventanas.Ninguna && VaEnPanel && !await TeclaConVentanaAsync(tecla, desdeLaCaptura: texto is not null))
            return;

        // Con «/» en el cuadro, ↑ ↓ recorren las acciones.
        if (tecla is "ArrowUp" or "ArrowDown" && texto is not null && FiltroDeAcciones(texto) is { } filtro)
        {
            if (_accionesVistas is null || filtro != _textoAcciones)
                MostrarAcciones(filtro);
            MoverAccion(tecla == "ArrowUp" ? -1 : 1);
            StateHasChanged();
            return;
        }
        // Las familias de la lista (caja.js solo manda estas teclas con la lista abierta): → despliega, ← y Esc cierran, Tab
        // despliega por otra cosa. Sin familia abierta, Esc hace lo de siempre.
        // caja.js no vació el cuadro si creyó que había una familia abierta.
        var cuadroSinVaciar = tecla == "Escape-familia";
        if (cuadroSinVaciar && _abierta < 0)
            tecla = "Escape";
        if (_familias is not null && tecla is "ArrowRight" or "ArrowLeft" or "Tab" or "Shift+Tab" or "Escape-familia")
        {
            switch (tecla)
            {
                case "ArrowRight": AbrirSeleccionada(); break;
                case "ArrowLeft" or "Escape-familia": CerrarFamilia(); break;
                case "Tab": CambiarEje(1); break;
                case "Shift+Tab": CambiarEje(-1); break;
            }
            StateHasChanged();
            return;
        }
        // Con un nombre en el cuadro, ↑ ↓ recorren los resultados (si se teclearon antes de que salieran, se busca ya).
        if (tecla is "ArrowUp" or "ArrowDown" && texto is not null && EsTextoDeBusqueda(SepararCantidad(texto).Texto))
        {
            if (_resultados is null || SepararCantidad(texto).Texto != _textoBuscado)
                await BuscarMientrasEscribeAsync(texto);
            MoverResultado(tecla == "ArrowUp" ? -1 : 1);
            StateHasChanged();
            return;
        }
        // Cualquier otra tecla (Esc, F12, F6…) cierra la lista, el menú del usuario y «Más».
        if (_resultados is not null)
            CerrarResultados();
        CerrarAcciones();
        _menuUsuario = false;
        _menuEspera = false;

        // Las teclas que actúan sobre el ticket esperan a que termine el último escaneo (y el cobro en curso): F6 no manda
        // un escaneo al ticket nuevo, ni + cambia el que se está cobrando. F12 espera en IrAlCobroAsync: dentro del cobro,
        // que además dice si llegó algo mientras, o antes de pasar el cursor al cobro.
        if (tecla is "F6" or "F5" or "+" or "-" or "Delete" or "F11" || tecla.StartsWith("Alt+", StringComparison.Ordinal))
            await _captura.EsperarAsync();

        switch (tecla)
        {
            // Lo que no está entre sus permisos no tiene tecla.
            case var _ when SinTecla(tecla):
                Avisar("Eso no está entre lo que puedes hacer: «/» muestra todo lo que sí.");
                break;
            case "Ctrl+U": await SalirAsync(); break;
            case "F10": Buscar(); break;
            // caja.js ya movió el cursor a «Pagó con» (sin esperar esta vuelta): no cobra todavía, y el cobro espera el
            // último escaneo al dar Enter.
            case "F12-pago": break;
            case "F12": await IrAlCobroAsync(); break;
            case "F5": RetomarPrimero(); break;
            case "F6": PonerEnEspera(); break;
            case ['A', 'l', 't', '+', var numero] when numero is >= '1' and <= '6': await RapidoAsync(numero - '1'); break;
            case "F7": await Abrir(Ventanas.Entrada); break;
            case "F8": await Abrir(Ventanas.Salida); break;
            case "F9": await Abrir(Ventanas.Verificador); break;
            case "F2": await Abrir(Ventanas.Impresiones); break;
            case "Insert" or "Ctrl+P": await Abrir(Ventanas.Comun); break;
            case "Ctrl+E": await AbrirCambioPrecio(); break;
            case "Ctrl+D": await Abrir(Ventanas.Descuento); break;
            case "Ctrl+L": await Abrir(Ventanas.ElegirCliente); break;
            case "Ctrl+B": await Abrir(Ventanas.Abono); break;
            case "Delete": await BorrarSeleccion(); break;
            case "ArrowUp": await MoverSeleccion(-1); break;
            case "ArrowDown": await MoverSeleccion(1); break;
            case "+": await CambiarCantidadSeleccion(1); break;
            case "-": await CambiarCantidadSeleccion(-1); break;
            case "F11": await MayoreoAsync(); break;
            case "F3": await IrAAsync(Pagina.Productos); break;
            case "F4": await IrAAsync(Pagina.Inventario); break;
            case "Escape":
                _cobrado = null;
                // Desde el cuadro de captura, caja.js ya lo vació: vaciarlo otra vez desde aquí borraría lo que se
                // empezó a escribir enseguida.
                if (texto is not null && !cuadroSinVaciar)
                    _captura.Texto = "";
                else
                    VaciarCaptura();
                _mensaje = null;
                // Desde «Pagó con», Esc borra lo escrito y regresa al cuadro del código sin cobrar.
                (_pagoCon, _avisoDelCobro) = ("", null);
                _enfocar = "#codigo";
                break;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Una tecla con una ventana abierta; devuelve si sigue a hacer lo suyo. Esc la cierra. Con un panel a la derecha
    /// (el ticket a la vista), las teclas de la barra y de «/» siguen funcionando (docs/propuesta-interfaz.md, «Los
    /// demás paneles»): la del mismo panel lo cierra («F9 o Esc regresan a vender») y, si el panel se deja
    /// (<see cref="PanelesQueSeDejan"/>), las demás lo cierran y hacen lo suyo, como sin él: abrir otro panel, F12 al
    /// cobro, F6 a la espera. Un panel con campos espera su Enter o Esc, y con otra tecla lo dice. Antes solo respondía
    /// Esc. caja.js solo manda las que no escriben en los campos del panel (Esc, las F, las Ctrl de la caja e Ins);
    /// Supr, las flechas, + y − se quedan en el panel. Ctrl+U cambia de usuario con lo que esté abierto, y F1 regresa a
    /// vender desde lo que va encima del ticket, como en el prototipo.
    /// </summary>
    /// <param name="desdeLaCaptura">Se oprimió en el cuadro de captura: caja.js mandó su texto.</param>
    private async Task<bool> TeclaConVentanaAsync(string tecla, bool desdeLaCaptura)
    {
        if (tecla == "Escape")
        {
            // Desde el cuadro de captura, caja.js ya lo vació.
            if (desdeLaCaptura)
                _captura.Texto = "";
            await Cerrar();
            return false;
        }
        // caja.js no manda estas con una ventana abierta: si llegan, perdió la cuenta porque otra parte de la caja le dijo
        // que ya no había ventana (la franja de la prueba lo hacía al cerrar su guía encima de un panel). Se le vuelve a
        // decir y la tecla no hace nada: Supr no quita un renglón, + no cambia una cantidad ni Alt+1 agrega un rápido
        // detrás del panel.
        if (EsTeclaSinVentana(tecla))
        {
            await AvisarTeclasAsync();
            return false;
        }
        // Ctrl+U cambia de usuario desde donde se esté («Ctrl+U cambia de usuario», docs/propuesta-interfaz.md; el prototipo
        // lo hace desde cualquier vista), igual que «Cambiar de usuario» del menú, que se toca con un panel abierto: lo
        // abierto se deja como con Esc. Antes, con algo encima del ticket (productos, clientes, el corte…) no hacía nada, y
        // el fondo de la ventana tapaba el menú: no había por dónde salir más que Esc.
        if (tecla == "Ctrl+U")
        {
            await QuitarVentanaAsync();
            return true;
        }
        // F1 es la pestaña «Venta»: desde lo que va encima (el corte, la Configuración, también sobre una página) regresa a
        // vender, como Esc (el prototipo va a la venta desde cualquier vista). Con un panel ya se está en la venta: no hace nada.
        if (tecla == "F1")
        {
            if (!VaEnPanel)
            {
                await Cerrar();
                if (_pagina != Pagina.Venta)
                    await IrAAsync(Pagina.Venta);
            }
            return false;
        }
        // F3 y F4 van a su página (entrega 8): el panel no se cierra, se queda en la venta como está, para cuando se regrese.
        if (VaEnPanel && tecla is "F3" or "F4")
            return true;
        // Las demás no cierran lo que va encima del ticket (los módulos de arriba y el conteo): puede tener algo a medio
        // escribir, y su tecla no es la de quitarlo.
        if (!VaEnPanel)
            return false;
        if (PanelDeLaTecla(tecla) == _ventana)
        {
            await Cerrar();
            return false;
        }
        // Una autorización a mitad del cobro, o un panel con campos: espera su Enter o Esc, y lo dice.
        if (PorQueNoSeDeja is { } espera)
        {
            AvisarEnElPanel(espera);
            return false;
        }
        // La tecla de algo que no puede solo lo avisa: el panel se queda.
        if (SinTecla(tecla))
        {
            AvisarEnElPanel("Eso no está entre lo que puedes hacer: «/» muestra todo lo que sí.");
            return false;
        }
        if (tecla == "Ctrl+Q")
        {
            // El PDF a cotizar: el selector se abre ya (la tecla se acaba de oprimir) y, al elegir el PDF, el panel cambia al
            // de cotizar. Si no se elige ninguno, el panel se queda.
            await Js.ClicAsync("#pdf-cotizar");
            return false;
        }
        if (tecla == "F12")
        {
            // Al cobro: el cursor va directo a «Pagó con» (IrAlCobroAsync), sin pasar por el cuadro de captura, donde lo
            // que se teclee enseguida se tomaría como un código. No estaba en el cobro (el panel lo tapaba): no cobra todavía.
            await QuitarVentanaAsync();
            _enPago = false;
            if (Actual.Venta.Lineas.Count == 0)
                _enfocar = "#codigo";
            return true;
        }
        await Cerrar();
        return true;
    }

    /// <summary>
    /// Las que caja.js deja en los campos de una ventana abierta (Supr, las flechas, + y −, Alt+1 a Alt+6) y las que solo
    /// manda sin ventana: F12 que ya movió el cursor a «Pagó con» y las de la lista de familias (→, ←, Tab y su Esc).
    /// </summary>
    private static bool EsTeclaSinVentana(string tecla) =>
        tecla is "Delete" or "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight" or "+" or "-" or "Tab" or "Shift+Tab" or "Escape-familia"
            or "F12-pago"
        || tecla.StartsWith("Alt+", StringComparison.Ordinal);

    private void AvisarEnElPanel(string aviso)
    {
        _avisoDelPanel = aviso;
        StateHasChanged();
    }

    /// <summary>El panel que abre la tecla, para que la misma lo cierre; null si no abre uno.</summary>
    private Ventanas? PanelDeLaTecla(string tecla) => tecla switch
    {
        "F9" => Ventanas.Verificador,
        "F2" => Ventanas.Impresiones,
        "F7" => Ventanas.Entrada,
        "F8" => Ventanas.Salida,
        "Insert" or "Ctrl+P" => Ventanas.Comun,
        "Ctrl+E" => Ventanas.CambiarPrecio,
        "Ctrl+D" => Ventanas.Descuento,
        "Ctrl+L" => Ventanas.ElegirCliente,
        "Ctrl+B" => Ventanas.Abono,
        // Con las piezas escritas en el cuadro, F11 las pone en el renglón (MayoreoAsync): ahí no cierra el mayoreo.
        "F11" when _captura.Texto.Trim().TrimEnd('*').Length == 0 => Ventanas.Mayoreo,
        _ => null,
    };

    /// <summary>Un botón de la barra de teclas hace lo mismo que su tecla, también con un panel abierto (el suyo lo cierra).</summary>
    private Task ComoSuTecla(string tecla) => Tecla(tecla, null);

    // ── Captura ─────────────────────────────────────────────────────────────

    /// <summary>El cuadro se vacía al momento y el escaneo espera su turno: el lector no espera a la red.</summary>
    /// <param name="hora">La del Enter, con el reloj de la página: se mide hasta que se ve lo que agregó.</param>
    private Task AgregarCodigoAsync(double? hora = null) => _captura.EnterAsync(texto => MedidoAsync(() => ProcesarCodigoAsync(texto), hora));

    /// <summary>
    /// "7501…" agrega una pieza; "3*7501…" agrega tres; "5*" cambia la cantidad del renglón seleccionado. El QR de un
    /// ticket ("A-000123") abre la devolución. El código se busca en la copia de esta caja, también en línea (entrega 5): la
    /// red no entra en el escaneo. Lo que no está en la copia entra como «buscando…» y se le pregunta a la caja principal en
    /// segundo plano. Sin copia (el navegador sin base local), se pregunta como antes.
    /// </summary>
    private async Task ProcesarCodigoAsync(string texto)
    {
        if (FolioTicket.IsMatch(texto))
        {
            await AbrirDevolucion(texto.ToUpperInvariant());
            return;
        }

        var cantidad = Cantidad.Piezas(1);
        var asterisco = texto.IndexOf('*');
        if (asterisco > 0)
        {
            if (!decimal.TryParse(texto[..asterisco], NumberStyles.Number, CultureInfo.InvariantCulture, out var n) || n <= 0)
            {
                Avisar($"Cantidad inválida: «{texto[..asterisco]}».");
                return;
            }
            cantidad = Cantidad.Unidades(Math.Round(n, 3));
            texto = texto[(asterisco + 1)..].Trim();
            if (texto.Length == 0)
            {
                // Es para lo último que se escaneó, aunque siga «buscando…»: primero llega (o sale) su línea.
                await _captura.EsperarEnVueloAsync();
                await FijarCantidadSeleccion(cantidad);
                return;
            }
        }

        if (Cliente.Foto is { } foto)
        {
            if (foto.PorCodigo(texto) is { } enLaCopia)
                Agregar(enLaCopia, null, cantidad);
            else if (!PareceNombre(texto))
                BuscarEnLaPrincipal(texto, cantidad);
            else if (!texto.Contains(' ') && await CodigoSinNumerosAsync(texto) is { } nuevo)
                Agregar(nuevo, null, cantidad);
            else
                await AgregarNombreAsync(texto, cantidad);
            return;
        }

        try
        {
            var producto = await Cliente.PorCodigoAsync(texto, Caja.SucursalId);
            if (producto is null && PareceNombre(texto))
            {
                // El nombre se busca aquí mismo: Enter agrega el primero de la lista («3*cuad» también).
                await AgregarPrimeroAsync(texto, cantidad);
                return;
            }
            if (producto is null)
            {
                NoExiste(texto);
                return;
            }
            Agregar(producto, null, cantidad);
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    /// <summary>
    /// Una palabra sin números que no está en la copia: puede ser un código nuevo («SOBRE-A», dado de alta en otra caja) o un
    /// nombre. Como antes de la copia, primero se pregunta el código a la caja principal (con su plazo, en la cola: el nombre
    /// también la espera); si no lo tiene o no contesta, se busca como nombre.
    /// </summary>
    private async Task<ProductoVentaDto?> CodigoSinNumerosAsync(string texto)
    {
        try
        {
            return (await Cliente.BuscarEnLaPrincipalAsync(texto, Caja.SucursalId)).Producto;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            return null;
        }
    }

    /// <summary>Un nombre y Enter: se busca (en la copia de esta caja; sin ella, en el servicio) y se agrega el primero.</summary>
    private async Task AgregarNombreAsync(string texto, Cantidad cantidad)
    {
        try
        {
            await AgregarPrimeroAsync(texto, cantidad);
        }
        catch (ErrorCaja ex)
        {
            Avisar(ex.Message);
        }
    }

    /// <summary>
    /// Un código que no está en la copia de esta caja (un producto recién dado de alta en otra caja): entra en su lugar como
    /// «buscando…» y se le pregunta a la caja principal en segundo plano, con medio segundo de plazo. La cola de escaneos no
    /// lo espera; el cobro y las teclas del ticket, sí (<see cref="CapturaCodigo.EnVuelo"/>).
    /// </summary>
    private void BuscarEnLaPrincipal(string codigo, Cantidad cantidad)
    {
        var ticket = Actual;
        var buscando = new LineaBuscando(codigo, cantidad, ticket.Venta.Lineas.LastOrDefault(), ++_escaneosBuscados);
        ticket.Buscando.Add(buscando);
        // Como al agregar: ya empezó el siguiente cliente, y el aviso de antes ya pasó.
        (_cobrado, _avisoDelCobro, _mensaje) = (null, null, null);
        _captura.EnVuelo(ResolverAsync(ticket, buscando));
    }

    /// <summary>
    /// Lo que contestó la caja principal: el producto toma el lugar del «buscando…» (y queda en la foto de la copia); si no
    /// existe, lo de siempre (darlo de alta o venderlo como artículo común, según los permisos); si no contestó a tiempo, el
    /// renglón sale y se le dice al cajero que lo escanee otra vez.
    /// </summary>
    private async Task ResolverAsync(TicketAbierto ticket, LineaBuscando buscando)
    {
        var respuesta = CodigoDeLaPrincipal.NoContesto;
        try
        {
            respuesta = await Cliente.BuscarEnLaPrincipalAsync(buscando.Codigo, Caja.SucursalId);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // Lo que sea (una respuesta que no se entiende): como si no hubiera contestado. El renglón no se queda buscando.
        }
        finally
        {
            ticket.Buscando.Remove(buscando);
        }
        // La pantalla ya se fue (se volvió a cargar): sus tickets ya no son los de la caja; no se tocan ni se guardan.
        if (_seFue)
            return;
        if (respuesta.Producto is { } producto)
            AgregarEnSuLugar(ticket, buscando, producto);
        else if (respuesta.Contesto)
            NoExiste(buscando.Codigo);
        else if (respuesta.Pregunto)
            Avisar($"«{buscando.Codigo}» no está en la copia de esta caja y la caja principal no contestó: escanéalo otra vez en un momento.");
        else
        {
            // Sin conexión (o mientras sube lo que hizo sin ella, que también se vende con la copia): como antes, lo que sus
            // permisos le dejan (el artículo común se vende sin conexión).
            var elige = Ve(AccionControlada.AltaRapida) || Ve(AccionControlada.ArticuloComun);
            Avisar($"«{buscando.Codigo}» no está en la copia de esta caja y ahora se vende sin la caja principal. Revisa el código{(elige ? " o elige:" : ".")}");
            _codigoNuevo = buscando.Codigo;
        }
        if (ticket != Actual && _tickets.Contains(ticket))
        {
            // Un ticket que ya no se atiende: si solo esperaba este código y se quedó vacío, se descarta, como al retomar otro;
            // si no, se guarda en espera con su línea nueva.
            if (ticket.Venta.Lineas.Count == 0 && ticket.Buscando.Count == 0)
            {
                var actual = Actual;
                _tickets.Remove(ticket);
                _actual = _tickets.IndexOf(actual);
            }
            else if (respuesta.Producto is not null)
                GuardarEspera();
        }
        StateHasChanged();
    }

    /// <summary>Como el prototipo: bajo el aviso, darlo de alta o venderlo como artículo común, si sus permisos lo dejan.</summary>
    private void NoExiste(string codigo)
    {
        var elige = Ve(AccionControlada.AltaRapida) || Ve(AccionControlada.ArticuloComun);
        Avisar($"No existe «{codigo}». Revisa el código{(elige ? " o elige:" : ".")}");
        _codigoNuevo = codigo;
    }

    /// <summary>
    /// El producto que llegó de la caja principal, donde estaba su «buscando…»: debajo de lo que se escaneó antes y arriba de
    /// lo que se escaneó después. Si ya estaba en el ticket, suma a su línea, como cualquier escaneo. Lo seleccionado se
    /// queda, salvo que la línea nueva quede al final (lo último que se escaneó).
    /// </summary>
    private void AgregarEnSuLugar(TicketAbierto ticket, LineaBuscando buscando, ProductoVentaDto producto)
    {
        var lineas = ticket.Venta.Lineas;
        var seleccionada = ticket == Actual ? LineaSeleccionada : null;
        var antes = lineas.Count;
        VentaLinea linea;
        try
        {
            linea = ticket.Venta.AgregarProducto(producto.ParaVenta(), producto.PresentacionModelo(), buscando.Cantidad, producto.PreciosModelo());
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
            return;
        }
        DescuentoDelCliente(ticket, linea);
        ticket.Calculada(linea, producto);
        if (lineas.Count > antes)
        {
            lineas.Remove(linea);
            var anterior = buscando.Despues is { } despues ? lineas.IndexOf(despues) : -1;
            lineas.Insert(buscando.Despues is null ? 0 : anterior < 0 ? lineas.Count : anterior + 1, linea);
            // Los que se escanearon después y esperaban detrás de la misma línea, ahora van detrás de esta.
            foreach (var otro in ticket.Buscando.Where(b => b.Despues == buscando.Despues && b.Numero > buscando.Numero))
                otro.Despues = linea;
        }
        if (ticket != Actual)
            return;
        (_cobrado, _avisoDelCobro) = (null, null);
        _seleccion = seleccionada is null || lineas[^1] == linea ? lineas.IndexOf(linea) : lineas.IndexOf(seleccionada);
        _ = Js.MostrarAsync($"#linea-{_seleccion}");
    }

    private void Agregar(ProductoVentaDto producto, Guid? presentacionId, Cantidad cantidad)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        (_cobrado, _avisoDelCobro) = (null, null);
        try
        {
            var linea = Actual.Venta.AgregarProducto(producto.ParaVenta(), producto.PresentacionModelo(presentacionId), cantidad, producto.PreciosModelo());
            DescuentoDelCliente(linea);
            Actual.Calculada(linea, producto);
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
            _mensaje = null;
            _ = Js.MostrarAsync($"#linea-{_seleccion}");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    private async Task AgregarComun((string Descripcion, long Precio, Cantidad Cantidad) articulo)
    {
        // Ya empezó el siguiente cliente: el cambio del anterior deja el panel.
        _cobrado = null;
        await Cerrar();
        try
        {
            var linea = Actual.Venta.AgregarArticuloComun(articulo.Descripcion, articulo.Precio, articulo.Cantidad);
            DescuentoDelCliente(linea);
            _seleccion = Actual.Venta.Lineas.IndexOf(linea);
            // Como al agregar un producto: el aviso de antes (el código que no existía, con sus botones) ya pasó.
            _mensaje = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
        }
    }

    // ── Renglones ───────────────────────────────────────────────────────────

    private void Seleccionar(int indice) => _seleccion = indice;

    /// <summary>Lo que dice el renglón de una línea (FilaTicket): con lo mismo que la vez pasada, no se vuelve a pintar.</summary>
    private FilaTicket.Datos Renglon(VentaLinea linea)
    {
        var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
        return new FilaTicket.Datos(
            ConPasos: producto is not null && !linea.EsImpresiones,
            Cantidad: linea.Cantidad.EnUnidades,
            Nombre: linea.EsImpresiones ? $"Impresiones ({Actual.Impresiones.Count})" : Descripcion(linea, producto),
            Codigo: producto?.Codigo,
            Mayoreo: linea.TieneMayoreo ? $"{MayoreoTexto(linea, producto)} · ahorra {Formato.Dinero(linea.AhorroMayoreoCentavos)}" : null,
            Descuento: linea.TieneDescuento ? $"Descuento −{Formato.Dinero(linea.DescuentoCentavos)} · {linea.MotivoDescuento}" : null,
            PrecioCambiado: linea.PrecioCambiado,
            Existencia: producto?.Existencia is { } quedan && quedan <= 3 ? quedan <= 0 ? "Sin existencia en el sistema" : $"Quedan {Formato.Numero(quedan)}" : null,
            PrecioOriginalCentavos: linea.PrecioOriginalCentavos ?? 0,
            PrecioCentavos: linea.PrecioCentavos,
            ImporteCentavos: linea.ImporteCentavos);
    }

    /// <summary>Las acciones del renglón elegido, según lo que puede quien entró: lo que no puede no sale.</summary>
    private FilaTicket.AccionesDeFila AccionesDe(VentaLinea linea)
    {
        var producto = linea.VarianteId is { } v ? Actual.Productos.GetValueOrDefault(v) : null;
        var deProducto = producto is not null && !linea.EsImpresiones;
        return new FilaTicket.AccionesDeFila(
            Precio: deProducto && Ve(AccionControlada.CambiarPrecio) ? MarcaDe(AccionControlada.CambiarPrecio, "Ctrl+E") : null,
            Descuento: Ve(AccionControlada.Descuento) ? MarcaDe(AccionControlada.Descuento, "Ctrl+D") : null,
            LimiteDeDescuento: Permiso(AccionControlada.Descuento) is { Nivel: NivelPermiso.Permitido, UmbralCentavos: { } umbral }
                ? Permisos.TextoMonto(AccionControlada.Descuento, umbral) : null,
            Mayoreo: deProducto && TieneEscalas(producto!),
            Quitar: Ve(AccionControlada.QuitarProducto));
    }

    /// <summary>La tecla, o el candado con quién autoriza.</summary>
    private FilaTicket.MarcaDeAccion MarcaDe(AccionControlada accion, string tecla) =>
        new(tecla, Permiso(accion) is { Nivel: NivelPermiso.RequiereAutorizacion } p ? Quien(p) : null);

    /// <summary>Los botones − y + de un renglón.</summary>
    private Task PasoDeFilaAsync((int Indice, int Paso) paso) => PasoCantidadAsync(paso.Indice, paso.Paso);

    /// <summary>Un botón de las acciones del renglón elegido: lo mismo que su tecla.</summary>
    private Task AccionDeFilaAsync(FilaTicket.Accion accion) => accion switch
    {
        FilaTicket.Accion.Precio => EnLaFilaAsync(AbrirCambioPrecio),
        FilaTicket.Accion.Descuento => EnLaFilaAsync(() => Abrir(Ventanas.Descuento)),
        FilaTicket.Accion.Mayoreo => EnLaFilaAsync(MayoreoAsync),
        _ => EnLaFilaAsync(BorrarSeleccion),
    };

    private async Task MoverSeleccion(int paso)
    {
        if (Actual.Venta.Lineas.Count == 0)
            return;
        _seleccion = Math.Clamp(_seleccion + paso, 0, Actual.Venta.Lineas.Count - 1);
        await Js.MostrarAsync($"#linea-{_seleccion}");
    }

    private async Task BorrarSeleccion()
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Actual.Impresiones.Clear();
            Actual.Venta.FijarImpresiones(0, 0);
        }
        else
            Actual.Venta.QuitarLinea(linea);
        _seleccion = Math.Min(_seleccion, Actual.Venta.Lineas.Count - 1);
        await RegistrarQuitadoAsync($"Quitó «{linea.Descripcion}» × {linea.Cantidad} del ticket {Actual.Numero}", linea.ImporteCentavos);
    }

    private async Task CambiarCantidadSeleccion(int paso)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
            return;
        var linea = Actual.Venta.Lineas[_seleccion];
        var nueva = linea.Cantidad + Cantidad.Piezas(paso);
        if (!nueva.EsPositiva)
        {
            await BorrarSeleccion();
            return;
        }
        await FijarCantidadSeleccion(nueva);
    }

    /// <summary>Quitar lo ya escaneado no requiere permiso, pero siempre queda en la bitácora.</summary>
    private async Task RegistrarQuitadoAsync(string detalle, long montoCentavos)
    {
        try
        {
            await Cliente.BitacoraAsync(new SolicitudBitacora(Sesion.UsuarioId, Caja.SucursalId, Caja.Id, AccionControlada.QuitarProducto, detalle, montoCentavos));
        }
        catch (ErrorCaja ex)
        {
            Avisar($"No quedó en la bitácora: {ex.Message}");
        }
    }

    /// <summary>
    /// F11: el mayoreo ya se aplica solo al llegar a la cantidad. Como en eleventa, si se escribieron las piezas (el
    /// paquete) y luego F11, esa es la cantidad del renglón seleccionado; si no, muestra sus escalas.
    /// </summary>
    private async Task MayoreoAsync()
    {
        if (LineaSeleccionada is not { VarianteId: { } varianteId, EsImpresiones: false } linea || !Actual.Productos.ContainsKey(varianteId))
        {
            Avisar("Selecciona un producto (flechas) para ver su mayoreo.");
            return;
        }
        var texto = _captura.Texto.Trim().TrimEnd('*');
        if (texto.Length > 0)
        {
            if (!decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var piezas) || piezas <= 0)
            {
                Avisar($"Escribe cuántas lleva antes de F11: «{texto}» no es una cantidad.");
                return;
            }
            // Si no se pudo (una fracción en algo por pieza), se queda el error y lo escrito.
            if (!await FijarCantidadSeleccion(Cantidad.Unidades(Math.Round(piezas, 3))))
                return;
            VaciarCaptura();
            if (linea.TieneMayoreo)
                Avisar($"{MayoreoTexto(linea, Actual.Productos[varianteId])}: ahorra {Formato.Dinero(linea.AhorroMayoreoCentavos)}.", error: false);
            else if (linea.PrecioCambiado)
                Avisar("El precio de este renglón se cambió a mano: no aplica el mayoreo.", error: false);
            else if (_mensaje is null)
                Avisar("A esa cantidad no hay mayoreo: F11 sin escribir nada muestra desde cuánto.", error: false);
            return;
        }
        await Abrir(Ventanas.Mayoreo);
    }

    /// <summary>"Mayoreo desde 12", o "desde 24 pzas" en un renglón de paquetes, o "desde 10 m" a granel.</summary>
    private static string MayoreoTexto(VentaLinea linea, ProductoVentaDto? producto) =>
        linea.MayoreoDeCliente ? "Mayoreo de cliente"
            : $"Mayoreo desde {ArmadoTicket.MayoreoTexto(linea.MayoreoDesde!.Value, linea.Unidad, producto?.PresentacionModelo(linea.PresentacionId).EsBase ?? true)}";

    /// <summary>Si se cambió la cantidad; si no, ya avisó por qué.</summary>
    private async Task<bool> FijarCantidadSeleccion(Cantidad cantidad)
    {
        if (_seleccion < 0 || _seleccion >= Actual.Venta.Lineas.Count)
        {
            Avisar("Selecciona un renglón (flechas) para cambiar su cantidad.");
            return false;
        }
        var linea = Actual.Venta.Lineas[_seleccion];
        if (linea.EsImpresiones)
        {
            Avisar("Las impresiones se eligen con F2.");
            return false;
        }
        if (linea.VarianteId is not { } varianteId || !Actual.Productos.TryGetValue(varianteId, out var producto))
        {
            Avisar("La cantidad del artículo común no se cambia: bórralo y agrégalo de nuevo.");
            return false;
        }
        var (antes, importeAntes) = (linea.Cantidad, linea.ImporteCentavos);
        try
        {
            Actual.Venta.CambiarCantidad(linea, cantidad, producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo());
            Actual.Versiones[linea] = producto.Version;
            _mensaje = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Avisar(ex.Message);
            return false;
        }
        if (cantidad < antes)
            await RegistrarQuitadoAsync($"Bajó «{linea.Descripcion}» de {antes} a {cantidad} en el ticket {Actual.Numero}", importeAntes - linea.ImporteCentavos);
        return true;
    }

    // ── Tickets ─────────────────────────────────────────────────────────────

    private Venta VentaVacia() => new()
    {
        SucursalId = Caja.SucursalId,
        CajaId = Caja.Id,
        TurnoId = Turno.Id,
        CajeroId = Sesion.UsuarioId,
        Serie = Caja.Serie,
        CreadaUtc = DateTime.UtcNow,
    };

    private void NuevoTicket()
    {
        _tickets.Add(new TicketAbierto { Numero = _siguienteNumero++, Venta = VentaVacia() });
        _actual = _tickets.Count - 1;
        _seleccion = -1;
        LimpiarCobro();
        _ = Js.EnfocarAsync("#codigo");
        GuardarEspera();
    }

    private void Cambiar(TicketAbierto ticket)
    {
        _actual = _tickets.IndexOf(ticket);
        _seleccion = Actual.Venta.Lineas.Count - 1;
        LimpiarCobro();
        GuardarEspera();
    }

    /// <summary>
    /// Cada vez que cambia el ticket que se atiende (F6, F5, retomar, cobrar), los que tienen algo quedan
    /// guardados en la caja. También el que se atiende, como estaba en ese momento: si se va la luz, vuelve en espera.
    /// </summary>
    private void GuardarEspera()
    {
        var conAlgo = _tickets.Where(t => t.Venta.Lineas.Count > 0).ToList();
        // Sin tickets con algo, ni antes ni ahora (lo de casi siempre al cobrar): no hay nada que escribir.
        if (conAlgo.Count == 0 && !_hayEsperaGuardada)
            return;
        // Como están ahora: se escriben en el hilo del escritor de la base local (entrega 5), y la pantalla sigue mientras.
        var guardados = conAlgo.Select(t => TicketsEnEspera.Guardar(t.Venta, t.Productos, t.Impresiones, t.Cliente, t.Cuenta, t.FiadoSinConfirmar)).ToList();
        _hayEsperaGuardada = conAlgo.Count > 0;
        _esperaGuardandose = GuardarEsperaAsync(guardados);
    }

    /// <summary>Lo último que se mandó guardar de la espera: al salir, al cerrar el turno o antes de instalar, se espera.</summary>
    private Task _esperaGuardandose = Task.CompletedTask;

    private async Task GuardarEsperaAsync(List<TicketGuardado> guardados)
    {
        try
        {
            await Cliente.GuardarEnEsperaAsync(guardados);
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException)
        {
            _hayEsperaGuardada = true;
            Avisar($"No se pudieron guardar los tickets en espera en esta caja: {ex.Message}");
            StateHasChanged();
        }
    }

    /// <summary>Guarda la espera y termina cuando ya quedó (al salir de la venta, al cerrar el turno, antes de instalar).</summary>
    private async Task GuardarEsperaYEsperarAsync()
    {
        GuardarEspera();
        await _esperaGuardandose;
    }

    /// <summary>Al entrar a la venta, los que quedaron guardados (de antes de un reinicio o un apagón) vuelven a esperar.</summary>
    private void RecuperarEspera()
    {
        List<TicketGuardado> guardados;
        try
        {
            guardados = Cliente.TicketsEnEspera();
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or IOException or System.Text.Json.JsonException)
        {
            Avisar($"No se pudieron leer los tickets en espera de esta caja: {ex.Message}");
            return;
        }
        var perdidas = 0;
        foreach (var guardado in guardados)
        {
            var ticket = new TicketAbierto
            {
                Numero = _siguienteNumero++, Venta = VentaVacia(), Cliente = guardado.Cliente, Cuenta = guardado.Cuenta,
                FiadoSinConfirmar = guardado.FiadoSinConfirmar,
            };
            perdidas += TicketsEnEspera.Rearmar(guardado, ticket.Venta);
            foreach (var producto in guardado.Productos)
                ticket.Productos[producto.VarianteId] = producto;
            ticket.Impresiones.AddRange(guardado.Impresiones);
            if (ticket.Venta.Lineas.Count > 0)
                _tickets.Add(ticket);
        }
        if (_tickets.Count > 0)
            Avisar((_tickets.Count == 1 ? "Volvió el ticket que estaba en espera." : $"Volvieron los {_tickets.Count} tickets que estaban en espera.")
                + (perdidas > 0 ? $" {perdidas} productos ya no se pudieron armar: revísalos." : ""), error: perdidas > 0);
    }

    /// <summary>Si lo último que se guardó tenía tickets: al entrar puede haber de antes, por eso empieza en sí.</summary>
    private bool _hayEsperaGuardada = true;

    // ── Cobro e impresión ───────────────────────────────────────────────────

    /// <summary>
    /// Cobra el ticket que se atiende. Quien llama ya apartó la cola (<see cref="EnTurnoDeCobroAsync"/>): se suelta en
    /// cuanto está el ticket del siguiente cliente, antes de imprimir, y lo que se escaneó mientras se cobraba cae ahí.
    /// Devuelve el error, que el panel dice; null si se cobró.
    /// </summary>
    private async Task<string?> CobrarAsync(IReadOnlyList<CobroSolicitado> cobros, Guid? autorizacionCredito, CapturaCodigo.Apartado apartado)
    {
        var abierto = Actual;
        var venta = abierto.Venta;
        TicketDto ticket;
        try
        {
            // Con la versión de la que salieron los precios que vio el cajero (entrega 5): si alguno cambió después, el servicio
            // no cobra y contesta con los de ahora.
            var (lineas, version) = ArmadoSolicitud.ParaCobrar(venta, abierto.VersionDe, Cliente.Foto?.Version);
            // Con el Id del ticket: si la respuesta se pierde, el siguiente intento (en línea o sin conexión) es la misma venta.
            ticket = await Cliente.CobrarAsync(new SolicitudCobro(Caja.Id, Turno.Id, Sesion.UsuarioId, lineas, cobros,
                VentaId: venta.Id, Impresiones: abierto.Impresiones.Count > 0 ? abierto.Impresiones.Select(i => i.Id).ToList() : null,
                ClienteId: venta.ClienteId, AutorizacionDescuentoId: venta.AutorizacionDescuentoId,
                AutorizacionBajoCostoId: venta.AutorizacionBajoCostoId, MayoreoDeCliente: venta.MayoreoDeCliente,
                AutorizacionCreditoId: autorizacionCredito, VersionCatalogo: version), soloEnLinea: abierto.FiadoSinConfirmar);
        }
        catch (ErrorCaja ex) when (ex.PreciosCambiados is { } preciosCambiados)
        {
            // No se cobró: el ticket se pone al día y el cajero lo revisa; el cobro no se repite solo.
            return PonerPreciosAlDia(abierto, preciosCambiados);
        }
        catch (ErrorCaja ex)
        {
            if (ex.Codigo == "fiado-sin-confirmar")
                abierto.FiadoSinConfirmar = true;
            // Si no se pudo fiar (otra caja le fió, le abonaron, venció la autorización…), el panel del total sigue con la
            // cuenta al día; los callbacks de las ventanas no vuelven a dibujar esta pantalla.
            if (abierto.Cliente is not null && cobros.Any(c => c.Forma == FormaPago.Credito))
            {
                await CargarCuentaAsync(abierto);
                StateHasChanged();
            }
            return ex.Message;
        }
        // Sale el que se cobró, aunque mientras se haya tocado otro (una ficha en espera). Los que esperan se quedan
        // esperando: lo siguiente es un ticket vacío para el siguiente cliente.
        _tickets.Remove(abierto);
        NuevoTicket();
        apartado.Dispose();
        Avisar($"Venta {ticket.FolioImpreso} cobrada. Cambio: {Formato.Dinero(ticket.CambioCentavos)}", error: false);
        _ultimo = ticket;
        await ImprimirCobradoAsync(ticket);
        await RevisarEfectivoAsync();
        if (abierto.Impresiones.Count > 0 && _estado is not null)
            await _estado.ActualizarAsync();
        return null;
    }

    /// <summary>
    /// El servicio no cobró (entrega 5): el precio o el mayoreo de algo del ticket cambió después de la copia con que se
    /// pusieron sus precios. Las líneas de esos productos se vuelven a calcular con los precios de ahora (un precio cambiado a
    /// mano se queda); lo demás del ticket ya lo revisó el servicio hasta su versión, y la foto de la caja se queda con lo de
    /// ahora para el siguiente escaneo. El panel del cobro dice qué cambió; el cobro no se repite solo. Lo que el cliente dio
    /// se queda escrito: el cambio se vuelve a calcular con el total nuevo.
    /// </summary>
    private string PonerPreciosAlDia(TicketAbierto ticket, PreciosCambiadosDto precios)
    {
        var venta = ticket.Venta;
        var antes = venta.Lineas.ToDictionary(l => l, l => (l.PrecioCentavos, l.ImporteCentavos, l.AhorroMayoreoCentavos));
        var cambiados = precios.Productos.Select(p => p.VarianteId).ToHashSet();
        // Lo que no cambió ya lo revisó el servicio hasta su versión: sus líneas tienen los precios de ahora.
        foreach (var linea in venta.Lineas.Where(l => l.VarianteId is { } v && !l.EsImpresiones && !cambiados.Contains(v)))
        {
            if (ticket.VersionDe(linea) is not { } version || version < precios.VersionCatalogo)
                ticket.Versiones[linea] = precios.VersionCatalogo;
        }
        foreach (var (varianteId, producto) in ticket.Productos.ToList())
        {
            if (!cambiados.Contains(varianteId) && (producto.Version is not { } version || version < precios.VersionCatalogo))
                ticket.Productos[varianteId] = producto with { Version = precios.VersionCatalogo };
        }
        foreach (var producto in precios.Productos)
        {
            Cliente.PreciosAlDia(producto);
            var lineas = venta.Lineas.Where(l => l.VarianteId == producto.VarianteId && !l.EsImpresiones).ToList();
            foreach (var linea in lineas)
                ticket.Versiones.TryAdd(linea, ticket.VersionDe(linea));
            ticket.Productos[producto.VarianteId] = producto;
            foreach (var linea in lineas)
            {
                try
                {
                    venta.CambiarCantidad(linea, linea.Cantidad, producto.PresentacionModelo(linea.PresentacionId), producto.PreciosModelo());
                    ticket.Versiones[linea] = producto.Version;
                }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
                {
                    // Ya no tiene esa presentación o se quedó sin precio: la línea queda como estaba (con la versión de sus
                    // precios) y el servicio lo dice al cobrar.
                }
            }
        }
        var cambiaron = precios.Productos
            .Where(p => venta.Lineas.Any(l => l.VarianteId == p.VarianteId && antes.TryGetValue(l, out var a)
                                              && a != (l.PrecioCentavos, l.ImporteCentavos, l.AhorroMayoreoCentavos)))
            .Select(p => $"«{p.Descripcion}»")
            .ToList();
        _avisoDelCobro = cambiaron.Count > 0
            ? $"Cambió el precio de {Textos.Lista(cambiaron)}: revisa el total ({Formato.Dinero(venta.TotalCentavos)}) y cobra otra vez."
            : $"Se pusieron al día los precios de {Textos.Lista(precios.Productos.Select(p => $"«{p.Descripcion}»").ToList())} con la caja principal; "
              + "el total no cambió: cobra otra vez.";
        _enfocar = EnEfectivo.ACobrarCentavos > 0 ? "#pago-nuevo" : "#cobrar-nuevo";
        return _avisoDelCobro;
    }

