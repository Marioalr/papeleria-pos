@* Solo en la prueba con una persona real (docs/plan.md): avisa que son datos ficticios y da la guía de la prueba, los
   avisos que le habrían llegado al dueño por Telegram, empezar de cero y (en la caja de Windows, la que sigue sin la caja
   principal) simular que no hay conexión: el servicio de la prueba corre en la misma PC y no hay cable que desconectar.
   Las respuestas van con la versión de la guía, y al terminar una persona se guardan y la guía queda en blanco para la
   siguiente (el sábado una y el domingo otra). La tarea que toca se ve en un renglón debajo, mientras se hace. *@
@inject ClienteCaja Cliente
@inject ConexionCaja Conexion
@inject ModuloCaja Js
@inject NavigationManager Navegacion
@inject IServiceProvider Servicios
@implements IAsyncDisposable

@if (_prueba)
{
    <div class="franja-prueba">
        <strong>Prueba: datos ficticios.</strong>
        <span>Nada de esto es real; puedes equivocarte sin problema.</span>
        <button class="boton chico" @onclick="AbrirGuiaAsync">Guía de la prueba (@Contestadas de @GuiaPrueba.Tareas.Count)</button>
        <button class="boton chico" @onclick="AbrirAvisosAsync">Avisos al dueño</button>
        <button class="boton chico" @onclick="() => AbrirAsync(Panel.EmpezarDeCero)">Empezar de cero</button>
        @if (Servicios.GetService<Contingencia>() is not null)
        {
            <button class="boton chico @(Conexion.SimularSinConexion ? "principal" : "")" disabled="@_ocupado" @onclick="SimularAsync">
                @(Conexion.SimularSinConexion ? "Volver a conectar" : "Simular sin conexión")
            </button>
        }
    </div>
    @if (Actual is { } actual)
    {
        @* La tarea que toca, a la vista mientras se hace y sin tapar el ticket (la guía completa sigue en su botón). Los botones
           no se quedan con el cursor: lo que se escanea después va al cuadro de captura, y su Enter no oprime «Siguiente». Una
           ya contestada (se llega a ella con «Siguiente» cuando solo falta otra) se ve marcada, como en la guía. *@
        var ya = Respuesta(actual.Id).SalioBien;
        <div class="franja-tarea">
            <span class="num">Tarea @(_actual + 1) de @GuiaPrueba.Tareas.Count@(ya is null ? "" : " · ya contestada")</span>
            @if (_anotando)
            {
                <input class="nota-tarea" placeholder="¿Qué falló o qué viste? (Enter para seguir)" autocomplete="off" @ref="_nota"
                       @bind="_notaFalla" @bind:event="oninput" @onkeydown="AlTeclearNota" @onfocus="() => NotaConCursorAsync(true)"
                       @onblur="() => NotaConCursorAsync(false)" />
            }
            else
            {
                <span class="hacer" title="@($"{actual.Hacer}\nDebe pasar: {actual.Esperado}")">@actual.Hacer</span>
                <button class="boton chico @(ya == true ? "principal" : "")" @onmousedown:preventDefault="true" @onclick="() => MarcarActualAsync(true)">Salió bien</button>
                <button class="boton chico @(ya == false ? "principal" : "")" @onmousedown:preventDefault="true" @onclick="() => MarcarActualAsync(false)">Algo falló</button>
            }
            <button class="boton chico" @onmousedown:preventDefault="true" @onclick="SiguienteAsync">Siguiente</button>
        </div>
    }
    else if (Contestadas == GuiaPrueba.Tareas.Count)
    {
        <div class="franja-tarea"><span class="hacer">Contestaste todas las tareas: en «Guía de la prueba» guarda tus respuestas.</span></div>
    }

    @switch (_panel)
    {
        case Panel.Guia:
            <Ventana Titulo="Guía de la prueba" Clase="configuracion" AlCerrar="CerrarAsync">
                <p class="nota">
                    Haz cada tarea en la caja (puedes cerrar esta ventana y volver) y marca si salió lo que debía pasar. Si algo
                    estorbó, fue lento o confuso, escríbelo aunque haya salido bien. Los usuarios y PIN están en «Léeme.txt».
                    Primero va lo de vender en la pantalla nueva; al final, lo que todavía abre las pantallas de hoy (dice
                    «@GuiaPrueba.PantallaDeHoy»).
                </p>
                <label>Tu nombre <input @bind="_respuestas.Nombre" @bind:after="GuardarAsync" autocomplete="off" /></label>
                @foreach (var grupo in GuiaPrueba.Tareas.GroupBy(t => t.Tema))
                {
                    <h5>@grupo.Key</h5>
                    @foreach (var tarea in grupo)
                    {
                        var t = tarea;
                        var r = Respuesta(t.Id);
                        <div class="tarea-prueba @(r.SalioBien switch { true => "bien", false => "mal", _ => "" })">
                            <div><strong>@t.Hacer</strong></div>
                            <div class="nota">Debe pasar: @t.Esperado</div>
                            <div class="acciones izquierda">
                                <button class="boton chico @(r.SalioBien == true ? "principal" : "")" @onclick="() => MarcarAsync(t.Id, true)">Salió bien</button>
                                <button class="boton chico @(r.SalioBien == false ? "principal" : "")" @onclick="() => MarcarAsync(t.Id, false)">Algo falló</button>
                                <input class="nota-tarea" placeholder="¿Qué viste? (opcional)" value="@r.Nota" @onchange="e => AnotarAsync(t.Id, e.Value?.ToString())" />
                            </div>
                        </div>
                    }
                }
                <label>Comentarios generales: ¿qué te faltó, qué fue lento o confuso?
                    <textarea rows="4" @bind="_respuestas.Comentarios" @bind:after="GuardarAsync"></textarea>
                </label>
                @if (_error is not null)
                {
                    <p class="error">@_error</p>
                }
                @if (_aviso is not null)
                {
                    <p class="aviso">@_aviso</p>
                }
                <div class="acciones izquierda">
                    <button class="boton principal" disabled="@_ocupado" @onclick="ExportarAsync">Guardar mis respuestas en el escritorio</button>
                    <span class="nota">Se guardan solas mientras contestas; este botón deja el archivo para mandarlo.</span>
                </div>
                @if (_confirmarEnBlanco)
                {
                    <p>
                        Tus respuestas se guardan en el escritorio, como con el botón de arriba, y la guía queda en blanco para la
                        siguiente persona. Lo que hiciste en la caja se queda (para eso es «Empezar de cero»).
                    </p>
                    <div class="acciones izquierda">
                        <button class="boton" @onclick="() => _confirmarEnBlanco = false">No</button>
                        <button class="boton principal" disabled="@_ocupado" @onclick="DejarEnBlancoAsync">Sí, guardarlas y dejar la guía en blanco</button>
                    </div>
                }
                else
                {
                    <div class="acciones izquierda">
                        <button class="boton" disabled="@_ocupado" @onclick="PedirEnBlanco">Guardar respuestas y dejar la guía en blanco</button>
                        <span class="nota">Cuando termines, para que pruebe otra persona.</span>
                    </div>
                }
            </Ventana>
            break;

        case Panel.Avisos:
            <Ventana Titulo="Avisos que le llegarían al dueño por Telegram" Clase="ventas-dia" AlCerrar="CerrarAsync">
                <p class="nota">En la tienda le llegan al dueño a su celular. En la prueba no se manda nada: se ven aquí.</p>
                @if (_avisos is { Count: 0 })
                {
                    <p class="vacia">Todavía no hay avisos. Llegan con una cancelación, un corte con diferencia, una compra con faltantes…</p>
                }
                @foreach (var aviso in _avisos ?? [])
                {
                    <div class="tarea-prueba">
                        <div class="nota">@aviso.FechaLocal.ToString("dd/MM/yyyy HH:mm")</div>
                        <pre class="aviso-telegram">@aviso.Texto</pre>
                    </div>
                }
            </Ventana>
            break;

        case Panel.EmpezarDeCero:
            <Ventana Titulo="Empezar de cero" AlCerrar="CerrarAsync">
                <p>
                    La caja vuelve a como se instaló: se pierde lo que hiciste en la prueba (ventas, compras, turnos). Tus respuestas
                    de la guía se quedan; para que pruebe otra persona, en la guía: «Guardar respuestas y dejar la guía en blanco».
                </p>
                @if (_error is not null)
                {
                    <p class="error">@_error</p>
                }
                <div class="acciones">
                    <button class="boton" @onclick="CerrarAsync">No</button>
                    <button class="boton principal" disabled="@_ocupado" @onclick="EmpezarDeCeroAsync">Sí, empezar de cero</button>
                </div>
            </Ventana>
            break;
    }
}

@code {
    private enum Panel { Ninguno, Guia, Avisos, EmpezarDeCero }

    private sealed class Respuestas
    {
        public string? Nombre { get; set; }
        public Dictionary<string, RespuestaTareaDto> Tareas { get; set; } = [];
        public string? Comentarios { get; set; }

        public RespuestasPruebaDto Dto() => new(Nombre, Tareas, Comentarios, GuiaPrueba.Version);
    }

    private bool _prueba;
    private Panel _panel;
    private Respuestas _respuestas = new();
    private List<AvisoPruebaDto>? _avisos;
    private bool _ocupado;
    private string? _error;
    private string? _aviso;
    private bool _confirmarEnBlanco;

    /// <summary>
    /// Las respuestas suben una tras otra: una nota que se guarda al dejar su cuadro no llega después de dejar la guía en
    /// blanco (y la llenaría otra vez con lo de la persona anterior).
    /// </summary>
    private readonly SemaphoreSlim _subiendo = new(1, 1);

    private int Contestadas => GuiaPrueba.Tareas.Count(t => _respuestas.Tareas.GetValueOrDefault(t.Id)?.SalioBien is not null);

    // ── La tarea que toca, en la franja ────────────────────────────────────

    /// <summary>La que se ve en la franja: empieza en la primera sin contestar; -1 si ya están todas.</summary>
    private int _actual;

    /// <summary>Después de «Algo falló»: el renglón pide qué pasó (opcional) antes de seguir.</summary>
    private bool _anotando;

    private string _notaFalla = "";

    /// <summary>
    /// El cuadro de la nota. Recibe el cursor al aparecer: los botones no se lo quedan, así que seguiría en el cuadro de
    /// captura, y lo que se escribiera de lo que falló sería una búsqueda, y su Enter agregaría un producto al ticket.
    /// </summary>
    private ElementReference _nota;

    private bool _enfocarNota;

    private bool _notaConCursor;

    private TareaPrueba? Actual => _actual >= 0 && _actual < GuiaPrueba.Tareas.Count ? GuiaPrueba.Tareas[_actual] : null;

    /// <summary>Si en la guía se contestó la que se veía (o se dejó en blanco), la franja pasa a la que sigue sin contestar.</summary>
    private void SeguirConLaQueFalta()
    {
        if (!_anotando && (Actual is not { } tarea || Respuesta(tarea.Id).SalioBien is not null))
            _actual = GuiaPrueba.SinContestarDespuesDe(_respuestas.Tareas, Math.Max(_actual, 0) - 1);
    }

    private async Task MarcarActualAsync(bool salioBien)
    {
        if (Actual is not { } tarea)
            return;
        _respuestas.Tareas[tarea.Id] = Respuesta(tarea.Id) with { SalioBien = salioBien };
        if (salioBien)
            _actual = GuiaPrueba.SinContestarDespuesDe(_respuestas.Tareas, _actual);
        else
            (_anotando, _notaFalla, _enfocarNota) = (true, Respuesta(tarea.Id).Nota ?? "", true);
        await GuardarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enfocarNota && _anotando)
        {
            _enfocarNota = false;
            await _nota.FocusAsync();
        }
    }

    /// <summary>Con lo que haya escrito de lo que falló, a la siguiente (<see cref="GuiaPrueba.Siguiente"/>); el cursor vuelve al cuadro de captura.</summary>
    private async Task SiguienteAsync()
    {
        if (_anotando && Actual is { } tarea)
            await AnotarAsync(tarea.Id, _notaFalla);
        // El cuadro de la nota se quita: puede que el navegador no avise que dejó de tener el cursor.
        (_anotando, _notaConCursor) = (false, false);
        await AvisarVentanaAsync();
        _actual = GuiaPrueba.Siguiente(_respuestas.Tareas, _actual);
        await Js.EnfocarAsync("#codigo");
    }

    /// <summary>
    /// El cursor entra o sale de la nota. Con él ahí, la venta de atrás no se queda con Supr, Ins ni Alt+1 (borraría un
    /// renglón del ticket o agregaría un rápido). Al salir (Esc, que regresa al cuadro de captura, o un clic en la venta), lo
    /// escrito se guarda y el renglón sigue pidiendo la nota hasta «Siguiente».
    /// </summary>
    private async Task NotaConCursorAsync(bool conCursor)
    {
        _notaConCursor = conCursor;
        await AvisarVentanaAsync();
        if (!conCursor && _anotando && Actual is { } tarea)
            await AnotarAsync(tarea.Id, _notaFalla);
    }

    /// <summary>
    /// Con la guía (o sus avisos, o «Empezar de cero») abierta, o el cursor en la nota de la tarea, la pantalla de venta de
    /// atrás no atrapa las teclas que se escriben aquí. Al quitarse, vuelve lo que la venta tenga abierto (ModuloCaja).
    /// </summary>
    private Task AvisarVentanaAsync() => Js.VentanaDeLaFranjaAsync(_panel != Panel.Ninguno || _notaConCursor);

    private async Task AlTeclearNota(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SiguienteAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Cliente.EstadoAsync(Conexion.Servicio) is { Prueba: true })
            {
                _prueba = true;
                await CargarRespuestasAsync();
            }
        }
        catch (ErrorCaja)
        {
            // Sin conexión no se sabe si es la prueba: la caja lo dice por su lado.
        }
    }

    private async Task CargarRespuestasAsync()
    {
        var r = await Cliente.RespuestasPruebaAsync(GuiaPrueba.Version);
        _respuestas = new Respuestas { Nombre = r.Nombre, Tareas = r.Tareas.ToDictionary(), Comentarios = r.Comentarios };
        SeguirConLaQueFalta();
    }

    private RespuestaTareaDto Respuesta(string id) => _respuestas.Tareas.GetValueOrDefault(id) ?? new RespuestaTareaDto(null, null);

    private async Task AbrirAsync(Panel panel)
    {
        (_panel, _error, _aviso, _confirmarEnBlanco) = (panel, null, null, false);
        await AvisarVentanaAsync();
    }

    private async Task CerrarAsync()
    {
        _panel = Panel.Ninguno;
        SeguirConLaQueFalta();
        await AvisarVentanaAsync();
    }

    private async Task AbrirGuiaAsync()
    {
        await AbrirAsync(Panel.Guia);
        try
        {
            await CargarRespuestasAsync();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AbrirAvisosAsync()
    {
        await AbrirAsync(Panel.Avisos);
        try
        {
            _avisos = await Cliente.AvisosPruebaAsync();
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private Task MarcarAsync(string id, bool salioBien)
    {
        var r = Respuesta(id);
        _respuestas.Tareas[id] = r with { SalioBien = r.SalioBien == salioBien ? null : salioBien };
        return GuardarAsync();
    }

    private Task AnotarAsync(string id, string? nota)
    {
        _respuestas.Tareas[id] = Respuesta(id) with { Nota = string.IsNullOrWhiteSpace(nota) ? null : nota };
        return GuardarAsync();
    }

    private async Task GuardarAsync()
    {
        _error = null;
        await _subiendo.WaitAsync();
        try
        {
            await Cliente.GuardarRespuestasPruebaAsync(_respuestas.Dto());
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _subiendo.Release();
        }
    }

    private async Task ExportarAsync()
    {
        _ocupado = true;
        (_error, _aviso) = (null, null);
        await _subiendo.WaitAsync();
        try
        {
            await Cliente.GuardarRespuestasPruebaAsync(_respuestas.Dto());
            var archivo = await Cliente.ExportarRespuestasPruebaAsync(GuiaPrueba.Documento(_respuestas.Dto(), DateTime.Now));
            _aviso = $"Listo: tus respuestas quedaron en «{archivo.Ruta}». Mándalo por WhatsApp o correo.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _subiendo.Release();
            _ocupado = false;
        }
    }

    private void PedirEnBlanco() => (_confirmarEnBlanco, _error, _aviso) = (true, null, null);

    /// <summary>
    /// Al terminar una persona: sus respuestas quedan en el escritorio (como al exportar) y la guía, en blanco para la
    /// siguiente. En el servicio su archivo se aparta con la hora, no se borra.
    /// </summary>
    private async Task DejarEnBlancoAsync()
    {
        _ocupado = true;
        (_error, _aviso) = (null, null);
        await _subiendo.WaitAsync();
        try
        {
            var dto = _respuestas.Dto();
            await Cliente.GuardarRespuestasPruebaAsync(dto);
            var archivo = await Cliente.DejarGuiaEnBlancoAsync(GuiaPrueba.Version, GuiaPrueba.Documento(dto, DateTime.Now));
            _respuestas = new Respuestas();
            (_confirmarEnBlanco, _actual, _anotando, _notaConCursor) = (false, 0, false, false);
            _aviso = $"Listo: las respuestas{(string.IsNullOrWhiteSpace(dto.Nombre) ? "" : $" de {dto.Nombre.Trim()}")} quedaron en «{archivo.Ruta}». "
                + "La guía quedó en blanco para la siguiente persona.";
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _subiendo.Release();
            _ocupado = false;
        }
    }

    /// <summary>La caja deja de ver a la caja principal (o la vuelve a ver) y lo nota en seguida, sin esperar el latido.</summary>
    private async Task SimularAsync()
    {
        _ocupado = true;
        Conexion.SimularSinConexion = !Conexion.SimularSinConexion;
        try
        {
            if (Servicios.GetService<Contingencia>() is { } contingencia)
                await contingencia.LatidoAsync();
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task EmpezarDeCeroAsync()
    {
        _ocupado = true;
        _error = null;
        try
        {
            await Cliente.EmpezarDeCeroAsync();
            await Js.VentanaDeLaFranjaAsync(false);
            // Todo lo que la caja tenía en memoria (sesión, turno, tickets) era de la base anterior.
            Navegacion.NavigateTo(Navegacion.Uri, forceLoad: true);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
            _ocupado = false;
        }
    }

    /// <summary>
    /// Si la franja se va con algo encima de la venta (la guía, o el cursor en la nota de la tarea; también si truena y la
    /// cambia «Algo falló»), caja.js seguiría creyendo que hay una ventana y la venta no tendría sus teclas.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_panel == Panel.Ninguno && !_notaConCursor)
            return;
        try
        {
            await Js.VentanaDeLaFranjaAsync(false);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // El navegador ya se cerró, o la página se está volviendo a cargar.
        }
    }
}
