@* «Ventas del día» (paridad con eleventa, «Ventas del día y devoluciones», 2026-10-17), en el panel de la derecha (desde «/»).
   Desde el 2026-11-22 (el dueño: «similar a como se muestra la ventana cuando das en devoluciones… ahí puedes elegir qué día
   ver; si tienes el permiso puedes ver todo, si no solo los tuyos; además va por cajas»): la lista de los tickets del día que
   se elija (abre en hoy, de todas las cajas), con su folio, la hora, quién cobró, la caja, los artículos, el total, cómo se
   pagó y su estado; Enter abre uno con su detalle y de ahí se imprime (el que no salió, sin motivo), se reimprime (con motivo)
   o se va a devolverlo o cancelarlo, con las reglas de la devolución. Quien tiene «Ver reportes de ventas» ve los de todos y
   filtra por cajero; los demás, solo los suyos (lo revisa el servicio). Todo con el teclado: ↑ ↓ el ticket, Enter lo abre,
   Esc regresa a la lista (y en la lista, cierra), ← → el día, Alt+H hoy, Alt+F la fecha, Alt+C la caja, Alt+U el cajero; en el
   detalle, Alt+I imprimir y Alt+D devolver. Las ventas están en la caja principal: sin ella, la caja solo tiene su copia para
   vender, y lo dice (como la devolución, que tampoco se hace sin ella). El folio se busca como sale en el ticket: sin letra (lo de
   en línea desde 2026-11-22; «-004812» es solo el sin letra), con su serie (B-000123) o, en el piloto, el de eleventa. *@
@inject ClienteCaja Cliente
@inject ModuloCaja Js

<div class="vn-ventas" id="ventas" @onkeydown="AlTeclearAsync">
    @if (_abierta is { } abierta)
    {
        <div class="vn-ventas-detalle" id="venta-detalle" tabindex="-1">
            <div class="vn-ventas-detalle-cab">
                <button class="vn-boton chico" id="detalle-volver" @onclick="RegresarALaLista">← Lista <kbd>Esc</kbd></button>
                <span class="vn-ventas-teclas"><span><kbd>↑</kbd> <kbd>↓</kbd> otro ticket</span></span>
            </div>
            @if (_errorDetalle is not null)
            {
                <div class="vn-alerta" role="alert">
                    <Ico Nombre="alerta" />
                    <div>
                        <span>@_errorDetalle</span>
                        <span><button class="vn-boton chico" @onclick="() => AbrirAsync(abierta)">Volver a intentar</button></span>
                    </div>
                </div>
            }
            else if (_detalle is not { } det || det.Venta.Id != abierta)
            {
                <p class="vn-ventas-resumen">Cargando…</p>
            }
            else
            {
                var v = det.Venta;
                var t = det.Ticket;
                <h3 class="vn-ventas-detalle-folio">
                    Ticket @t.FolioImpreso@(v.FolioEleventa is null ? "" : " · en la caja ")
                    @if (v.FolioEleventa is not null)
                    {
                        <code>@v.Folio</code>
                    }
                </h3>
                <p class="vn-ventas-detalle-datos">@v.FechaLocal.ToString("dd/MM/yyyy HH:mm") · @v.Cajero · @v.Caja@(t.Cliente is { } cliente ? $" · {cliente}" : "")</p>
                <EstadoDelTicket Venta="v" />
                <div class="resultados">
                    <table>
                        <thead><tr><th>Descripción</th><th class="num">Cantidad</th><th class="num">Importe</th></tr></thead>
                        @foreach (var l in t.Lineas)
                        {
                            <tr>
                                <td>@l.Descripcion</td>
                                <td class="num">@l.Cantidad × @Formato.Dinero(l.PrecioCentavos)@(l.DescuentoCentavos > 0 ? $" · descuento {Formato.Dinero(l.DescuentoCentavos)}" : "")</td>
                                <td class="num cifra-derecha">@Formato.Dinero(l.ImporteCentavos)</td>
                            </tr>
                        }
                    </table>
                </div>
                <dl class="vn-ventas-detalle-cuentas">
                    <dt>Total · @v.Articulos @(v.Articulos == 1 ? "artículo" : "artículos")</dt><dd>@Formato.Dinero(t.TotalCentavos)</dd>
                    @if (t.RedondeoCentavos != 0)
                    {
                        <dt>Redondeo al peso</dt><dd>@Formato.Dinero(t.RedondeoCentavos)</dd>
                    }
                    @foreach (var c in t.Cobros.Where(c => c.MontoCentavos > 0))
                    {
                        <dt>@FormasTexto([c.Forma])@(c.Referencia is { Length: > 0 } referencia ? $" · {referencia}" : "")@(c.CambioCentavos > 0 ? $" · pagó con {Formato.Dinero(c.RecibidoCentavos)}" : "")</dt>
                        <dd>@Formato.Dinero(c.MontoCentavos)</dd>
                    }
                    @if (t.CambioCentavos > 0)
                    {
                        <dt>Cambio</dt><dd>@Formato.Dinero(t.CambioCentavos)</dd>
                    }
                </dl>
                @if (v.Nota is { } nota)
                {
                    <p class="vn-ventas-nota">Nota: @nota</p>
                }
                @foreach (var d in det.Devoluciones)
                {
                    <p class="vn-ventas-nota">
                        @(d.EsCancelacion ? "Cancelado" : "Devolución de " + Formato.Dinero(d.TotalCentavos)) el @d.FechaLocal.ToString("dd/MM/yyyy HH:mm") por @d.Quien@(d.ReembolsoEfectivoCentavos > 0 ? $" · salió {Formato.Dinero(d.ReembolsoEfectivoCentavos)} en efectivo" : ""): «@d.Motivo»
                    </p>
                }
                <div class="vn-venta-botones">
                    @if (v.SinImprimir)
                    {
                        @* Su ticket nunca salió: imprimirlo no es una reimpresión y no pide motivo (2026-10-22). *@
                        <button class="vn-boton chico" id="detalle-imprimir" title="No ha salido nunca: no es una reimpresión, no pide motivo"
                                @onclick="() => AlImprimir.InvokeAsync(v.Id)"><Ico Nombre="impresora" />Imprimir <kbd>Alt+I</kbd></button>
                    }
                    else if (Ve(AccionControlada.Reimprimir))
                    {
                        <button class="vn-boton chico" id="detalle-imprimir" @onclick="() => AlReimprimir.InvokeAsync(v.Id)"><Ico Nombre="impresora" />Reimprimir <kbd>Alt+I</kbd></button>
                    }
                    @if (SeDevuelveOCancela(v))
                    {
                        <button class="vn-boton chico" id="detalle-devolver" @onclick="() => AlDevolver.InvokeAsync(v.Folio)"><Ico Nombre="volver" />Devolver o cancelar <kbd>Alt+D</kbd></button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="vn-ventas-dia">
            <button class="vn-boton" title="Día anterior (←)" aria-label="Día anterior" disabled="@(_datos is null)" @onclick="() => MoverAsync(-1)">←</button>
            <input id="ventas-fecha" @key="_versionFecha" type="date" aria-label="Día (Alt+F)" value="@Dia?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                   max="@_datos?.Hoy.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="CambiarFechaAsync" @onkeydown="AlTeclearFecha"
                   @onkeydown:stopPropagation="true" />
            <button class="vn-boton" title="Día siguiente (→)" aria-label="Día siguiente" disabled="@(_datos is null || EsHoy)" @onclick="() => MoverAsync(1)">→</button>
            <button class="vn-boton" id="ventas-hoy" disabled="@(_datos is null || EsHoy)" @onclick="IrAHoyAsync">Hoy <kbd>Alt+H</kbd></button>
        </div>
        <div class="vn-ventas-filtros">
            <select id="ventas-caja" aria-label="Caja (Alt+C)" value="@_caja" @onchange="CambiarCajaAsync" @onkeydown:stopPropagation="true">
                <option value="">Todas las cajas</option>
                @foreach (var c in Cajas)
                {
                    <option value="@c.Id">@(c.Id == CajaId ? $"{c.Nombre} (esta)" : c.Nombre)</option>
                }
            </select>
            @if (VeTodas)
            {
                <select id="ventas-cajero" aria-label="Cajero (Alt+U)" value="@_cajero" @onchange="CambiarCajeroAsync" @onkeydown:stopPropagation="true">
                    <option value="">Todos los cajeros</option>
                    @foreach (var u in _datos?.Cajeros ?? [])
                    {
                        <option value="@u.Id">@u.Nombre</option>
                    }
                </select>
            }
            else
            {
                @* Sin «Ver reportes de ventas», solo los suyos (lo revisa el servicio). *@
                <span class="vn-ventas-hoy" id="ventas-solo-tuyos">Solo tus tickets</span>
            }
        </div>
        <input id="ventas-folio" data-escaneo class="vn-ventas-folio" aria-label="Buscar un folio" autocomplete="off" placeholder="Folio de cualquier día (004812 o B-000123)"
               value="@_folio" @oninput="e => _folio = e.Value?.ToString() ?? string.Empty" @onkeydown="AlTeclearFolioAsync" @onkeydown:stopPropagation="true" />
        <p class="vn-ventas-teclas" id="ventas-teclas">
            <span><kbd>↑</kbd> <kbd>↓</kbd> ticket</span><span><kbd>Enter</kbd> abrirlo</span><span><kbd>←</kbd> <kbd>→</kbd> día</span>
            <span><kbd>Alt+H</kbd> hoy</span><span><kbd>Alt+F</kbd> fecha</span><span><kbd>Alt+C</kbd> caja</span>
            @if (VeTodas)
            {
                <span><kbd>Alt+U</kbd> cajero</span>
            }
            <span><kbd>Esc</kbd> cerrar</span>
        </p>

        @if (_error is not null)
        {
            <div class="vn-alerta @(_sinConexion ? "info" : "")" role="alert">
                <Ico Nombre="@(_sinConexion ? "red" : "alerta")" />
                <div>
                    <span>@_error</span>
                    <span><button class="vn-boton chico" @onclick="CargarAsync">Volver a intentar</button></span>
                </div>
            </div>
        }
        else if (_datos is not { } d)
        {
            <p class="vn-ventas-resumen">Cargando…</p>
        }
        else
        {
            var cobradas = d.Ventas.Where(v => !v.Cancelada).ToList();
            var canceladas = d.Ventas.Count - cobradas.Count;
            var devuelto = cobradas.Sum(v => v.DevueltoCentavos);
            <p class="vn-ventas-resumen">
                @if (_cargando)
                {
                    <span>Cargando…</span>
                }
                else
                {
                    @* Los espacios van dentro del texto: Razor quita el que queda solo entre una etiqueta y una expresión. *@
                    <span>@(d.Folio is { } folio ? $"Folio «{folio}»: " : "")<strong>@cobradas.Count</strong>@(cobradas.Count == 1 ? " venta · " : " ventas · ")<strong>@Formato.Dinero(cobradas.Sum(v => v.TotalCentavos))</strong>@(canceladas > 0 ? $" · {canceladas} {(canceladas == 1 ? "cancelada" : "canceladas")}" : "")@(devuelto > 0 ? $" · devuelto {Formato.Dinero(devuelto)}" : "")</span>
                    @if (d.Folio is not null)
                    {
                        <button class="vn-enlace" @onclick="VerElDiaAsync">Ver el día</button>
                    }
                }
            </p>
            @if (d.HayMas)
            {
                <p class="vn-ventas-nota">Ese día tiene más ventas de las que caben aquí: se ven las más nuevas. Elige una caja o un cajero.</p>
            }
            @if (d.Ventas.Count == 0)
            {
                <p class="vn-ventas-vacia">@Vacia(d)</p>
            }
            else
            {
                <div class="resultados vn-ventas-lista @(_cargando ? "cargando" : "")" aria-label="Tickets">
                    <table>
                        <thead><tr><th>Folio</th><th class="num">Total</th><th>Hora, cajero y caja</th><th>Artículos y pago</th><th>Estado</th></tr></thead>
                        @foreach (var v in d.Ventas)
                        {
                            var venta = v;
                            <tr class="@(v.Id == _seleccionada ? "seleccionada" : "") @(v.Cancelada ? "cancelada" : "")" id="venta-@v.Id" @onclick="() => AbrirAsync(venta.Id)">
                                <td>@(v.FolioEleventa?.ToString(CultureInfo.InvariantCulture) ?? v.Folio)</td>
                                <td class="num cifra-derecha">@Formato.Dinero(v.TotalCentavos)</td>
                                <td>
                                    @* Los espacios van dentro del texto: Razor quita el que queda al principio de una etiqueta. *@
                                    @Hora(v, d) · @v.Cajero · @v.Caja@(v.FolioEleventa is null ? "" : " · en la caja ")
                                    @if (v.FolioEleventa is not null)
                                    {
                                        <code>@v.Folio</code>
                                    }
                                </td>
                                <td>@v.Articulos @(v.Articulos == 1 ? "artículo" : "artículos") · @FormasTexto(v.Formas)@(v.Nota is { } nota ? $" · Nota: {nota}" : "")</td>
                                <td><EstadoDelTicket Venta="v" /></td>
                            </tr>
                        }
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CajaId { get; set; }

    /// <summary>Quien entró a la caja: el servicio revisa con su usuario lo que puede ver.</summary>
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>La pantalla de venta pide el motivo y reimprime.</summary>
    [Parameter] public EventCallback<Guid> AlReimprimir { get; set; }

    /// <summary>
    /// El ticket de una venta que no salió nunca: la pantalla de venta lo imprime sin pedir motivo (no es una reimpresión), y si
    /// mientras tanto ya salió, pide el motivo como siempre.
    /// </summary>
    [Parameter] public EventCallback<Guid> AlImprimir { get; set; }

    /// <summary>Abre la devolución o cancelación con el folio ya escrito.</summary>
    [Parameter] public EventCallback<string> AlDevolver { get; set; }

    /// <summary>
    /// Los permisos con que pinta la pantalla de venta (los de la sesión o, de un servicio de antes, los que pidió aparte); sin
    /// ellos, los de la sesión.
    /// </summary>
    [CascadingParameter(Name = "PermisosDeSesion")] public IReadOnlyDictionary<AccionControlada, PermisoDeSesion>? PermisosDeSesion { get; set; }

    private VentasDeUnDiaDto? _datos;
    private string? _error;
    private bool _sinConexion;

    /// <summary>El día que se ve; vacío hasta que la caja principal dice cuál es hoy.</summary>
    private DateOnly? _fecha;

    /// <summary>La caja del filtro («»: todas, como abre desde el 2026-11-22).</summary>
    private string _caja = "";

    /// <summary>El cajero del filtro («»: todos). Sin «Ver reportes de ventas» no hay filtro: son los suyos.</summary>
    private string _cajero = "";

    private string _folio = "";

    /// <summary>El folio que se buscó: mientras, la lista es la de ese folio, de cualquier día.</summary>
    private string? _folioBuscado;

    /// <summary>La última consulta: una respuesta vieja (de otro día) no tapa a la nueva.</summary>
    private int _consulta;

    /// <summary>Se pidió otro día, otro filtro o un folio y todavía no llega: lo de antes se ve apagado.</summary>
    private bool _cargando;

    /// <summary>A dónde va el cursor en el siguiente dibujo (al abrir, el folio).</summary>
    private string? _enfocar = "#ventas-folio";

    /// <summary>El ticket elegido con ↑ ↓ (el primero al cargar): Enter lo abre.</summary>
    private Guid? _seleccionada;

    /// <summary>Se movió el elegido: en el siguiente dibujo se lleva a la vista.</summary>
    private bool _mostrarElegida;

    /// <summary>El ticket abierto con su detalle; vacío: se ve la lista.</summary>
    private Guid? _abierta;

    private VentaDelDiaDetalleDto? _detalle;
    private string? _errorDetalle;

    /// <summary>Lo que se pidió del detalle: el de otro ticket (↑ ↓ en el detalle) no tapa al que ya se pidió después.</summary>
    private int _consultaDetalle;

    /// <summary>Los de todos (y el filtro de cajero): con «Ver reportes de ventas» en «Puede» (el servicio lo vuelve a revisar).</summary>
    private bool VeTodas => _datos is { SoloLasSuyas: true } ? false : Puede(AccionControlada.VerReportes);

    /// <summary>Lo puede sin pedir autorización. Sin saberlo, se ve y el servicio decide, como en la pantalla de venta.</summary>
    private bool Puede(AccionControlada accion) => PermisosDeSesion is { } permisos
        ? (permisos.GetValueOrDefault(accion)?.Nivel ?? NivelPermiso.Permitido) == NivelPermiso.Permitido
        : Sesion.Puede(accion);

    /// <summary>Se le enseña: lo puede o lo puede pedir.</summary>
    private bool Ve(AccionControlada accion) => PermisosDeSesion is { } permisos
        ? permisos.GetValueOrDefault(accion)?.Nivel != NivelPermiso.NoPermitido
        : Sesion.Ve(accion);

    /// <summary>
    /// Sube cuando la fecha escrita no se tomó tal cual (incompleta, o después de hoy): el campo se vuelve a dibujar con el día
    /// que se ve, y no se queda con lo escrito.
    /// </summary>
    private int _versionFecha;

    private DateOnly? Dia => _fecha ?? _datos?.Fecha;

    private bool EsHoy => _datos is not null && Dia >= _datos.Hoy;

    private IReadOnlyList<OpcionFiltroDto> Cajas => _datos?.Cajas ?? [];

    private Guid? CajaElegida => Guid.TryParse(_caja, out var caja) ? caja : null;

    private Guid? CajeroElegido => Guid.TryParse(_cajero, out var cajero) ? cajero : null;

    protected override Task OnInitializedAsync() => CargarAsync();

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (_mostrarElegida && _abierta is null && _seleccionada is { } elegida)
        {
            _mostrarElegida = false;
            await Js.MostrarAsync($"#venta-{elegida}");
        }
        if (_enfocar is not { } selector)
            return;
        _enfocar = null;
        await Js.EnfocarAsync(selector);
    }

    private async Task CargarAsync()
    {
        var consulta = ++_consulta;
        _cargando = true;
        try
        {
            // Sin «Ver reportes de ventas» el servicio manda solo las suyas; el cajero no se elige.
            var datos = await Cliente.VentasDeUnDiaAsync(CajaId, Sesion.UsuarioId, _fecha, CajaElegida, VeTodas ? CajeroElegido : null, _folioBuscado);
            if (consulta != _consulta)
                return;
            (_datos, _error, _sinConexion) = (datos, null, false);
            if (datos.Folio is null)
                _fecha = datos.Fecha;
            // Se queda el elegido si sigue en la lista; si no, el primero.
            if (datos.Ventas.All(v => v.Id != _seleccionada))
                _seleccionada = datos.Ventas.FirstOrDefault()?.Id;
            _mostrarElegida = true;
        }
        catch (ErrorCaja ex)
        {
            if (consulta != _consulta)
                return;
            (_error, _sinConexion) = (ex.Message, ex.Codigo == "sin-conexion");
        }
        _cargando = false;
    }

    /// <summary>
    /// Las teclas del panel (fuera de los campos, o las que el folio le pasa). En la lista: ↑ ↓ el ticket, ← → el día, Alt+H hoy,
    /// Alt+F la fecha, Alt+C la caja, Alt+U el cajero. En el detalle: ↑ ↓ el ticket de arriba o el de abajo, Alt+I imprimir,
    /// Alt+D devolver o cancelar. Esc lo atiende la pantalla de venta (<see cref="Regresar"/>).
    /// </summary>
    private async Task AlTeclearAsync(KeyboardEventArgs e)
    {
        var letra = e.AltKey && !e.CtrlKey && e.Key.Length == 1 ? char.ToUpperInvariant(e.Key[0]) : (char?)null;
        if (_abierta is not null)
        {
            switch (e.Key, letra)
            {
                case ("ArrowDown", _): await OtroTicketAsync(1); break;
                case ("ArrowUp", _): await OtroTicketAsync(-1); break;
                case (_, 'I'): await ImprimirAbiertaAsync(); break;
                case (_, 'D'): await DevolverAbiertaAsync(); break;
            }
            return;
        }
        switch (e.Key, letra)
        {
            case ("ArrowLeft", null): await MoverAsync(-1); break;
            case ("ArrowRight", null): await MoverAsync(1); break;
            case ("ArrowDown", _): Elegir(1); break;
            case ("ArrowUp", _): Elegir(-1); break;
            case (_, 'H'): await IrAHoyAsync(); break;
            case (_, 'F'): _enfocar = "#ventas-fecha"; break;
            case (_, 'C'): await SiguienteCajaAsync(); break;
            case (_, 'U') when VeTodas: await SiguienteCajeroAsync(); break;
        }
    }

    /// <summary>
    /// Enter busca el folio escrito (vacío, después de buscar uno: regresa al día) y, si ya se buscó o no hay nada escrito, abre el
    /// ticket elegido. Con el folio vacío, ← → cambian de día; ↑ ↓ eligen el ticket; las de Alt, las del panel.
    /// </summary>
    private async Task AlTeclearFolioAsync(KeyboardEventArgs e)
    {
        var folio = _folio.Trim();
        if (e.Key == "Enter")
        {
            if (folio.Length > 0 && !string.Equals(folio, _folioBuscado, StringComparison.OrdinalIgnoreCase))
                await BuscarFolioAsync();
            else if (folio.Length == 0 && _folioBuscado is not null)
                await VerElDiaAsync();
            else if (_seleccionada is { } elegida)
                await AbrirAsync(elegida);
        }
        else if (e.Key is "ArrowDown" or "ArrowUp" || e.AltKey || _folio.Length == 0)
            await AlTeclearAsync(e);
    }

    /// <summary>Enter en la fecha la deja y regresa al folio (la fecha ya se tomó al cambiarla).</summary>
    private void AlTeclearFecha(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _enfocar = "#ventas-folio";
    }

    /// <summary>El ticket de abajo o el de arriba (se queda en el primero o en el último).</summary>
    private void Elegir(int paso)
    {
        if (_datos is not { Ventas.Count: > 0 } d)
            return;
        var actual = d.Ventas.ToList().FindIndex(v => v.Id == _seleccionada);
        var siguiente = Math.Clamp(actual < 0 ? 0 : actual + paso, 0, d.Ventas.Count - 1);
        _seleccionada = d.Ventas[siguiente].Id;
        _mostrarElegida = true;
    }

    /// <summary>Abre el ticket con su detalle (Enter o un clic en su renglón); el cursor, en su primer botón.</summary>
    private async Task AbrirAsync(Guid ventaId)
    {
        var consulta = ++_consultaDetalle;
        (_abierta, _seleccionada, _errorDetalle) = (ventaId, ventaId, null);
        // Mientras llega, el cursor en el detalle (el folio ya no está): las teclas siguen llegando al panel.
        _enfocar = "#venta-detalle";
        try
        {
            var detalle = await Cliente.VentaDelDiaAsync(CajaId, Sesion.UsuarioId, ventaId);
            if (consulta != _consultaDetalle || _abierta != ventaId)
                return;
            _detalle = detalle;
            _enfocar = SeDevuelveOCancela(detalle.Venta) && !detalle.Venta.SinImprimir && !Ve(AccionControlada.Reimprimir)
                ? "#detalle-devolver"
                : detalle.Venta.SinImprimir || Ve(AccionControlada.Reimprimir) ? "#detalle-imprimir" : "#detalle-volver";
        }
        catch (ErrorCaja ex)
        {
            if (consulta != _consultaDetalle)
                return;
            _errorDetalle = ex.Message;
            _enfocar = "#detalle-volver";
        }
    }

    /// <summary>En el detalle, ↑ ↓ abren el ticket de arriba o el de abajo de la lista.</summary>
    private async Task OtroTicketAsync(int paso)
    {
        if (_datos is not { } d || _abierta is not { } abierta)
            return;
        var siguiente = d.Ventas.ToList().FindIndex(v => v.Id == abierta) + paso;
        if (siguiente >= 0 && siguiente < d.Ventas.Count)
            await AbrirAsync(d.Ventas[siguiente].Id);
    }

    /// <summary>
    /// Esc con un ticket abierto: regresa a la lista, con ese ticket elegido y el cursor en el folio. Lo llama la pantalla de
    /// venta antes de cerrar el panel; dice si había algo que regresar (si no, Esc cierra el panel).
    /// </summary>
    public bool Regresar()
    {
        if (_abierta is null)
            return false;
        RegresarALaLista();
        StateHasChanged();
        return true;
    }

    private void RegresarALaLista()
    {
        (_abierta, _detalle, _errorDetalle) = (null, null, null);
        _consultaDetalle++;
        _mostrarElegida = true;
        _enfocar = "#ventas-folio";
    }

    private Task ImprimirAbiertaAsync()
    {
        if (_detalle is not { } d || d.Venta.Id != _abierta)
            return Task.CompletedTask;
        if (d.Venta.SinImprimir)
            return AlImprimir.InvokeAsync(d.Venta.Id);
        return Ve(AccionControlada.Reimprimir) ? AlReimprimir.InvokeAsync(d.Venta.Id) : Task.CompletedTask;
    }

    private Task DevolverAbiertaAsync() =>
        _detalle is { } d && d.Venta.Id == _abierta && SeDevuelveOCancela(d.Venta) ? AlDevolver.InvokeAsync(d.Venta.Folio) : Task.CompletedTask;

    private async Task MoverAsync(int dias)
    {
        if (_datos is null || Dia is not { } dia)
            return;
        var nuevo = dia.AddDays(dias);
        if (nuevo > _datos.Hoy)
            return;
        await IrAAsync(nuevo);
    }

    private Task IrAHoyAsync() => _datos is null || (EsHoy && _folioBuscado is null) ? Task.CompletedTask : IrAAsync(_datos.Hoy);

    /// <summary>La fecha escrita (o elegida en el calendario): hasta hoy.</summary>
    private async Task CambiarFechaAsync(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
        {
            _versionFecha++;
            return;
        }
        if (_datos is { } d && fecha > d.Hoy)
        {
            _versionFecha++;
            fecha = d.Hoy;
        }
        await IrAAsync(fecha);
    }

    private async Task IrAAsync(DateOnly dia)
    {
        (_fecha, _folioBuscado, _folio) = (dia, null, "");
        await CargarAsync();
    }

    private async Task CambiarCajaAsync(ChangeEventArgs e)
    {
        (_caja, _folioBuscado, _folio) = (e.Value?.ToString() ?? "", null, "");
        await CargarAsync();
    }

    /// <summary>Alt+C: «Todas las cajas», luego cada caja, y otra vez todas.</summary>
    private Task SiguienteCajaAsync() =>
        CambiarCajaAsync(new ChangeEventArgs { Value = Siguiente(_caja, Cajas) });

    private async Task CambiarCajeroAsync(ChangeEventArgs e)
    {
        (_cajero, _folioBuscado, _folio) = (e.Value?.ToString() ?? "", null, "");
        await CargarAsync();
    }

    /// <summary>Alt+U: «Todos los cajeros», luego cada uno de los de ese día, y otra vez todos.</summary>
    private Task SiguienteCajeroAsync() =>
        CambiarCajeroAsync(new ChangeEventArgs { Value = Siguiente(_cajero, _datos?.Cajeros ?? []) });

    /// <summary>La opción que sigue de un filtro («»: todas).</summary>
    private static string Siguiente(string actual, IReadOnlyList<OpcionFiltroDto> opciones)
    {
        var ids = opciones.Select(o => o.Id.ToString()).Prepend("").ToList();
        return ids[(ids.IndexOf(actual) + 1) % ids.Count];
    }

    private async Task BuscarFolioAsync()
    {
        var folio = _folio.Trim();
        if (folio.Length == 0 && _folioBuscado is null)
            return;
        _folioBuscado = folio.Length == 0 ? null : folio;
        await CargarAsync();
    }

    private async Task VerElDiaAsync()
    {
        (_folioBuscado, _folio) = (null, "");
        await CargarAsync();
    }

    /// <summary>
    /// «Devolver o cancelar» se ofrece mientras se pueda: en sus 7 días (como lo cuenta la ventana de la devolución) y si queda
    /// algo por devolver. La ventana aplica sus reglas y los permisos.
    /// </summary>
    private bool SeDevuelveOCancela(VentaDeUnDiaDto v) =>
        !v.Cancelada && !v.DevueltaCompleta && v.SeDevuelve && (Ve(AccionControlada.Devolucion) || Ve(AccionControlada.CancelarTicket));

    /// <summary>La hora; con la fecha si es de otro día que el que se ve (lo de un folio).</summary>
    private static string Hora(VentaDeUnDiaDto v, VentasDeUnDiaDto d) =>
        d.Folio is null && DateOnly.FromDateTime(v.FechaLocal) == d.Fecha ? v.FechaLocal.ToString("HH:mm") : v.FechaLocal.ToString("dd/MM/yyyy HH:mm");

    /// <summary>«Efectivo», «Efectivo y tarjeta», «Tarjeta, transferencia y crédito».</summary>
    private static string FormasTexto(IReadOnlyList<FormaPago> formas)
    {
        var nombres = formas.Select(f => f switch
        {
            FormaPago.Tarjeta => "tarjeta",
            FormaPago.Transferencia => "transferencia",
            FormaPago.Credito => "crédito",
            _ => "efectivo",
        }).ToList();
        if (nombres.Count == 0)
            return "sin cobro";
        var texto = nombres.Count == 1 ? nombres[0] : $"{string.Join(", ", nombres.Take(nombres.Count - 1))} y {nombres[^1]}";
        return char.ToUpper(texto[0], CultureInfo.CurrentCulture) + texto[1..];
    }

    /// <summary>Sin ventas: lo dice con el día, la caja y el cajero que se eligieron.</summary>
    private string Vacia(VentasDeUnDiaDto d)
    {
        if (d.Folio is { } folio)
            return d.SoloLasSuyas
                ? $"No tienes un ticket con el folio «{folio}». Los de otros cajeros los ve quien tiene «{Permisos.Nombre(AccionControlada.VerReportes)}»; "
                  + "para devolver uno, escribe su folio en la venta."
                : $"No hay un ticket con el folio «{folio}».";
        var cuando = d.Fecha == d.Hoy ? "hoy" : $"el {d.Fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)}";
        var donde = CajaElegida is { } caja ? $" en {Cajas.FirstOrDefault(c => c.Id == caja)?.Nombre ?? "esa caja"}" : "";
        if (d.SoloLasSuyas)
            return $"No cobraste ningún ticket {cuando}{donde}.";
        var quien = CajeroElegido is { } cajero ? $" de {d.Cajeros.FirstOrDefault(c => c.Id == cajero)?.Nombre ?? "ese cajero"}" : "";
        return $"No hubo ventas {cuando}{donde}{quien}.";
    }
}
