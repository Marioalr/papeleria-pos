@inject ClienteCaja Cliente

@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_ventas is null)
{
    <p>Cargando…</p>
}
else if (_ventas.Count == 0)
{
    <p class="vacia">Esta caja no ha vendido hoy.</p>
}
else
{
    var cobradas = _ventas.Where(v => !v.Cancelada).ToList();
    <p>
        <strong>@cobradas.Count</strong> ventas · <strong>@Formato.Dinero(cobradas.Sum(v => v.TotalCentavos))</strong>
        @if (_ventas.Count > cobradas.Count)
        {
            <span> · @(_ventas.Count - cobradas.Count) canceladas</span>
        }
    </p>
    <div class="resultados">
        <table>
            <thead><tr><th>Folio</th><th>Hora</th><th>Cajero</th><th class="num">Artículos</th><th class="num">Total</th><th></th></tr></thead>
            @foreach (var v in _ventas)
            {
                <tr class="@(v.Cancelada ? "negado" : "")">
                    <td>@v.Folio@(v.Cancelada ? " (cancelado)" : "")</td>
                    <td>@v.FechaLocal.ToString("HH:mm")</td>
                    <td>@v.Cajero</td>
                    <td class="num">@v.Articulos</td>
                    <td class="num">@Formato.Dinero(v.TotalCentavos)</td>
                    <td>
                        <button class="boton chico" @onclick="() => ReimprimirAsync(v.Id)">Reimprimir</button>
                        @if (!v.Cancelada)
                        {
                            <button class="boton chico" @onclick="() => AlDevolver.InvokeAsync(v.Folio)">Devolver / cancelar</button>
                        }
                    </td>
                </tr>
            }
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CajaId { get; set; }
    /// <summary>La pantalla de venta pide el motivo y reimprime.</summary>
    [Parameter] public EventCallback<Guid> AlReimprimir { get; set; }
    /// <summary>Abre la devolución o cancelación con el folio ya escrito.</summary>
    [Parameter] public EventCallback<string> AlDevolver { get; set; }

    private List<VentaDelDiaDto>? _ventas;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ventas = await Cliente.VentasDelDiaAsync(CajaId);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
    }

    private Task ReimprimirAsync(Guid ventaId) => AlReimprimir.InvokeAsync(ventaId);
}
