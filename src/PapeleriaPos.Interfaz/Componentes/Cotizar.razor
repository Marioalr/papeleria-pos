@* Cotizar un PDF antes de imprimirlo, a un botón: la caja mide la tinta de cada página (como en una impresión real) y
   la caja principal le pone precio con los costos de la impresora donde se imprimiría; con cada opción se recalcula al instante.
   Traído de Control Print (QuoteViewModel). Desde el 2026-11-08 (hito 3 de docs/impresion.md): empieza en la impresora donde imprime
   esta caja y con lo que de verdad se imprime en ella (calidad, papel, tamaño), da el precio de lo medido mientras mide, y la
   cotización se guarda sola (15 días: solo el nombre del archivo, sus páginas, sus ajustes y su precio; el PDF, su miniatura y su
   texto no) para cobrar lo cotizado cuando se imprima. *@
@using PapeleriaPos.Impresiones.Medicion
@implements IDisposable
@inject ClienteCaja Cliente
@inject ModuloCaja Js
@inject IServiceProvider Servicios

@if (_medidor is null)
{
    <p class="error">Cotizar un PDF funciona en la caja de Windows: aquí no hay con qué medir el archivo.</p>
}
else
{
    <div class="cotizar">
        <div class="cotizar-documento">
            @if (_miniatura is { } miniatura)
            {
                <img class="miniatura-grande" src="data:image/png;base64,@miniatura" alt="" />
            }
            <div>
                <strong>@(_nombre ?? "Ningún PDF")</strong>
                <div class="nota">@_resumen</div>
                @if (_estado is not null)
                {
                    <div class="@(_estadoEsError ? "error" : "nota")">@_estado</div>
                }
                <label class="boton chico otro-pdf">
                    Otro PDF
                    <InputFile accept=".pdf,application/pdf" OnChange="OtroPdfAsync" />
                </label>
            </div>
        </div>

        @if (_paginas is not null)
        {
            <div class="cotizar-opciones">
                <label>Color
                    <select @bind="Color" @bind:after="CotizarAsync">
                        <option value="true">Color</option>
                        <option value="false">Blanco y negro</option>
                    </select>
                </label>
                <label>Copias <input type="number" min="1" max="9999" @bind="Copias" @bind:after="CotizarAsync" /></label>
                <label>Páginas (vacío: todas) <input placeholder="1-3, 5" @bind="Rango" @bind:after="CotizarAsync" autocomplete="off" /></label>
                <label>Tamaño
                    <select @bind="Tamano" @bind:after="CotizarAsync">
                        @foreach (var t in _opciones?.Tamanos ?? ["Carta"])
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </label>
                <label>Papel
                    <select @bind="TipoPapel" @bind:after="CotizarAsync">
                        @foreach (var p in _opciones?.TiposPapel ?? [new OpcionDto("Plain", "Normal")])
                        {
                            <option value="@p.Clave">@p.Nombre</option>
                        }
                    </select>
                </label>
                <label>Calidad
                    <select @bind="Calidad" @bind:after="CotizarAsync">
                        @foreach (var calidad in _opciones?.Calidades ?? [new OpcionDto("Standard", "Normal")])
                        {
                            <option value="@calidad.Clave">@calidad.Nombre</option>
                        }
                    </select>
                </label>
                <label>Páginas por hoja
                    <select @bind="PaginasPorHoja" @bind:after="CotizarAsync">
                        <option value="1">1 (normal)</option>
                        <option value="2">2 por hoja</option>
                        <option value="4">4 por hoja</option>
                    </select>
                </label>
                <label class="en-linea opcion"><input type="checkbox" @bind="Duplex" @bind:after="CotizarAsync" /> Doble cara</label>
                @if (_impresoras.Count > 1)
                {
                    @* Con varias impresoras (2026-11-03): en cuál se imprimiría, con sus costos (la L5590 gasta menos tinta). *@
                    <label>Impresora
                        @* data-solo-flechas: un escaneo o una letra no cambia la impresora (ni el precio); con las flechas sí. *@
                        <select id="cotizar-impresora" data-solo-flechas @bind="Impresora" @bind:after="OtraImpresoraAsync">
                            @foreach (var impresora in _impresoras)
                            {
                                <option value="@impresora.Numero">@impresora.Nombre</option>
                            }
                        </select>
                    </label>
                }
            </div>
        }

        @if (_habitual is { } habitual)
        {
            <p class="nota" id="cotizar-habitual">@habitual</p>
        }

        @if (_cotizacion is { } c)
        {
            <div class="cotizar-precio" id="cotizar-precio">
                @if (_parcial is { } parcial)
                {
                    @* Mientras mide (2026-11-08): el precio de lo medido; el final, al terminar. *@
                    <small>Precio de lo medido (@parcial.Hechas de @parcial.Total páginas): sigue midiendo</small>
                }
                else
                {
                    <small>@(c.CobroMinimo ? "Cobro mínimo" : "Precio a cobrar")</small>
                }
                <div class="precio">@Formato.Dinero(c.PrecioCentavos)</div>
                <div>@Detalle(c)</div>
                @if (_parcial is null && c.ValeHastaLocal is { } vale)
                {
                    <div class="nota" id="cotizar-guardada">Cotización guardada: vale hasta el @vale.ToString("dd/MM", Formato.Mexico). Al imprimir este PDF, F2 la reconoce y cobra lo cotizado.</div>
                }
                @if (c.Costo is { } costo)
                {
                    <div class="nota">Costo @Formato.Dinero(costo.TotalCentavos) · ganancia @Formato.Dinero(c.PrecioCentavos - costo.TotalCentavos) (margen @costo.MargenPorcentaje.ToString("0.#") %)</div>
                    @if (costo.Margen is { } deDonde)
                    {
                        <div class="nota">@deDonde</div>
                    }
                }
                @foreach (var aviso in c.Avisos)
                {
                    <div class="aviso-autorizacion">@aviso</div>
                }
            </div>
            <details>
                <summary>Precio por página</summary>
                <p class="nota">Lo que le toca a cada página según su tinta (por copia). El total se redondea una sola vez e incluye cobro mínimo y mayoreo, igual que al imprimir.</p>
                <div class="resultados">
                    <table>
                        <thead><tr><th class="num">Página</th><th>Tipo</th><th class="num">Precio</th>@if (c.Costo is not null) {<th class="num">Costo</th>}</tr></thead>
                        @foreach (var p in c.PorPagina)
                        {
                            <tr>
                                <td class="num">@p.Pagina</td>
                                <td>@p.Tipo</td>
                                <td class="num">@Centavos(p.PrecioCentavos)</td>
                                @if (p.CostoCentavos is { } costoPagina)
                                {
                                    <td class="num">@Centavos(costoPagina)</td>
                                }
                            </tr>
                        }
                    </table>
                </div>
            </details>
        }
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        @if (_aviso is not null)
        {
            <p class="aviso">@_aviso</p>
        }
        <div class="acciones">
            <button class="boton principal" disabled="@(_cotizacion is null || _parcial is not null)" @onclick="CopiarAsync">Copiar resumen para el cliente</button>
        </div>

        @if (_guardadas is { Count: > 0 } guardadas)
        {
            @* Las cotizaciones de los últimos 15 días (2026-11-08), de todas las cajas de la sucursal. *@
            <details id="cotizaciones-guardadas">
                <summary>Cotizaciones de los últimos 15 días (@guardadas.Count)</summary>
                <div class="resultados">
                    <table>
                        <thead><tr><th>Cuándo</th><th>Documento</th><th class="num">Caras</th><th class="num">Cotizado</th><th>Estado</th></tr></thead>
                        @foreach (var g in guardadas)
                        {
                            <tr>
                                <td>@g.CreadaLocal.ToString("dd/MM HH:mm", Formato.Mexico)</td>
                                <td title="@g.Documento">@g.Documento@(g.Impresora is { } i ? $" · {i}" : "")</td>
                                <td class="num">@g.Caras@(g.Color ? " color" : "")</td>
                                <td class="num">@Formato.Dinero(g.PrecioCentavos)</td>
                                <td>@EstadoDe(g)</td>
                            </tr>
                        }
                    </table>
                </div>
            </details>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CajaDto Caja { get; set; } = null!;
    [Parameter, EditorRequired] public SesionDto Sesion { get; set; } = null!;

    /// <summary>El PDF que se eligió con el botón de la pantalla de venta.</summary>
    [Parameter] public IBrowserFile? Archivo { get; set; }

    /// <summary>El tamaño más grande que se acepta (los PDF escaneados pesan mucho).</summary>
    private const long MaximoBytes = 200L * 1024 * 1024;

    private IMedidorPdf? _medidor;
    private OpcionesImpresionDto? _opciones;

    /// <summary>La cotización de este PDF (2026-11-08): cada cambio de opciones la vuelve a guardar.</summary>
    private Guid _id = Guid.NewGuid();

    /// <summary>Mientras mide: cuántas páginas van de cuántas (el precio es el de lo medido).</summary>
    private AvanceMedicion? _parcial;

    /// <summary>Cuándo se pidió el último precio de lo medido (no más de uno a la vez, ni más seguido que <see cref="CadaCuantoParcial"/>).</summary>
    private DateTime _ultimoParcial;

    private bool _pidiendoParcial;

    private static readonly TimeSpan CadaCuantoParcial = TimeSpan.FromMilliseconds(700);

    /// <summary>Con qué se cotiza en la impresora elegida y de dónde sale, para decirlo.</summary>
    private string? _habitual;

    private List<CotizacionGuardadaDto>? _guardadas;
    private IReadOnlyList<CoberturaPaginaDto>? _paginas;
    private CotizacionDto? _cotizacion;
    private CancellationTokenSource? _midiendo;
    private int _pedido;
    private string? _nombre;
    private string _resumen = "Elige un PDF para saber cuánto cobrar antes de imprimir.";
    private string? _miniatura;
    private string? _estado;
    private bool _estadoEsError;
    private string? _error;
    private string? _aviso;

    private bool Color { get; set; } = true;
    private int Copias { get; set; } = 1;
    private string Rango { get; set; } = "";
    private string Tamano { get; set; } = "Carta";
    private string TipoPapel { get; set; } = "Plain";
    private string Calidad { get; set; } = "Standard";
    private int PaginasPorHoja { get; set; } = 1;
    private bool Duplex { get; set; }

    /// <summary>Las impresoras activas de la sucursal (2026-11-03): con más de una, se elige en cuál se imprimiría.</summary>
    private List<ImpresoraDto> _impresoras = [];

    private int? Impresora { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _medidor = Servicios.GetService<IMedidorPdf>();
        if (_medidor is null)
            return;
        try
        {
            _opciones = await Cliente.OpcionesImpresionAsync(Caja.SucursalId, Caja.Id);
        }
        catch (ErrorCaja ex)
        {
            _error = ex.Message;
        }
        try
        {
            // Una caja principal de antes no las da: entonces, como antes, con los costos de la sucursal.
            _impresoras = (await Cliente.ImpresorasAsync(Caja.SucursalId))?.Where(i => i.Activa).ToList() ?? [];
            // Empieza en la impresora donde imprime esta caja (la de su último trabajo), con lo que se imprime en ella (2026-11-08).
            Impresora = _impresoras.FirstOrDefault(i => i.Numero == _opciones?.ImpresoraDeLaCaja)?.Numero ?? _impresoras.FirstOrDefault()?.Numero;
        }
        catch (ErrorCaja)
        {
            // Sin la lista se cotiza con la primera, como antes.
        }
        PonerLoHabitual();
        await CargarGuardadasAsync();
        if (Archivo is not null)
            await MedirAsync(Archivo);
    }

    /// <summary>
    /// Las opciones con que se imprime de verdad en la impresora elegida (lo más usado en sus últimos trabajos): cotizar como se va a imprimir
    /// (2026-11-08; cotizar en «Normal» lo que sale en «Normal (colores vivos)» daba un 15 % menos de tinta). Las copias y las páginas no.
    /// </summary>
    private void PonerLoHabitual(bool documentoConColor = true)
    {
        var numero = Impresora ?? _opciones?.ImpresoraDeLaCaja;
        var habitual = _opciones?.Habituales?.FirstOrDefault(h => h.Impresora == numero) ?? _opciones?.Habituales?.FirstOrDefault();
        if (habitual is null)
        {
            _habitual = null;
            return;
        }
        var o = habitual.Opciones;
        (TipoPapel, Tamano, Calidad, Duplex, PaginasPorHoja) = (o.TipoPapel, o.Tamano, o.Calidad, o.Duplex, o.PaginasPorHoja);
        // Un documento sin color se cotiza en B/N: la impresora lo saca solo con negro, en color o no.
        Color = o.Color && documentoConColor;
        var calidad = _opciones?.Calidades.FirstOrDefault(c => c.Clave == o.Calidad)?.Nombre ?? o.Calidad;
        var papel = _opciones?.TiposPapel.FirstOrDefault(p => p.Clave == o.TipoPapel)?.Nombre ?? o.TipoPapel;
        var donde = _impresoras.Count > 1 ? $" en la {_impresoras.FirstOrDefault(i => i.Numero == habitual.Impresora)?.Nombre}" : "";
        _habitual = habitual.Trabajos > 0
            ? $"Con lo que más se imprime{donde} (sus últimos {habitual.Trabajos} trabajos): calidad {calidad.ToLowerInvariant()}, {papel.ToLowerInvariant()}, "
              + $"{o.Tamano.ToLowerInvariant()}{(o.Color ? "" : ", blanco y negro")}{(o.Duplex ? ", doble cara" : "")}. Si se va a imprimir distinto, cámbialo."
            : null;
    }

    private async Task OtraImpresoraAsync()
    {
        PonerLoHabitual(_paginas?.Any(p => p.ConColor) ?? true);
        await CotizarAsync();
    }

    private async Task CargarGuardadasAsync()
    {
        try
        {
            _guardadas = await Cliente.CotizacionesAsync(Caja.SucursalId);
        }
        catch (ErrorCaja)
        {
            // Una caja principal de antes no las guarda: sin lista.
            _guardadas = null;
        }
    }

    private static string EstadoDe(CotizacionGuardadaDto g) =>
        g.Usada
            ? g.ImpresoCentavos is { } impreso && impreso != g.PrecioCentavos ? $"Impresa (calculó {Formato.Dinero(impreso)})" : "Impresa"
            : g.ValeHastaLocal >= HoraMexico.ALocal(DateTime.UtcNow) ? $"Vale hasta el {g.ValeHastaLocal.ToString("dd/MM", Formato.Mexico)}" : "Venció";

    private Task OtroPdfAsync(InputFileChangeEventArgs e) => MedirAsync(e.File);

    private async Task MedirAsync(IBrowserFile archivo)
    {
        _midiendo?.Cancel();
        var cts = _midiendo = new CancellationTokenSource();
        (_paginas, _cotizacion, _miniatura, _error, _aviso, _parcial) = (null, null, null, null, null, null);
        // Otro PDF, otra cotización.
        _id = Guid.NewGuid();
        _nombre = archivo.Name;
        _resumen = "";
        (_estado, _estadoEsError) = ("Abriendo…", false);
        if (archivo.Size > MaximoBytes)
        {
            (_estado, _estadoEsError) = ("El PDF pesa más de 200 MB: no se puede cotizar aquí.", true);
            return;
        }
        try
        {
            // El archivo se lee completo antes de medirlo: la pantalla puede cambiar mientras se mide.
            var memoria = new MemoryStream();
            await using (var flujo = archivo.OpenReadStream(MaximoBytes, cts.Token))
                await flujo.CopyToAsync(memoria, cts.Token);
            memoria.Position = 0;
            var avance = new Progress<AvanceMedicion>(a =>
            {
                if (_midiendo != cts)
                    return;
                _estado = a.Hechas < a.Total ? $"Midiendo la tinta de la página {a.Hechas + 1} de {a.Total}…" : null;
                // El precio de lo medido mientras sigue (2026-11-08): Control Print no daba precio hasta medir todo.
                if (a.Hechas > 0 && a.Hechas < a.Total)
                    _ = InvokeAsync(() => PrecioDeLoMedidoAsync(a, cts));
                InvokeAsync(StateHasChanged);
            });
            var medido = await _medidor!.MedirAsync(memoria, avance, cts.Token);
            if (_midiendo != cts)
                return;
            _parcial = null;
            _paginas = medido.Paginas.Select(Dto).ToList();
            _miniatura = medido.MiniaturaPng is { } png ? Convert.ToBase64String(png) : null;
            var conColor = medido.Paginas.Count(p => p.HasColor);
            _resumen = $"{Plural(medido.Paginas.Count, "página", "páginas")}" + (conColor == 0 ? " · todas en blanco y negro" : $" · {conColor} con color");
            // Con lo que se imprime en la impresora; un documento sin color, en blanco y negro (la impresora lo saca solo con negro).
            if (_opciones?.Habituales is { Count: > 0 })
                PonerLoHabitual(conColor > 0);
            else
                Color = conColor > 0;
            (_estado, _estadoEsError) = (medido.Nota, false);
            await CotizarAsync();
            await CargarGuardadasAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (InvalidDataException ex)
        {
            (_estado, _estadoEsError) = (ex.Message, true);
        }
        catch (Exception ex) when (ex is IOException or JSException)
        {
            (_estado, _estadoEsError) = ("No se pudo leer el PDF: " + ex.Message, true);
        }
    }

    private async Task CotizarAsync()
    {
        if (_paginas is null)
            return;
        (_error, _aviso) = (null, null);
        if (Copias is < 1 or > 9999)
        {
            (_cotizacion, _error) = (null, "Escribe cuántas copias (1 o más).");
            return;
        }
        // Si cambian dos opciones seguidas, solo cuenta la respuesta de la última.
        var pedido = ++_pedido;
        try
        {
            // Con su Id y el nombre del archivo se guarda (2026-11-08); cada cambio de opciones la vuelve a guardar.
            var cotizacion = await Cliente.CotizarAsync(new SolicitudCotizacion(Caja.SucursalId, Sesion.UsuarioId, _paginas,
                new OpcionesCotizacionDto(TipoPapel, Tamano, Color, Calidad, Duplex, Copias, PaginasPorHoja, Rango), Impresora, _id, _nombre,
                _paginas.Count, Caja.Id));
            if (pedido == _pedido)
                _cotizacion = cotizacion;
        }
        catch (ErrorCaja ex)
        {
            if (pedido == _pedido)
                (_cotizacion, _error) = (null, ex.Message);
        }
    }

    /// <summary>
    /// El precio de lo medido hasta ahora, con las opciones de la pantalla y sin el rango (todavía no están todas las páginas). No se guarda.
    /// Uno a la vez y no más seguido que <see cref="CadaCuantoParcial"/>: medir no espera al precio.
    /// </summary>
    private async Task PrecioDeLoMedidoAsync(AvanceMedicion a, CancellationTokenSource cts)
    {
        // Ya terminó (el aviso llegó tarde): no se pide, o taparía el precio final.
        if (_midiendo != cts || _paginas is not null || _pidiendoParcial || DateTime.UtcNow - _ultimoParcial < CadaCuantoParcial || Copias is < 1 or > 9999)
            return;
        (_pidiendoParcial, _ultimoParcial) = (true, DateTime.UtcNow);
        var pedido = ++_pedido;
        try
        {
            var cotizacion = await Cliente.CotizarAsync(new SolicitudCotizacion(Caja.SucursalId, Sesion.UsuarioId, a.Medidas.Select(Dto).ToList(),
                new OpcionesCotizacionDto(TipoPapel, Tamano, Color, Calidad, Duplex, Copias, PaginasPorHoja), Impresora, CajaId: Caja.Id, Parcial: true));
            if (pedido == _pedido && _midiendo == cts && _paginas is null)
                (_cotizacion, _parcial) = (cotizacion, a);
        }
        catch (ErrorCaja)
        {
            // Sin el precio de lo medido: llega el final al terminar.
        }
        finally
        {
            _pidiendoParcial = false;
        }
        StateHasChanged();
    }

    private static CoberturaPaginaDto Dto(PageCoverage p) => new(p.C, p.M, p.Y, p.K, p.Gray, p.AreaSqIn, p.HasColor, p.WidthIn, p.HeightIn);

    private string Detalle(CotizacionDto c) =>
        $"{Plural(c.Paginas, "página", "páginas")}" + (c.Copias > 1 ? $" × {c.Copias} copias" : "")
        + $" = {Plural(c.Caras, "cara", "caras")} en {Plural(c.Hojas, "hoja", "hojas")} {c.Tamano.ToLowerInvariant()} · {c.TipoPapel.ToLowerInvariant()}"
        + (c.CarasColor > 0 ? $" · {c.CarasColor} a color" : "");

    /// <summary>Para el cliente (sin costos): se pega en WhatsApp o en un correo.</summary>
    private string Resumen(CotizacionDto c)
    {
        var lineas = new List<string>
        {
            $"Cotización · {DateTime.Now.ToString("dd/MM/yyyy HH:mm", Formato.Mexico)}",
            $"Documento: {_nombre} ({Detalle(c)})",
            (Color ? "Color" : "Blanco y negro") + (Duplex ? " · doble cara" : "") + (PaginasPorHoja > 1 ? $" · {PaginasPorHoja} páginas por hoja" : ""),
        };
        if (!string.IsNullOrWhiteSpace(Rango))
            lineas.Add($"Páginas: {Rango}");
        lineas.Add($"Total: {Formato.Dinero(c.PrecioCentavos)}");
        if (c.Copias > 1)
            lineas.Add($"Por copia: aprox. {Formato.Dinero(c.PrecioCentavos / c.Copias)}");
        return string.Join(Environment.NewLine, lineas);
    }

    private async Task CopiarAsync()
    {
        if (_cotizacion is not { } c)
            return;
        try
        {
            await Js.CopiarAsync(Resumen(c));
            _aviso = "Resumen copiado: pégalo en WhatsApp o en un correo.";
        }
        catch (JSException ex)
        {
            _error = "No se pudo copiar: " + ex.Message;
        }
    }

    private static string Centavos(decimal centavos) => (centavos / 100m).ToString("$#,##0.00", Formato.Mexico);

    private static string Plural(int n, string uno, string varios) => $"{n:N0} {(n == 1 ? uno : varios)}";

    public void Dispose() => _midiendo?.Cancel();
}
