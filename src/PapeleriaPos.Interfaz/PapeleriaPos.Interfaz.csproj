<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Corre en el servicio (Blazor Server) y en la ventana de Windows, nunca en WebAssembly: puede usar la red (UDP). -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- El lector de códigos por puerto COM (piloto alfa): lo usan la ventana de Windows y probar-lector. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PapeleriaPos.Nucleo\PapeleriaPos.Nucleo.csproj" />
    <ProjectReference Include="..\PapeleriaPos.Impresion\PapeleriaPos.Impresion.csproj" />
    <!-- El módulo de impresión: sus contratos (F2, cotizar, copias, la impresora) e IMedidorPdf (cotizar mide el PDF en
         la PC donde está; la ventana de Windows pone el medidor). -->
    <ProjectReference Include="..\Impresiones\PapeleriaPos.Impresiones\PapeleriaPos.Impresiones.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las pruebas ven con qué plazos sale cada petición (Transporte.PlazosDeLaVenta). -->
    <InternalsVisibleTo Include="PapeleriaPos.Pruebas" />
  </ItemGroup>

</Project>
