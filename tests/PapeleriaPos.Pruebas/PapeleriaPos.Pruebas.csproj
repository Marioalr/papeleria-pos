<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- La de la ventana de Windows (la trae Microsoft.AspNetCore.Components.WebView.Wpf): volver a cargar la página. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- SkiaSharp (logo del ticket) sin esto no carga en Linux; la tienda es Windows y no lo necesita. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- El Control Print falso de las pruebas del módulo de impresión (Kestrel con HTTPS y su protocolo escrito aparte del cliente;
         falla la prueba si el POS le escribe): aquí, para las tarjetas de su cola en la caja 2 (2026-10-25). -->
    <Compile Include="..\Impresiones\PapeleriaPos.Impresiones.Pruebas\ControlPrint\ServidorControlPrintFalso.cs" Link="ControlPrint\ServidorControlPrintFalso.cs" />
    <Compile Include="..\Impresiones\PapeleriaPos.Impresiones.Pruebas\ControlPrint\DatosDeControlPrint.cs" Link="ControlPrint\DatosDeControlPrint.cs" />
    <Compile Include="..\Impresiones\PapeleriaPos.Impresiones.Pruebas\ControlPrint\PorCobrarDePrueba.cs" Link="ControlPrint\PorCobrarDePrueba.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PapeleriaPos.Nucleo\PapeleriaPos.Nucleo.csproj" />
    <ProjectReference Include="..\..\src\PapeleriaPos.Datos\PapeleriaPos.Datos.csproj" />
    <ProjectReference Include="..\..\src\PapeleriaPos.Herramientas\PapeleriaPos.Herramientas.csproj" />
    <ProjectReference Include="..\..\src\PapeleriaPos.Servicio\PapeleriaPos.Servicio.csproj" />
    <ProjectReference Include="..\..\src\PapeleriaPos.Impresion\PapeleriaPos.Impresion.csproj" />
  </ItemGroup>

</Project>