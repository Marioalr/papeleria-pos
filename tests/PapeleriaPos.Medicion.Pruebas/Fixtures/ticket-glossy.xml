<?xml version="1.0" encoding="UTF-8"?>
<psf:PrintTicket xmlns:psf="http://schemas.microsoft.com/windows/2003/08/printing/printschemaframework" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1" xmlns:ns0000="http://schema.epson.net/printschema/business/v100" xmlns:psk="http://schemas.microsoft.com/windows/2003/08/printing/printschemakeywords" xmlns:bpe="http://www.adobe.com/schemas/2006/01/bpeschema">
  <psf:ParameterInit name="ns0000:PageDevmodeSnapshot">
    <psf:Value></psf:Value>
  </psf:ParameterInit>
  <psf:Feature name="psk:PageInputBin">
    <psf:Option name="ns0000:AutoSelect" />
  </psf:Feature>
  <psf:Feature name="psk:PageOutputColor">
    <psf:Option name="psk:Color" />
  </psf:Feature>
  <psf:Feature name="psk:PageMediaType">
    <psf:Option name="psk:PhotographicHighGloss" />
  </psf:Feature>
  <psf:Feature name="psk:PageOutputQuality">
    <psf:Option name="ns0000:Standard" />
  </psf:Feature>
  <psf:Feature name="psk:PageResolution">
    <psf:Option name="ns0000:NormalStd">
      <psf:ScoredProperty name="psk:ResolutionX">
        <psf:Value xsi:type="xsd:integer">600</psf:Value>
      </psf:ScoredProperty>
      <psf:ScoredProperty name="psk:ResolutionY">
        <psf:Value xsi:type="xsd:integer">600</psf:Value>
      </psf:ScoredProperty>
    </psf:Option>
  </psf:Feature>
  <psf:Feature name="psk:PageMediaSize">
    <psf:Option name="psk:NorthAmericaLetter">
      <psf:ScoredProperty name="psk:MediaSizeWidth">
        <psf:Value xsi:type="xsd:integer">215900</psf:Value>
      </psf:ScoredProperty>
      <psf:ScoredProperty name="psk:MediaSizeHeight">
        <psf:Value xsi:type="xsd:integer">279400</psf:Value>
      </psf:ScoredProperty>
    </psf:Option>
  </psf:Feature>
  <psf:Feature name="psk:PageBorderless">
    <psf:Option name="psk:None" />
  </psf:Feature>
  <psf:Feature name="psk:PageOrientation">
    <psf:Option name="psk:Portrait" />
  </psf:Feature>
  <psf:Feature name="psk:JobDuplexAllDocumentsContiguously">
    <psf:Option name="psk:OneSided" />
  </psf:Feature>
  <psf:Feature name="psk:PageColorManagement">
    <psf:Option name="psk:Driver" />
  </psf:Feature>
  <psf:Feature name="psk:PageICMRenderingIntent">
    <psf:Option name="psk:Photographs" />
  </psf:Feature>
  <psf:Feature name="psk:DocumentCollate">
    <psf:Option name="psk:Collated" />
  </psf:Feature>
  <psf:Feature name="ns0000:PageFixRedEye">
    <psf:Option name="psk:Off" />
  </psf:Feature>
  <psf:Feature name="psk:JobNUpAllDocumentsContiguously">
    <psf:Option>
      <psf:ScoredProperty name="psk:PagesPerSheet">
        <psf:Value xsi:type="xsd:integer">1</psf:Value>
      </psf:ScoredProperty>
    </psf:Option>
  </psf:Feature>
  <psf:Feature name="psk:JobBindAllDocuments">
    <psf:Option name="psk:BindLeft">
      <psf:ScoredProperty name="psk:BindingGutter">
        <psf:ParameterRef name="psk:JobBindAllDocumentsGutter" />
      </psf:ScoredProperty>
    </psf:Option>
  </psf:Feature>
  <psf:ParameterInit name="psk:JobBindAllDocumentsGutter">
    <psf:Value xsi:type="xsd:integer">0</psf:Value>
  </psf:ParameterInit>
  <psf:Feature name="psk:PageDestinationColorProfile">
    <psf:Option name="psk:DriverConfiguration" />
  </psf:Feature>
  <psf:Feature name="bpe:JobBPECalibrationDue">
    <psf:Option>
      <psf:ScoredProperty name="bpe:TimeStamp">
        <psf:Value xsi:type="xsd:boolean">false</psf:Value>
      </psf:ScoredProperty>
    </psf:Option>
  </psf:Feature>
  <psf:Feature name="bpe:JobBPELastCalibration">
    <psf:Option>
      <psf:ScoredProperty name="bpe:TimeStamp">
        <psf:Value xsi:type="xsd:integer">0</psf:Value>
      </psf:ScoredProperty>
    </psf:Option>
  </psf:Feature>
  <psf:ParameterInit name="psk:JobCopiesAllDocuments">
    <psf:Value xsi:type="xsd:integer">1</psf:Value>
  </psf:ParameterInit>
  <psf:ParameterInit name="ns0000:JobUserName">
    <psf:Value>
    </psf:Value>
  </psf:ParameterInit>
</psf:PrintTicket>
